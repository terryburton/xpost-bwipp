%!PS-Adobe-3.0
%%BoundingBox: 20 20 498 498
%%Pages: 1
%%EndComments
%%Page: 1 1
% One fill with thousands of subpaths: its formatted content far exceeds the
% device's content-buffer size, exercising the buffer-flush path. Integer
% coordinates so the ink bounding box is exact. No save/restore.
0 0 0 setrgbcolor
newpath
0 1 79 {
  6 mul 20 add /gx exch def
  0 1 79 {
    6 mul 20 add /gy exch def
    gx gy moveto 4 0 rlineto 0 4 rlineto -4 0 rlineto closepath
  } for
} for
fill
% A stroke of a path with more line segments than a device-path array could
% hold: the path is streamed to the content stream as it is walked, where
% once it was gathered into an array first and overran it -- the composite
% limit or the operand stack -- aborting the whole job. Thirty thousand
% segments is well past that limit; the run reaching showpage is the proof.
newpath 20 250 moveto
1 1 30000 {
  dup 0.015 mul 20 add exch 0.008 mul dup sin 100 mul 250 add exch pop lineto
} for
0.4 setlinewidth stroke
showpage
%%Trailer
%%EOF
