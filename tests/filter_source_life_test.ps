%!testlib
% A filter holds its source (a decode filter) or its target (an encode
% filter) as a live stream. Closing that underlying file before the filter
% must leave the filter usable: reading a decode filter whose source is
% closed reports end-of-data (PLRM 3.8: an operation that cannot obtain
% data because the file is closed returns the end-of-file result rather
% than erroring), and writing to an encode filter whose target is closed
% is refused rather than reaching a dead stream.
%
% Run through `xpost -q --no-sandbox -d null` by run-ps-test.sh: prints
% SUCCESS iff every assertion holds. The interpreter's exit status is part
% of the verdict, so a crash here fails the test even if SUCCESS printed.


% --- a decode filter over a disk file whose source is closed first ---
/scr (filtersrc.scratch) def
/f scr (w) file def
f (41424344) writestring
f closefile

/src scr (r) file def
/flt src /ASCIIHexDecode filter def
src closefile
/s 4 string def
flt s readstring
exch pop not (a decode filter whose source is closed reads as end-of-data) assert

% the filter object itself is still open and closing it is harmless
flt status (the filter is still open after its source is closed) assert
flt closefile
flt status not (the filter closes normally) assert

% --- the same for a run-length decode filter, whose reader keeps run state ---
/src2 scr (r) file def
/flt2 src2 /RunLengthDecode filter def
src2 closefile
flt2 4 string readstring exch pop not
    (a run-length filter whose source is closed reads as end-of-data) assert
flt2 closefile

% --- a filter chained onto a filter, with the innermost source closed ---
/src3 scr (r) file def
/inner src3 /ASCIIHexDecode filter def
/outer inner /RunLengthDecode filter def
src3 closefile
outer 4 string readstring exch pop not
    (a chained filter whose innermost source is closed reads as end-of-data) assert
outer closefile
inner closefile

% --- an encode filter whose target is closed before it ---
% PLRM 3.8.2: any exception during writing raises ioerror, so a write that
% cannot reach its destination is refused rather than reaching a dead stream.
/tgt (filtertgt.scratch) (w) file def
/enc tgt /ASCIIHexEncode filter def
tgt closefile
{ enc (AB) writestring } /ioerror
    (writing through an encode filter whose target is closed is an ioerror) raises
% Closing the filter is one more write to that target -- the coding's
% end-of-data marker -- so it is refused for the same reason, and the
% stream it leaves behind has no terminator. The filter closes either
% way; what it cannot do is report that it finished.
{ enc closefile } /ioerror
    (closing an encode filter whose target is closed is an ioerror) raises
enc status not (the filter is closed even so) assert

% --- closing the source twice around a live filter ---
/src4 scr (r) file def
/flt4 src4 /ASCIIHexDecode filter def
src4 closefile
src4 closefile
flt4 4 string readstring exch pop not
    (a twice-closed source still reads as end-of-data through its filter) assert
flt4 closefile

% --- the reverse order still works: filter closed first, source after ---
/src5 scr (r) file def
/flt5 src5 /ASCIIHexDecode filter def
flt5 closefile
src5 status (closing a filter leaves its source open) assert
src5 read pop 52 eq (the source still reads its own bytes after the filter closes) assert
src5 closefile

% --- a filter over a string, dropped by the restore that swept it ---
% The string forms of filter build a hidden source stream for the filter to
% read from. It has a file entity of its own even though no program object
% names it, and restore closes files born since the save by walking the
% entity table -- so the sweep meets the source as well as the filter above
% it. Closing the filter frees the source's stream; unless the source's
% entity is cleared at the same moment, the sweep reaches that freed struct
% through the entity and dispatches a close through its method table.
% Two rounds: it takes entity reuse to place the source ABOVE its filter in
% the table, which is the order that has the sweep arrive at the source
% second, after the filter has already freed it.
save
  /a (41>) /ASCIIHexDecode filter def
restore
save
  /s (41>) /ASCIIHexDecode filter def
restore

% and the machinery still works afterwards
/after (41>) /ASCIIHexDecode filter def
after 1 string readstring pop 0 get 65 eq
    (a string-sourced filter still reads after restore has swept its kind) assert
after closefile

scr deletefile
(filtertgt.scratch) deletefile

verdict

% --- a filter cannot outlive the restore that freed its source ---
%
% A filter over a string builds a source stream of its own, with its own
% entity. Closing the filter releases that stream, and the stream
% remembers the entity number so it can clear it -- but if the entity
% has been reclaimed and handed out again by then, the number names
% something else and the write lands in whatever holds it.
%
% Freeing the source under the filter takes a restore that leaves the
% filter behind, and that is what invalidrestore refuses (PLRM 3.7.3):
% the filter is a file made under the save and the operand stack still
% names it. So the hazard is shut at its entrance, and what is asserted
% is the entrance -- a filter made under a save may not be carried out
% of it, whichever stack carries it.
/lifescratch (filter_source_life.scratch) def
/w lifescratch (w) file def w (hello) writestring w closefile

{ save (41>) /ASCIIHexDecode filter exch restore } /invalidrestore
    (a filter made under a save may not be left on the operand stack) raises
{ save (41>) /ASCIIHexDecode filter 1 dict dup 3 -1 roll /f exch put
  begin restore } /invalidrestore
    (nor in a dictionary left open on the dictionary stack) raises
clear

% and a file the restore is free to close leaves everything else alone
save
  (41>) /ASCIIHexDecode filter pop
restore
/victim lifescratch (r) file def
victim status (a fresh file opens after such a restore) assert
victim closefile

