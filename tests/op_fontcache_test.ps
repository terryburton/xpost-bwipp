%!testlib
% The font cache parameter operators (PLRM 8.2), run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% cachestatus reports the cache's occupancy and limits, setcachelimit
% sets the largest glyph the cache will hold, and setcacheparams sets
% the same parameters as the MaxFontCache system parameter and the
% MinFontCompress and MaxFontItem user parameters. PLRM allows an
% implementation to substitute the nearest value it can achieve for any
% of them, with no error, so what is asserted here is that the values it
% does achieve are the ones it reports back.

/allint { true exch { type /integertype eq and } forall } def

% --- cachestatus answers seven integers ---
cachestatus 7 array astore /cs exch def
cs length 7 eq (cachestatus answers seven values) assert
cs allint (cachestatus answers integers) assert
% bsize <= bmax and csize <= cmax: the cache holds no more than it may
cs 0 get cs 1 get le (the bytes in use are within the byte maximum) assert
cs 4 get cs 5 get le (the characters in use are within their maximum) assert

% --- setcachelimit sets the largest glyph the cache will hold ---
% cachestatus reports it last, so the two agree.
/orig cs 6 get def
5000 setcachelimit
cachestatus 7 array astore 6 get 5000 eq
    (setcachelimit sets the limit cachestatus reports) assert
1 setcachelimit
cachestatus 7 array astore 6 get 1 eq
    (a smaller limit is reported in its turn) assert
orig setcachelimit
cachestatus 7 array astore 6 get orig eq
    (the original limit is restored) assert

{ (x) setcachelimit } /typecheck (setcachelimit refuses a non-integer) raises

% --- setcacheparams and currentcacheparams ---
% The operands sit above a mark and setcacheparams removes the mark with
% them, as cleartomark does.
currentcacheparams counttomark /nparams exch def
nparams array astore /before exch def
cleartomark
nparams 3 eq (currentcacheparams answers three parameters) assert
before allint (the cache parameters are integers) assert

count /depth exch def
mark 4444 4 40000 setcacheparams
count depth eq (setcacheparams removes its operands and the mark) assert

currentcacheparams counttomark array astore /after exch def cleartomark
after 0 get 4444 eq (setcacheparams sets the cache size) assert
after 2 get 40000 eq (setcacheparams sets the largest item) assert

% put the cache back the way it was found
mark before aload pop setcacheparams
currentcacheparams counttomark array astore /back exch def cleartomark
back 0 get before 0 get eq (the original cache size is restored) assert
back 2 get before 2 get eq (the original item limit is restored) assert

% fewer operands than parameters: the defaults fill in from the mark up,
% and the ones supplied are the topmost (PLRM 8.2)
{ mark 20000 setcacheparams } (setcacheparams accepts fewer operands than parameters) works
currentcacheparams counttomark array astore 2 get 20000 eq
    (a lone operand sets the topmost parameter) assert
cleartomark
mark before aload pop setcacheparams

% the mark has to be there
{ 4444 4 40000 setcacheparams } /unmatchedmark
    (setcacheparams without a mark is unmatchedmark) raises

% --- cachestatus msize counts distinct face-and-transform combinations ---
% Filing a face at several sizes makes each its own combination; msize (the
% third value) counts them, and re-using one adds none. The count is taken
% here with the cache at the limits it was found with, so a glyph files
% rather than being turned away for its size.
/msizeof { cachestatus 7 array astore 2 get } def
/Courier findfont /F exch def
/m0 msizeof def
[ 101 103 107 109 113 127 131 ] { /sz exch def
    F sz scalefont setfont 72 100 moveto (Ag) show } forall
msizeof m0 sub 7 eq
    (cachestatus counts each new face-and-size combination once) assert
[ 101 103 107 ] { /sz exch def
    F sz scalefont setfont 72 100 moveto (Ag) show } forall
msizeof m0 sub 7 eq
    (re-using a cached combination adds no combination) assert

verdict
