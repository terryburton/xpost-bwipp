%!PS
% qsort_test.ps
%
% Exercise the private .xpostsys /.qsort helper, which the shipped file
% only ever ran inline. .qsort is reached the way tamper_dispatch_test
% reaches the namespace -- through a privatedict-anchored bound procedure
% -- and run in global VM, since the sort keeps its state in the global
% qsortdict. Prints SUCCESS iff every assertion holds.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% Copyright (c) 2026 Terry Burton
% SPDX-License-Identifier: BSD-3-Clause

/failed 0 def
/assert { % bool (name) . -
    exch { pop }
    { (FAIL: ) print print (\n) print /failed failed 1 add store } ifelse
} bind def

% --- recover .xpostsys through a privatedict-anchored procedure ---
% The namespace is not recovered by reading a bound body -- the bodies the
% machinery runs are execute-only -- but enumerated through the accessors
% a run that asked for introspection is given.
/ID 1183615869 internaldict def
/names /xpostsys ID /.namespacenames get exec def
names length 0 gt (the .xpostsys namespace is enumerable) assert
/hasqsort false def
names { /.qsort eq { /hasqsort true store } if } forall
hasqsort (it holds .qsort) assert
/qs /xpostsys /.qsort ID /.namespacevalue get exec def

% --- the sort runs in global VM ---
currentglobal true setglobal

% true iff no adjacent pair breaks the order the comparison asks for
/ordered? { % array {test} . bool
    /t exch def /a exch def true
    1 1 a length 1 sub {
        /i exch def a i 1 sub get a i get t exec and
    } for
} bind def

/A [ 8 3 9 2 4 83 0 29 1 8 22 55 12 99 201 333 999 ] def
A qs
A length 17 eq (the default sort preserves length) assert
A { gt not } ordered? (the default sort is non-descending) assert
A 0 get 0 eq (its least element is at the front) assert
A 16 get 999 eq (its greatest is at the back) assert

/B [ 8 3 9 2 4 83 0 29 1 8 22 55 12 99 201 333 999 ] def
B { gt } qs
B { lt not } ordered? (a gt sort is non-ascending) assert
B 0 get 999 eq (its greatest element is at the front) assert

setglobal

% --- neither operand has to be in global VM ---
%
% cmp is kept in a dictionary the call makes for itself, so it lands in
% whichever bank the caller is working in. Kept in qsortdict, which is
% global, it would refuse a local comparison procedure with invalidaccess
% rather than sort with it -- and refuse it from inside the sort, where
% what the program sees is a failure in its own comparison.
% A sort abandoned part-way leaves both stacks as it had them: .qsort
% brackets itself with begin and end and a stop steps over the end, and
% the operands of whatever refused are still where it left them. stopped
% restores neither. So the depths are taken before each probe and put
% back after one that fails -- without which a failure here would fail
% every assertion after it too, each for a reason of its own, and the
% run would end somewhere unrelated.
/mark! { countdictstack /DEPTH exch def count /NCOUNT exch def } bind def
/unwind {
    { countdictstack DEPTH le { exit } if end } loop
    { count NCOUNT le { exit } if pop } loop
} bind def

currentglobal false setglobal
/L [ 5 1 4 2 3 ] def
/LC { lt } def
mark!
{ L /LC load qs } stopped { unwind false }{ true } ifelse
/sorted exch def
sorted (a local array and a local comparison sort) assert
sorted { L { gt not } ordered? }{ false } ifelse
    (and the local sort left them non-descending) assert
setglobal

% --- a comparison procedure may start a sort of its own ---
%
% Each call holds its own cmp and drops it on the way out, so an inner
% sort cannot leave the outer one comparing with the inner one's
% procedure. One shared slot would: the outer sort would finish under a
% comparison it never asked for, and finish quietly.
currentglobal true setglobal
/inner [ 30 10 20 ] def
/outer [ 3 1 2 ] def
% The inner sort asks for ascending and the outer for descending, so a
% cmp the inner sort left behind is visible in the outer sort's answer.
% Were both the same comparison, a clobbered cmp would sort correctly by
% accident and this would assert nothing.
/NEST { //inner { lt } qs gt } def
mark!
{ outer /NEST load qs } stopped { unwind false }{ true } ifelse
/nested exch def
nested (a comparison procedure may start a sort of its own) assert
nested { outer { lt not } ordered? }{ false } ifelse
    (and the outer sort still came out descending) assert
nested { inner { gt not } ordered? }{ false } ifelse
    (the inner sort ordered its array too) assert
setglobal

failed 0 eq { (SUCCESS\n) print }
{ (FAILED: ) print failed ==only ( assertions\n) print } ifelse
