%!testlib
% Every way of presenting an image against every way of painting one,
% run through `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% An image is described along several axes at once, and each is decoded
% by a branch of its own: where the samples come from (a string, a
% procedure called for more, a file, or one string per colour channel),
% how many bits each sample takes, how the samples map to colour values,
% and which of the three painting operators was called. A combination
% that no one has tried is a combination that has never run, so an image
% that paints perfectly from a string may fail from a procedure, or at
% one sample depth and not another.
%
% So the axes are crossed rather than sampled, and each combination
% reports for itself.

% The framework this suite runs on brackets every case: the reasons the
% unwind has to reach the graphics state, and what went wrong here when it
% did not, are written in tests/testlib.ps beside the code that does it.

/place { gsave 40 0 0 40 0 0 6 array astore concat } bind def

% ---------------------------------------------- sample depth by operator
% Every depth the language defines, through the operand form of image,
% and the same depths through imagemask where only one is meaningful.

[ 1 2 4 8 ] {
    /bpc exch def
    /nm bpc 4 string cvs def
    { place 4 4 bpc [4 0 0 -4 0 4]
      <0123456789abcdef0123456789abcdef> image grestore }
        (paints at this sample depth) nm works2
    % the same data described by a dictionary rather than by operands
    { place
      << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent bpc
         /Decode [0 1] /ImageMatrix [4 0 0 -4 0 4]
         /DataSource <0123456789abcdef0123456789abcdef> >> image
      grestore } (paints from a dictionary at this depth) nm works2
    % and reversed, which exercises the decode arithmetic rather than
    % just carrying the samples through
    { place
      << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent bpc
         /Decode [1 0] /ImageMatrix [4 0 0 -4 0 4]
         /DataSource <0123456789abcdef0123456789abcdef> >> image
      grestore } (paints inverted at this depth) nm works2
} forall

% ------------------------------------------------------ the data sources
% The same picture presented four ways. A source that is read rather
% than indexed has to be asked for exactly as many bytes as the image
% needs, which is where a wrong count shows up.

/bytes <00408000C0FF40208060A0E01030507090B0D0F0> def

{ place 4 4 8 [4 0 0 -4 0 4] bytes image grestore }
    (a string) (source) works2

{ place 4 4 8 [4 0 0 -4 0 4] { bytes } image grestore }
    (a procedure) (source) works2

{ /f (imatrix.scratch) (w) file def f bytes writestring f closefile
  place 4 4 8 [4 0 0 -4 0 4]
  /f (imatrix.scratch) (r) file def
  << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent 8
     /Decode [0 1] /ImageMatrix [4 0 0 -4 0 4]
     /DataSource f >> image grestore
  % the file is deleted at the end and an open one need not go
  f closefile
  pop pop pop pop } (a file) (source) works2

% a procedure that hands over the data a piece at a time, which is the
% case a reader that assumes one call gets wrong
{ /part 0 def
  place 4 4 8 [4 0 0 -4 0 4]
  { part 4 ge { () }
    { bytes part 5 mul 5 getinterval /part part 1 add store } ifelse }
  image grestore } (a procedure called repeatedly) (source) works2

% ------------------------------------------------------- the operators
% imagemask, which paints through a stencil rather than in colour, and
% takes its polarity as a boolean rather than a sample depth.

{ place 4 4 true [4 0 0 -4 0 4] <A050A050> imagemask grestore }
    (with true polarity) (imagemask) works2
{ place 4 4 false [4 0 0 -4 0 4] <A050A050> imagemask grestore }
    (with false polarity) (imagemask) works2
{ place
  << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent 1
     /Decode [0 1] /ImageMatrix [4 0 0 -4 0 4]
     /DataSource <A050A050> >> imagemask grestore }
    (from a dictionary) (imagemask) works2
{ place 4 4 1 [4 0 0 -4 0 4] <A050A050> imagemask grestore }
    (given a depth instead of a polarity) (imagemask) refuses2

% colorimage, whose channels may arrive interleaved in one string or
% separately in one string each -- two quite different readers.
{ place 2 2 8 [2 0 0 -2 0 2]
  <FF000000FF000000FFFFFFFF00> false 3 colorimage grestore }
    (interleaved) (colorimage) works2
% the same picture described per channel as interleaved above: the two
% readers have to agree, which is checked by rendering rather than here
{ place 2 2 8 [2 0 0 -2 0 2]
  <FF0000FF> <00FF00FF> <0000FF00> true 3 colorimage grestore }
    (one string per channel) (colorimage) works2
{ place 2 2 8 [2 0 0 -2 0 2] <30607090> false 1 colorimage grestore }
    (a single channel) (colorimage) works2
{ place 2 2 8 [2 0 0 -2 0 2]
  <FF00000000FF000000FFFF000000FFFF00> false 4 colorimage grestore }
    (four channels) (colorimage) works2

% ------------------------------------------------ under the graphics state
% An image is painted through the current transform and clip like
% anything else, and has to survive both.

{ place 0.5 0.5 scale 45 rotate
  4 4 8 [4 0 0 -4 0 4] bytes image grestore }
    (under a rotation and a scale) (transform) works2
{ place newpath 0 0 2 2 rectclip
  4 4 8 [4 0 0 -4 0 4] bytes image grestore }
    (under a clip) (transform) works2
% A transform that collapses the image to nothing, and a width of no
% samples, are neither required to paint nor required to be refused: the
% specification constrains neither. Reported rather than asserted, so
% that this interpreter's answer is recorded without being written down
% here as the only correct one.
{ gsave 0 0 0 0 0 0 6 array astore concat
  4 4 8 [4 0 0 -4 0 4] bytes image grestore } outcome /ok ne
  { (note: a degenerate image transform is refused\n) print }
  { (note: a degenerate image transform paints nothing\n) print } ifelse

% ------------------------------------------------- a source that runs out
% Running out of data is NOT a bad description. PLRM 4.10.5: "If a data
% source ends before all samples have been read, the remainder of the
% image that would have been painted by the missing samples is left
% unpainted", and an incomplete final row may be discarded. So every one
% of these must be accepted, and refusing any of them would be the
% deviation.
%
% What is painted differs between implementations and this harness paints to the null
% device, so what is held here is that the description is accepted and
% read no further than its data; the samples themselves are held by the
% rendered comparisons.

{ place 4 4 8 [4 0 0 -4 0 4] <0011> image grestore }
    (a string shorter than the samples) (a source that ends early) works2
{ place 4 4 8 [4 0 0 -4 0 4] <> image grestore }
    (a string with no samples at all) (a source that ends early) works2
{ place 4 4 8 [4 0 0 -4 0 4] { <0011> } image grestore }
    (a procedure that runs short) (a source that ends early) works2
{ place 4 4 8 [4 0 0 -4 0 4] { () } image grestore }
    (a procedure that ends at once) (a source that ends early) works2
{ place 4 4 true [4 0 0 -4 0 4] <A0> imagemask grestore }
    (a stencil shorter than its rows) (a source that ends early) works2

% ------------------------------------------------------- what is refused
% A description that does not add up is refused.
{ place 0 4 8 [4 0 0 -4 0 4] bytes image grestore } outcome /ok ne
  { (note: an image of zero width is refused\n) print }
  { (note: an image of zero width paints nothing\n) print } ifelse
{ place 4 4 3 [4 0 0 -4 0 4] bytes image grestore }
    (a sample depth the language does not define) (a bad description) refuses2
{ place
  << /ImageType 99 /Width 4 /Height 4 /BitsPerComponent 8
     /Decode [0 1] /ImageMatrix [4 0 0 -4 0 4]
     /DataSource bytes >> image grestore }
    (an unknown image type) (a bad description) refuses2

% --- the dictionary's word about its own data source ---------------------
%
% PLRM Table 4.20: MultipleDataSources says whether DataSource carries one
% source or one per colour component. It is the dictionary's word that
% decides, not the shape of what DataSource points at -- so a dictionary
% whose flag disagrees with its value is describing itself wrongly and is
% refused, rather than painted from whichever the implementation guessed.
%
% Both forms still work when the dictionary is truthful, which is the half
% that would otherwise be lost by refusing too much.

/rgb3 [ <FF> <80> <00> ] def
{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /MultipleDataSources true /DataSource rgb3 >> image grestore }
  (one source per component, said so) works

{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /MultipleDataSources false /DataSource <FF8000> >> image grestore }
  (one source for all of them, said so) works

{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /MultipleDataSources true /DataSource <FF8000> >> image grestore }
  /typecheck (several sources promised, one string given) raises

{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /MultipleDataSources false /DataSource rgb3 >> image grestore }
  /typecheck (one source promised, an array of them given) raises

% absent is false (PLRM Table 4.20), so this is the case above by default
{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /DataSource rgb3 >> image grestore }
  /typecheck (an array of sources with the flag left out) raises

{ gsave /DeviceRGB setcolorspace
  << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
     /Decode [0 1 0 1 0 1] /ImageMatrix [1 0 0 -1 0 1]
     /MultipleDataSources 7 /DataSource <FF8000> >> image grestore }
  /typecheck (a flag that is not a boolean) raises

% ------------------------------------------------------ the masked types
%
% PLRM Tables 4.22 to 4.24: a type 3 dictionary carries a data dictionary
% and a mask dictionary, and InterleaveType says where the mask's samples
% travel -- sample by sample in the image's stream, row by row in the
% image's stream, or in the mask's own DataSource. A mask sample decoding
% to 1 leaves its pixel unpainted.
%
% These cases read the raster, because the question is which pixels the
% mask kept and nothing weaker answers it: an image under a mask that is
% ignored raises nothing, paints every pixel, and is a pass to any test
% that only asks whether the operator returned.
%
% The page is eight by four with one image over the whole of it, painted
% black on white, so a pixel is 0 where the image reached the page and
% 255 where the mask stopped it.

<< /OutputDevice /pgm /PageSize [8 4] /OutputFile (/dev/null) >> setpagedevice

/black <0000000000000000
        0000000000000000
        0000000000000000
        0000000000000000> def

% the mask rows the cases below share, and the raster they must produce
/wantrows [ <ff00ff00ff00ff00>
            <ffff0000ffff0000>
            <00000000ffffffff>
            <ffffffff00000000> ] def

/paint {  % { body }  .  -
    gsave 1 setgray 0 0 8 4 rectfill 0 0 translate 8 4 scale exec grestore
} bind def

/rasteris {  % [ wanted rows ]  .  bool
    /want exch def
    /got DEVICE /ImgData get def
    got length want length eq {
        true 0 1 want length 1 sub {
            /r exch def got r get want r get eq and
        } for
    }{ false } ifelse
} bind def

% --- interleaved by sample (InterleaveType 1) ----------------------------
%
% The mask sample carries the image's depth with every bit set to the same
% value, and PLRM Table 4.22 says a sample that is neither all 0 nor all 1
% is treated as all 1. So what decides the pixel is whether the sample is
% zero: the values below run across the range and only the zeros paint.

/il1data <0100000040000000 7f000000ff000000
          8000c00000000000 fe00010000000000
          0000000000000000 01007f008000ff00
          ff00fe0002000300 0000000000000000> def

{ { << /ImageType 3 /InterleaveType 1
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource il1data /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } (a sample-interleaved mask paints) works
wantrows rasteris
    (a mask sample is all-0 or all-1, and any other value is all-1) assert

% the same mask read the other way round: Decode [1 0] reverses which
% samples paint (PLRM Table 4.24)
{ { << /ImageType 3 /InterleaveType 1
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource il1data /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [1 0] >> >> image
    } paint } (a sample-interleaved mask under a reversed Decode paints) works
[ <00ff00ff00ff00ff> <0000ffff0000ffff>
  <ffffffff00000000> <00000000ffffffff> ] rasteris
    (the mask's Decode decides which samples paint) assert

% --- interleaved by row (InterleaveType 2) -------------------------------
%
% A stream of interleave blocks, all of one shape, every mask row of a
% block before every image row of it, each row padded separately to a byte
% boundary. The heights decide the shape: one is a multiple of the other.

{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource <aa 0000000000000000
                                 cc 0000000000000000
                                 0f 0000000000000000
                                 f0 0000000000000000>
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } (a row-interleaved mask paints) works
wantrows rasteris (one mask row to one image row) assert

% two mask rows to one image row. The block's mask rows are equal here,
% so what is asked is that both of them are read and the image rows are
% found after them: a reader taking one mask row a block finds the second
% where the image row should be and paints the rest of the stream a row
% out of step.
{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource <aa aa 0000000000000000
                                 cc cc 0000000000000000
                                 0f 0f 0000000000000000
                                 f0 f0 0000000000000000>
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 8 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -8 0 8] /Decode [0 1] >> >> image
    } paint } (a taller mask than the image paints) works
wantrows rasteris (two mask rows to one image row) assert

% one mask row to two image rows: both image rows of the block are masked
% by it
{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource <aa 0000000000000000 0000000000000000
                                 0f 0000000000000000 0000000000000000>
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 2 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -2 0 2] /Decode [0 1] >> >> image
    } paint } (a shorter mask than the image paints) works
[ <ff00ff00ff00ff00> <ff00ff00ff00ff00>
  <00000000ffffffff> <00000000ffffffff> ] rasteris
    (one mask row to two image rows) assert

% a mask narrower than the image, its samples spread across the row
{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource <a0 0000000000000000
                                 c0 0000000000000000
                                 30 0000000000000000
                                 f0 0000000000000000>
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent 1
                    /ImageMatrix [4 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } (a narrower mask than the image paints) works
[ <ffff0000ffff0000> <ffffffff00000000>
  <00000000ffffffff> <ffffffffffffffff> ] rasteris
    (a mask sample covers the image samples it spans) assert

% --- separate sources (InterleaveType 3) ---------------------------------

{ { << /ImageType 3 /InterleaveType 3
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource black /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -4 0 4]
                    /DataSource <aa cc 0f f0> /Decode [0 1] >> >> image
    } paint } (a mask from its own source paints) works
wantrows rasteris (a separate mask source is read on its own grid) assert

% --- colour key masking (ImageType 4) ------------------------------------
%
% PLRM Table 4.25: MaskColor names the colour to mask, exactly with one
% value a component or as a range with two, and the comparison is made on
% the sample as read, before Decode.

/ramp <0010203040506070
       0010203040506070
       0010203040506070
       0010203040506070> def

{ { << /ImageType 4 /MaskColor [0]
       /Width 8 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource ramp /Decode [0 1] >> image
    } paint } (an exact mask colour paints) works
DEVICE /ImgData get 0 get 0 get 255 eq
    (the sample matching the mask colour exactly is not painted) assert
DEVICE /ImgData get 0 get 1 get 255 ne
    (a sample that does not match it is painted) assert

{ { << /ImageType 4 /MaskColor [16 48]
       /Width 8 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource ramp /Decode [0 1] >> image
    } paint } (a mask colour range paints) works
DEVICE /ImgData get 0 get 0 get 255 ne
    (a sample below the range is painted) assert
true 1 1 3 { DEVICE /ImgData get 0 get exch get 255 eq and } for
    (every sample within the range is masked out) assert
DEVICE /ImgData get 0 get 4 get 255 ne
    (a sample above the range is painted) assert

% the comparison is on the sample as read, so a Decode that reverses the
% samples masks the same pixels
{ { << /ImageType 4 /MaskColor [16 48]
       /Width 8 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource ramp /Decode [1 0] >> image
    } paint } (a mask colour range under a reversed Decode paints) works
true 1 1 3 { DEVICE /ImgData get 0 get exch get 255 eq and } for
    (MaskColor is compared before Decode) assert

% --- what the three dictionaries are held to ----------------------------
%
% PLRM 4.10.6: "any inconsistency among the three dictionaries or
% violation of the stated restrictions will result in a typecheck error".
% A description that breaks one of them is refused rather than painted,
% because painting it reads a stream laid out one way as though it were
% laid out another -- which does not fail, it paints a page from samples
% that were never there.

/dd8 << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
        /ImageMatrix [8 0 0 -4 0 4] /DataSource black /Decode [0 1] >> def
/md1 << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 1
        /ImageMatrix [8 0 0 -4 0 4] /DataSource <aa cc 0f f0>
        /Decode [0 1] >> def

{ { << /ImageType 3 /InterleaveType 5 /DataDict dd8 /MaskDict md1 >> image
    } paint } /rangecheck (an interleave type the table does not define) raises

{ { << /ImageType 3 /InterleaveType 3
       /DataDict << /ImageType 2 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >>
       /MaskDict md1 >> image
    } paint } /rangecheck (a data dictionary that is not type 1) raises

{ { << /ImageType 3 /InterleaveType 3 /DataDict dd8
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >> >> image
    } paint } /typecheck (a separate mask deeper than one bit) raises

{ { << /ImageType 3 /InterleaveType 1 /DataDict dd8
       /MaskDict << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [4 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } /typecheck (a sample-interleaved mask on another grid) raises

{ { << /ImageType 3 /InterleaveType 1 /DataDict dd8
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } /typecheck (a sample-interleaved mask at another depth) raises

{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 3 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -3 0 3] /Decode [0 1] >> >> image
    } paint } /typecheck (heights neither of which divides the other) raises

% An image of no samples in one dimension, presented with a mask. PLRM
% Table 4.20 has Width and Height be the image's extent in samples, and
% the text above that table makes an image dictionary whose entries are
% inconsistent with each other a rangecheck. A mask dictionary stating
% neither is refused already: PLRM Table 4.24 aligns the mask's corners
% with the image's, and a grid with no rows or no columns has no corners
% to align. The image's own grid carries the other half of that
% alignment -- and under InterleaveType 2 the block shape is the ratio
% of the two heights, which a height of none divides by nothing -- so a
% masked image stating no width or no height is refused for the same
% reason as the mask that states none.
{ { << /ImageType 3 /InterleaveType 3
       /DataDict << /ImageType 1 /Width 0 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >>
       /MaskDict md1 >> image
    } paint } /rangecheck (a masked image of no columns) raises

{ { << /ImageType 3 /InterleaveType 3
       /DataDict << /ImageType 1 /Width 8 /Height 0 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >>
       /MaskDict md1 >> image
    } paint } /rangecheck (a masked image of no rows) raises

{ { << /ImageType 3 /InterleaveType 2
       /DataDict << /ImageType 1 /Width 8 /Height 0 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /DataSource black
                    /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 1
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } /rangecheck (a row-interleaved masked image of no rows) raises

% Unmasked, an image of no samples is not refused. Nothing about it
% contradicts anything else in its dictionary: it describes a rectangle
% of no area and paints nothing, and this is the reading both reference
% interpreters take.
{ { << /ImageType 1 /Width 8 /Height 0 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource black /Decode [0 1] >> image
    } paint } (an unmasked image of no rows paints nothing) works

{ { << /ImageType 1 /Width 0 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource black /Decode [0 1] >> image
    } paint } (an unmasked image of no columns paints nothing) works

{ { << /ImageType 3 /InterleaveType 1
       /DataDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /MultipleDataSources true
                    /DataSource [ black ] /Decode [0 1] >>
       /MaskDict << /ImageType 1 /Width 8 /Height 4 /BitsPerComponent 8
                    /ImageMatrix [8 0 0 -4 0 4] /Decode [0 1] >> >> image
    } paint } /typecheck (a mask in a stream the image does not have) raises

{ { << /ImageType 4 /MaskColor [1 2 3]
       /Width 8 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource black /Decode [0 1] >> image
    } paint } /rangecheck (a mask colour of neither length) raises

{ { << /ImageType 4 /MaskColor [300]
       /Width 8 /Height 4 /BitsPerComponent 8
       /ImageMatrix [8 0 0 -4 0 4] /DataSource black /Decode [0 1] >> image
    } paint } /rangecheck (a mask colour outside the sample range) raises

(imatrix.scratch) status { pop pop pop pop
    (imatrix.scratch) deletefile } if
verdict
