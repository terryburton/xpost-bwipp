%!testlib
% Predictor stages on a compressed stream, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% An LZW or Flate stream may have been differenced before compression.
% Undoing it is a stage over the decompressor, so each case here
% compresses a known image with a known differencing and requires the
% original bytes back: a stage that did nothing would return the
% differences, which read as an image rather than as an error.


/want <0a141e28323c46505a646e780c16202a343e48525c66707a0f19232d37414b555f69737d> def
/rd { % <<params>> <compressed>  ->  string
    /r.d exch def /r.p exch def
    r.d r.p /FlateDecode filter 64 string readstring pop
} def

/plain << /Colors 3 /BitsPerComponent 8 /Columns 4 >> def

% no differencing at all, named and unnamed
<789ce31291d330b2710b884ac9abe01153d032b1f3088a492ba8e29754d63577f40e8dcf2cae05009bbe0979> << >> exch rd want eq (an undifferenced stream) assert
<789ce31291d330b2710b884ac9abe01153d032b1f3088a492ba8e29754d63577f40e8dcf2cae05009bbe0979> << /Predictor 1 >> exch rd want eq (predictor 1 changes nothing) assert

% horizontal differencing
<789ce3129183031e3105389b5f5219ce0600470d03f4> plain dup /Predictor 2 put exch rd
want eq (predictor 2 undoes horizontal differencing) assert

% each of the five row filters, all under predictor 12
<789c63e01291d330b2710b884ac9ab60e01153d032b1f3088a492ba862e09754d63577f40e8dcf2cae0500a4fd0979>
plain dup /Predictor 12 put exch rd
want eq (the none row filter is undone) assert
<789c63e412918303461e310504875f5219ce01004b4203f7>
plain dup /Predictor 12 put exch rd
want eq (the sub row filter is undone) assert
<789c63e21291d330b2710b884ac9ab604201cc48000060f1034f>
plain dup /Predictor 12 put exch rd
want eq (the up row filter is undone) assert
<789c63e6129153d6d03532b77174f36666e711148001664e3e614118000056a503ac>
plain dup /Predictor 12 put exch rd
want eq (the average row filter is undone) assert
<789c63e112918303162624c0c28c04002d670193>
plain dup /Predictor 12 put exch rd
want eq (the paeth row filter is undone) assert

% and a stream whose rows use a different filter each
<789c63e41291830366761e4101186061460200387a022b>
plain dup /Predictor 15 put exch rd
want eq (rows may each use their own filter) assert

% the parameters the stage is defined for
/src <789ce3129183031e3105389b5f5219ce0600470d03f4> def
{ src << /Predictor 99 >> /FlateDecode filter } /rangecheck (a predictor out of range) raises
{ src << /Predictor 9 >> /FlateDecode filter } /rangecheck (a predictor below the png range) raises
{ src << /Predictor 16 >> /FlateDecode filter } /rangecheck (a predictor above the png range) raises
{ src << /Predictor (two) >> /FlateDecode filter } /typecheck (a predictor that is not an integer) raises
{ src << /Predictor 2 /BitsPerComponent 4 >> /FlateDecode filter } /rangecheck (a sample narrower than a byte) raises
% PLRM 3.13.3 types Colors as "1 or greater", not as the count a device
% space happens to take, so a stream naming more of them is a stream this
% stage carries. What it is still held to is a row it can size.
{ src << /Predictor 2 /Colors 9 >> /FlateDecode filter pop } outcome /ok eq
    (more colours than a device space takes) assert
{ src << /Predictor 2 /Colors 0 >> /FlateDecode filter } /rangecheck (a sample of no components) raises
{ src << /Predictor 12 /Colors 40000 /Columns 40000 >> /FlateDecode filter } /rangecheck
    (a row too large for the stage to hold) raises
{ src << /Predictor 2 /Columns 0 >> /FlateDecode filter } /rangecheck (a row of no columns) raises
{ src << /Predictor 2 /Columns 2000000000 >> /FlateDecode filter } /rangecheck (a row of more columns than the stage sizes) raises

% ------------------------------------------------ the other direction
% PLRM Table 3.20: the parameter is given to the encoding filters too,
% where it selects the differencing to APPLY. So the question is asked as
% a round trip, in all four combinations of the two ends having it: the
% two that agree must return what was written, and the two that disagree
% must not. Without the encoding half only the disagreeing pair round
% trips, which is what the four cases together tell apart -- one that
% asked the agreeing pair alone would pass on an encoder that ignored the
% parameter and a decoder that was handed undifferenced data.

/nm (predrt.scratch) def
/rt.src 96 string def
0 1 rt.src length 1 sub {
    /rt.i exch def rt.src rt.i rt.i 37 mul 13 add 255 and put
} for

/rt { % encparams-or-null decparams-or-null /Encode /Decode  .  bool
    /rt.dn exch def /rt.en exch def /rt.dp exch def /rt.ep exch def
    /rt.f nm (w) file def
    /rt.e rt.ep null eq
        { rt.f rt.en filter }{ rt.f rt.ep rt.en filter } ifelse def
    rt.e rt.src writestring
    rt.e closefile
    rt.f closefile
    /rt.g nm (r) file def
    /rt.d rt.dp null eq
        { rt.g rt.dn filter }{ rt.g rt.dp rt.dn filter } ifelse def
    /rt.got 256 string def
    /rt.k rt.d rt.got readstring pop length def
    rt.d closefile
    rt.g closefile
    rt.got 0 rt.k getinterval rt.src eq
} bind def

/pd { % predictor  .  <<params>>
    << /Predictor 3 -1 roll /Colors 3 /BitsPerComponent 8 /Columns 4 >>
} bind def

% the four combinations, for each compressor and for horizontal
% differencing and a PNG row filter alike
/fourway { % predictor /Encode /Decode (case)  .  -
    /fw.w exch def /fw.d exch def /fw.e exch def /fw.p exch def
    fw.p pd fw.p pd fw.e fw.d rt
        fw.w (round trips with the parameter at both ends) assert2
    fw.p pd null fw.e fw.d rt not
        fw.w (does not round trip with the parameter only on the encoder) assert2
    null fw.p pd fw.e fw.d rt not
        fw.w (does not round trip with the parameter only on the decoder) assert2
    null null fw.e fw.d rt
        fw.w (round trips with the parameter at neither end) assert2
} bind def

2  /FlateEncode /FlateDecode (flate, predictor 2:) fourway
12 /FlateEncode /FlateDecode (flate, predictor 12:) fourway
15 /FlateEncode /FlateDecode (flate, predictor 15:) fourway
2  /LZWEncode /LZWDecode (lzw, predictor 2:) fourway
12 /LZWEncode /LZWDecode (lzw, predictor 12:) fourway
15 /LZWEncode /LZWDecode (lzw, predictor 15:) fourway

% every PNG function the parameter can name
10 pd 10 pd /FlateEncode /FlateDecode rt (the none function round trips) assert
11 pd 11 pd /FlateEncode /FlateDecode rt (the sub function round trips) assert
13 pd 13 pd /FlateEncode /FlateDecode rt (the average function round trips) assert
14 pd 14 pd /FlateEncode /FlateDecode rt (the paeth function round trips) assert

% PLRM Table 3.20: at 10 and above the two ends need not name the same
% function, because each row says which one it used
11 pd 12 pd /FlateEncode /FlateDecode rt
    (a sub-filtered stream is read by a decoder asked for up) assert
15 pd 10 pd /LZWEncode /LZWDecode rt
    (a per-row choice is read by a decoder asked for none) assert

% a last row the program left short, and a sample wider than a byte
<< /Predictor 12 /Colors 3 /BitsPerComponent 8 /Columns 7 >> dup
    /FlateEncode /FlateDecode rt
    (a final row shorter than the rest round trips) assert
<< /Predictor 2 /Colors 1 /BitsPerComponent 16 /Columns 5 >> dup
    /LZWEncode /LZWDecode rt
    (sixteen-bit samples round trip) assert

% the parameters an encoding stage is defined for, refused as the
% decoding one refuses them
{ nm (w) file << /Predictor 99 >> /FlateEncode filter } /rangecheck
    (an encoder predictor out of range) raises
{ nm (w) file << /Predictor 2 /BitsPerComponent 4 >> /LZWEncode filter }
    /rangecheck (an encoder sample narrower than a byte) raises

nm deletefile

% PLRM 3.13.3 types the sample width at 1, 2, 4 or 8 bits. The PNG
% predictors difference over whole bytes whatever that width is -- their
% stride is one sample rounded up to a byte -- so a sample narrower than a
% byte is carried by the same arithmetic the wider ones use. Each case
% below is a known image differenced by a known filter, and what is
% required back is the image.
<78DA6362E0665255852000049D00F2> << /Predictor 13 /Colors 1 /BitsPerComponent 1 /Columns 16 >>
    exch /r.d exch def /r.p exch def r.d r.p /FlateDecode filter 8 string readstring pop
    <000B25304A556F7A> eq (one bit a sample, differenced against the row above) assert
<78DA6362E016536452050204010011C60207> << /Predictor 13 /Colors 1 /BitsPerComponent 2 /Columns 16 >>
    exch /r.d exch def /r.p exch def r.d r.p /FlateDecode filter 16 string readstring pop
    <000B162125303B464A55606B6F7A8590> eq (two bits a sample) assert
<78DA6364E08600465518C30BC6C887320021B00217> << /Predictor 12 /Colors 1 /BitsPerComponent 4 /Columns 16 >>
    exch /r.d exch def /r.p exch def r.d r.p /FlateDecode filter 32 string readstring pop
    <000B16212C37424D25303B46515C67724A55606B76818C976F7A85909BA6B1BC> eq (four bits a sample, differenced against the sample before it) assert
<78DA6364E0168303465503248E572882030040FA0397> << /Predictor 12 /Colors 3 /BitsPerComponent 4 /Columns 8 >>
    exch /r.d exch def /r.p exch def r.d r.p /FlateDecode filter 36 string readstring pop
    <000B16212C37424D58636E7925303B46515C67727D88939E4A55606B76818C97A2ADB8C3> eq (four bits over three components, so the stride is two bytes) assert

verdict
