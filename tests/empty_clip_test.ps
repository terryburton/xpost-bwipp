%!testlib
% What the painting operators do when the clip region covers no pixels.
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% Run through `xpost -d null` by run-ps-test.sh: prints SUCCESS iff every
% assertion holds.
%
% A clipping region can end up covering nothing: two clips that do not
% overlap, or a tiling pattern whose fill lies outside the clip already in
% force -- the pattern cuts the region down to what its fill meets and
% then steps its cells over the result. PLRM 7.5.1 states what a painting
% operation marks as the intersection of two sets of pixels, so when one
% of them is empty the answer is the empty set: every painter paints
% nothing, and none of them has anything to report.
%
% Such a region has no boundary, and clippath hands back a single point
% at the centre of the page for one -- PLRM 8.2 gives clippath no errors,
% and a region that bounds nothing is as much a question clippath has to
% answer as one that bounds something. The point encloses no area, so the
% box it reports is empty in both directions and clippath pathbbox, the
% sizing idiom, sizes nothing rather than failing. The region the painters
% enforce is unchanged by any of that, which the sweep above holds to.
%
% Each painter is asked twice. Once under a region that covers what it
% paints, where it has to mark something -- otherwise "marked nothing"
% below would be the operator doing nothing at all, and the run would pass
% while asserting nothing. Then under a region covering no pixels, where
% it has to return quietly and leave the page as it found it.

/p.name () def
/check { % bool (what)  .  -   (reported against the painter named in p.name)
    p.name exch assert2
} bind def

/.fillpoly     1183615869 internaldict /.fillpoly get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def

/DEV 96 96 .privatedict /newPGMIMAGEdevice get exec def
DEV begin
    /defaultmatrix [ 1 0 0 -1 0 96 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV put
graphicsdict /currgstate get /device DEV put

/inkcount { % -  .  n   (pixels darker than the erased page)
    0
    0 1 95 { /ic.y exch def
        0 1 95 { /ic.x exch def
            ic.x ic.y DEV dup /GetPix get exec 128 lt { 1 add } if
        } for
    } for
} bind def

/boxpath { % x0 y0 x1 y1  .  -
    4 dict begin
    /by1 exch def /bx1 exch def /by0 exch def /bx0 exch def
    newpath bx0 by0 moveto bx1 by0 lineto bx1 by1 lineto bx0 by1 lineto closepath
    end
} bind def

% the clip everything below is painted under, and the same clip cut down
% by a band that does not touch it -- the second leaves a region covering
% no pixels at all
/liveclip  { initgraphics erasepage 0 30 96 70 boxpath clip newpath } bind def
/emptyclip { liveclip 0 5 96 15 boxpath clip newpath } bind def

/setpat {
    << /PatternType 1 /PaintType 1 /TilingType 1
       /BBox [0 0 8 8] /XStep 8 /YStep 8
       /PaintProc { begin 0 setgray 0 0 8 8 rectfill end } >>
    matrix makepattern /Pattern setcolorspace setcolor
} bind def
/setshpat {
    << /PatternType 2
       /Shading << /ShadingType 2 /ColorSpace /DeviceGray /Coords [0 30 0 70]
                   /Extend [true true]
                   /Function << /FunctionType 2 /Domain [0 1]
                                /C0 [0] /C1 [0] /N 1 >> >> >>
    matrix makepattern /Pattern setcolorspace setcolor
} bind def

% every painter, each marking the band the clips above are cut around. The
% shadings extend at both ends, so they reach for a radius covering the
% whole region -- the measurement that has no answer when there is no
% region.
%
% The third element says whether the region governs what the painter
% marks, which it does for every one of them. What a glyph raster meets
% the region as, and that it meets the same pixels a fill of the same
% shape would, is tests/show_clip_test.ps; here show is one painter among
% the rest, held to marking nothing when the region covers nothing.
/PAINTERS [
  [ (fill)          { 0 setgray 10 40 80 60 boxpath fill } true ]
  [ (eofill)        { 0 setgray 10 40 80 60 boxpath eofill } true ]
  [ (stroke)        { 0 setgray 6 setlinewidth
                      newpath 10 50 moveto 80 50 lineto stroke } true ]
  [ (rectfill)      { 0 setgray 10 40 70 20 rectfill } true ]
  [ (show)          { 0 setgray /Times-Roman findfont 24 scalefont setfont
                      10 42 moveto (Hg) show } true ]
  [ (image)         { 0 setgray 10 40 translate 70 20 scale
                      2 2 8 [2 0 0 -2 0 2] <00204060> image } true ]
  [ (axial shfill)  { << /ShadingType 2 /ColorSpace /DeviceGray
                         /Coords [10 40 80 60] /Extend [true true]
                         /Function << /FunctionType 2 /Domain [0 1]
                                      /C0 [0] /C1 [0] /N 1 >> >> shfill } true ]
  [ (radial shfill) { << /ShadingType 3 /ColorSpace /DeviceGray
                         /Coords [48 50 2 48 50 30] /Extend [true true]
                         /Function << /FunctionType 2 /Domain [0 1]
                                      /C0 [0] /C1 [0] /N 1 >> >> shfill } true ]
  [ (mesh shfill)   { << /ShadingType 4 /ColorSpace /DeviceGray
                         /DataSource [ 0 12 40 0.0  0 84 42 0.0  0 48 62 0.0 ]
                      >> shfill } true ]
  [ (pattern fill)   { setpat 10 40 80 60 boxpath fill } true ]
  [ (pattern eofill) { setpat 10 40 80 60 boxpath eofill } true ]
  [ (pattern stroke) { setpat 6 setlinewidth
                       newpath 10 50 moveto 80 50 lineto stroke } true ]
  [ (pattern show)   { setpat /Times-Roman findfont 24 scalefont setfont
                       10 42 moveto (Hg) show } true ]
  [ (pattern image)  { setpat 10 40 translate 70 20 scale
                       2 2 8 [2 0 0 -2 0 2] <00204060> image } true ]
  [ (shading-pattern fill) { setshpat 10 40 80 60 boxpath fill } true ]
] def

% --- under a region that covers them, the painters mark the page --------
PAINTERS {
    aload pop /p.gov exch def /p.proc exch def /p.name exch def
    liveclip
    { p.proc } stopped
        { (FAIL: ) print p.name print ( raised ) print
          $error /errorname get 40 string cvs print (\n) print
          /failcount failcount 1 add store }
        { inkcount 0 gt (marks the page under a region that covers it) check }
    ifelse
} forall

% --- under a region covering no pixels, they raise nothing and mark none -
PAINTERS {
    aload pop /p.gov exch def /p.proc exch def /p.name exch def
    emptyclip
    { p.proc } stopped
        { (FAIL: ) print p.name print ( raised ) print
          $error /errorname get 40 string cvs print
          ( under a region covering no pixels\n) print
          /failcount failcount 1 add store }
        { p.gov
          { inkcount 0 eq (marks nothing under a region covering no pixels) check }
          if }
    ifelse
} forall

% --- a pattern fill outside the clip already in force -------------------
% The reported shape of the fault, and the one that needs no second clip:
% the tiling cuts the region down to what its own fill meets, so a bar
% that misses the clip leaves the cells nothing to be stepped over.

/p.name (a pattern fill outside the clip) def
initgraphics erasepage
0 60 96 90 boxpath clip newpath
setpat
{ newpath 0 40.1 96 0.3 rectfill } stopped
    { (FAIL: ) print p.name print ( raised ) print
      $error /errorname get 40 string cvs print (\n) print
      /failcount failcount 1 add store }
    { inkcount 0 eq (marks nothing) check }
ifelse

% and the same bar inside the clip does mark, so the miss above is the
% clip's doing and not the bar's
initgraphics erasepage
0 60 96 90 boxpath clip newpath
setpat
newpath 0 70.1 96 4.3 rectfill
inkcount 0 gt (a pattern fill inside the clip marks the page) assert

% --- what the region itself answers -------------------------------------
% clippath hands the region over as a path. A region covering no pixels
% has no boundary to hand over, and what comes back for one is a single
% point at the centre of the page: a moveto and a closepath, enclosing no
% area. So clippath pathbbox answers for such a region -- with a box of no
% width and no height, which sizes nothing -- rather than raising.

/near { % a b  .  bool
    sub abs 0.01 lt
} bind def
% the page centre, in the user space the assertions are made in
/pagecx DEV /dimensions get 0 get 2 div def
/pagecy DEV /dimensions get 1 get 2 div def
initgraphics
pagecx pagecy itransform /ucy exch def /ucx exch def

emptyclip
{ clippath } stopped not (clippath over an empty region returns quietly) assert

% the shape: a moveto and a closepath, in that order and nothing else
/eseq 16 string def
/enel 0 def
/eput { eseq enel 3 -1 roll put /enel enel 1 add def } bind def
emptyclip
clippath
    { pop pop 109 eput }
    { pop pop 108 eput }
    { pop pop pop pop pop pop 99 eput }
    { 104 eput }
pathforall
enel 2 eq { eseq 0 2 getinterval (mh) eq }{ false } ifelse
    (clippath over an empty region gives a moveto and a closepath) assert

% and where it is
emptyclip
clippath
{ pathbbox } stopped not
    (pathbbox over what clippath handed back returns quietly) assert
/ey1 exch def /ex1 exch def /ey0 exch def /ex0 exch def
ex0 ucx near (the empty region's box starts at the page centre in x) assert
ey0 ucy near (the empty region's box starts at the page centre in y) assert
ex1 ex0 near (the empty region's box has no width) assert
ey1 ey0 near (the empty region's box has no height) assert

emptyclip
clippath
currentpoint /cpy exch def /cpx exch def
cpx ucx near (clippath leaves a current point at the page centre in x) assert
cpy ucy near (clippath leaves a current point at the page centre in y) assert

% the point is the page's, not the current space's: it is carried in
% device coordinates like the rest of a path, so a coordinate system set
% up after the clip reports it through that system
emptyclip
2 2 scale
clippath pathbbox
/sy1 exch def /sx1 exch def /sy0 exch def /sx0 exch def
sx0 ucx 2 div near (a scaled space reports half the centre's x) assert
sy0 ucy 2 div near (a scaled space reports half the centre's y) assert
sx1 sx0 near (the scaled box still has no width) assert
sy1 sy0 near (the scaled box still has no height) assert

% every way of arriving at a region covering no pixels answers the same
/emptyways [
  [ (two clips that do not overlap) { liveclip 0 5 96 15 boxpath clip newpath } ]
  [ (a clip on an empty path)       { initgraphics newpath clip } ]
  [ (a clip entirely off the page)  { initgraphics
                                      -50 -50 -10 -10 boxpath clip newpath } ]
  [ (a region carried in a gstate)  { initgraphics newpath clip
                                      /eg gstate currentgstate def
                                      initclip eg setgstate } ]
] def
emptyways {
    aload pop /p.proc exch def /p.name exch def
    p.proc
    clippath pathbbox
    /wy1 exch def /wx1 exch def /wy0 exch def /wx0 exch def
    wx0 ucx near wy0 ucy near and wx1 wx0 near and wy1 wy0 near and
    (reports the page centre for a region covering no pixels) check
} forall

% a region that bounds no area but does have a boundary is not the same
% question: it reports its own box, which is where the program put it
initgraphics
newpath 30 30 moveto 30 30 lineto closepath clip
clippath pathbbox
/zy1 exch def /zx1 exch def /zy0 exch def /zx0 exch def
zx0 30 near zy0 30 near and zx1 30 near and zy1 30 near and
    (a region bounding no area reports its own box) assert

% and clipping to what clippath handed back leaves the region as it was:
% a point bounds no pixels, so the painters still mark nothing and the
% next clippath answers the same way
emptyclip
clippath clip newpath
clippath pathbbox
/ry1 exch def /rx1 exch def /ry0 exch def /rx0 exch def
rx0 ucx near ry0 ucy near and rx1 rx0 near and ry1 ry0 near and
    (clipping to the point reported leaves the region covering nothing) assert
emptyclip
clippath clip newpath
0 setgray 10 40 80 60 boxpath fill
inkcount 0 eq (a fill under the reclipped region marks nothing) assert

% and the point itself is a shape that marks nothing, asked where there
% is a region to mark under
emptyclip
clippath
initclip
0 setgray fill
inkcount 0 eq (filling the point clippath reported marks nothing) assert

% pathbbox over an empty current path is still a nocurrentpoint, as PLRM
% 8.2 states: what changed is what clippath hands over, not pathbbox
initgraphics
{ newpath pathbbox } stopped
    { $error /errorname get /nocurrentpoint eq }{ false } ifelse
    (pathbbox over an empty current path is a nocurrentpoint) assert
clear

initclip newpath
count 0 eq (the suite leaves the operand stack empty) assert
verdict
quit
