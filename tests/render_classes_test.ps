%!testlib
% Render-class coverage, run through `xpost -d null` by run-ps-test.sh: prints
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% SUCCESS iff every construct runs without error. Covers Type 3 and composite
% (Type 0) fonts, the shading types, tiling and shading patterns, and screen
% and halftone setup.

% --- Type 3 procedural font ---
{
    8 dict dup begin
        /FontType 3 def /FontMatrix [ 0.001 0 0 0.001 0 0 ] def
        /FontBBox [ 0 0 1000 1000 ] def
        /Encoding 256 array def 0 1 255 { Encoding exch /.notdef put } for
        Encoding 65 /box put Encoding 66 /tri put
        /CharProcs 3 dict def
        CharProcs /.notdef { 0 0 setcharwidth } put
        CharProcs /box { 1000 0 setcharwidth 100 100 800 800 rectfill } put
        CharProcs /tri { 1000 0 setcharwidth 100 0 moveto 900 0 lineto 500 900 lineto closepath fill } put
        /BuildChar { exch begin Encoding exch get CharProcs exch get exec end } bind def
    end /T3Font exch definefont
    40 scalefont setfont 40 730 moveto (ABAB) show
} stopped not (a Type 3 procedural font paints) assert

% --- composite Type 0 font; a spacing show advances the pen per character ---
{
    << /FontType 0 /FMapType 2 /FontMatrix [ 1 0 0 1 0 0 ] /Encoding [ 0 1 ]
       /FDepVector [ /Helvetica findfont /Times-Roman findfont ] >> /T0Font exch definefont
    20 scalefont setfont
    40 690 moveto 0 0 32 4 0 <004800650149014c004f> awidthshow
} stopped not (a composite Type 0 font paints through a spacing show) assert

% --- axial shading through a stitching function, plus radial ---
{
    << /ShadingType 2 /ColorSpace /DeviceRGB /Coords [ 40 400 240 600 ]
       /Function << /FunctionType 3 /Domain [ 0 1 ]
         /Functions [ << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 1 0 0 ] /C1 [ 1 1 0 ] /N 1 >>
                      << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 1 1 0 ] /C1 [ 0 0 1 ] /N 1.5 >> ]
         /Bounds [ 0.5 ] /Encode [ 0 1 0 1 ] >> /Extend [ true true ] >> shfill
} stopped not (an axial shading through a stitching function paints) assert
{
    << /ShadingType 3 /ColorSpace /DeviceRGB /Coords [ 380 500 5 380 500 100 ]
       /Function << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 0 1 1 ] /C1 [ 1 0 1 ] /N 1 >>
       /Extend [ true true ] >> shfill
} stopped not (a radial shading paints) assert

% --- Gouraud mesh shadings (16-bit coordinates), free-form (4) and lattice (5) ---
{
    << /ShadingType 4 /ColorSpace /DeviceRGB /BitsPerFlag 8 /BitsPerCoordinate 16
       /BitsPerComponent 8 /Decode [ 0 200 0 200 0 1 0 1 0 1 ]
       /DataSource <00 0014 0014 FF0000  00 00B4 0014 00FF00  00 0064 00B4 0000FF> >> shfill
} stopped not (a Type 4 free-form Gouraud mesh paints) assert
{
    << /ShadingType 5 /ColorSpace /DeviceRGB /VerticesPerRow 2 /BitsPerCoordinate 16
       /BitsPerComponent 8 /Decode [ 0 200 0 200 0 1 0 1 0 1 ]
       /DataSource <000A 008C FF0000  008C 008C 00FF00  000A 00EE 0000FF  008C 00EE FFFF00> >> shfill
} stopped not (a Type 5 lattice Gouraud mesh paints) assert

% --- the same meshes with an array DataSource: the flag, coordinate and colour
%     values are literal numbers and BitsPer*/Decode are absent (PLRM 4.9.3, as
%     dvips emits for 3-D shaded figures); a DeviceN case takes its component
%     count from the colour space rather than a Decode array ---
{
    << /ShadingType 4 /ColorSpace /DeviceRGB
       /DataSource [ 0 20 20 1 0 0   0 180 20 0 1 0   0 100 180 0 0 1 ] >> shfill
} stopped not (a Type 4 free-form mesh with an array DataSource paints) assert
{
    << /ShadingType 5 /ColorSpace /DeviceRGB /VerticesPerRow 2
       /DataSource [ 10 340 1 0 0   140 340 0 1 0   10 430 0 0 1   140 430 1 1 0 ] >> shfill
} stopped not (a Type 5 lattice mesh with an array DataSource paints) assert
{
    << /ShadingType 4 /ColorSpace [ /DeviceN [ (Ca) (Mb) ] /DeviceRGB { pop dup dup } ]
       /DataSource [ 0 220 20 0.1 0.2   0 380 20 0.5 0.6   0 300 180 0.9 0.8 ] >> shfill
} stopped not (a Type 4 mesh over a DeviceN space with an array DataSource paints) assert

% --- Separation and DeviceN colours: paint through the tint transform, and the
%     colour reads back as the tints it was set with (the spots.ps machinery) ---
{
    [ /Separation (SpotInk) /DeviceCMYK { dup 0.2 mul exch dup 0.5 mul exch 0.1 mul 0 } ]
    setcolorspace
    0.6 setcolor
    10 10 30 30 rectfill
} stopped not (a Separation colour paints through its tint transform) assert
currentcolor 0.6 sub abs 0.001 lt (currentcolor returns the separation tint) assert
currentcolorspace dup type /arraytype eq { 0 get /Separation eq }{ pop false } ifelse
(currentcolorspace reports the Separation family) assert
{
    [ /DeviceN [ /InkA /InkB ] /DeviceRGB { 2 copy add 0.5 mul 3 1 roll exch } ]
    setcolorspace
    0.25 0.75 setcolor
    50 10 30 30 rectfill
} stopped not (a DeviceN colour paints through its tint transform) assert
currentcolor
0.75 sub abs 0.001 lt exch 0.25 sub abs 0.001 lt and
(currentcolor returns both DeviceN tints) assert
gsave 0 setgray grestore
currentcolor
0.75 sub abs 0.001 lt exch 0.25 sub abs 0.001 lt and
(the tints survive a gsave/grestore bracket) assert
0 setgray

% --- a font's Metrics dictionary overrides glyph widths (PLRM 5.9.2): a number
%     is the new x width, an array carries it second (of two) or third (of
%     four), all in character space, so the text-space width is that value times
%     the font matrix. dvips re-encoded fonts lean on this. The widths are taken
%     relative to the resolved font matrix, so the test does not depend on which
%     face the platform substitutes for Helvetica or its units-per-em. ---
/Helvetica findfont dup length 1 add dict copy
dup /Metrics << /A 500 /B [ 100 400 ] /C [ 0 0 300 0 ] >> put
/MetricsFont exch definefont pop
/MetricsFont findfont 20 scalefont setfont
currentfont /FontMatrix get 0 get /mfm exch def
(A) stringwidth pop 500 mfm mul sub abs 0.01 lt
    (a number Metrics entry sets the width) assert
(B) stringwidth pop 400 mfm mul sub abs 0.01 lt
    (a two-element Metrics entry carries the width second) assert
(C) stringwidth pop 300 mfm mul sub abs 0.01 lt
    (a four-element Metrics entry carries the width vector) assert
(D) stringwidth pop
/Helvetica findfont 20 scalefont setfont (D) stringwidth pop
sub abs 0.01 lt (a glyph without a Metrics entry keeps its own width) assert
/MetricsFont findfont 20 scalefont setfont
40 650 moveto (A) show currentpoint pop 40 sub 500 mfm mul sub abs 0.01 lt
    (the show pen advances by the Metrics width) assert

% --- a font's Metrics dictionary also overrides where the glyph sits against
%     its origin (PLRM 5.9.2): the two-element form gives the x component of a
%     new left sidebearing first, the four-element form the x and y components
%     of one. The sidebearing is a position and not a displacement (PLRM 5.4),
%     so what moves the glyph is the difference between the one named and the
%     one the face drew it with -- which makes the difference between two named
%     sidebearings the whole of the move, and that is what is asked here: it
%     does not depend on the face the platform substitutes or on where that
%     face puts the glyph. The number form names no sidebearing, and a glyph
%     under one stands where the face put it.
%
%     Where the glyph sits is read from its outline, which the interpreter
%     hands back through a private operator: fetched deliberately through
%     the password, as the other suites that reach into internaldict do. ---
/.glyphoutline 1183615869 internaldict /.glyphoutline get def
/sbfont {                               % metrics  .  -
    /Helvetica findfont dup length 1 add dict copy
    dup /Metrics 4 -1 roll put
    /SbFont exch definefont pop
    /SbFont findfont 20 scalefont setfont
} bind def
/firstpt {                              % -  .  x y
    /A .glyphoutline pop pop            % the outline alone
    dup 0 get exch 1 get
} bind def

<< /A [ 0 400 ] >> sbfont
currentfont /FontMatrix get 0 get /sfm exch def
firstpt pop /sbx0 exch def
<< /A [ 300 400 ] >> sbfont
firstpt pop /sbx300 exch def
sbx300 sbx0 sub 300 sfm mul sub abs 0.01 lt
    (a two-element Metrics entry moves the glyph by the sidebearing it names) assert

<< /A [ 0 0 400 0 ] >> sbfont
firstpt /fy0 exch def /fx0 exch def
<< /A [ 300 0 400 0 ] >> sbfont
firstpt pop /fx300 exch def
fx300 fx0 sub 300 sfm mul sub abs 0.01 lt
    (a four-element Metrics entry moves the glyph by its x sidebearing) assert
<< /A [ 0 300 400 0 ] >> sbfont
firstpt exch pop /fy300 exch def
fy300 fy0 sub 300 sfm mul sub abs 0.01 lt
    (and by its y sidebearing) assert

% the sidebearing moves the glyph and leaves the width alone
<< /A [ 0 400 ] >> sbfont (A) stringwidth pop /w0 exch def
<< /A [ 300 400 ] >> sbfont (A) stringwidth pop w0 sub abs 0.01 lt
    (a sidebearing does not move the pen) assert

% a number names a width and no sidebearing, so the glyph stays put
/Helvetica findfont 20 scalefont setfont firstpt pop /natx exch def
<< /A 400 >> sbfont firstpt pop natx sub abs 0.01 lt
    (a number Metrics entry leaves the glyph where the face drew it) assert

% --- charpath produces the same glyph as a path that show paints on the page,
%     so it reads the same Metrics dictionary (PLRM 5.9.2, PLRM 8.2 charpath):
%     the outline it appends stands where the overriding sidebearing puts the
%     glyph, and the glyph after one starts where the overriding width ends.
%     Asked of the appended path's bounding box, and of the difference between
%     two Metrics dictionaries rather than of either alone, so that neither the
%     face the platform substitutes nor its units per em is being asserted. ---
/cpbox {                                % metrics str  .  llx lly urx ury
    exch sbfont
    gsave newpath 40 650 moveto false charpath pathbbox grestore
} bind def

<< /A [ 0 400 ] >>   (A) cpbox pop pop pop /cx0 exch def
<< /A [ 300 400 ] >> (A) cpbox pop pop pop /cx300 exch def
cx300 cx0 sub 300 sfm mul sub abs 0.01 lt
    (charpath puts the outline where the Metrics sidebearing puts the glyph) assert

<< /A 300 >> (AA) cpbox pop exch pop exch pop /cw300 exch def
<< /A 600 >> (AA) cpbox pop exch pop exch pop /cw600 exch def
cw600 cw300 sub 300 sfm mul sub abs 0.01 lt
    (and starts the glyph after one where the Metrics width ends) assert

% the path and the pen agree about how far the text reached
<< /A 300 >> sbfont
gsave newpath 40 650 moveto (AA) false charpath currentpoint grestore
pop 40 sub 600 sfm mul sub abs 0.01 lt
    (the charpath pen advances by the Metrics widths) assert

% --- tiling pattern and shading pattern (PatternType 2) ---
{
    /Pattern setcolorspace
    << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [ 0 0 12 12 ]
       /XStep 12 /YStep 12 /PaintProc { pop 0.6 0 0.3 setrgbcolor 2 2 8 8 rectfill } >>
    matrix makepattern setpattern
    newpath 300 200 moveto 500 200 lineto 500 340 lineto 300 340 lineto closepath fill
} stopped not (a tiling pattern fills) assert
{
    [ /Pattern /DeviceRGB ] setcolorspace
    << /PatternType 2 /Shading
       << /ShadingType 2 /ColorSpace /DeviceRGB /Coords [ 0 0 100 100 ]
          /Function << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 1 0 0 ] /C1 [ 0 0 1 ] /N 1 >>
          /Extend [ true true ] >> >> matrix makepattern setpattern
    newpath 40 40 moveto 140 40 lineto 140 140 lineto 40 140 lineto closepath fill
} stopped not (a shading pattern fills) assert

% --- screen and halftone setup ---
{
    60 45 { dup mul exch dup mul add 1 sqrt sub } setscreen
    << /HalftoneType 3 /Width 4 /Height 4
       /Thresholds <10305070 20406080 15355575 25456585> >> sethalftone
} stopped not (screen and halftone setup complete) assert

count 0 eq (operand stack is balanced) assert
verdict
flush
quit
