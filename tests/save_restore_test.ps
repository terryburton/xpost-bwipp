%!testlib
% Save/restore VM regression checks, run through `xpost -d null` by
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% Guards the saverec entity-width defect: a saverec stored the source
% and copy entity numbers of a saved composite in 16-bit `word` fields,
% so once the interpreter had allocated more than 65535 entities the
% copy entity number was truncated and `restore` reverted -- or the
% collector marked -- the wrong allocation. The failure is silent data
% corruption: the modification made under save survives the restore, or
% an unrelated object is clobbered. These checks first drive the entity
% count past 65536, then require save/restore to revert dicts and arrays
% exactly. Strings are deliberately not exercised: PLRM specifies that
% restore "resets the values of all composite objects in local VM, except
% strings, to their state at the time of the save", so a put'd string
% character is meant to survive restore.
%
% COLLECTION: of the three numbers vmstatus answers, only the first -- the
% save level -- is read here, and the two the collector moves are dropped
% on the spot. A save level is the count of saves outstanding, which no
% collection changes.

% --- across a job boundary ---
%
% No save object crosses one. A job starts with nothing saved, and
% startjob is refused while a save is outstanding (PLRM 3.7.7), so a
% program cannot reach the far side of a boundary holding a snapshot of
% the near one.
%
% THIS COMES FIRST IN THE SUITE and cannot be moved down. Every refused
% restore below leaves the save it was given outstanding -- a refusal
% winds nothing back -- and the framework's unwind puts back the operand
% and dictionary stacks and not the save stack, so from the first refusal
% on there is always a save outstanding and startjob always answers false.
% Here the level is still the one a run begins at.
vmstatus pop pop 0 eq (a run stands at no save level of its own) assert
save
vmstatus pop pop 1 eq (a save raises the level) assert
false () startjob not
    (startjob is refused while a save is outstanding) assert
restore
vmstatus pop pop 0 eq (and the restore puts the level back) assert
% The control, without which the refusal above could be the password
% rather than the save: with nothing saved and everything else about the
% run unchanged, startjob succeeds. It resets the operand, dictionary and
% hold stacks, which is the other reason this belongs at the top -- there
% is nothing on any of them yet for it to take.
false () startjob (startjob succeeds with nothing saved) assert
count 0 eq (and leaves the operand stack empty) assert

% --- drive the entity counter past 65536 with reachable allocations ---
% (unreachable ones would be collected and their entity numbers reused)
/j1 35000 array def
/j2 35000 array def
0 1 34999 { j1 exch 2 array put } for
0 1 34999 { j2 exch 2 array put } for

% --- dict reverts across save/restore ---
/d 3 dict def
d /a 1 put
save
    d /a 2 put
    d /a get 2 eq (dict change is visible under save) assert
restore
d /a get 1 eq (dict reverts on restore past 65536 entities) assert

% --- array reverts across save/restore ---
/arr 4 array def
arr 0 100 put
save
    arr 0 200 put
restore
arr 0 get 100 eq (array reverts on restore past 65536 entities) assert

% --- nested save/restore reverts to the right level ---
/e 3 dict def
e /k 0 put
save
    e /k 1 put
    save
        e /k 2 put
    restore
    e /k get 1 eq (inner restore reverts to outer-save value) assert
restore
e /k get 0 eq (outer restore reverts to pre-save value) assert

% --- a dict that GROWS (dicgrow) under a save reverts cleanly ---
% dicgrow moves the dict to a larger allocation, so the saved copy and the
% live object end the save block at different addresses AND different sizes.
% restore therefore has to exchange the whole storage identity (adr, sz and
% used) between the two, not just the address: swapping the address alone
% leaves the reverted dict claiming the grown byte count while pointing at
% the smaller backup allocation, an entity whose range then overruns its
% neighbours once it is freed and reused. The overrun only manifests with a
% specific allocation adjacency (the multi-plate poster reproduces it under a
% low GC threshold); what a small script can pin down is that the revert
% itself is exact -- size and keys -- and survives a collection.
/g 2 dict def  g /a 1 put
save
    g /b 2 put  g /c 3 put  g /d 4 put  g /e 5 put  g /f 6 put
    g length 6 eq (grown dict is visible under save) assert
restore
g length 1 eq (grown dict reverts to its saved size) assert
g /a known (its saved key survives) assert
g /b known not (a key added under save is gone) assert
% churn the collector over a fresh allocation load; the reverted dict must
% read back intact rather than reflecting a stale grown-storage identity
/blk 4000 array def 0 1 3999 { blk exch 3 array put } for
g /a get 1 eq (the reverted dict is intact after a collection) assert

% --- the string exception, asserted positively ---
% PLRM 3.7.3: restore resets all composite objects in local VM EXCEPT
% strings. A character put and a putinterval into a pre-save string must
% SURVIVE the restore; reverting them would be the deviation.
/xs (hello) def
save
    xs 0 72 put            % (Hello)
    xs 3 (LO) putinterval  % (HelLO)
restore
xs (HelLO) eq (string contents survive restore, per the PLRM string exception) assert

% --- restore is refused while a stack still names what it would discard ---
%
% PLRM 3.7.3, on what restore does NOT do: "Affect the contents of the
% operand, dictionary, and execution stacks. If a stack contains a
% reference to a composite object in local VM that would be discarded by
% the restore operation, the restore is not allowed; an invalidrestore
% error occurs." PLRM 8.2 restore says the same and adds that the
% restriction covers save objects, and name objects in LanguageLevel 1.
%
% Two things rest on it. One is the program's: it would be left holding
% storage that is no longer its own. The other is the interpreter's: an
% object carried out of the save level it was made at keeps that level's
% birth stamp, which is above the level it now lives at, and the next
% save reads the stamp, concludes the object postdates it and takes no
% backup -- so the next restore silently fails to revert a write. The
% control below drives exactly that sequence and is the reason this is
% not only a conformance check.
%
% Each composite type is asked separately: they are stamped by different
% constructors and read through different fields, so one type answering
% correctly says nothing about the others.

{ save 5 string exch restore } /invalidrestore
    (a string made under the save may not be left on the operand stack) raises
{ save 3 array exch restore } /invalidrestore
    (nor an array) raises
{ save 3 dict exch restore } /invalidrestore
    (nor a dictionary) raises
{ save 1 2 3 3 packedarray exch restore } /invalidrestore
    (nor a packed array) raises
{ save (43>) /ASCIIHexDecode filter exch restore } /invalidrestore
    (nor a file) raises
{ save save exch restore } /invalidrestore
    (nor a save object, which PLRM 8.2 names beside the composites) raises

% The dictionary stack and the execution stack are named by the same
% sentence. A dictionary made under the save and left open is on the
% dictionary stack; a procedure made under the save is on the execution
% stack while it runs, which is what calling restore from inside one
% means.
{ save 3 dict begin restore } /invalidrestore
    (nor a dictionary left open on the dictionary stack) raises

% The procedure is built after the save and is what runs the restore, so
% it is on the execution stack at the moment the restore is asked for.
% Something has to follow the restore in it: a procedure runs out of an
% interval on the execution stack naming the elements not yet reached,
% and one with nothing left to reach has finished -- so a procedure
% ENDING in the restore is on no stack by the time the restore runs, and
% is not a reference to anything.
{ save [ /restore cvx /pop cvx ] cvx exec 0 } /invalidrestore
    (nor a procedure on the execution stack that has the restore to run) raises

% --- a snapshot serves once ---
%
% PLRM 8.2, restore, closes the sentence quoted above with "This
% restriction applies to save objects": a restore invalidates the save
% object it was handed along with every save object made more recently, so
% a snapshot is good for one restore and no more.
%
% No save object here is named across the restore that spends it: the
% restore reverts userdict, so the second mention fails at name lookup
% and raises undefined without reaching restore at all, which is a
% different question altogether. Where a case cannot hold its object on
% the operand stack -- a case that raises does not carry on, and the
% framework's unwind takes the stack back to where the case found it --
% the object is named while its level still stands and read back before
% the restore.

% A save object records as its level the save-stack count taken before
% it pushed itself, and the save took the snapshot before it made the
% object -- so an object recording the very level being restored to is
% newer than the snapshot that level names, and a stack holding one is a
% stack holding what the restore discards. The operand this restore was
% handed is exempt: PLRM 8.2 has restore "pop its save operand", and it
% is off the operand stack before the stacks are read. A copy of it is
% not, so the refusal falls on the restore that would spend the original
% and no spent object is left holding a stack place.
{ save dup restore } /invalidrestore
    (a copy of the save object may not be kept across the restore) raises
{ save dup restore restore } /invalidrestore
    (so a save object cannot be held back for a second restore) raises

% --- a save object may not be stored where a restore does not reach ---
%
% A save object "is composite and logically belongs to the local VM,
% regardless of the current VM allocation mode" (PLRM 8.2, save), so
% making one an element of a composite object in global VM is the
% invalidaccess PLRM 3.7.2 makes of storing any other local composite
% there. It is refused alongside the three whose values live in a memory
% file, and the array and the dictionary are asked separately because a
% store into each takes a different path to the check -- a dictionary is
% asked once more again for a value defined into it.
%
% This is what leaves a spent save object nowhere to be kept. Global VM
% is the one part of virtual memory a restore does not reach (PLRM
% 3.7.3), and the walk that refuses a restore reads what the stacks hold
% rather than what the objects on them contain, so an object put there
% was outside both rules.
/sr.gl true setglobal 1 array false setglobal def
/sr.gd true setglobal 3 dict false setglobal def
save /sr.a exch def                     % named, so a case that raises can
                                        % be followed by one that does not
{ sr.gl 0 sr.a put } /invalidaccess
    (a save object may not be made an element of a global array) raises
{ sr.gd /s sr.a put } /invalidaccess
    (nor of a global dictionary) raises
{ sr.gd begin /s sr.a def end } /invalidaccess
    (nor defined into one) raises
sr.a restore
{ sr.gl 0 (abc) put } /invalidaccess
    (nor a local string) raises
{ sr.gl 0 3 array put } /invalidaccess
    (nor a local array) raises
{ sr.gl 0 3 dict put } /invalidaccess
    (nor a local dictionary) raises

% and the controls, without which those refusals could be an array that
% takes nothing and a probe that never discriminates. The same element
% takes a simple value and reads it back, and a LOCAL array takes the
% very save object the global one refused -- so what is refused is the
% bank the element lives in, not the operand's type.
sr.gl 0 42 put
sr.gl 0 get 42 eq
    (while a simple value is stored there and reads back) assert
/sr.lo 1 array def
{ save sr.lo 0 3 -1 roll put sr.lo 0 get restore }
    (and a local array takes the save object a global one refuses) works
sr.lo 0 get null eq
    (though the restore winds that local array back, which is why global
     VM was the only place a spent save object could have been kept) assert

% --- a snapshot serves once, and nothing may hold one to serve it twice --
%
% With the store above refused, the only copy of a live save object is a
% copy on a stack, and a stack holding one is itself the reason the
% restore is refused. A refusal winds nothing back, so it spends nothing
% either and the object is still good once no stack holds it.
/sr.d 3 dict def
sr.d /k 0 put
save dup                        % a copy kept back for a second restore
sr.d /k 1 put                   % written under the save
{ restore } /invalidrestore
    (a restore is refused while a stack holds a copy of its operand) raises
{ restore } /invalidrestore
    (and again, the refusal having spent nothing) raises
pop restore                     % the copy dropped, the object still good
sr.d /k get 0 eq
    (and the restore, once the copy is gone, winds its level back) assert

% The sequence that refusal closes: a save object put in global VM and
% spent, a second save taking the level the first named, and the first
% presented again -- a snapshot serving twice, and winding back a level
% it was never taken over. It stops at its first step, and the write made
% under the second save stands.
sr.d /k 0 put
save /sr.a exch def
{ sr.gl 0 sr.a put } /invalidaccess
    (a save object cannot be put out of the walk's sight) raises
sr.a restore                    % so this spends it, and nothing holds it
save pop                        % a second save, standing at the level the
                                % first named and on no stack either
sr.d /k 2 put                   % written under it
sr.d /k get 2 eq
    (and that write stands: no spent save object survives to be presented
     against it) assert

% --- and the controls, which are what make the checks above mean anything --
%
% A check that refused every restore would pass all of the above.

{ save restore } (a save with nothing made under it restores) works

% A simple object holds no storage a restore could discard, so one made
% under the save is no reason to refuse -- the refusals above are for
% what the restore would take away, not for a stack that is not empty.
{ save 42 exch restore pop }
    (an integer made under the save may stay on the operand stack) works

{ 5 string save restore pop } (a string made BEFORE the save may stay) works
{ 3 array save restore pop } (so may an array) works
{ 3 dict save restore pop } (so may a dictionary) works
{ (46>) /ASCIIHexDecode filter save restore closefile }
    (so may a file) works

% Global virtual memory is undisturbed by a restore (PLRM 3.7.3), so an
% object made there under the save is no reason to refuse.
{ save true setglobal 3 array false setglobal exch restore pop }
    (an array made in global VM under the save may stay) works
clear

% The controls for the rule that a snapshot serves once. It is a
% comparison against the depth of the save stack, and one made the other
% way round would refuse every restore there is.

{ save save restore restore }
    (two nested saves restore, innermost first) works
{ save save sr.lo 0 3 -1 roll put sr.lo 0 get restore restore }
    (a save object taken back out of a local array restores, and the
     outer one after it) works
{ save save pop restore }
    (and a restore may pass a level whose save object has been dropped)
    works
{ { save restore } exec } (a save and its restore inside a procedure) works
{ { save restore 1 pop } exec }
    (and inside one still running when the restore is reached) works
{ { save restore } stopped pop }
    (and inside a context that catches what it runs) works

% An object cannot now reach a save level below the one it was made at,
% so every object a save can see was made at or before the level it was
% taken over -- which is the condition the backup stamps are read under,
% and a write under the save is reverted.
/sr.arr 3 array def
save sr.arr 0 42 put restore
sr.arr 0 get null eq
    (a write under a save reverts, the object having stayed at its level) assert

% --- a refused restore leaves the state it found ---
%
% The refusal comes before anything is wound back, so a program that
% handles the error carries on with exactly what it had: the write made
% under the save still stands, the save level is where it was, and the
% operand is back on the stack (PLRM 3.11.1 restores the operands of the
% operator that raised).
/sr.n 3 dict def
sr.n /k 0 put
save dup                    % a copy on the stack, which is what the
                            % restore below is refused for
sr.n /k 7 put               % written under the save
count /sr.count exch def
vmstatus pop pop /sr.level exch def
{ restore } stopped
    { $error /errorname get /invalidrestore eq }{ false } ifelse
    (the restore is refused) assert
sr.n /k get 7 eq (a refused restore winds nothing back) assert
vmstatus pop pop sr.level eq (and leaves the save level where it stood) assert
count sr.count eq (and gives the operand back) assert
pop pop

% --- the graphics and file work a restore does, where it is accepted ---
%
% PLRM 8.2 has restore perform the equivalent of a grestoreall, and PLRM
% 3.8.2 has it close a file created since the save. A refused restore
% reaches neither, so both are asked of one that is accepted.
1 0 0 setrgbcolor
save 0 1 0 setrgbcolor gsave 0 0 1 setrgbcolor restore
currentrgbcolor 0 eq exch 0 eq and exch 1 eq and
    (an accepted restore puts the graphics state back) assert

(4142>) /ASCIIHexDecode filter
save
    1 index << /EODCount 1000 /EODString () /CloseSource true >>
        /SubFileDecode filter pop
restore
dup status not
    (an accepted restore closes a file made under it, and with it the
     source that file was told to close) assert
pop

% the control: status can say a file here is open, so the answer above is
% the close and not an operator that always says no
(4142>) /ASCIIHexDecode filter
save restore
dup status (a file made before the save is left open) assert
closefile

count 0 eq (operand stack is balanced) assert
verdict
flush
quit
