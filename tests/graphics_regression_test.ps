% An embedded Type 1 program: the encrypted portion runs through
% eexec, the charstrings arrive through RD from the decrypted
% stream, and the program closes its own file; the face assembles
% from the written-back program. Top level, since eexec reads the
% file itself.
%!PS-AdobeFont-1.0: TestT1 001.001
11 dict begin
/FontName /TestT1 def
/FontType 1 def
/PaintType 0 def
/FontMatrix [0.001 0 0 0.001 0 0] def
/FontBBox {0 0 1000 1000} def
/Encoding 256 array 0 1 255 {1 index exch /.notdef put} for
dup 65 /sq put readonly def
currentdict end
currentfile eexec
