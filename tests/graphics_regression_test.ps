10 dict begin
begincmap
/CMapName /TestCMap0 def
/CIDSystemInfo << /Registry (T) /Ordering (T) /Supplement 0 >> def
1 begincodespacerange
<0000> <FFFF>
endcodespacerange
1 begincidrange
<0000> <FFFF> 0
endcidrange
endcmap
CMapName currentdict end /CMap defineresource pop
end
