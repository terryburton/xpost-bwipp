% Type 3 fonts serve glyphshow through their BuildGlyph procedure, as
% plotting tools emit them (a name-keyed CharStrings of drawing
% procedures); a font defining only BuildGlyph also answers show
% through the derived BuildChar, and one defining only BuildChar
% serves glyphshow through the code its Encoding assigns the name.
9 dict begin
    /FontType 3 def
    /FontMatrix [0.01 0 0 0.01 0 0] def
    /FontBBox [0 0 100 100] def
    /Encoding 256 array def
    0 1 255 { Encoding exch /.notdef put } for
    Encoding 65 /box put
    /CharStrings << /box { 0 0 60 60 rectfill } /.notdef {} >> def
    /BuildGlyph {
        exch begin
        80 0 setcharwidth
        CharStrings exch 2 copy known not { pop /.notdef } if get exec
        end
    } def
currentdict end
/T3GlyphTest exch definefont pop
/T3GlyphTest findfont 20 scalefont setfont
erasepage
10 16 moveto /box glyphshow
countink 100 ge (BuildGlyph serves glyphshow) assert
currentpoint pop 26 sub abs 0.5 le (the BuildGlyph width advances the pen) assert
erasepage
10 16 moveto (A) show
countink 100 ge (a BuildGlyph-only font answers show) assert
currentpoint pop 26 sub abs 0.5 le (show advances through the derived BuildChar) assert
9 dict begin
    /FontType 3 def
    /FontMatrix [0.01 0 0 0.01 0 0] def
    /FontBBox [0 0 100 100] def
    /Encoding 256 array def
    0 1 255 { Encoding exch /.notdef put } for
    Encoding 66 /tribar put
    /BuildChar {
        exch begin
        80 0 setcharwidth
        Encoding exch get /tribar eq { 0 0 60 30 rectfill } if
        end
    } def
currentdict end
/T3CharTest exch definefont pop
/T3CharTest findfont 20 scalefont setfont
erasepage
10 16 moveto /tribar glyphshow
countink 50 ge (BuildChar serves glyphshow through the Encoding) assert
currentpoint pop 26 sub abs 0.5 le (the BuildChar width advances the pen) assert
erasepage

% --- charpath appends glyph outlines: the path carries curves, fills
%     with its counters intact, and clips like any other path ---
basefont null ne {
    /cpd 4 dict def
    cpd /nc 0 put cpd /nm 0 put
    erasepage
    basefont 40 scalefont setfont
    newpath 8 20 moveto (O) false charpath
    { pop pop cpd /nm 2 copy get 1 add put }
    { pop pop }
    { 6 { pop } repeat cpd /nc 2 copy get 1 add put }
    { }
    pathforall
    cpd /nm get 2 ge (charpath makes a contour per boundary) assert
    cpd /nc get 8 ge (charpath carries curve segments) assert
    fill
    countink 20 ge (charpath fills) assert
    % the counter must stay clear: probe the middle of the O
    23 34 inkat not (charpath fill keeps the counter open) assert
    10 34 inkat (charpath fill marks the ring) assert

    erasepage
    gsave
    newpath 8 20 moveto (O) false charpath clip
    newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
    grestore
    23 34 inkat not (charpath clip keeps the counter open) assert
    10 34 inknear (charpath clip admits the ring) assert
} if

% a many-segment convex clip window (a closed contour ends on its own
% start; the degenerate closing edge must not poison the half-planes)
erasepage
gsave
newpath 32 32 20 0 360 arc closepath clip
newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
grestore
32 32 inkat (a circular clip window admits its centre) assert
countink dup
900 ge (circular clip covers the disk) assert
1600 le (circular clip stays within the disk) assert

% two rectangle clips intersect to a rectangle, and the region still
% answers as one through clippath
gsave
newpath 10 10 40 40 rectclip 20 20 40 40 rectclip
clippath pathbbox 4 array astore
dup 0 get 20 sub abs 0.02 le
1 index 1 get 20 sub abs 0.02 le and
1 index 2 get 50 sub abs 0.02 le and
exch 3 get 50 sub abs 0.02 le and
(two rectangle clips intersect to the rectangle) assert
grestore

% the procedures a program hands pathforall run in the caller's
% environment: a def made inside one must land in the caller's
% dictionary -- the Blue Book's centred-dash program accumulates its
% path length this way
/pfsum 0 def
newpath 10 10 moveto 30 40 lineto 50 10 lineto
{ pop pop } { pop pop /pfsum pfsum 1 add def } { 6 { pop } repeat } { }
pathforall
pfsum 2 eq (pathforall procedures def into the caller's dictionary) assert

% --- arc semantics: sweep direction, current point, segmentation ---
% arc sweeps counterclockwise from angle1 to angle2 and leaves the
% current point at angle2; arcn mirrors. Probed through pathforall,
% independent of any device.
/apd 8 dict def
newpath 30 30 10 0 90 arc
currentpoint
40 (arc leaves the current point at angle2, y) assertnear
30 (arc leaves the current point at angle2, x) assertnear
newpath 30 30 10 90 0 arcn
currentpoint
30 (arcn leaves the current point at angle2, y) assertnear
40 (arcn leaves the current point at angle2, x) assertnear

% counterclockwise from (40,30): the first control point leads upward
apd /c1y null put
newpath 30 30 10 0 90 arc
{ pop pop } { pop pop }
{ pop pop pop pop exch pop
  apd /c1y get null eq { apd /c1y 3 -1 roll put }{ pop } ifelse }
{} pathforall
apd /c1y get 30 gt (arc sweeps counterclockwise) assert

% a full circle is one moveto and four quadrant curves, nothing else
apd /m 0 put apd /l 0 put apd /c 0 put
newpath 40 40 12 0 360 arc
{ pop pop apd /m 2 copy get 1 add put }
{ pop pop apd /l 2 copy get 1 add put }
{ pop pop pop pop pop pop apd /c 2 copy get 1 add put }
{} pathforall
apd /m get 1 eq (a full circle starts with one moveto) assert
apd /l get 0 eq (a full circle has no linetos) assert
apd /c get 4 eq (a full circle is four quadrant curves) assert

% a partial arc splits at the quadrant boundaries it crosses
apd /c 0 put
newpath 40 40 12 45 200 arc
{ pop pop } { pop pop }
{ pop pop pop pop pop pop apd /c 2 copy get 1 add put }
{} pathforall
apd /c get 3 eq (a partial arc splits at quadrant boundaries) assert

% --- arct/arcto: tangent geometry, degenerate forms, errors ---
% arcto reports both tangent points and leaves the current point at
% the second; the results arrive as xt1 yt1 xt2 yt2
newpath 0 0 moveto 100 0 100 100 50 arcto
50 (arcto second tangent point y) assertnear
100 (arcto second tangent point x) assertnear
0 (arcto first tangent point y) assertnear
50 (arcto first tangent point x) assertnear
currentpoint
50 (arcto leaves the current point at the second tangent, y) assertnear
100 (arcto leaves the current point at the second tangent, x) assertnear

% arct builds the same path and reports nothing
count /precount exch def
newpath 0 0 moveto 100 0 100 100 50 arct
count precount eq (arct leaves no results) assert
currentpoint
50 (arct leaves the current point at the second tangent, y) assertnear
100 (arct leaves the current point at the second tangent, x) assertnear

% one moveto, the straight tangent segment, one quadrant curve
apd /m 0 put apd /l 0 put apd /c 0 put
newpath 0 0 moveto 100 0 100 100 50 arct
{ pop pop apd /m 2 copy get 1 add put }
{ pop pop apd /l 2 copy get 1 add put }
{ pop pop pop pop pop pop apd /c 2 copy get 1 add put }
{} pathforall
apd /m get 1 eq (arct starts from the existing current point) assert
apd /l get 1 eq (arct appends the tangent line) assert
apd /c get 1 eq (a 90-degree arct corner is one curve) assert

% the arct path agrees with its explicit lineto+arc expansion (the
% bounding box spans the curves' control hulls, so it checks the
% control points too)
newpath 0 0 moveto 100 0 100 100 50 arct
pathbbox /aury exch def /aurx exch def /ally exch def /allx exch def
newpath 0 0 moveto 50 0 lineto 50 50 50 -90 0 arc
pathbbox
aury (arct matches lineto+arc, ury) assertnear
aurx (arct matches lineto+arc, urx) assertnear
ally (arct matches lineto+arc, lly) assertnear
allx (arct matches lineto+arc, llx) assertnear

% a right-hand turn sweeps the corner clockwise
newpath 0 0 moveto 100 0 100 -100 50 arct
currentpoint
-50 (clockwise arct current point y) assertnear
100 (clockwise arct current point x) assertnear

% collinear rays degenerate to the straight segment, both tangent
% points collapsing onto the corner
newpath 0 0 moveto 50 0 100 0 25 arcto
0 (collinear arcto yt2) assertnear
50 (collinear arcto xt2) assertnear
0 (collinear arcto yt1) assertnear
50 (collinear arcto xt1) assertnear
apd /l 0 put apd /c 0 put
newpath 0 0 moveto 50 0 100 0 25 arct
{ pop pop } { pop pop apd /l 2 copy get 1 add put }
{ pop pop pop pop pop pop apd /c 2 copy get 1 add put }
{} pathforall
apd /l get 1 eq (collinear arct is a line) assert
apd /c get 0 eq (collinear arct has no curve) assert

% errors: a missing current point, a directionless tangent ray, a
% negative radius (a caught continuation leaves its operands: mark
% and clear around each)
mark newpath { 1 2 3 4 5 arct } stopped
/caught exch def cleartomark
caught (arct without a current point is caught) assert
$error /errorname get /nocurrentpoint eq (arct raises nocurrentpoint) assert
mark newpath 0 0 moveto { 0 0 10 10 5 arct } stopped
/caught exch def cleartomark
caught (arct on a degenerate ray is caught) assert
$error /errorname get /undefinedresult eq (arct raises undefinedresult) assert
mark newpath 0 0 moveto { 100 0 100 100 -5 arcto } stopped
/caught exch def cleartomark
caught (arcto with a negative radius is caught) assert
$error /errorname get /rangecheck eq (arcto raises rangecheck) assert
$error /newerror false put

% a rounded rectangle built from four arct corners: filled inside,
% clipped away at the square corner
erasepage
newpath 32 8 moveto
56 8 56 32 16 arct
56 56 32 56 16 arct
8 56 8 32 16 arct
8 8 32 8 16 arct
closepath fill
32 32 inkat (rounded rectangle fills its centre) assert
32 10 inkat (rounded rectangle fills its edge midpoints) assert
10 10 inkat not (rounded rectangle excludes the square corner) assert
54 54 inkat not (rounded rectangle excludes the opposite corner) assert
2 32 inkat not (rounded rectangle stays inside its frame) assert

% pen advances scale linearly: a run of one character is as wide as
% the sum of its parts (the hinter must not round each step)
/Courier findfont 13 scalefont setfont
(iiiiiiiiiiiiiiiiiiii) stringwidth pop
(i) stringwidth pop 20 mul
sub abs 0.01 lt (advances accumulate without per-glyph rounding) assert

% the PostScript style-variant names reach a styled face: bold covers
% more area than regular at the same size
erasepage
/Helvetica findfont 24 scalefont setfont
newpath 4 20 moveto (HHHH) show
countink /apreg exch def
erasepage
/Helvetica-Bold findfont 24 scalefont setfont
newpath 4 20 moveto (HHHH) show
countink apreg gt (Helvetica-Bold resolves to a bold face) assert

% --- text metrics: stringwidth reports the scaled glyph advances ---
% a bold digit spans roughly half its em -- far from the rounded-to-a-
% whole-pixel failure mode of one em per glyph -- and the reported
% width scales linearly with the font size, including sub-unit sizes
/Helvetica-Bold findfont 13 scalefont setfont
(23) stringwidth pop /w13 exch def
w13 13 div dup 0.8 gt exch 1.6 lt and ((23) width is a plausible em fraction) assert
/Helvetica-Bold findfont 1 scalefont setfont
(23) stringwidth pop 13 mul
w13 (stringwidth scales linearly with the font size) assertnear
/Helvetica-Bold findfont 0.62 scalefont setfont
(23) stringwidth pop 13 mul 0.62 div
w13 (a sub-unit font size scales the advances) assertnear

% the pen moves by exactly the width stringwidth reports
erasepage
/Helvetica-Bold findfont 13 scalefont setfont
(23) stringwidth pop /w13 exch def
newpath 4 20 moveto (23) show
currentpoint pop 4 sub
w13 (show advances the pen by stringwidth) assertnear

% --- text colour: glyphs mark in the current colour ---
% white text knocks its ink out of a black field regardless of the
% space the colour was set in, and composite black marks like any fill
erasepage
0 setgray newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
countink /fieldink exch def
0 0 0 0 setcmykcolor
/Helvetica-Bold findfont 24 scalefont setfont
newpath 4 20 moveto (HHH) show
countink fieldink lt (white cmyk text cuts ink out of a black field) assert
0 setgray newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
1 1 1 setrgbcolor
newpath 4 20 moveto (HHH) show
countink fieldink lt (white rgb text cuts ink out of a black field) assert
erasepage
0 0 0 1 setcmykcolor
newpath 4 20 moveto (HHH) show
countink 20 gt (full-black cmyk text marks the page) assert
0 setgray

% --- font identity: scalefont and makefont build dictionaries ---
% scaling a font returns a new dictionary carrying the size in its
% FontMatrix and leaves the operand font untouched. Read the operand's
% own base scale rather than assume one, so the check holds whichever
% face the name resolves to (a Type 1's 0.001 or a TrueType face's em
% scale): the copy carries the size times that base.
/Helvetica-Bold findfont
dup /FontMatrix get 0 get /basefm exch def
dup 13 scalefont
2 copy eq not (scalefont returns a new dictionary) assert
exch /FontMatrix get 0 get
basefm (scalefont leaves the operand font unscaled) assertnear
/FontMatrix get 0 get
basefm 13 mul (scalefont carries the size in the copy's FontMatrix) assertnear

% two sizes of one face coexist: measuring through one dictionary must
% not disturb the other
/Helvetica-Bold findfont 13 scalefont /F13x exch def
/Helvetica-Bold findfont 7 scalefont /F7x exch def
F13x setfont (23) stringwidth pop /wa13 exch def
F7x setfont (23) stringwidth pop /wa7 exch def
F13x setfont (23) stringwidth pop
wa13 (a font is unaffected by uses of its siblings) assertnear
wa13 7 mul
wa7 13 mul (two sizes of one face are in proportion) assertnear

% rendered ink likewise: drawing small, then using the large font,
% then drawing small again yields the same marks
erasepage
F7x setfont newpath 4 20 moveto (23) show
countink /smallink exch def
erasepage
F13x setfont (23) stringwidth pop pop
F7x setfont newpath 4 20 moveto (23) show
countink smallink eq (a font's marks are unaffected by uses of its siblings) assert

% the CTM applies when glyphs are marked, not when the font is scaled:
% a font scaled under a magnified CTM is the same font...
gsave 7 7 scale /Helvetica-Bold findfont 13 scalefont grestore
setfont (23) stringwidth pop
wa13 (scalefont does not bake the CTM of its moment) assertnear

% ...stringwidth reports user space whatever the CTM...
F13x setfont
gsave 7 7 scale (23) stringwidth pop grestore
wa13 (stringwidth is CTM-independent) assertnear

% ...and the CTM in force at show time scales the marks
erasepage
F7x setfont
gsave 2 2 scale newpath 4 12 moveto (23) show grestore
countink smallink gt (the CTM at show time scales the marks) assert

% makefont concatenates its matrix onto the FontMatrix: an anisotropic
% matrix stretches the advances by its x component
/Helvetica-Bold findfont [26 0 0 52 0 0] makefont setfont
(23) stringwidth pop
wa13 2 mul (makefont scales the advances by its x component) assertnear

% a sub-pixel em is served exactly: FreeType cannot size a face below
% a pixel, so the interpreter carries the residual scale itself; the
% advances stay linear all the way down
/Helvetica-Bold findfont 0.25 scalefont setfont
(23) stringwidth pop 13 mul 0.25 div
wa13 (a sub-pixel em scales the advances) assertnear

% and a sub-pixel em under a magnifying CTM marks like the equivalent
% point size: 0.3 em drawn at 40x covers the ink of 12 pt within a
% rasterization tolerance
erasepage
/Helvetica-Bold findfont 12 scalefont setfont
newpath 4 20 moveto (6) show
countink /ink12 exch def
erasepage
/Helvetica-Bold findfont 0.3 scalefont setfont
gsave 40 40 scale newpath 0.1 0.5 moveto (6) show grestore
countink ink12 sub abs
ink12 0.15 mul lt (a sub-pixel em under a magnifying CTM marks at full size) assert

% an annulus clip built the standard way: the closepath's point bridges
% into the inner subpath by a straight line, so the region arrives as
% one keyhole path; the clipper must split it at the close, peel the
% doubled bridge edge, and subtract the opposite-wound inner ring
erasepage
gsave
newpath 32 32 24 0 360 arc closepath
        32 32 12 360 0 arcn closepath
clip
newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
grestore
32 14 inkat (ring clip admits the band) assert
14 32 inkat (ring clip admits the band on the other axis) assert
32 32 inkat not (ring clip excludes the hole) assert
32 4 inkat not (ring clip excludes outside the outer circle) assert

% Insideness testing: the probe pixel or aperture region intersects
% the spans the painting operator would mark. Point results at edges
% are half-open in device space; the clip does not participate
initgraphics
newpath 10 10 moveto 20 10 lineto 20 20 lineto 10 20 lineto closepath
15 15 infill (infill inside) assert
25 15 infill not (infill outside) assert
10.01 15 infill (infill just inside the edge) assert
9.99 15 infill not (infill just outside the edge) assert
10 15 infill (infill on the near edge) assert
20 15 infill not (infill on the far edge) assert
15 15 infill pop
currentpoint pop 10 eq (infill leaves the current path) assert
gsave
newpath 0 0 moveto 5 0 lineto 5 5 lineto 0 5 lineto closepath clip
newpath 10 10 moveto 20 10 lineto 20 20 lineto 10 20 lineto closepath
15 15 infill (infill disregards the clip) assert
grestore
newpath
15 15 infill not (infill of an empty path) assert
newpath 0 0 moveto 30 0 lineto 30 30 lineto 0 30 lineto closepath
        10 10 moveto 20 10 lineto 20 20 lineto 10 20 lineto closepath
15 15 ineofill not (ineofill sees the even-odd hole) assert
5 15 ineofill (ineofill inside the ring) assert
15 15 infill (infill fills the nonzero hole) assert
{ 14 14 16 16 setbbox 14 14 moveto 16 14 lineto 16 16 lineto closepath }
ineofill not (an aperture inside the hole misses) assert
{ 18 18 40 40 setbbox 18 18 moveto 25 18 lineto 25 25 lineto closepath }
infill (an overlapping aperture hits) assert
{ 40 40 50 50 setbbox 40 40 moveto 50 40 lineto 50 50 lineto closepath }
infill not (a disjoint aperture misses) assert
newpath 10 10 moveto 20 10 lineto
5 setlinewidth
15 11 instroke (instroke within the stroke width) assert
15 14 instroke not (instroke beyond the stroke width) assert

% PLRM setlinewidth puts half the ABSOLUTE value of the number on each
% side of the path, so a width and its negation describe the same pen.
% The parameter itself is the number that was set, which is what
% currentlinewidth answers with -- only the pen takes the magnitude.
% A negative width used as given collapses one side of the outline, and
% what that leaves is a narrower line rather than an error, so this asks
% how far the pen reaches rather than whether the stroke succeeded.
newpath 10 10 moveto 20 10 lineto
-5 setlinewidth
% the parameter keeps the number; only the pen takes the magnitude, so
% this fails if the absolute value is taken in the setter instead
currentlinewidth -5 eq (a negative width is reported as it was set) assert
% 2.4 from the path is inside a pen of half-width 2.5 and outside the
% half-pixel pen a collapsed side leaves, so this is the distance that
% separates the two readings -- nearer than 2.5 and both answer yes
15 12.4 instroke (a negative width reaches half its magnitude) assert
15 14 instroke not (and no further than half its magnitude) assert
-5 setlinewidth 15 12.4 instroke
 5 setlinewidth 15 12.4 instroke eq
    (a width and its negation cover the same pixels) assert
1 setlinewidth

% PLRM setdash's offset is a phase into the dash pattern, not a distance
% measured forward from the path, and the pattern repeats: an offset and
% the same offset a whole number of cycles away are the same phase, so a
% negative one names the phase that far before the pattern begins. It is
% neither refused nor read as its magnitude, and what it produces when
% it is used as given is a first dash longer than the pattern names --
% a plausible dashed line rather than a failure -- so these ask where
% the ink landed.
newpath 10 10 moveto 40 10 lineto
% [2 1] repeats every 3 units, so -1 is the phase 2 gives. Half a unit
% along the path is inside the dash at phase 0 and inside the leading
% gap at phase 2; a unit further on and both phases are painting, so
% this is the distance that separates them.
[2 1] 0 setdash 10.5 10 instroke (a dash begins at phase 0) assert
[2 1] 2 setdash 10.5 10 instroke not (phase 2 begins in the gap) assert
[2 1] -1 setdash 10.5 10 instroke not
    (a negative offset is the phase one cycle further on) assert
[2 1] -4 setdash 10.5 10 instroke not
    (and the same phase another cycle back) assert
% An odd-length array only returns a dash to a dash after two passes, so
% [3] repeats every 6 units rather than 3 and -3 is the phase 3 gives.
% Carried back by the sum of the elements instead of by the cycle it
% would paint the dash where the gap belongs, which is what the first of
% these catches; the second holds the dash that follows.
[3] 3 setdash 10.5 10 instroke not (an odd-length pattern at phase 3 starts in the gap) assert
[3] -3 setdash 10.5 10 instroke not
    (a negative offset is carried back by the whole cycle) assert
[3] -3 setdash 13.5 10 instroke (and the dash follows that gap) assert
[] 0 setdash
5 2 { 0 0 8 8 setbbox 0 0 moveto 8 0 lineto 8 8 lineto closepath }
inufill (inufill inside the triangle) assert
2 7 { 0 0 8 8 setbbox 0 0 moveto 8 0 lineto 8 8 lineto closepath }
inufill not (inufill outside the triangle) assert
15 11.4 { 10 10 20 12 setbbox 10 10 moveto 20 10 lineto } [1 0 0 4 0 0]
inustroke (inustroke shapes the pen by the matrix) assert
15 11.4 { 10 10 20 12 setbbox 10 10 moveto 20 10 lineto }
inustroke not (inustroke without the matrix keeps the pen) assert
newpath

% Smooth shading of the function-based and patch types reaches the
% raster with each declared corner colour in its corner; a mesh
% carrying a Function maps its parametric values through it
/shbuf 200 string def
/shp 0 def
/pb { shbuf shp 3 -1 roll put /shp shp 1 add def } def
/pw { dup 256 idiv pb 256 mod pb } def
/ppt { % x y (user units, 0..8)
    exch 8 div 65535 mul round cvi pw
    8 div 65535 mul round cvi pw
} def
/rgbat { % x y . r g b
    DEV2 dup /GetPix get exec
} def
graphicsdict /currgstate get /device DEV2 put
matrix setmatrix

% type 6: a square patch with straight edges, corners RGBY
/shp 0 def
0 pb
0 0 ppt  0 8 3 div ppt  0 16 3 div ppt  0 8 ppt
8 3 div 8 ppt  16 3 div 8 ppt  8 8 ppt
8 16 3 div ppt  8 8 3 div ppt  8 0 ppt
16 3 div 0 ppt  8 3 div 0 ppt
255 pb 0 pb 0 pb   0 pb 255 pb 0 pb
0 pb 0 pb 255 pb   255 pb 255 pb 0 pb
DEV2 zerorgb
<<
  /ShadingType 6 /ColorSpace /DeviceRGB
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1 0 1 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
1 1 rgbat 100 lt exch 100 lt and exch 150 gt and
(the Coons corner c1 is red) assert
1 6 rgbat 100 lt exch 150 gt and exch 100 lt and
(the Coons corner c2 is green) assert
6 6 rgbat 150 gt exch 100 lt and exch 100 lt and
(the Coons corner c3 is blue) assert
6 1 rgbat 100 lt exch 150 gt and exch 150 gt and
(the Coons corner c4 is yellow) assert

% type 7: the same square as a tensor patch, interior at the thirds
/shp 0 def
0 pb
0 0 ppt  0 8 3 div ppt  0 16 3 div ppt  0 8 ppt
8 3 div 8 ppt  16 3 div 8 ppt  8 8 ppt
8 16 3 div ppt  8 8 3 div ppt  8 0 ppt
16 3 div 0 ppt  8 3 div 0 ppt
8 3 div 8 3 div ppt  8 3 div 16 3 div ppt
16 3 div 16 3 div ppt  16 3 div 8 3 div ppt
255 pb 0 pb 0 pb   0 pb 255 pb 0 pb
0 pb 0 pb 255 pb   255 pb 255 pb 0 pb
DEV2 zerorgb
<<
  /ShadingType 7 /ColorSpace /DeviceRGB
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1 0 1 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
1 1 rgbat 100 lt exch 100 lt and exch 150 gt and
(the tensor corner c1 is red) assert
6 6 rgbat 150 gt exch 100 lt and exch 100 lt and
(the tensor corner c3 is blue) assert

% type 1: a sampled two-input function, corner samples RGBY
DEV2 zerorgb
<<
  /ShadingType 1 /ColorSpace /DeviceRGB
  /Domain [0 1 0 1] /Matrix [8 0 0 8 0 0]
  /Function <<
    /FunctionType 0 /Domain [0 1 0 1] /Range [0 1 0 1 0 1]
    /Size [2 2] /BitsPerSample 8
    /DataSource <ff000000ff000000ffffff00>
  >>
>> shfill
0 0 rgbat 100 lt exch 100 lt and exch 150 gt and
(the function shading corner is red) assert
7 0 rgbat 100 lt exch 150 gt and exch 100 lt and
(the function shading corner is green) assert
0 7 rgbat 150 gt exch 100 lt and exch 100 lt and
(the function shading corner is blue) assert
7 7 rgbat 100 lt exch 150 gt and exch 150 gt and
(the function shading corner is yellow) assert

% type 5 with a Function: parametric values map through it
/shp 0 def
0 0 ppt 0 pb   8 0 ppt 0 pb
0 8 ppt 255 pb 8 8 ppt 255 pb
DEV2 zerorgb
<<
  /ShadingType 5 /ColorSpace /DeviceRGB /VerticesPerRow 2
  /BitsPerCoordinate 16 /BitsPerComponent 8
  /Decode [0 8 0 8 0 1]
  /Function << /FunctionType 2 /Domain [0 1] /N 1
               /C0 [1 0 0] /C1 [0 0 1] >>
  /DataSource shbuf 0 shp getinterval
>> shfill
4 0 rgbat 100 lt exch 100 lt and exch 150 gt and
(a Function mesh starts at C0) assert
4 7 rgbat 150 gt exch 100 lt and exch 100 lt and
(a Function mesh ends at C1) assert

% A mesh whose colours are tints -- Separation or DeviceN -- runs the
% space's transform once per triangle, and the space the program set is
% what the graphics state holds when the triangle is filled. The mesh
% painters resolve the alternative space before the first triangle
% rather than entering it again at each one, so what each triangle is
% left to do is asked for here directly.

% the transform's colours reach the raster: (b s) becomes (b, s, 0), so
% each corner's tints name its pixel
/ShTintRGB [ /DeviceN [ (A) (B) ] /DeviceRGB { 0 } ] def
/shp 0 def
0 pb 0 0 ppt 255 pb   0 pb
0 pb 8 0 ppt   0 pb 255 pb
0 pb 0 8 ppt   0 pb   0 pb
DEV2 zerorgb
<<
  /ShadingType 4 /ColorSpace ShTintRGB
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
0 0 rgbat 100 lt exch 100 lt and exch 150 gt and
    (a DeviceN mesh corner takes its first tint) assert
7 0 rgbat 100 lt exch 150 gt and exch 100 lt and
    (a DeviceN mesh corner takes its second tint) assert
0 7 rgbat 100 lt exch 100 lt and exch 100 lt and
    (a DeviceN mesh corner takes both tints at zero) assert

% the space the program set is the space in force when the triangle is
% filled, and a /None separation is a space that marks nothing: a mesh
% left in the alternative space instead would paint every triangle
/ShNone [ /Separation /None /DeviceRGB { pop 1 0 0 } ] def
/shp 0 def
0 pb 0 0 ppt 255 pb
0 pb 8 0 ppt 255 pb
0 pb 0 8 ppt 255 pb
DEV2 zerorgb
<<
  /ShadingType 4 /ColorSpace ShNone
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
1 1 rgbat 0 eq exch 0 eq and exch 0 eq and
    (a None separation mesh marks nothing) assert

% the transform is called with the colour the alternative space is
% entered holding, not with the colour the triangle before it left: one
% that adds to what it reads paints one flat colour rather than a ramp
/ShCarry [ /DeviceN [ (A) (B) ] /DeviceRGB
           { pop pop currentrgbcolor pop pop 0.5 add dup dup } ] def
/shp 0 def
0 pb 0 0 ppt 255 pb   0 pb
0 pb 8 0 ppt   0 pb 255 pb
0 pb 0 8 ppt   0 pb   0 pb
DEV2 zerorgb
<<
  /ShadingType 4 /ColorSpace ShCarry
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
0 0 rgbat pop pop /shcarry0 exch def
5 1 rgbat pop pop /shcarry1 exch def
shcarry0 shcarry1 eq
    (a tint transform reads the same colour at every triangle) assert
shcarry0 200 lt (and that colour is the one the space is entered holding) assert

% and currentcolor answers it with the alternative space's components,
% not with the tints of the space being converted: three components
% rather than two
/ShComps [ /DeviceN [ (A) (B) ] /DeviceRGB
           { pop pop [ currentcolor ] length 3 eq
             { 1 1 1 }{ 1 0 0 } ifelse } ] def
/shp 0 def
0 pb 0 0 ppt 255 pb   0 pb
0 pb 8 0 ppt   0 pb 255 pb
0 pb 0 8 ppt   0 pb   0 pb
DEV2 zerorgb
<<
  /ShadingType 4 /ColorSpace ShComps
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
1 1 rgbat 150 gt exch 150 gt and exch 150 gt and
    (a tint transform reads the alternative space's components) assert

% a device that keeps separations of its own is offered every triangle's
% tint and files it: such a mesh is one whose colours do not convert the
% same way at every triangle, and it goes the way every other colour of
% its space goes
% the count lands in an array rather than under a name: the device
% method runs with the machinery's own dictionary current, where a
% definition would land somewhere the assertion below cannot read
/shsepn [ 0 ] def
DEV2 /.registersep {  % tint space IMAGE  .  index true | tint false
    pop pop pop shsepn 0 shsepn 0 get 1 add put 0 true
} put
/ShKept [ /Separation (Spot) /DeviceRGB { dup dup } ] def
/shp 0 def
0 pb 0 0 ppt 255 pb
0 pb 8 0 ppt 128 pb
0 pb 0 8 ppt   0 pb
DEV2 zerorgb
<<
  /ShadingType 4 /ColorSpace ShKept
  /BitsPerCoordinate 16 /BitsPerComponent 8 /BitsPerFlag 8
  /Decode [0 8 0 8 0 1]
  /DataSource shbuf 0 shp getinterval
>> shfill
DEV2 /.registersep undef
% one call is the colour the space is entered holding; a mesh that took
% the short way round would add none to it
shsepn 0 get 1 gt
    (a device that keeps separations is offered every mesh tint) assert

graphicsdict /currgstate get /device DEV put
initgraphics

% Byte-mapped composite fonts: each mapping hands the declared
% descendant the right code, shown by the descendants' distinct
% advances and by the codes cshow reports. Each descendant counts the
% characters it is asked to build, which is what makes the order a walk
% measures in visible.
/fm.nb 0 def
/FmA << /FontType 3 /FontMatrix matrix /FontBBox [0 0 0 0]
  /Encoding 256 array 0 1 255 { 1 index exch /.notdef put } for
  /BuildChar { pop pop /fm.nb fm.nb 1 add store 7 0 setcharwidth } bind
>> definefont pop
/FmB << /FontType 3 /FontMatrix matrix /FontBBox [0 0 0 0]
  /Encoding 256 array 0 1 255 { 1 index exch /.notdef put } for
  /BuildChar { pop pop /fm.nb fm.nb 1 add store 11 0 setcharwidth } bind
>> definefont pop
/fm.desc [ /FmA findfont /FmB findfont ] def
/fm.w { % string composite . wx
    findfont setfont stringwidth pop
} def
/Fm2 << /FontType 0 /FMapType 2 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<0041 0141> /Fm2 fm.w 18 (an 8/8 code selects by its first byte) assertnear
/Fm4 << /FontType 0 /FMapType 4 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 C1> /Fm4 fm.w 18 (a 1/7 code selects by its top bit) assertnear
/Fm5 << /FontType 0 /FMapType 5 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<0041 00C1> /Fm5 fm.w 18 (a 9/7 code selects by its top nine bits) assertnear
/Fm6 << /FontType 0 /FMapType 6 /FontMatrix matrix /SubsVector <003497>
        /Encoding [0 1 0] /FDepVector fm.desc >> definefont pop
<33 41> /Fm6 fm.w 18 (SubsVector codes select by their range) assertnear
<CB> /Fm6 fm.w 7 (a code past every range lands one font beyond) assertnear
% cshow reports the decoded codes with the descendant's widths
/Fm2 findfont setfont
mark { pop exch } <0041 0142> cshow ]
dup length 4 eq
1 index 1 get 65 eq and
1 index 3 get 66 eq and
1 index 0 get 7 sub abs 0.01 lt and
exch 2 get 11 sub abs 0.01 lt and
(cshow reports byte-mapped codes and widths) assert
% and it hands the procedure exactly three operands, so a procedure that
% takes all three comes back with the stacks as it found them, having run
% once per decoded character under the descendant the mapping selected
% (PLRM 8.2)
/fm.n 0 def
/fm.seen [] def
/Fm2 findfont setfont
count /fm.d0 exch def
{ /fm.n fm.n 1 add store
  /fm.seen [ fm.seen aload pop currentfont ] store
  pop pop pop } <0041 0142> cshow
count fm.d0 eq (a cshow procedure that takes its three operands balances) assert
fm.n 2 eq (cshow calls it once per decoded character) assert
fm.seen length 2 eq
fm.seen 0 get /FontType get 3 eq and
fm.seen 1 get /FontType get 3 eq and
fm.seen 0 get fm.seen 1 get ne and
(cshow runs the procedure under the descendant the mapping selected) assert
currentfont /Fm2 findfont eq (and puts the composite back afterwards) assert
% each width is taken as the walk reaches its character, not all of them
% before the first call: the descendant builds one more glyph between
% one call and the next
/fm.seenb [] def
/fm.nb 0 store
{ /fm.seenb [ fm.seenb aload pop fm.nb ] store pop pop pop } <0058 0159 005A> cshow
fm.seenb length 3 eq
fm.seenb 0 get 1 eq and
fm.seenb 1 get 2 eq and
fm.seenb 2 get 3 eq and
(cshow measures each character where it reaches it) assert
% the modal mappings: an escape or shift selects for what follows,
% and the selection resets at each show operation
/Fm3 << /FontType 0 /FMapType 3 /FontMatrix matrix /EscChar 255
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 FF01 42 43> /Fm3 fm.w 29 (an escape selects for the rest) assertnear
<41 42> /Fm3 fm.w 14 (the selection resets between shows) assertnear
<FF01 41 FF00 42> /Fm3 fm.w 18 (escapes switch back and forth) assertnear
/fm.e300 300 array 0 1 299 { 1 index exch 0 put } for
    dup 257 1 put def
/Fm7 << /FontType 0 /FMapType 7 /FontMatrix matrix /EscChar 255
        /Encoding fm.e300 /FDepVector fm.desc >> definefont pop
<FFFF01 41 42> /Fm7 fm.w 22 (a doubled escape reaches past 255) assertnear
/Fm8 << /FontType 0 /FMapType 8 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 0E 42 43 0F 44> /Fm8 fm.w 36 (shift bytes toggle the two fonts) assertnear
% stringwidth needs no currentpoint of its own
newpath
<41> /Fm4 fm.w 7 (stringwidth measures without a currentpoint) assertnear

% colorimage pulls its procedure source once per row, not once for
% the image: the last row's colour arrives only if every call
% happened (a bare name fetch once ran the procedure and left its
% first chunk standing in for the whole image)
graphicsdict /currgstate get /device DEV2 put
matrix setmatrix
DEV2 zerorgb
/ci.data 192 string def
0 1 167 { ci.data exch 0 put } for
168 1 191 { ci.data exch dup 168 sub 3 mod 1 eq { 255 }{ 0 } ifelse put } for
userdict /ci.pos 0 put
gsave
8 8 scale
8 8 8 [8 0 0 -8 0 8]
{ ci.data userdict /ci.pos get 24 getinterval
  userdict /ci.pos 2 copy get 24 add put }
false 3 colorimage
grestore
userdict /ci.pos get 192 eq (colorimage consumes every row's chunk) assert
4 0 rgbat 100 lt exch 150 gt and exch 100 lt and
(the last row's colour reaches the raster) assert
4 7 rgbat 100 lt exch 100 lt and exch 100 lt and
(the first row stays its own colour) assert
graphicsdict /currgstate get /device DEV put
initgraphics

% Interpolate reaches the planar, masked and clipped image shapes:
% samples ramp between their neighbours while a mask still decides
% each pixel by its nearest sample
graphicsdict /currgstate get /device DEV2 put
matrix setmatrix
DEV2 zerorgb
/DeviceRGB setcolorspace
gsave
8 8 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1 0 1 0 1]
   /Interpolate true /MultipleDataSources true
   /DataSource [ <00 ff 00 ff> <00 00 ff ff> <80 80 80 80> ]
>> image
grestore
1 4 rgbat pop pop /ip.l exch def
6 4 rgbat pop pop /ip.r exch def
ip.r ip.l sub 100 gt (a planar image ramps under Interpolate) assert
4 4 rgbat pop pop dup 40 gt exch 215 lt and
(the ramp passes through the blend) assert
DEV2 zerorgb
gsave
8 8 scale
<< /ImageType 3 /InterleaveType 3
   /DataDict << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
      /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1 0 1 0 1]
      /Interpolate true
      /DataSource <00ff00 ff0000 0000ff 00ff00> >>
   /MaskDict << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 1
      /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1]
      /DataSource <80 00> >>
>> image
grestore
1 6 rgbat 5 lt exch 5 lt and exch 5 lt and
(the masked corner stays unpainted) assert
5 6 rgbat pop pop /ip.a exch def
7 6 rgbat pop pop /ip.b exch def
ip.a ip.b ne (the unmasked cells ramp rather than step) assert
DEV2 zerorgb
gsave
newpath 0 0 moveto 8 0 lineto 0 8 lineto closepath clip
8 8 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1 0 1 0 1]
   /Interpolate true
   /DataSource <ff0000 00ff00 0000ff ffff00>
>> image
grestore
1 1 rgbat 100 gt 3 1 roll pop pop
(the clipped interpolated image paints inside) assert
7 7 rgbat 5 lt exch 5 lt and exch 5 lt and
(the clipped interpolated image spares outside) assert
graphicsdict /currgstate get /device DEV put
initgraphics

% These four devices are emitted directly rather than through a page,
% so each is handed the two names a transmitted page would have put on
% it: the output name the device was made under, and the name settled
% for the page being written, which is what an Emit opens.
%
% The TIFF device frames the rgb raster as a baseline TIFF: the
% little-endian header, a directory whose width entry answers, and
% one uncompressed strip of the pixels
/DEVT 8 8 .privatedict /newTIFFIMAGEdevice get exec def
DEVT /OutputFileName (graphics.scratch) put
DEVT /.outputfile (graphics.scratch) put
DEVT zerorgb
1 1 0 2 2 4 4 DEVT dup /FillRect get exec
DEVT dup /Emit get exec
/tf.h (graphics.scratch) (r) file 500 string readstring pop def
tf.h 0 get 16#49 eq tf.h 1 get 16#49 eq and
tf.h 2 get 42 eq and (the TIFF opens little-endian with its magic) assert
% the directory follows the compressed strip at the patched offset
/tf.le4 { % pos . v
    /tf.p exch def 0
    3 -1 0 { tf.p add tf.h exch get exch 256 mul add } for
} def
/tf.ifd 4 tf.le4 def
tf.ifd 8 gt (the directory offset patches past the strip) assert
tf.h tf.ifd 2 add 12 3 mul add get 3 eq
tf.h tf.ifd 2 add 12 3 mul add 1 add get 1 eq and
(the fourth directory entry is the compression tag) assert
tf.h tf.ifd 2 add 12 3 mul add 8 add get 5 eq
(the strip compresses with the shared coder) assert
% decoding the strip recovers the painted pixel
/tf.rt 192 string def
(graphics.scratch) (r) file dup 8 setfileposition
/LZWDecode filter tf.rt readstring pop pop
tf.rt 2 8 mul 2 add 3 mul get 255 eq
tf.rt 2 8 mul 2 add 3 mul 1 add get 255 eq and
tf.rt 2 8 mul 2 add 3 mul 2 add get 0 eq and
(the strip carries the painted pixel) assert

% The distilled-ps device wraps the recorded marks in document
% structure and a prolog naming the accumulated operators
/DEVP 100 100 .privatedict /newDSCWRITEdevice get exec def
DEVP /OutputFileName (graphics.scratch) put
DEVP /.outputfile (graphics.scratch) put
0.5 10 10 30 20 DEVP dup /FillRect get exec
DEVP dup /Emit get exec
% the distilled program spans pages, so Destroy writes the trailer that closes
% the document; read the completed file after it
DEVP dup /Destroy get exec
/pw.s (graphics.scratch) (r) file 4096 string readstring pop def
pw.s (%!PS-Adobe-3.0) anchorsearch { pop pop true }{ pop false } ifelse
(the distilled page opens with its DSC header) assert
pw.s (re\nf\n) search { pop pop pop true }{ pop false } ifelse
(the recorded rectangle reaches the page) assert
pw.s (%%EOF) search { pop pop pop true }{ pop false } ifelse
(the distilled page closes with its trailer) assert

% The vector writers take whole sampled images: the pdf device files
% an image object the page references, and the svg device embeds the
% bitmap as a data URI; both leave the masked forms to the painters
/DEVV 100 100 .privatedict /newPDFWRITEdevice get exec def
DEVV /OutputFileName (graphics.scratch) put
DEVV /.outputfile (graphics.scratch) put
graphicsdict /currgstate get /device DEVV put
matrix setmatrix
gsave 10 10 translate 40 40 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1]
   /DataSource <11 55 aa ee> >> image
grestore
DEVV dup /Emit get exec
% the pdf spans pages, so Destroy writes the cross-reference table and trailer
% that close the document; read the completed file after it
DEVV dup /Destroy get exec
/vw.s (graphics.scratch) (r) file 4096 string readstring pop def
vw.s (%PDF-1.4) anchorsearch { pop pop true }{ pop false } ifelse
(the pdf page opens with its header) assert
vw.s (/Subtype /Image) search { pop pop pop true }{ pop false } ifelse
(the sampled image files as an image object) assert
vw.s (/XObject) search { pop pop pop true }{ pop false } ifelse
(the page resources reference the image) assert
/DEVW 100 100 .privatedict /newSVGWRITEdevice get exec def
DEVW /OutputFileName (graphics.scratch) put
DEVW /.outputfile (graphics.scratch) put
graphicsdict /currgstate get /device DEVW put
matrix setmatrix
gsave 10 10 translate 40 40 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1]
   /DataSource <11 55 aa ee> >> image
grestore
DEVW dup /Emit get exec
/vw.s (graphics.scratch) (r) file 4096 string readstring pop def
% PNG where the build can write one and the bitmap format where it
% cannot; both are embedded the same way, as a data URI the image
% refers to through the xlink namespace
vw.s (data:image/png;base64,) search { pop pop pop true }{ pop
  vw.s (data:image/bmp;base64,) search { pop pop pop true }{ pop false } ifelse
} ifelse
(the svg page embeds the bitmap as a data URI) assert
vw.s (xlink:href=) search { pop pop pop true }{ pop false } ifelse
(the svg page refers to it through the xlink namespace) assert
DEVW dup /Destroy get exec
graphicsdict /currgstate get /device DEV put
initgraphics

% Holding a form: the paint runs once for the form and the
% transformation it stands under; later executions place what it
% painted, uncovered pixels keep the page beneath, a new transformation
% is a new drawing, and an unwritable dictionary paints directly every
% time
erasepage
userdict /fm.n 0 put
/FmCached << /FormType 1 /Matrix [1 0 0 1 0 0] /BBox [0 0 16 16]
    /PaintProc { pop
        userdict /fm.n 2 copy get 1 add put
        0 setgray 2 2 12 12 rectfill } >> def
gsave 4 4 translate FmCached execform grestore
userdict /fm.n get 1 eq (the capture runs the paint once) assert
countink /fm.one exch def
gsave 36 4 translate FmCached execform grestore
userdict /fm.n get 1 eq (a second execution places what was painted) assert
countink fm.one 2 mul eq (the replay lands the same marks) assert
% uncovered pixels keep what the page held
erasepage
0 setgray 0 24 64 8 rectfill
/fm.bg countink def
gsave 8 20 translate FmCached execform grestore
9 25 inkat (the stripe shows through the form's uncovered margin) assert
% a rotated transformation is a different key
gsave 32 32 translate 30 rotate FmCached execform grestore
userdict /fm.n get 2 eq (a new transformation captures afresh) assert
% readonly forms paint afresh every time
userdict /fm.m 0 put
/FmPlain << /FormType 1 /Matrix [1 0 0 1 0 0] /BBox [0 0 8 8]
    /PaintProc { pop
        userdict /fm.m 2 copy get 1 add put
        0 setgray 0 0 8 8 rectfill } >> readonly def
erasepage
FmPlain execform
FmPlain execform
userdict /fm.m get 2 eq (an unwritable form paints directly each time) assert
initgraphics

% a font dictionary's entries carry the attributes a program reads:
% the matrix is data, the bounding box answers executable, and the
% encoding is data
basefont null ne {
    basefont /FontMatrix get xcheck not
    (a font matrix is literal) assert
    basefont /FontBBox get xcheck
    (a font bounding box is executable) assert
    basefont /Encoding get xcheck not
    (a font encoding is literal) assert
} if
% --- procedure-implemented standard operators stand as operators ---
% load answers operatortype for them, so bind substitutes them and the
% classic self-redefinition idiom captures the standard behaviour
% instead of recursing into the new definition
/stroke load type /operatortype eq (stroke loads as an operator) assert
/fill load type /operatortype eq (fill loads as an operator) assert
/show load type /operatortype eq (show loads as an operator) assert
gsave
/bnd.st /stroke load def
/stroke { 2 2 scale stroke } bind def
newpath 10 10 moveto 20 20 lineto stroke
userdict /stroke undef   % drop the shadow; the standard stroke returns
userdict /bnd.st undef
true (a bound self-redefinition of stroke terminates) assert
grestore

% an error that unwinds out of a wrapped operator is the operator's
% error: it names the command, and the stacks return to their depths
% at the call -- what the procedure part-way pushed drops, operands
% still in place stay
/ep.op /ep.testname { (j1) (j2) ep.doesnotexist } .wrapop def
count /ep.d0 exch def
1 2 { ep.op } stopped
(the wrapped-operator error is caught) assert
$error /command get dup type /operatortype eq
exch 32 string cvs (ep.testname) eq and
(an error in a wrapped operator names the operator) assert
count ep.d0 sub 2 eq (the operand depth at the call comes back) assert
pop pop
% nested wrapped calls report the innermost and unwind to the caller
/ep.in /ep.inner { 7 8 ep.alsomissing } .wrapop def
/ep.out /ep.outer { (x) (y) ep.in } .wrapop def
count /ep.d1 exch def
{ ep.out } stopped pop
$error /command get 32 string cvs (ep.inner) eq
(a nested wrapped error names the innermost operator) assert
count ep.d1 eq (a nested wrapped error unwinds the operand junk) assert
% a wrapper that catches its own error keeps its own state
/ep.c /ep.catcher { (kept) { ep.gone } stopped pop } .wrapop def
ep.c (kept) eq (a wrapper catching its own error keeps its stack) assert
% the dict stack comes back when the procedure dies inside a begin
countdictstack /ep.dd exch def
/ep.d /ep.dicty { 5 dict begin ep.nothere } .wrapop def
{ ep.d } stopped pop
countdictstack ep.dd eq (the dict depth at the call comes back) assert

% --- runaway recursion meets the execution-stack ceiling ---
% a procedure that calls itself without limit, and a wrapped operator
% doing the same, raise a catchable execstackoverflow instead of
% consuming memory without bound
/eso.p { eso.p 1 pop } def
{ eso.p } stopped
(runaway procedure recursion is caught) assert
$error /errorname get 32 string cvs (execstackoverflow) eq
(runaway procedure recursion raises execstackoverflow) assert
/eso.w /eso.w { eso.w } .wrapop def
{ eso.w } stopped
(runaway wrapped recursion is caught) assert
$error /errorname get 32 string cvs (execstackoverflow) eq
(runaway wrapped recursion raises execstackoverflow) assert
% the other stacks have ceilings too: a loop pushing operands without
% bound overflows the operand stack, one beginning dicts without end
% overflows the dictionary stack, and both errors are catchable
{ { 1 } loop } stopped
(a runaway operand-pushing loop is caught) assert
$error /errorname get 32 string cvs (stackoverflow) eq
(a runaway operand-pushing loop raises stackoverflow) assert
clear
countdictstack /eso.dd exch def
{ { 1 dict begin } loop } stopped
(a runaway dict-begin loop is caught) assert
$error /errorname get 32 string cvs (dictstackoverflow) eq
(a runaway dict-begin loop raises dictstackoverflow) assert
countdictstack eso.dd sub { end } repeat
clear % the interrupted loop's pending operands

% --- machinery runs a program's procedures on the program's stacks ---
% a callback's defs reach the program's dictionaries, and names the
% machinery uses privately (str, proc, i, pend...) are out of reach:
% defining them in a callback must not corrupt the machinery
/Courier findfont 10 scalefont setfont
gsave
100 100 moveto
{ pop pop /str (mine) def /proc 7 def /iso.k true def } (ab) kshow
grestore
iso.k (a kshow procedure runs on the caller's stacks) assert
str (mine) eq (a kshow procedure's defs reach the caller) assert
userdict /str undef userdict /proc undef userdict /iso.k undef
count /iso.kd exch def
gsave 100 100 moveto { pop pop (k) } (abc) kshow grestore
count iso.kd sub 2 eq (a kshow procedure's stack results survive) assert
pop pop
/iso.c 0 def
gsave 100 100 moveto
{ pop pop pop /iso.c iso.c 1 add def } (ab) cshow
grestore
iso.c 2 eq (a cshow procedure runs per character on the caller's stacks) assert
userdict /iso.c undef

% --- the machinery's internal references are frozen: a program
% shadowing a core operator name reaches only its own calls ---
userdict /exch 99 put
gsave
{ 100 100 moveto (a) show
  newpath 10 10 moveto 20 20 lineto stroke } stopped not
grestore
userdict /exch undef
(text and stroking survive a shadowed exch) assert
/iso.g /gsave load def
userdict /gsave (shadowed) put
{ newpath 30 30 moveto 40 40 lineto 30 40 lineto closepath eofill } stopped not
userdict /gsave undef   % drop the shadow; the standard gsave returns
(painting survives a shadowed gsave) assert
userdict /iso.g undef

% --- the machinery's data roots and state are its own: a program may
% take the names graphicsdict, DEVICE and =string for itself, and it
% finds no machinery state in userdict to disturb ---
5 dict begin
/graphicsdict (mine) def
/DEVICE 42 def
/=string 7 def
{ newpath 10 10 moveto 40 40 lineto stroke
  100 100 moveto (a) show
  gsave 20 20 10 10 rectfill grestore } stopped not
end
(painting survives shadowed graphicsdict, DEVICE and =string) assert
userdict /.wrappedprocs known not
userdict /.imginterp known not and
userdict /.fontserial known not and
userdict /.hairrect known not and
(the machinery keeps its state out of userdict) assert
gsave
{ 10 10 8 [10 0 0 -10 0 10]
  { /pend (x) def /rawrow 5 def /got 99 def <00112233445566778899> }
  image } stopped not
(an image source defining the row pump's names completes) assert
grestore
userdict /pend undef userdict /rawrow undef userdict /got undef
gsave
<< /PatternType 1 /PaintType 1 /TilingType 1
   /BBox [0 0 10 10] /XStep 10 /YStep 10
   /PaintProc { pop /i 999 def /pat (mine) def /iso.p true def
                newpath 0 0 moveto 5 0 lineto 5 5 lineto closepath fill }
>> matrix makepattern setpattern
newpath 0 0 moveto 30 0 lineto 30 30 lineto 0 30 lineto closepath fill
grestore
iso.p (a pattern paint procedure runs on the caller's stacks) assert
userdict /i undef userdict /pat undef userdict /iso.p undef

% selectfont takes either a size or a matrix (PLRM 8.2). The matrix form
% reaches makefont where the size form reaches scalefont, and both end at
% setfont. Both scale the face's own matrix, so what is asserted is the
% scaling and not a figure: the entry is read off the face this host
% resolved and multiplied here, because the name /Courier means whichever
% face answers to it and the faces differ in what they measure in. One
% host answers with a face of a thousand units to the em and its entry is
% 0.001; another substitutes one whose matrix is the identity. A figure
% written down here would hold on the first and fail on the second, which
% is a test about which face is installed and not about selectfont.
%
% The scaled entry is compared with room in it: the font's own matrix
% carries single-precision values, and a build whose reals are wider
% shows that rounding rather than hiding it -- 0.024 arrives as
% 0.02400000113993883. The room is taken in the same units as the entry,
% so it is the same room wherever this runs, and it is far below the
% difference a wrong branch would make, which is the whole size.
gsave
/Courier findfont /FontMatrix get 0 get /base.m0 exch def
/base.room base.m0 1e-3 mul def
/Courier 12 selectfont
currentfont /FontMatrix get 0 get base.m0 12 mul sub abs base.room lt
    (selectfont scales by a size) assert
/Courier [24 0 0 24 0 0] selectfont
currentfont /FontMatrix get 0 get base.m0 24 mul sub abs base.room lt
    (selectfont makes a font from a matrix) assert
{ /Courier (24) selectfont } stopped
    (selectfont refuses a size that is neither number nor matrix) assert
clear
grestore

% image takes either the five operands of the Level 1 form or a single
% image dictionary (PLRM 8.2), and states both, the way imagemask beside
% it does. What the statement buys is the refusal: a Level 1 call whose
% bits-per-component is not an integer is answered before the body runs,
% where an operator that declared only its topmost operand would carry a
% malformed call into the painting machinery and fail somewhere further
% in, with an error naming whatever it reached.
gsave
20 20 scale
{ 4 4 8 [4 0 0 -4 0 4] <00408000C0FF40208010FFC08000FF4020> image } stopped not
    (image takes the Level 1 five-operand form) assert
{ << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
     /Decode [0 1] /ImageMatrix [2 0 0 -2 0 2]
     /DataSource <00FF8040> >> image } stopped not
    (image takes an image dictionary) assert
% The error name is the assertion, and not merely that something stopped:
% a call carried into the painting machinery stops there too, and reports
% whatever it reached. typecheck is the dispatcher answering for the
% operand statement, before a line of the body has run.
{ 4 4 (bits) [4 0 0 -4 0 4] <00> image } stopped
    (image refuses a Level 1 call it cannot paint from) assert
$error /errorname get /typecheck eq
    (and refuses it on the operand statement, not somewhere further in) assert
clear
grestore
userdict /base.m0 undef userdict /base.room undef

count 0 eq (operand stack is balanced) assert
faildict /n get 0 eq { (SUCCESS\n) print } { faildict /n get =print ( failures\n) print } ifelse
flush
quit
