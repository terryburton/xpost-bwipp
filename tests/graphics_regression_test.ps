20 dict begin
/CIDFontName /TestCID0 def
/CIDFontType 0 def
/CIDSystemInfo << /Registry (T) /Ordering (T) /Supplement 0 >> def
/FontMatrix [0.001 0 0 0.001 0 0] def
/FontBBox [0 0 1000 1000] def
/CIDCount 2 def
/FDBytes 1 def
/GDBytes 2 def
/CIDMapOffset 0 def
/FDArray 1 array
dup 0 4 dict begin
/FontType 1 def
/FontMatrix [1 0 0 1 0 0] def
/Private 1 dict def
currentdict end put
def
(Hex) 43 StartData
00000900001200002B10BF317079C84B925B10BF317079C84B92BA9844E67E3430AF9B4AC1F3C7BC50D639>
