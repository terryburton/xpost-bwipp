%!testlib
% File lifetime under everything that can end one, run by
% run-file-lifetime-test.sh with the open-file allowance lowered.
%
% A file can be closed by the program, by the restore of a save taken
% before it was opened (PLRM 3.8), or reclaimed with the rest of a job.
% Each holds a descriptor until it is, and the allowance the wrapper sets
% is far smaller than the number of files opened here: anything that
% fails to close shows up as a refusal to open rather than as a slow
% leak nobody notices.
%
% Collections are asked for throughout, because a file is held by the
% interpreter outside its stacks and a collection is where that goes
% wrong.


/nm (flife.scratch) def
/seed nm (w) file def seed (0123456789abcdef) writestring seed closefile

% --- closed by restore: each file and filter is opened after the save ---
0 1 200 {
    pop
    save
    /f nm (r) file def
    f 4 string readstring pop pop
    /g nm (r) file def
    /h g /ASCIIHexDecode filter def
    1 vmreclaim
    restore
    1 vmreclaim
} for
{ nm (r) file dup closefile } (a file still opens after two hundred rounds closed by restore) works

% --- closed by the program, filter first then its source ---
0 1 200 {
    pop
    /f nm (r) file def
    /h f /ASCII85Decode filter def
    h closefile
    f closefile
    1 vmreclaim
} for
{ nm (r) file dup closefile } (a file still opens after two hundred closed by the program) works

% --- closed by the program, source first then the filter over it ---
% The filter holds the stream beneath it, so closing them this way round
% has to leave the filter usable until it is closed in its turn.
0 1 200 {
    pop
    /f nm (r) file def
    /h f /ASCIIHexDecode filter def
    f closefile
    h 2 string readstring pop pop
    h closefile
    1 vmreclaim
} for
{ nm (r) file dup closefile } (a file still opens after two hundred closed source-first) works

% --- reusable streams, which hold their source's bytes ---
0 1 200 {
    pop
    /r nm (r) file def
    /s r /ReusableStreamDecode filter def
    s 4 string readstring pop pop
    s closefile
    r closefile
    1 vmreclaim
} for
{ nm (r) file dup closefile } (a file still opens after two hundred reusable streams) works

% --- dropped without being closed, and without anything asking for a
% collection ---
% PLRM 3.8 has the collector close a file whose object is no longer
% accessible, and 3.7.4 has collection "take place without explicit
% action by the PostScript program". Nothing in this round closes a file
% or asks for a reclaim: each one is opened, read from and dropped
% unreachable, and there are far more of them than the allowance the
% wrapper sets. The descriptor a dropped file holds therefore has to
% come back to the program on the interpreter's own account, since an
% open spends too little of what paces a collection to make one due.
0 1 200 {
    pop
    nm (r) file dup 4 string readstring pop pop pop
} for
{ nm (r) file dup closefile }
    (a file still opens after two hundred dropped without being closed) works

% and the interpreter is still working
1 2 add 3 eq (the interpreter still works after the rounds) assert

% The round above leaves its files open: nothing in it closes one and
% nothing asks for a reclaim, which is its whole subject. The scratch
% file is deleted next, and a host that refuses to delete a file another
% handle still holds refuses that for the round's leavings rather than
% for anything the delete is being asked about. The handles go back
% first, so what the delete answers is the delete.
1 vmreclaim
nm deletefile

% --- what a refused file operation is called -----------------------------
% PLRM 8.2 says of both deletefile and renamefile: "If the device does
% not allow this operation, an invalidfileaccess error occurs", and of a
% name that is not there, undefinedfilename. Three operators decide this
% from errno and only one of them consulted the mapping that knows the
% difference; the other two answered ioerror for every failure that was
% not a missing name, so a permission refusal was reported as a device
% fault.

% What a procedure raised, with whatever it left behind taken off the
% stack. The depth remembered is the one below the procedure: the count
% at this point includes both the procedure and the name just pushed for
% it, and `stopped` consumes the procedure, so a case that leaves nothing
% would otherwise be asked to pop a negative number of operands.

% and the control for it: a case leaving nothing and a case leaving more
% than one, since every case below leaves exactly one and a helper off by
% one would pass all of them. The depth is taken before the name to hold
% it is pushed, rather than counted and adjusted, so that this control
% cannot be wrong in the same way as the thing it controls.
count /ef.d0 exch def
{ } outcome /ok eq
    (a procedure that leaves nothing behind returns) assert
count ef.d0 eq
    (outcome pops nothing after a procedure that left nothing) assert
{ 1 2 3 } outcome /ok eq
    (a procedure that leaves three operands returns) assert
count ef.d0 eq
    (outcome pops all three) assert

{ (/nonexistent-directory-xpost/f) deletefile } outcome /undefinedfilename eq
    (deletefile names a missing file undefinedfilename) assert
{ (/nonexistent-directory-xpost/a) (/nonexistent-directory-xpost/b) renamefile } outcome
    /undefinedfilename eq
    (renamefile names a missing file undefinedfilename) assert

% The refusal case -- a directory the run may search but not write -- is
% held by run-file-refusal-test.sh, which can make one; this file cannot.
verdict
