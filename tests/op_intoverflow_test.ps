%!testlib
% Integer-literal range (PLRM 3.3.2), run through `xpost -d null` by
% run-ps-test.sh.
%
% An integer constant beyond the implementation's integer range is converted to
% a real, not wrapped. The value is checked rather than the type, since the
% integer range itself is implementation-defined.

% in-range values remain integers on any implementation
42 type /integertype eq (small literal is an integer) assert
2147483647 type /integertype eq (2^31-1 is an integer) assert

% just past 2^31: must stay positive and near its true value (a wrap flips sign)
2147483648 0 gt (2^31 literal is positive, not wrapped) assert
2147483648 1000000 div 2147.483648 sub abs 1 lt (2^31 literal has its value) assert

% far past the range
100000000000 0 gt (1e11 literal is positive) assert
100000000000 100000 div 1000000 sub abs 100 lt (1e11 literal has its value) assert
-9999999999 0 lt (negative over-range literal stays negative) assert

% --- arithmetic overflow behaves identically wherever the operator runs ---
% The interpreter executes add, sub and mul inline when they appear inside
% a procedure. That path and the operator must agree exactly: an operation
% that overflows the integer range yields a real of the true value (PLRM
% 3.3.2), and one that does not yields an integer.
/mx 2147483647 def
/mn -2147483648 def

/pair { % top-level-result {proc} (label) . -  the fused result must equal
        %                                       the top-level operator result
    3 dict begin
    /lbl exch def /pr exch def /want exch def
    pr exec want eq lbl assert
    end
} def

mx 1 add   { mx 1 add }   (add overflow agrees in and out of a procedure) pair
mn 1 sub   { mn 1 sub }   (sub underflow agrees in and out of a procedure) pair
mx 2 mul   { mx 2 mul }   (mul overflow agrees in and out of a procedure) pair
mx mx add  { mx mx add }  (max+max agrees in and out of a procedure) pair
mn mn add  { mn mn add }  (min+min agrees in and out of a procedure) pair
mn 1 mul   { mn 1 mul }   (min*1 agrees in and out of a procedure) pair
2 3 add    { 2 3 add }    (in-range add agrees in and out of a procedure) pair

% and the promotion happens at whatever the build's integer range is,
% which is what this file says at the top it will not assume. The build
% is asked where its range ends -- the narrow personality promotes past
% 2^31, the wide one carries integers further -- and each is held to
% arithmetic that leaves its own range rather than to a fixed number.
/wideint mx 1 add type /integertype eq def
/promotes wideint { /integertype }{ /realtype } ifelse def

/itype { 2 3 add type } def
itype /integertype eq (an in-range add in a procedure yields an integer) assert

/otype { mx 1 add type } def
otype promotes eq (an add past the range agrees with the build) assert
/stype { mn 1 sub type } def
stype promotes eq (a sub past the range agrees with the build) assert
/mtype { mx 2 mul type } def
mtype promotes eq (a mul past the range agrees with the build) assert

% and whichever personality this is, leaving the range never wraps: the
% sign is kept, which is the property the type was standing in for. The
% magnitudes are not compared against the range itself, since a promoted
% value is a real and the range's own endpoint does not survive the
% conversion exactly
mx 1 add 0 gt (an add past the range stays positive) assert
mn 1 sub 0 lt (a sub past the range stays negative) assert
mx 2 mul 0 gt (a mul past the range stays positive) assert

% the value survives, promoted or not
/ovval { mx 1 add 2147483648.0 sub abs 1 lt } def
ovval (an add past the range keeps its value) assert

verdict
