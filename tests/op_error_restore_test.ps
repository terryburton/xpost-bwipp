%!testlib
% Operand restoration on error (PLRM 3.11): after an operator errors, the operand
% stack is restored to the state it was in when the operator began -- including
% the integer types the program pushed, not the reals the dispatcher coerces them
% to. Run through `xpost -d null` by run-ps-test.sh.

/isint { type /integertype eq } def
/isreal { type /realtype eq } def

% div by zero: both operands restored as integers, deeper stack untouched
clear 9 8 1 0 { div } stopped pop
count 4 eq (div by zero leaves four operands) assert
4 array astore /a exch def
a 0 get 9 eq (deep operand untouched) assert
a 3 get 0 eq (dividend value restored) assert  % a3 is top (the 0)
a 3 get isint (top operand restored as integer, not real) assert
a 2 get isint (second operand restored as integer, not real) assert

% real numerator stays real, integer denominator stays integer
clear 1.5 0 { div } stopped pop
2 array astore /a exch def
a 0 get isreal (real operand kept real) assert
a 1 get isint (integer operand kept integer) assert

% idiv / mod by zero (integer operators, no coercion) still restore cleanly
clear 7 0 { idiv } stopped pop 2 array astore /a exch def
a 0 get 7 eq a 1 get 0 eq and (idiv operands restored) assert
a 0 get isint a 1 get isint and (idiv operands are integers) assert
clear 7 0 { mod } stopped pop 2 array astore /a exch def
a 0 get isint a 1 get isint and (mod operands are integers) assert

% dispatch typecheck: a rejected float signature must not leave a coerced operand
clear (x) 1 { add } stopped pop 2 array astore /a exch def
a 1 get 1 eq (add: integer operand value kept) assert
a 1 get isint (add: integer operand not coerced by the rejected float signature) assert
clear 1 (x) { add } stopped pop 2 array astore /a exch def
a 0 get isint (add: leading integer operand not coerced) assert

% single-operand coercion: sqrt of a negative integer restores the integer
clear -1 { sqrt } stopped pop
dup -1 eq (sqrt: value restored) assert
isint (sqrt: operand restored as integer) assert

% successful coercing operator is unaffected
clear 6 4 div 1.5 sub abs 1e-6 lt (div still works) assert

% --- an error whose errordict handler is gone must still be an error ---
% A program may replace errordict entries; removing one must not make the
% error itself disappear. The interpreter schedules the handler by pushing
% it, and a push that cannot happen once left execution resuming past the
% error as though it had succeeded -- so a program could switch error
% reporting off wholesale by undefining an entry.
clear
/savedtypecheck errordict /typecheck get def

% removing the entry: the error is still raised, through the same route
% a standard handler takes, so $error records it (PLRM 3.11.1)
errordict /typecheck undef
{ 1 (str) add } stopped
    (an error with no errordict handler still reaches stopped) assert
clear
$error /errorname get /typecheck eq
    (the error name reaches $error with no handler installed) assert
$error /newerror get
    (newerror is set with no handler installed) assert
clear

% an entry that is not executable is pushed, never run
errordict /typecheck 42 put
{ 1 (str) add } stopped
    (an error whose handler is not a procedure still reaches stopped) assert
clear
$error /errorname get /typecheck eq
    (a non-procedure handler still records the error name) assert
clear

errordict /typecheck /savedtypecheck load put   % load: the handler is executable
clear

% and the handler restored above works again
{ 1 (str) add } stopped (a restored handler still reports the error) assert
clear

% interrupt and timeout arrive from outside the program rather than from
% an operator it executed. PLRM 3.11.1 has the interpreter execute them
% from errordict between two objects without pushing the object being
% executed or disturbing the operand stack in any other way, and PLRM 8.2
% says the same of each: their handlers stop, and leave the stack as they
% found it.
clear 1 2 3
count /depth exch def
{ errordict /interrupt get exec } stopped
(the interrupt handler stops) assert
count depth eq (an interrupt leaves the operand stack alone) assert

clear 1 2 3
count /depth exch def
{ errordict /timeout get exec } stopped
(the timeout handler stops) assert
count depth eq (a timeout leaves the operand stack alone) assert
clear

verdict
