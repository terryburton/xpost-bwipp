%!testlib
%!
% The font cache's two byte parameters -- the cache's own capacity and
% the ceiling above which a glyph renders uncached -- are set from a
% program, and a program states any integer. The store admits an entry
% on one test, that its bytes are within the per-glyph ceiling, so a
% ceiling of a whole word is no ceiling at all.
%
% Both are held to the largest cache this implementation offers. A
% value above it is substituted by that value with no error indication
% (PLRM 8.2, setcacheparams), so what cachestatus and
% currentcacheparams report is a size the cache can be, and the two
% agree with each other.

/say { print (\n) print } def

% Setting the cache size is allowed only in a system administrator job
% (PLRM 8.2 setcacheparams), and this suite states a size repeatedly, so
% the run leaves the server first and stays unencapsulated to the end.
% The refusal itself is asserted in tests/op_fontcache_test.ps.
serverdict begin 0 exitserver

% keep the cache as it was found
cachestatus 7 array astore /cs0 exch def
currentcacheparams counttomark array astore /cp0 exch def cleartomark

/limit { cachestatus 7 array astore 6 get } def
/size  { currentcacheparams counttomark array astore /cptmp exch def
         cleartomark cptmp 0 get } def

% --- the per-glyph ceiling is bounded above ---
2147483647 setcachelimit
/big limit def
big 2147483647 lt (a per-glyph ceiling of a whole word is not taken as it stands) assert
big 0 gt (and the ceiling substituted for it is a usable one) assert

% --- twice over: the substitute is a fixed value, not a running one ---
2147483647 setcachelimit
limit big eq (the same ceiling is substituted the second time) assert

% --- the cache capacity is bounded above by the same value ---
mark 2147483647 4 2147483647 setcacheparams
size big eq (a cache capacity of a whole word is held to the same value) assert
limit big eq (and so is the per-glyph ceiling stated with it) assert

% --- values within the range are taken exactly ---
40000 setcachelimit
limit 40000 eq (a per-glyph ceiling within range is set exactly) assert
mark 4444 4 40000 setcacheparams
size 4444 eq (a cache capacity within range is set exactly) assert
limit 40000 eq (and the per-glyph ceiling stated with it) assert

% --- and bounded below by a substitution, not by a refusal ---
% PLRM 8.2 gives setcachelimit stackunderflow and typecheck and nothing
% besides, so a ceiling the store cannot take is answered by the nearest
% one it can rather than by an error. Below the range that is no ceiling
% at all, which admits no glyph -- a store that caches nothing, which is
% a store this implementation can be.
count /c0 exch def
{ -1 setcachelimit } (a per-glyph ceiling below the range raises no error) works
count c0 sub dup 0 gt { { pop } repeat }{ pop } ifelse
limit 0 eq
  (and the ceiling substituted for it is the floor of the range) assert

% setcacheparams states the same parameter (PLRM 8.2, Appendix C:
% MaxFontItem), so a ceiling stated through it is substituted the same
% way rather than left standing
mark 4444 4 40000 setcacheparams
mark 4444 4 -1 setcacheparams
limit 0 eq (a ceiling below the range is the floor through setcacheparams)
  assert

% --- the bound is a ceiling, not a refusal: it is above the ceiling
% the interpreter starts with, so every glyph that was cacheable before
% any of this still is ---
big cs0 6 get ge
  (the substituted ceiling is at least the one the cache starts with) assert
big cs0 1 get ge
  (and at least the capacity the cache starts with) assert

% put the cache back the way it was found
mark cp0 aload pop setcacheparams
cs0 6 get setcachelimit

verdict
quit
