%!testlib
% Every halftone dictionary fault against the error it is defined to
% raise, run through `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% A halftone dictionary carries a type, and the type decides which
% entries the rest of the dictionary must have. The specification gives
% three separate answers for three separate faults: a type the
% interpreter cannot screen with is a rangecheck, a required entry that
% is absent is an undefined, and an entry of the wrong type is a
% typecheck. A validator that raises something is not the same as one
% that raises the right thing, and a program that distinguishes the
% three -- to fall back on a simpler screen, say -- is told the wrong
% story by the wrong error.
%
% So each fault is introduced in each type that can carry it, and the
% error name is checked rather than the mere fact of an error.



% The tag is put away before the procedure runs: a procedure that fails
% may leave anything at all on the stack.

% A file of n zero bytes, for the types whose thresholds must arrive
% through one rather than in a string: the hexadecimal for them, decoded.
/zerofile { % n  ->  file
    dup 2 mul string /zf.s exch def
    0 1 zf.s length 1 sub { zf.s exch 48 put } for
    pop zf.s /ASCIIHexDecode filter
} def

% The dictionary the screen in force was built from. PLRM 8.2 has
% currentscreen answer with a halftone dictionary in place of the spot
% function where the halftone was set by sethalftone, and that is the
% dictionary carrying the threshold array a cell reads -- the array
% itself, in a string, whatever the array arrived as.
/screendict { % -  ->  dict
    currentscreen exch pop exch pop
} def

% ----------------------------------------------------- the whole dictionaries
% Each type this interpreter screens with, complete, is accepted.

{ << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 } >>
  sethalftone } (a complete type 1) works
{ << /HalftoneType 3 /Width 2 /Height 2 /Thresholds <0180C8FF> >>
  sethalftone } (a complete type 3) works
{ << /HalftoneType 5
     /Gray << /HalftoneType 3 /Width 2 /Height 2 /Thresholds <0180C8FF> >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } (a complete type 5) works

% A type 6 is a type 3 whose thresholds arrive through a file rather
% than a string (PLRM Table 7.6), so its Thresholds is a filter over
% the hexadecimal the type 3 case above spells inline.
{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >>
  sethalftone } (a complete type 6) works

% A type 16 is a type 6 with 16-bit samples (PLRM Table 7.8), so a 2 by 2
% cell is eight bytes rather than four. The screen keeps the high byte of
% each sample, which is the precision the cell carries.
{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >>
  sethalftone } (a complete type 16) works

% The 16-bit samples reduce to the byte the cell carries, and the
% reduction is the high byte: a type 16 whose samples are 0x01xx 0x80xx
% 0x00xx 0xFFxx must leave the same thresholds behind as the type 6
% spelling 01 80 00 FF.
{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0140807F0022FF13) /ASCIIHexDecode filter >> sethalftone
  screendict /Thresholds get 4 string copy
  << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (018000FF) /ASCIIHexDecode filter >> sethalftone
  screendict /Thresholds get
  ne { (a type 16 does not reduce to the type 6 it matches)
       (16-bit thresholds) note } if }
  (a type 16 reduced to the cell's precision) works

% sethalftone consumes its argument and leaves nothing behind, whatever
% the thresholds arrived as. A file-borne array is the case that got
% this wrong: the loop draining the unread remainder exited still
% holding the last piece it had read, so the pop that was meant for the
% file took that instead and the file stayed on the stack.
{ count /htdepth exch def
  << /HalftoneType 3 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone
  count htdepth ne
    { (leaves something on the operand stack) (a type 3 from a file) note } if }
  (sethalftone consuming a file-borne type 3) works
{ count /htdepth exch def
  << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone
  count htdepth ne
    { (leaves something on the operand stack) (a type 6) note } if }
  (sethalftone consuming a type 6) works
{ count /htdepth exch def
  << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >> sethalftone
  count htdepth ne
    { (leaves something on the operand stack) (a type 16) note } if }
  (sethalftone consuming a type 16) works

% Types 2 and 4 give four screens, one per primary. This interpreter
% screens grey, and picks the grey component exactly as it does from a
% type 5, so each must be accepted and must screen as the single-screen
% type its grey triple spells.
{ << /HalftoneType 2
     /RedFrequency 60 /RedAngle 0 /RedSpotFunction { pop pop 0 }
     /GreenFrequency 60 /GreenAngle 0 /GreenSpotFunction { pop pop 0 }
     /BlueFrequency 60 /BlueAngle 0 /BlueSpotFunction { pop pop 0 }
     /GrayFrequency 75 /GrayAngle 45 /GraySpotFunction { pop pop 0 } >>
  sethalftone } (a complete type 2) works
{ << /HalftoneType 4
     /RedWidth 2 /RedHeight 2 /RedThresholds <0180C8FF>
     /GreenWidth 2 /GreenHeight 2 /GreenThresholds <0180C8FF>
     /BlueWidth 2 /BlueHeight 2 /BlueThresholds <0180C8FF>
     /GrayWidth 2 /GrayHeight 2 /GrayThresholds <01234567> >>
  sethalftone } (a complete type 4) works

% the grey triple is the screen that reaches the device: a type 2 must
% leave the frequency and angle its GrayFrequency and GrayAngle name
{ << /HalftoneType 2
     /RedFrequency 60 /RedAngle 0 /RedSpotFunction { pop pop 0 }
     /GreenFrequency 60 /GreenAngle 0 /GreenSpotFunction { pop pop 0 }
     /BlueFrequency 60 /BlueAngle 0 /BlueSpotFunction { pop pop 0 }
     /GrayFrequency 75 /GrayAngle 45 /GraySpotFunction { pop pop 0 } >>
  sethalftone
  currentscreen pop exch
  dup 75 ne { (frequency is not the grey one) (a type 2) note } if pop
  45 ne { (angle is not the grey one) (a type 2) note } if }
  (a type 2 screening with its grey triple) works

% A type 10 describes a cell at a nonzero screen angle by two squares,
% X and Y, whose sides are the horizontal and vertical displacement to
% the next cell (PLRM 7.4.5). It carries Xsquare^2 + Ysquare^2
% thresholds, square X first, each square in image order, and its
% Thresholds may be a string or a file as a type 3's and a type 6's are
% respectively.
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 2
     /Thresholds <0110204030506070809008182838> >>
  sethalftone } (a complete type 10 from a string) works
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 2
     /Thresholds (0110204030506070809008182838) /ASCIIHexDecode filter >>
  sethalftone } (a complete type 10 from a file) works

% and comes back as the type it was set to
{ << /HalftoneType 3 /Width 2 /Height 2 /Thresholds <0180C8FF> >> sethalftone
  currenthalftone /HalftoneType get 3 ne
    { (does not read back as type 3) (currenthalftone) note } if }
  (a type 3 read back) works

% -------------------------------------------- the array comes back again
% A threshold array given through a file comes back through one. PLRM
% 7.4.5 has currenthalftone answer a type 6 and a type 16 with a
% dictionary whose Thresholds is a FILE -- a different file object from
% the one sethalftone was given -- and the dictionary can be presented to
% sethalftone to reinstall the same array. A type 3
% spells its array in a string and is the control here: it must still
% come back as the string it was set with, and must still reinstall.
%
% Each case checks the reinstalled array against the array first
% installed, because a round trip that merely does not raise cannot tell
% a dictionary that reinstalled the same screen from one that reinstalled
% some other.

{ << /HalftoneType 3 /Width 2 /Height 2 /Thresholds <0180C8FF> >> sethalftone
  /htwas screendict /Thresholds get 4 string copy def
  currenthalftone /Thresholds get type /stringtype ne
    { (does not come back as a string) (a type 3 threshold array) note } if
  currenthalftone sethalftone
  screendict /Thresholds get htwas ne
    { (does not reinstall the same array) (a type 3 threshold array) note } if }
  (a type 3 threshold array through currenthalftone) works

{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone
  /htwas screendict /Thresholds get 4 string copy def
  currenthalftone /Thresholds get type /filetype ne
    { (does not come back as a file) (a type 6 threshold array) note } if
  currenthalftone sethalftone
  screendict /Thresholds get htwas ne
    { (does not reinstall the same array) (a type 6 threshold array) note } if }
  (a type 6 threshold array through currenthalftone) works

{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0140807F0022FF13) /ASCIIHexDecode filter >> sethalftone
  /htwas screendict /Thresholds get 4 string copy def
  currenthalftone /Thresholds get type /filetype ne
    { (does not come back as a file) (a type 16 threshold array) note } if
  currenthalftone sethalftone
  screendict /Thresholds get htwas ne
    { (does not reinstall the same array) (a type 16 threshold array) note } if }
  (a type 16 threshold array through currenthalftone) works

% and the same for the type 16 that carries a second rectangle, whose
% array is expanded into a cell rather than read straight into one
{ << /HalftoneType 16 /Width 4 /Height 3 /Width2 2 /Height2 2
     /Thresholds
     (00010A0B14151E1F28292A2B34353E3F48494A4B54555E5F68696A6B74757E7F)
     /ASCIIHexDecode filter >> sethalftone
  /htwas screendict /Thresholds get
         screendict /Thresholds get length string copy def
  currenthalftone sethalftone
  screendict /Thresholds get htwas ne
    { (does not reinstall the same cell) (a type 16 angled cell) note } if }
  (a type 16 with a second rectangle through currenthalftone) works

% A type 5's components are threshold arrays in their own right, so the
% dictionary answered for a composite carries a file wherever a component
% was given one, and the composite reinstalls.
{ << /HalftoneType 5
     /Gray << /HalftoneType 6 /Width 2 /Height 2
              /Thresholds (0180C8FF) /ASCIIHexDecode filter >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >> sethalftone
  /htwas screendict /Thresholds get 4 string copy def
  currenthalftone /Gray get /Thresholds get type /filetype ne
    { (does not come back as a file) (a type 5 component's array) note } if
  currenthalftone sethalftone
  screendict /Thresholds get htwas ne
    { (does not reinstall the same array) (a type 5 component's array) note } if }
  (a type 5 component's threshold array through currenthalftone) works

% ------------------------------------------------ what may be read back
% PLRM 7.4.5 gives the answered type 6 file the access attribute the
% original had, so a program may read the array back through it where the
% original permitted a read. It gives the answered type 16 file no access
% AT ALL, whatever the original's was, so a program cannot read a type
% 16's array. The two are separate rules and both are asked here: a fix
% that made the answered file's access unconditional would satisfy one of
% them and fail the other.

{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone
  currenthalftone /Thresholds get
  dup type /filetype ne
    { (is not a file at all) (a type 6 answered file) note } if
  rcheck not
    { (is not readable where the original was) (a type 6 answered file) note } if }
  (a type 6 answered file keeping a readable original's access) works

{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone
  currenthalftone /Thresholds get 4 string readstring pop
  <0180C8FF> ne
    { (does not carry the array) (a type 6 answered file) note } if }
  (a type 6 answered file carrying the array) works

{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter noaccess >> sethalftone
  currenthalftone /Thresholds get
  dup type /filetype ne
    { (is not a file at all) (a type 6 answered file) note } if
  rcheck
    { (is readable where the original was not) (a type 6 answered file) note } if }
  (a type 6 answered file keeping a no-access original's access) works

{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >> sethalftone
  currenthalftone /Thresholds get
  dup type /filetype ne
    { (is not a file at all) (a type 16 answered file) note } if
  rcheck
    { (is readable, and a type 16's may not be) (a type 16 answered file) note } if }
  (a type 16 answered file being no-access) works

% The array is read with the file's own access attribute disregarded,
% which PLRM 7.4.5 asks of sethalftone and of nothing else: a file a
% program cannot read still delivers its array. That is the rule the type
% 16 round trip above rests on, and it holds for a file the program made
% no-access itself.
{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180C8FF) /ASCIIHexDecode filter noaccess >> sethalftone }
  (a type 6 whose Thresholds file is no-access) works
{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter noaccess >>
  sethalftone } (a type 16 whose Thresholds file is no-access) works

% ------------------------------------- a file that does not hold it all
% PLRM 7.4.5: a rangecheck where the file ends before the array does.
{ << /HalftoneType 6 /Width 2 /Height 2
     /Thresholds (0180) /ASCIIHexDecode filter >> sethalftone }
  /rangecheck (a type 6 whose file ends before the array does) raises
{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (01008040) /ASCIIHexDecode filter >> sethalftone }
  /rangecheck (a type 16 whose file ends before the array does) raises
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 2
     /Thresholds (011020) /ASCIIHexDecode filter >> sethalftone }
  /rangecheck (a type 10 whose file ends before the array does) raises

% and one that declares more than a string can hold, as an angled cell
% too large to expand is refused for the same reason
{ << /HalftoneType 6 /Width 400 /Height 400
     /Thresholds (0180C8FF) /ASCIIHexDecode filter >> sethalftone }
  /limitcheck (a type 6 declaring more thresholds than a string holds) raises

% ------------------------------------------------------------ the type itself
% A dictionary with no type at all, a type that is not a number, and
% types the interpreter does not screen with.

{ << /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 } >> sethalftone }
    /undefined (a dictionary with no HalftoneType) raises
{ << /HalftoneType (three) /Width 2 /Height 2 /Thresholds <0180C8FF> >>
  sethalftone } /typecheck (a HalftoneType that is not an integer) raises

[ -1 0 9 99 ] {
    /t exch def
    { << /HalftoneType t /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 } >>
      sethalftone }
      /rangecheck (a type this interpreter does not screen with) raises
} forall

% ------------------------------------------------- the entries each type needs
% Every required entry, removed one at a time, in the type that requires
% it. A validator that checks only the first entry passes the first of
% these and fails the rest.

{ << /HalftoneType 1 /Angle 45 /SpotFunction { pop pop 0 } >> sethalftone }
    /undefined (a type 1 with no Frequency) raises
{ << /HalftoneType 1 /Frequency 60 /SpotFunction { pop pop 0 } >> sethalftone }
    /undefined (a type 1 with no Angle) raises
{ << /HalftoneType 1 /Frequency 60 /Angle 45 >> sethalftone }
    /undefined (a type 1 with no SpotFunction) raises

{ << /HalftoneType 3 /Height 2 /Thresholds <0180C8FF> >> sethalftone }
    /undefined (a type 3 with no Width) raises
{ << /HalftoneType 3 /Width 2 /Thresholds <0180C8FF> >> sethalftone }
    /undefined (a type 3 with no Height) raises
{ << /HalftoneType 3 /Width 2 /Height 2 >> sethalftone }
    /undefined (a type 3 with no Thresholds) raises
{ << /HalftoneType 3 /Width 4 /Height 4 /Thresholds <0011> >> sethalftone }
    /rangecheck (a type 3 with fewer thresholds than it declares) raises
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 2 /Thresholds <0011> >> sethalftone }
    /rangecheck (a type 10 with fewer thresholds than its squares hold) raises

% A type 6 demands the same three entries, and PLRM Table 7.6 makes its
% Thresholds a file specifically -- a string is the type 3 spelling.
{ << /HalftoneType 6 /Height 2 /Thresholds (0180C8FF) /ASCIIHexDecode filter >>
  sethalftone } /undefined (a type 6 with no Width) raises
{ << /HalftoneType 6 /Width 2 /Thresholds (0180C8FF) /ASCIIHexDecode filter >>
  sethalftone } /undefined (a type 6 with no Height) raises
{ << /HalftoneType 6 /Width 2 /Height 2 >> sethalftone }
  /undefined (a type 6 with no Thresholds) raises
{ << /HalftoneType 6 /Width 2 /Height 2 /Thresholds <0180C8FF> >> sethalftone }
  /typecheck (a type 6 whose Thresholds is a string, not a file) raises

% A type 16 demands the same three, and PLRM Table 7.8 pairs Width2 with
% Height2: one without the other describes a rectangle with no extent.
{ << /HalftoneType 16 /Height 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >>
  sethalftone } /undefined (a type 16 with no Width) raises
{ << /HalftoneType 16 /Width 2 /Height 2 >> sethalftone }
  /undefined (a type 16 with no Thresholds) raises
{ << /HalftoneType 16 /Width 2 /Height 2 /Thresholds <0180C8FF> >> sethalftone }
  /typecheck (a type 16 whose Thresholds is a string, not a file) raises
{ << /HalftoneType 16 /Width 2 /Height 2 /Width2 2
     /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >>
  sethalftone } /undefined (a type 16 with Width2 and no Height2) raises
% A type 16 may carry a second rectangle, and then it describes a cell
% at an angle the way a type 10's two squares do: the repeat vectors are
% (Width, Height2) and (-Width2, Height), whose determinant is the
% sample count. It is a cell on the same condition, that Height and
% Width2 are coprime.
{ << /HalftoneType 16 /Width 4 /Height 3 /Width2 2 /Height2 2
     /Thresholds
     (00010A0B14151E1F28292A2B34353E3F48494A4B54555E5F68696A6B74757E7F)
     /ASCIIHexDecode filter >>
  sethalftone } (a type 16 with a second rectangle) works
{ << /HalftoneType 16 /Width 4 /Height 2 /Width2 2 /Height2 2
     /Thresholds (000102030405060708090A0B0C0D0E0F101112131415161718191A1B)
     /ASCIIHexDecode filter >>
  sethalftone } (a type 16 whose rectangles share a factor) works

{ << /HalftoneType 2
     /RedFrequency 60 /RedAngle 0 /RedSpotFunction { pop pop 0 }
     /GreenFrequency 60 /GreenAngle 0 /GreenSpotFunction { pop pop 0 }
     /BlueFrequency 60 /BlueAngle 0 /BlueSpotFunction { pop pop 0 }
     /GrayAngle 45 /GraySpotFunction { pop pop 0 } >>
  sethalftone } /undefined (a type 2 with no GrayFrequency) raises
{ << /HalftoneType 4
     /RedWidth 2 /RedHeight 2 /RedThresholds <0180C8FF>
     /GreenWidth 2 /GreenHeight 2 /GreenThresholds <0180C8FF>
     /BlueWidth 2 /BlueHeight 2 /BlueThresholds <0180C8FF>
     /GrayWidth 2 /GrayHeight 2 >>
  sethalftone } /undefined (a type 4 with no GrayThresholds) raises

{ << /HalftoneType 10 /Ysquare 2 /Thresholds <0110204030506070809008182838> >>
  sethalftone } /undefined (a type 10 with no Xsquare) raises
{ << /HalftoneType 10 /Xsquare 3 /Thresholds <0110204030506070809008182838> >>
  sethalftone } /undefined (a type 10 with no Ysquare) raises
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 2 >> sethalftone }
  /undefined (a type 10 with no Thresholds) raises
{ << /HalftoneType 10 /Xsquare (three) /Ysquare 2
     /Thresholds <0110204030506070809008182838> >>
  sethalftone } /typecheck (a type 10 whose Xsquare is a string) raises

% The cell is expanded to an axis-aligned tile of side Xsquare^2 +
% Ysquare^2, so a large angled cell asks for a square of that side. One
% too large to hold is refused rather than truncated.
{ << /HalftoneType 10 /Xsquare 40 /Ysquare 31
     /Thresholds 2561 string >> sethalftone }
  /limitcheck (a type 10 whose expanded cell will not fit) raises

% Sides sharing a factor describe a smaller cell scaled up rather than a
% cell of their own. The tile is reduced by that factor, so the cell
% that gets built is the smaller one and every place in it is reached
% exactly once, as it is when the sides are coprime.
{ << /HalftoneType 10 /Xsquare 2 /Ysquare 2 /Thresholds <0011223344556677> >>
  sethalftone } (a type 10 whose squares share a factor) works
{ << /HalftoneType 10 /Xsquare 4 /Ysquare 2
     /Thresholds <000102030405060708090A0B0C0D0E0F0011223344> >>
  sethalftone } (a type 10 whose squares share a factor of two) works

% A type 10 and a type 16 can describe the same cell: two squares of side
% X and Y are the rectangles X by X and Y by Y, and the count of places
% is the same determinant read from the same four sides. Whichever way it
% is written the answer must be the same one. Sixteen and sixteen tells a
% tile measured before the sides' common factor is taken out from one
% measured after: five hundred and twelve places, a factor of sixteen, and
% a tile thirty-two on a side.
{ << /HalftoneType 10 /Xsquare 16 /Ysquare 16 /Thresholds 512 string >>
  sethalftone } (a type 10 whose squares are sixteen) works
{ << /HalftoneType 16 /Width 16 /Height 16 /Width2 16 /Height2 16
     /Thresholds 1024 zerofile >>
  sethalftone } (the same cell written as a type 16) works

% A cell with no places has no tile to reduce to. Saying so is the
% validator's job rather than the arithmetic's: the sides are refused,
% not divided by.
{ << /HalftoneType 10 /Xsquare 0 /Ysquare 0 /Thresholds <> >>
  sethalftone } /rangecheck (a type 10 with no places) raises

{ << /HalftoneType 5
     /Gray << /HalftoneType 1 /Frequency 60 /Angle 45
              /SpotFunction { pop pop 0 } >> >>
  sethalftone } /undefined (a type 5 with no Default) raises

% ------------------------------------------------- the entries of a wrong type
{ << /HalftoneType 1 /Frequency (sixty) /Angle 45
     /SpotFunction { pop pop 0 } >> sethalftone }
    /typecheck (a type 1 whose Frequency is a string) raises
{ << /HalftoneType 1 /Frequency 60 /Angle (forty-five)
     /SpotFunction { pop pop 0 } >> sethalftone }
    /typecheck (a type 1 whose Angle is a string) raises
{ << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction 7 >> sethalftone }
    /typecheck (a type 1 whose SpotFunction is a number) raises

{ << /HalftoneType 3 /Width (two) /Height 2 /Thresholds <0180C8FF> >>
  sethalftone } /typecheck (a type 3 whose Width is a string) raises
{ << /HalftoneType 3 /Width 2 /Height 2 /Thresholds 7 >> sethalftone }
    /typecheck (a type 3 whose Thresholds is a number) raises

% ------------------------------------------------------ inside the composite
% A type 5 is checked through to its components: a fault in one of them
% is a fault in the whole, and a component may not itself be composite.

{ << /HalftoneType 5
     /Gray << /HalftoneType 3 /Width 2 /Height 2 >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } /undefined (a type 5 whose component lacks an entry) raises

{ << /HalftoneType 5
     /Gray << /HalftoneType 99 >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } /rangecheck (a type 5 whose component has a bad type) raises

{ << /HalftoneType 5
     /Gray << /HalftoneType 5
              /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                          /SpotFunction { pop pop 0 } >> >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } /rangecheck (a type 5 nested in a type 5) raises

% A component stands for one colorant, so the two types that carry four
% screens at once are no more admissible there than a composite is.
% PLRM 7.4.6 allows a component of any type except 2, 4 or 5, and all
% three are refused alike -- a rule asked of one of them and not the
% others is how a family acquires a hole.
{ << /HalftoneType 5
     /Gray << /HalftoneType 2
              /RedFrequency 60 /RedAngle 0 /RedSpotFunction { pop pop 0 }
              /GreenFrequency 60 /GreenAngle 0 /GreenSpotFunction { pop pop 0 }
              /BlueFrequency 60 /BlueAngle 0 /BlueSpotFunction { pop pop 0 }
              /GrayFrequency 60 /GrayAngle 0 /GraySpotFunction { pop pop 0 } >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } /rangecheck (a type 2 as a type 5 component) raises
{ << /HalftoneType 5
     /Gray << /HalftoneType 4
              /RedWidth 2 /RedHeight 2 /RedThresholds <0180C8FF>
              /GreenWidth 2 /GreenHeight 2 /GreenThresholds <0180C8FF>
              /BlueWidth 2 /BlueHeight 2 /BlueThresholds <0180C8FF>
              /GrayWidth 2 /GrayHeight 2 /GrayThresholds <0180C8FF> >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } /rangecheck (a type 4 as a type 5 component) raises

% and the types the specification does allow there are still allowed
{ << /HalftoneType 5
     /Cyan << /HalftoneType 10 /Xsquare 2 /Ysquare 1
              /Thresholds <0040808000> >>
     /Magenta << /HalftoneType 6 /Width 2 /Height 2
                 /Thresholds (0180C8FF) /ASCIIHexDecode filter >>
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } (a type 5 over the component types PLRM allows) works

% a name rather than a halftone alongside the components is not a
% component, and does not make the dictionary invalid
{ << /HalftoneType 5 /HalftoneName (screen)
     /Default << /HalftoneType 1 /Frequency 60 /Angle 45
                 /SpotFunction { pop pop 0 } >> >>
  sethalftone } (a type 5 carrying a name) works

% ------------------------------------------------- a cell with no extent
% A screen frequency, the side of a rectangle, the side of a square and
% the second rectangle of an angled cell all state an extent, and an
% extent of zero or less describes no area. PLRM gives these entries a
% type but no bound; a dictionary carrying one is refused rather than
% screened with, and the error is the rangecheck that a value outside
% the range of legal values takes.

{ << /HalftoneType 1 /Frequency 0 /Angle 45 /SpotFunction { pop pop 0 } >>
  sethalftone } /rangecheck (a type 1 at no frequency) raises
{ << /HalftoneType 1 /Frequency -60 /Angle 45 /SpotFunction { pop pop 0 } >>
  sethalftone } /rangecheck (a type 1 at a negative frequency) raises

{ << /HalftoneType 3 /Width 0 /Height 2 /Thresholds <> >>
  sethalftone } /rangecheck (a type 3 no cell wide) raises
{ << /HalftoneType 3 /Width 2 /Height 0 /Thresholds <> >>
  sethalftone } /rangecheck (a type 3 no cell high) raises
{ << /HalftoneType 3 /Width -2 /Height 2 /Thresholds <> >>
  sethalftone } /rangecheck (a type 3 of negative width) raises

{ << /HalftoneType 6 /Width 0 /Height 2
     /Thresholds () /ASCIIHexDecode filter >>
  sethalftone } /rangecheck (a type 6 no cell wide) raises
{ << /HalftoneType 16 /Width 0 /Height 2
     /Thresholds () /ASCIIHexDecode filter >>
  sethalftone } /rangecheck (a type 16 no cell wide) raises

{ << /HalftoneType 10 /Xsquare 0 /Ysquare 3 /Thresholds 9 string >>
  sethalftone } /rangecheck (a type 10 whose square X has no side) raises
{ << /HalftoneType 10 /Xsquare 3 /Ysquare 0 /Thresholds 9 string >>
  sethalftone } /rangecheck (a type 10 whose square Y has no side) raises
{ << /HalftoneType 10 /Xsquare -3 /Ysquare 2 /Thresholds 13 string >>
  sethalftone } /rangecheck (a type 10 with a negative square) raises

% a second rectangle that is present describes a rectangle; one with no
% extent is not the way to say there is no second rectangle, which is to
% leave both entries out
{ << /HalftoneType 16 /Width 2 /Height 2 /Width2 0 /Height2 0
     /Thresholds 8 zerofile >>
  sethalftone } /rangecheck (a type 16 whose second rectangle has no extent) raises

% and the four-screen types are held to it in each of their primaries
{ << /HalftoneType 2
     /RedFrequency 60 /RedAngle 0 /RedSpotFunction { pop pop 0 }
     /GreenFrequency 60 /GreenAngle 0 /GreenSpotFunction { pop pop 0 }
     /BlueFrequency 60 /BlueAngle 0 /BlueSpotFunction { pop pop 0 }
     /GrayFrequency 0 /GrayAngle 0 /GraySpotFunction { pop pop 0 } >>
  sethalftone } /rangecheck (a type 2 whose grey screen has no frequency) raises
{ << /HalftoneType 4
     /RedWidth 2 /RedHeight 2 /RedThresholds <0180C8FF>
     /GreenWidth 2 /GreenHeight 2 /GreenThresholds <0180C8FF>
     /BlueWidth 2 /BlueHeight 2 /BlueThresholds <0180C8FF>
     /GrayWidth 0 /GrayHeight 2 /GrayThresholds <> >>
  sethalftone } /rangecheck (a type 4 whose grey cell has no width) raises

% ActualFrequency is not an extent either, though its name ends in one.
% It is an entry the operator WRITES: PLRM Table 7.4 has sethalftone set
% it to the frequency actually achieved, so a program supplies it with
% whatever value it likes -- nought being the obvious one -- and reads it
% back afterwards. Refusing it for its incoming value refuses the
% dictionary the specification asks for.
{ << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 }
     /ActualFrequency 0 /ActualAngle 0 >>
  sethalftone } (a type 1 asking what it actually got) works

% An angle is not an extent. Zero is straight, and a negative angle
% turns the other way, so neither is refused.
{ << /HalftoneType 1 /Frequency 60 /Angle 0 /SpotFunction { pop pop 0 } >>
  sethalftone } (a type 1 at no angle) works
{ << /HalftoneType 1 /Frequency 60 /Angle -45 /SpotFunction { pop pop 0 } >>
  sethalftone } (a type 1 at a negative angle) works

% ------------------------------------------- what the screen actually came to
% A screen is not given the frequency and angle asked for: a cell has to
% land on whole pixels, so the interpreter picks the nearest lattice it
% can tile the device with. PLRM Table 7.4 lets a program find out what
% it got -- if ActualFrequency and ActualAngle are present, sethalftone
% sets them to what was achieved, and leaves Frequency and Angle alone
% reflecting what was asked for. The feature is not available through
% setscreen, which has no dictionary to answer into.

/d1 << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 }
       /ActualFrequency 0 /ActualAngle 0 >> def
d1 sethalftone
/isnum { type dup /integertype eq exch /realtype eq or } bind def
d1 /ActualFrequency get isnum
    (sethalftone answers with the frequency achieved) assert
d1 /ActualAngle get isnum
    (sethalftone answers with the angle achieved) assert
d1 /ActualFrequency get 0 gt
    (the frequency achieved is a real screen frequency) assert
d1 /Frequency get 60 eq
    (the frequency asked for is left as it was asked) assert
d1 /Angle get 45 eq
    (the angle asked for is left as it was asked) assert

% asking again for what was achieved must achieve the same thing: the
% lattice that answered is one the search can reach, so a second pass
% settles rather than drifting
/got d1 /ActualFrequency get def
/d2 << /HalftoneType 1 /Frequency got /Angle d1 /ActualAngle get
       /SpotFunction { pop pop 0 } /ActualFrequency 0 >> def
{ d2 sethalftone } stopped
{ false }{ d2 /ActualFrequency get got sub abs 0.001 lt } ifelse
    (asking for what was achieved achieves it again) assert

% a dictionary that does not ask is not answered
/d3 << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction { pop pop 0 } >> def
d3 sethalftone
d3 /ActualFrequency known not
    (a dictionary that did not ask gains no answer) assert

% and setscreen answers nobody, having no dictionary to answer into
60 45 { pop pop 0 } setscreen
currenthalftone /ActualFrequency known not
    (setscreen leaves no achieved frequency behind) assert

% --------------------------------------------------- nothing is left behind
% A rejected halftone must not have displaced the one already in force.
%
% The framework's runners cannot ask this question. They put the graphics
% state back when a case raises, and the graphics state is where the
% halftone lives -- so a case run through them would be answered by the
% framework's own tidying whatever sethalftone did. These are run by hand
% for that reason.

<< /HalftoneType 1 /Frequency 33 /Angle 44 /SpotFunction { pop pop 0 } >>
sethalftone
{ << /HalftoneType 99 >> sethalftone } stopped pop clear
currenthalftone /Frequency get 33 eq
    (a rejected halftone leaves the current one in force) assert

% A type 16 is the type whose dictionary can be sound and whose FILE
% still cannot deliver the array, so the last thing that can refuse it is
% the read. The array is drawn out before any of the halftone is
% recorded: a file that ends early leaves the halftone in force whole --
% its type, the array a cell is built from, and its own ability to be
% reinstalled.

<< /HalftoneType 3 /Width 2 /Height 2 /Thresholds <0180C8FF> >> sethalftone
/htkept screendict /Thresholds get 4 string copy def
{ << /HalftoneType 16 /Width 2 /Height 2
     /Thresholds (01008040) /ASCIIHexDecode filter >> sethalftone } stopped
    (a type 16 whose file ends early is refused) assert
clear
currenthalftone /HalftoneType get 3 eq
    (a refused type 16 leaves the halftone type in force) assert
screendict /Thresholds get htkept eq
    (a refused type 16 leaves the threshold array in force) assert
currenthalftone sethalftone
currenthalftone /HalftoneType get 3 eq
    (the halftone a refused type 16 left can be reinstalled) assert

% and the control the three checks above need: a type 16 whose file DOES
% deliver the array replaces the halftone. Without it they would pass
% just as well against a sethalftone that had stopped installing
% anything at all.
<< /HalftoneType 16 /Width 2 /Height 2
   /Thresholds (0100804000C800FF) /ASCIIHexDecode filter >> sethalftone
currenthalftone /HalftoneType get 16 eq
    (a type 16 whose file delivers the array does replace the halftone) assert

% and the operand is still refused when it is not a dictionary at all
{ 7 sethalftone } /typecheck (a halftone that is not a dictionary) raises
verdict
