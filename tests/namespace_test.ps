% names present only when an optional library or the platform provides them
/optional <<
  (NOFACES) true  (WIN32) true  (currentcontext) true  (detach) true
  (fork) true  (join) true  (loadjpegdevice) true  (loadpngalphadevice) true
  (loadpngdevice) true  (loadwin32device) true  (loadxcbdevice) true  (resetfile) true
  (yield) true
>> def

% no name may leak: every systemdict name key is golden or optional
systemdict {
  pop dup type /nametype eq {
    128 string cvs
    golden 1 index known { pop }{
      optional 1 index known { pop }{ (unexpected systemdict key) bad } ifelse
    } ifelse
  }{ pop } ifelse
} forall

% nothing is missing: every golden name key is present in systemdict
golden {
  pop
  dup type /stringtype eq { dup cvn }{ dup } ifelse
  systemdict exch known { pop }{ (missing systemdict key) bad } ifelse
} forall

fail 0 eq { (SUCCESS) = }{ (FAILURES: ) print fail = } ifelse
end
