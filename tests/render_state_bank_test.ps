% What the machinery notes about a render in progress outlives the
% program's own restore.
%
% Three notes are written while a procedure of the program's is running --
% the page's, a pattern cell's and a glyph's -- and each is read afterwards
% by the machinery that ran that procedure. Bracketing such a procedure in
% save and restore is the ordinary shape of generated PostScript, and
% restore reverts local virtual memory wholesale (PLRM 3.7.2): a note kept
% there is rewound between the write and the read, and the machinery then
% acts on what the program erased. The notes are kept in global virtual
% memory, which restore leaves alone.
%
% Each case is judged by what came out and not by reading the note. What
% the machinery keeps is its own, and a suite that reached in to read it
% would be reporting on the note rather than on the render, and would pass
% on a tree where nothing that renders did.
%
% One case per note, chosen with -DCASE, and each carries a control: a
% render beside it that must come out differently. A case that has stopped
% seeing anything then fails on its control rather than reporting the
% render clean.
%
% The verdict is the wrapper's. This program paints, reports where the pen
% landed, and judges nothing.

CASE /pages eq {
    % The separation-plate idiom: one save and one restore around each
    % page. The count of pages transmitted fills the %d in the output
    % name, and it is advanced inside the bracket and read at the next
    % page. Each page is painted differently, so three pages that landed
    % on one name cannot be mistaken for three that were kept apart.
    1 1 3 {
        save exch                       % save-object n
        20 mul 20 100 50 rectfill
        showpage
        restore
    } for
    (  three pages painted, each differently\n) print
} if

CASE /glyph eq {
    % A Type 3 build procedure that brackets its own work. What the build
    % declared -- the advance, and that its marks were going to a capture
    % raster rather than to the page -- is written inside the bracket and
    % read after it, when the glyph is placed.
    %
    % Two glyphs paint the same box and declare the same width. One
    % brackets itself and the other does not, and the pages they make
    % must be the same page with the pen in the same place. The
    % unbracketed one is the control: a run that has stopped marking
    % anything fails on it rather than reporting the bracketed one clean.
    /Probe 8 dict def
    Probe begin
        /FontType 3 def
        /FontMatrix [0.001 0 0 0.001 0 0] def
        /FontBBox [0 0 1000 1000] def
        /Encoding 256 array def
        0 1 255 { Encoding exch /.notdef put } for
        Encoding 65 /A put
        Encoding 66 /B put
        /CharProcs 3 dict def
        CharProcs /A {
            save
            600 0 0 0 600 700 setcachedevice
            50 50 500 600 rectfill
            restore
        } bind put
        CharProcs /B {
            600 0 0 0 600 700 setcachedevice
            50 50 500 600 rectfill
        } bind put
        CharProcs /.notdef { 0 0 setcharwidth } bind put
        /BuildGlyph {
            exch /CharProcs get exch
            2 copy known not { pop /.notdef } if
            get exec
        } bind def
    end
    /Probe Probe definefont pop
    /Probe findfont 100 scalefont setfont

    % page 1: nothing painted, which is what the two below are weighed
    % against
    showpage

    % page 2: the control. How far the pen moved is reported to the
    % nearest unit: what it is weighed for is the difference between the
    % declared advance and none at all, and a fraction of a unit either
    % way is the arithmetic of the font matrix, not an answer.
    72 400 moveto (BBB) show
    (  control pen: ) print
    currentpoint pop 72 sub round cvi 20 string cvs print (\n) print
    showpage

    % page 3: the same three glyphs, each build bracketed in its own
    % save and restore
    72 400 moveto (AAA) show
    (  bracketed pen: ) print
    currentpoint pop 72 sub round cvi 20 string cvs print (\n) print
    showpage
} if

CASE /cells eq {
    % A tiling pattern whose paint procedure brackets its own work and
    % paints with a second pattern. The second pattern's space was fixed
    % against the page when it was instantiated, so the marks it makes
    % belong to coordinates the cell is not written in and the cell
    % cannot be filed as a pattern for the writer to repeat. The note
    % that says so is made inside the bracket, by the nested pattern, and
    % read after it.
    %
    % The cells are placed against the page instead, which is what the
    % run must show: a document carrying a tiling pattern here is one
    % that filed a cell it could not carry.
    /inner <<
        /PatternType 1 /PaintType 1 /TilingType 1
        /BBox [0 0 7 7] /XStep 7 /YStep 7
        /PaintProc { begin 0 setgray 0 0 3 7 rectfill end } bind
    >> matrix makepattern def
    <<
        /PatternType 1 /PaintType 1 /TilingType 1
        /BBox [0 0 40 40] /XStep 40 /YStep 40
        /PaintProc {
            save exch
            begin
                /Pattern setcolorspace inner setcolor
                4 4 32 32 rectfill
            end
            restore
        } bind
    >> matrix makepattern
    /Pattern setcolorspace setcolor
    100 100 80 80 rectfill
    showpage
    (  a cell painted with a second pattern\n) print
} if

CASE /cellcontrol eq {
    % The control for the case above, and the same pattern but for what
    % its paint procedure paints with: a colour of its own, which IS the
    % cell's, so the cell is filed and the document carries it as a
    % tiling pattern. A writer that has stopped filing cells altogether
    % fails here rather than reporting the case above clean.
    <<
        /PatternType 1 /PaintType 1 /TilingType 1
        /BBox [0 0 40 40] /XStep 40 /YStep 40
        /PaintProc {
            save exch
            begin
                0 setgray
                4 4 32 32 rectfill
            end
            restore
        } bind
    >> matrix makepattern
    /Pattern setcolorspace setcolor
    100 100 80 80 rectfill
    showpage
    (  a cell painted in a colour of its own\n) print
} if
