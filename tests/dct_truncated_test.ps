%!testlib
% A malformed or truncated JPEG stream must end the decode, not hang it,
% and a stream that was cut short must say so rather than read as empty.
% Run through `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% The decoder is fed from the filter's source a byte at a time, and a
% source that runs out has to be closed off with the marker the decoder
% is waiting for. An end-of-image marker is two bytes; a decoder handed
% the second one alone goes on asking for input that will never come.
%
% A program reads image data it did not write -- an embedded stream in a
% document -- so a stream that stops early is ordinary input, not an
% attack, and it has to be reported rather than waited on.
%
% A JPEG stream also carries markers whose payload the decoder does not
% read: a comment, an application block it knows nothing about. Those are
% stepped over at the source rather than parsed, and a decode that failed
% to step over one would read the payload as though it were the stream.
% The last part of this test makes that visible by hiding an end-of-image
% marker inside a comment in an image that decodes.


% start of image, then an APP0 marker whose declared length promises
% bytes that never arrive
/truncated <FFD8FFE000104A46> def

/reads { % (data)  .  bytecount-or--1
    /DCTDecode filter 64 string readstring
    { pop -1 }{ length } ifelse    % true means data followed: unexpected here
} def

% A stream that opened as a JPEG and then ran out is corrupt input, not
% an empty image, and PLRM 3.13 makes that an ioerror. Reading it as no
% scanlines would be indistinguishable from a picture that is genuinely
% blank.
{ truncated reads pop } stopped
    (a truncated JPEG stream reports rather than reading as empty) assert
$error /errorname get /ioerror eq
    (a truncated JPEG stream is an ioerror) assert
clear

{ (not a jpeg, just some text) reads 0 eq
    (a stream that is not a JPEG yields no scanlines) assert }
stopped { (FAIL: reading a non-JPEG errored) print (\n) print
          /failcount failcount 1 add store } if
clear

{ () reads 0 eq (an empty stream yields no scanlines) assert }
stopped { (FAIL: reading an empty stream errored) print (\n) print
          /failcount failcount 1 add store } if
clear

% read to exhaustion rather than once: the loop has to end. It ends by
% raising now rather than by running out of scanlines, and the point of
% the case is unchanged -- what must not happen is waiting for input that
% will never arrive.
/rounds 0 def
{ /f truncated /DCTDecode filter def
  { f 64 string readstring not { exit } if pop
    /rounds rounds 1 add store
    rounds 1000 ge { exit } if } loop
} stopped (reading a truncated stream to its end ends the read) assert
rounds 1000 lt (the read to exhaustion ends rather than repeating) assert
clear

% bytes that are no marker, sitting between two that are: the decoder
% steps past them and says so, and the stream still ends
{ <FFD841424344FFD9> reads 0 eq
    (a stream with bytes between its markers yields no scanlines) assert }
stopped { (FAIL: reading a stream with stray bytes errored) print (\n) print
          /failcount failcount 1 add store } if
clear

% a comment marker whose payload is entirely present, and one whose
% payload the stream ends in the middle of: stepping over either has to
% leave the decode able to finish rather than waiting on the rest
{ <FFD8FFFE0008010203040506FFD9> reads 0 eq
    (a stream whose comment is complete yields no scanlines) assert }
stopped { (FAIL: reading a stream with a comment errored) print (\n) print
          /failcount failcount 1 add store } if
clear

% the payload this one declares never arrives, so the stream ran out:
% cut short inside a comment is cut short like any other
{ <FFD8FFFE00200102> reads pop } stopped
    (a stream cut off inside a comment reports) assert
$error /errorname get /ioerror eq
    (a stream cut off inside a comment is an ioerror) assert
clear

% An image that does decode, with a comment spliced in ahead of
% everything the decoder reads. The comment's payload is three
% end-of-image markers, so a decode that read the payload instead of
% stepping over it would stop at the first of them with no picture; the
% picture is the assertion.
/scratch (dct_scratch) def
/f scratch (w) file def
/e f << /Columns 16 /Rows 16 /Colors 1 >> /DCTEncode filter def
/data 256 string def
0 1 255 { dup dup 16 mod exch 16 idiv add 8 mul data 3 1 roll put } for
e data writestring e closefile f closefile

% the file is closed before it is deleted: a platform may hold a name
% that something still has open, and the delete is then refused
/jf scratch (r) file def
/jpg jf 8192 string readstring pop def
jf closefile
/plain 256 string def
jpg /DCTDecode filter plain readstring pop pop
scratch deletefile

% start of image, comment marker, its declared length, its payload
/comment <FFFE0008FFD9FFD9FFD9> def
/spliced jpg length comment length add string def
spliced 0 jpg 0 2 getinterval putinterval
spliced 2 comment putinterval
spliced 2 comment length add jpg 2 jpg length 2 sub getinterval putinterval

/hidden 256 string def
/decoded spliced /DCTDecode filter hidden readstring pop def
decoded length 256 eq
    (an image behind a comment decodes to its whole raster) assert
decoded plain eq
    (a comment ahead of the image changes none of its samples) assert
clear

% the interpreter is still usable afterwards
1 2 add 3 eq (the interpreter still works after the malformed streams) assert

verdict
