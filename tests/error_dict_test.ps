%!testlib
% What the error dictionary is defined to carry, and what the standard
% handler is defined to do to it, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% A program that handles its own errors reads $error, so every entry the
% language names has to be there with the value it is defined to start
% at -- an entry that is simply absent answers undefined at the moment a
% program is already coping with something going wrong. The standard
% handler in turn is defined to consume what it reported: it clears the
% flag that says an error is outstanding, and the context entry that
% belongs to the error just reported.


% ------------------------------------------------------------ the entries
% Every entry the language names, present before anything has gone
% wrong.

/missing 0 def
[ /newerror /errorname /command /errorinfo
  /ostack /estack /dstack /recordstacks /binary ] {
    dup $error exch known not {
        (FAIL: $error has no ) print ==
        /missing missing 1 add store
    }{ pop } ifelse
} forall
missing 0 eq (every entry the language names is present) assert

% and the two flags start at the values they are defined to start at
$error /recordstacks get true eq (recordstacks starts true) assert
$error /binary get false eq (binary starts false) assert

% ------------------------------------------------------- what an error fills
% An error records its own name and what was executing, and raises the
% flag that says one is outstanding.

{ 1 0 div } stopped (a divide by zero is caught) assert
$error /newerror get (newerror is raised) assert
$error /errorname get /undefinedresult eq (errorname is the error) assert
$error /command get 40 string cvs (div) eq (command is what was executing) assert

% the snapshots are taken while recordstacks says to
$error /ostack get null ne (the operand stack is recorded) assert
$error /estack get null ne (the execution stack is recorded) assert
$error /dstack get null ne (the dictionary stack is recorded) assert

% ------------------------------------------------- what the handler consumes
% handleerror lowers the flag and clears the context of the error it
% just reported, so the next reader is not told about the last error.

$error /errorinfo [ /SomeKey 7 ] put
errordict /handleerror get exec
$error /newerror get not (handleerror lowers newerror) assert
$error /errorinfo get null eq (handleerror clears errorinfo) assert

% and a second call reports nothing, the flag being down
errordict /handleerror get exec
$error /newerror get not (handleerror stays quiet with no error) assert

% ------------------------------------------------------ recordstacks obeyed
% With the flag down the snapshots are not taken, which is the whole
% point of a program lowering it.

$error /recordstacks false put
$error /ostack null put
{ 1 0 div } stopped pop
$error /ostack get null eq (no snapshot is taken when recordstacks is false) assert
$error /recordstacks true put
$error /newerror false put

% ------------------------------------------------- a handler for every error
% PLRM 3.11: every error name is a key in errordict, and 3.11.2: the
% errordict present in the initial state of VM provides standard handlers
% for all errors. The interpreter reaches a handler by looking its name up
% there, so a name with no entry is an error a program can neither observe
% through $error nor take over -- the idiom of fetching the standard
% handler, wrapping it and putting it back cannot even be written.
%
% execstackunderflow is one the interpreter raises: the control operators
% that resume a loop from its execution-stack frame report it when the
% frame is not there.

errordict /execstackunderflow known
    (errordict carries a handler for execstackunderflow) assert

% the rest of this section reads the entry, so it runs only when there is
% one to read: without the guard a missing entry ends the job on an
% undefined error and the failure above never reaches the report
errordict /execstackunderflow known {

    % it is the standard handler: it records the error's name and what was
    % executing into $error, and stops, so an enclosing stopped context
    % sees it
    { /aloop errordict /execstackunderflow get exec } stopped
        (the execstackunderflow handler stops) assert
    $error /errorname get /execstackunderflow eq
        (it records the error's name) assert
    $error /command get /aloop eq
        (it records what was executing) assert
    $error /newerror get (it raises newerror) assert
    $error /newerror false put

    % and a program replaces it selectively, the entry being there to
    % fetch, wrap and put back
    /standard errordict /execstackunderflow get def
    /substituted false def
    errordict /execstackunderflow { /substituted true store } put
    errordict /execstackunderflow get exec
    substituted (a program's own handler replaces the standard one) assert
    errordict /execstackunderflow /standard load put
    errordict /execstackunderflow get /standard load eq
        (the standard handler goes back) assert

} if

% PLRM 3.11.2 defines ostack as "a snapshot of the entire operand stack
% immediately before the error". A snapshot that was never taken must not
% be answered with one belonging to an earlier error: recordstacks turns
% the recording off, and what was left behind was the previous error's
% stack, reported by the standard handler under this error's name.
{ 111 222 333 nosuchoperatorA } stopped pop
$error /ostack get type /arraytype eq
    (a recorded error holds its own operand stack) assert
$error /recordstacks false put
{ 999 nosuchoperatorB } stopped pop
$error /ostack get null eq
    (an error recorded no stack holds none, rather than the last one's) assert
$error /estack get null eq
    (and none of the execution stack) assert
$error /dstack get null eq
    (and none of the dictionary stack) assert
$error /recordstacks true put
{ 444 nosuchoperatorC } stopped pop
$error /ostack get type /arraytype eq
    (and recording it again restores the snapshot) assert

verdict
