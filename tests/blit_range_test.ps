%!
% The blit's dictionary is data, and the counts it carries index fixed
% tables inside the operator: one plane pointer, one decode table, one
% decoded sample and one mask range pair per component, and the entries
% of the baked colour table per native byte. A dictionary is reachable
% from a program, so a count outside what those tables hold has to be
% reported rather than followed: it is a rangecheck, and the operator
% must still be there afterwards.
%
% The same holds for the counts that walk the caller's own strings: the
% row width counts samples along the sample row, and the row index and
% the mask stride together name the mask bits for the row. Each is
% checked against the string it walks, and the check has to hold for
% every count a dictionary can carry -- including the pairs whose
% product is larger than the type an index is formed in, which is where
% a check written as a multiplication stops saying anything.
%
% Each case below hands .blitrow a dictionary that is well formed apart
% from one count, and requires that error. A count of zero is the case
% that leaves every per-component table empty while the row is still
% blitted from it.

/fails 0 def
/note { print (\n) print } def

/id 1183615869 internaldict def
/blit id /.blitrow get def

/lut 256 string def
/dl 256 string def

% width and component count  .  a blit dictionary that is otherwise sound
/bd {
  /nc exch def
  /nn exch def
  <<
    /devw 4 /devh 4 /nat nn /w 1 /h 4 /ncomp nc /y 0
    /mw 1 /mh 4
    /rgbrows false /cmyk false
    /xoff 0 /xscale 1 /yoff 0 /yscale 1
    /cx0 0 /cy0 0 /cx1 4 /cy1 4
    /rows [ 4 string 4 string 4 string 4 string ]
    /lut lut
  >>
} def

% dict label  .  -   run the blit; expect rangecheck
/expectrange {
  /label exch def
  /d0 countdictstack def
  { blit } stopped
  dup { $error /errorname get 128 string cvs }{ (none) } ifelse
  countdictstack d0 sub { end } repeat
  exch
  { dup (rangecheck) eq
    { pop (ok   ) print label note }
    { /fails fails 1 add def
      (FAIL: ) print label print ( raised ) print note } ifelse }
  { pop /fails fails 1 add def
    (FAIL: ) print label print ( raised no error) note } ifelse
} def

% --- planar sources: the plane pointer table ---
% bufs supplies one row buffer per component, so a count of zero fills
% none of them and a count above four has none to fill
1 0 bd dup /bufs [ (a) ] put (planar blit of no components) expectrange
1 5 bd dup /bufs [ (a) (a) (a) (a) (a) ] put
  (planar blit of five components) expectrange

% --- interleaved source: the decode tables and the sample vector ---
1 0 bd dup /buf 8 string put (interleaved blit of no components) expectrange
1 5 bd dup /buf 8 string put dup /lut undef
  dup /dluts [ dl dl dl dl dl ] put dup /tlut 256 string put
  (interleaved blit of five components) expectrange

% --- the baked colour table is indexed by the native byte count ---
% its length is checked against that count, so a count of zero passes a
% table of no entries to a read of one
0 1 bd dup /buf 8 string put dup /lut () put
  (blit into no native bytes) expectrange
4 1 bd dup /buf 8 string put (blit into four native bytes) expectrange

% --- the row width walks the sample row ---
% the row holds ncomp samples per pixel, so a width the row cannot
% carry is refused -- including one whose product with the component
% count is too large for the type the samples are indexed with
1 4 bd dup /buf 8 string put dup /lut undef
  dup /dluts [ dl dl dl dl ] put dup /tlut 256 string put
  dup /w 1073741824 put
  (blit of a row wider than its samples) expectrange
1 1 bd dup /buf 8 string put dup /w -1 put
  (blit of a row of negative width) expectrange

% --- the mask grid and the mask stride walk the mask bits ---
% the mask holds one row of mrowb bytes per row of its own grid, and
% the row a device row falls on selects among them: a negative sample
% row reads before the mask, a stride the mask cannot carry reads past
% it, a stride too short for a mask row reads the row after's bits as
% this row's, and a grid with no samples in it divides by nothing
1 1 bd dup /buf 8 string put dup /devh 8 put
  dup /rows [ 4 string 4 string 4 string 4 string
              4 string 4 string 4 string 4 string ] put
  dup /cy1 8 put dup /yoff 4 put
  dup /mbits 8 string put dup /mrowb 1 put dup /y -1 put
  (blit of a row before the mask) expectrange
1 1 bd dup /buf 8 string put
  dup /mbits 8 string put dup /mrowb 2000000000 put
  (blit through a mask stride the mask cannot hold) expectrange
1 1 bd dup /buf 8 string put
  dup /mbits 8 string put dup /mrowb 1 put dup /mh 100 put
  (blit through more mask rows than the mask holds) expectrange
1 1 bd dup /buf 8 string put
  dup /mbits 8 string put dup /mrowb 1 put dup /mw 100 put
  (blit through a mask row wider than its stride) expectrange
1 1 bd dup /buf 8 string put
  dup /mbits 8 string put dup /mrowb 1 put dup /mh 0 put
  (blit through a mask of no rows) expectrange
1 1 bd dup /buf 8 string put
  dup /mbits 8 string put dup /mrowb 1 put dup /mw 0 put
  (blit through a mask of no columns) expectrange

% the operator still answers a sound dictionary
/d 1 1 bd def
d /buf 8 string put
{ d blit } stopped
{ /fails fails 1 add def
  (FAIL: a sound dictionary raised ) print
  $error /errorname get 128 string cvs note }
{ (ok   a sound dictionary still blits) note } ifelse

% and a sound masked blit still reaches the raster: one row of mask
% bytes per sample row, the row index inside them, a clear bit over the
% pixel -- and the pixel takes the colour the table names
/white 256 string def
0 1 255 { white exch 255 put } for
/md 1 1 bd def
md /w 4 put
md /mw 4 put
md /buf 4 string put
md /lut white put
md /mbits 4 string put
md /mrowb 1 put
md /y 1 put
md /yoff 0 put
{ md blit } stopped
{ /fails fails 1 add def
  (FAIL: a sound masked dictionary raised ) print
  $error /errorname get 128 string cvs note }
{ md /rows get 1 get 0 get 255 eq
  { (ok   a sound masked blit still paints) note }
  { /fails fails 1 add def
    (FAIL: a sound masked blit painted nothing) note } ifelse } ifelse

fails 0 eq { (SUCCESS) = }{ (FAILURES: ) print fails 20 string cvs note } ifelse
quit
