%!testlib
% What a dictionary key is -- how a string key resolves to one, and the
% attribute a stored key carries -- run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% A dictionary key that is a name is compared by its interned identity, so
% a string key is resolved to the name it names before the lookup. A store
% must intern -- its key is about to live in the dictionary -- but a read
% (known/get/where/load/undef) that interned an unseen string would leave a
% permanent name behind, one no collection reclaims, for a key that matched
% nothing. A program probing a dictionary with unbounded distinct strings
% would then grow the name table without end. The read resolves the string
% without interning instead: a string that is not already a name is in no
% dictionary, so the miss is answered and nothing is minted.

% ---- the resolution is unchanged: a string key finds the name key it equals

/d << /alpha 1 /beta 2 >> def

{ d (alpha) known } (a string key equal to a stored name key is known) works
d (alpha) known (a present string key reads as known) assert
d (alpha) get 1 eq (a string key gets the value stored under the name) assert
d (gamma) known not (an absent string key is not known) assert
{ d (gamma) get } /undefined (get of an absent string key is undefined) raises

% where resolves a string key across the dictionary stack
d begin (alpha) where { pop true } { false } ifelse end
/wf exch def
wf (where finds a string key that names a defined name) assert
(neverdefinedanywhere) where { pop false } { true } ifelse
    (where does not find a string that names nothing) assert

% undef by string key removes the entry named by the string
d (beta) undef
d (beta) known not (undef by string key removes the named entry) assert
% undef of an absent key behaves the same whether the key is a string or a
% name -- outcome is /ok or the error raised, and they must agree
{ d (noSuchKey) undef } outcome
{ d /noSuchKey undef } outcome
eq (undef of an absent string key matches undef of an absent name key) assert

% ---- the name a string key resolves to is the whole string

% A string is a counted array of bytes whose elements are "integers in
% the range 0 to 255" (PLRM 3.3.7), so a 0 among them is a character of
% the key like any other and the count is what says where the key ends.
% Two strings differing only past a 0 are different keys, and neither is
% the key the bytes before the 0 spell.

/dn 4 dict def
dn <410042> (whole) put

dn <410042> known (a string key carrying a nul is found by itself) assert
dn <410042> get (whole) eq (and reads back the value stored under it) assert
dn <4100> known not
    (a key one character shorter is a different key) assert
dn (A) known not
    (and so are the characters before the nul alone) assert
dn <41004243> known not
    (and so is a key one character longer) assert

% the same two keys as names, which is the resolution a string key has to
% agree with: cvn takes every byte of the string (PLRM 3.3.7), so the
% names differ and the dictionary must not answer one for the other
<410042> cvn <4100> cvn eq not
    (two names differing past a nul are different names) assert
dn <410042> cvn known (the name a nul-carrying string key resolves to is stored) assert
dn <4100> cvn known not (and the shorter name is not) assert

% a store keyed by such a string reaches only its own entry: putting the
% shorter key leaves the longer one where it was
dn <4100> (part) put
dn <410042> get (whole) eq (a store under the shorter key leaves the longer one alone) assert
dn <4100> get (part) eq (and the shorter key holds what was stored under it) assert
dn length 2 eq (so the two keys occupy two entries) assert

% ---- a stored key is a literal name, whoever stored it

% forall hands back the object stored beside the value, so the attribute a
% key was stored with is one a program reads. Executability belongs to the
% token a name was scanned from: /add is literal, add inside a procedure is
% executable, and a name that was never scanned -- a key, or cvn of a
% string -- takes the attribute PLRM 3.3.4 gives it rather than a default.
% A key is not being executed, so every key in these dictionaries is
% literal, whether the entry came from PostScript or was installed by the
% interpreter itself.

/execkeys { 0 exch { pop xcheck { 1 add } if } forall } def

{ systemdict execkeys } (counting executable keys works) works
systemdict execkeys 0 eq    (every systemdict key is literal) assert
userdict execkeys 0 eq      (every userdict key is literal) assert
globaldict execkeys 0 eq    (every globaldict key is literal) assert
statusdict execkeys 0 eq    (every statusdict key is literal) assert
errordict execkeys 0 eq     (every errordict key is literal) assert
$error execkeys 0 eq        ($error's keys are literal) assert
FontDirectory execkeys 0 eq (FontDirectory's keys are literal) assert

% the two ways an entry gets into systemdict, each checked at its key: add
% is an operator the interpreter installs, clip one written in PostScript
/keyfor {  % string  .  key-as-stored
    /_want exch def /_got null def
    systemdict { pop dup 40 string cvs _want eq { /_got exch def } { pop }
        ifelse } forall
    _got
} def

(add) keyfor  dup xcheck not (the key an installed operator is stored under is literal) assert
    type /nametype eq (that key is a name) assert
(clip) keyfor dup xcheck not (the key a PostScript-defined operator is stored under is literal) assert
    type /nametype eq (that key is a name too) assert

% which is what makes a harvested key inert: a program that collects keys
% and executes them gets the names, not the operators they name
[ (add) keyfor ] cvx exec
dup type /nametype eq (executing a harvested key yields the name) assert
xcheck not (and the name it yields is literal) assert

% the scanner is what applies executability, and cvn follows its string
/add xcheck not (a name written /name is literal) assert
{ add } 0 get xcheck (a name scanned from an unquoted token is executable) assert
(add) cvn xcheck not (cvn of a literal string yields a literal name) assert
(add) cvx cvn xcheck (cvn of an executable string yields an executable name) assert

% ---- probing with distinct strings does not grow virtual memory

% reuse one buffer so building the key allocates nothing per iteration; the
% only per-iteration allocation without the fix is the interned name. Both
% the names and the count vmstatus reports are local here. Collection is
% turned off so that the memory vmstatus reports is what is live rather
% than what an arena reuse has reached (PLRM C.3.5): the reading before and
% after the loop then measures exactly what the loop retained.
false setglobal
-2 vmreclaim
/buf 24 string def
vmstatus pop /used0 exch def pop
1 1 8000 { buf cvs pop
    d buf known pop } for
vmstatus pop /used1 exch def pop
% With the fix the loop interns nothing, so used barely moves; without it
% 8000 distinct twenty-character names add well over a megabyte.
used1 used0 sub 200000 lt
    (probing with 8000 distinct string keys does not grow VM) assert

verdict
