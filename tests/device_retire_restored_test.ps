% A restore that displaces the device setpagedevice installed retires it.
% Run against a live device (-d <dev>) by run-device-restore-test.sh:
% prints SUCCESS iff every step holds.
%
% PLRM 6.1 makes the page device an element of the graphics state, so a
% restore back past a setpagedevice deactivates the device the request
% installed and reactivates the one the saved state names. What the
% displaced device holds is a raster or a content accumulator outside
% virtual memory: the collector owns none of it and will never look, so
% it is released at the restore or not at all.
%
% The raster is the part of that a program can see, and a mark is what
% tells a raster that is still there from one that is gone. A pixel
% painted on the installed page reads back as the paint; a released
% raster holds no pixel and reads as the page's ground, the colour it was
% cleared to. So the pixel is painted and read before the restore and
% read again after it, and the two readings tell the two apart. The
% reading before is taken first: without it a device that never had a
% raster to read would answer the ground both times and agree for the
% wrong reason.
%
% A device whose Destroy is a PostScript procedure is out of the
% restore's reach, restore executing no PostScript. Those classes keep
% their raster as PostScript objects the collector already owns, so they
% have nothing to release and nothing to answer here.
%
% Every exit from the body below states its own verdict, so an error the
% body did not expect leaves the one standing here and is reported rather
% than caught and passed over.

/getdevice { DEVICE } def

/verdict (FAILURE: the run raised an error) def
/bail { /verdict exch def stop } def

{
    % An operator of the program's own under /Destroy, written onto the
    % instance the request built. A page-device request cannot put it
    % there: a request states page-device parameters and a device's
    % painting procedures are not among them, so a key naming one is
    % dropped rather than carried onto the device. The slot is reached
    % here the way the later cases reach it, through the device the
    % graphics state holds. The release runs where no procedure can run
    % and nothing catches an error, so what runs there is a release a
    % device class installed or nothing at all. dup is an operator whose
    % having run is visible: the release pushes the instance before
    % calling what it recorded, so a call leaves the instance and its
    % duplicate behind on the operand stack. Every device answers this
    % one, whatever the class put in the slot.
    count /before exch def
    save
    << /PageSize [400 400] >> setpagedevice
    getdevice /Destroy /dup load put
    getdevice /Destroy get type /operatortype ne
        { (FAILURE: the operator did not reach the instance) bail }
    if

    restore

    count before ne
        { (FAILURE: an operator of the program's own ran from the restore)
          bail }
    if

    getdevice /Destroy get type /operatortype ne { (SUCCESS) bail } if
    getdevice /GetPix known not { (SUCCESS) bail } if

    % the arity of the read slot, established on the live device
    clear
    2 2 getdevice dup /GetPix get exec
    count /ncomp exch def
    ncomp 0 le { (FAILURE: GetPix returned no components) bail } if
    clear

    % The mark the readings below are taken against: black on a page
    % erased to its ground, so a raster that is still there answers with
    % the paint and one that is gone answers with the ground. Defined
    % here, outside every save below, so a restore does not take the
    % definition away with the device it retires.
    /paintmark { ncomp { 0 } repeat 2 2 getdevice dup /PutPix get exec } def

    save

    << /PageSize [400 400] >> setpagedevice

    paintmark
    2 2 getdevice dup /GetPix get exec
    /live 0 def
    ncomp { 0 ne { /live live 1 add def } if } repeat
    live 0 ne {
        % The reading is not the paint, so this device reports no pixel
        % back: it answers the ground wherever it holds none, which is
        % what the contract has a device answer and is what a device
        % holding the page as the marks that made it answers everywhere.
        % The raster question below is asked by reading a mark, so it
        % cannot be asked of such a device at all -- and a device that
        % has quietly stopped reporting reads exactly the same, which is
        % why the wrapper holds the set that says this against the
        % devices it is written for.
        (NOREADBACK\n) print flush
        (SUCCESS) bail
    } if
    (READBACK\n) print flush

    % hold the replacement under the save object, so the program still
    % names it once the restore has taken it out of the graphics state
    getdevice exch

    restore

    % the read that says whether the restore retired it: the mark is
    % gone with the raster that held it
    2 2 3 -1 roll dup /GetPix get exec
    /bad 0 def
    ncomp { 0 ne { /bad bad 1 add def } if } repeat
    bad 0 eq
        { (FAILURE: a device displaced by restore kept its raster) bail }
    if

    % painting on the reinstated device, which the setpagedevice above
    % retired and whose raster is gone: it takes no marks and follows
    % nothing (device_restore_retired_test.ps)
    0 setgray 10 10 50 50 rectfill

    % The same again with the installed device's Destroy overwritten. Each
    % class keeps its C state in a string under /Private and each puts a
    % different struct there, so which release a device gets is not the
    % program's to choose: read a raster device's private state as a
    % vector writer's and the release frees a pointer taken from the
    % middle of it. The release the restore performs is the one the device
    % was installed carrying.
    save

    << /PageSize [400 400] >> setpagedevice
    getdevice /Destroy { } put
    getdevice /Destroy get type /arraytype ne
        { (FAILURE: the device's Destroy did not take the overwrite) bail }
    if
    paintmark
    getdevice exch

    restore

    2 2 3 -1 roll dup /GetPix get exec
    /bad 0 def
    ncomp { 0 ne { /bad bad 1 add def } if } repeat
    bad 0 eq
        { (FAILURE: an overwritten Destroy chose the release) bail }
    if

    % The same again with an operator of the program's own under
    % /Destroy, which a page device request puts there: setpagedevice
    % writes the keys it was given into the instance it builds, so the
    % slot is one a program reaches without naming anything internal.
    % The release runs where no procedure can run and nothing catches an
    % error, so what runs there is a release a device class installed or
    % nothing at all. dup is an operator whose having run is visible: the
    % release pushes the instance before calling what it recorded, so a
    % call leaves the instance and its duplicate behind on the operand
    % stack.
    % A restore that leaves the install standing displaces nothing and so
    % retires nothing: the device below is installed under the outer save
    % and the inner restore goes back only as far as the inner save. A
    % program that brackets a page in save and restore having already set
    % the page up goes on painting on that page.
    save
    << /PageSize [400 400] >> setpagedevice
    paintmark
    save
    restore
    2 2 getdevice dup /GetPix get exec
    /kept 0 def
    ncomp { 0 ne { /kept kept 1 add def } if } repeat
    kept 0 ne
        { (FAILURE: a restore that displaced nothing retired the device) bail }
    if
    restore

    << /PageSize [300 300] >> setpagedevice
    currentpagedevice /PageSize get 0 get 300 ne
        { (FAILURE: setpagedevice stopped working after the restore) bail }
    if

    count 0 ne { (FAILURE: operand stack unbalanced) bail } if
    (SUCCESS) bail
} stopped pop

clear
verdict =
