%!testlib
% Dispatch-dictionary tamper resistance, run through `xpost -d null` by
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% run-ps-test.sh: prints SUCCESS iff no internal dispatch dictionary stores an
% executable NAME where an operator value belongs.
%
% The interpreter's machinery must be immune to a program redefining standard
% operators. `bind` (via init.ps .bindscope) freezes the operator names inside
% every stored procedure, but a name held as DATA in a dispatch dictionary is
% re-looked-up on the dictionary stack each time it executes -- so an entry like
%     /DeviceRGB /setrgbcolor cvx
% reaches a program's redefinition of setrgbcolor instead of the operator (the
% casselman ch8 execstackoverflow: its setrgbcolor re-enters setcolor). The safe
% idiom stores the VALUE: /DeviceRGB /setrgbcolor load. This test walks every
% reachable internal namespace and flags executable-name entries, so the class
% stays closed as dispatch tables are added.
%
% .xpostsys itself is hidden from name lookup after lockdown; it is recovered
% here through the introspection accessors, which answer a run that asked
% for them with names and with one value at a time. Walking a bound
% procedure no longer reaches it: the machinery's bodies are execute-only,
% which is what closes reading a body as a route to what it froze in.

% --- recover .xpostsys from a privatedict-anchored bound procedure ---
% (values are taken cvlit: a walked element may be an operator or an
% executable name, and a bare variable reference would execute it)
% The namespace is not recovered by reading a bound body: the bodies the
% machinery runs are execute-only, so a program cannot read one and lift
% out the dictionary bind froze into it. It is enumerated instead, by the
% accessors a run that asked for introspection is given -- names, and a
% value at a time. What is scanned below is therefore a copy built from
% those, and the namespace itself is never handed over.
/ID 1183615869 internaldict def
/NSV ID /.namespacevalue get def
/found 600 dict def
/xpostsys ID /.namespacenames get exec {
  dup /xpostsys exch NSV
  found 3 1 roll put
} forall
found length 0 gt (the .xpostsys namespace is enumerable for scanning) assert

% --- the scanner: count executable-name values in a dict, recursing into
%     sub-dictionaries ---
/nbad 0 def
/scan { % dict label depth
  4 dict begin
  /d exch def /label exch def /dct exch cvlit def
  { dct {
      exch cvlit /k exch def
      dup xcheck /vx exch def cvlit /v exch def
      v type /nametype eq vx and {
        (  executable-name entry: ) print label print (/) print
        k 128 string cvs print ( -> ) print v 128 string cvs print (\n) print
        /nbad nbad 1 add store
      } if
      v type /dicttype eq d 0 gt and { v label d 1 sub scan } if
  } forall } stopped { pop pop } if
  end
} def

% the scanner must actually catch the unsafe idiom before its zero means anything
/nbad 0 def
<< /good /setgray load  /bad /setgray cvx >> (selftest) 0 scan
nbad 1 eq (the scanner flags a planted executable-name entry) assert

% --- the real sweep: every reachable internal namespace ---
/nbad 0 def
found null ne { found (.xpostsys) 2 scan } if
1183615869 internaldict (.internaldict) 2 scan
.gscratch (.gscratch) 2 scan
errordict (errordict) 1 scan
statusdict (statusdict) 1 scan
found null ne {
    graphicsdict dup type /dicttype eq
        { (graphicsdict) 2 scan }{ pop } ifelse
} if
nbad 0 eq (no internal dispatch dictionary stores an executable name) assert

% --- the nested-table bound-ness sweep: a procedure stored inside a NESTED
%     dispatch dictionary (a table within a table, like the per-space entries
%     of .colorconversiondict) must not carry an executable name that resolves to
%     a standard operator. The lockdown's .bindscope descends recursively, so
%     these are frozen structurally; a regression to fixed-depth descent, or
%     a new nested table added without a per-procedure bind, resurfaces here.
%
%     Two things are exempt. Top-level machinery procedures, because the
%     sweep is asked for nested tables only. And the wrapped operators
%     wherever they appear -- not because their bodies are known to be
%     frozen, but because this sweep never reaches them: it scans
%     .xpostsys, .internaldict, .gscratch and graphicsdict, while the
%     promoted bodies live in the register in privatedict, which is not
%     among its targets.
%
%     So the exemption asserts nothing about those bodies, and it is safe
%     only because another guard owns that population outright:
%     tests/check-wrapped-bind.sh walks every promoted body and holds each
%     operator it reaches by name to tests/wrapped_bind.golden, a register
%     that only shrinks. Widening the exemption here, or narrowing what
%     that script walks, breaks the pairing -- either is a change to both
%     files, and neither is a local decision. ---
% The exemption list is the register of wrapped procedures. Finding it is
% not optional: an empty list exempts nothing, so every exempt name is
% reported instead and the run reads as a crowd of procedures losing their
% bindings. That is what a moved register looked like once already, so a
% missing one is a failure here rather than a silently different test.
/wrapped
  .privatedict /.wrappedprocs 2 copy known
  { get }
  { pop pop (FAIL: the register of wrapped procedures is not reachable\n) print
    /fail fail 1 add def 0 dict } ifelse
def
/nunbound 0 def
/pscan { % proc label depth  -  (flag exec-name elements resolving to operators)
  4 dict begin
  /d exch def /label exch def /p exch cvlit def
  % the same: p is only asked whether it is readable once it is known to
  % be something that carries an access at all
  p type /arraytype eq { p rcheck }{ false } ifelse {
    0 1 p length 1 sub {
      p exch get
      dup xcheck exch cvlit /v exch def /vx exch def
      v type /nametype eq vx and {
        systemdict v 2 copy known { get type /operatortype eq }{ pop pop false } ifelse
        wrapped v known not and {
          (  unbound operator reference: ) print label print ( -> ) print
          v 128 string cvs print (\n) print
          /nunbound nunbound 1 add store
        } if
      } if
      v type /arraytype eq vx and d 0 gt and { v label d 1 sub pscan } if
    } for
  } if
  end
} def
/bscan { % dict label depth inner  -   (inner: procs of this dict are scanned)
  5 dict begin
  /inner exch def /d exch def /label exch def /dct exch cvlit def
  { dct {
      exch pop
      dup xcheck exch cvlit /v exch def /vx exch def
      v type /arraytype eq vx and inner and { v label 6 pscan } if
      v type /dicttype eq d 0 gt and { v label d 1 sub true bscan } if
  } forall } stopped { pop pop } if
  end
} def

% the scanner must catch a planted unbound reference before its zero counts
% (the plant is assembled at run time: a source-literal procedure here would
% carry this test file's own unbound tokens and inflate the count)
/nunbound 0 def
<< /table << /planted [ /add cvx ] cvx >> >> (selftest) 2 false bscan
nunbound 1 eq (the bound-ness scanner flags a planted unbound reference) assert

/nunbound 0 def
found null ne { found (.xpostsys) 6 false bscan } if
1183615869 internaldict (.internaldict) 6 false bscan
.gscratch (.gscratch) 6 false bscan
found null ne {
    graphicsdict dup type /dicttype eq
        { (graphicsdict) 6 false bscan }{ pop } ifelse
} if
nunbound 0 eq (no nested dispatch table carries an unbound operator reference) assert

% =============================== the C side holds values too ===============
% Everything above walks dictionaries, so it sees only what PostScript
% stores. The interpreter's own C code also pushes objects for the
% interpreter to run, and a standard operator's NAME pushed there is
% resolved against the dictionary stack at the moment it runs -- the same
% defect as an executable name in a dispatch table, and out of reach of
% any dictionary walk.
%
% The show operators are where the C side does most of this. They paint
% each glyph through the device's pixel or rectangle method, and they
% leave a procedure behind to restore the current point in user space and
% flush the page -- a procedure that runs after the operator has returned,
% with the program's own dictionaries in force.
%
% So this half is behavioural: take a standard operator away, paint a
% glyph, and require the show both to succeed and to leave the operand
% stack as it found it. Succeeding on its own proves little. A name
% pushed once per set pixel leaves the glyph on the page and a hundred-odd
% strings behind it, which is a corrupted stack for the program that comes
% next rather than a fault it can catch.
%
% The font and the current point are set before the theft, so the probe
% names nothing that is being taken, and the tally is anchored to a mark
% rather than to a stack depth, so that debris of any size is still
% counted rather than swallowing the bookkeeping.

/TAKEN [ /exec /moveto /lineto /itransform /transform /flushpage /currentpoint
         /setmatrix /defaultmatrix /matrix /concatmatrix /rotate /translate /scale
         /get /put /exch /dup /known /length /forall /type /index /copy /eq
         /if /ifelse /roll /pop /add /sub /mul /div /repeat /for /loop /exit
         /gsave /grestore /setgray /setrgbcolor /currentfont /cvx /load /def
         /token /maxlength /getinterval /stop /newpath /closepath /fill /stroke ] def

% The probe is handed its procedure on the operand stack, under a mark the
% caller pushes, and never through a name: a name holding a procedure runs
% it on lookup rather than pushing it, and recovering it instead with
% `load` would put one of the operators being taken inside the probe.
/nsens 0 def
/probeunder { % mark {proc}  .  -   (p.lbl, p.nm set by the caller)
    gsave /Times-Roman findfont 12 scalefont setfont 5 5 moveto
    /p.sv save def
    userdict p.nm { (stolen) } put
    stopped
    p.sv restore
    grestore
    % judged out here: the operators answer for themselves again, and the
    % flag and the mark are simple objects the restore left alone
    /p.failed exch def
    counttomark /p.debris exch def
    cleartomark
    p.failed
      { (  FAILED: ) print p.lbl print ( under ) print
        p.nm 30 string cvs print (\n) print /nsens nsens 1 add store }
      { p.debris p.expect ne
          { (  DEBRIS ) print p.debris 6 string cvs print ( want ) print
            p.expect 6 string cvs print ( from ) print p.lbl print
            ( under ) print p.nm 30 string cvs print (\n) print
            /nsens nsens 1 add store } if } ifelse
} def

% the probe must catch a show that disturbs the stack before its zero means
% anything: this one paints correctly and leaves one object behind
/nsens 0 def
/p.lbl (selftest) def /p.nm /exec def /p.expect 0 def
mark { (X) show 42 } probeunder
nsens 1 eq (the probe flags a show that leaves the stack disturbed) assert

% --- every standard operator, against show ---
/nsens 0 def
TAKEN {
    /p.nm exch def /p.lbl (show) def /p.expect 0 def
    mark { (X) show } probeunder
} forall
nsens 0 eq (no standard operator taken from a program reaches show) assert

% --- the rest of the family, against the operators reached from C ---
% kshow and cshow are left out: they run a procedure the program supplies,
% so a redefinition reaching them is the operator working as specified.
%
% The third element is what the probe leaves on the stack when nothing has
% gone wrong. stringwidth returns a width, and the probe cannot discard it,
% because every operator that would discard it is on the list being taken.
/FAMILY [ [ (ashow)       { 1 0 (X) ashow }        0 ]
          [ (widthshow)   { 1 0 88 (X) widthshow } 0 ]
          [ (awidthshow)  { 1 0 88 1 0 (X) awidthshow } 0 ]
          [ (stringwidth) { (X) stringwidth }      2 ] ] def
/nsens 0 def
FAMILY {
    dup 0 get /p.lbl exch def
    dup 2 get /p.expect exch def
    1 get                          % the procedure stays here on the stack
    TAKEN { /p.nm exch def mark 1 index probeunder } forall
    pop
} forall
nsens 0 eq (nor any of the rest of the show family) assert

% =========================== a helper reached from a body ==================
% The sweeps above walk what a dictionary holds and what a promoted body
% calls directly. Between the two sits a machinery helper: a procedure kept
% in .xpostsys and baked into a body by an immediate reference, whose own
% calls are frozen only if it was still unbound when the promotion's bind
% swept through -- bind makes what it binds read-only and then ignores a
% read-only array, so a helper bound at its definition keeps whichever
% names were not yet operators there, and every operator reaching it
% inherits them.
%
% shfill is where the last of those showed. A shading carrying no Function
% takes one value per colour component out of its data stream, and the
% component count is asked for with currentcolorspace -- so a program that
% has defined that name changes how the vertices of somebody else's
% shading are read, from inside shfill, with no shading of its own in
% sight.
%
% Asked as a render, since a redefinition that answers plausibly changes
% the picture without raising anything: paint a mesh shading, define the
% name, paint it again, and require the same page and no fault. The device
% is installed last, after the show probes above have had theirs.

/.fillpoly     1183615869 internaldict /.fillpoly get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def
/SDEV 64 64 .privatedict /newPGMIMAGEdevice get exec def
SDEV begin
    /defaultmatrix [ 1 0 0 -1 0 64 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device SDEV put
graphicsdict /currgstate get /device SDEV put

/shsnap { % -  .  string   (the page, one byte per pixel)
    initgraphics erasepage
    << /ShadingType 4 /ColorSpace /DeviceGray
       /DataSource [ 0 6 6 0.0  0 56 10 0.5  0 30 56 1.0 ] >> shfill
    4096 string
    0 1 63 { /sh.y exch def
        0 1 63 { /sh.x exch def
            dup sh.y 64 mul sh.x add
            sh.x sh.y SDEV dup /GetPix get exec
            put
        } for
    } for
} bind def

/shwant shsnap def
/shgot null def
% the probe must have something to see: a page of one flat colour would
% match whatever the redefinition did to it
/shflat true def
0 1 4095 { shwant exch get shwant 0 get ne { /shflat false def } if } for
shflat not (the mesh shading paints a page with more than one level in it) assert

userdict /currentcolorspace { /DeviceCMYK } put
{ /shgot shsnap store } stopped /shfailed exch def
userdict /currentcolorspace undef

shfailed not (shfill runs with a program's currentcolorspace defined) assert
shfailed not { shgot shwant eq }{ false } ifelse
    (shfill paints the same page with currentcolorspace defined) assert

% The == / pstack / error-report machinery is the interpreter's own and is
% bound (init.ps .bindscope over ==dict), so a program redefining an
% operator it uses is not honoured when it runs. Flag a redefinition of
% type -- which == dispatches an array's printing through -- and confirm
% == does not reach it.
userdict /tamper.seen false put
userdict /type { userdict /tamper.seen true put //type exec } put
[1] ==
userdict /type undef
userdict /tamper.seen get not (== does not honour a program's redefined type) assert

verdict
