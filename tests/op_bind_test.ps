%!testlib
% Standard operators reached by bind, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% bind replaces an executable name with an operator only when the name's
% value is an operator (PLRM 3.12.1). A standard operator implemented as
% a plain procedure is therefore invisible to bind, and the name in a
% bound procedure stays a name, looked up afresh on every execution.
%
% That breaks the idiom a prolog is written with:
%
%     /setlinewidth { 2 mul setlinewidth } bind def
%
% The intent is that the inner name is the standard operator, frozen by
% bind at definition. If bind could not see it, the inner name resolves
% at run time to the definition just made, and the procedure calls
% itself for ever. The failure is a hang, not an error, so nothing is
% reported and nothing recovers.
%
% PLRM permits a standard feature to be a built-in procedure -- it names
% findfont as one -- so this is not a conformance requirement. It is
% what a program written against the idiom needs in order to run.
%
% The operators below are implemented in PostScript and wrapped so that
% they are operator objects. What is checked is that bind reaches them
% and that the idiom terminates.


/OPS [ /setlinewidth /currentlinewidth /setlinecap /currentlinecap
       /setlinejoin /currentlinejoin /setmiterlimit /currentmiterlimit
       /setdash /currentdash /setflat /currentflat ] def

% ------------------------------------ where a wrapped procedure has to live
% The operator table is outside the collector's view, so the procedure a
% wrapped operator runs is kept reachable by .wrappedprocs alone. That
% procedure must be in global VM: a local one would be invalidated by a
% restore past its creation while the operator table still pointed at it,
% and load and exec would follow the dangling reference.
%
% Which VM a definition lands in is decided by the setglobal in force
% when its file is read, so it is settled a long way from the definition
% and nothing else checks the result.

.privatedict /.wrappedprocs known {
    /wp .privatedict /.wrappedprocs get def
    /local 0 def
    wp { pop gcheck not { /local local 1 add store } if } forall
    local 0 eq (every wrapped procedure is in global VM) assert
    wp length 0 gt (there are wrapped procedures to check) assert
}{ (FAIL: the wrapped-procedure register is not reachable\n) print
   /failcount failcount 1 add store } ifelse

% ------------------------------- every wrapped operator reaches systemdict
% The registers above name exactly the operators that were wrapped, so
% they say what the finished interpreter must look like: each of those
% names is an operator, and it is in systemdict, where a standard
% operator lives. A name that failed to reach systemdict, or that
% arrived still holding its procedure, shows up here.
%
% This is the check that the definitions' homes are not left to whatever
% dictionary happened to be current when a file was read.

/checkreg { % dict (what)  -
    /k.w exch def /k.d exch def
    /k.notop 0 def /k.nothome 0 def
    k.d {
        pop
        systemdict 1 index known
            { dup systemdict exch get type /operatortype ne
                { /k.notop k.notop 1 add store } if }
            { /k.nothome k.nothome 1 add store } ifelse
        pop
    } forall
    k.notop 0 eq k.w assert
    k.nothome 0 eq k.w assert
} def

.privatedict /.wrappedprocs known {
    .privatedict /.wrappedprocs get
    (every wrapped operator is an operator in systemdict) checkreg
} if
% --------------------- a PostScript operator is not shadowed by a C one
% Some standard operators are written in PostScript over a C operator of
% the same name: findfont keeps the resource table the C operator knows
% nothing about, and reaches the C one through a frozen reference. Which
% of the two a name resolves to depends on the order the dictionaries
% were filled and searched while the language was read, so it is settled
% a long way from here and by nothing that announces itself.
%
% Getting it wrong is silent. definefont registers the font and then
% returns findfont's answer; bound against the C operator it answers
% with a substitute face instead, and a program's own font is quietly
% replaced by another that has all the same operators and different
% glyphs. The round trip below is what says which one is in force.

/tf.dict 10 dict def
tf.dict begin
  /FontType 3 def /FontMatrix [0.001 0 0 0.001 0 0] def
  /FontBBox [0 0 1000 1000] def
  /Encoding 256 array def 0 1 255 { Encoding exch /.notdef put } for
  /CharProcs 1 dict def CharProcs /.notdef {} put
  /BuildChar { exch begin Encoding exch get CharProcs exch get exec end } def
end
/tf.made /tf.testfont tf.dict definefont def
tf.made /FontType get 3 eq
    (definefont answers with the font it was given) assert
/tf.testfont findfont /FontType get 3 eq
    (findfont answers with the font definefont registered) assert
FontDirectory /tf.testfont known
    (definefont registered the font in FontDirectory) assert
/tf.testfont undefinefont

% {test} (what)  -  run the test on every name, naming any that fail
/eachop {
    /e.w exch def /e.t exch def /e.bad 0 def
    OPS { dup e.t exec { pop }{ (FAIL: ) print 40 string cvs print ( ) print
          e.w print (\n) print /e.bad e.bad 1 add store } ifelse } forall
    e.bad 0 eq e.w assert
} def

% ------------------------------------------------- they are operators
% load answers operatortype, which is what makes bind substitute them
% and what the type operator reports for a standard operator.

{ load type /operatortype eq } (is an operator) eachop

% ------------------------------------------------------- bind sees them
% A procedure holding just the name, bound: the element left behind must
% be the operator, not the name. This is the property the idiom rests
% on, checked without running anything that could fail to terminate.

{ [ exch cvx ] cvx bind 0 get type /operatortype eq } (is reached by bind) eachop

% --------------------------------------------------------- the idiom runs
% Each redefinition calls the operator it replaces. Bound, the inner name
% is the standard operator and the procedure terminates; unbound, it
% would call itself until the interpreter stopped, so reaching the
% assertion at all is half of what is being checked.
%
% That is also why this part runs only when the checks above have
% passed. Were bind unable to reach these operators, the redefinitions
% would not return, and a run that hangs reports nothing at all; the
% guard turns that into the failures already counted.

failcount 0 eq {

save
/setlinewidth { 2 mul setlinewidth } bind def
3 setlinewidth
currentlinewidth 6 eq (a scaling setlinewidth reaches the standard one) assert
restore

save
/setlinecap { pop 2 setlinecap } bind def
0 setlinecap
currentlinecap 2 eq (a forcing setlinecap reaches the standard one) assert
restore

save
/setflat { 3 div setflat } bind def
3 setflat
currentflat 1 eq (a dividing setflat reaches the standard one) assert
restore

save
/setdash { pop pop [ 1 1 ] 0 setdash } bind def
[ 9 9 ] 4 setdash
currentdash exch length 2 eq exch 0 eq and
    (a replacing setdash reaches the standard one) assert
restore

% the redefinitions are gone with the save levels that held them
3 setlinewidth currentlinewidth 3 eq (the standard operator is back) assert

} { (SKIPPED: the idiom is not run, bind does not reach these\n) print } ifelse

% ------------------------------------------- and they still check operands
% Wrapping moved each statement of operands to the definition, where the
% dispatcher enforces it before the body runs. PLRM gives setlinewidth a
% number, and a string is not one, whatever cvr would have made of it.


{ (3) setlinewidth } /typecheck (setlinewidth refuses a string) raises
{ (3) setflat } /typecheck (setflat refuses a string) raises
{ (3) setmiterlimit } /typecheck (setmiterlimit refuses a string) raises
{ (0) setlinecap } /typecheck (setlinecap refuses a string) raises
{ 1.5 setlinecap } /typecheck (setlinecap refuses a real) raises
{ [ 3 3 ] (0) setdash } /typecheck (setdash refuses a string offset) raises
{ 3 0 setdash } /typecheck (setdash refuses a number for the array) raises
{ setlinewidth } /stackunderflow (setlinewidth reports a shortage) raises
{ setdash } /stackunderflow (setdash reports a shortage) raises

% and the values they do take still arrive
clear
2 setlinewidth currentlinewidth 2 eq (setlinewidth takes an integer) assert
2.5 setlinewidth currentlinewidth 2.5 eq (setlinewidth takes a real) assert
1 setlinecap currentlinecap 1 eq (setlinecap takes an integer) assert
[ 2 2 ] 1 setdash currentdash 1 eq exch length 2 eq and
    (setdash takes an array and an offset) assert

verdict
