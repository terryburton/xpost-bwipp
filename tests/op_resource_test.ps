%!testlib
% Resource and user-object operator compliance (PLRM 8.2), run through
% `xpost -d null` by run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% resourcestatus raises undefined for a category that does not exist (PLRM: "If
% the specified resource category does not exist, an undefined error occurs") and
% returns false for a present category whose instance is absent. execuserobject
% and undefineuserobject follow the UserObjects rules for a missing array, a
% cleared slot, and an out-of-range index.


% --- UserObjects: exercise the PLRM rules BEFORE any defineuserobject runs ---
% execuserobject / undefineuserobject with UserObjects never defined -> undefined
{ 1 execuserobject }      /undefined (execuserobject with no UserObjects) raises
{ 1 undefineuserobject }  /undefined (undefineuserobject with no UserObjects) raises

% index anyobject defineuserobject; a defined slot executes its object (a dict
% is pushed literally), so its type is dicttype
5 3 dict defineuserobject
5 execuserobject type /dicttype eq (execuserobject returns the defined object) assert
% a valid index whose slot was cleared returns null
5 undefineuserobject
5 execuserobject type /nulltype eq (execuserobject of a cleared slot is null) assert
% an out-of-range or negative index is rangecheck
{ 999999 execuserobject }     /rangecheck (execuserobject out-of-range index) raises
{ -1 execuserobject }         /rangecheck (execuserobject negative index) raises
{ 999999 undefineuserobject } /rangecheck (undefineuserobject out-of-range index) raises

% --- resourcestatus: nonexistent category is undefined, not false ---
{ /AnyKey /NoSuchCategory resourcestatus } /undefined (resourcestatus unknown category) raises
% a real category with an absent instance returns false
/DefinitelyNotAFont /Font resourcestatus not (resourcestatus absent instance is false) assert
% a defined resource category is itself reachable through the Category category
/Font /Category resourcestatus { pop pop true }{ false } ifelse (Font is a known category) assert

% --- a category is two entries made together, and they agree ---
% A category exists as an implementation dictionary, an instance of
% /Category, and as a table of its own instances. Nothing a program can
% see distinguishes the two, so a category made with only one of them
% answers /Category resourcestatus and then raises undefinedresource the
% moment anything asks it for an instance. Every category is checked, not
% a chosen one, so a second way of registering them cannot make a
% half-formed category somewhere off to the side.
/badcat 0 def
/ncat 0 def
% resourceforall hands the key back in the scratch string, so each name is
% made from it before use and the buffer is not held past the iteration
/hasinstancetable { % name  .  bool
    /h.n exch def
    count /h.c exch def
    { /NoSuchInstanceAnywhere h.n resourcestatus { pop pop } if } stopped
    /h.r exch def
    count h.c gt { count h.c sub { pop } repeat } if
    h.r not
} def
% Generic is held to the same rule as the rest. PLRM 3.9.2 says "The
% Category category contains an instance named Generic, whose value is a
% dictionary containing a generic resource implementation", which is the
% prototype a program copies to define a category of its own; the table of
% standard categories separately lists Generic as a category taking
% instances of any type. It is both, so it needs both halves.
(*)
{
    cvn
    {
    /ncat ncat 1 add store
    % the implementation dictionary names the category it implements
    dup dup /Category findresource /Category get ne
        { (FAIL: category does not name itself: ) print dup ==
          /badcat badcat 1 add store } if
    % and the category answers about its own instances rather than raising
    % undefinedresource for want of a table to look in
    dup hasinstancetable not
        { (FAIL: category has no instance table: ) print dup ==
          /badcat badcat 1 add store } if
    pop
    } exec
} 60 string /Category resourceforall
ncat 10 gt (the categories are enumerable) assert
badcat 0 eq (every category has both halves) assert

% /Category lists itself among the categories: PLRM Table 3.9 calls the
% Category resource recursive
/okcat false def
mark { /Category /Category findresource /Category get /Category eq /okcat exch store }
stopped { } if cleartomark
okcat (Category is a category in its own right) assert

% PLRM Table 3.8 lists IODevice among the standard categories, and PLRM 3.8.5
% has resourceforall over it enumerate the device parameter sets. There are
% none here, so asking after one reports an absent instance rather than an
% absent category.
/okiod false def
mark { (%os%) /IODevice resourcestatus { pop pop false }{ true } ifelse /okiod exch store }
stopped { } if cleartomark
okiod (IODevice is a category, empty of instances) assert

% PLRM 8.2: "Before defining the resource instance, defineresource verifies
% that the instance object is the correct type." The type each category holds
% its instances to is PLRM Table 3.7's: Encoding and ColorSpace take arrays,
% Font takes a dictionary.
{ /Xp.E1 3 dict /Encoding defineresource }   /typecheck (a dict is not an Encoding) raises
{ /Xp.C1 3 dict /ColorSpace defineresource } /typecheck (a dict is not a ColorSpace) raises
{ /Xp.F1 [1 2 3] /Font defineresource }      /typecheck (an array is not a Font) raises
/oktyped false def
mark { /Xp.E2 [1 2 3] /Encoding defineresource pop
       /Xp.E2 /Encoding findresource type /arraytype eq /oktyped exch store }
stopped { } if cleartomark
oktyped (an Encoding of the right type is accepted) assert

% PLRM 8.2: defineresource "makes the object read-only if its access is not
% already restricted", so neither the object handed to it nor the one
% findresource gives back can be written through afterwards.
/dro 3 dict def
/Xp.RO dro /ProcSet defineresource pop
/okdefro false def
mark { dro /k 1 put } stopped { /okdefro true store } if cleartomark
okdefro (the object defineresource took is read-only) assert
/okfindro false def
mark { /Xp.RO /ProcSet findresource /k 2 put } stopped { /okfindro true store } if cleartomark
okfindro (the instance findresource returns is read-only) assert

% Generic is a category in its own right, and its instances are of no
% particular type: PLRM 3.9.3 notes its implementation dictionary has no
% InstanceType entry, so "instances need not be of any particular type"
/badgeneric 0 def
[ 3 dict (a string) [1 2 3] 42 /aname ] {
    mark exch { /Xp.Any exch /Generic defineresource pop
                /Xp.Any /Generic findresource pop
                /Xp.Any /Generic undefineresource }
    stopped { /badgeneric badgeneric 1 add store } if cleartomark
} forall
badgeneric 0 eq (Generic takes an instance of any type) assert

% and it is the prototype a program copies to make a category of its own,
% the way PLRM 3.9.3 Example 3.7 does it
/okwidget false def
mark {
    currentglobal true setglobal
    /Generic /Category findresource
    dup length 1 add dict copy
    dup /InstanceType /dicttype put
    /Xp.Widget exch /Category defineresource pop
    setglobal
    /Xp.W1 3 dict /Xp.Widget defineresource pop
    /Xp.W1 /Xp.Widget findresource type /dicttype eq /okwidget exch store
} stopped { } if
cleartomark
okwidget (a category copied from Generic holds instances) assert

% the composite font machinery states the categories it keeps instances in
/missingcidcat 0 def
[ /CIDFont /CMap /ProcSet ] {
    /Category resourcestatus { pop pop }{ /missingcidcat missingcidcat 1 add store } ifelse
} forall
missingcidcat 0 eq (the CID machinery's categories are all there) assert

% --- implicit resources say what this build can actually do -------------
%
% PLRM Table 3.8: an implicit resource's instance is a capability rather
% than an object a program defined, and `7 /ShadingType resourcestatus` is
% how a program asks whether type 7 shadings are painted before it sends
% one. A declaration that does not match the code is worse than none: it
% answers the question wrongly, and the program acts on the answer.
%
% So this is held in BOTH directions, per capability. Each row carries a
% probe that exercises the thing itself. Where the probe succeeds the
% resource must be declared; where it fails the resource must be absent.
% Neither a capability that was added and not declared, nor a declaration
% for something that has stopped working, can pass.
%
% The probes are shaped per type on purpose. A halftone dictionary of the
% wrong shape is refused exactly as an unsupported type is, so a careless
% probe reports a working type as missing -- which is how types 2, 3, 4
% and 5 came to be thought absent while all four work.
/rgbdata <000000> def
/capabilities [
  % A function-based shading is fed by a function of TWO inputs; given the
  % one-input form its siblings use it is refused, which looks exactly like
  % the type being unsupported. It is not.
  [ /ShadingType 1 { << /ShadingType 1 /ColorSpace /DeviceGray /Domain [0 1 0 1]
        /Matrix [1 0 0 1 0 0]
        /Function << /FunctionType 0 /Domain [0 1 0 1] /Range [0 1]
                     /Size [2 2] /BitsPerSample 8 /DataSource <00FF00FF> >>
        >> shfill } ]
  [ /FunctionType 0 { << /ShadingType 1 /ColorSpace /DeviceGray /Domain [0 1 0 1]
        /Matrix [1 0 0 1 0 0]
        /Function << /FunctionType 0 /Domain [0 1 0 1] /Range [0 1]
                     /Size [2 2] /BitsPerSample 8 /DataSource <00FF00FF> >>
        >> shfill } ]
  [ /ShadingType 2 { << /ShadingType 2 /ColorSpace /DeviceGray /Coords [0 0 1 0]
        /Function << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [1] /N 1 >> >> shfill } ]
  [ /ShadingType 3 { << /ShadingType 3 /ColorSpace /DeviceGray /Coords [0 0 0 0 0 1]
        /Function << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [1] /N 1 >> >> shfill } ]
  [ /FunctionType 2 { << /ShadingType 2 /ColorSpace /DeviceGray /Coords [0 0 1 0]
        /Function << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [1] /N 1 >> >> shfill } ]
  [ /FunctionType 3 { << /ShadingType 2 /ColorSpace /DeviceGray /Coords [0 0 1 0]
        /Function << /FunctionType 3 /Domain [0 1]
          /Functions [ << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [1] /N 1 >>
                       << /FunctionType 2 /Domain [0 1] /C0 [1] /C1 [0] /N 1 >> ]
          /Bounds [0.5] /Encode [0 1 0 1] >> >> shfill } ]
  [ /HalftoneType 1 { << /HalftoneType 1 /Frequency 60 /Angle 0
        /SpotFunction { pop } >> sethalftone } ]
  [ /HalftoneType 3 { << /HalftoneType 3 /Width 2 /Height 2
        /Thresholds <00408000> >> sethalftone } ]
  [ /HalftoneType 5 { << /HalftoneType 5
        /Gray << /HalftoneType 1 /Frequency 60 /Angle 0 /SpotFunction { pop } >>
        /Default << /HalftoneType 1 /Frequency 60 /Angle 45 /SpotFunction { pop } >>
        >> sethalftone } ]
  % 6 and 16 take their thresholds through a file where 3 takes a string,
  % and 10 describes its screen with Xsquare and Ysquare. Given the wrong
  % shape each is refused exactly as an unimplemented type would be, which
  % is how all three came to be thought missing when all three work.
  [ /HalftoneType 6 { << /HalftoneType 6 /Width 2 /Height 2
        /Thresholds (00408000>) /ASCIIHexDecode filter >> sethalftone } ]
  [ /HalftoneType 10 { << /HalftoneType 10 /Xsquare 2 /Ysquare 2
        /Thresholds <0040800000408000> >> sethalftone } ]
  [ /HalftoneType 16 { << /HalftoneType 16 /Width 2 /Height 2
        /Thresholds (0040800000408000>) /ASCIIHexDecode filter >> sethalftone } ]
  [ /ImageType 1 { << /ImageType 1 /Width 1 /Height 1 /BitsPerComponent 8
        /Decode [0 1] /ImageMatrix [1 0 0 -1 0 1] /DataSource <80> >> image } ]
  [ /ImageType 4 { << /ImageType 4 /MaskColor [0] /Width 1 /Height 1
        /BitsPerComponent 8 /Decode [0 1] /ImageMatrix [1 0 0 -1 0 1]
        /DataSource <80> >> image } ]
  [ /PatternType 1 { << /PatternType 1 /PaintType 1 /TilingType 1
        /BBox [0 0 1 1] /XStep 1 /YStep 1 /PaintProc { pop } >> matrix makepattern } ]
  [ /PatternType 2 { << /PatternType 2 /Shading << /ShadingType 2
        /ColorSpace /DeviceGray /Coords [0 0 1 0] /Function << /FunctionType 2
        /Domain [0 1] /C0 [0] /C1 [1] /N 1 >> >> >> matrix makepattern } ]
  [ /FormType 1 { << /FormType 1 /BBox [0 0 1 1] /Matrix [1 0 0 1 0 0]
        /PaintProc { pop } >> execform } ]
  [ /ColorRenderingType 1 { << /ColorRenderingType 1
        /WhitePoint [0.9505 1 1.089] /TransformPQR [{} {} {}] >>
        setcolorrendering } ]
  [ /Filter /FlateDecode { (abc) /FlateDecode filter closefile } ]
  [ /Filter /ASCIIHexDecode { (616263>) /ASCIIHexDecode filter closefile } ]
  [ /ColorSpaceFamily /DeviceCMYK { /DeviceCMYK setcolorspace } ]
  [ /ColorSpaceFamily /Separation { [ /Separation (S) /DeviceGray { } ]
        setcolorspace } ]
] def

/capmismatch 0 def
capabilities {
    aload pop /body exch def /key exch def /cat exch def
    gsave
    % /body load, not body: a name that answers with a procedure runs it,
    % and stopped wants the procedure itself.
    /body load stopped /worked exch not def
    grestore
    clear
    key cat resourcestatus { pop pop true }{ false } ifelse /declared exch def
    declared worked ne {
        /capmismatch capmismatch 1 add store
        (MISMATCH: ) print cat 20 string cvs print ( ) print
        key 20 string cvs print
        worked { ( works but is not declared) }{ ( is declared but does not work) }
        ifelse print (\n) print
    } if
} forall
capmismatch 0 eq
    (every implicit resource declared is one this build can do, and every one
     it can do is declared) assert

% --- the device parameter sets ------------------------------------------
%
% PLRM 3.8.5 has IODevice enumerate the parameter sets setdevparams and
% currentdevparams reach, and PLRM 8.2 gives both operators the undefined
% error. So the category and the operators have to agree: a device a
% program can enumerate must be one the operators answer for, and one they
% refuse must not be enumerable. Answering an empty dictionary for every
% string handed in -- which is what this did -- tells a program that every
% device exists.
/iodmismatch 0 def
[ (%stdin) (%stdout) (%stderr) (%lineedit) (%statementedit) ]
{ /d exch def
    d /IODevice resourcestatus { pop pop }{ 
        /iodmismatch iodmismatch 1 add store
        (MISSING from IODevice: ) print d print (\n) print } ifelse
    { d currentdevparams pop } stopped {
        /iodmismatch iodmismatch 1 add store
        (currentdevparams refuses an enumerated device: ) print d print (\n) print
    } if
    clear
} forall
iodmismatch 0 eq
    (every device the category holds is one the operators answer for) assert

{ (%nosuchdevice) currentdevparams pop } stopped
    (currentdevparams refuses a parameter set that is not there) assert
$error /errorname get /undefined eq
    (and refuses it as undefined) assert
clear
{ (%nosuchdevice) 1 dict setdevparams } stopped
    (setdevparams refuses a parameter set that is not there) assert
$error /errorname get /undefined eq
    (and refuses it as undefined) assert
clear
(%nosuchdevice) /IODevice resourcestatus not
    (and it is not enumerable either) assert

% The categories themselves exist, so a program asking is answered rather
% than stopped (PLRM: an absent category raises undefined). The names are
% PLRM Table 3.8's own -- every implicit category the specification
% defines -- and not the set this interpreter happens to hold, because a
% list taken from the implementation cannot report what is missing from
% both.
/missingimplicit 0 def
[ /Filter /ColorSpaceFamily /Emulator /IODevice /ColorRenderingType
  /FMapType /FontType /FormType /HalftoneType /ImageType /PatternType
  /FunctionType /ShadingType /TrappingType ]
{ /Category resourcestatus { pop pop }{ /missingimplicit missingimplicit 1 add store } ifelse
} forall
missingimplicit 0 eq
    (every implicit category the specification defines is there) assert

% A declaration answers for what is implemented AND declines what is
% not. Both halves are asserted of each category below: one answering
% yes to every key would be a category rather than a declaration, and
% one answering no to every key reads exactly like an empty one.

% FontType. PLRM Table 5.1 names the font types; type 1 is painted here,
% type 14 is named by the same table and nothing here implements it, and
% 99 was never given a meaning at all.
1 /FontType resourcestatus { pop pop true }{ false } ifelse
    (a font type this interpreter paints with is declared) assert
1 /FontType findresource 1 eq
    (and findresource answers with the key, as PLRM 3.9.1 has it do) assert
14 /FontType resourcestatus not
    (a font type the specification names and nothing here implements is not) assert
99 /FontType resourcestatus not
    (nor is a code that is no font type at all) assert
{ 14 /FontType findresource } /undefinedresource
    (and findresource refuses the one that is not implemented) raises

% FMapType. PLRM Table 5.9 gives the mapping algorithms an FMapType
% value may select, from 2 up. The 8/8 mapping is walked here; 1 names
% no algorithm in that table and neither does 10.
2 /FMapType resourcestatus { pop pop true }{ false } ifelse
    (a composite font mapping this interpreter walks is declared) assert
1 /FMapType resourcestatus not
    (a mapping code the table does not define is not) assert
10 /FMapType resourcestatus not
    (nor is one past the end of it) assert

% TrappingType. The category is declared and holds nothing, which is the
% answer an interpreter that performs no trapping has to give. PLRM
% 6.3.1 defines one trapping type, 1001, and this answers false for it:
% an answer, where an undeclared category would raise an error instead
% and say something else -- that the interpreter does not know what a
% trapping type is.
1001 /TrappingType resourcestatus not
    (the trapping type the specification defines is not performed here) assert
/trapinstances 0 def
(*) { pop /trapinstances trapinstances 1 add store } 40 string
    /TrappingType resourceforall
trapinstances 0 eq
    (and the category holds no trapping type at all) assert
% the control for that count: the same enumeration, over a category that
% does hold instances. Without it an empty answer cannot be told from a
% probe that sees nothing whatever it is pointed at.
/shadeinstances 0 def
(*) { pop /shadeinstances shadeinstances 1 add store } 40 string
    /ShadingType resourceforall
shadeinstances 0 gt
    (while the same enumeration finds the shading types) assert


% --- the procedure runs in the program's own context ------------------
%
% resourceforall is implemented in PostScript and needs a dictionary of its
% own to enumerate out of. That dictionary is the interpreter's, and the
% program's procedure must not be standing in it: a name the procedure
% defines belongs to the program and has to land where the program will
% look for it, and the machinery's own members must not be in reach of a
% name the procedure resolves. Both are invisible unless asked -- a
% definition that lands in a dictionary about to be discarded raises
% nothing, it just is not there afterwards.
/dsdepth countdictstack def
/rfdepth -1 def
/rfcurrent false def
/rfprivate true def
/rfdefined false def
(*) { pop
    /rfdepth countdictstack store
    /rfcurrent currentdict userdict eq store
    /rfprivate /.rfbuf where { pop true }{ false } ifelse store
    /rfdefined true store
} 60 string /Filter resourceforall
rfdefined (the procedure ran at all) assert
rfdepth dsdepth eq (it ran at the dictionary depth its caller had) assert
rfcurrent (its current dictionary is the caller's, not the machinery's) assert
rfprivate not (the machinery's own members are out of its reach) assert

% and what it defines is still there once the enumeration is over, which is
% the same fact from the program's side
/rfstore 0 def
(*) { pop /rfstore rfstore 1 add def } 60 string /Filter resourceforall
rfstore 0 gt (what the procedure defined outlived the enumeration) assert

% --- a category the interpreter made is not the program's to replace ---
% The resource operators dispatch through the procedures a category
% carries (PLRM 3.9.2), so replacing or removing one of the categories
% this interpreter defines would hand a program the inside of every
% operation on it, or leave those operations undefined for the rest of
% the job. Defining categories of one's own (PLRM 3.9.3) is untouched,
% which is what the last four rows hold.
{ /Font 5 dict /Category defineresource }
    /invalidaccess (replacing a standard category) raises
{ /Category 5 dict /Category defineresource }
    /invalidaccess (replacing the category of categories) raises
{ /Font /Category undefineresource }
    /invalidaccess (removing a standard category) raises
{ /Category /Category undefineresource }
    /invalidaccess (removing the category of categories) raises

% The refusals left the category working, which is asked of the category
% itself and of a font this suite defines. Naming a standard face here
% asks a different question: /Font resourcestatus consults the host's
% font configuration, so the row reports whether the machine carries that
% face and fails wherever it does not.
/Font /Category resourcestatus { pop pop true }{ false } ifelse
    (the refused category is still there) assert
% The font is compared with the one definefont returned rather than asked
% for its type, because findresource answers a name it does not hold with
% a substitute face: a row that checks the type is answered by the
% substitute and holds whether or not the definition arrived. Identity is
% what distinguishes them, and a substitute is a different object.
/XpostProbeFont 10 dict dup begin
    /FontType 3 def /FontMatrix [0.001 0 0 0.001 0 0] def
    /FontBBox [0 0 1000 1000] def /Encoding 256 array def
    /BuildGlyph { pop pop 0 0 setcharwidth } def
end definefont
/XpostProbeFont /Font findresource eq
    (and still answers findresource with the font defined here) assert

% and a program's own category is still its own: defined, found,
% enumerated and removed without complaint
currentglobal true setglobal
/XpostOwnCat /Generic /Category findresource dup length 2 add dict copy
    dup /Category /XpostOwnCat put /Category defineresource pop
setglobal
/XpostOwnCat /Category findresource type /dicttype eq
    (a program's own category is defined) assert
/oc1 1 def
/k 42 /XpostOwnCat defineresource pop
/k /XpostOwnCat findresource 42 eq (its instances are found) assert
/occount 0 def
(*) { pop /occount occount 1 add def } 60 string /XpostOwnCat resourceforall
occount 1 eq (its instances enumerate) assert
/XpostOwnCat /Category undefineresource
{ /XpostOwnCat /Category findresource } /undefinedresource
    (a program's own category is removed) raises

% --- an implicit category's instances are not a program's to change ---
% PLRM 3.9.1: the instances of an implicit category ARE the capabilities
% the interpreter has, so defineresource and undefineresource are not
% allowed on them. A program that could add one would have every program
% that asked told the interpreter can do something it cannot; one that
% could remove one would have the interpreter deny what it still does.
{ /XpostNoSuchType 99 /ShadingType defineresource pop }
    /invalidaccess (adding a shading type) raises
{ 4 /ShadingType undefineresource }
    /invalidaccess (removing a shading type) raises
{ /XpostNoSuchFilter /XpostNoSuchFilter /Filter defineresource pop }
    /invalidaccess (adding a filter) raises
{ /ASCII85Decode /Filter undefineresource }
    /invalidaccess (removing a filter) raises
{ 14 14 /FontType defineresource pop }
    /invalidaccess (adding a font type) raises
{ 1 /FontType undefineresource }
    /invalidaccess (removing a font type) raises
{ 1 1 /FMapType defineresource pop }
    /invalidaccess (adding a composite font mapping) raises
{ 2 /FMapType undefineresource }
    /invalidaccess (removing a composite font mapping) raises
% the empty category refuses just as the full ones do: a program that
% could add an instance would have this interpreter claim trapping it
% does not perform, which is the whole reason the category is empty
{ 1001 1001 /TrappingType defineresource pop }
    /invalidaccess (adding a trapping type) raises

% and the capability the refusals guard is still declared and still there
/ASCII85Decode /Filter resourcestatus { pop pop true }{ false } ifelse
    (the filter the refusal guarded is still declared) assert
(87cURD]~>) /ASCII85Decode filter 32 string readstring pop (Hello) eq
    (and still builds) assert
4 /ShadingType resourcestatus { pop pop true }{ false } ifelse
    (the shading type is still declared) assert
1 /FontType resourcestatus { pop pop true }{ false } ifelse
    (the font type the refusal guarded is still declared) assert
2 /FMapType resourcestatus { pop pop true }{ false } ifelse
    (and so is the composite font mapping) assert
1001 /TrappingType resourcestatus not
    (and the trapping type the refusal guarded is still absent) assert

% The refusal is the implicit categories' and not every category's: an
% explicit one takes an instance and gives it back, which is what says
% the rows above are about being implicit rather than about the operators.
/XpostProbeSet 5 dict /ProcSet defineresource type /dicttype eq
    (an explicit category still takes an instance) assert
/XpostProbeSet /ProcSet undefineresource
{ /XpostProbeSet /ProcSet findresource } /undefinedresource
    (and still gives it up) raises

verdict
