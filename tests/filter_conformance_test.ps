%!testlib
% Filter and scanner behaviours that a program packaging itself as a ProcSet
% relies on (PLRM 3.8.4, 3.13), run through `xpost -d null` by run-ps-test.sh:
% prints SUCCESS iff every assertion holds.
%
% These are the behaviours an extensible-filter or binary-IO library depends
% on: that a data source may be a string, a file or a procedure; that an
% encoding filter flushes and writes its end-of-data when closed; that a
% procedure handed round as data is still readable when packed or read-only;
% that gcheck answers where an object lives; and that a token read from a file
% leaves the file where the next raw read expects it.
%
% Two divergences from the commoner behaviour are recorded at the foot of this
% file rather than asserted, so that neither is frozen in as though it were
% correct.


% --- data sources: a filter takes a string, a file, or a procedure ---------

/hex (48656c6c6f>) def       % the ASCIIHex of (Hello) with its EOD

/fromstring 16 string def
hex /ASCIIHexDecode filter fromstring readstring pop
(Hello) eq (a string serves as a data source) assert

% a procedure source returns strings until it returns a zero-length one
/srcdone false def
/src { srcdone { () }{ /srcdone true store hex } ifelse } def
/fromproc 16 string def
/src load /ASCIIHexDecode filter fromproc readstring pop
(Hello) eq (a procedure serves as a data source) assert

% --- an encoding filter flushes and writes its EOD when it is closed ------
% A library that closes an encoding filter and then reads back what it wrote
% gets nothing, or a truncated stream, from an interpreter that does not.

/TMP (filter_conf_tmp.txt) def
/w TMP (w) file def
/enc w /ASCIIHexEncode filter def
enc (Hi) writestring
enc closefile
w closefile
/r TMP (r) file def
/back 64 string def
r back readstring pop /encoded exch def
r closefile
encoded (4869>) eq (an encoding filter flushes and writes EOD on closefile) assert

% --- a token read from a file leaves the file positioned after it ---------
% A library that reads a count with token and then reads that many raw bytes
% from the same file depends on this. The delimiter that ends the token is
% consumed with it.

/w2 TMP (w) file def
w2 (42 abcdefgh) writestring
w2 closefile
/r2 TMP (r) file def
r2 token pop pop                      % the 42
/rest 9 string def
r2 rest readstring pop /remaining exch def
r2 closefile
remaining (abcdefgh) eq (token leaves the file just past the token) assert

mark { TMP deletefile } stopped { } if cleartomark

% --- a procedure handed round as data stays readable ----------------------
% Staged-programming libraries are handed procedures that may be packed or
% read-only and must be able to read them without modifying them.

currentpacking true setpacking
/pk { 1 2 add } cvlit def
setpacking
pk type /packedarraytype eq (a packed procedure reports packedarraytype) assert
/n 0 def
pk { pop /n n 1 add store } forall
n 3 eq (forall walks a packed procedure) assert
mark { pk 0 2 getinterval pop } stopped not exch cleartomark
    (getinterval reads a packed procedure) assert
{ pk 0 /x put } /invalidaccess (a packed procedure refuses put) raises

/ro { 1 2 add } cvlit readonly def
/m 0 def
ro { pop /m m 1 add store } forall
m 3 eq (forall walks a read-only procedure) assert
{ ro 0 /x put } /invalidaccess (a read-only procedure refuses put) raises

% --- gcheck reports which memory an object was allocated in ---------------
% A library that must decide whether its queue may outlive a restore asks
% this before it allocates.

3 dict gcheck not (gcheck is false for a local object) assert
currentglobal true setglobal
/gd 3 dict def
setglobal
gd gcheck (gcheck is true for a global object) assert

% ---- a decode filter reports data its coding cannot represent

% PLRM 3.13 makes corrupt filter input an ioerror: an ASCII85 character
% outside the alphabet, a 5-tuple naming a value above 2^32-1, a hex digit
% that is not one, a compressed stream the decompressor rejects. The
% failure has to reach the program, because the alternative is worse than
% wrong -- a short read is indistinguishable from a clean end of data, so a
% truncated embedded image reads as an empty one and the job carries on
% painting nothing.

/decodes { % (data) name  .  errorname-or-/ok
    /_n exch def /_d exch def
    { _d _n filter 64 string readstring pop pop /ok }
    stopped { $error /errorname get } { } ifelse
} def

(v) /ASCII85Decode decodes /ioerror eq
    (an ASCII85 character outside the alphabet is an ioerror) assert
(uuuuu~>) /ASCII85Decode decodes /ioerror eq
    (an ASCII85 5-tuple above 2^32-1 is an ioerror) assert
(zzz) /ASCIIHexDecode decodes /ioerror eq
    (a character that is not a hex digit is an ioerror) assert
(abcdefgh) /FlateDecode decodes /ioerror eq
    (a flate stream the decompressor rejects is an ioerror) assert
(abcdefgh) /LZWDecode decodes /ioerror eq
    (an LZW stream the decompressor rejects is an ioerror) assert

% and a stream its coding does represent still reads without one
(87cURD]j7BEbo80~>) /ASCII85Decode decodes /ok eq
    (a well-formed ASCII85 stream decodes without an error) assert
(48656c6c6f>) /ASCIIHexDecode decodes /ok eq
    (a well-formed hex stream decodes without an error) assert

% ---- a fax decode reports what it can prove, and only that

% The distinction the CCITT decoding turns on is not how much input
% arrived: it is whether the bits in hand establish a violation before
% the input runs out. Bits that cannot be a code, and a run carrying a
% row past its declared width, are wrong however the stream ends. Input
% that stops first establishes nothing -- the run that would have proved
% something never finished -- so the stream ends, the half-decoded row is
% dropped, and nothing is reported.
%
% The pairs below differ by one bit of evidence either side of that line,
% which is what makes them worth keeping: a rule that reports too eagerly
% fails the left column, and one that never reports fails the right.

(abcd) /CCITTFaxDecode decodes /ok eq
    (four bytes of rubbish end the fax decode without a verdict) assert
(abcde) /CCITTFaxDecode decodes /ioerror eq
    (the fifth byte completes a run past the row and is an ioerror) assert

<4D9A80> /CCITTFaxDecode decodes /ok eq
    (a run sequence landing exactly on the row width decodes) assert
<4D8E> /CCITTFaxDecode decodes /ioerror eq
    (a run sequence one pixel past the row width is an ioerror) assert

<60D100> /CCITTFaxDecode decodes /ok eq
    (a row filled to its width by its last run decodes) assert
<60D3> /CCITTFaxDecode decodes /ioerror eq
    (a last run overshooting the width is an ioerror) assert

% a makeup code carries no verdict of its own: the run it belongs to has
% not finished, so a row already owed twice its width is still unproven
<4DA6C0> /CCITTFaxDecode decodes /ok eq
    (runs owed past the width but unterminated end without a verdict) assert

% zeros are fill ahead of a row and cannot be a code inside one
<00000000> /CCITTFaxDecode decodes /ok eq
    (a row preceded by nothing but fill bits ends without a verdict) assert
<350000> /CCITTFaxDecode decodes /ioerror eq
    (zeros where a run code belongs are an ioerror) assert

% A procedure standing as a data source or target is exercised in
% tests/filter_proc_test.ps, which holds the calls to the contract PLRM
% 3.13.1 states for them.

verdict
