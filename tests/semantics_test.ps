% Object-semantics regression checks, run through `xpost -d null` by
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% Covers:
%   - eq/ne on file objects compare the underlying stream (distinct
%     streams are ne; an object is eq to itself)
%   - pathbbox reports the current path in user space, undoing the CTM

% flate compression is an interpreter-private operator in internaldict, not
% systemdict; fetch it through the password to exercise it below.
/.flatecompress 1183615869 internaldict /.flatecompress get def

/failcount 0 def
/assert { % bool (name) . -
    exch { pop } { (FAIL: ) print print (\n) print /failcount failcount 1 add store } ifelse
} def
/assertnear { % val expected (name) . -
    3 1 roll sub abs 0.001 lt exch assert
} def

% --- file object comparison ---
/tmpf (%stdout) (w) file def
/diskf (semantics.diskf) (w) file def  % a real disk file (portable: not /dev/null)
diskf tmpf ne (disk file vs stdout are distinct) assert
diskf dup eq (file object equals itself) assert
tmpf dup ne not (stdout object not-ne itself) assert

% --- %stderr is writable ---
{ (%stderr) (w) file (semantics_test: stderr probe\n) writestring true } stopped
{ pop false } if (writestring to %stderr) assert

% --- currentfile returns a literal file: programs stash it under a
%     name and the later lookup must push the stashed file, not
%     resume executing it ---
currentfile xcheck not (currentfile carries the literal attribute) assert
/cfstash currentfile def
cfstash type /filetype eq (a stashed currentfile recalls as a file) assert

% --- pathbbox in user space ---
% pathbbox leaves llx lly urx ury; consume top-down
newpath 10 10 moveto 50 10 lineto 50 60 lineto 10 60 lineto closepath
pathbbox
60 (pathbbox ury) assertnear
50 (pathbbox urx) assertnear
10 (pathbbox lly) assertnear
10 (pathbbox llx) assertnear

% under a translated CTM the box must stay in (translated) user space
gsave
100 200 translate
newpath 0 0 moveto 10 0 lineto 10 5 lineto closepath
pathbbox
5 (translated ury) assertnear
10 (translated urx) assertnear
0 (translated lly) assertnear
0 (translated llx) assertnear
grestore

% a moveto that ends the path is only a pending current point (as
% after charpath or a text operator advances it) and stays outside
% the box; a moveto later drawn from counts, and a path holding
% nothing but a moveto is that one point
newpath 0 0 moveto 10 10 lineto 50 60 moveto
pathbbox
10 (trailing moveto ury) assertnear
10 (trailing moveto urx) assertnear
0 (trailing moveto lly) assertnear
0 (trailing moveto llx) assertnear
newpath 0 0 moveto 10 10 lineto 50 60 moveto 20 20 lineto
pathbbox
60 (drawn-from moveto ury) assertnear
50 (drawn-from moveto urx) assertnear
0 (drawn-from moveto lly) assertnear
0 (drawn-from moveto llx) assertnear
newpath 5 7 moveto
pathbbox
7 (only-moveto ury) assertnear
5 (only-moveto urx) assertnear
7 (only-moveto lly) assertnear
5 (only-moveto llx) assertnear

% --- get and put require an integer index for strings and arrays; a real
%     index, or a real value for a string byte, is a typecheck ---
(ab) 1 get 98 eq (string get by an integer index) assert
{ (ab) 1.0 get } stopped { pop pop true }{ false } ifelse (a real string index is a typecheck in get) assert
/st.co 2 string def
st.co 0 65 put st.co 0 get 65 eq (string put by an integer index and value) assert
{ st.co 0.0 65 put } stopped { pop pop pop true }{ false } ifelse (a real string index is a typecheck in put) assert
{ st.co 0 65.0 put } stopped { pop pop pop true }{ false } ifelse (a real string value is a typecheck in put) assert
[ 5 6 7 ] 1 get 6 eq (array get by an integer index) assert
{ [ 5 6 7 ] 1.0 get } stopped { pop pop true }{ false } ifelse (a real array index is a typecheck in get) assert
/st.ca 2 array def
st.ca 1 42 put st.ca 1 get 42 eq (array put by an integer index) assert
{ st.ca 1.0 42 put } stopped { pop pop pop true }{ false } ifelse (a real array index is a typecheck in put) assert

% cvi and cvr read their string operands with the scanner's token
% semantics: leading white space and anything past the numeral's end
% are ignored, and a token that is not a numeral refuses
(0.5\n) cvr 0.5 (cvr ignores what follows the numeral) assertnear
(  16 pt) cvi 16 eq (cvi skips leading space and trailing text) assert
{ (0.5junk) cvr } stopped { pop true }{ false } ifelse
(a glued suffix is no numeral) assert

% $error carries the standard entries: recordstacks (settable to skip
% the stack snapshot) and errorinfo, both present in the reference
$error /recordstacks known $error /errorinfo known and
($error carries recordstacks and errorinfo) assert
$error /recordstacks get (recordstacks defaults on) assert
$error /ostack null put
$error /recordstacks false put
{ 1 (s) add } stopped pop
$error /ostack get null eq (recordstacks off skips the snapshot) assert
$error /recordstacks true put
{ 1 (s) add } stopped pop
$error /ostack get type /arraytype eq (recordstacks on takes the snapshot) assert
$error /newerror false put

% == prints arrays and procedures with single-space separators and no
% padding inside the brackets, and its per-level scope leaves the dict
% stack as it found it however deep the nesting goes
countdictstack /st.dsd exch def
[ 1 [ 2 [ 3 4 ] ] (s) /n { add } ] ==
countdictstack st.dsd eq (== balances the dict stack when nesting) assert

% the string scanner reads octal escapes as the reference does: at
% most three digits, and octal digits only, so 8 and 9 and any fourth
% digit end the escape. == relies on this to reconstruct what it
% escaped (checked exhaustively by fuzzing, not here)
(\3770) length 2 eq (an octal escape stops after three digits) assert
(\0000) length 2 eq (a full three-digit octal stops at the third) assert
(\09) length 2 eq (8 and 9 are not octal digits) assert
(\128) length 2 eq (a non-octal digit ends the escape) assert
(\101) 0 get 65 eq (three octal digits decode) assert
(\377) 0 get 255 eq (the high octal value decodes) assert
(\0) 0 get 0 eq (a one-digit octal decodes) assert

% cvs of a real produces the shortest decimal that reads back to the
% same value, in the customary notation: fixed
% between 1e-4 and 1e6, scientific outside, a whole value keeping its
% .0. It once emitted full binary-float precision, and a large value
% corrupted a digit.
/st.cvsr { 40 string cvs } def
3.14159 st.cvsr (3.14159) eq (a real formats to the shortest decimal) assert
0.001 st.cvsr (0.001) eq (a small real keeps fixed notation) assert
2.5 st.cvsr (2.5) eq (no trailing zeros) assert
100000.0 st.cvsr (100000.0) eq (a whole real keeps its point below 1e6) assert
1e6 st.cvsr (1e+06) eq (a large real turns scientific at 1e6) assert
1e-5 st.cvsr (1e-05) eq (a tiny real turns scientific below 1e-4) assert
0.0001 st.cvsr (0.0001) eq (1e-4 is the last fixed magnitude) assert
% every formatted real reads back to the value it came from
/st.roundtrips true def
[ 3.14159 0.001 2.5 100000.0 0.5 0.1 42.0 1e10 1e-5 ] {
    dup st.cvsr cvr ne { /st.roundtrips false def } if
} forall
st.roundtrips (a formatted real reads back to itself) assert

% a source that ends inside a procedure is a syntax error, not an
% endless scan: the scanner answers null at end of input and nowhere
% else, a literal null in the text being a name
/st.f (semantics.scratch) (w) file def
st.f (1 2 { 3 4) writestring st.f closefile
{ (semantics.scratch) (r) file cvx exec } stopped
{ $error /errorname get /syntaxerror eq }{ false } ifelse
(a truncated procedure ends the scan) assert
clear
% a complete procedure still scans and runs
/st.f (semantics.scratch) (w) file def
st.f (/st.tp { 6 7 add } def) writestring st.f closefile
(semantics.scratch) (r) file cvx exec
st.tp 13 eq (a closed procedure scans and runs) assert

% --- an end-of-line inside a string literal: escaped, it joins
%     the lines; raw, it is one newline character, whichever of
%     the three conventions wrote it ---
(ab\
cd) length 4 eq (an escaped CRLF joins the lines) assert
(ab\
cd) length 4 eq (an escaped bare CR joins the lines) assert
(ab\
cd) length 4 eq (an escaped LF joins the lines) assert
(a
b) dup length 3 eq exch 1 get 10 eq and
(a raw CRLF reads as one newline) assert
(a
b) dup length 3 eq exch 1 get 10 eq and
(a raw CR reads as one newline) assert

% --- an end-of-line marker is one white-space delimiter ---
(ab\r\ncd) token pop exch (cd) eq
    (a CRLF after a token is consumed as one marker) assert
(ab\rcd) token pop exch (cd) eq
    (a bare CR after a token is consumed alone) assert

% --- gcheck holds for simple objects; composites answer for their
%     storage ---
42 gcheck (an integer is a legal element of a global composite) assert
/st.gname gcheck (a name is a simple object under gcheck) assert
[ 1 2 ] gcheck not (a local array is not) assert
currentglobal true setglobal [ 1 2 ] exch setglobal gcheck
(a global array is) assert

% --- bind terminates on a procedure that reaches itself ---
/st.cyc [ 1 2 3 ] cvx def
/st.cyc load 0 /st.cyc load put
/st.cyc load bind type /arraytype eq (bind survives a cyclic procedure) assert

% --- a repeated stencil replays from the run cache cleanly ---
count /st.c0 exch def
gsave 8 8 true [8 0 0 -8 0 8] {<AA55AA55AA55AA55>} imagemask grestore
gsave 8 8 true [8 0 0 -8 0 8] {<AA55AA55AA55AA55>} imagemask grestore
count st.c0 eq (a cached stencil leaves the stack clean) assert

% --- the job server: exitserver ends the encapsulated job and begins an
% unencapsulated one, resetting the stacks (PLRM 3.7.7) -- serverdict comes
% off the dictionary stack and the operand stack is cleared ---
countdictstack /st.esd exch def
{ serverdict begin 0 exitserver } stopped not
    (exitserver continues the job) assert
count 0 eq (exitserver clears the operand stack) assert
countdictstack st.esd eq (exitserver unwinds the begun serverdict) assert

% --- dict growth: inserting far past a small dict's capacity grows and
% rehashes it in place, repeatedly. Regression for a heap-use-after-free
% where a re-insertion that relocated the memory file left the grow's
% source-table pointer dangling: every entry must survive the growths. ---
/GD 4 dict def
0 1 20000 { GD exch dup put } for
GD length 20001 eq (a repeatedly grown dict keeps every entry) assert
GD 0 get 0 eq (the first key survives dict growth) assert
GD 12345 get 12345 eq (a middle key survives dict growth) assert
GD 20000 get 20000 eq (the last key survives dict growth) assert

% --- procedure-implemented standard operators stand as operators ---
% load answers operatortype for them, so bind substitutes them and the
% classic self-redefinition idiom captures the standard behaviour
% instead of recursing into the new definition
/stroke load type /operatortype eq (stroke loads as an operator) assert
/fill load type /operatortype eq (fill loads as an operator) assert
/show load type /operatortype eq (show loads as an operator) assert
/st.stroke /stroke load def
gsave
/stroke { 2 2 scale stroke } bind def
newpath 10 10 moveto 20 20 lineto stroke
true (a bound self-redefinition of stroke terminates) assert
grestore
userdict /stroke /st.stroke load put

% an error that unwinds out of a wrapped operator is the operator's
% error: it names the command, and the stacks return to their depths
% at the call -- what the procedure part-way pushed drops, operands
% still in place stay
/ep.op /ep.testname { (j1) (j2) ep.doesnotexist } 1183615869 internaldict /.wrapop get exec def
count /ep.d0 exch def
1 2 { ep.op } stopped
(the wrapped-operator error is caught) assert
$error /command get dup type /operatortype eq
exch 32 string cvs (ep.testname) eq and
(an error in a wrapped operator names the operator) assert
count ep.d0 sub 2 eq (the operand depth at the call comes back) assert
pop pop
% nested wrapped calls report the innermost and unwind to the caller
/ep.in /ep.inner { 7 8 ep.alsomissing } 1183615869 internaldict /.wrapop get exec def
/ep.out /ep.outer { (x) (y) ep.in } 1183615869 internaldict /.wrapop get exec def
count /ep.d1 exch def
{ ep.out } stopped pop
$error /command get 32 string cvs (ep.inner) eq
(a nested wrapped error names the innermost operator) assert
count ep.d1 eq (a nested wrapped error unwinds the operand junk) assert
% a wrapper that catches its own error keeps its own state
/ep.c /ep.catcher { (kept) { ep.gone } stopped pop } 1183615869 internaldict /.wrapop get exec def
ep.c (kept) eq (a wrapper catching its own error keeps its stack) assert
% the dict stack comes back when the procedure dies inside a begin
countdictstack /ep.dd exch def
/ep.d /ep.dicty { 5 dict begin ep.nothere } 1183615869 internaldict /.wrapop get exec def
{ ep.d } stopped pop
countdictstack ep.dd eq (the dict depth at the call comes back) assert

% --- machinery runs a program's procedures on the program's stacks ---
% a callback's defs reach the program's dictionaries, and the
% machinery's private names are out of the callback's reach
gsave
{ 10 10 8 [10 0 0 -10 0 10]
  { /bp (x) def /buf 5 def /bz 99 def <00112233445566778899> }
  image } stopped not
(an image source defining the row pump's names completes) assert
grestore
userdict /bp undef userdict /buf undef userdict /bz undef

% --- the machinery's data roots and state are its own: a program may
% take the names graphicsdict, DEVICE and =string for itself, and it
% finds no machinery state in userdict to disturb ---
/Courier findfont 10 scalefont setfont
5 dict begin
/graphicsdict (mine) def
/DEVICE 42 def
/=string 7 def
{ newpath 10 10 moveto 40 40 lineto stroke
  100 100 moveto (a) show
  gsave 20 20 10 10 rectfill grestore } stopped not
end
(painting survives shadowed graphicsdict, DEVICE and =string) assert
userdict /.wrappedprocs known not
(the machinery keeps its state out of userdict) assert

% --- the machinery's internal references are frozen: a program
% shadowing a core operator name reaches only its own calls ---
/Courier findfont 10 scalefont setfont
userdict /exch 99 put
gsave
{ 100 100 moveto (a) show
  newpath 10 10 moveto 20 20 lineto stroke } stopped not
grestore
userdict /exch undef
(text and stroking survive a shadowed exch) assert

% --- internaldict answers its password and refuses others ---
1183615869 internaldict type /dicttype eq
(internaldict answers its password) assert
{ 0 internaldict } stopped (a wrong password is refused) assert
$error /newerror false put clear

% --- the language answers for itself ---
languagelevel 3 eq (languagelevel names the level) assert
false (pw) startjob (startjob accepts a job boundary) assert
currentshared currentglobal eq (shared and global VM are one view) assert
42 scheck (scheck follows gcheck) assert
shareddict globaldict eq (shareddict is the global dictionary) assert
/st.uf << /FontType 3 /FontMatrix [1 0 0 1 0 0] /Encoding 256 array
    /BuildChar { pop pop } /FontBBox [0 0 1 1] >> definefont pop
/st.uf undefinefont
FontDirectory /st.uf known not (undefinefont removes the instance) assert
true setstrokeadjust currentstrokeadjust (stroke adjustment is recorded) assert
false setstrokeadjust
0.5 setsmoothness currentsmoothness 0.5 eq (smoothness is recorded) assert
currentrasteropcode 12 eq (the raster op code defaults to replace) assert
6 setrasteropcode currentrasteropcode 6 eq (the raster op code is recorded) assert
12 setrasteropcode
currentoverprintmode 0 eq (the overprint mode defaults to zero) assert
1 setoverprintmode currentoverprintmode 1 eq (the overprint mode is recorded) assert
0 setoverprintmode
currentdistillerparams type /dicttype eq (currentdistillerparams answers a dict) assert
currentdistillerparams /CompressPages get (a seeded parameter has its default) assert
<< /CompressPages false >> setdistillerparams
currentdistillerparams /CompressPages get not (setdistillerparams records a change) assert
currentdistillerparams /PreserveOverprintSettings get (an untouched parameter keeps its default) assert
<< /EmbedAllFonts true >> setdistillerparams
currentdistillerparams /EmbedAllFonts get (a parameter this build does not act on is still accepted) assert
currentdistillerparams /CompressPages true put
currentdistillerparams /CompressPages get not (currentdistillerparams hands back a copy) assert
<< /LockDistillerParams true >> setdistillerparams
<< /CompressPages true >> setdistillerparams
currentdistillerparams /CompressPages get not (a set after the lock is ignored) assert
/StandardEncoding findencoding length 256 eq
(findencoding resolves through the Encoding category) assert
% findcolorrendering forms intent.deviceconfig.halftone and answers true
% only when a dictionary of that name is registered (PLRM 8.2). An intent
% nothing was registered for gets the substitute and FALSE, which is what
% tells the program the name is a proposal rather than a match.
(any) findcolorrendering
not exch /DefaultColorRendering eq and
(findcolorrendering proposes the default for an unregistered intent) assert
/Perceptual.none.none << /ColorRenderingType 1 >> /ColorRendering defineresource pop
/Perceptual findcolorrendering
exch /Perceptual.none.none eq and
(findcolorrendering finds a dictionary registered under the name it forms) assert
<< /HalftoneType 1 /Frequency 60 /Angle 0 /SpotFunction { pop pop 0 }
   /HalftoneName /Named >> sethalftone
/Perceptual.none.Named << /ColorRenderingType 1 >> /ColorRendering defineresource pop
/Perceptual findcolorrendering
exch /Perceptual.none.Named eq and
(the current halftone's name is part of the name it forms) assert
count /st.cd exch def
cachestatus
count st.cd sub 7 eq (cachestatus reports seven values) assert
7 { pop } repeat
/Courier findfont dup setfont
rootfont eq (rootfont answers with the font the program set) assert

% --- user objects index into a growing table ---
3 { 40 2 add } defineuserobject
3 execuserobject 42 eq (a user object executes by index) assert
25 (far) defineuserobject
25 execuserobject (far) eq (the table grows to reach an index) assert
3 execuserobject 42 eq (growth preserves earlier entries) assert
3 undefineuserobject
UserObjects 3 get null eq (undefineuserobject clears the slot) assert

% --- user paths append through both forms ---
newpath
{ 0 0 40 40 setbbox 10 10 moveto 30 30 lineto } uappend
currentpoint 30 eq exch 30 eq and (a self-describing path appends) assert
newpath
[ [0 0 20 20  5 5  1 1  1 1] <00 01 22 04> ] uappend
currentpoint 7 eq exch 7 eq and
(an encoded path repeats its operator by the factor less thirty-two) assert
newpath 1 2 moveto 3 4 lineto
false upath
newpath uappend
currentpoint 4 eq exch 3 eq and (upath round-trips the current path) assert

% --- ReusableStreamDecode buffers its whole source at construction
%     and replays it from any position ---
currentfile /ASCIIHexDecode filter /ReusableStreamDecode filter
48656C6C6F>
/rsdstash exch def
rsdstash 5 string readstring pop (Hello) eq
(a reusable stream reads its data) assert
rsdstash resetfile
rsdstash 5 string readstring pop (Hello) eq
(resetfile replays a reusable stream) assert
rsdstash 2 setfileposition
rsdstash fileposition 2 eq (fileposition reports the reusable position) assert
rsdstash 3 string readstring pop (llo) eq
(setfileposition repositions a reusable stream) assert

% a reusable stream built over a decode chain consumes its source
% through the encoding's end, survives being closed -- the position
% rewinds -- and so a program run off it can run again
currentfile << /Filter [ /ASCIIHexDecode ] >> /ReusableStreamDecode filter
2F73742E7273642031372064656620>
/st.rsdp exch def
st.rsdp cvx exec
st.rsd 17 eq (a chained reusable stream delivers its program) assert
userdict /st.rsd undef
st.rsdp 0 setfileposition
st.rsdp cvx exec
st.rsd 17 eq (the stream runs again after its end closed it) assert
% repositioning a closed file is an error, not a crash
/st.f (semantics.scratch) (w) file def
st.f (x) writestring st.f closefile
{ st.f 0 setfileposition } stopped { pop pop true }{ false } ifelse
(repositioning a closed file refuses) assert

% --- resetfile discards a disk file's buffered read-ahead ---
% a small file is read whole into the standard-I/O buffer on the first read, so
% once resetfile discards that buffer the next read reaches end of file. This is
% resetfile's behaviour on an input disk file across platforms -- __fpurge on
% POSIX, fflush on Windows both discard-and-skip.
/rf.f (semantics.scratch) (w) file def
rf.f (ABCDEFGHIJ) writestring rf.f closefile
/rf.g (semantics.scratch) (r) file def
rf.g 3 string readstring pop (ABC) eq (a disk file reads its head) assert
rf.g resetfile
rf.g read { pop false }{ true } ifelse (resetfile discards a disk file's read-ahead) assert
rf.g closefile

% --- ASCII base-85 string literals decode in the scanner ---
<~87cURD]hD=6i~> (Hello CID) eq (a base-85 literal decodes) assert
<~z~> <00000000> eq (z abbreviates four zero bytes) assert

% --- immediately evaluated names (PLRM 3.12.2): the scanner looks the
% name up on the dictionary stack and substitutes its value, and where
% it cannot find the name an undefined error occurs. A lookup that fails
% leaves nothing to substitute, so the value beneath on the operand stack
% is what the token would otherwise become -- silently, and differently
% depending on what the program last left there ---
/imm.defined 42 def
(//imm.defined) token (a defined immediate name scans) assert
42 eq (an immediate name scans as the value it names) assert
pop

1234567  % what a lookup that pushed nothing would take instead
{ (//imm.undefined) token } stopped
    (an immediate name with no definition raises) assert
$error /errorname get /undefined eq
    (an immediate name with no definition raises undefined) assert
clear

% The scanner substitutes the value, so what it substitutes carries the
% value's access with it (PLRM 3.12.2 with 3.3.2). For an array access
% belongs to the reference, so a constant sealed BEFORE the body that names
% it is scanned is sealed inside that body too, and one sealed afterwards
% is not: the reference the body holds was taken while it was still open.
% For a dictionary access belongs to the value, so the order does not
% arise. Machinery that seals a table where it is defined depends on the
% first of these, and on knowing the second is not the same.
/imm.sealed [ 1 2 3 ] readonly def
/imm.usesealed { //imm.sealed } def
/imm.usesealed load 0 get wcheck not
    (an immediate name of a sealed array carries the seal into the body) assert

/imm.late [ 1 2 3 ] def
/imm.uselate { //imm.late } def
/imm.late imm.late readonly def
/imm.uselate load 0 get wcheck
    (an array sealed after a body named it leaves that body's copy open) assert

/imm.dict 3 dict def
/imm.usedict { //imm.dict } def
imm.dict readonly pop
/imm.usedict load 0 get wcheck not
    (a dictionary sealed after is sealed in the body, access being the value's) assert

{ /imm.usesealed load 0 get 0 99 put } stopped
    (writing through a sealed immediate reference raises) assert
$error /errorname get /invalidaccess eq
    (writing through a sealed immediate reference raises invalidaccess) assert
clear

% --- clipsave and cliprestore stack the clip region alone ---
gsave
newpath 10 10 moveto 50 10 lineto 50 50 lineto 10 50 lineto closepath clip
clipsave
newpath 20 20 moveto 30 20 lineto 30 30 lineto 20 30 lineto closepath clip
gsave clippath flattenpath pathbbox grestore
pop pop pop 20 sub abs 0.5 lt (an inner clip narrows the region) assert
cliprestore
gsave clippath flattenpath pathbbox grestore
pop pop pop 10 sub abs 0.5 lt (cliprestore reopens the outer region) assert
grestore

% black generation, undercolor removal and colour rendering record
% and report round-trip
{ 0.5 mul } setblackgeneration
4 currentblackgeneration exec 2 eq (blackgeneration round-trips) assert
{ 0.25 mul } setundercolorremoval
8 currentundercolorremoval exec 2 eq (undercolorremoval round-trips) assert

% --- resource machinery: instances per category, private categories
%     registered by defining into /Category ---
currentglobal true setglobal
/Generic /Category findresource type /dicttype eq (Generic category exists) assert
/Generic /Category findresource dup length 1 add dict copy
dup /Category /st.private put
/st.private exch /Category defineresource pop
/st.key << /v 42 >> /st.private defineresource /v get 42 eq (defineresource returns the instance) assert
/st.key /st.private findresource /v get 42 eq (findresource retrieves the instance) assert
/st.key /st.private resourcestatus { pop pop true } { false } ifelse (resourcestatus finds it) assert
/st.other /st.private resourcestatus { pop pop false } { true } ifelse (resourcestatus rejects the unknown) assert
/st.aa 1 /st.private defineresource pop
/st.ab 2 /st.private defineresource pop
/st.bb 3 /st.private defineresource pop
[ (*) { dup length string copy } 32 string /st.private resourceforall ]
length 4 eq (resourceforall enumerates every instance) assert
[ (st.a*) { dup length string copy } 32 string /st.private resourceforall ]
length 2 eq (resourceforall filters by a star template) assert
[ (st.?b) { dup length string copy } 32 string /st.private resourceforall ]
length 2 eq (a ? in the template matches any one character) assert
[ (st.key) { dup length string copy } 32 string /st.private resourceforall ]
length 1 eq (a literal template matches exactly one) assert
[ (none*) { dup length string copy } 32 string /st.private resourceforall ]
length 0 eq (an unmatched template enumerates nothing) assert
[ (st.priv*) { dup length string copy } 32 string /Category resourceforall ]
length 1 eq (resourceforall enumerates categories) assert
/st.aa /st.private undefineresource
/st.ab /st.private undefineresource
/st.bb /st.private undefineresource
/st.key /st.private undefineresource
/st.key /st.private resourcestatus { pop pop false } { true } ifelse (undefineresource removes it) assert
count /st.d0 exch def
{ /st.key /st.ghost findresource } stopped
{ count st.d0 sub { pop } repeat $error /errorname get /undefinedresource eq }
{ count st.d0 sub { pop } repeat false } ifelse
(a missing category reports undefinedresource) assert
setglobal

% undefineresource has three arms, chosen by whether the category and
% then the key are local. Above exercises only the arm reached when
% neither is -- the block runs under `true setglobal`, so a local
% category never exists. The other two ran with the wrong operand: one
% removed the category name from a dictionary it had just created and
% reported success, and the other raised undefinedresource naming
% findresource. Both left the instance in place.
currentglobal false setglobal
/st.loc (v) /Generic defineresource pop
count /st.d1 exch def
{ /st.loc /Generic undefineresource } stopped
{ count st.d1 sub { pop } repeat false }
{ count st.d1 sub { pop } repeat true } ifelse
    (undefineresource removes a local instance without raising) assert
/st.loc /Generic resourcestatus { pop pop false }{ true } ifelse
    (and the local instance is gone) assert

% the other arm: a global instance while some local instance has put the
% category in the local table
/st.keep (v) /Generic defineresource pop
currentglobal true setglobal /st.glob (g) /Generic defineresource pop setglobal
count /st.d2 exch def
{ /st.glob /Generic undefineresource } stopped
{ count st.d2 sub { pop } repeat false }
{ count st.d2 sub { pop } repeat true } ifelse
    (undefineresource removes a global instance beside a local one) assert
/st.glob /Generic resourcestatus { pop pop false }{ true } ifelse
    (and the global instance is gone) assert
/st.keep /Generic undefineresource
setglobal

% --- instances defined in local VM shadow global ones and go away
%     with restore ---
currentglobal false setglobal
/StandardEncoding /Encoding findresource length 256 eq
(the Encoding category serves the standard encodings) assert
save
/st.linst [ 1 2 3 ] /Encoding defineresource pop
/st.linst /Encoding findresource length 3 eq (a local instance resolves) assert
/st.linst /Encoding resourcestatus { pop pop true }{ false } ifelse
(a local instance reports status) assert
restore
/st.linst /Encoding resourcestatus { pop pop false }{ true } ifelse
(restore removes a local instance) assert
setglobal

% --- binary tokens (PLRM 3.14.2): every encoding a packaged program
%     body uses, plus the sibling byte orders ---
<8820> cvx exec 32 eq (int8) assert
<88E0> cvx exec -32 eq (int8 negative) assert
<860100> cvx exec 256 eq (int16 high order) assert
<870001> cvx exec 256 eq (int16 low order) assert
<8400010000> cvx exec 65536 eq (int32 high order) assert
<8500000100> cvx exec 65536 eq (int32 low order) assert
<84FFFFFFFF> cvx exec -1 eq (int32 negative) assert
<8A3F800000> cvx exec 1.0 eq (real IEEE high order) assert
<8B0000803F> cvx exec 1.0 eq (real IEEE low order) assert
<8D01> cvx exec true eq (boolean) assert
<8E03414243> cvx exec (ABC) eq (string, 1-byte length) assert
<8F0003414243> cvx exec (ABC) eq (string, 2-byte length) assert
<9100> cvx exec /abs eq (literal system name) assert
-5 <9200> cvx exec 5 eq (executable system name executes) assert
% a binary token byte delimits the token it follows
<747275658820> cvx exec 32 eq exch true eq and (binary byte delimits a name token) assert
% inside a deferred procedure body
<7B20880A203320616464207D> cvx exec exec 13 eq (binary token inside a procedure) assert

