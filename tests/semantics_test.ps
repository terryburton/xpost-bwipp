   /RangeABC [0 1 0 1 0 1]
   /DecodeABC [ {2.2 exp} bind {2.2 exp} bind {2.2 exp} bind ]
   /MatrixABC [ 0.4124 0.2126 0.0193 0.3576 0.7152 0.1192
                0.1805 0.0722 0.9505 ]
   /RangeLMN [0 0.9505 0 1 0 1.089] >> ] setcolorspace
currentcolorspace 0 get /CIEBasedABC eq (a CIE space reports itself) assert
0.5 0.5 0.5 setcolor
currentrgbcolor
0.5 sub abs 0.02 lt exch 0.5 sub abs 0.02 lt and exch 0.5 sub abs 0.02 lt and
(a calibrated mid grey lands mid grey) assert
1 0 0 setcolor currentrgbcolor pop pop 0.98 gt
(a calibrated red reaches the red channel) assert
[ /CIEBasedA << /WhitePoint [0.9505 1.0 1.089]
   /DecodeA {2.2 exp} bind
   /MatrixA [0.9505 1.0 1.089]
   /RangeLMN [0 0.9505 0 1 0 1.089] >> ] setcolorspace
0.5 setcolor currentrgbcolor
2 { 1 index sub abs 0.005 lt (calibrated grey is neutral) assert } repeat
0.5 sub abs 0.02 lt (and half in comes out half) assert
[ /CIEBasedDEF << /WhitePoint [0.9505 1.0 1.089]
   /Table [ 2 2 2 [ <000000 0000FF 00FF00 00FFFF>
                    <FF0000 FF00FF FFFF00 FFFFFF> ] ]
   /RangeLMN [0 0.9505 0 1 0 1.089]
   /MatrixLMN [0.9505 0 0 0 1 0 0 0 1.089] >> ] setcolorspace
0.5 0.5 0.5 setcolor currentrgbcolor
0.732 sub abs 0.02 lt exch 0.732 sub abs 0.02 lt and exch 0.732 sub abs 0.02 lt and
(the table midpoint interpolates all eight corners) assert
/DeviceGray setcolorspace 0 setgray


% --- setpagedevice (last: it replaces the device) ---
<< /OutputDevice /pgm /PageSize [50 25] /HWResolution [144 144] /TextAlphaBits 3 >> setpagedevice
DEVICE /dimensions get dup 0 get 100 eq exch 1 get 50 eq and
    (setpagedevice sizes the device from PageSize and HWResolution) assert
DEVICE /TextAlphaBits get 3 eq (device features land on the device) assert
% A feature the machinery reads as a number is refused where the value
% is not one, at the request rather than at the page it would have made:
% the number of bits of a glyph's edge coverage a device is sent is one,
% and a value that is not a number of anything reads as no number at
% all, which is what the machinery does for a device asking for none. So
% a misspelt request would otherwise come out as a request that asked
% for nothing, silently. PLRM 6.2.7 has setpagedevice raise typecheck
% besides refusing what it cannot satisfy.
{ << /TextAlphaBits 4.0 >> setpagedevice } stopped
{ $error /errorname get /typecheck eq }{ false } ifelse
    (a page-device feature read as a number is typechecked) assert
{ << /TextAlphaBits (four) >> setpagedevice } stopped
{ $error /errorname get /typecheck eq }{ false } ifelse
    (and so is one spelt as a string) assert
DEVICE /TextAlphaBits get 3 eq (a refused request leaves the device as it was) assert
currentpagedevice /HWResolution get 0 get 144 eq (currentpagedevice reports the request) assert
1 0 dtransform pop 2 sub abs 0.01 lt (the device matrix carries the resolution) assert
<< /PageSize [25 25] >> setpagedevice
DEVICE /dimensions get 0 get 50 eq (a partial request merges over the previous one) assert
DEVICE /TextAlphaBits get 3 eq (merged features persist) assert
<< /OutputDevice /null /PageSize [10 10] >> setpagedevice
currentpagedevice /TextAlphaBits known not
    (switching OutputDevice discards the accumulated parameters) assert
currentpagedevice /HWResolution known not
    (a device switch reverts unstated parameters to defaults) assert

% --- the page-size convenience operators of the printer products ---
a4 currentpagedevice /PageSize get
dup 0 get 595 eq exch 1 get 842 eq and
    (a4 requests the a4 page) assert
legal currentpagedevice /PageSize get 1 get 1008 eq
    (legal requests the legal page) assert
letter currentpagedevice /PageSize get 0 get 612 eq
    (letter requests the letter page) assert
b4 currentpagedevice /PageSize get 0 get 728 eq
    (b4 measures 728 points across) assert

% --- names carry every byte of their string, embedded nuls included
% (PLRM cvn: a name lexically the same as the string) ---
<00> cvn () cvn ne (a one-nul name differs from the empty name) assert
<00> cvn length 1 eq (a one-nul name has length 1) assert
<610062> cvn (ab) cvn ne (an embedded nul is not a terminator) assert
<610062> cvn length 3 eq (an embedded-nul name keeps its length) assert
<610062> cvn 16 string cvs <610062> eq (cvs round-trips an embedded nul) assert
<610062> cvn <610062> cvn eq (an embedded-nul name interns stably) assert
2 dict dup <00> cvn 42 put dup () cvn 7 put
dup <00> cvn get 42 eq (a nul name keys its own dictionary slot) assert
() cvn get 7 eq (the empty name keys a distinct slot) assert

% --- restore closes a file created since the save (PLRM 3.8.2: the
% close flushes, observable as bytes on disk; a file from before the
% save is untouched) ---
save /rc_f (semantics_restore_scratch) (w) file def
rc_f (hello) writestring restore
(semantics_restore_scratch) (r) file
dup bytesavailable 5 eq (restore flushes and closes a post-save file) assert
closefile
/rc_g (semantics_restore_scratch2) (w) file def
save restore
{ rc_g (x) writestring true } stopped { pop false } if
(a file from before the save stays open across restore) assert
rc_g closefile

% the scratch files are the test's own; leaving them behind pollutes the
% tree the suite runs in
(semantics_restore_scratch) deletefile
(semantics_restore_scratch2) deletefile

failcount 0 eq { (SUCCESS\n) print } { (FAILURES: ) print failcount 20 string cvs print (\n) print } ifelse
flush
quit
