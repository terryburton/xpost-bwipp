%!testlib
% What a font found under a name nothing here supplies says it is, run
% through `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% PLRM 8.2 has findfont answer with a font in every case: a name the
% host cannot supply "substitutes a default font or executes the
% invalidfont error", and this build substitutes. PLRM Table 5.7 has
% /FontName state "the name of this font". The two together decide what
% the substitute's dictionary has to say: the name of the font it is,
% which is the face that was found, and not the name that was asked for
% and reached nothing.
%
% The statement is invisible to painting, which is why it lasted. The
% substitute paints its own glyphs whatever its dictionary says it is
% called. What the wrong name breaks is every program that READS the
% name: a program that asks for a font, reads /FontName back and finds
% the name it asked for has been told the face is there when it is not,
% and can neither report the substitution nor choose differently.
%
% WHAT IS NOT A SUBSTITUTION, and is the case that matters more. A name
% resolved to a face of another family is not one: a host is told which
% families stand in for which, and a name it maps that way is a name it
% considers itself to have -- the font asked for is there, under another
% family's file, and the name asked by is still the name of the font
% that was got. Only a name the host has nothing for at all falls
% through to its default face, and only that is the substitution PLRM
% 8.2 describes. The two are told apart in the font machinery; what is
% asserted here is what a program can see of the answer.
%
% WHICH NAMES A HOST HAS is the host's business and differs from one
% machine to the next, so it cannot be asserted from here -- a suite
% that named the fonts it expected would be reporting the machine it
% was written on. The names below are printed instead, so a log taken
% anywhere says what that host answered.

% a face answers for this suite: a build without a face library resolves
% no faces by name at all
systemdict /NOFACES known
{ (SKIPPED: this suite reads the name of a face found by name, and this build carries no face library) = flush quit } if

% A name no font file carries. It is not a name this suite invented to
% be refused -- the platform's font configuration answers nearly any
% name with some face, which is what makes a substitution happen at all.
/fs.asked /XpostNoSuchFaceZZ def

/fs.got null def
{ fs.asked findfont /fs.got exch def } outcome /ok ne {
    (SKIPPED: nothing on this host answers a name it does not carry, so no)
      print ( substitution happens here) print (\n) print flush quit
} if

fs.got type /dicttype eq
    (a name nothing supplies still answers with a font) assert

% ------------------------------------------------- the name it answers by
fs.got /FontName known
    (a substituted font carries a FontName) assert
fs.got /FontName get type /nametype eq
    (a substituted font names itself with a name) assert
fs.got /FontName get xcheck not
    (a substituted font names itself with a literal name) assert
fs.got /FontName get fs.asked ne
    (a substituted font does not answer by the name that reached nothing) assert

% ------------------------------------------------------ and says it again
%
% The face behind a name is held between lookups, so the second lookup
% of a name takes a different route through the font machinery from the
% first. What it says about the font must not depend on which route it
% took.
/fs.again null def
{ fs.asked findfont /fs.again exch def } outcome /ok eq
    (a substituted name answers a second time) assert
fs.again null ne {
    fs.again /FontName get fs.got /FontName get eq
        (a substituted name says the same thing the second time) assert
} if

% ------------------------------------------------- and lands somewhere real
%
% The name a substitute answers by is the name of a face this host
% holds, so asking for it reaches that face and it answers by itself.
% A name that answered by something the host cannot then resolve would
% be as useless to a program as the name that reached nothing.
/fs.name fs.got /FontName get def
/fs.round null def
{ fs.name findfont /fs.round exch def } outcome /ok eq
    (the name a substitute answers by finds a font) assert
fs.round null ne {
    fs.round /FontName get fs.name eq
        (the name a substitute answers by is a name that answers by itself) assert
} if

% ---------------------------------------------------------- and is a font
%
% A substitute is a font and not a placeholder: PLRM 8.2 asks findfont
% for a font, so what comes back sets and measures like one.
{ fs.got 12 scalefont setfont (Az) stringwidth pop pop }
    (a substituted font sets and measures) works

% ------------------------------------------------- what this host answered
%
% Printed rather than asserted, for the reason given at the top: which
% of these a machine holds is the machine's business. What a reader of
% the log can see is whether a name the host resolves came back under
% its own name, which is the whole of the distinction above.
[ /Times-Roman /Helvetica /Courier /Symbol ] {
    dup 40 string cvs print (: ) print
    findfont /FontName get 40 string cvs print (\n) print
} forall
(note: a name nothing carries: ) print
fs.asked 40 string cvs print (: ) print fs.name 40 string cvs print (\n) print
flush

% ================== the kind of face a substitute is =====================
%
% PLRM 8.2 lets findfont substitute, and says nothing about what. What a
% document loses when the substitute is chosen badly is not a different
% cut of the type it asked for but a different kind of type: a page set
% in a serif and answered with a sans carries the same words in the wrong
% letterforms at the wrong widths for the measure it was written to.
%
% A name that reaches nothing reaches the machine's default face, and
% that face is of one kind however many kinds of name arrive. So the
% words of the name are read for the kind they name -- Serif, Sans, Mono,
% and the other words type uses for those three -- and the request is put
% again as that kind. What comes back is still a substitute and still
% says so; it is a substitute of the kind that was asked for.
%
% WHAT IS ASSERTED HERE is what a program can see, which is the name each
% of these lands on and no more: whether two names land on one face, and
% whether a name lands on the face a nameless request would have got.
% Which faces this machine holds is the machine's business, as at the top
% of this suite, so nothing below names a face.

/fs.face { findfont /FontName get } bind def       % name  .  facename
/fs.carried { /Font resourcestatus { pop pop true }{ false } ifelse } bind def

% ---------------------------------------------- the names that must not move
%
% The standard PostScript names are the common case, and a machine is
% told which of its families stand in for them. A name it answers that
% way is a name it has: nothing above may divert it, and the font must
% still answer by the name it was asked for.
%
% Asserted of each name the host says it carries, and skipped by name for
% each it does not -- which of them a machine holds differs from one
% machine to the next, and a suite naming the ones it expected would be
% reporting the machine it was written on.
[ /Times-Roman /Helvetica /Courier /Symbol /AvantGarde-Book /Bookman-Light
  /Palatino-Roman /ZapfChancery-MediumItalic /ZapfDingbats /Courier-Bold ]
{
    dup fs.carried {
        dup dup fs.face eq
        exch 40 string cvs (answers by the name the host carries it under)
        assert2
    }{
        (SKIPPED: this host does not carry ) print 40 string cvs print
        (\n) print flush
    } ifelse
} forall

% The compressed spelling of a standard name is the case the aliasing
% misses: the machine holds the family spelled out and nothing maps one
% onto the other. Whatever answers it -- the machine's own aliasing, this
% build's, or the kind read out of the words -- it must not be the face a
% request naming nothing at all reaches.
/fs.plain /XpostPlainZZ fs.face def
/fs.serif /XpostSerifZZ fs.face def
/fs.sans  /XpostSansZZ  fs.face def
/fs.mono  /XpostMonoZZ  fs.face def

fs.serif fs.plain ne {
    /NewCenturySchlbk-Roman fs.face fs.plain ne
        (a compressed standard name does not reach the classless default) assert
}{
    (SKIPPED: this host answers a serif request with its classless default,)
      print ( so the two cannot be told apart) print (\n) print flush
} ifelse

% ------------------------------------------------- a kind read from the words
%
% The three probe names below are names no machine carries -- each is
% checked for that, since a machine that did carry one would be answering
% rather than falling back and the case would hold vacuously. They differ
% only in the word that says the kind.
[ /XpostSerifZZ /XpostSansZZ /XpostMonoZZ /XpostPlainZZ ] {
    dup fs.carried not exch 40 string cvs
    (is a name no machine carries, so it falls back) assert2
} forall

fs.serif fs.sans ne
    (a serif-named name and a sans-named name do not reach one face) assert

fs.mono fs.sans ne
    (a mono-named name and a sans-named name do not reach one face) assert
fs.mono fs.serif ne
    (a mono-named name and a serif-named name do not reach one face) assert

% It is the kind and not the name that decides. Two serif-named names
% with nothing else in common reach the same face, and it is not the one
% a name saying nothing reaches.
/XpostGaramondZZ fs.face fs.serif eq
    (two serif-named names reach one face) assert
fs.serif fs.plain ne
    (a serif-named name does not reach the classless default) assert

% ------------------------------------------------------- and a style with it
%
% The style a PostScript name states in its suffix is recovered
% separately, and the kind is carried into that question rather than
% instead of it: an italic asked for by a serif name is answered by an
% italic, and by one of that kind.
/fs.serifital /XpostSerifZZ-Italic fs.face def
/fs.sansital  /XpostSansZZ-Italic  fs.face def

fs.serifital fs.serif ne
    (a name asking for an italic does not reach the upright face) assert
fs.serifital fs.sansital ne
    (an italic asked for by a serif name and one asked for by a sans name
     do not reach one face) assert

% ------------------------------------------------------------ read as words
%
% A word counts where it is the whole of a word. Sansom is not a sans,
% Serifina is not a serif and Monotype is not a monospace, and all three
% would be if the name were searched for the letters instead of split
% into the words it is written in. Each must reach what a name saying
% nothing reaches.
%
% Told apart only where this machine answers the three kinds with three
% faces: where its default is already the kind a trap would wrongly ask
% for, a trap that fired would look exactly like one that did not.
fs.serif fs.plain ne fs.mono fs.plain ne and {
    /XpostSerifinaZZ fs.face fs.plain eq
        (a serif-shaped word inside a longer word is not the word) assert
    /XpostMonotypeZZ fs.face fs.plain eq
        (a mono-shaped word inside a longer word is not the word) assert
    /XpostSansomZZ fs.face fs.plain eq
        (a sans-shaped word inside a longer word is not the word) assert
}{
    (SKIPPED: this host answers fewer than three kinds with three faces,)
      print ( so a trap that fired could not be seen) print (\n) print flush
} ifelse

% ------------------------------------------------- a name that says no kind
%
% A name whose words name no kind gets what the machine chose for it. The
% machine's own default is what a request carrying no family is entitled
% to reach, and a name that says nothing gives this build no ground to
% overrule it -- so two such names, with nothing in common but saying
% nothing, reach the same face.
/XpostQuiddityZZ fs.face fs.plain eq
    (a name naming no kind keeps the face the machine chose) assert

verdict
