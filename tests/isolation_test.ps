% Interpreter isolation regression, run through `xpost -d null` by
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% run-ps-test.sh; prints SUCCESS iff every assertion holds. The interpreter's
% internal helper procedures live in the private .xpostsys namespace, so:
%   (1) their names do not pollute the dictionaries a program sees -- a
%       program's `/.ravec where` is false, and
%   (2) a program may redefine any of those names for its own use without
%       disturbing the graphics machinery.
% The machinery is also required to survive a program shadowing the operator
% names its helper calls rely on (get, exec), which the helper-call form
% //.xpostsys /.h get exec only withstands because those references are frozen.

% capture userdict's size before this program defines anything: at startup it
% must be empty, every helper and every piece of machinery having been relocated
% into a private namespace or systemdict. (This program's own defs land here as
% it runs, so the check has to read the length first.)
userdict length /startupudlen exch def

/faildict 2 dict def
faildict /n 0 put
/assert { % bool (name) . -
    exch { pop } {
        (FAIL: ) print print (\n) print
        faildict /n 2 copy get 1 add put
    } ifelse
} bind def

% the graphics machinery must be loaded for its helpers to exist
gsave grestore

/HELPERS [
    % helper procedures
    /.gstatecopy /.ravec /.cpath /.dolinejoin /.ptdiff /.magang
    /.doclip /.hodgman-sutherland /.despike /.polyarea2 /.normclipwind /.p2abc
    /.evaluate /.rect /.dashpath /.minlinewidth /.crossdashbound /.dopending
    /.initial_ipos /.loadgraphics
    % private state dictionaries
    /DashDict /strokedict /SetColorDict /CurrentColorDict
] def

% the CLI file-runners keep the input on the operand stack, so a program run
% as `xpost prog.ps` sees neither name (this test is itself run that way,
% through startfilename)
[ /inputfilename /inputfile ] {
    where { pop false }{ true } ifelse (CLI runner leaves no variable) assert
} forall

% (1) none of the internal helper names are visible to a program
HELPERS {
    dup where { pop (STILL-VISIBLE: ) print == false }{ pop true } ifelse
    (internal helper name is hidden) assert
} forall

% exercise the machinery the helpers serve, as a baseline
{
    gsave
        0.4 setgray 8 setlinewidth 1 setlinejoin [6 3] 1 setdash
        newpath 20 20 moveto 180 120 lineto 60 190 lineto closepath stroke
        newpath 100 100 40 0 300 arc fill
        newpath 30 30 140 140 rectclip newpath 0 0 200 200 rectfill
    grestore
} stopped not (baseline graphics run cleanly) assert

% (2) redefine every helper name to a value of the program's own, then run the
% same graphics: the machinery must use its frozen helpers, not the program's
HELPERS { { (PROGRAM-OWNED) } def } forall
{
    gsave
        0.4 setgray 8 setlinewidth 1 setlinejoin [6 3] 1 setdash
        newpath 20 20 moveto 180 120 lineto 60 190 lineto closepath stroke
        newpath 100 100 40 0 300 arc fill
        newpath 30 30 140 140 rectclip newpath 0 0 200 200 rectfill
    grestore
} stopped not (graphics survive a program redefining every helper name) assert

% (3) the program's own definitions are intact and answer to the program
/.rect { (mine) } def
.rect (mine) eq (a program's own /.rect is its own) assert
/.ravec { 42 } def
.ravec 42 eq (a program's own /.ravec is its own) assert

% (4) survive the operator names a helper call depends on being shadowed
<< /get 1 /exec 2 /pop 3 /put 4 /known 5 /if 6 /ifelse 7 /forall 8 >> begin
{
    gsave
        6 setlinewidth [4 2] 0 setdash
        newpath 5 5 moveto 60 40 lineto 20 70 lineto closepath stroke fill
    grestore
} stopped not (graphics survive shadowed get/exec) assert
end

% Internals that were relocated out of systemdict into the private internaldict
% at lockdown: the =string pusher (.=stringproc) and the draw-line device flag
% (USEDRAWLINE), together with the arc guard (.pathempty) and run-error hook
% (.rundied). A program sees none of them, and the machinery reaches what it
% needs through frozen references -- the arc start procedure tests the current
% path through privatedict, and =string freezes in its scratch-string pusher --
% so both survive a program taking the names.
/SYSINTERNALS [ /.pathempty /.rundied /.=stringproc /USEDRAWLINE ] def
SYSINTERNALS {
    dup where { pop (SYSINTERNAL-VISIBLE: ) print == false }{ pop true } ifelse
    (relocated systemdict internal is hidden) assert
} forall
SYSINTERNALS { { (PROGRAM-OWNED) } def } forall
{
    newpath 100 100 40 0 360 arc            % builds its path through privatedict
    { pop pop }{ pop pop }{ pop pop pop pop pop pop }{ } pathforall
    42 =string cvs pop                       % =string operator pushes the scratch
} stopped not (arc and =string survive redefined internal names) assert

% The device makers (newPGMIMAGEdevice ...) moved out of systemdict into
% privatedict at lockdown: a program builds a device through the default device
% or the nulldevice operator, never by naming a maker, so the names are invisible
% and the nulldevice operator reaches its maker through privatedict, surviving a
% program taking the names.
/MAKERNAMES [ /newPGMIMAGEdevice /newPPMIMAGEdevice /newPBMIMAGEdevice
    /newTIFFIMAGEdevice /newnulldevice /newbboxdevice /newPDFWRITEdevice
    /newSVGWRITEdevice /newDSCWRITEdevice ] def
MAKERNAMES {
    dup where { pop (MAKER-VISIBLE: ) print == false }{ pop true } ifelse
    (device maker name is hidden) assert
} forall
MAKERNAMES { { (PROGRAM-OWNED) } def } forall
{
    gsave nulldevice newpath 0 0 moveto 10 10 lineto stroke grestore
} stopped not (nulldevice survives redefined maker names) assert

startupudlen 0 eq (userdict was empty at startup) assert

% The CIE converter family lives in the global .xpostsys and is baked into its
% callers (//.cie... exec), so the names are invisible to a program and a
% program redefining them cannot reach the colour machinery.
/CIENAMES [
    /.cieclamp /.ciexyzrgb /.cielmndev /.cieabcdev /.cieadev /.cietblpos
    /.cietblval /.ciedefdev /.ciedefgdev /.ciedev /.ciefams
    /.cierender /.crddefault /.crdget /.crdsame /.crdmul /.crdinv3
    /.crdpqr /.crdabc /.crdtable
] def
CIENAMES {
    dup where { pop (CIE-VISIBLE: ) print == false }{ pop true } ifelse
    (CIE converter name is hidden) assert
} forall
CIENAMES { { (PROGRAM-OWNED) } def } forall
{
    [ /CIEBasedABC <<
        /MatrixABC [ 0.9 0.1 0 0.1 0.8 0.1 0 0.2 0.9 ]
        /DecodeABC [ {dup mul} {dup mul} {dup mul} ]
        /MatrixLMN [ 0.4 0.2 0.02 0.35 0.7 0.12 0.18 0.1 0.95 ]
        /WhitePoint [ 0.9505 1.0 1.089 ]
    >> ] setcolorspace
    0.6 0.3 0.8 setcolor
    newpath 20 20 moveto 180 20 lineto 180 180 lineto closepath fill
} stopped not (CIE colour survives redefined converter names) assert

% The shading family lives in the global .xpostsys, baked into shfill and into
% each other, so the names are invisible and a program redefining them cannot
% reach the shading machinery (self-recursive members keep a frozen get form).
/SHADENAMES [
    /.fneval /.fneval2 /.fnsampled /.fnsample /.fnsamplebits /.fnsh /.shcolor /.clipbig /.axialsh /.radialsh
    /.mrdbits /.mrdalign /.mrdmore /.mrddec /.mrdpt /.mrdcolor
    /.mrdvertex /.mrdcoordbits /.mrdcompbits /.mrdflagbits /.gsetcolor
    /.gmid /.gtri /.tridepth /.tridepthcap /.meshsh /.bez1 /.pgridmap /.pmix /.patchpaint /.patchsh
] def
SHADENAMES {
    dup where { pop (SHADE-VISIBLE: ) print == false }{ pop true } ifelse
    (shading helper name is hidden) assert
} forall
SHADENAMES { { (PROGRAM-OWNED) } def } forall
{
    << /ShadingType 2 /ColorSpace /DeviceRGB /Coords [ 10 10 190 190 ]
       /Function << /FunctionType 3 /Domain [ 0 1 ]
         /Functions [ << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 1 0 0 ] /C1 [ 1 1 0 ] /N 1 >>
                      << /FunctionType 2 /Domain [ 0 1 ] /C0 [ 1 1 0 ] /C1 [ 0 0 1 ] /N 1 >> ]
         /Bounds [ 0.5 ] /Encode [ 0 1 0 1 ] >>
       /Extend [ true true ] >> shfill
} stopped not (shading survives redefined helper names) assert

% The pattern family lives in .xpostsys, reached across files by a frozen
% //.xpostsys reference, so redefining the names cannot disturb a pattern fill.
/PATNAMES [ /.patternactive /.patterntile /.patternclip /.patternfill /.patterneofill ] def
PATNAMES {
    dup where { pop (PAT-VISIBLE: ) print == false }{ pop true } ifelse
    (pattern helper name is hidden) assert
} forall
PATNAMES { { (PROGRAM-OWNED) } def } forall
{
    /Pattern setcolorspace
    << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [ 0 0 10 10 ]
       /XStep 10 /YStep 10 /PaintProc { pop 0 0 5 5 rectfill } >>
    matrix makepattern setpattern
    newpath 20 20 moveto 120 20 lineto 120 120 lineto closepath fill
} stopped not (pattern fill survives redefined helper names) assert

% The halftone/screen family lives in .xpostsys, so redefining the names
% cannot disturb screen or halftone setup (public ops reach it by frozen get).
/HTNAMES [ /.spreadgrayscreen /.samplespot /.gcd /.screenlattice
    /.installscreencell /.refreshscreencell /.ht5component /.htreadthresholds ] def
HTNAMES {
    dup where { pop (HT-VISIBLE: ) print == false }{ pop true } ifelse
    (halftone helper name is hidden) assert
} forall
HTNAMES { { (PROGRAM-OWNED) } def } forall
{
    60 45 { dup mul exch dup mul add 1 sqrt sub } setscreen
    << /HalftoneType 3 /Width 4 /Height 4
       /Thresholds <10305070 20406080 15355575 25456585> >> sethalftone
} stopped not (screen and halftone setup survive redefined helper names) assert

% scattered device/path/init helpers in .xpostsys
/SCATNAMES [ /.docap /.pfdict /.strcat /.pagefilename /.isupmat
    /.execformbox /.execformdirect /.upathargs /.upathops ] def
SCATNAMES {
    dup where { pop (SCAT-VISIBLE: ) print == false }{ pop true } ifelse
    (scattered helper name is hidden) assert
} forall
SCATNAMES { { (PROGRAM-OWNED) } def } forall
{
    1 setlinecap 8 setlinewidth
    newpath 10 10 moveto 100 100 lineto 180 20 lineto stroke
    gsave 200 200 translate
        << /FormType 1 /BBox [ 0 0 40 40 ] /Matrix matrix
           /PaintProc { pop 0 0 30 30 rectfill } >> execform
    grestore
    [ [ 0 0 100 100  10 10  90 90 ] <0001030a> ] ufill
} stopped not (stroke caps, execform and userpath survive redefined names) assert

% font/CID family (font.ps + cid.ps) now in .xpostsys
/FONTNAMES [ /.cmapnext /.cidface /.fmapnext /.fmapdesc /.showfmap /.showtype0
    /.cmapwalk /.cshmeasure /.cshsetfont /.cshbytecmap /.cidglyphshow
    /.runbuild /.t3capkeys
    /.t3build /.glyphbytes /.kshowshow /.rootsetfont
    /.charpathoutline /.charpathstroked ] def
FONTNAMES {
    dup where { pop (FONT-VISIBLE: ) print == false }{ pop true } ifelse
    (font helper name is hidden) assert
} forall
FONTNAMES { { (PROGRAM-OWNED) } def } forall
{
    /Helvetica findfont 12 scalefont setfont
    50 50 moveto (font test) show
    50 30 moveto { pop pop } (kshow) kshow
    /Times-Roman findfont 20 scalefont setfont 50 10 moveto (X) true charpath stroke
} stopped not (font show, kshow and charpath survive redefined names) assert

% the fill/image/stencil pipeline (paint.ps, clip.ps, path.ps) in the private namespaces
/PAINTNAMES [ /.applytransfer /.intest /.hairsegclip /.fill /.rownorm
    /.imgsource /.clipspans /.c255 /.sampleat /.imagepaintm /.imagepaint /.mcscale
    /.imagetype4 /.it1row /.it2row /.imagetype3 /.identdecode /.stencilcache
    /.stencilruns /.stencilmask /.setclipregion /.clipregionpoly /.clipmeet
    /.polytopath /.devpathforall ] def
PAINTNAMES {
    dup where { pop (PAINT-VISIBLE: ) print == false }{ pop true } ifelse
    (paint helper name is hidden) assert
} forall
PAINTNAMES { { (PROGRAM-OWNED) } def } forall
{
    1 0 0 setrgbcolor newpath 10 10 moveto 100 10 lineto 100 100 lineto closepath fill
    0 0 1 setrgbcolor newpath 20 20 moveto 80 20 lineto 50 90 lineto closepath eofill
    gsave 120 10 translate 40 40 scale
        << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8 /Decode [ 0 1 0 1 0 1 ]
           /ImageMatrix [ 2 0 0 -2 0 2 ] /DataSource <FF000000FF000000FFFFFF00> >> image
    grestore
    gsave 10 120 translate 40 40 scale 0 setgray
        << /ImageType 1 /Width 4 /Height 4 /BitsPerComponent 1 /Decode [ 0 1 ]
           /ImageMatrix [ 4 0 0 -4 0 4 ] /DataSource <A5A5> >> imagemask
    grestore
} stopped not (fill, image and imagemask survive redefined helper names) assert

% device switching through setpagedevice reaches its maker through
% privatedict too, surviving a program that has taken the maker names
{
    << /OutputDevice /bbox /PageSize [40 40] >> setpagedevice
    newpath 5 5 moveto 30 30 lineto 30 5 lineto closepath fill
    gsave nulldevice newpath 0 0 moveto 10 10 lineto stroke grestore
} stopped not (device switch and nulldevice survive redefined maker names) assert

count 0 eq (operand stack is balanced) assert
faildict /n get 0 eq { (SUCCESS\n) print } { faildict /n get =print ( failures\n) print } ifelse
flush
quit
