%!testlib
% Execution-context operators, run through
% `xpost -q --no-sandbox --enable-dps -d null` by run-ps-test.sh.
%
% fork, join, detach, yield and currentcontext are Display PostScript
% operators (PLRM 2nd ed 7.1), not standard base PostScript -- the 3rd
% edition moved them to the Display PostScript System manuals and defines
% no multiple-execution-context facility itself. xpost installs them only
% on the --enable-dps opt-in, so this suite is run with that flag; their
% behaviour where it reaches past the cited edition is pinned here.
%
% The interpreter schedules contexts cooperatively: a forked context runs
% until it yields, blocks on I/O, or returns from its top-level procedure,
% at which point the scheduler moves on. join runs the child and returns
% the operands it left; detach lets a context free itself when it finishes
% rather than wait to be joined.

/completes { % { proc }  -  bool
    stopped not
} def

% currentcontext yields the running context
currentcontext type /contexttype eq (currentcontext yields a context) assert
clear

% fork yields a context object
mark 2 3 { add } fork
dup type /contexttype eq (fork yields a context) assert
detach
clear

% detach accepts a forked context
{ mark { } fork detach } completes (detach accepts a forked context) assert
clear

% yield succeeds
{ yield } completes (yield succeeds) assert
clear

% fork runs the child and join returns the operands it left, beneath a mark
mark 2 3 { add } fork join
counttomark 1 eq { 5 eq }{ false } ifelse
    (fork then join returns the child's result) assert
cleartomark

% a forked context copies the parent's whole dictionary stack, so a name the
% parent defined in userdict is found by the child, and the dictionaries are
% shared, so a definition the child makes is seen by the parent
/parent_def 314 def
mark { parent_def } fork join
counttomark 1 eq { 314 eq }{ false } ifelse
    (a forked context inherits the parent's dictionary stack) assert
cleartomark
mark { /child_def 271 def } fork join cleartomark
/child_def where { pop child_def 271 eq }{ false } ifelse
    (a definition made in a forked context is shared with the parent) assert

% the font cache's per-glyph ceiling is private to a context too: PLRM 8.2
% setcachelimit says the parameter is maintained separately for each
% context. A forked context starts from the parent's, and what it sets is
% its own -- the parent goes on by the ceiling it set, which is what the
% cache goes by while the parent is the one executing.
/blim { cachestatus 7 array astore 6 get } def
/blim0 blim def
5000 setcachelimit
mark { blim } fork join
counttomark 1 eq { 5000 eq }{ false } ifelse
    (a forked context inherits the parent's per-glyph ceiling) assert
cleartomark
mark { 7777 setcachelimit blim } fork join
counttomark 1 eq { 7777 eq }{ false } ifelse
    (a forked context sets its own per-glyph ceiling) assert
cleartomark
blim 5000 eq
    (a forked context's ceiling does not reach the parent) assert
blim0 setcachelimit

% the graphics state, unlike VM, is private to a context: a forked context
% inherits the parent's but neither sees the other's later changes
2 setlinewidth
mark { currentlinewidth } fork join
counttomark 1 eq { 2.0 eq }{ false } ifelse
    (a forked context inherits the parent's graphics state) assert
cleartomark
2 setlinewidth
mark { 9 setlinewidth } fork join cleartomark
currentlinewidth 2.0 eq
    (a change to a forked context's graphics state does not reach the parent) assert

% the current path is part of that private graphics state, so a forked context
% builds its own: the child's path operators must not reach the parent's path.
% (Before this was fixed the path operators resolved a cached graphics state
% belonging to whichever context ran first, so every context shared one path.)
newpath 100 100 moveto
mark { newpath 500 500 moveto 600 600 lineto currentpoint } fork join
counttomark 2 eq { 600 eq exch 600 eq and }{ false } ifelse
    (a forked context builds its own current path) assert
cleartomark
currentpoint 100 eq exch 100 eq and
    (a forked context's current path does not disturb the parent's) assert
newpath

% the operands handed to a forked context are the ones above a mark, so a
% stack without one has no count to hand over: the operand on top is not
% the count, and the slots below the bottom of the stack are not operands
{ 5 { } fork } /unmatchedmark (fork without a mark is unmatchedmark) raises
{ { } fork } /unmatchedmark (fork of a bare stack is unmatchedmark) raises
clear

% an empty mark hands over nothing and still forks
{ mark { } fork detach } completes (fork of an empty mark succeeds) assert
clear

% join and detach type-check their operand
{ 42 join } /typecheck (join of a non-context is typecheck) raises
{ (str) detach } /typecheck (detach of a non-context is typecheck) raises

% repeated forks either all succeed or report; none may answer a context
% it did not create
/n 0 def
{ 40 { mark { } fork detach /n n 1 add store } repeat } stopped pop
n 0 gt (forks were performed) assert
clear

% a forked context that ends on an error reports it through handleerror and
% then terminates, so a later join of it is invalidcontext (PLRM 2nd ed 7.1: a
% forked procedure runs effectively as `proc stopped { handleerror quit } if`,
% and join of a context that did not run to a clean return is invalidcontext).
% The child's handleerror writes its report to the output as it must; the
% behaviour under test is join's answer. handleerror also clears the shared
% $error/newerror, which the parent's own raise-and-catch below relies on.
{ mark { 1 0 idiv } fork join } /invalidcontext
    (join of a context that ended on an error is invalidcontext) raises
clear

% a context identifier is equatable: it equals itself and differs from another
% context's, so a program can tell one context from another (PLRM 2nd ed 7.1:
% an identifier means the same in every context)
currentcontext currentcontext eq (a context identifier equals itself) assert
mark { } fork dup /c exch def currentcontext ne
    (a forked context's identifier differs from the parent's) assert
c detach
clear

% fork or join with a save the program has not matched by a restore is
% invalidcontext (PLRM 2nd ed 7.1)
save /svg1 exch def
{ mark { } fork } /invalidcontext
    (fork with an unmatched save is invalidcontext) raises
clear
svg1 restore
mark { } fork /svgctx exch def
save /svg2 exch def
{ svgctx join } /invalidcontext
    (join with an unmatched save is invalidcontext) raises
clear
svg2 restore
svgctx join cleartomark

% the synchronisation operators coordinate contexts through a shared lock and
% condition (PLRM 2nd ed 7.1). Scheduling is cooperative, so mutual exclusion
% between yields is inherent; these carry the wait/notify coordination.

% wait on a lock the context does not hold is invalidcontext
{ lock condition wait } /invalidcontext
    (wait on a lock not held is invalidcontext) raises
clear

% monitor of a lock the context already holds is invalidcontext, and the outer
% monitor still gives the lock back
/lk1 lock def
{ lk1 { lk1 { } monitor } monitor } /invalidcontext
    (monitor of a held lock is invalidcontext) raises
clear
lk1 /held get not (an invalidcontext leaves the lock free) assert

% monitor releases the lock when its procedure raises, and re-raises the error
/lk2 lock def
{ lk2 { 1 0 idiv } monitor } /undefinedresult
    (monitor re-raises its procedure's error) raises
clear
lk2 /held get not (monitor releases the lock on an error) assert

% monitor runs its procedure in the caller's dictionary, not a private one
/lk3 lock def
lk3 { /monvar 271 def } monitor
/monvar where { pop monvar 271 eq }{ false } ifelse
    (a monitor procedure defines in the caller's dictionary) assert

% a context waits on a condition until another notifies it: the consumer blocks
% until the producer sets the shared value and notifies
/mlk lock def /mcond condition def
/box 2 dict def box /ready false put box /v 0 put
mark {
    mlk { { box /ready get { exit }{ mlk mcond wait } ifelse } loop
          box /v get } monitor
} fork /mcons exch def
mark {
    mlk { box /v 55 put box /ready true put mcond notify } monitor
} fork /mprod exch def
mcons join counttomark 1 eq { 55 eq }{ false } ifelse
    (a context waits for another to notify a condition) assert
cleartomark
mprod join cleartomark

% the interpreter runs normally afterwards
1 2 add 3 eq (execution continues after the context operators) assert

verdict
