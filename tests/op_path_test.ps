%!testlib
% Path-construction operator compliance (PLRM 8.2), run through `xpost -d null` by
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% currentpoint tracks moveto/lineto and their relative forms; arc/arcn land their
% endpoints on the axes so the bounding box is exact.

/assertnear { 3 1 roll sub abs 1e-3 lt exch assert } def

% --- currentpoint tracks moveto / lineto / relative moves ---
initgraphics newpath 10 20 moveto currentpoint
20 (moveto y) assertnear 10 (moveto x) assertnear
initgraphics newpath 10 20 moveto 30 40 lineto currentpoint
40 (lineto y) assertnear 30 (lineto x) assertnear
initgraphics newpath 10 20 moveto 5 6 rmoveto currentpoint
26 (rmoveto y) assertnear 15 (rmoveto x) assertnear
initgraphics newpath 0 0 moveto 10 0 rlineto 0 10 rlineto currentpoint
10 (rlineto y) assertnear 10 (rlineto x) assertnear

% --- currentpoint with no current point is nocurrentpoint; likewise rlineto ---
{ initgraphics newpath currentpoint } /nocurrentpoint (currentpoint with no point) raises
{ initgraphics newpath 5 5 rlineto }  /nocurrentpoint (rlineto with no point) raises

% pathbbox pushes llx lly urx ury (ury on top) -- pop in that reverse order
/bbox4 { /ury exch def /urx exch def /lly exch def /llx exch def } def

% --- pathbbox over a triangle ---
initgraphics newpath 10 10 moveto 20 30 lineto 40 10 lineto pathbbox bbox4
llx 10 (pathbbox llx) assertnear  lly 10 (pathbbox lly) assertnear
urx 40 (pathbbox urx) assertnear  ury 30 (pathbbox ury) assertnear

% --- arc (0..90 deg, centre 50 50, r 20): box is exactly [50 50 70 70] ---
initgraphics newpath 50 50 20 0 90 arc pathbbox bbox4
llx 50 (arc bbox llx on centre x) assertnear  lly 50 (arc bbox lly on centre y) assertnear
urx 70 (arc bbox urx) assertnear  ury 70 (arc bbox ury) assertnear
% arcn (0..90 the other way, i.e. 0 down to -270) reaches left and below centre
initgraphics newpath 50 50 20 0 90 arcn pathbbox bbox4
llx 30 (arcn bbox llx) assertnear  ury 70 (arcn bbox ury) assertnear

% --- closepath returns to the subpath start ---
initgraphics newpath 3 4 moveto 20 4 lineto 20 20 lineto closepath currentpoint
4 (closepath returns to start y) assertnear 3 (closepath returns to start x) assertnear

% --- flattenpath keeps the curve's bounding box ---
initgraphics newpath 0 0 moveto 0 100 100 100 100 0 curveto flattenpath pathbbox bbox4
llx 0 (flattened curve llx) assertnear  urx 100 (flattened curve urx) assertnear

% --- pathbbox raises nocurrentpoint on an empty path; a bare moveto still has a box ---
{ initgraphics newpath pathbbox } /nocurrentpoint (pathbbox on an empty path is nocurrentpoint) raises
initgraphics newpath 3 4 moveto pathbbox bbox4
llx 3 (moveto-only bbox llx) assertnear  urx 3 (moveto-only bbox urx) assertnear
lly 4 (moveto-only bbox lly) assertnear  ury 4 (moveto-only bbox ury) assertnear

% --- upath describes a path, so there has to be one ---
{ initgraphics newpath false upath } /nocurrentpoint
    (upath on an empty path) raises
initgraphics newpath 10 10 moveto 20 20 lineto
false upath length 0 gt (upath of a path yields a userpath) assert

% --- setbbox takes four numbers (llx lly urx ury) ---
{ initgraphics newpath 12 24 36 48 setbbox } (setbbox accepts four numbers) works

% --- an encoded userpath's repeat count cannot drive unbounded work ---
% A repeat prefix precedes an operator to feed it one run of arguments
% several times; before an operator that takes no arguments -- closepath
% or ucache -- it would ask for that operator any number of times while
% consuming nothing, so it is refused rather than run.
{ [ [ ] [ 2147483647 11 ] ] uappend } /rangecheck
    (a repeat count on a no-argument userpath operator is refused) raises
{ [ [ ] [ 8000032 10 ] ] uappend } /rangecheck
    (a repeated closepath in a userpath is refused) raises
% a repeat before an operator that does take arguments is ordinary: two
% coordinate pairs fed through one lineto after a moveto
{ initgraphics newpath [ [10 10 40 40 70 10] [ 1 34 3 ] ] uappend }
    (a repeat count on an operator that takes arguments still works) works

% --- rcurveto: the three points are relative to the current point (PLRM 8.2) ---
% Each pair displaces from the current point, not from the point before it, so
% the curve rcurveto appends is the one curveto appends at the summed points.
initgraphics newpath 100 100 moveto 10 10 20 20 30 0 rcurveto
currentpoint exch 130 (rcurveto ends at the third displacement) assertnear
    100 (rcurveto's third displacement is relative to the start) assertnear

% the same curve written absolutely leaves the same path
initgraphics newpath 100 100 moveto 10 10 20 20 30 0 rcurveto
flattenpath pathbbox bbox4
/rllx llx def /rlly lly def /rurx urx def /rury ury def
initgraphics newpath 100 100 moveto 110 110 120 120 130 100 curveto
flattenpath pathbbox bbox4
llx rllx (rcurveto's box matches the absolute curve, llx) assertnear
lly rlly (rcurveto's box matches the absolute curve, lly) assertnear
urx rurx (rcurveto's box matches the absolute curve, urx) assertnear
ury rury (rcurveto's box matches the absolute curve, ury) assertnear

% it needs a current point to be relative to
{ initgraphics newpath 10 10 20 20 30 0 rcurveto } /nocurrentpoint
    (rcurveto without a current point is nocurrentpoint) raises

% rcurveto composes with the other relative operators
initgraphics newpath 0 0 moveto 50 0 rlineto 10 10 20 20 30 0 rcurveto
currentpoint exch 80 (rcurveto continues from where rlineto left off) assertnear
    0 (rcurveto keeps the y the displacements sum to) assertnear

% --- reversepath turns a path with a curve around ---
% The curve's control points exchange roles when the direction reverses, so a
% reversed path must still cover the ground the original covered.
initgraphics newpath 100 100 moveto 110 130 120 130 130 100 curveto
flattenpath pathbbox bbox4
/fllx llx def /flly lly def /furx urx def /fury ury def
initgraphics newpath 100 100 moveto 110 130 120 130 130 100 curveto
reversepath
currentpoint exch 100 (reversepath ends where the path began, x) assertnear
    100 (reversepath ends where the path began, y) assertnear
initgraphics newpath 100 100 moveto 110 130 120 130 130 100 curveto
reversepath flattenpath pathbbox bbox4
llx fllx (a reversed curve covers the same ground, llx) assertnear
lly flly (a reversed curve covers the same ground, lly) assertnear
urx furx (a reversed curve covers the same ground, urx) assertnear
ury fury (a reversed curve covers the same ground, ury) assertnear

% reversing twice restores the original direction
initgraphics newpath 100 100 moveto 110 130 120 130 130 100 curveto
reversepath reversepath
currentpoint exch 130 (reversing twice ends where the path ended, x) assertnear
    100 (reversing twice ends where the path ended, y) assertnear

verdict
