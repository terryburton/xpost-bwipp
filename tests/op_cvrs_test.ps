%!testlib
% cvrs at radix ten is cvs, reals keeping real syntax; at every other
% radix the value is truncated toward zero and rendered unsigned at the
% integer's own width, a negative number arriving as its
% two's-complement bit pattern. A real beyond what the integer holds, a
% radix outside 2..36 and a string the digits do not fit are refused
% with rangecheck. Run through `xpost -d null` by run-ps-test.sh.

/streq { 2 copy length exch length eq { eq } { pop pop false } ifelse } def
/cvrseq { 70 string cvrs exch streq } def

% the integer's width decides how many digits an unsigned rendering has
/wide 2147483647 1 add type /integertype eq def

% positive values, several radices
(0) 0 2 cvrseq (zero base two) assert
(101) 5 2 cvrseq (five base two) assert
(Z) 35 36 cvrseq (thirty-five base thirty-six) assert
(FF) 255 16 cvrseq (two five five base sixteen) assert
(777) 511 8 cvrseq (five one one base eight) assert

% radix ten is cvs
(-5) -5 10 cvrseq (negative integer base ten) assert
(42) 42 10 cvrseq (integer base ten) assert
(3.7) 3.7 10 cvrseq (real base ten keeps real syntax) assert
(-3.7) -3.7 10 cvrseq (negative real base ten) assert

% negative values render as the unsigned bit pattern of the build's
% integer width
wide { (FFFFFFFFFFFFFFFF) } { (FFFFFFFF) } ifelse
    -1 16 cvrseq (minus one base sixteen) assert
wide { (FFFFFFFFFFFFFFFB) } { (FFFFFFFB) } ifelse
    -5 16 cvrseq (minus five base sixteen) assert
wide { (FFFFFFFF80000000) } { (80000000) } ifelse
    -2147483648 16 cvrseq (most negative narrow integer) assert
-1 2 70 string cvrs length
    wide { 64 } { 32 } ifelse eq (minus one base two, one digit per bit) assert

% a real at another radix truncates toward zero first
(3) 3.7 16 cvrseq (real truncates toward zero) assert
(2) 2.9 16 cvrseq (real truncates below three) assert
wide { (FFFFFFFFFFFFFFFD) } { (FFFFFFFD) } ifelse
    -3.7 16 cvrseq (negative real truncates toward zero) assert

% the refusals
{ 1e30 16 70 string cvrs } /rangecheck (real beyond the integer) raises
{ 5 1 70 string cvrs } /rangecheck (radix below two) raises
{ 5 37 70 string cvrs } /rangecheck (radix above thirty-six) raises
{ 255 16 1 string cvrs } /rangecheck (string the digits do not fit) raises
{ 5 16 70 string readonly cvrs } /invalidaccess (read-only string) raises

% the answer aliases the front of the caller's string: a write through
% the result shows in the argument
70 string dup 255 16 3 -1 roll cvrs
dup 0 65 put pop
0 get 65 eq (result aliases the argument) assert

verdict
