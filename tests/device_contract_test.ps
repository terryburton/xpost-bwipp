% Device method contract: every device must accept the boundary inputs
% its methods can legally receive -- degenerate, inverted and
% out-of-range rectangles, edge and out-of-bounds pixels, real-valued
% coordinates -- without error, and still emit a page. Run against a
% live device (-d <dev>) by run-device-contract-test.sh.
%
% The safety tier below asks only that nothing errors. The behaviour
% tier after it asks what was painted, and so runs only on a device
% whose GetPix reports back what a marking method wrote; a device that
% keeps its raster somewhere this test cannot see announces itself by
% failing the readback probe and takes the safety tier alone.

/dev .privatedict /.graphicsdict get /currgstate get /device get def

% The tag is put away before the procedure runs, and the stack is taken
% back to the depth the procedure was handed: a procedure that fails may
% leave anything at all behind, and a report reading its own operands
% from there reports the leavings instead of the tag.
/try { % proc (name)  .  -
    /t.tag exch def
    /t.depth count 2 sub def
    stopped {
        % the error's name goes in the report: a failure seen once, on a
        % machine that is not to hand, is diagnosable only from what the
        % report carried
        (FAIL: ) print t.tag print ( errored: ) print
        $error /errorname known { $error /errorname get } { /unknown } ifelse
        dup type /nametype eq { 128 string cvs } { pop (unknown) } ifelse print
        (\n) print
        /contractfail true def
    } if
    count t.depth sub dup 0 gt { { pop } repeat }{ pop } ifelse
} def
/assert { % bool (name)  .  -
    exch { pop }{
        (FAIL: ) print print (\n) print
        /contractfail true def
    } ifelse
} def
/contractfail false def

% the colour a method takes is the device's native colourspace, one
% number per component; /val pushes black in that space
/ncomp dev /nativecolorspace 2 copy known
    { get /DeviceRGB eq { 3 }{ 1 } ifelse }{ pop pop 1 } ifelse def
/val { ncomp { 0 } repeat } def
/white { ncomp { 1 } repeat } def
/black { ncomp { 0 } repeat } def

% each marking method reached the one way, with the device supplied
/fillrect { dev dup /FillRect get exec } def
/putpix   { dev dup /PutPix   get exec } def
/drawline { dev dup /DrawLine get exec } def
/getpix   { dev dup /GetPix   get exec } def
/fillpoly { dev dup /FillPoly get exec } def
/drawrect { dev dup /DrawRect get exec } def

% --- what the class copy put on the instance -------------------------
% An instance is a copy of its class dictionary made by .copydict, which
% also records the dimensions the device adopted and the output file
% name in force. Every class needs the same copy: one that leaves the
% file name off produces a device that writes wherever its Emit
% defaults to, whatever the program asked for.
dev /dimensions known (the instance records its dimensions) assert
/OutputFileName where {
    pop dev /OutputFileName known
        (the instance carries the output file name) assert
} if

% a painted baseline so Emit has marks to write
newpath 10 10 moveto 90 90 lineto stroke

% --- FillRect boundary inputs (val x y w h DEVICE FillRect) ---
% the raster classes take val as the device's native colour; probe the
% method only when the device carries it
dev /FillRect known {
    { val 5 5 0 0 fillrect }          (zero-size FillRect) try
    { val 5 5 1 1 fillrect }          (unit FillRect) try
    { val -20 -20 10 10 fillrect }    (negative-origin FillRect) try
    { val 5000 5000 50 50 fillrect }  (out-of-range FillRect) try
    { val 50.5 60.25 10.75 3.5 fillrect } (fractional FillRect) try
    { val 80 80 -30 -30 fillrect }    (negative-extent FillRect) try
} if

% --- PutPix boundary inputs (val x y DEVICE PutPix) ---
dev /PutPix known {
    { val 0 0 putpix }        (origin PutPix) try
    { val -1 -1 putpix }      (negative PutPix) try
    { val 9999 9999 putpix }  (out-of-range PutPix) try
    { val 3.7 4.2 putpix }    (fractional PutPix) try
} if

% --- DrawLine boundary inputs (val x1 y1 x2 y2 DEVICE DrawLine) ---
% The last four are segments sized by the program rather than by the
% page. A device walks the line one pixel per step of its major axis and
% drops the steps that miss it, so a walk held to the segment costs what
% was drawn rather than what can be marked: two billion steps for the
% hundred that land, minutes of it, and no way to interrupt it. Held to
% the device, each costs the device. Asked along both axes and in both
% directions, since either end of the walk is the one that can run away,
% and asked of every device, since the extent a walk is held to is the
% device's own and each drops the misses for itself.
dev /DrawLine known {
    { val 5 5 5 5 drawline }            (degenerate DrawLine) try
    { val -50 -50 5000 5000 drawline }  (clipped DrawLine) try
    { val -2e9 0 2e9 10 drawline }      (far-off DrawLine) try
    { val 2e9 10 -2e9 0 drawline }      (far-off DrawLine reversed) try
    { val 0 -2e9 10 2e9 drawline }      (far-off steep DrawLine) try
    { val 10 2e9 0 -2e9 drawline }      (far-off steep DrawLine reversed) try
} if

% --- DrawRect boundary inputs (val x y w h DEVICE DrawRect) ---
dev /DrawRect known {
    { val 5 5 0 0 drawrect }          (zero-size DrawRect) try
    { val 5 5 1 1 drawrect }          (unit DrawRect) try
    { val -20 -20 10 10 drawrect }    (negative-origin DrawRect) try
    { val 5000 5000 50 50 drawrect }  (out-of-range DrawRect) try
    { val 50.5 60.25 10.75 3.5 drawrect } (fractional DrawRect) try
    { val 80 80 -30 -30 drawrect }    (negative-extent DrawRect) try
} if

% --- FillPoly boundary inputs (val polygon DEVICE FillPoly) ---
% A polygon is an array of [x y] pairs. Fewer than three enclose no
% area, and a fill of them marks nothing rather than refusing; the
% coordinates are subject to the same range and realness as any other
% marking method's.
dev /FillPoly known {
    { val [ ] fillpoly }                        (empty FillPoly) try
    { val [ [10 10] ] fillpoly }                (one-point FillPoly) try
    { val [ [10 10] [20 20] ] fillpoly }        (two-point FillPoly) try
    { val [ [10 10] [10 10] [10 10] ] fillpoly } (degenerate FillPoly) try
    { val [ [-40 -40] [5000 -40] [5000 5000] [-40 5000] ] fillpoly }
        (out-of-range FillPoly) try
    { val [ [10.5 10.25] [20.75 10.25] [15.5 20.5] ] fillpoly }
        (fractional FillPoly) try
    { val [ [10 10] [30 30] [30 10] [10 30] ] fillpoly }
        (self-intersecting FillPoly) try
} if

% --- GetPix boundary inputs (x y DEVICE GetPix -> c1..cN) ---
% A method the class dictionary offers has to work. Every device copies
% a class whose GetPix reads the base class's raster, so a device
% keeping its raster elsewhere must bring its own or the name answers
% undefined -- present, callable, and broken, which no probe with
% `known` can tell from working.
%
% A read is answered wherever a mark may be aimed. PutPix drops a mark
% that lands off the page rather than refusing it, so a read from off
% the page is answered rather than refused: the slot is the whole of
% what a caller has to ask a device with, and a pixel it will not answer
% for is one the caller cannot ask about at all.
dev /GetPix known {
    { 5 5 getpix ncomp { pop } repeat }      (GetPix answers) try
    { 3.7 4.2 getpix ncomp { pop } repeat }  (fractional GetPix) try
    { -1 -1 getpix ncomp { pop } repeat }    (GetPix before the page) try
    { 5000 5000 getpix ncomp { pop } repeat } (GetPix past the page) try
    { -0.5 -0.5 getpix ncomp { pop } repeat }
        (fractional GetPix before the page) try
} if

% the standard operators must equally survive boundary geometry
{ newpath -100 -100 moveto 10000 10000 lineto stroke } (off-page stroke) try
{ -50 -50 20 20 rectfill }                             (off-page rectfill) try
{ 0 0 0 0 rectfill }                                   (zero rectfill) try
{ newpath 306 396 0 0 360 arc fill }                   (zero-radius arc fill) try

% --- behaviour tier: what a marking method paints -------------------
%
% Reachable only where the device reports its own pixels back. The
% probe writes white and black through PutPix and reads each back: a
% device whose GetPix answers the same both times (or answers nothing,
% or errors) cannot witness anything below, and says so.

/samepix { % a1..aN b1..bN  .  bool
    ncomp array astore /sp.b exch def
    ncomp array astore /sp.a exch def
    true 0 1 ncomp 1 sub {
        /sp.i exch def
        sp.a sp.i get sp.b sp.i get eq and
    } for
} def

% A read, and the comparison of two of them. Both tiers below read
% pixels: one asserts what a marking method left on the raster, the
% other that a device holding no raster answers the ground.
%
% A read that refuses answers no components rather than ending the run,
% so that which read a device refuses is the diagnosis.
/readpix { % x y  .  [c1..cN] or [ ]
    % the depth the read is handed, taken before the name of the place
    % it is kept is pushed, so a read that fails is unwound to where it
    % started whatever it left behind
    count 2 sub /rp.depth exch def
    { getpix ncomp array astore } stopped {
        count rp.depth sub dup 0 gt { { pop } repeat }{ pop } ifelse
        [ ]
    } if
} def
/eqpix { % [a] [b]  .  bool
    2 copy length exch length eq {
        true 0 1 3 index length 1 sub {
            3 index 1 index get 3 index 3 -1 roll get eq and
        } for 3 1 roll pop pop
    }{ pop pop false } ifelse
} def

/readable false def
dev /GetPix known dev /PutPix known and {
    /rb.depth count def
    { white 1 1 putpix  1 1 getpix  black 1 1 putpix  1 1 getpix
      samepix not } stopped
    { % the probe could not finish -- a GetPix that errors or answers
      % nothing leaves the raster unreadable, and readable stays false
    }{
        /readable exch def
    } ifelse
    % a probe that stopped may have left anything behind; take the
    % stack back to the depth it was handed
    count rb.depth sub dup 0 gt { { pop } repeat }{ pop } ifelse
} if

readable {
    (READBACK\n) print

    % --- what the page shows where it holds no pixel ----------------
    %
    % Off the page there is nothing to hold a pixel, and a mark aimed
    % there is dropped, so what a read answers there is the page's
    % ground: the colour erasepage left, which is what every pixel of
    % the page the job never covers shows.
    %
    % The ground is read off the device rather than named here. PLRM 8.2
    % erases the page to grey 1.0, and what that colour comes to is the
    % transfer function's answer in the device's own colour space and
    % channel scale, none of which this test knows. A page just cleared
    % carries it, so a pixel of one stands for it.
    %
    % Which pixel is not free. A device that screens what it stores
    % leaves a grey as a pattern repeating over a cell that tiles the
    % device plane, so what the page carries changes from pixel to pixel
    % and two readings are comparable only at the same place in that
    % cell. Positions a whole number of cells apart are the same place in
    % it, on the page or off it, so the readings below are taken that way
    % round; a device that stores what it is handed tiles the plane with
    % a single pixel and any two positions are alike.
    %
    % A read that refuses answers no components, and every check below
    % reports for itself rather than ending the run on the first of
    % them: which read a device refuses is the diagnosis. readpix and
    % eqpix are defined above, because the tier after this one reads
    % pixels too.

    % the cell the device tiles the plane with, and a pixel of the page
    % with the positions a whole number of cells before and past it
    /cellw dev /.htw 2 copy known { get }{ pop pop 1 } ifelse def
    /cellh dev /.hth 2 copy known { get }{ pop pop 1 } ifelse def
    cellw type /integertype ne { /cellw 1 def } if
    cellh type /integertype ne { /cellh 1 def } if
    cellw 1 lt { /cellw 1 def } if
    cellh 1 lt { /cellh 1 def } if
    /gr.x 2 def
    /gr.y 2 def
    /gr.beforex gr.x cellw 8 mul sub def
    /gr.beforey gr.y cellh 8 mul sub def
    /gr.pastx gr.x cellw 5000 mul add def
    /gr.pasty gr.y cellh 5000 mul add def

    erasepage
    /gr.page gr.x gr.y readpix def
    /gr.before gr.beforex gr.beforey readpix def
    /gr.past gr.pastx gr.pasty readpix def
    gr.page length ncomp eq (the page's ground is readable) assert
    gr.before length ncomp eq (a pixel before the page is answered) assert
    gr.past length ncomp eq (a pixel past the page is answered) assert
    gr.page gr.before eqpix
        (a pixel before the page reads as the ground) assert
    gr.page gr.past eqpix
        (a pixel past the page reads as the ground) assert

    % And it is the ground this page was cleared to, not a value the
    % device carries: cleared through a transfer function that is not
    % the identity, a device answering white regardless is caught.
    %
    % A device that screens what it stores is held to this as any other
    % is. What it leaves for the cleared page is a pattern, but the
    % pattern is the page's, and the pixel off the page is read at the
    % same place in the cell as the pixel on it, where the page carries
    % one value and the device owes that one.
    gsave { 0.35 mul 0.2 add } settransfer erasepage grestore
    /gr.page gr.x gr.y readpix def
    /gr.before gr.beforex gr.beforey readpix def
    gr.page length ncomp eq
        (a page cleared through a transfer function is readable) assert
    gr.page gr.before eqpix
        (the ground read off the page is the ground it was cleared to) assert

    % A coordinate names the pixel it falls in, off the page as on it. A
    % read a fraction inside a pixel is a read of that pixel and answers
    % what it shows, not what the pixel the fraction rounds towards
    % shows: on a device that screens, those are two different answers.
    /gr.frac gr.beforex 0.5 add gr.beforey 0.5 add readpix def
    gr.frac gr.before eqpix
        (a fractional coordinate off the page reads as its own pixel) assert

    % the page was cleared to take those readings; the baseline mark is
    % laid again so Emit has one to write
    erasepage
    newpath 10 10 moveto 90 90 lineto stroke

    % A component outside [0,1] is clamped, not folded. Unclamped, the
    % scale wraps the stored channel: 1.7 lands as 0.69 and -0.7 as
    % 0.31, so the ink comes out a different colour rather than the
    % nearest one. Stated without naming the device's own scale: the
    % out-of-range paint must read back as the in-range extreme does.
    ncomp { 1 } repeat 3 3 putpix  3 3 getpix
    ncomp { 1.7 } repeat 4 3 putpix  4 3 getpix
    samepix (PutPix clamps a component above the range) assert

    ncomp { 0 } repeat 5 3 putpix  5 3 getpix
    ncomp { -0.7 } repeat 6 3 putpix  6 3 getpix
    samepix (PutPix clamps a component below the range) assert

    dev /FillRect known {
        ncomp { 1 } repeat 3 5 0 0 fillrect  3 5 getpix
        ncomp { 1.7 } repeat 4 5 0 0 fillrect  4 5 getpix
        samepix (FillRect clamps a component above the range) assert

        ncomp { 0 } repeat 5 5 0 0 fillrect  5 5 getpix
        ncomp { -0.7 } repeat 6 5 0 0 fillrect  6 5 getpix
        samepix (FillRect clamps a component below the range) assert
    } if

    dev /DrawLine known {
        ncomp { 1 } repeat 3 7 3 7 drawline  3 7 getpix
        ncomp { 1.7 } repeat 4 7 4 7 drawline  4 7 getpix
        samepix (DrawLine clamps a component above the range) assert
    } if

    % --- one page, whichever method painted it ----------------------
    % A device paints through the methods its class writes or through the
    % compiled ones its raster shape allows, and one pixel must come out
    % the same either way. A class that screens what it stores screens in
    % both, off the one cell at the one position, or the page comes out
    % in two patterns according to which method laid which part of it.
    % Only a colour between the extremes can tell the two apart, and it
    % is asked at two neighbouring pixels, which a screen need not answer
    % alike.
    dev /FillRect known {
        ncomp { 0.55 } repeat 8 8 putpix        8 8 getpix
        ncomp { 0.55 } repeat 8 8 0 0 fillrect  8 8 getpix
        samepix (PutPix and FillRect leave a pixel alike) assert

        ncomp { 0.55 } repeat 9 8 putpix        9 8 getpix
        ncomp { 0.55 } repeat 9 8 0 0 fillrect  9 8 getpix
        samepix (PutPix and FillRect leave its neighbour alike) assert
    } if

    % --- which pixels a marking method paints -----------------------
    % One definition, so it can be stated here once and asked of every
    % device. Each check clears its patch to black first and asks
    % whether a given pixel came out white, so it reads as the picture.

    /clear4 { % x y w h  .  -   paint the patch black
        /c4h exch def /c4w exch def /c4y exch def /c4x exch def
        black c4x c4y c4w c4h fillrect
    } def
    /white? { % x y  .  bool
        getpix ncomp array astore /wp exch def
        true 0 1 ncomp 1 sub { wp exch get 0 ne and } for
    } def

    dev /FillRect known {
        % a rectangle's far corner is inclusive: w+1 columns, h+1 rows
        20 20 6 6 clear4
        white 21 21 2 1 fillrect
        21 21 white? 22 21 white? and 23 21 white? and
            (FillRect paints w+1 columns) assert
        21 22 white? 22 22 white? and 23 22 white? and
            (FillRect paints h+1 rows) assert
        24 21 white? not (FillRect stops after the far column) assert
        21 23 white? not (FillRect stops after the far row) assert

        % a zero extent is one pixel, not none
        30 30 4 4 clear4
        white 31 31 0 0 fillrect
        31 31 white? (a zero-extent FillRect paints one pixel) assert
        32 31 white? not (a zero-extent FillRect paints only that one) assert

        % a negative extent reflects the rectangle through its origin
        40 40 8 8 clear4
        white 45 45 -2 -2 fillrect
        43 43 white? 45 45 white? and
            (a negative extent spans x-|w|..x) assert
        46 45 white? not (a negative extent stops at the origin) assert

        % a real coordinate names the pixel containing it
        50 50 6 6 clear4
        white 51.5 51.25 1 1 fillrect
        51 51 white? 52 52 white? and
            (a fractional origin lands in its own pixel) assert
    } if

    dev /DrawLine known {
        % the pixels whose centres the segment covers: a run from a to b
        % covers a..b-1, so two segments meeting at b abut exactly
        60 60 8 2 clear4
        white 61 61 65 61 drawline
        61 61 white? 64 61 white? and (DrawLine covers the near pixels) assert
        65 61 white? not (DrawLine stops before the far endpoint) assert

        % drawn the other way it covers the same pixels
        60 63 8 2 clear4
        white 65 64 61 64 drawline
        61 64 white? 64 64 white? and
            (a reversed DrawLine covers the same pixels) assert
        65 64 white? not (a reversed DrawLine stops at the same place) assert

        % and a degenerate segment still marks one pixel
        70 70 4 4 clear4
        white 71 71 71 71 drawline
        71 71 white? (a degenerate DrawLine marks its pixel) assert
    } if

    dev /DrawRect known {
        % the outline of the rectangle FillRect would fill: the same
        % inclusive far corner, and nothing inside it
        80 80 12 10 clear4
        white 81 81 8 6 drawrect
        81 81 white? 89 81 white? and 81 87 white? and 89 87 white? and
            (DrawRect marks all four corners) assert
        85 81 white? 85 87 white? and 81 84 white? and 89 84 white? and
            (DrawRect marks the four sides) assert
        85 84 white? not (DrawRect leaves the inside unmarked) assert
        90 84 white? not (DrawRect stops after the far column) assert
        85 88 white? not (DrawRect stops after the far row) assert
    } if

    dev /FillPoly known {
        % the polygon's own area, not its bounding box: a right triangle
        % has one corner of that box outside it, and a fill that marked
        % the box would be a square
        100 100 24 24 clear4
        white [ [102 102] [118 102] [118 118] [102 118] ] fillpoly
        110 110 white? (FillPoly marks the inside of a square) assert
        101 110 white? not (FillPoly stops at the near edge) assert
        119 110 white? not (FillPoly stops at the far edge) assert

        130 100 24 24 clear4
        white [ [132 102] [148 102] [132 118] ] fillpoly
        134 104 white? (FillPoly marks the inside of a triangle) assert
        146 116 white? not (FillPoly leaves the corner the triangle cuts off) assert

        % a polygon standing on one point covers no pixel, rather than
        % refusing or marking the point
        160 100 12 12 clear4
        white [ [166 106] [166 106] [166 106] ] fillpoly
        166 106 white? not (a polygon of one point marks nothing) assert
    } if
} if

% --- what a device that retains marks answers a read -----------------
%
% The tier above needs a device that holds pixels. A device that keeps
% the marks a page made rather than the pixels they cover holds none,
% and the contract has such a device answer a read with the page's
% ground -- the colour erasepage left -- wherever it holds no pixel,
% which for this one is everywhere. That is an answer and not a refusal,
% and it is the same answer after a mark as before it, because the mark
% went into the record rather than onto a raster.
%
% So the device is not merely excused the tier above: what it does
% answer is asserted here. A device that began answering something else
% -- the ink it was handed, or nothing at all -- would otherwise read
% exactly like one that had gone quiet for a reason.
%
% Which kind of device is in hand is asked of the interpreter rather
% than read off a method the device happens to carry. The smallest band
% there is is asked for and currentsystemparams is read back: a device
% that paints holds its page whole whatever budget is set on it, and one
% playing a record into a painter holds it in bands. The budget is put
% back afterwards, so the asking changes nothing.
/retains? {
    2 dict begin
    /rt.had dev /.bandbytes known def
    /rt.was rt.had { dev /.bandbytes get }{ 0 } ifelse def
    dev /.bandbytes 1 put
    currentsystemparams /CurBandHeight get 0 gt
    rt.had { dev /.bandbytes rt.was put }
           { dev /.bandbytes undef } ifelse
    end
} def

retains? {
    (GROUNDBACK\n) print
    dev /GetPix known (a device retaining marks answers a read) assert
    dev /GetPix known {
        erasepage
        /rt.page 4 4 readpix def
        rt.page length ncomp eq
            (a device retaining marks answers every component) assert

        % off the page and on it read alike: the device holds no pixel
        % of either, so both are the ground
        /rt.off -8 -8 readpix def
        rt.page rt.off eqpix
            (a pixel off the page reads as one on it) assert

        % and a mark changes neither. The mark is made through every
        % method the device carries, because a device answering the ink
        % for one of them and the ground for the rest would pass a check
        % that asked about one.
        black 4 4 putpix
        dev /FillRect known { black 4 4 8 8 fillrect } if
        dev /DrawLine known { black 4 4 12 12 drawline } if
        /rt.marked 4 4 readpix def
        rt.page rt.marked eqpix
            (a mark leaves a retained page reading as the ground) assert

        % the ground it answers is the one the page was cleared to, not
        % a value the device carries: cleared through a transfer
        % function that is not the identity, a device answering white
        % regardless is caught
        gsave { 0.35 mul 0.2 add } settransfer erasepage grestore
        /rt.other 4 4 readpix def
        rt.other length ncomp eq
            (a retained page cleared through a transfer function reads)
            assert
        rt.other rt.page eqpix not
            (the ground a retained page answers is the one it was cleared to)
            assert
    } if
} if

showpage

% --- the device is reachable by the name it was selected with --------
%
% -d and setpagedevice are two spellings of one selection, so a device
% the interpreter started with has to be one setpagedevice can make.
% Where it is not, the failure is not confined to switching devices: a
% request that names no device at all defaults to the running one, so
% every setpagedevice call raises rangecheck, and the page cannot even
% be resized. Runs last, because it retires the device the tier above
% painted on.
{ << /PageSize [200 200] >> setpagedevice }
    (the running device accepts a page-device request) try

% --- and it was completed the same way -------------------------------
%
% A freshly created device is finished off before it is installed: the
% page's default matrix, the compiled rasterisers its raster shape can
% take, the process colour model it was asked for. The device the
% interpreter starts with and the device setpagedevice makes take that
% same finishing, or the same device behaves differently according to
% how it was selected. Compare the two, slot by slot.

/newdev .privatedict /.graphicsdict get /currgstate get /device get def
/slotsame { % /key (what)  .  -
    /csw exch def /csk exch def
    dev csk known newdev csk known eq
    dev csk known newdev csk known and {
        dev csk get type newdev csk get type eq and
    } if
    csw assert
} def
newdev dev ne {
    /FillPoly (both devices complete FillPoly the same way) slotsame
    /FillRect (both devices complete FillRect the same way) slotsame
    /nativecolorspace
        (both devices settle on the same native colour space) slotsame
    /defaultmatrix (both devices carry a default matrix) slotsame
    /BlendPix (both devices agree on the coverage blender) slotsame
    % the default matrix is the page's, so its shape is fixed even
    % though the page size just changed
    dev /defaultmatrix known newdev /defaultmatrix known and {
        dev /defaultmatrix get length newdev /defaultmatrix get length eq
            (both default matrices have six entries) assert
        dev /defaultmatrix get 1 get 0 eq
        newdev /defaultmatrix get 1 get 0 eq and
            (both default matrices are unskewed) assert
        dev /defaultmatrix get 0 get 0 gt
        newdev /defaultmatrix get 0 get 0 gt and
            (both default matrices scale x forwards) assert
        dev /defaultmatrix get 3 get 0 lt
        newdev /defaultmatrix get 3 get 0 lt and
            (both default matrices flip y) assert
    } if
} if

% --- the page that device came with ----------------------------------
%
% Nothing has painted on this instance, so what its pixels hold is what
% its Create left there. A device that hands out its buffer unwritten
% starts the job on whatever the allocator last held, and every pixel
% the job never covers is emitted as that. The device the interpreter
% started with is erased before the job runs and so cannot witness
% this; an instance setpagedevice made is never erased, and can.
%
% Stated against a pixel painted white on the same instance, so the
% device's own scale is never named. (40,20) and (41,20) are inside the
% new page and nothing above has painted on it.

newdev dev ne readable and {
    /newgetpix { newdev dup /GetPix get exec } def
    /newputpix { newdev dup /PutPix get exec } def
    newdev /GetPix known newdev /PutPix known and {
        /bp.depth count def
        { 40 20 newgetpix ncomp array astore
          white 41 20 newputpix
          41 20 newgetpix ncomp array astore } stopped
        { % this instance cannot answer; nothing to compare
          count bp.depth sub dup 0 gt { { pop } repeat }{ pop } ifelse
        }{
            /bp.white exch def
            /bp.untouched exch def
            bp.untouched aload pop
            bp.white aload pop
            samepix (an unpainted page is blank) assert
        } ifelse
    } if
} if

% A device is not made by writing to the class it is made from. A class
% is a declaration every instance of it shares; a page's geometry
% belongs to the instance that adopted it, and a class left carrying it
% is a class this run has written to -- which is both a class that
% cannot be sealed and a page size the next device made would inherit
% without being asked.
/geomclean true def
.privatedict {
    exch pop
    dup type /dicttype eq {
        dup /Create known {
            dup /width known 1 index /height known or
                { /geomclean false def } if
        } if
    } if
    pop
} forall
geomclean (no device class carries a page's geometry) assert

contractfail { (FAILURES\n) print }{ (SUCCESS\n) print } ifelse
