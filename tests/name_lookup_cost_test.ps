%!testlib
% What resolving a name costs the work that resolves one, run through
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% A name is interned in a ternary search tree, and offering a string to
% the name mechanism walks that tree whether or not the string is
% already a name there. There are two banks, local and global, and the
% local one is searched first, so a name that lives in the global bank
% costs a walk that misses and then a walk that hits: resolving one is
% never free and is dearest for exactly the names the interpreter itself
% installs.
%
% That makes a name resolved from a C string a cost, and where it is
% paid decides whether it is a cost at all. Paid once, when the
% operators are installed, it is nothing. Paid inside a loop that runs
% once per unit of work -- once per span of a fill, once per row of a
% page -- it is the tree walk multiplied by the size of the page, and it
% does not show on a small one.
%
% So the assertion is a count of lookups and not a time: the interpreter
% carries the count itself, and a bound stated in lookups survives a
% loaded machine, which a bound stated in seconds does not. The two arms
% do the same work over a hundred and four hundred rectangles, and what
% the second costs may not be four times what the first does -- that is
% the whole property, and it is what the count can say and a wall clock
% cannot.

% A check that names which member of a family failed rather than only
% that one did, recorded through the framework's own counters.
/assertn { % bool (label) (name)  .  -
    /nm exch def /lb exch def
    { }{ (FAIL: ) print lb print nm print (\n) print
         /failcount failcount 1 add store } ifelse
    /checkcount checkcount 1 add store
} def

/.namelookups 1183615869 internaldict /.namelookups get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def

/SMALL 100 def
/LARGE 400 def

% The lookups a run of rectangle fills may cost between its arms. The
% names the fill needs are resolved when the device operators are
% installed, so a fill resolves none; what this leaves room for is the
% measurement itself, which runs a procedure and reads a counter. A
% lookup charged per rectangle lands three hundred above this on the
% larger arm, not a few.
/SLACK 16 def

% The raster a compiled rectangle fill writes: the array of row strings
% the grey base classes keep a page in. Four rows is enough -- what is
% being counted is the calls, not the pixels.
/mkdev { 2 dict dup /ImgData [ 4 { 64 string } repeat ] put } def

% Fill one row-wide rectangle n times, answering the name lookups it
% took. The rectangle is the whole of a row, so every call reaches the
% row and writes it; a call clipped away would reach less of the fill
% than a real span does.
/measure { % int  .  int
    /n exch def
    /dev mkdev def
    .namelookups
    1 1 n { pop 0.5 0 0 63 0 dev .fillrectgray } for
    .namelookups exch sub
} def

% Warm first: the very first fill of a run may resolve names nothing has
% asked for yet, and that is a cost paid once and not per rectangle.
10 measure pop

/small SMALL measure def
/large LARGE measure def

% A counter stuck at one number would satisfy every bound below by
% saying nothing, so require first that it moves for something that does
% resolve a name. cvn offers a string to the name mechanism, which is
% the one thing here that must be charged.
/before .namelookups def
(namelookupcostprobe) cvn pop
.namelookups before gt
    (the interpreter reports the names it looked up) assert

% The property: four times the rectangles, and no more lookups between
% them than the measurement itself accounts for. A lookup charged per
% rectangle makes the difference three hundred.
large small sub SLACK le
    (filling more rectangles does not resolve more names) assert

% And the same thing said from the other end, so that a fill which
% resolved names on every call could not pass by resolving few: the
% whole of the larger arm is bounded by what the measurement costs.
large SLACK le
    (a rectangle fill resolves no names of its own) assert

% The same property, for the operators that convert a coordinate. Each
% of these walks from the private dictionary to the graphics state to
% the matrix it needs, and a program converting a path's worth of points
% calls one per point. What is asserted is the shape and not a number:
% four times the calls, and no more lookups between the two arms than
% the measurement itself accounts for.
%
% They are asked as a family rather than one at a time because that is
% how the cost arrives -- one helper reaches the matrix for all of them,
% so one of them regressing is all of them regressing, and a list of
% names is what makes the failure say which.
/PROBES [
    [ (transform)     { 1 2 transform pop pop } ]
    [ (itransform)    { 1 2 itransform pop pop } ]
    [ (dtransform)    { 1 2 dtransform pop pop } ]
    [ (idtransform)   { 1 2 idtransform pop pop } ]
    [ (translate)     { 0 0 translate } ]
    [ (scale)         { 1 1 scale } ]
    [ (rotate)        { 0 rotate } ]
    [ (concat)        { MAT concat } ]
    [ (currentmatrix) { MAT currentmatrix pop } ]
    [ (defaultmatrix) { MAT defaultmatrix pop } ]
    [ (currentpoint)  { 1 1 moveto currentpoint pop pop } ]
    [ (rectfill)      { 0 0 1 1 rectfill } ]
    [ (stroke)        { newpath 0 0 moveto 2 2 lineto stroke } ]
] def
/MAT [ 1 0 0 1 0 0 ] def

% A procedure reached by name is run by the name, so the one being
% measured is kept in a one-element array and fetched from it: what is
% counted has to be the procedure's own lookups and not a lookup of the
% procedure.
/repeatcost { % proc int  .  int
    /n exch def /pr 1 array def pr 0 3 -1 roll put
    5 { pr 0 get exec } repeat
    .namelookups
    n { pr 0 get exec } repeat
    .namelookups exch sub
} def

initgraphics
0 1 PROBES length 1 sub {
    /pi exch def
    /pn PROBES pi get 0 get def
    /c1 PROBES pi get 1 get SMALL repeatcost def
    /c2 PROBES pi get 1 get LARGE repeatcost def
    c2 c1 sub SLACK le
        (this operator resolves a name per call: ) pn assertn
} for

% And for the text operators, which resolved the most of all: a show
% walked to the graphics state, the font, the device and the colour by
% name for every string it painted -- thirty-five lookups a call -- and
% measuring or outlining a string cost its own dozen or two. These run
% once per string of every page of text, so they are held to the same
% shape as the fills above. The font is set once, outside the
% measurement, the way a page of text sets it.
/Courier findfont 8 scalefont setfont
/TPROBES [
    [ (show)        { 5 5 moveto (xy) show } ]
    [ (ashow)       { 5 5 moveto 0 0 (xy) ashow } ]
    [ (widthshow)   { 5 5 moveto 0 0 32 (xy) widthshow } ]
    [ (stringwidth) { (xy) stringwidth pop pop } ]
    [ (charpath)    { newpath 5 5 moveto (xy) true charpath newpath } ]
] def
0 1 TPROBES length 1 sub {
    /pi exch def
    /pn TPROBES pi get 0 get def
    /c1 TPROBES pi get 1 get SMALL repeatcost def
    /c2 TPROBES pi get 1 get LARGE repeatcost def
    c2 c1 sub SLACK le
        (this operator resolves a name per call: ) pn assertn
} for

checkcount 3 PROBES length add TPROBES length add eq (every check was reached) assert

verdict
