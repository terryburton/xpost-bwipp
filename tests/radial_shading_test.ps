%!testlib
% Where a radial shading puts its colours, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% PLRM 4.9.3 draws the circles of a radial shading in order of increasing
% s, each over the ones before, so a point takes the colour of the
% GREATEST s whose circle PASSES THROUGH it -- and a circle of negative
% radius is no circle at all.
%
% Two readings of that are wrong in ways an ordinary page never shows,
% because both are right whenever one circle lies wholly inside the other
% and neither end extends, which is what almost every radial shading in
% use looks like. The cases below are the ones that tell them apart.
%
%   Taking only the greatest root and giving up where it falls outside
%   the range leaves the far side of a family whose circles sweep clear
%   of one another unpainted -- there the lesser root is the one in
%   range.
%
%   Reading the colours only over the box the two circles occupy leaves
%   everything an extending shading reaches beyond them unpainted.
%
% Every value below is the s the geometry gives, worked out from the
% circles and not read off a render, and DeviceGray with C0 0 and C1 a
% half puts s on the page as s/2.

/.fillpoly     1183615869 internaldict /.fillpoly get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def

/W 200 def
/DEV W W .privatedict /newPGMIMAGEdevice get exec def
DEV begin
    /defaultmatrix [ 1 0 0 -1 0 W ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV put
graphicsdict /currgstate get /device DEV put
initgraphics

/greyat { % ux uy . 0..255
    transform floor cvi exch floor cvi exch
    DEV dup /GetPix get exec
} bind def
/clearpage { gsave 1 setgray 0 0 W W rectfill grestore } bind def
/near { % got want tol . bool
    3 1 roll sub abs exch le
} bind def

/half << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [0.5] /N 1 >> def

% --------------------------------------------- circles that sweep clear
% Equal radii of fifteen at (40,160) and (160,40): the centres are far
% further apart than the radii, so the family sweeps a band between them
% and touches nothing else.

clearpage
gsave
    << /ShadingType 3 /ColorSpace /DeviceGray
       /Coords [ 40 160 15 160 40 15 ] /Function half >> shfill
grestore

 40 160 greyat  11 6 near (the first circle's middle is s = 0.088) assert
100 100 greyat  75 6 near (the middle of the band is s = 0.588) assert
160  40 greyat 116 6 near (the last circle's middle is s = 0.912) assert

% THE CASE. Near the last circle the greater root has run past the end of
% the range while the lesser one is still inside it, and the lesser one
% is the circle this point is on. A reading that takes the greater root
% and gives up leaves this white.
150  50 greyat 106 6 near (the far side of the band is s = 0.828) assert

% and nothing outside the band is painted, neither end extending
 30  30 greyat 255 eq (a point beside the band keeps the page) assert
190 190 greyat 255 eq (and the far corner keeps it too) assert

% ------------------------------------------------------- what extends
% Ten to forty about one centre. Extended past its last circle the family
% grows without bound, so it reaches wherever it is allowed to paint.

clearpage
gsave
    << /ShadingType 3 /ColorSpace /DeviceGray
       /Coords [ 100 100 10 100 100 40 ] /Extend [ false true ]
       /Function half >> shfill
grestore
100 125 greyat  64 6 near (half way out is s = 0.5) assert
190 190 greyat 128 6 near (the far corner takes the last colour) assert
  5 195 greyat 128 6 near (and so does the opposite one) assert
100 100 greyat 255 eq (while the middle, which no circle passes through, keeps the page) assert

% CONTROL. The same family that does not extend leaves those corners, so
% the two arms above are about Extend and not about a shading that covers
% the page whatever it is told.
clearpage
gsave
    << /ShadingType 3 /ColorSpace /DeviceGray
       /Coords [ 100 100 10 100 100 40 ] /Extend [ false false ]
       /Function half >> shfill
grestore
100 125 greyat  64 6 near (unextended, half way out is still s = 0.5) assert
190 190 greyat 255 eq (unextended, the far corner keeps the page) assert
  5 195 greyat 255 eq (and so does the opposite one) assert

verdict
