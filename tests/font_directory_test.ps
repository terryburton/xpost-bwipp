%!testlib
% The two font directories, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% FontDirectory and GlobalFontDirectory are different dictionaries holding
% different things (PLRM 3.7, Tables 3.3 and 3.4). FontDirectory is local:
% a font defined in local VM goes away with the save level that defined
% it. GlobalFontDirectory is global and holds only the fonts defined while
% the allocation mode was global, so it survives those restores.
% SharedFontDirectory is an older name for the same global dictionary.
%
% They were one local dictionary under three names. Nothing failed
% visibly: definefont and findfont agreed with each other, so fonts
% resolved. What a program could not do was tell the two populations
% apart -- GlobalFontDirectory reported fonts that would vanish at the
% next restore, which is the one question it exists to answer.


% the fonts are built in global VM so their parts are global too: a
% global dictionary may not hold a local object, so a font destined for
% GlobalFontDirectory has to be assembled there
currentglobal true setglobal
/fd.mk {
    10 dict
    dup /FontType 3 put
    dup /FontMatrix [0.001 0 0 0.001 0 0] put
    dup /FontBBox [0 0 1000 1000] put
    dup /Encoding 256 array put
    dup /CharProcs 1 dict put
    dup /BuildChar { pop pop } put
} def
setglobal

% ------------------------------------------------------- they are distinct

FontDirectory GlobalFontDirectory ne
    (FontDirectory and GlobalFontDirectory are different dictionaries) assert
SharedFontDirectory GlobalFontDirectory eq
    (SharedFontDirectory is the same dictionary as GlobalFontDirectory) assert
GlobalFontDirectory gcheck
    (GlobalFontDirectory is in global VM) assert
FontDirectory gcheck not
    (FontDirectory is in local VM) assert

% ------------------------------------------------- the name follows the mode
% FontDirectory denotes the local directory while the allocation mode is
% local and the global one while it is global, so a font defined in terms
% of another finds the directory its own fonts are going into.

false setglobal
FontDirectory GlobalFontDirectory ne
    (in local mode FontDirectory is the local directory) assert
true setglobal
FontDirectory GlobalFontDirectory eq
    (in global mode FontDirectory is GlobalFontDirectory) assert
false setglobal
FontDirectory GlobalFontDirectory ne
    (leaving global mode puts FontDirectory back) assert

% ------------------------------------------- each font lands in one of them

false setglobal
/fd.local fd.mk definefont pop
FontDirectory /fd.local known
    (a font defined in local VM is in FontDirectory) assert
GlobalFontDirectory /fd.local known not
    (a font defined in local VM is not in GlobalFontDirectory) assert

true setglobal
/fd.global fd.mk definefont pop
false setglobal
GlobalFontDirectory /fd.global known
    (a font defined in global VM is in GlobalFontDirectory) assert
FontDirectory /fd.global known not
    (a font defined in global VM is not in FontDirectory) assert

% --------------------------------------------- both are reachable by name
% Which directory a font went into is the program's business, not
% findfont's: a prolog defines its fonts in global VM and the pages that
% use them run in local VM.

/fd.local findfont /FontType get 3 eq
    (findfont answers for a font defined in local VM) assert
/fd.global findfont /FontType get 3 eq
    (findfont answers for a font defined in global VM) assert

% ------------------------------------------------- undefinefont reaches both

/fd.global undefinefont
GlobalFontDirectory /fd.global known not
    (undefinefont removes a font from GlobalFontDirectory) assert
/fd.local undefinefont
FontDirectory /fd.local known not
    (undefinefont removes a font from FontDirectory) assert

% ------------------------------------------ the global one outlives a restore
% This is the difference that matters, and the one a single shared
% dictionary could not express: a font defined in global VM is still
% there after a restore that discards everything local.

true setglobal
/fd.keep fd.mk definefont pop
false setglobal
save
false setglobal
/fd.drop fd.mk definefont pop
restore
GlobalFontDirectory /fd.keep known
    (a font defined in global VM survives a restore) assert
FontDirectory /fd.drop known not
    (a font defined in local VM does not survive a restore) assert
/fd.keep undefinefont

% ------------------------------------------- neither is a program's to write
% PLRM Tables 3.3 and 3.4: both directories are read-only. They are
% updated by definefont and consulted by findfont, and a program adds to
% them through definefont or not at all. A writable one is a font the
% program never defined that findfont hands back as a font, and a name
% already defined that a program can replace under whoever asks for it
% next.
%
% The access attribute belongs to the dictionary and not to the reference
% (PLRM 3.3.2), so this is asked of the name every program reaches them
% by, and every route a program has to a dictionary is asked in turn: put,
% def with the dictionary current, and undef.

false setglobal
FontDirectory wcheck not
    (FontDirectory is not writable) assert
GlobalFontDirectory wcheck not
    (GlobalFontDirectory is not writable) assert
SharedFontDirectory wcheck not
    (SharedFontDirectory is not writable) assert

{ FontDirectory /fd.plant 5 dict put } /invalidaccess
    (put into FontDirectory) raises
{ FontDirectory begin /fd.plant 5 dict def end } /invalidaccess
    (def with FontDirectory current) raises
{ FontDirectory /fd.local undef } /invalidaccess
    (undef from FontDirectory) raises

% The global directory is asked with a font built in global VM, so that
% what refuses it is the access attribute and not the rule against a
% global dictionary naming a local object (PLRM 3.7.2).
currentglobal true setglobal
/fd.globalplant fd.mk def
setglobal
{ GlobalFontDirectory /fd.plant fd.globalplant put } /invalidaccess
    (put into GlobalFontDirectory) raises
{ GlobalFontDirectory begin /fd.plant fd.globalplant def end } /invalidaccess
    (def with GlobalFontDirectory current) raises
{ GlobalFontDirectory /fd.global undef } /invalidaccess
    (undef from GlobalFontDirectory) raises

FontDirectory /fd.plant known not
    (nothing a program planted is in FontDirectory) assert
GlobalFontDirectory /fd.plant known not
    (nothing a program planted is in GlobalFontDirectory) assert

% ---------------------------------- and the operators still write them both
% The seal is on the dictionary, so it stands against every reference to
% it -- the ones definefont and undefinefont hold included. They reach
% past it rather than around it, and this is what says they still do.

false setglobal
/fd.sealed fd.mk definefont pop
FontDirectory /fd.sealed known
    (definefont still files a font in the sealed FontDirectory) assert
/fd.sealed findfont /FontType get 3 eq
    (findfont still answers with the font definefont filed) assert
/fd.sealed undefinefont
FontDirectory /fd.sealed known not
    (undefinefont still takes a font out of the sealed FontDirectory) assert

true setglobal
/fd.sealedglobal fd.mk definefont pop
false setglobal
GlobalFontDirectory /fd.sealedglobal known
    (definefont still files a font in the sealed GlobalFontDirectory) assert
/fd.sealedglobal undefinefont
GlobalFontDirectory /fd.sealedglobal known not
    (undefinefont still takes a font out of the sealed GlobalFontDirectory) assert

% PLRM 3.9.2 makes /Font defineresource, findresource and undefineresource
% the same operations as definefont, findfont and undefinefont, and the
% category's instances ARE these directories, so the route through the
% resource operators has to reach past the seal as well.

false setglobal
/fd.viaresource fd.mk /Font defineresource pop
FontDirectory /fd.viaresource known
    (defineresource files a font in the sealed FontDirectory) assert
/fd.viaresource /Font findresource /FontType get 3 eq
    (findresource answers with the font defineresource filed) assert
/fd.viaresource /Font undefineresource
FontDirectory /fd.viaresource known not
    (undefineresource takes a font out of the sealed FontDirectory) assert

FontDirectory wcheck not
    (the directories are still sealed after all of that) assert
GlobalFontDirectory wcheck not
    (and so is the global one) assert

verdict
