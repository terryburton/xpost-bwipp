%!testlib
% A captured glyph mask is handed to the cache in a dictionary: buf
% holds the coverage bytes, and w and h say how the cache is to read
% them -- h rows of w bytes, copied whole into the cache's own store.
% The dictionary is data a program can build, so buf has to hold that
% many bytes before any of them is copied, and the check has to hold
% for every pair of dimensions a dictionary can carry, including the
% pairs whose product is larger than the type a multiplication would
% form it in. A mask whose dimensions overrun its bytes is a
% rangecheck, and the operator must still be there afterwards.

/fails 0 def
/say { print (\n) print } def

/id 1183615869 internaldict def
/mput id /.maskcacheput get def
/cstat id /.cachestatus get def

% buflen w h  .  a capture dictionary that is otherwise sound
/cap {
  /hh exch def
  /ww exch def
  <<
    /buf 3 -1 roll string /mat [ 1 0 0 1 0 0 ] /key [ 1 /A ]
    /w ww /h hh /bx0 0 /by0 0 /ox 0 /oy 0 /advx 0 /advy 0
  >>
} def

% dict label  .  -   put it in the cache; expect rangecheck
/expectrange {
  /label exch def
  /d0 countdictstack def
  { mput } stopped
  dup { $error /errorname get 128 string cvs }{ (none) } ifelse
  countdictstack d0 sub { end } repeat
  exch
  { dup (rangecheck) eq
    { pop (ok   ) print label say }
    { /fails fails 1 add def
      (FAIL: ) print label print ( raised ) print say } ifelse }
  { pop /fails fails 1 add def
    (FAIL: ) print label print ( raised no error) say } ifelse
} def

% --- the dimensions read the coverage bytes ---
16 8 8 cap (a mask wider than its bytes) expectrange
16 4 8 cap (a mask taller than its bytes) expectrange
% the pair whose product leaves the type it would be formed in: eight
% bytes of coverage read as four thousand million
8 65536 65536 cap (a mask of unformable extent) expectrange
% and neither dimension counts backwards
64 -1 8 cap (a mask of negative width) expectrange
64 8 0 cap (a mask of no rows) expectrange

% --- a mask its bytes do hold still reaches the cache ---
% the cache reports the bytes it holds, and a sound capture adds its
% own to them
cstat 7 array astore /before exch def
/d 64 8 8 cap def
{ d mput } stopped
{ /fails fails 1 add def
  (FAIL: a sound capture raised ) print
  $error /errorname get 128 string cvs say }
{ cstat 7 array astore /after exch def
  /grew false def
  0 1 6 { /i exch def
    after i get before i get gt { /grew true def } if } for
  grew
  { (ok   a sound capture still reaches the cache) say }
  { /fails fails 1 add def
    (FAIL: a sound capture cached nothing) say } ifelse } ifelse

% --- what the cache tells one entry from another by ---
% An entry belongs to one mask under one transform, and the cache is
% asked for it by the two together: the caller's own number for the
% mask, and the transform quantized into a fixed-point field. Two
% entries filed under one number and different transforms are two
% entries, and each transform has to reach its own.
%
% A transform past what the fixed-point field carries has no place in
% it. Keyed anyway, several such transforms arrive at one key and each
% is served whichever of their rasters was filed first, which is the
% wrong mask rather than a slow one. So the pair below straddles the
% field's own boundary -- about 1.4e14 where the field is sixty-four
% bits and about 3.3e4 where it is thirty-two, so the second pair is
% outside it at either width -- and each transform must reach the entry
% it filed, or reach none.
/mhit id /.maskcachehit get def

% The operator paints, and what it paints in is the colour the painting
% machinery resolves for a coverage raster: the components in the
% device's own space with the transfer functions applied, left where the
% paint reads them. Nothing here has painted yet, so nothing has resolved
% one, and the calls below would be refused for want of it rather than
% answering about the keys they are here to ask about. Showing a
% character resolves one the ordinary way.
testfont3 0 0 moveto (A) show
/require { % bool label  .  -
    exch { (ok   ) print say }
         { /fails fails 1 add def (FAIL: ) print say } ifelse
} def
% The key is a serial paired with the name of the thing the mask is of;
% what varies below is the transform, so the same serial and name stand
% behind every entry and the number written at the call site picks the
% serial.
/askey { % n  .  [n /A]
    [ exch /A ]
} bind def
/file { % mat key advance  .  -   file a one-pixel mask under mat and key
    3 dict begin /a exch def /k exch askey def /m exch def
    << /buf (\377) /w 1 /h 1 /bx0 0 /by0 0 /ox 0 /oy 0
       /advx a /advy 0.0 /mat m /key k >> mput
    end
} bind def
/ask { % mat key  .  advance | null
    askey 10 10 4 2 roll [ 0 0 140 48 ] mhit
    { pop }{ null } ifelse
} bind def

% The field is the face's own 16.16 form, held in the C type the font
% library gives it, whose width is the platform's: a value inside the
% field where that type is 64 bits is outside it where it is 32. So the
% values below are chosen against the narrower of the two -- well inside
% it for the entries that must each be reached, and past what either can
% hold for the ones that must not be.

% inside the field: two transforms, two entries, each reached by its own
[ 1.0 0 0 1.0 0 0 ] 11 33.0 file
[ 1.2 0 0 1.2 0 0 ] 11 44.0 file
[ 1.0 0 0 1.0 0 0 ] 11 ask 33.0 eq
    (a transform inside the fixed-point field reaches its own entry) require
[ 1.2 0 0 1.2 0 0 ] 11 ask 44.0 eq
    (and so does the other one filed beside it) require

% outside it: whatever is filed, neither transform may reach the other's
[ 2.0e15 0 0 2.0e15 0 0 ] 12 55.0 file
[ 3.0e15 0 0 3.0e15 0 0 ] 12 66.0 file
[ 2.0e15 0 0 2.0e15 0 0 ] 12 ask dup null eq exch 55.0 eq or
    (a transform outside the field reaches no other transform's entry) require
[ 3.0e15 0 0 3.0e15 0 0 ] 12 ask dup null eq exch 66.0 eq or
    (nor does the other one filed beside it) require

% The caller's number for a mask shares one field with the name beside
% it, so it has a range rather than the whole of the integer's. A number
% outside that range is no key: nothing is filed under it, and the ask
% that follows is answered by nothing rather than by whatever entry a
% number reduced into range would have landed on. Only a build whose
% integer reaches past the range can state the case.
2147483648 type /integertype eq {
    [ 1 0 0 1 0 0 ] 4294967297 77.0 file
    [ 1 0 0 1 0 0 ] 1 88.0 file
    [ 1 0 0 1 0 0 ] 4294967297 ask null eq
        (a mask number past the key's range files nothing) require
    [ 1 0 0 1 0 0 ] 1 ask 88.0 eq
        (and the number below the range keeps its own entry) require
} if

% a negative number is outside the range at every width
[ 1 0 0 1 0 0 ] -1 99.0 file
[ 1 0 0 1 0 0 ] -1 ask null eq
    (a negative mask number files nothing) require

fails 0 eq { (SUCCESS) = }{ (FAILURES: ) print fails 20 string cvs say } ifelse
quit
