%!testlib
% The glyph cache's key, run through `xpost -d null` by run-ps-test.sh:
% prints SUCCESS iff every assertion holds.
%
% The cache remembers a glyph under an integer made from the font's
% serial and the character code. The serial lives in the font dictionary
% under .fontid, and a font dictionary is the program's: definefont
% stamps a serial only where there is none, and nothing stops a program
% writing its own there, writing something that is not a serial at all,
% or removing it. So the key is made from whatever is there, and what is
% there may be no key at all -- a serial far enough out that the pair
% leaves the integer range arrives as a real, and the narrower of the two
% object widths leaves it sooner.
%
% A glyph whose font has no key builds direct. Two things are asserted
% about that, because either alone would admit a wrong fix: the glyph is
% drawn, and it is drawn from its own outline rather than from whatever
% mask a serial reduced into range happened to land on.

/.fillpoly     1183615869 internaldict /.fillpoly get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def

% --- a raster to draw into and read back ---
/DEV 64 64 .privatedict /newPGMIMAGEdevice get exec def
DEV begin
    /defaultmatrix [ 1 0 0 -1 0 64 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV put
graphicsdict /currgstate get /device DEV put
initgraphics

/snap { % - . [rows]
    [ 0 1 63 { DEV /ImgData get exch get dup length string copy } for ]
} bind def
/same { % [rows] [rows] . bool
    /gk.b exch def /gk.a exch def
    true 0 1 63 {
        /gk.i exch def
        gk.a gk.i get gk.b gk.i get eq and
    } for
} bind def
/ink { % [rows] . n
    0 exch { { 128 lt { 1 add } if } forall } forall
} bind def
% what the cache is holding: the entry count cachestatus reports
/csize { cachestatus 7 array astore 4 get } bind def

% --- Type 3 fonts: a glyph whose size is the font's, so two fonts can
%     be told apart by what they draw ---
/mkfont { % size id . font
    /gk.id exch def /gk.sz exch def
    8 dict dup begin
        /FontType 3 def
        /FontMatrix [0.001 0 0 0.001 0 0] def
        /FontBBox [0 0 1000 1000] def
        /Encoding 256 array def
        0 1 255 { Encoding exch /.notdef put } for
        Encoding 65 /A put
        /gk.side gk.sz def
        /CharProcs 2 dict def
        CharProcs /A {
            gk.side 50 add 0  0 0 gk.side gk.side setcachedevice
            0 0 gk.side gk.side rectfill
        } put
        CharProcs /.notdef { 0 0 setcharwidth } put
        /BuildChar { exch begin
            Encoding exch get CharProcs exch get exec
        end } def
        gk.id null ne { /.fontid gk.id def } if
    end
} bind def

/draw { % font . [rows]
    1 setgray 0 0 64 64 rectfill 0 setgray
    30 scalefont setfont
    2 4 moveto (A) show
    snap
} bind def

% The serial the key has no room for. The key carries the character's
% name -- a stack index and the bank bit saying which name stack it
% indexes -- and gives the serial the bits left over, so a serial
% outside that range is one no key can be made from. Below the range is
% outside it at every width; above it is only reachable where the
% language's integer is wider than the range itself, so the case that
% stands everywhere is the negative one and the other is taken where it
% can be.
/wideint 2147483648 type /integertype eq def
/bigid -1 def
/overid wideint { 2147483648 }{ null } ifelse def

/base0 csize def
/rbig 700 null mkfont /GKbig exch definefont draw def
/rsmall 300 null mkfont /GKsmall exch definefont draw def
/basecached csize def

% The two shapes have to be distinguishable, or nothing below says
% anything: a comparison that cannot tell them apart passes whatever the
% cache serves.
rbig ink 0 gt (a glyph with a serial the cache can key leaves ink) assert
rsmall ink 0 gt (the second shape leaves ink too) assert
rbig rsmall same not (the two shapes are told apart) assert
basecached base0 gt (a font the cache can key fills the cache) assert

% --- a serial the key cannot be made from ---
/rhostile 300 bigid mkfont /GKhostile exch definefont draw def
rhostile rsmall same
    (a glyph whose serial is outside the key's range is drawn from its own outline) assert
rhostile rbig same not
    (it is not drawn from the mask a reduced serial would have found) assert
csize basecached eq
    (a glyph with no key files nothing in the cache) assert

% and the other end of the range, where the language carries an integer
% that far out at all
overid null ne {
    /rover 300 overid mkfont /GKover exch definefont draw def
    rover rsmall same
        (a serial past the top of the key's range is drawn from its own outline) assert
    csize basecached eq
        (nor does that one file anything in the cache) assert
} if

% --- the other shapes .fontid can take ---
/rreal 300 1.5 mkfont /GKreal exch definefont draw def
rreal rsmall same (a serial that is a real is not a key) assert
/rstr 300 (x) mkfont /GKstr exch definefont draw def
rstr rsmall same (a serial that is a string is not a key) assert
/rname 300 /x mkfont /GKname exch definefont draw def
rname rsmall same (a serial that is a name is not a key) assert
% Not registered, which is how a font comes to carry no serial at all:
% definefont stamps one and makes the dictionary read-only (PLRM 8.2),
% so a registered font is one whose serial the program can no longer
% take away. setfont asks a font for its matrix and not for a
% registration, so an unregistered one shows text the same way.
/GKgone 300 null mkfont def
/rgone GKgone draw def
rgone rsmall same (a font with no serial at all is not a key) assert

% --- an encoding the selector cannot be read out of ---
% The other half of the key is the character's name, which is what the
% font's encoding holds at the code. An encoding a program has replaced
% with something that is not an array holds no name the cache can be
% asked for, so the glyph builds direct as one with no serial does. The
% font still draws: what a glyph description reads its encoding as is
% its own business, and only the key is refused.
% The encoding is replaced before the font is registered, definefont
% making the dictionary read-only (PLRM 8.2). It IS registered, so it
% carries a serial: a font refused a key for want of one would pass this
% whatever its encoding held.
/GKnoenc 300 null mkfont def
GKnoenc /Encoding 1 dict put
GKnoenc /Encoding get 65 /A put
/GKnoenc /GKnoenc GKnoenc definefont def
/rnoenc GKnoenc draw def
rnoenc rsmall same
    (a font whose encoding is not an array of names is not a key) assert

csize basecached eq
    (none of them files anything in the cache) assert

verdict
