%!testlib
% `holds2` is the shared assert2 with the two strings the other way round:
% this suite names the question first and the member second, and printing
% them in the order it always did is what lets the move be checked by
% diffing the output.
/holds2 { exch assert2 } bind def
% Every file operator against every filter, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% A filter carries a table of methods and inherits the rest of its
% behaviour from the machinery around it. Which methods it has to carry
% itself depends on how it holds its data, so a filter can read
% perfectly while being unable to be reset, or closed, or asked what it
% holds -- and one operator at a time is exactly what a per-operator
% test does not catch. The same shape of gap left five devices unable to
% paint a glyph.
%
% So each operator is tried against each filter, and each combination
% reports for itself.



% each decoding filter with a source it can actually decode
/cases [
    [ (ASCIIHexDecode)      (414243>)      ]
    [ (ASCII85Decode)       (@:E_W~>)      ]
    [ (RunLengthDecode)     (\002abc\200)  ]
    [ (ReusableStreamDecode) (abcdef)      ]
] def

cases {
    aload pop /src exch def /fn exch def

    { src fn cvn filter 8 string readstring pop pop }   (readstring) fn works2
    { src fn cvn filter read pop pop }                  (read) fn works2
    { src fn cvn filter 8 string readhexstring pop pop } (readhexstring) fn works2
    { src fn cvn filter 8 string readline pop pop }     (readline) fn works2
    { src fn cvn filter closefile }                     (closefile) fn works2
    { src fn cvn filter resetfile }                     (resetfile) fn works2
    { src fn cvn filter status pop }                    (status) fn works2
    { src fn cvn filter bytesavailable pop }            (bytesavailable) fn works2
    { src fn cvn filter flushfile }                     (flushfile) fn works2
    { src fn cvn filter /ASCIIHexDecode filter closefile } (filter over it) fn works2
    { src fn cvn filter dup closefile closefile }       (closing twice) fn works2
    { src fn cvn filter token { pop } if }              (token) fn works2

    % and the operators each has to refuse
    { src fn cvn filter 0 string readstring pop pop }
        (a zero-length read) fn refuses2
    { src fn cvn filter (x) writestring }
        (writing to an input filter) fn refuses2
} forall

% flushfile on an input file reads and discards characters until the end
% of the data, and leaves the file open (PLRM 8.2). Reaching the end is
% a different piece of work in each filter -- one decodes its way there,
% one already holds the whole stream -- so what answers for it is the
% filter's own, and each has to be asked. Half a family answering is how
% an operator comes to have two implementations, one of them reached and
% one of them not.
cases {
    aload pop /src exch def /fn exch def
    /m.d src fn cvn filter def
    m.d flushfile
    m.d 8 string readstring exch pop not
        (flushfile leaves it at end of data) fn holds2
    m.d status
        (flushfile leaves it open) fn holds2
    m.d closefile
} forall

% each encoding filter, through the operators an output file takes
[ (ASCIIHexEncode) (ASCII85Encode) (NullEncode) (RunLengthEncode) ] {
    /fn exch def
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e (data) writestring e closefile o closefile }        (write and close) fn works2
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e (d) writestring e flushfile e closefile o closefile } (flushfile) fn works2
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e (d) writestring e resetfile e closefile o closefile } (resetfile) fn works2
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e status pop e closefile o closefile }                 (status) fn works2
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e 65 write e closefile o closefile }                   (write a byte) fn works2
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e <4142> writehexstring e closefile o closefile }      (writehexstring) fn works2

    % and the one it has to refuse
    { /o (fmatrix.scratch) (w) file def /e o fn cvn filter def
      e read pop pop }                          (reading an output filter) fn refuses2
    % the refusal unwound past the closes, so the pair it opened is still
    % open; the file is deleted at the end and an open one need not go
    e closefile o closefile
} forall

% ------------------------------------------- pushback under the scanner
% A token ends at the delimiter following it, and that delimiter is the
% start of the next token, so it goes back on the stream it came from.
% The filter machinery holds one character of pushback for the codings
% that read through it; a reusable stream holds its data itself and so
% has to take a character back for itself. A stream that could not would
% swallow every delimiter it read, which reads as a shorter program
% rather than as an error.
/rs (12[34]) << >> /ReusableStreamDecode filter def
/toks 8 array def
/ntok 0 def
{ rs token not { exit } if
  toks ntok 3 -1 roll put
  /ntok ntok 1 add store
  ntok 8 ge { exit } if } loop
ntok 4 eq (a delimiter ending a token goes back on the stream) assert
ntok 4 eq {
    toks 0 get 12 eq (the number before the delimiter reads whole) assert
    toks 2 get 34 eq (the number after it reads whole) assert
} if

% ------------------------------------------- the parameters a filter needs
% A filter given its parameters in a dictionary has to be told when the
% dictionary does not carry the one that decides anything. Without an
% end-of-data string, SubFileDecode defaulted would reach its end of data
% at once and hand back an empty stream, which reads as a truncated file
% rather than as the mistake it is. A count is not like that: zero is what
% a dictionary naming only the string is asking for, and COMPLIANCE
% records that leniency against PLRM 3.13 Table 3.23.

{ (abcXdef) 1 (X) /SubFileDecode filter 16 string readstring pop pop }
    (the operand form) (SubFileDecode) works2
{ (abcXdef) << /EODCount 1 /EODString (X) >> /SubFileDecode filter
  16 string readstring pop pop } (the dictionary form) (SubFileDecode) works2

{ (abcXdef) << >> /SubFileDecode filter }
    /undefined (a dictionary carrying neither parameter) raises
{ (abcXdef) << /EODCount 1 >> /SubFileDecode filter }
    /undefined (a dictionary with no EODString) raises
{ (abcXdef) << /EODString (X) >> /SubFileDecode filter
  16 string readstring pop pop } (a dictionary with only the string)
    (SubFileDecode) works2
{ (abcXdef) << /EODCount (one) /EODString (X) >> /SubFileDecode filter }
    /typecheck (an EODCount that is not an integer) raises
{ (abcXdef) << /EODCount 1 /EODString 7 >> /SubFileDecode filter }
    /typecheck (an EODString that is not a string) raises
{ (abcXdef) << /EODCount -1 /EODString (X) >> /SubFileDecode filter }
    /rangecheck (a negative EODCount) raises

% and the two forms agree with each other
/opform (abcXdef) 1 (X) /SubFileDecode filter 16 string readstring pop def
/dictform (abcXdef) << /EODCount 1 /EODString (X) >> /SubFileDecode filter
    16 string readstring pop def
opform dictform eq (both forms read the same) assert


(fmatrix.scratch) status { pop pop pop pop (fmatrix.scratch) deletefile } if

verdict
