%!testlib
% An operator leaves nothing behind when it refuses, and its caller has
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% its operands back.
%
% PLRM 3.11.1 gives the interpreter three steps at an error, the first
% of which is "restores the operand stack to the state it was in when it
% began executing the current object". For an operator that is one, the
% stack a caught error leaves is the operands it was called with:
% nothing the body pushed on its way to failing, and nothing missing
% that the body consumed before it failed.
%
% An operator written in C is passed its operands as arguments, and the
% dispatcher has them in hand to put back. One written in PostScript is
% passed nothing and reads the operand stack itself, so its operands are
% copied when it is called, and an unwind puts the copies back.
%
% There are three ways an error reaches a caller here. The interpreter
% raises its own; a body written in PostScript raises one with
% signalerror, which ends in a PostScript stop and never passes through
% the interpreter's handler; and a body that caught a failure in a
% stopped context of its own raises it again with a bare stop. All three
% end in a stop, so the unwinding is done there as well as where each
% error is raised, and a path added later inherits it. That matters
% beyond tidiness: the machinery's own operators hold the machinery's
% own structures while they work, and a program left holding one can
% read and write it.
%
% The rule reaches only as far as the operator. Where an operator calls
% back into a procedure of the program's, the object being executed when
% the failure comes is that procedure, and the stack goes back to what
% the procedure found -- not to what the operator was called with. The
% operator's operands stay consumed.
%
% The operators built here are built rather than borrowed so the claims
% are about the mechanism and not about whichever library operator
% happens to fail this way today. Library operators are asserted
% alongside them, so that both halves are known to reach real ones.

/ID 1183615869 internaldict def

% depth left behind by a procedure that is expected to fail
/leftby { % {proc}  .  int
    count 1 sub /lb.d exch def
    /lb.p exch def
    /lb.p load stopped not { (FAIL: the probe did not fail\n) print /failcount failcount 1 add store } if
    count lb.d sub
    dup 0 gt { dup { exch pop } repeat }{ } ifelse
} def

% clear back to a recorded depth, answering false: the arm of a value
% check that runs when the depth is already wrong, so that a failing
% assertion leaves the stack as a passing one does
/wrongdepth { % int  .  false
    count 1 sub exch sub dup 0 gt { { pop } repeat }{ pop } ifelse false
} def

% --- an operator whose body signals with values on the stack ---------
%
% Three values pushed, then a refusal. The operator takes none, so a
% conforming stack after the caught error is exactly as deep as before.

/.sigleak
    /.sigleak { 11 22 33 /.sigleak cvx /limitcheck signalerror } [ ]
    ID /.wrapopsig get exec
def
{ .sigleak } leftby 0 eq
    (an operator that signals leaves nothing it pushed) assert

% and the error still reaches the program as its own
{ .sigleak } stopped { $error /errorname get /limitcheck eq }{ false } ifelse
    (the refusal is still reported) assert
{ .sigleak } stopped { $error /command get dup length string cvs
                       (.sigleak) eq }{ false } ifelse
    (the refusal still names the operator) assert

% --- the operands a body consumed before it refused -------------------
%
% The whole of PLRM 3.11.1 step 1: not merely that the stack is no
% deeper than the call found it, but that it holds what the call found.
% This body consumes both its operands and pushes two of its own, so it
% signals at exactly the depth it was called at -- a check on the depth
% alone passes here whether or not the operands came back. The values
% are what says so.

/.sigargs
    /.sigargs { pop pop 44 55 /.sigargs cvx /rangecheck signalerror }
    [ /anytype /anytype ] ID /.wrapopsig get exec
def
count /d0 exch def
{ 1 2 .sigargs } stopped pop
count d0 sub 2 eq
    { 2 eq exch 1 eq and }{ d0 wrongdepth } ifelse
    (an operator that signals gives its operands back) assert

% the same for an error the interpreter raises rather than the body
/.cargs
    /.cargs { pop pop pop 66 77 1 0 div }
    [ /anytype /anytype /anytype ] ID /.wrapopsig get exec
def
count /d0 exch def
{ 7 8 9 .cargs } stopped pop
count d0 sub 3 eq
    { 9 eq exch 8 eq and exch 7 eq and }{ d0 wrongdepth } ifelse
    (an operator whose body faults gives its operands back) assert

% --- an error caught inside a body and raised again ------------------
%
% The third path: the body runs something in a stopped context of its
% own, and on catching the failure raises it again with a bare stop.
% That stop never passes an error hook, so the unwinding lives in stop
% itself. The frame below the body's own stopped context is left alone
% while that context is live -- the body is still running -- and is
% unwound by the stop that finally leaves it.

/.sigcatch
    /.sigcatch { pop pop { 1 0 div } stopped { 44 55 stop } if }
    [ /anytype /anytype ] ID /.wrapopsig get exec
def
count /d0 exch def
{ 3 4 .sigcatch } stopped pop
count d0 sub 2 eq
    { 4 eq exch 3 eq and }{ d0 wrongdepth } ifelse
    (an operator that re-raises with stop gives its operands back) assert

% --- nesting: only the calls the stop unwinds out of ------------------
%
% An operator that calls another which refuses. Both frames are live, so
% the stack goes back to what the outer call found -- its own operands,
% not the inner call's.

/.siginner
    /.siginner { pop 66 77 /.siginner cvx /typecheck signalerror }
    [ /anytype ] ID /.wrapopsig get exec
def
/.sigouter
    /.sigouter { pop pop 88 .siginner }
    [ /anytype /anytype ] ID /.wrapopsig get exec
def
count /d0 exch def
{ 5 6 .sigouter } stopped pop
count d0 sub 2 eq
    { 6 eq exch 5 eq and }{ d0 wrongdepth } ifelse
    (a nested refusal unwinds to what the outermost call found) assert

% --- a refusal inside a procedure the program is running --------------
%
% A call whose frame sits below the caught context keeps running: what
% the program itself pushed before calling is not the operator's to
% take. Here the program pushes two values, then the operator refuses;
% the two stay, and are still themselves.

count /d0 exch def
{ 1 2 .sigleak } stopped pop
count d0 sub 2 eq
    { 2 eq exch 1 eq and }{ d0 wrongdepth } ifelse
    (what the program pushed before the call is left alone) assert

% --- the interpreter's own errors were already unwound ----------------
%
% The other kind of operator, asserted alongside so that the two stay
% together: a C operator's operands come back, which is the same clause
% of the same rule.

count /d0 exch def
{ 1 0 div } stopped pop
count d0 sub 2 eq
    { 0 eq exch 1 eq and }{ d0 wrongdepth } ifelse
    (the interpreter restores an operand it consumed) assert

% --- library operators ------------------------------------------------
%
% Two operators of the language itself, written in PostScript, whose
% bodies consume their operands well before they discover they cannot go
% on. They stand here for both halves of the rule, as operators nobody
% wrote for this test.
%
% findresource refuses on the operands it was handed, and hands them
% back.

count /d0 exch def
{ /zzz /zzz findresource } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (findresource gives back the operands it was called with) assert

% store looks the key up before it writes it, and reads the answer off
% the operand stack. A key the lookup refuses -- null, which is no key
% (PLRM 3.3.5) -- is a key it answers nothing for, and what lies under a
% refusal is whatever the program left there. Two operands are placed
% below the call to stand in that position, and the typecheck has to give
% the caller all four back.

count /d0 exch def
{ 11 22 null 33 store } stopped pop
count d0 sub 4 eq
    { 33 eq exch null eq and exch 22 eq and exch 11 eq and }
    { d0 wrongdepth } ifelse
    (store refusing a key gives back what was under the call) assert

% the control: a key it does not refuse is stored, and the operands are
% consumed as the operator's own
count /d0 exch def
/zzstore 1 def
/zzstore 2 store
count d0 sub 0 eq (store takes its own operands when it stores) assert
zzstore 2 eq (and stores the value it was given) assert

% image runs a procedure of the program's. What fails in there is not
% image refusing: the object being executed is the program's own
% procedure, so the stack goes back no further than that procedure found
% it, and the five operands image consumed stay consumed. The value the
% program left below the call says nothing was put back over it: it is
% still itself, and still the only thing there.
%
% Both ways out of that procedure leave the same stack, because both
% leave by the same route.

/im.m [ 8 0 0 -8 0 8 ] def
count /d0 exch def
/im.sentinel
{ 8 8 8 im.m { stop } image } stopped pop
count d0 sub 1 eq
    { /im.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in the procedure image runs restores nothing of image's) assert

count /d0 exch def
/im.sentinel
{ 8 8 8 im.m { zzundefinedname } image } stopped pop
count d0 sub 1 eq
    { /im.sentinel eq }{ d0 wrongdepth } ifelse
    (an error in the procedure image runs restores nothing of image's) assert

% The boundary the procedure stands behind is one-sided. An operator the
% procedure itself calls is refusing on its own operands and hands them
% back where it failed; only the calls beneath the procedure are left
% alone.

count /d0 exch def
{ 8 8 8 im.m { /zzz /zzz findresource } image } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside that procedure gives its own back) assert

% And it reaches only as far as the procedure. image failing on its own
% account -- on an operand it was handed, or on what the procedure left
% it once the procedure had returned -- is image refusing, and its five
% operands come back as any other operator's do.

count /d0 exch def
{ 8 8 8 (notamatrix) { (\377) } image } stopped pop
count d0 sub 5 eq
    { length 1 eq exch (notamatrix) eq and exch 8 eq and
      exch 8 eq and exch 8 eq and }{ d0 wrongdepth } ifelse
    (image refusing on an operand gives its operands back) assert

count /d0 exch def
{ 8 8 8 im.m { } image } stopped pop
count d0 sub 5 eq
    { length 0 eq exch im.m eq and exch 8 eq and
      exch 8 eq and exch 8 eq and }{ d0 wrongdepth } ifelse
    (image refusing on what the procedure left gives them back) assert

% What comes back is the stack the call was made on, not enough values
% to make its depth right. A data source has moved the stack by the time
% image discovers it cannot go on -- it may have left a value of its
% own, or taken one from beneath the call -- and none of that survives:
% the caller is handed the stack image began with, every slot of it.
%
% This is the whole of PLRM 3.11.1 step 1 and it is asserted in values
% because the depth alone cannot tell it apart from putting back only as
% many entries as the depth is short. COMPLIANCE records it as a
% deviation, so the values below are the choice and not an accident.

count /d0 exch def
{ 8 8 8 im.m { 42 } image } stopped pop
count d0 sub 5 eq
    { length 1 eq exch im.m eq and exch 8 eq and
      exch 8 eq and exch 8 eq and }{ d0 wrongdepth } ifelse
    (nothing the procedure left survives the operands coming back) assert

count /d0 exch def
/uw.s1
{ 8 8 8 im.m { pop 42 } image } stopped pop
count d0 sub 6 eq
    { length 2 eq exch im.m eq and exch 8 eq and exch 8 eq and
      exch 8 eq and exch /uw.s1 eq and }{ d0 wrongdepth } ifelse
    (and one it took from beneath the call is back where it was) assert

count /d0 exch def
/uw.s1 /uw.s2
{ 8 8 8 im.m { pop pop 42 } image } stopped pop
count d0 sub 7 eq
    { length 3 eq exch im.m eq and exch 8 eq and exch 8 eq and
      exch 8 eq and exch /uw.s2 eq and exch /uw.s1 eq and }
    { d0 wrongdepth } ifelse
    (however far beneath the call the procedure reached) assert

% More of the first half, in operators of the language: an operator that
% refuses on the operands it was handed hands them back, whichever
% language it is written in and however many it takes.

count /d0 exch def
{ /zzz /zzz 1 defineresource } stopped pop
count d0 sub 3 eq
    { 1 eq exch /zzz eq and exch /zzz eq and }{ d0 wrongdepth } ifelse
    (defineresource gives back the operands it was called with) assert

count /d0 exch def
{ 1 2 3 4 5 6 7 99 roll } stopped pop
count d0 sub 8 eq
    { 99 eq exch 7 eq and exch 6 eq and exch 5 eq and exch 4 eq and
      exch 3 eq and exch 2 eq and exch 1 eq and }{ d0 wrongdepth } ifelse
    (roll gives back everything it was called with) assert

% kshow refuses before it reaches the procedure it was handed, so this
% is the first half of the rule and not the second: both operands come
% back, the procedure among them.

count /d0 exch def
{ (ab) { pop pop stop } kshow } stopped pop
count d0 sub 2 eq
    { length 3 eq exch (ab) eq and }{ d0 wrongdepth } ifelse
    (kshow gives back the operands it was called with) assert

% --- the other operators that hand control back -----------------------
%
% image is not the only one. A Type 3 font's build procedure, a transfer
% function, a spot function and a colour space's tint transform are all
% the program's, run from inside the operator that installs or uses
% them, and each stands behind the same boundary: a failure in one of
% them is the program's own object failing, so the operator that called
% it keeps what it consumed, and the boundary is one-sided, so an
% operator the procedure itself calls still hands its own operands back.
%
% The sentinel below each call is what says the operands did not come
% back: it is still itself, and still the only thing there.

/t3.font { % {glyphbody}  .  fontdict
    /t3.b exch def
    10 dict begin
        /FontType 3 def
        /FontMatrix [ 0.001 0 0 0.001 0 0 ] def
        /FontBBox [ 0 0 1000 1000 ] def
        /Encoding 256 array def
        0 1 255 { Encoding exch /.notdef put } for
        Encoding 65 /t3.A put
        /BuildGlyph /t3.b load def
    currentdict end
} def
/t3.head { pop pop 1000 0 0 0 800 800 setcachedevice } def
/t3.stopf  { t3.head stop } t3.font def
/t3.errf   { t3.head zzundefinedname } t3.font def
/t3.innerf { t3.head /zzz /zzz findresource } t3.font def
/t3.okf    { t3.head 0 0 800 800 rectfill } t3.font def
/t3.stop  t3.stopf  definefont pop
/t3.err   t3.errf   definefont pop
/t3.inner t3.innerf definefont pop
/t3.ok    t3.okf    definefont pop
/t3.use { findfont 12 scalefont setfont 72 72 moveto } def

initgraphics /t3.stop t3.use
count /d0 exch def
/t3.sentinel
{ 1.5 2.5 (A) ashow } stopped pop
count d0 sub 1 eq
    { /t3.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a build procedure restores nothing of the shower's) assert

initgraphics /t3.err t3.use
count /d0 exch def
/t3.sentinel
{ 1.5 2.5 (A) ashow } stopped pop
count d0 sub 1 eq
    { /t3.sentinel eq }{ d0 wrongdepth } ifelse
    (an error in a build procedure restores nothing of the shower's) assert

initgraphics /t3.stop t3.use
count /d0 exch def
/t3.sentinel
{ (A) stringwidth } stopped pop
count d0 sub 1 eq
    { /t3.sentinel eq }{ d0 wrongdepth } ifelse
    (and the same for a shower that measures rather than paints) assert

initgraphics /t3.inner t3.use
count /d0 exch def
{ 1.5 2.5 (A) ashow } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside a build procedure gives its own back) assert

initgraphics /t3.ok t3.use
count /d0 exch def
{ 1.5 2.5 (A) 0 get ashow } stopped pop
count d0 sub 3 eq
    { 65 eq exch 2.5 eq and exch 1.5 eq and }{ d0 wrongdepth } ifelse
    (a shower refusing on an operand gives its operands back) assert

/xf.stop  { pop stop } def
/xf.err   { pop zzundefinedname } def
/xf.inner { pop /zzz /zzz findresource } def
/xf.bad   { pop (notanumber) } def

count /d0 exch def
/xf.sentinel
{ /xf.stop load settransfer } stopped pop
count d0 sub 1 eq
    { /xf.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a transfer procedure restores nothing of settransfer's) assert

count /d0 exch def
/xf.sentinel
{ /xf.err load setblackgeneration } stopped pop
count d0 sub 1 eq
    { /xf.sentinel eq }{ d0 wrongdepth } ifelse
    (nor an error in one restore anything of the setter's) assert

count /d0 exch def
{ /xf.inner load settransfer } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside one gives its own back) assert

% and the sampling refusing on what the procedure returned is the
% setter's own refusal, so the procedure comes back
count /d0 exch def
{ /xf.bad load settransfer } stopped pop
count d0 sub 1 eq
    { /xf.bad load eq }{ d0 wrongdepth } ifelse
    (settransfer refusing on what the procedure left gives it back) assert
{ { } settransfer } stopped pop

/sp.stop  { pop pop stop } def
/sp.inner { pop pop /zzz /zzz findresource } def

count /d0 exch def
/sp.sentinel
{ 60 45 /sp.stop load setscreen } stopped pop
count d0 sub 1 eq
    { /sp.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a spot function restores nothing of setscreen's) assert

count /d0 exch def
{ 60 45 /sp.inner load setscreen } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside a spot function gives its own back) assert

count /d0 exch def
{ 60 (notanangle) { pop pop 0.5 } setscreen } stopped pop
count d0 sub 3 eq
    { length 3 eq exch (notanangle) eq and exch 60 eq and }
    { d0 wrongdepth } ifelse
    (setscreen refusing on an operand gives its operands back) assert
{ 60 45 { pop pop 0.5 } setscreen } stopped pop

% The four-channel setters sample a procedure per colour component and
% stand behind the same boundary, whichever component's procedure fails.
% The counter beside each is what says the procedure was reached: a
% setter that recorded without ever calling would leave the same depth
% behind for the opposite reason, and read as a pass.

/xc.hit 0 def
/xc.ok    { pop 0.5 } def
/xc.stop  { /xc.hit xc.hit 1 add store pop stop } def
/xc.err   { /xc.hit xc.hit 1 add store pop zzundefinedname } def
/xc.inner { /xc.hit xc.hit 1 add store pop /zzz /zzz findresource } def
/xc.oks    { pop pop 0.5 } def
/xc.sstop  { /xc.hit xc.hit 1 add store pop pop stop } def
/xc.sinner { /xc.hit xc.hit 1 add store pop pop /zzz /zzz findresource } def

/xc.hit 0 def
count /d0 exch def
/xc.sentinel
{ /xc.stop load /xc.ok load /xc.ok load /xc.ok load setcolortransfer }
    stopped pop
count d0 sub 1 eq
    { /xc.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a colour transfer restores nothing of setcolortransfer's) assert
xc.hit 0 gt (and the procedure that stopped was reached) assert

/xc.hit 0 def
count /d0 exch def
/xc.sentinel
{ /xc.ok load /xc.ok load /xc.ok load /xc.stop load setcolortransfer }
    stopped pop
count d0 sub 1 eq
    { /xc.sentinel eq }{ d0 wrongdepth } ifelse
    (nor does one in the grey channel of it) assert
xc.hit 0 gt (and that procedure was reached too) assert

/xc.hit 0 def
count /d0 exch def
/xc.sentinel
{ /xc.err load /xc.ok load /xc.ok load /xc.ok load setcolortransfer }
    stopped pop
count d0 sub 1 eq
    { /xc.sentinel eq }{ d0 wrongdepth } ifelse
    (nor an error in one restore anything of the setter's) assert
xc.hit 0 gt (and the procedure that raised it was reached) assert

/xc.hit 0 def
count /d0 exch def
{ /xc.inner load /xc.ok load /xc.ok load /xc.ok load setcolortransfer }
    stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside a colour transfer gives its own back) assert
xc.hit 0 gt (and the procedure it was called from was reached) assert

% the sampling refusing on what a channel's procedure returned is the
% setter's own refusal, so all four procedures come back
count /d0 exch def
{ /xc.ok load /xc.ok load /xc.ok load { pop (notanumber) } setcolortransfer }
    stopped pop
count d0 sub 4 eq
    { length 2 eq exch /xc.ok load eq and exch /xc.ok load eq and
      exch /xc.ok load eq and }{ d0 wrongdepth } ifelse
    (setcolortransfer refusing on a result gives its operands back) assert
{ { } settransfer } stopped pop

/xc.hit 0 def
count /d0 exch def
/xc.sentinel
{ 60 45 /xc.sstop load 60 45 /xc.oks load 60 45 /xc.oks load
  60 45 /xc.oks load setcolorscreen } stopped pop
count d0 sub 1 eq
    { /xc.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a colour spot restores nothing of setcolorscreen's) assert
xc.hit 0 gt (and the spot function that stopped was reached) assert

/xc.hit 0 def
count /d0 exch def
/xc.sentinel
{ 60 45 /xc.oks load 60 45 /xc.oks load 60 45 /xc.oks load
  60 45 /xc.sstop load setcolorscreen } stopped pop
count d0 sub 1 eq
    { /xc.sentinel eq }{ d0 wrongdepth } ifelse
    (nor does one in the grey channel of it) assert
xc.hit 0 gt (and that spot function was reached too) assert

/xc.hit 0 def
count /d0 exch def
{ 60 45 /xc.sinner load 60 45 /xc.oks load 60 45 /xc.oks load
  60 45 /xc.oks load setcolorscreen } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside a colour spot gives its own back) assert
xc.hit 0 gt (and the spot function it was called from was reached) assert

count /d0 exch def
{ 60 45 /xc.oks load 60 45 /xc.oks load 60 45 /xc.oks load
  60 (notanangle) /xc.oks load setcolorscreen } stopped pop
count d0 sub 12 eq
    { /xc.oks load eq exch (notanangle) eq and exch 60 eq and
      exch /xc.oks load eq and exch 45 eq and exch 60 eq and
      exch /xc.oks load eq and exch 45 eq and exch 60 eq and
      exch /xc.oks load eq and exch 45 eq and exch 60 eq and }
    { d0 wrongdepth } ifelse
    (setcolorscreen refusing on an operand gives its operands back) assert
{ 60 45 { pop pop 0.5 } setscreen } stopped pop

/cs.go false def
/cs.sep [ /Separation /Spot /DeviceGray { pop stop } ] def
/cs.dn  [ /DeviceN [ /Ca /Cb /Cc ] /DeviceGray
          { cs.go { pop pop pop stop } if pop pop pop 0.5 } ] def
/cs.dni [ /DeviceN [ /Ca /Cb /Cc ] /DeviceGray
          { cs.go { pop pop pop /zzz /zzz findresource } if
            pop pop pop 0.5 } ] def

count /d0 exch def
/cs.sentinel
{ cs.sep setcolorspace } stopped pop
count d0 sub 1 eq
    { /cs.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a tint transform restores nothing of setcolorspace's) assert
initgraphics

{ cs.dn setcolorspace } stopped pop
/cs.go true def
count /d0 exch def
/cs.sentinel
{ 0.1 0.2 0.3 setcolor } stopped pop
count d0 sub 1 eq
    { /cs.sentinel eq }{ d0 wrongdepth } ifelse
    (nor does one restore anything of setcolor's) assert
/cs.go false def
initgraphics

{ cs.dni setcolorspace } stopped pop
/cs.go true def
count /d0 exch def
{ 0.1 0.2 0.3 setcolor } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside a tint transform gives its own back) assert
/cs.go false def
initgraphics

count /d0 exch def
{ 0.1 0.2 (notanumber) setcolor } stopped pop
count d0 sub 3 eq
    { (notanumber) eq exch 0.2 eq and exch 0.1 eq and }
    { d0 wrongdepth } ifelse
    (setcolor refusing on an operand gives its operands back) assert
initgraphics

% --- the enumerators and the painters that call back ------------------
%
% The four operators below hand control to a procedure of the program's
% in the middle of a body of their own: pathforall calls one of four per
% path element, resourceforall calls one per instance it matched, cshow
% calls one per character, and execform calls the form's paint
% procedure. Each stands behind the same boundary as image and the
% setters above, and is asserted the same way.
%
% They are worth stating separately because each reaches its procedure
% through machinery of its own -- a dictionary scope dropped and taken
% back, a compiled program, an offscreen device -- and a boundary is
% easy to leave out of one of those without leaving it out of the rest.

newpath 0 0 moveto 100 100 lineto 50 90 20 30 10 10 curveto closepath
/pf.drop { pop pop } def
/pf.drop6 { 6 { pop } repeat } def

count /d0 exch def
/pf.sentinel
{ { pop pop stop } /pf.drop load /pf.drop6 load { } pathforall } stopped pop
count d0 sub 1 eq
    { /pf.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a pathforall procedure restores nothing of pathforall's) assert

count /d0 exch def
/pf.sentinel
{ { pop pop zzundefinedname } /pf.drop load /pf.drop6 load { } pathforall }
    stopped pop
count d0 sub 1 eq
    { /pf.sentinel eq }{ d0 wrongdepth } ifelse
    (nor does an error in one restore anything of pathforall's) assert

count /d0 exch def
{ { pop pop /zzz /zzz findresource } /pf.drop load /pf.drop6 load { } pathforall }
    stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside one gives its own back) assert

count /d0 exch def
{ { } { } { } (notaprocedure) pathforall } stopped pop
count d0 sub 4 eq
    { (notaprocedure) eq exch length 0 eq and
      exch length 0 eq and exch length 0 eq and }
    { d0 wrongdepth } ifelse
    (pathforall refusing on an operand gives its operands back) assert
newpath

% resourceforall enumerates a category that is always populated: the
% categories themselves. The counter says the procedure was reached, so
% an enumeration that matched nothing cannot read as a pass.

/rf.hit 0 def
count /d0 exch def
/rf.sentinel
{ (*) { /rf.hit rf.hit 1 add store pop stop } 65 string /Category resourceforall }
    stopped pop
count d0 sub 1 eq
    { /rf.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a resourceforall procedure restores nothing of its own) assert
rf.hit 0 gt (and the procedure that stopped was reached) assert

/rf.hit 0 def
count /d0 exch def
{ (*) { /rf.hit rf.hit 1 add store pop /zzz /zzz findresource }
  65 string /Category resourceforall } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside one gives its own back) assert
rf.hit 0 gt (and that procedure was reached too) assert

count /d0 exch def
{ (*) { pop } 65 string (notacategory) resourceforall } stopped pop
count d0 sub 4 eq
    { (notacategory) eq exch length 65 eq and
      exch length 1 eq and exch (*) eq and }
    { d0 wrongdepth } ifelse
    (resourceforall refusing on an operand gives its operands back) assert

% cshow reaches its procedure from a program it compiles, which runs
% with the machinery's dictionary already gone.

/Helvetica findfont 12 scalefont setfont
/cw.hit 0 def
count /d0 exch def
/cw.sentinel
{ { /cw.hit cw.hit 1 add store pop pop pop stop } (A) cshow } stopped pop
count d0 sub 1 eq
    { /cw.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a cshow procedure restores nothing of cshow's) assert
cw.hit 0 gt (and the procedure that stopped was reached) assert

/cw.hit 0 def
count /d0 exch def
{ { /cw.hit cw.hit 1 add store pop pop pop /zzz /zzz findresource } (A) cshow }
    stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside one gives its own back) assert
cw.hit 0 gt (and that procedure was reached too) assert

count /d0 exch def
{ { pop pop pop } (notastring) 0 get cshow } stopped pop
count d0 sub 2 eq
    { 110 eq exch length 3 eq and }{ d0 wrongdepth } ifelse
    (cshow refusing on an operand gives its operands back) assert

% execform paints the form's procedure through a bounding box of its
% own, and on some paths through an offscreen device.

/ef.form { % {paintproc}  .  formdict
    /ef.p exch def
    << /FormType 1 /BBox [ 0 0 8 8 ] /Matrix [ 1 0 0 1 0 0 ]
       /PaintProc /ef.p load >>
} def

initgraphics
count /d0 exch def
/ef.sentinel
{ { pop stop } ef.form execform } stopped pop
count d0 sub 1 eq
    { /ef.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a paint procedure restores nothing of execform's) assert

initgraphics
count /d0 exch def
/ef.sentinel
{ { pop zzundefinedname } ef.form execform } stopped pop
count d0 sub 1 eq
    { /ef.sentinel eq }{ d0 wrongdepth } ifelse
    (nor does an error in one restore anything of execform's) assert

initgraphics
count /d0 exch def
{ { pop /zzz /zzz findresource } ef.form execform } stopped pop
count d0 sub 2 eq
    { /zzz eq exch /zzz eq and }{ d0 wrongdepth } ifelse
    (an operator refusing inside one gives its own back) assert

initgraphics
count /d0 exch def
{ (notaform) execform } stopped pop
count d0 sub 1 eq
    { (notaform) eq }{ d0 wrongdepth } ifelse
    (execform refusing on its operand gives it back) assert
initgraphics

% --- a procedure is not an operator -----------------------------------
%
% Nothing is handed back for a procedure. A stop or an error inside one
% leaves the operand stack as the failure found it: what the procedure
% pushed stays, and what it consumed stays consumed. That holds whether
% the procedure stands where it runs, is reached through a name, or is
% fetched from a dictionary, and it holds for a procedure a control
% operator is running.

count /d0 exch def
{ 1 2 3 stop } stopped pop
count d0 sub 3 eq
    { 3 eq exch 2 eq and exch 1 eq and }{ d0 wrongdepth } ifelse
    (a stop in a procedure leaves what the procedure pushed) assert

count /d0 exch def
{ [1 2] 0 zzundefinedname } stopped pop
count d0 sub 2 eq
    { 0 eq exch dup length 2 eq exch 1 get 2 eq and and }
    { d0 wrongdepth } ifelse
    (an error in a procedure leaves what the procedure pushed) assert

/pr.stop { 44 55 stop } def
count /d0 exch def
{ 11 22 pr.stop } stopped pop
count d0 sub 4 eq
    { 55 eq exch 44 eq and exch 22 eq and exch 11 eq and }
    { d0 wrongdepth } ifelse
    (a procedure a name resolves to is still a procedure) assert

/pr.err { 44 55 zzundefinedname } def
count /d0 exch def
{ 11 22 pr.err } stopped pop
count d0 sub 4 eq
    { 55 eq exch 44 eq and exch 22 eq and exch 11 eq and }
    { d0 wrongdepth } ifelse
    (and so is one that fails rather than stops) assert

count /d0 exch def
{ 5 dict dup /zzk { stop } put dup /zzk get exec } stopped pop
count d0 sub 1 eq
    { type /dicttype eq }{ d0 wrongdepth } ifelse
    (a procedure fetched from a dictionary is still a procedure) assert

count /d0 exch def
/fa.sentinel
{ [10 20 30] { pop stop } forall } stopped pop
count d0 sub 1 eq
    { /fa.sentinel eq }{ d0 wrongdepth } ifelse
    (a stop in a forall procedure restores nothing of forall's) assert

% --- what a successful call leaves ------------------------------------
%
% The copies are taken on every call and let go on every return, so a
% call that does not fail is unaffected by them, and the ones taken for
% it do not outlive it: a call made after many others has room for its
% own, which it would not if theirs were still held.

/.sigok /.sigok { add 1 add } [ /anytype /anytype ] ID /.wrapopsig get exec def
count /d0 exch def
0 1 2000 { pop 2 3 .sigok pop } for
count d0 sub 0 eq (a call that does not fail leaves nothing) assert
2 3 .sigok 6 eq (and answers what it was written to answer) assert
count /d0 exch def
{ 1 2 .sigargs } stopped pop
count d0 sub 2 eq
    { 2 eq exch 1 eq and }{ d0 wrongdepth } ifelse
    (and the copies are still there for a call that does fail) assert

verdict
