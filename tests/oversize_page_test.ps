% A page the device cannot build leaves the interpreter able to build the
% next one. Run against a live device (-d <dev>) by
% run-oversize-page-test.sh: prints SUCCESS iff every step holds.
%
% A page size is the program's own data, so a program may ask for one no
% device can build, and PLRM 3.7.1 leaves VMerror an error like any
% other: the program catches it and carries on. Carrying on means the
% memory the refused page would have taken is still there for the page
% after it.
%
% The devices asked the whole of this are the ones whose page is built
% out of the interpreter's virtual memory -- they carry the array of row
% storage, ImgData -- because they are the ones with virtual memory in
% the page to lose. That storage is global VM, which save and restore are
% defined not to reach (PLRM 3.7.2), so a mark made inside a save is still
% on the page after the restore that ends it. A device that allocated
% rows one at a time until the memory ran out would ask the system for
% everything it could get before failing, and answer the same error at
% the end of it. A device whose page is a buffer outside
% virtual memory has no virtual memory in the page to give back and
% answers for its buffer elsewhere; it still runs everything below that
% does not depend on the page being virtual memory.
%
% The page asked for is 65535 by 65535, the largest page this interpreter
% can name: a composite holds 65535 elements in the ordinary build, so no
% row and no array of rows can be longer than that. At one byte a pixel
% it comes to 4,294,836,225 bytes, and an object addresses its memory
% file through an unsigned 32-bit offset, so the smallest raster that
% page could possibly need already runs past the end of the file it would
% have to live in. No build holds it and no host supplies it.
%
% What the refusal cost is counted in entities rather than in bytes.
% Every row is one composite and so one entity, which makes the count the
% direct measure of how much of the raster was built before the error;
% and it is a number that survives the measurement, where the byte figure
% vmstatus reports is a signed integer that a raster filling the address
% space wraps right past.

% COLLECTION: measured insensitive to collection frequency -- the same
% result with no collection at all and with one every two thousand
% bytes. What it reads memory for is a refusal, not a quantity.

/failures 0 def
/note { (FAIL: ) print print (\n) print /failures failures 1 add store } bind def
/assert { % bool (what went wrong)  .  -
    exch { pop }{ note } ifelse
} bind def

/getdevice { DEVICE } bind def
/ents { 1183615869 internaldict /.vmentcount get exec exch pop } bind def

% the components a device reports for one pixel, added up. Any change to
% the page changes the sum, which is all this needs of it, and adding is
% the one thing that reads the same for one component and for three.
/pixsum { % x y  .  sum
    getdevice dup /GetPix get exec
    0 getdevice /.ncomp get { exch add } repeat
} bind def

% Whether this device's page is virtual memory this run can read and
% account for. Three of the roster's devices keep their page as rows of
% the interpreter's own memory; the rest keep a buffer of their own, or
% paint nothing, and there is no entity count to compare.
%
% Two things have to hold and the second is asked of the interpreter
% rather than guessed from a key the device happens to carry: the device
% keeps its rows where this run can reach them, and it is holding the
% whole page rather than a band of it. A device holding a band has no
% ceiling for the refusal below to find -- one band is one band whatever
% the page is -- so the largest page this interpreter can name is a page
% it builds rather than one it refuses, and there is no cost of a
% refusal to weigh.
/raster getdevice /ImgData known
    currentsystemparams /CurBandHeight get 0 eq and def
/refused 0 def

% Said out loud, because the comparison this file exists to make is
% inside it. A roster on which no device kept its page in virtual memory
% would make that comparison nowhere and print exactly what a clean tree
% prints; the wrapper counts these and holds them to a floor.
(RASTER ) print raster { (yes) }{ (no) } ifelse = flush

raster {
    /e0 ents def
    % An operator that fails part way leaves its own working operands
    % behind; stopped reports the failure but does not rewind the stack.
    { << /PageSize [65535 65535] >> setpagedevice } stopped
        { clear }
        { (the largest page this interpreter can name was built) note }
    ifelse
    /refused ents e0 sub def
} if

% Every device: an ordinary page, of the size and shape any job asks for,
% must still be built and must still take a mark.
/e1 ents def
{ << /PageSize [200 200] >> setpagedevice } stopped
    { clear (an ordinary page could not be built after the refused one) note }
    {
        newpath 0 setgray 0 0 200 100 rectfill

        % Where the page is virtual memory it can be read back: the fill
        % covers half of it, so a pixel from each half must differ.
        raster {
            100 50 pixsum  100 150 pixsum  ne
                (the mark made after the refused page did not reach the page)
            assert
        } if

        showpage
    }
ifelse
/ordinary ents e1 sub def

% The refused page has 65535 rows and the page that was built has 200, so
% a refusal that began building costs entities by the thousand where the
% ordinary page costs them by the hundred. Refusing the larger page for
% less than building the smaller one is the whole of what "it took
% nothing" means here, and it is a comparison between two things this run
% measured rather than a figure written down in advance.
raster {
    refused ordinary lt
        (the refused page allocated more than the page that was built)
    assert
} if

count 0 eq (operand stack unbalanced) assert

failures 0 eq { (SUCCESS) = }{ (FAILURES: ) print failures == } ifelse
