%!testlib
%!
% Every colour space, asked the same questions.
%
% A colour space is a family of eleven members, and the machinery that
% cares tests each by name at the site that cares -- fifty-four such
% tests across six files. Nothing enumerates the family, so a member is
% reached by whichever sites its author thought of, and a member no site
% thought of is reached by none.
%
% That is not hypothetical. An uncoloured pattern over a Separation,
% DeviceN or Indexed base raised dictstackunderflow, and those are three
% of the four members that exist nowhere as data: they are only inline
% name tests. A member with no data representation is one nobody can
% enumerate, so nobody crossed them with the pattern machinery.
%
% This asks every member the questions the family is asked, so that a
% member cannot answer differently from the rest merely because no site
% was written for it. The answers here are what the interpreter gives
% today; where one is wrong it is to be corrected here and in the
% machinery together.

% A CONSTRUCTOR per member, not a shared value: a case that mutates or
% poisons its space cannot reach the next one.
/members [
    (DeviceGray)   { /DeviceGray }
    (DeviceRGB)    { /DeviceRGB }
    (DeviceCMYK)   { /DeviceCMYK }
    (CIEBasedA)    { [ /CIEBasedA <<
                       /WhitePoint [0.9505 1.0 1.089] >> ] }
    (CIEBasedABC)  { [ /CIEBasedABC <<
                       /WhitePoint [0.9505 1.0 1.089] >> ] }
    % The two pre-extensions carry a lookup table their colour is read
    % out of, so they are the only members whose construction is more
    % than a name and a range. PLRM 4.8.3: a DEF table is an array of
    % NH strings of 3 x NI x NJ bytes, a DEFG table an array of NH
    % arrays of NI strings of 3 x NJ x NK bytes -- one more level of
    % nesting, which is the difference between the two families.
    (CIEBasedDEF)  { [ /CIEBasedDEF <<
                       /WhitePoint [0.9505 1.0 1.089]
                       /Table [ 2 2 2
                         [ <000000FF000000FF000000FFFF>
                           <FFFFFF808080404040000000FF> ] ] >> ] }
    (CIEBasedDEFG) { [ /CIEBasedDEFG <<
                       /WhitePoint [0.9505 1.0 1.089]
                       /Table [ 2 2 2 2
                         [ [ <000000FF000000FF000000FFFF>
                             <FFFFFF808080404040000000FF> ]
                           [ <101010202020303030404040FF>
                             <505050606060707070808080FF> ] ] ] >> ] }
    (Indexed)      { [ /Indexed /DeviceRGB 1 <FF000000FF00> ] }
    (Separation)   { [ /Separation /Spot /DeviceGray { } ] }
    (DeviceN)      { [ /DeviceN [ /A /B ] /DeviceRGB
                       { pop pop 0.0 0.0 0.0 } ] }
    (Pattern)      { [ /Pattern ] }
] def

/eachmember {                           % { name proc }  .  -
    /body exch def
    0 2 members length 2 sub {
        /i exch def
        members i get members i 1 add get body
    } for
} bind def

% ---- every member is accepted by setcolorspace
{                                       % (name) { space }  .  -
    /sp exch def /nm exch def
    { sp setcolorspace } outcome /ok eq
    nm (is accepted by setcolorspace) assert2
} eachmember

% ---- and what it reports can be handed straight back to it
{
    /sp exch def /nm exch def
    { sp setcolorspace currentcolorspace setcolorspace } outcome /ok eq
    nm (survives a currentcolorspace round trip) assert2
} eachmember

% ---- and it is entered holding a colour, whatever that colour is.
%      A pattern space holds the null pattern until one is set, so one
%      element is the floor every member clears.
{
    /sp exch def /nm exch def
    /n 0 def
    gsave
        { sp setcolorspace } stopped { clear }{
            count /before exch def
            { currentcolor } stopped { clear }{
                /n count before sub def
            } ifelse
            clear
        } ifelse
    grestore
    n 0 gt
    nm (enters its space holding a colour) assert2
} eachmember

% ---- only a pattern space takes null as a colour
%
% PLRM 4.9.1 gives the null object a meaning in a Pattern space and only
% there: it is the colour the space is entered holding, it stands for an
% empty tiling pattern, and a program may set it back with setcolor. No
% other family gives it one, so setcolor's operand statement admits null
% for every space and the operator narrows it to the one that has a
% meaning for it.
%
% Asked of every member rather than of the pattern alone, because the
% statement is about the whole family: the answer that would go wrong
% quietly is another space starting to accept null and painting
% something undefined with it.
{
    /sp exch def /nm exch def
    { sp setcolorspace null setcolor } outcome
    % which family this member is, asked of the space its constructor
    % built rather than read off a second list this test would have to
    % keep in step with the first
    gsave sp setcolorspace currentcolorspace 0 get grestore
    /Pattern eq { /ok }{ /typecheck } ifelse
    eq
    nm (answers for null exactly as its family should) assert2
} eachmember

% and the pattern space's own null round-trips through currentcolor,
% which is what makes the entered colour and a program-set one the same
% value rather than two that merely both paint nothing
{ [ /Pattern ] setcolorspace currentcolor } outcome /ok eq
(Pattern) (reports the colour it was entered holding) assert2
[ /Pattern ] setcolorspace currentcolor type /nulltype eq
(Pattern) (is entered holding the null object itself) assert2
{ [ /Pattern ] setcolorspace currentcolor setcolor } outcome /ok eq
(Pattern) (takes that colour back through setcolor) assert2

% ---- and every member answers the operators that ask after the
% current colour in a device space
%
% PLRM 8.2 has currentgray, currentrgbcolor, currentcmykcolor and
% currenthsbcolor report the current colour converted to their own
% space, and says they cannot convert from a CIE-based or special one.
% Cannot convert is not the same as cannot answer: what a program reads
% then is the colour the graphics state starts at, and a program asking
% after the current colour has no obligation to ask what space it is in
% first. So every member answers all four, and the answer is a number.
%
% Asked of every member because the family is what makes it a rule. The
% one member that refused was the pattern space, which is the member
% that has no components to convert -- and it refused by raising
% undefined, which is neither a conversion nor an answer. Nothing else
% in the family behaved that way, and nothing said the pattern space
% should.
{
    /sp exch def /nm exch def
    { sp setcolorspace currentgray pop } outcome /ok eq
    nm (answers currentgray) assert2
    { sp setcolorspace currentrgbcolor pop pop pop } outcome /ok eq
    nm (answers currentrgbcolor) assert2
    { sp setcolorspace currentcmykcolor pop pop pop pop } outcome /ok eq
    nm (answers currentcmykcolor) assert2
    { sp setcolorspace currenthsbcolor pop pop pop } outcome /ok eq
    nm (answers currenthsbcolor) assert2
} eachmember

% and the pattern space, which has no components to convert, answers
% with the colour the graphics state starts at
[ /Pattern ] setcolorspace currentgray 0.0 eq
(Pattern) (answers currentgray with black) assert2
[ /Pattern ] setcolorspace currentrgbcolor
    0.0 eq exch 0.0 eq and exch 0.0 eq and
(Pattern) (answers currentrgbcolor with black) assert2
[ /Pattern ] setcolorspace currentcmykcolor
    1.0 eq exch 0.0 eq and exch 0.0 eq and exch 0.0 eq and
(Pattern) (answers currentcmykcolor with black) assert2

% ---- a tint space's transform must be a procedure
%
% PLRM 4.8.5 gives Separation a tintTransform and DeviceN a
% tintTransform, and both are procedures the interpreter calls to reach
% the alternative space. A value that is not a procedure cannot be
% called, so a space carrying one is not a colour space; the refusal
% belongs where the space is set, because that is the last moment the
% program is still holding the operator that supplied it.
%
% The two special colorant names do not exempt it. PLRM 4.8.5 says a
% Separation named All or None ignores the alternative space and the
% transform, "though dummy values must still be provided" -- a dummy
% that could never be called is not a value of the right kind, and a
% space accepted here would be accepted for every colorant name alike.
{ [ /Separation /Spot /DeviceGray 42 ] setcolorspace } outcome /typecheck eq
(Separation) (refuses a tint transform that is not a procedure) assert2
{ [ /Separation /None /DeviceGray 42 ] setcolorspace } outcome /typecheck eq
(Separation /None) (refuses one too, its transform being unused not unneeded) assert2
{ [ /Separation /All /DeviceGray 42 ] setcolorspace } outcome /typecheck eq
(Separation /All) (refuses one too) assert2
{ [ /DeviceN [ /A /B ] /DeviceRGB 42 ] setcolorspace } outcome /typecheck eq
(DeviceN) (refuses a tint transform that is not a procedure) assert2

% and a procedure is still accepted, so the check refuses only what it means to
{ [ /Separation /Spot /DeviceGray { } ] setcolorspace } outcome /ok eq
(Separation) (still takes a procedure) assert2
{ [ /DeviceN [ /A /B ] /DeviceRGB { pop pop 0 0 0 } ] setcolorspace } outcome /ok eq
(DeviceN) (still takes a procedure) assert2

% ---- what may sit beneath a space that is built over another one
%
% Four of the eleven are built over another colour space: an Indexed
% space over its base, a Separation and a DeviceN over their alternative,
% a Pattern over the space its uncoloured cells paint with. Not every
% space may sit there, and each of the four admits a different set:
%
%   PLRM 4.8.4  an Indexed base is any device or CIE-based space, or a
%               Separation or DeviceN, but not a Pattern and not another
%               Indexed
%   PLRM 4.8.5  a Separation or DeviceN alternative is any device or
%               CIE-based space and no special space at all
%   PLRM 4.9.2  the space underlying a Pattern may not be a Pattern
%
% Asked as a product -- every member under every one of the four -- for
% the reason this file exists. It is three rules of one shape, and a rule
% of that shape is enforced wherever somebody wrote a test for it: a
% Pattern under a Pattern was accepted while a Pattern under an Indexed
% was refused, and nothing could see the difference, because no site
% asked the same question of the second family that it asked of the
% first.
%
% BOTH directions, since a rule that refuses too much is as wrong as one
% that refuses too little: a member the specification admits beneath a
% family must still be accepted there.
%
% The refused sets are written out as the specification writes them, as
% family names -- not as a classification this file would then have to
% keep in step with the interpreter's own.

/inset {                                % name array  .  bool
    /theset exch def /wanted exch def
    false theset { wanted eq or } forall
} bind def

/beneath {                    % { composed } [refused] (refused) (taken)  .  -
    /takenmsg exch def /refusedmsg exch def
    /refused exch def /composed exch def
    fam refused inset {
        { /composed load exec setcolorspace } outcome /rangecheck eq
        nm refusedmsg assert2
    }{
        { /composed load exec setcolorspace } outcome /ok eq
        nm takenmsg assert2
    } ifelse
} bind def

{
    /sp exch def /nm exch def
    % which family this member is, asked of the space its constructor
    % built rather than read off a second list this test would have to
    % keep in step with the first
    gsave sp setcolorspace currentcolorspace 0 get grestore /fam exch def

    % How many components a colour in this member takes, MEASURED from
    % the colour the space is entered holding rather than listed. The
    % composed spaces below are only well-formed if what sits beneath
    % them is fed the number of components it consumes -- a palette
    % entry that wide, a tint transform returning that many -- and a
    % member fed the wrong number would be reported as refused by the
    % rule when it was refused for being malformed.
    gsave
        count /before exch def
        sp setcolorspace currentcolor
        count before sub /ncomp exch def
        ncomp { pop } repeat
    grestore
    /tint [ /pop cvx ncomp { 0.0 } repeat ] cvx def
    /palette ncomp 2 mul string def

    { [ /Indexed sp 1 palette ] }
        [ /Indexed /Pattern ]
        (is refused as an Indexed base)
        (is still taken as an Indexed base) beneath

    { [ /Separation /Spot sp /tint load ] }
        [ /Indexed /Separation /DeviceN /Pattern ]
        (is refused as a Separation alternative)
        (is still taken as a Separation alternative) beneath

    { [ /DeviceN [ /A ] sp /tint load ] }
        [ /Indexed /Separation /DeviceN /Pattern ]
        (is refused as a DeviceN alternative)
        (is still taken as a DeviceN alternative) beneath

    { [ /Pattern sp ] }
        [ /Pattern ]
        (is refused as the space under a Pattern)
        (is still taken as the space under a Pattern) beneath
} eachmember

% and a space that names itself is one of those compositions, whichever
% family it is -- a special space beneath a special space. So the rule
% above is what refuses it, rather than a walk that would otherwise
% follow it round with no end, over an operand a program writes in two
% lines.
{ /c [ /Indexed /DeviceRGB 1 <000000000000> ] def c 1 c put c setcolorspace }
    outcome /rangecheck eq
(Indexed) (naming itself as its own base is refused) assert2
{ /c [ /Separation /Spot /DeviceGray { } ] def c 2 c put c setcolorspace }
    outcome /rangecheck eq
(Separation) (naming itself as its own alternative is refused) assert2
{ /c [ /DeviceN [ /A ] /DeviceGray { } ] def c 2 c put c setcolorspace }
    outcome /rangecheck eq
(DeviceN) (naming itself as its own alternative is refused) assert2
{ /c [ /Pattern null ] def c 1 c put c setcolorspace }
    outcome /rangecheck eq
(Pattern) (naming itself as its own underlying space is refused) assert2

% ---- and a colour space is read, never run
%
% PLRM 8.2 states setcolorspace's operand as an array, and an array may
% be executable. What is inside it is the program's, so the space is
% looked at and never executed -- including the space beneath it, which
% reaches the same reader by a different route.
{ [ /Pattern { (a colour space was RUN\n) print /DeviceGray } ] setcolorspace }
    outcome /typecheck eq
(Pattern) (does not run a procedure handed to it as its underlying space) assert2
{ [ /Indexed { (a colour space was RUN\n) print /DeviceGray } 1 <00> ]
  setcolorspace } outcome /typecheck eq
(Indexed) (does not run a procedure handed to it as its base) assert2
{ [ /Separation /Spot { (a colour space was RUN\n) print /DeviceGray } { } ]
  setcolorspace } outcome /typecheck eq
(Separation) (does not run a procedure handed to it as its alternative) assert2
{ { (a colour space was RUN\n) print /DeviceGray } setcolorspace }
    outcome /typecheck eq
(a space) (that is itself a procedure is not run) assert2

% ---- and a CIE-based family's decode entries are procedures
%
% PLRM Tables 4.5 to 4.8 give DecodeA, DecodeABC, DecodeDEF, DecodeDEFG
% and DecodeLMN the type procedure. A value of another type is not one,
% and a number is the value that goes wrong in silence: executing a
% number leaves that number, so the component the decode was to have
% transformed becomes that constant, and every colour set in the space
% is wrong with nothing raised.
%
% Asked of each family with the entries that family carries, because the
% entry names are the whole difference between them -- and an entry one
% family carries and another does not is exactly the shape of thing that
% gets a check written for it once.

/WP [0.9505 1.0 1.089] def
/DEFTAB [ 2 2 2 [ <000000FF000000FF000000FFFF>
                  <FFFFFF808080404040000000FF> ] ] def
/DEFGTAB [ 2 2 2 2 [ [ <000000FF000000FF000000FFFF>
                       <FFFFFF808080404040000000FF> ]
                     [ <101010202020303030404040FF>
                       <505050606060707070808080FF> ] ] ] def

/decodes [
    (CIEBasedA)    { << /WhitePoint WP >> }
        [ (CIEBasedA DecodeA)      /DecodeA    42
          (CIEBasedA DecodeLMN)    /DecodeLMN  [ 1 2 3 ] ]
    (CIEBasedABC)  { << /WhitePoint WP >> }
        [ (CIEBasedABC DecodeABC)  /DecodeABC  [ 1 2 3 ]
          (CIEBasedABC DecodeLMN)  /DecodeLMN  [ 1 2 3 ] ]
    (CIEBasedDEF)  { << /WhitePoint WP /Table DEFTAB >> }
        [ (CIEBasedDEF DecodeDEF)  /DecodeDEF  [ 1 2 3 ]
          (CIEBasedDEF DecodeABC)  /DecodeABC  [ 1 2 3 ]
          (CIEBasedDEF DecodeLMN)  /DecodeLMN  [ 1 2 3 ] ]
    (CIEBasedDEFG) { << /WhitePoint WP /Table DEFGTAB >> }
        [ (CIEBasedDEFG DecodeDEFG) /DecodeDEFG [ 1 2 3 4 ]
          (CIEBasedDEFG DecodeABC)  /DecodeABC  [ 1 2 3 ]
          (CIEBasedDEFG DecodeLMN)  /DecodeLMN  [ 1 2 3 ] ]
] def

0 3 decodes length 3 sub {
    /di exch def
    /dnm decodes di get def
    /dbase decodes di 1 add get def
    /dents decodes di 2 add get def

    % the family with no decode entry at all is accepted, so what follows
    % refuses the entry rather than the family
    { [ dnm cvn dbase exec ] setcolorspace } outcome /ok eq
    dnm (is accepted carrying no decode entry) assert2

    0 3 dents length 3 sub {
        /ei exch def
        { [ dnm cvn dbase exec
            dup dents ei 1 add get dents ei 2 add get put ] setcolorspace }
        outcome /typecheck eq
        dents ei get (holds a number where the specification asks for a procedure) assert2
    } for
} for

% and a procedure is still taken, so the check refuses only what it means to
{ [ /CIEBasedA << /WhitePoint WP /DecodeA { } /DecodeLMN [ {} {} {} ] >> ]
  setcolorspace } outcome /ok eq
(CIEBasedA) (still takes procedures in its decode entries) assert2
{ [ /CIEBasedABC << /WhitePoint WP /DecodeABC [ {} {} {} ] >> ]
  setcolorspace } outcome /ok eq
(CIEBasedABC) (still takes procedures in its decode entries) assert2


% ---- an Indexed space's palette is as wide as its base
%
% PLRM 4.8.4 states the lookup string as being "of length m x (hival + 1),
% where m is the number of color components in the base color space". So
% the length the specification asks for is not a property of the Indexed
% space at all: it is the base's width multiplied by the number of
% entries, and a palette short of it is one whose last colours are read
% off the end of the string.
%
% Asked over every member that may be a base, for the reason the rule is
% written in terms of the base: m differs by member, from one for a
% device grey to four for a DeviceCMYK or a CIE pre-extension, and a
% check written against one member's width is a check that lets every
% wider member through. The width is MEASURED from the colour each space
% is entered holding rather than listed here, so a member whose width
% changes is asked the question its new width poses.
%
% The two members that may not be a base at all are left out: an Indexed
% base and a Pattern base are refused by the composition rule above,
% which would answer this product instead of the length rule.
%
% BOTH directions, since a palette of exactly the stated length is what
% every well-formed Indexed space carries.
{
    /sp exch def /nm exch def
    gsave sp setcolorspace currentcolorspace 0 get grestore /fam exch def
    fam [ /Indexed /Pattern ] inset not {
        gsave
            count /before exch def
            sp setcolorspace currentcolor
            count before sub /ncomp exch def
            ncomp { pop } repeat
        grestore
        % hival 1, so the palette holds two entries and the length the
        % specification asks for is 2m -- and 2m - 1 is a palette whose
        % second colour is one byte short of being there
        { [ /Indexed sp 1 ncomp 2 mul string ] setcolorspace } outcome /ok eq
        nm (is taken as an Indexed base under a palette of m x (hival + 1) bytes) assert2
        { [ /Indexed sp 1 ncomp 2 mul 1 sub string ] setcolorspace }
            outcome /rangecheck eq
        nm (is refused as an Indexed base under a palette one byte shorter) assert2
    } if
} eachmember

% ---- and hival is an integer index the specification admits
%
% PLRM 4.8.4: "The hival parameter is an integer that specifies the
% maximum valid index value", and "hival can be no greater than 4095,
% which is what would be required to index a table with 12-bit color
% sample values." An integer is the type, and 4095 is the bound; a value
% past it is a table wider than any sample can address, and a value of
% another type is not an index at all.
{ [ /Indexed /DeviceRGB 4096 40000 string ] setcolorspace } outcome /rangecheck eq
(Indexed) (refuses a hival above the 4095 PLRM 4.8.4 caps it at) assert2
{ [ /Indexed /DeviceRGB 4095 12288 string ] setcolorspace } outcome /ok eq
(Indexed) (still takes the largest hival PLRM 4.8.4 admits) assert2
{ [ /Indexed /DeviceRGB 1.5 <FF000000FF00> ] setcolorspace } outcome /typecheck eq
(Indexed) (refuses a hival that is not an integer) assert2
{ [ /Indexed /DeviceRGB 1 <FF000000FF00> ] setcolorspace } outcome /ok eq
(Indexed) (still takes an integer hival) assert2

% ---- and lookup is a string or a procedure, and nothing else
%
% PLRM 4.8.4 gives the colour table two forms and no third: "the lookup
% parameter, which can be either a procedure or a string". A number there
% is the value that goes wrong furthest from its cause -- executing it
% leaves that number on the stack, so the base space is handed one
% component where it wanted three and the program is told about it by
% whichever painting operator got there first.
{ [ /Indexed /DeviceRGB 1 42 ] setcolorspace } outcome /typecheck eq
(Indexed) (refuses a lookup that is neither a string nor a procedure) assert2
{ [ /Indexed /DeviceRGB 1 { pop 0 0 0 } ] setcolorspace } outcome /ok eq
(Indexed) (still takes a procedure as its lookup) assert2

% ---- a tint space names its colorants, and a colorant name is a name
%      or a string
%
% PLRM 4.8.5 states a Separation's name parameter as "a name or string
% object specifying the name of the colorant", and adds that "Name and
% string objects can be used interchangeably as names". The DeviceN
% entry states the same of every element of its names array: "an array of
% colorant names, specified as name or string objects."
%
% One statement over two families, so it is asked of both. Which is the
% point of asking it here rather than at either family's own site: the
% two carry their colorants differently -- one singly, one in an array --
% and a rule about what a colorant name is that is written where the
% carriage is written is a rule that gets written once.
%
% BOTH directions: both forms the specification admits must still be
% taken, since a spot colour whose name carries a space can only be given
% as a string.
/colorant null def
/namedtint [
    (Separation) { [ /Separation /colorant load /DeviceGray { } ] }
    (DeviceN)    { [ /DeviceN [ /colorant load ] /DeviceGray { } ] }
] def

/eachtint {                             % { name proc }  .  -
    /tbody exch def
    0 2 namedtint length 2 sub {
        /ti exch def
        namedtint ti get namedtint ti 1 add get tbody
    } for
} bind def

{
    /mk exch def /tnm exch def
    /colorant /Spot def
    { /mk load exec setcolorspace } outcome /ok eq
    tnm (takes a name where PLRM 4.8.5 asks for a colorant name) assert2
    /colorant (Spot colour) def
    { /mk load exec setcolorspace } outcome /ok eq
    tnm (takes a string there too, the two being interchangeable) assert2
    /colorant 42 def
    { /mk load exec setcolorspace } outcome /typecheck eq
    tnm (refuses a number there, which is neither) assert2
} eachtint

% ---- and a DeviceN carries its colorants in an array of at least one
%
% PLRM 4.8.5: "The names parameter in the color space array passed to
% setcolorspace is an array of colorant names... The length of the array
% determines the number of components, and hence the number of operands
% required by the setcolor operator when this space is the current color
% space."
%
% So the array is what prices the space, and the two ways of getting it
% wrong are both silent. A bare name where the array belongs is counted
% by its own length, because a name has one -- so a colorant called Gold
% prices the space at four components and reads four operands off the
% stack. An empty array prices it at none: setcolor reads nothing, the
% tint transform is called with nothing, and the space names no colorant
% to paint with. The first is the wrong type of object; the second is the
% right type carrying a value the family admits no space at, so it is
% refused as out of range.
{ [ /DeviceN /A /DeviceGray { } ] setcolorspace } outcome /typecheck eq
(DeviceN) (refuses a names parameter that is not an array) assert2
{ [ /DeviceN [ ] /DeviceGray { } ] setcolorspace } outcome /rangecheck eq
(DeviceN) (refuses an empty names array, which names no colorant and prices the space at none) assert2
{ [ /DeviceN [ /A /B ] /DeviceRGB { pop pop 0 0 0 } ] setcolorspace } outcome /ok eq
(DeviceN) (still takes an array of colorant names) assert2
{ [ /DeviceN [ (A) (B) ] /DeviceRGB { pop pop 0 0 0 } ] setcolorspace } outcome /ok eq
(DeviceN) (still takes them as strings) assert2

% PLRM 4.8.4 gives the colorant name All a meaning the tint transform has no
% part in: painting in it "appl[ies] tint values to all available colorants
% at once", and the space "ignore[s] the alternativeSpace and tintTransform
% parameters (though dummy values must still be provided)". So the transform
% below, which answers white whatever it is given, must not be consulted --
% a tint of one is full ink and a tint of a half is half of it. The same
% transform under an ordinary colorant name is consulted, which is what
% makes this a test of the name rather than of the tint.
[ /Separation /All /DeviceGray { pop 1 } ] setcolorspace
1 setcolor currentgray 0.0 sub abs 0.001 lt
(Separation /All) (paints full ink at a tint of one, where its transform says white) assert2
[ /Separation /All /DeviceGray { pop 1 } ] setcolorspace
0.5 setcolor currentgray 0.5 sub abs 0.001 lt
(Separation /All) (carries the tint itself, not the constant its transform returns) assert2
[ /Separation /Spot1 /DeviceGray { pop 1 } ] setcolorspace
1 setcolor currentgray 1.0 sub abs 0.001 lt
(Separation /Spot1) (still reaches its colour through its own tint transform) assert2

verdict
