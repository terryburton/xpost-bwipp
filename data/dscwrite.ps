%!PS
%
% dscwrite.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The dscwrite device: emit a DSC-conformant PostScript document from the recorded page.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading dscwrite.ps...)print } ifelse

currentdict .xpostsys begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  Make an instance of the DSC writer, which emits the page as
%  conforming PostScript: the class copied, with the extent it is asked
%  for written onto the copy.
%
%  This is the maker the page-device machinery reaches: init.ps files it
%  in .devicemakers under the name a -d option or a setpagedevice
%  request selects the device by, and calls it through privatedict.
%
.privatedict /newDSCWRITEdevice {  % width height  .  IMAGE-device-dict
    .privatedict /.xpost_DSCWRITE get dup /Create get exec
} put

%
%  .xpost_DSCWRITE writes a DSC-conforming PostScript program of the marks the
%  pages received, in the manner of a distiller: a multi-page job collects every
%  page into one document by default -- each showpage appends a %%Page section
%  (.emitpage) and Destroy writes the %%Trailer -- and a %d in the output name
%  selects a file per page instead. Flat
%  path construction and painting under a prolog of short operator
%  names. It is the .xpost_PDFWRITE device wearing another wrapper -- the
%  marking methods and the content accumulator are inherited whole,
%  and the prolog defines the accumulated operators as procedures, so
%  the same content serves both syntaxes. Separation colour spaces
%  are not carried across; their paints arrive in the process colours
%  the tint transform yields, which render the same.
%
%  Emit reports the page size in points (unscaling the device
%  resolution carried in the defaultmatrix fixup, as the bbox device
%  does) and the content runs under a matrix taking the accumulator's
%  y-down device coordinates back to that page.
%
%  A method runs its body with the device dictionary current, and opens it
%  through the bracket that takes it off again however the body ends, error
%  included (.indict, callout.ps).
%
/.xpost_DSCWRITE .xpost_PDFWRITE dup length 2 add dict copy def

%
%  The output plumbing is inherited from that base: .vw (pdfwrite.ps)
%  appends a string to the shared vector output and carries the byte count.
%  This class overrides only what a DSC document states differently from a
%  PDF one -- the header, the operator prolog, and the per-page structure.
%

%
%  The process colour models a setpagedevice request may move this device
%  to. Said again rather than inherited, because a copy carries what it
%  was copied from and the class this one copies offers its three on the
%  strength of the PDF content operators; what this device offers them on
%  is its own prolog, which defines g, rg and k over setgray,
%  setrgbcolor and setcmykcolor, so a paint made in any of the three is
%  written in the space it was made in and read back in that space. A
%  prolog that stopped defining one of them would leave this claim
%  standing over an operator no reader is given.
%
.xpost_DSCWRITE /.colormodels << /Process true /DeviceRGB true /DeviceCMYK true >> put

%
%  The colour space this device's marking methods take components in,
%  which for a device offering process colour models is the model in
%  force rather than a fixed space. Said again rather than inherited for
%  the reason above: what it means here is that a paint is written in the
%  space it was made in, through this device's own prolog, and the class
%  this one copies means it of the PDF content operators. The two are the
%  same word for two mechanisms, and a device answering with a space
%  nobody stated is one whose colour pipeline was settled on another
%  device's behalf.
%
.xpost_DSCWRITE /nativecolorspace /Process put

%
%  No separation registry: paints fall back to process colours
%
.xpost_DSCWRITE /.registersep undef

%
%  No pattern construct either. This document is LanguageLevel 1, which
%  has no pattern operator and no pattern colour space, so there is
%  nothing for a reader of it to be handed a cell and a name for. The
%  class this one copies offers both, and a copy carries what it was
%  copied from, so the offer is withdrawn here: left standing, it would
%  put a cell and a paint naming it into a program whose prolog defines
%  neither. The pattern is decomposed into the fills it resolves to
%  instead, which is the route every device without the construct has.
%
.xpost_DSCWRITE /PatternOverlap undef
.xpost_DSCWRITE /PatternCell undef
.xpost_DSCWRITE /FillPattern undef
.xpost_DSCWRITE /.patterntell undef
.xpost_DSCWRITE /.patterntake undef

%
%  A paint states its colour only where the stream does not carry it
%  already, and what this stream carries is not what a PDF one does. The
%  prolog defines G over g, RG over rg and K over k, so the operators a
%  fill and a stroke are written with reach one PostScript operator and
%  set one colour: this language has a current colour where PDF has a
%  fill colour and a stroke colour. The two paints therefore answer to
%  one slot, and a fill following a stroke restates its colour rather
%  than being suppressed against a value the stroke has since replaced.
%
.xpost_DSCWRITE dup /.gsfill get /.gsstroke exch put

%
%  Take a whole sampled image and write it as one, rather than letting the
%  paint machinery decompose it into fills.
%
%  This device decomposes what LanguageLevel 1 cannot say -- shadings and
%  patterns have no operator there, so they become the fills they resolve
%  to. An image is not in that class: image and colorimage ARE
%  LanguageLevel 1, and decomposing one is throwing away an operator the
%  reader already has. It is also the case where decomposing costs most,
%  the fills being per sample: a 64 by 64 image measured 339KB of them
%  against 25KB for the page that drew it.
%
%  The decode is applied here rather than emitted, as the SVG writer does
%  and for the same reason: the operand form of image carries no Decode,
%  and the operand form is what keeps this to LanguageLevel 1.
%
.xpost_DSCWRITE /PaintImage {  % w h ncomp mat rows decode interp IMAGE  .  -
{ {diint didec dirows dim dinc dih diw}{exch def}forall

    % one byte-to-byte table per component, so the samples go out decoded
    /diluts [ 0 1 dinc 1 sub { /c exch def
        /dilt 256 string def
        0 1 255 { /v exch def
            dilt v
            v 255 div
            didec c 2 mul 1 add get didec c 2 mul get sub mul
            didec c 2 mul get add
            //.xpostsys /.c255 get exec
            put
        } for dilt
    } for ] def
    /dihex 2 string def

    .qsave

    % a rectangular clip travels with the paint; the painting operators
    % arrive pre-clipped and an image does not
    //.internaldict /.cliprect get exec {
        /dicy1 exch def /dicx1 exch def /dicy0 exch def /dicx0 exch def
        dicx0 .pdfnum ( ) .put dicy0 .pdfnum ( ) .put
        dicx1 dicx0 sub .pdfnum ( ) .put
        dicy1 dicy0 sub .pdfnum ( re\nW n\n) .put
    } if

    % image space to device space, so what follows draws in samples
    dim 0 get .pdfnum ( ) .put dim 1 get .pdfnum ( ) .put
    dim 2 get .pdfnum ( ) .put dim 3 get .pdfnum ( ) .put
    dim 4 get .pdfnum ( ) .put dim 5 get .pdfnum ( cm\n) .put

    % The matrix above put user space in samples, and the page opened with
    % the flip that carries y-down device units to the page -- so image
    % space and user space already agree here and the image matrix is the
    % identity. A second flip would stand the picture on its head.
    %
    % The samples are READ FROM THE FILE rather than carried in a string
    % literal. LanguageLevel 1 has no filters at all -- filter is a
    % LanguageLevel 2 operator, so ASCIIHexDecode is not available to a
    % reader held to 1 -- but currentfile and readhexstring are there, and
    % between them they are the level's own way of streaming samples.
    %
    % A literal would also not hold one. A composite object takes at most
    % 65535 elements here, so the hex of anything past about a hundred
    % samples square is a string the scanner refuses: the picture would
    % emit and then fail to be read back. Streaming has no such bound.
    (/dib ) .put diw dinc mul 20 string cvs .put ( string def\n) .put
    diw 20 string cvs .put ( ) .put
    dih 20 string cvs .put
    ( 8 [ 1 0 0 1 0 0 ] { currentfile dib readhexstring pop } ) .put
    dinc 1 eq
        { (image\n) .put }
        { (false ) .put dinc 20 string cvs .put ( colorimage\n) .put }
    ifelse

    % the samples, decoded, wrapped so no line runs away
    /dicol 0 def
    0 1 dih 1 sub { /diy exch def
        /dirow dirows diy get def
        0 1 dirow length 1 sub { /dii exch def
            diluts dii dinc mod get dirow dii get get
            /dib2 exch def
            dihex 0 (0123456789ABCDEF) dib2 -4 bitshift get put
            dihex 1 (0123456789ABCDEF) dib2 15 and get put
            dihex .put
            /dicol dicol 1 add def
            dicol 32 ge { (\n) .put /dicol 0 def } if
        } for
    } for
    dicol 0 gt { (\n) .put } if
    .qrestore
} //.indict exec } put

%
%  A stencil, as the stencil the language already has.
%
%  imagemask is a LanguageLevel 1 operator, so what arrives here goes out
%  as itself rather than as the runs it would otherwise be decomposed
%  into. Bitmap text is where that tells: a Type 3 font paints one stencil
%  per glyph, and a page of it came out as thousands of little rectangles
%  where one imagemask says the same thing.
%
%  The bits are the caller's, packed one row to a byte boundary, which is
%  the packing imagemask reads -- so they are written out as they stand
%  and no repacking is needed. The current colour is already set on the
%  page by whatever painted last, exactly as it is for the runs.
%
.xpost_DSCWRITE /PaintStencil {  % w h polarity mat data interp DEVICE  .  -
{ {dsint dsdata dsm dspol dsh dsw}{exch def}forall
    /dshex 2 string def

    .qsave

    % imagemask paints the current colour, which is the graphics state's
    % and not an operand: a stencil's bits say where, and the colour says
    % what. The painting path takes it from the state through rectfill,
    % so this takes it from the same place.
    /dsnc .ncomps def
    /dsg graphicsdict /currgstate get def
    dsg /colorcomp1 get
    dsnc 1 gt { dsg /colorcomp2 get dsg /colorcomp3 get } if
    dsnc 4 eq { dsg /colorcomp4 get } if
    .pdffillcolor

    % a rectangular clip travels with the paint, as it does for an image
    //.internaldict /.cliprect get exec {
        /dscy1 exch def /dscx1 exch def /dscy0 exch def /dscx0 exch def
        dscx0 .pdfnum ( ) .put dscy0 .pdfnum ( ) .put
        dscx1 dscx0 sub .pdfnum ( ) .put
        dscy1 dscy0 sub .pdfnum ( re\nW n\n) .put
    } if

    % image space to device space, so what follows draws in samples
    dsm 0 get .pdfnum ( ) .put dsm 1 get .pdfnum ( ) .put
    dsm 2 get .pdfnum ( ) .put dsm 3 get .pdfnum ( ) .put
    dsm 4 get .pdfnum ( ) .put dsm 5 get .pdfnum ( cm\n) .put

    % streamed for the same reason an image's samples are: a hex literal
    % long enough for a real stencil is one the scanner refuses
    (/dsb ) .put dsw 7 add 8 idiv 20 string cvs .put ( string def\n) .put
    dsw 20 string cvs .put ( ) .put
    dsh 20 string cvs .put ( ) .put
    dspol { (true) }{ (false) } ifelse .put
    ( [ 1 0 0 1 0 0 ] { currentfile dsb readhexstring pop } imagemask\n) .put

    /dscol 0 def
    0 1 dsdata length 1 sub { /dsi exch def
        /dsb2 dsdata dsi get def
        dshex 0 (0123456789ABCDEF) dsb2 -4 bitshift get put
        dshex 1 (0123456789ABCDEF) dsb2 15 and get put
        dshex .put
        /dscol dscol 1 add def
        dscol 32 ge { (\n) .put /dscol 0 def } if
    } for
    dscol 0 gt { (\n) .put } if
    .qrestore
} //.indict exec } put

%
%  A showpage emits the page, and one writer writes it either way: without a
%  %d in the output name the pages accumulate into the one DSC program opened
%  at Create and Destroy closes it, and with a %d every page is a program of
%  its own, on a file opened for it and closed before the next page begins.
%  Create, the Emit dispatcher, the beginning of a document, Destroy and the
%  shared record are inherited from the PDF device; only the writer that puts
%  a page into an open program, and the one that closes a program off, are
%  this format's own.
%

%
%  write a number to the accumulating file in two decimals at most
%
.xpost_DSCWRITE /.vwnum {  % num  .  -
    //.num2str exec .vw
} put

%
%  Append one page to the accumulating DSC program: the prolog of short
%  operator names once, then this page's %%Page section and its marks under the
%  matrix taking the accumulator's y-down device units back to the page. The
%  content is read here, as the page is emitted, before any restore the job runs.
%
.xpost_DSCWRITE /.emitpage {  % IMAGE  .  -
{
    % page size in points from the resolution fixup
    currentdict //.xpostsys /.devres-to-points get exec
    /sy exch def /sx exch def

    % Header and prolog once, at the first page (the resolution fixup is ready)
    //.vecout /headered get not {
        (%!PS-Adobe-3.0\n) .vw
        (%%Creator: Xpost\n) .vw
        (%%BoundingBox: 0 0 ) .vw
        width sx div ceiling cvi 20 string cvs .vw ( ) .vw
        height sy div ceiling cvi 20 string cvs .vw (\n) .vw
        (%%Pages: \(atend\)\n) .vw

        % The media the pages are for. A bounding box says where the marks
        % are; it does not say how big the paper is, and a consumer that
        % reads only the box has no way to tell a small page from a small
        % drawing on a large one.
        (%%DocumentMedia: Custom ) .vw
        width sx div ceiling cvi 20 string cvs .vw ( ) .vw
        height sy div ceiling cvi 20 string cvs .vw ( 0 \(\) \(\)\n) .vw

        (%%DocumentData: Clean7Bit\n) .vw
        (%%LanguageLevel: 1\n) .vw
        (%%EndComments\n) .vw
        (%%BeginProlog\n) .vw
        (/m { moveto } bind def\n) .vw
        (/l { lineto } bind def\n) .vw
        (/c { curveto } bind def\n) .vw
        (/h { closepath } bind def\n) .vw
        (/re { 4 2 roll moveto 1 index 0 rlineto\n) .vw
        (     0 exch rlineto neg 0 rlineto closepath } bind def\n) .vw
        (/f { fill } bind def\n) .vw
        (/f* { eofill } bind def\n) .vw
        (/q { gsave } bind def\n) .vw
        (/Q { grestore } bind def\n) .vw
        (/W { clip } bind def\n) .vw
        (/W* { eoclip } bind def\n) .vw
        (/n { newpath } bind def\n) .vw
        (/S { stroke } bind def\n) .vw
        (/w { setlinewidth } bind def\n) .vw
        (/J { setlinecap } bind def\n) .vw
        (/j { setlinejoin } bind def\n) .vw
        (/M { setmiterlimit } bind def\n) .vw
        (/g { setgray } bind def\n) .vw
        (/rg { setrgbcolor } bind def\n) .vw
        (/k { setcmykcolor } bind def\n) .vw
        (/G /g load def /RG /rg load def /K /k load def\n) .vw
        (/cm { 6 array astore concat } bind def\n) .vw
        (%%EndProlog\n) .vw

        % And the size as something that runs, not only as something that
        % is read. The comments above are for a spooler; an interpreter
        % handed this file executes it, and without this it would lay a
        % page of one size out on a page of whatever size it defaults to.
        % A feature block is where the structuring conventions put a
        % request like this, so a consumer that would rather choose the
        % medium itself can find it and take it out.
        (%%BeginSetup\n) .vw
        (%%BeginFeature: *PageSize Custom\n) .vw
        (<< /PageSize [ ) .vw
        width sx div ceiling cvi 20 string cvs .vw ( ) .vw
        height sy div ceiling cvi 20 string cvs .vw
        ( ] >> setpagedevice\n) .vw
        (%%EndFeature\n) .vw
        (%%EndSetup\n) .vw

        //.vecout /headered true put
    } if

    % This page (label and ordinal both the running page number)
    //.vecout /np get 1 add /pn exch def
    (%%Page: ) .vw pn 20 string cvs .vw ( ) .vw pn 20 string cvs .vw (\n) .vw
    (%%PageBoundingBox: 0 0 ) .vw
    width sx div ceiling cvi 20 string cvs .vw ( ) .vw
    height sy div ceiling cvi 20 string cvs .vw (\n) .vw

    % The marks position themselves: the accumulator opens with the matrix
    % taking its y-down device units to the page. A device resolution above
    % one-to-one unscales first, so the output page stays in points.
    sx 1 ne sy 1 ne or {
        1 sx div .vwnum ( ) .vw 1 sy div .vwnum ( scale\n) .vw
    } if
    currentdict //.internaldict /.pdfchunks get exec { .vw } forall

    (showpage\n) .vw
    (%%PageTrailer\n) .vw

    % Advance the page count; start the next page fresh
    //.vecout dup /np get 1 add /np exch put
    .streamreset
} //.indict exec } put

%
%  Close the accumulating DSC program: the trailer carries the real page count
%  the header deferred with (atend).
%
.xpost_DSCWRITE /.endfile {  % IMAGE  .  -
{
    //.vecout /headered get not {
        (%!PS-Adobe-3.0\n%%Creator: Xpost\n%%Pages: \(atend\)\n%%EndComments\n) .vw
        //.vecout /headered true put
    } if
    (%%Trailer\n) .vw
    (%%Pages: ) .vw //.vecout /np get 20 string cvs .vw (\n) .vw
    (%%EOF\n) .vw
    //.vecout /F get dup (%stdout) (w) file ne { closefile }{ pop } ifelse
} //.indict exec } put

end end

//.internaldict /QUIET known { }{ (eof dscwrite.ps\n)print } ifelse
