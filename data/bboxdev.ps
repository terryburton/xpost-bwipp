%!PS
%
% bboxdev.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The bounding-box device: measure the marks a page makes without rendering them.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% Copyright (c) 2026 Terry Burton
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading bboxdev.ps...)print } ifelse

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The names these procedures bind their operands to. Literal
%  arrays: a list forall walks is data, and a list in braces is an
%  executable array a body may not read once the machinery is closed.
%
.xpostsys /.bboxdevbind0 [ /h /w /y /x /val ] readonly put
.xpostsys /.bboxdevbind1 [ /y2 /x2 /y1 /x1 /val ] readonly put

%
%  Make an instance of the bounding-box device, which marks no pixels
%  and records the extent of what would have been painted: the class
%  copied, with the extent it is asked for written onto the copy.
%
%  This is the maker the page-device machinery reaches: init.ps files it
%  in .devicemakers under the name a -d option or a setpagedevice
%  request selects the device by, and calls it through privatedict.
%
.privatedict /newbboxdevice {  % width height  .  IMAGE-device-dict
    .privatedict /.xpost_BBOX get dup /Create get exec
} put

%
%  .xpost_BBOX computes the bounding box of all marks and prints it on Emit --
%  without rasterizing (NoOutput). Coordinates arrive in device space; Emit
%  reports them in default user space (y-up).
%
%  Methods are as for the other devices (see nulldev.ps), except the marking
%  methods accumulate a box rather than discarding their arguments. The page
%  clear must not contribute to the box, so the device carries an Erase no-op
%  and erasepage never reaches the marking methods.
%
%  A method runs its body with the device dictionary current, and opens it
%  through the bracket that takes it off again however the body ends, error
%  included (.indict, callout.ps).
%
%  Glyphs need no rasterization here -- whose cost grows with the square of
%  the resolution -- so the device declares /GlyphExtents: each glyph
%  contributes its ink box through FillRect instead.
%
/.xpost_BBOX <<
    /nativecolorspace /DeviceGray
    /dimensions [0 0]
    /NoOutput true  % Accumulate coordinates only; never rasterize
    /GlyphExtents true  % Text marks contribute outline ink boxes, not bitmaps

    % Whether a white mark counts. A page-device request saying so
    % writes over this as it is copied, which is the one way it is ever
    % anything else; declared here so a method reads it rather than
    % asking whether it is there.
    /WhiteIsOpaque false

    /.copydict //.classcopydict
    /.instance //.classinstance

    /Create {  % width height IMAGE  .  IMAGE'
        //.classinstance exec
        dup 8 {
            .state /minx 1e30 put   % Empty box: min > max
            .state /miny 1e30 put
            .state /maxx -1e30 put
            .state /maxy -1e30 put
        } //.indevwork exec
    }

    /Destroy {  % IMAGE  .  -
        pop
    }

    % Does this colour mark the box? Pure white marks only when the
    % device carries /WhiteIsOpaque true; the default is false (white
    % ignored), so crop-style boxes exclude painted white. Anything else
    % always marks.
    /.opaque {  % val  .  bool
        1 lt WhiteIsOpaque or
    }

    % Expand the box to include a device-space point
    % The extent is written on every mark and read at the end, so it
    % outlives the call and is named where such a thing lives: the state
    % beside the device. Not left to the dictionary stack -- a state put
    % above the device shadows the device, and a name a body reads
    % unqualified would then be a name a program can supply.
    /.maxmin {  % x y  .  -
        2 copy
        dup .state /maxy get gt { .state exch /maxy exch put }{ pop } ifelse
        dup .state /maxx get gt { .state exch /maxx exch put }{ pop } ifelse
        dup .state /miny get lt { .state exch /miny exch put }{ pop } ifelse
        dup .state /minx get lt { .state exch /minx exch put }{ pop } ifelse
    }

    /PutPix {  % val x y IMAGE  .  -
        8 {
            3 -1 roll .opaque { .maxmin }{ pop pop } ifelse
        } //.indevwork exec
    }

    /GetPix {  % x y IMAGE  .  val
        pop pop pop  0
    }

    /DrawLine {  % val x1 y1 x2 y2 IMAGE  .  -
        8 { //.bboxdevbind1 {exch def} forall
            val .opaque {
                x1 y1 .maxmin
                x2 y2 .maxmin
            } if
        } //.indevwork exec
    }

    /DrawRect {  % val x y w h IMAGE  .  -
        8 { //.bboxdevbind0 {exch def} forall
            val .opaque {
                x y .maxmin
                x w add  y h add  .maxmin
            } if
        } //.indevwork exec
    }

    % The page clear (erasepage) is not a mark
    % Clearing the page empties the box with it: what the box states is
    % the extent of the marks the page holds, and a cleared page holds
    % none. erasepage is the one event that says so -- copypage
    % transmits a page without ending it (PLRM 8.2) and leaves the marks
    % where they are, so a box carried across one is the box of
    % everything still on the page, which is what it should be.
    %
    % A device holding pixels clears them here. This one holds only the
    % extent, so the extent is what it clears, back to the empty box
    % Create starts from.
    /Erase {  % IMAGE  .  -
        8 {
            .state /minx 1e30 put
            .state /miny 1e30 put
            .state /maxx -1e30 put
            .state /maxy -1e30 put
        } //.indevwork exec
    }

    % A whole path, taken exactly. The fill machinery offers the current
    % path to a device declaring FillPath whenever the clip is trivial
    % (paint.ps .devtakespath), and this device wants it because the box
    % a fill reaches is the box of its flattened outline's own vertices,
    % the same under either insideness rule -- the outermost boundary
    % borders the interior under both. Reading the vertices here keeps
    % the answer independent of the device resolution: the polygon route
    % resolves an even-odd interior into pixel-band rectangles first,
    % whose rows sit on the device grid, so the box it accumulates grows
    % with the coarseness of the grid. A fill under a non-trivial clip
    % still travels the polygon route, whose span intersection is exact
    % for the pixels painted. The colour gates the mark as everywhere on
    % this device: an unmarking white leaves the box alone.
    /FillPath {  % mark c1..cn IMAGE  .  mark
        8 {
            % The repeat loop stays. The index/roll/cleartomark form is
            % faster where the mark goes with the operands, but this keeps
            % the mark, which costs a second cleartomark and a fresh mark
            % and turns the saving round: measured over 200k iterations,
            % 41ms against 74 at one component above the mark, 74 against
            % 87 at three, 90 against 94 at four. A colour has at most
            % four components, so there is no count here at which the
            % other form wins.
            counttomark 1 sub { pop } repeat
            .opaque {
                flattenpath
                count /n0 exch def
                { .fillpolyargs } stopped {
                    count n0 sub { pop } repeat

                    % A path of more points than one polygon array
                    % describes: read the vertices off the path itself,
                    % a point at a time. An area-less subpath's points
                    % are counted this way where the polygon form drops
                    % them, so the box is never too small.
                    { transform .maxmin } dup {} {} pathforall
                }{
                    //.xpostsys /.polybounds get exec {
                        .maxmin .maxmin
                    } if
                } ifelse
            } if
        } //.indevwork exec
    }

    /FillRect {  % val x y w h IMAGE  .  -
        8 { //.bboxdevbind0 {exch def} forall
            val .opaque {
                x y .maxmin
                x w add  y h add  .maxmin
            } if
        } //.indevwork exec
    }

    /FillPoly {  % val polygon IMAGE  .  -
        8 {
            exch .opaque {
                {
                    dup type /arraytype eq {
                        dup length 2 eq { aload pop .maxmin }{ pop } ifelse
                    }{ pop } ifelse  % Null subpath separators fall here
                } forall
            }{
                pop
            } ifelse
        } //.indevwork exec
    }

    /Emit {  % IMAGE  .  -
        % The device's own scale, taken while the device is still the
        % thing on the stack: inside the bracket currentdict is the
        % state, and this asks the device.
        dup //.xpostsys /.devres-to-points get exec
        3 -1 roll 8 {
            /sy exch def /sx exch def
            .state /minx get .state /maxx get gt {  % Nothing was marked
                (%%BoundingBox: 0 0 0 0\n) print
                (%%HiResBoundingBox: 0 0 0 0\n) print
            }{
                % device -> default user space (points, y-up): unscale by
                % the device resolution and flip. The defaultmatrix fixup
                % applied after construction carries the scale; a raw
                % device is 1:1
                /uxmin .state /minx get sx div def
                /uxmax .state /maxx get sx div def
                /uymin height .state /maxy get sub sy div def
                /uymax height .state /miny get sub sy div def
                (%%BoundingBox: ) print
                uxmin floor cvi 20 string cvs print ( ) print
                uymin floor cvi 20 string cvs print ( ) print
                uxmax ceiling cvi 20 string cvs print ( ) print
                uymax ceiling cvi 20 string cvs print (\n) print
                (%%HiResBoundingBox: ) print
                uxmin 30 string cvs print ( ) print
                uymin 30 string cvs print ( ) print
                uxmax 30 string cvs print ( ) print
                uymax 30 string cvs print (\n) print
            } ifelse
        } //.indevwork exec
    }
>> def

end end end

//.internaldict /QUIET known { }{ (eof bboxdev.ps\n)print } ifelse
