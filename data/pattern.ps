%!PS
%
% pattern.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Tiling patterns (PLRM 4.9): makepattern, setpattern, and tiling the cells over a region.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% Copyright (c) 2026 Terry Burton
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading pattern.ps...)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  makepattern instantiates, setpattern
%  (color.ps) selects, and the painting operators tile the cells over
%  whatever region they would have painted.
%

%
%  The kind of pattern a dictionary describes. PLRM 4.9.1 defines two: 1 a
%  tiling pattern, 2 a shading pattern, and nothing else.
%
%  The three faults are three different errors, because they are three
%  different mistakes. PLRM Table 4.9 marks the entry required, so a
%  dictionary without one is not a pattern dictionary and the entry is
%  undefined. The table types it as an integer, so a value of another type
%  is a type error. And a code this interpreter has no machinery to paint
%  is out of range -- refused here rather than painted as though it were
%  the other type, which is what a dictionary whose code is merely "not 2"
%  would otherwise get.
%
%  The operator to name is stated by the caller, so the program is told
%  about the operator it wrote rather than about whichever piece of this
%  file reached the dictionary.
%
%  What an ABSENT entry means is also the caller's to say, because it is
%  not the same fault at every operator. makepattern is handed a prototype
%  to check, and an entry its table marks required and the dictionary does
%  not carry is undefined. setpattern is handed something that must
%  already be a pattern -- PLRM 8.2 defines it as an equivalence for
%  setcolorspace and setcolor and gives it no error list of its own, and
%  says its operand is a dictionary instantiated by makepattern -- so a
%  dictionary carrying no type is not a deficient pattern but the wrong
%  kind of operand, which is a type error. PLRM leaves the error name
%  open and practice splits on it; what it does not leave open is that
%  only one place should know the vocabulary.
%
.xpostsys /.patterntype {  % dict /operator /absent  .  int
    3 -1 roll
    dup /PatternType known not
        { pop exch cvx exch signalerror } if
    /PatternType get
    dup type /integertype ne
        { pop pop cvx /typecheck signalerror } if
    dup 1 lt 1 index 2 gt or
        { pop pop cvx /rangecheck signalerror } if
    exch pop exch pop
} put

%
%  A required entry is there, or the program is told which one is not.
%
.xpostsys /.patternneed {  % dict /operator /entry  .  -
    3 -1 roll 1 index known not
        { exch cvx /undefined signalerror }{ pop pop } ifelse
} put

%
%  Instantiate a tiling pattern: a copy of the dictionary carrying the
%  pattern space -- the matrix concatenated with the CTM in effect
%  now, so later coordinate changes leave the tiling anchored -- under
%  /Implementation.
%
/makepattern [ /dicttype /arraytype ] {  % dict matrix  .  pattern
    exch
    dup /makepattern /undefined //.patterntype exec 2 eq {
        dup /makepattern /Shading //.patternneed exec
    }{
        % PLRM Table 4.9 marks six entries required of a tiling pattern.
        % They are asked for one at a time so the program is told which
        % one it left out rather than that something among six is absent.
        dup /makepattern /PaintProc   //.patternneed exec
        dup /makepattern /BBox        //.patternneed exec
        dup /makepattern /XStep       //.patternneed exec
        dup /makepattern /YStep       //.patternneed exec
        dup /makepattern /PaintType   //.patternneed exec
        dup /makepattern /TilingType  //.patternneed exec

        % TilingType names one of three spacings (PLRM 4.9.2). Nothing
        % here goes on to read it, which is the reason to ask for it
        % rather than a reason to let it pass: a program that names a
        % spacing that does not exist has written a pattern this
        % interpreter cannot be told how to tile.
        dup /TilingType get
        dup type /integertype ne { pop true }
                                 { dup 1 lt exch 3 gt or } ifelse {
            /makepattern cvx /rangecheck signalerror
        } if

        % PaintType says whether the cells carry their own colour or take
        % the colour set beneath them (PLRM Table 4.9), and there are two
        % of those. A third value would be read as one or the other by
        % whichever site asked, and the sites do not all ask alike.
        dup /PaintType get
        dup type /integertype ne { pop true }
                                 { dup 1 lt exch 2 gt or } ifelse {
            /makepattern cvx /rangecheck signalerror
        } if

        % XStep and YStep may be positive or negative but not zero (PLRM
        % Table 4.9): a step of zero describes a tiling whose cells never
        % advance. Refused here, because the tiling walk can only decline
        % to paint, and a page that silently loses a pattern is worse
        % than one that says why.
        dup /XStep get 0 eq 1 index /YStep get 0 eq or {
            /makepattern cvx /rangecheck signalerror
        } if
    } ifelse
    dup length 1 add dict copy
    exch matrix currentmatrix matrix concatmatrix
    1 index exch /Implementation exch put

    % PLRM 8.2: "Finally, makepattern makes the new dictionary read-only
    % and returns it." The instantiated pattern is this interpreter's
    % statement that the dictionary has been checked, and every later
    % site relies on that; a program that could rewrite the type
    % afterwards would reach machinery chosen for the type it no longer
    % has.
    readonly
} .defop

.xpostsys begin

%
%  Whether the current colour is a pattern.
%
/.patternactive {  % -  .  bool
    graphicsdict /currgstate get /colorspace get /Pattern eq
} def

%
%  How the current colour reaches the page, and the only place that
%  decides.
%
%  Every painting operator asked one question here -- is the colour a
%  pattern -- and took the device route when the answer was no. That left
%  no room for a third answer, and there is one: a colour that can never
%  produce visible output marks nothing, which is neither tiling a pattern
%  nor handing a colour to the device. Naming the three routes is what
%  makes the missing one expressible at every operator rather than at
%  whichever ones somebody remembered.
%
%  The pattern route is first because it already carries a case of the
%  third: the null pattern paints nothing, and it does so inside the
%  tiling walk, where a pattern space's own empty colour belongs.
%
/.colorroute {  % -  .  /pattern | /nomarks | /direct
    graphicsdict /currgstate get /colorspace get /Pattern eq { /pattern }{
    graphicsdict /currgstate get /setspace get
    //.spacenomarks exec { /nomarks }{ /direct } ifelse
    } ifelse
} def

%
%  What is known about a cell being captured, kept where the program
%  cannot take it back.
%
%  A cell is captured by running the paint procedure, which is the
%  program's, and a program may bracket one in save and restore. restore
%  reverts local virtual memory wholesale (PLRM 3.7.2), so a flag parked
%  there while the procedure runs is reverted with it and the capture
%  would be trusted on the strength of a note the procedure erased. This
%  dictionary is global, which restore leaves alone.
%
%  /incell says a capture is running, and /spoiled that something in it
%  cannot be carried. The cells below are what spoils one: a pattern's
%  space is fixed against the page when the pattern is instantiated, so a
%  pattern painted inside a cell is anchored to the page and not to the
%  cell around it, and marks made under it belong to coordinates the cell
%  is not written in. There is nothing wrong with the marks; they are
%  simply not the cell's. So the capture is dropped and the cells are
%  walked, which places every one of them against the page.
%
.jobstore /.cellstate << /incell false /spoiled false >> put

%
%  Tile the current pattern colour over the current clip region: every
%  cell whose pattern-space step position meets the region's box runs
%  the pattern's paint procedure under the pattern space translated to
%  its position, clipped to the cell's BBox. An uncoloured pattern's
%  cells paint with the underlying colour; a coloured pattern's
%  procedure sets its own (the colour is reset first, so a procedure
%  that paints without setting one cannot re-enter the tiling).
%  The whole walk goes through the bracket: each cell opens a graphics
%  state and a paint procedure that raises would otherwise leave it open,
%  with this procedure's own dictionary on the stack behind it.
%
/.patterntile {  % -  .  -
    //.cellstate /incell get { //.cellstate /spoiled true put } if
    {
    16 dict begin
    /pat graphicsdict /currgstate get /patdict get def
    pat null ne {
    /pm pat /Implementation get def
    pat /setcolor /undefined //.patterntype exec 2 eq {
        % A shading pattern: the shading paints the whole clip under
        % the pattern space, no cells to step.
        gsave
        pm setmatrix
        /sh pat /Shading get def

        % PLRM Table 4.11: a Background is laid over the whole area about
        % to be painted before the shading goes on, so that what the
        % gradient does not reach is that colour rather than the page.
        % It is the shading PATTERN that honours it; shfill is required
        % to ignore it (PLRM 8.2, shfill), and does, which is why this is
        % here and not there.
        sh /Background 2 copy known {
            get
            gsave
                sh /ColorSpace get setcolorspace
                aload pop setcolor
                clippath fill
            grestore
        }{ pop pop } ifelse

        sh shfill
        grestore
    }{
    /bb pat /BBox get def
    /xs pat /XStep get def
    /ys pat /YStep get def
    xs 0 ne ys 0 ne and {
        % The region's bounds, carried to pattern space: clip box
        % corners through the CTM to the device, then back through
        % the pattern space. A region covering no pixels bounds
        % nothing, and there is no cell of it for a cell to meet.
        gsave //.clipregionpath exec flattenpath
        .pathempty { grestore }{
        pathbbox grestore
        /uy1 exch def /ux1 exch def /uy0 exch def /ux0 exch def
        /im pm matrix invertmatrix def
        /px0 9e99 def /px1 -9e99 def /py0 9e99 def /py1 -9e99 def
        [ ux0 uy0 ux0 uy1 ux1 uy0 ux1 uy1 ]
        0 2 6 { /k exch def
            dup k get 1 index k 1 add get
            transform im transform
            dup py0 lt { dup /py0 exch def } if
            dup py1 gt { dup /py1 exch def } if
            pop
            dup px0 lt { dup /px0 exch def } if
            dup px1 gt { dup /px1 exch def } if
            pop
        } for
        pop
        /i0 px0 bb 2 get sub xs div floor cvi def
        /i1 px1 bb 0 get sub xs div ceiling cvi def
        /j0 py0 bb 3 get sub ys div floor cvi def
        /j1 py1 bb 1 get sub ys div ceiling cvi def

        % A degenerate mapping tiles without bound: refuse it
        i1 i0 sub 1 add j1 j0 sub 1 add mul dup 65536 le exch 0 gt and {
            /wasuncol //.uncoloredcell /on get def
            {
            i0 1 i1 { /i exch def
                j0 1 j1 { /j exch def
                    gsave
                    pm setmatrix
                    i xs mul j ys mul translate
                    newpath
                    bb 0 get bb 1 get moveto
                    bb 2 get bb 1 get lineto
                    bb 2 get bb 3 get lineto
                    bb 0 get bb 3 get lineto
                    closepath

                    %  A cell sharing no pixel with the region cannot
                    %  mark, and its procedure is not run. The walk steps
                    %  the cells over the region's bounding box, so a
                    %  region that is not its own box -- the outline of a
                    %  glyph, the notch of an L -- has cells falling
                    %  wholly outside it, and each of those would
                    %  otherwise paint a cell for the clip to throw away
                    %  whole. PLRM 4.9.2 has the paint procedure called
                    %  at unpredictable times and asks that it have no
                    %  effect beyond painting the cell, so a cell nothing
                    %  can show need not be painted.
                    .clipmisses { grestore }{
                    clip newpath
                    pat /PaintType get 2 eq {
                        graphicsdict /currgstate get /patbase get
                        dup null ne {
                            setcolorspace
                            graphicsdict /currgstate get /patcomps get
                            dup null ne { aload pop setcolor }{ pop } ifelse
                        }{ pop 0 setgray } ifelse
                    }{
                        0 setgray
                    } ifelse

                    % The paint procedure runs on the caller's stacks:
                    % its defs are its own, out of this dict's names.
                    //.uncoloredcell /on pat /PaintType get 2 eq put
                    pat dup /PaintProc get
                    null 1 //.pcallout exec
                    //.uncoloredcell /on wasuncol put
                    grestore
                    } ifelse
                } for
            } for
            } stopped
            //.uncoloredcell /on wasuncol put
            { stop } if
        } if
        } ifelse
    } if
    } ifelse
    } if
    end
    } null 0 //.callout exec
} def

%
%  Cut the clip down to the region the pattern will tile across, and
%  leave no current path behind.
%
%  The region resolves to its spans unconditionally: the shading and
%  cell fills intersect against the resolved form, where a raw path
%  stored by the trivial branch of clip would not combine.
%
/.patternclip {  % [spans]  .  -
    % The region is pixel-band spans, which no single path under the
    % nonzero rule describes: a device that clips for itself has no
    % shape to be given, and the one the caller's own clip left behind
    % is not this one.
    //.clipstoreparts exec
    graphicsdict /currgstate get /currpath get
    null //.setclipregion exec

    % And the region is not left standing in as the current path: a
    % segment appended to a path is written into the storage the path
    % already holds while there is room, so the cells about to be walked
    % would otherwise build on the very region they are being cut from.
    newpath
} def

%
%  Whether the cell reaches no further than the step between cells.
%
%  PLRM Table 4.9 lets XStep and YStep differ from the BBox, and a step
%  shorter than the box is a tiling whose cells overlap. A construct
%  whose tile is its step cannot say that -- what falls outside the tile
%  is where the next one begins -- and says so of itself
%  (/PatternOverlap); those patterns are painted by the walk below.
%
/.patternfits {  % pat  .  bool
    4 dict begin
    /p exch def
    /b p /BBox get def
    b 2 get b 0 get sub abs p /XStep get abs le
    b 3 get b 1 get sub abs p /YStep get abs le and
    end
} def

%
%  Whether the pattern in force reaches the device as a pattern, rather
%  than as the cells this file steps over the region.
%
%  A format with a tiling construct of its own holds the cell once and
%  tiles it over whatever the paint covers, so what the output carries
%  does not grow with the area painted. The cells stepped here do: one
%  shape per cell, and a cell for every step across the region. So where
%  a device offers the construct, the pattern goes that way.
%
%  What it asks of the pattern is that it is a tiling pattern (PLRM
%  4.9.1) -- a shading pattern paints a gradient across the whole region
%  and has no cell to hold -- and of the device that it would take the
%  path being painted whole, since what it is handed is that path and a
%  colour. A device answering no to either is painted by the walk below,
%  as it always has been.
%
/.patterndevice {  % pat  .  bool
    DEVICE /FillPattern known
    DEVICE /PatternCell known and
    DEVICE /.patterntell known and
    DEVICE /.patterntake known and
    DEVICE /PatternOverlap known and {
        dup /PatternType get 1 eq {
            DEVICE /PatternOverlap get
            { pop true }{ //.patternfits exec } ifelse
        }{ pop false } ifelse
        %  The pattern goes to the device as a resource only where the
        %  clip can be handed over with it. The page's own clip lets a
        %  DRAWING go over whole -- there is nothing to clip against --
        %  but it is not a region the cell can be filed under, and the
        %  walk below is what paints a cell beneath the region in force.
        DEVICE /FillPath known //.devhandsclip exec and and
    }{ pop false } ifelse
} def

%
%  Capture the current pattern's cell as the device's own content and
%  file it there, answering the name a paint refers to it by.
%
%  The device is handed device coordinates, so the transformation in
%  force during the capture is what decides the coordinates the cell is
%  written in, and the pattern space then travels to the device as a
%  matrix beside the cell rather than as the coordinates themselves. It
%  is a scaling and a shift and nothing else: the cell is written square
%  to its own axes whatever the pattern space does with it, which is what
%  lets the two steps go over as the program stated them.
%
%  The shift puts the cell's box at the origin. What the box is against
%  is the corner the cell is stepped from, and a construct that says
%  where its tile begins says it from that corner; a cell written about
%  the pattern space's origin instead would have to carry the offset to
%  it in every such statement.
%
%  The scale is the pattern space's own. A coordinate written into the
%  cell then carries what a coordinate written into the page carries: a
%  cell captured at unit scale under a pattern space that magnifies
%  would be written to a precision the magnification afterwards
%  multiplies, and the cell would land off the grid the rest of the page
%  is on. The larger of the two axis scales is taken, so neither axis is
%  the coarser for it.
%
%  The clip in force is the cell's box with room around it. It is a
%  rectangle so that what the paint procedure draws reaches the device
%  whole rather than resolved against a region; and it is wider than the
%  box because what falls outside the box is the consumer's to cut, the
%  format requiring the cell to be clipped to it (PLRM 4.9.2, and the
%  same of the construct written out).
%
/.patterncell {  % -  .  n true | false
    16 dict begin
    count /n0 exch def
    /pat graphicsdict /currgstate get /patdict get def
    /pm pat /Implementation get def
    /bb pat /BBox get def
    /bx0 bb 0 get bb 2 get 2 copy gt { exch } if pop def
    /bx1 bb 0 get bb 2 get 2 copy lt { exch } if pop def
    /by0 bb 1 get bb 3 get 2 copy gt { exch } if pop def
    /by1 bb 1 get bb 3 get 2 copy lt { exch } if pop def
    /sc pm 0 get dup mul pm 1 get dup mul add sqrt
       pm 2 get dup mul pm 3 get dup mul add sqrt
       2 copy lt { exch } if pop def

    % A pattern space that collapses has no scale to write the cell at,
    % and one that magnifies past what a coordinate can carry has no
    % useful one; the walk below paints those.
    sc 0 gt sc 1e30 lt and {
        /cm [ sc 0 0 sc bx0 sc mul neg by0 sc mul neg ] def
        false DEVICE dup /.patterntell get exec
    }{ false } ifelse
    {
        /at exch def
        /d0 countdictstack def

        % What a capture running inside this one was told, put back
        % however this one ends: the outer capture is the one still
        % standing, and what spoiled this one did not spoil that.
        /wasin //.cellstate /incell get def
        /wasbad //.cellstate /spoiled get def
        /wasuncol //.uncoloredcell /on get def
        //.cellstate /incell true put
        //.cellstate /spoiled false put
        {
            {
                gsave
                cm setmatrix

                % the cell's box with room around it, installed as the
                % region and handed over as the shape as well, so a
                % paint that does reach the edge reaches the device as a
                % path and a clip rather than as spans
                /mx bx1 bx0 sub dup 0 le { pop 1 } if def
                /my by1 by0 sub dup 0 le { pop 1 } if def
                newpath
                bx0 mx sub by0 my sub moveto
                bx1 mx add by0 my sub lineto
                bx1 mx add by1 my add lineto
                bx0 mx sub by1 my add lineto
                closepath
                graphicsdict /currgstate get /currpath get
                [ graphicsdict /currgstate get /currpath get .copypath false ]
                //.setclipregion exec
                newpath

                % An uncoloured pattern's cells take the colour set
                % beneath them (PLRM Table 4.9), which is painted into
                % the cell here: the cell filed is the cell in that
                % colour, and the same pattern in another colour files
                % another cell. A coloured pattern's procedure sets its
                % own (the colour is reset first, so a procedure that
                % paints without setting one cannot re-enter the tiling).
                pat /PaintType get 2 eq {
                    graphicsdict /currgstate get /patbase get
                    dup null ne {
                        setcolorspace
                        graphicsdict /currgstate get /patcomps get
                        dup null ne { aload pop setcolor }{ pop } ifelse
                    }{ pop 0 setgray } ifelse
                }{
                    0 setgray
                } ifelse

                % The paint procedure runs on the caller's stacks: its
                % defs are its own, out of this dict's names.
                //.uncoloredcell /on pat /PaintType get 2 eq put
                pat dup /PaintProc get
                null 1 //.pcallout exec
                //.uncoloredcell /on wasuncol put
                grestore
            } null 0 //.callout exec
        } stopped {
            % The capture is open and holds part of a cell, which is not
            % the page's content and must not be left in it; the
            % dictionaries and operands the failure left behind go with
            % it, and the caller is handed the failure it was owed.
            countdictstack d0 sub { end } repeat
            count n0 sub dup 0 gt { { pop } repeat }{ pop } ifelse
            at false DEVICE dup /.patterntake get exec pop
            //.cellstate /incell wasin put
            //.cellstate /spoiled wasbad put
            //.uncoloredcell /on wasuncol put
            end
            stop
        } if
        count n0 sub dup 0 gt { { pop } repeat }{ pop } ifelse
        /bad //.cellstate /spoiled get def
        at bad not DEVICE dup /.patterntake get exec /chunks exch def
        //.cellstate /incell wasin put
        //.cellstate /spoiled wasbad put
        //.uncoloredcell /on wasuncol put
        bad {
            % nothing filed: the cells are walked instead
            end false
        }{
        [ 0 0 bx1 bx0 sub sc mul by1 by0 sub sc mul ]
        pat /XStep get sc mul
        pat /YStep get sc mul
        pat /TilingType get
        cm matrix invertmatrix pm matrix concatmatrix
        chunks
        DEVICE dup /PatternCell get exec
        end true
        } ifelse
    }{ end false } ifelse
} def

%
%  Hand the fill to the device as a pattern, and say whether it went.
%
%  What the device is given is the path being painted and the cell,
%  which is what the construct is: a colour a fill is made in. So the
%  clip goes over the same way a fill of any other colour's does, and
%  the rule the path is read under travels with it.
%
/.patterndevfill {  % evenodd  .  bool
    graphicsdict /currgstate get /patdict get
    dup null eq { pop pop false }{
    //.patterndevice exec {
        % A fill that cannot reach the region marks nothing. The walk
        % below arrives at the same blank by resolving the fill against
        % the region and finding no span to paint; here the consumer
        % would be handed a fill and a clip that cancel and carry both
        % to reach it, so the question is asked outright.
        .clipmisses { pop flushpage true }{
        //.patterncell exec {
            exch graphicsdict /currgstate get /.eorule 3 -1 roll put
            //.devsendclip exec
            DEVICE dup /FillPattern get exec
            graphicsdict /currgstate get /.eorule false put
            true //.setpagemarked exec
            flushpage
            true
        }{ pop false } ifelse
        } ifelse
    }{ pop false } ifelse } ifelse
} def

%
%  Paint the current path with the pattern colour: the path becomes the
%  clip and the pattern tiles across it.
%
%  The walk goes through the bracket, because the cells it steps run the
%  program's paint procedure and that procedure may raise. The graphics
%  state opened here holds the caller's clip and the caller's path, and
%  the walk replaces both -- the clip with the region the cells are cut
%  to, the path with whatever a cell was building. An error carrying
%  past this point without the close would leave those in force: the
%  program catches the error (PLRM 3.11.1 leaves it free to), carries on
%  painting, and paints through a clip that is one fill's spans and no
%  part of its own state. Closing it here puts the caller's state back
%  however the walk ends, and the error goes on to the caller.
%
/.patternfill {  % -  .  -
    false //.patterndevfill exec not {
        {
            gsave
            flattenpath
            false //.fillsubjparts exec
            //.clippartsmeet exec
            //.patternclip exec
            //.patterntile exec
            grestore
        } null 0 //.callout exec
    } if
    newpath
} def

%
%  The same, under the even-odd rule.
%
/.patterneofill {  % -  .  -
    true //.patterndevfill exec not {
        {
            gsave
            flattenpath
            true //.fillsubjparts exec
            //.clippartsmeet exec
            //.patternclip exec
            //.patterntile exec
            grestore
        } null 0 //.callout exec
    } if
    newpath
} def
end

end end end

%
%  The pattern types this file implements, as PLRM Table 3.8 has a program
%  ask after them (see the note in shade.ps): 1 tiling, 2 shading.
%
currentglobal true setglobal
[ 1 2 ] { dup /PatternType defineresource pop } forall
setglobal

//.internaldict /QUIET known { }{ (eof pattern.ps\n)print } ifelse
