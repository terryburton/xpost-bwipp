%!PS
% image.ps
%
% The raster device base classes: Create through Emit, the scanline and pixel machinery.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading image.ps...\n)print } ifelse

% Everything here defines into global VM.
true setglobal

% A raster class is one method suite --
% Create through Emit, the scanline plot machinery and the pixel
% accessors -- over a handful of parameters: the colour space, the
% number of colour components a paint delivers (.ncomp), how a scanline
% row is allocated and what it costs, how components store into a row
% and read back out of it, the coverage blender, and the page writer.
% .rasterproto holds the suite once; .makerasterclass builds a class
% from a parameter dictionary. The grayscale and rgb classes below are
% parameter files over this generator, and the bilevel and TIFF classes
% are dict-copies of those with the emission overridden.
%
% A method runs its body with a dictionary current -- the device's own,
% or a scratch one where the body wants somewhere of its own to work --
% and every one of them opens it through the bracket that takes it off
% again however the body ends, error included (.indict, graphics.ps).
%
% In the method comments, IMAGE is an instance returned by Create and
% c1..cN are the .ncomp colour components, each in [0,1].

(/qsort.ps) //.xpostsys /.loadmodule get exec


.xpostsys /.rasterproto <<
    /dimensions [0 0]

    % glyph edges blend by coverage against what the page holds; the
    % interior takes the solid PutPix path. Eight bits of that coverage,
    % which is every value a rasterised glyph carries and every value a
    % pixel storing a byte a component can be moved to.
    /TextAlphaBits 8

    /.copydict //.xpostsys /.classcopydict get

    /Create { % width height IMAGE  .  IMAGE'
    { {/height /width}{exch def}forall
    currentdict } //.xpostsys /.indict get exec
    dup /.copydict get exec
    {
        % The rows of the page this device holds. A program may declare
        % the page's imaging bounding box (PLRM 6.2), asserting that it
        % paints no marks outside it; PLRM 6.2 leaves a device free to
        % render or to drop the marks that do fall outside, so the rows
        % the box does not reach need not be held at all and the page
        % shows the ground over them instead.
        %
        % The run of rows is left for this device by the page device
        % that is making it, and taken here. Taken, and not merely read:
        % a device that holds its page some other way never asks for it,
        % and the next device made must not inherit a box that was not
        % asked of it.
        graphicsdict /.rasterband 2 copy known {
            2 copy get 3 1 roll undef aload pop
        }{ pop pop 0 height } ifelse
        /.bandrows exch def /.bandtop exch def
        % the run is held to the page, whatever named it
        .bandtop 0 lt .bandtop height ge or { /.bandtop 0 def } if
        .bandrows 1 lt { /.bandrows 1 def } if
        .bandtop .bandrows add height gt
            { /.bandrows height .bandtop sub def } if

        % raster memory is not part of VM (PLRM 3.7.3): allocate the
        % page buffer in global VM, which save and restore are defined not
        % to reach (PLRM 3.7.2, 3.7.3), so a mark made inside a save is
        % still on the page after the restore that ends it
        currentglobal true setglobal
        % The raster is priced before any of it is built: the ImgData
        % spine is one element per row of the page, each row held costs
        % what .rowcost says, and the whole extent is asked for at once.
        % One row beyond the run is the row carrying the ground every
        % row the device does not hold shows. A page this interpreter
        % cannot hold is refused having taken nothing to be refused
        % with, where one built row by row until the memory ran out
        % would ask the system for everything it could get before
        % failing, and answer the same error at the end of it.
        height                      % spine elements
        .rowcost                    % spine rowelements rowbytes
        .bandrows 1 add             % spine rowelements rowbytes rows
        dup 3 1 roll mul            % spine rowelements rows bytes
        3 1 roll mul                % spine bytes elements
        3 -1 roll add               % bytes elements'
        exch                        % elements' bytes
        //.internaldict /.vmreserve get exec not {
            setglobal
            /Create cvx /VMerror signalerror
        } if
        /ImgData height array def
        .bandtop 1 .bandtop .bandrows add 1 sub {
            ImgData exch .rowalloc put
        } for
        % One empty row stands for every row the device does not hold.
        % It is a row of the class's own shape carrying no pixel, so a
        % mark landing on such a row is dropped where every other
        % out-of-page mark is dropped: against the row it was about to
        % be written to. Carrying no pixel is what makes it safe to
        % share one of them across every row that is not held: a write
        % that reaches it lands nowhere, where a full-width row shared
        % the same way would take the mark and show it on every row
        % standing in through that same object.
        /.emptyrow .rowempty def
        0 1 .bandtop 1 sub { ImgData exch .emptyrow put } for
        .bandtop .bandrows add 1 height 1 sub
            { ImgData exch .emptyrow put } for
        % The ground the rows the device does not hold show. It is a row
        % of the class's own shape, laid out as a row that is held
        % starts, and erasepage fills it in through /Ground below. It is
        % held whether or not any row is standing in at this moment,
        % since which rows the device holds is not settled once at
        % Create: it is one row against a page, and having it costs less
        % than deciding twice whether to.
        /.groundrow .rowalloc def
        setglobal
    currentdict
    } //.xpostsys /.indict get exec } bind

    /Destroy { % IMAGE  .  -
        pop
    } bind

    % row  .rowclear  -
    % Leave a row as a row this device has just made. A string is
    % allocated zero, so a fresh row of the class's own shape is what a
    % row starts as, and one is kept to copy from: a raster standing for
    % one run of the page's rows after another has to start each run as
    % a fresh raster would, or what the run before painted shows through
    % wherever this one paints nothing.
    %
    % A row is a string or the array of planes a colour class keeps one
    % as, and either is cleared plane for plane against a row of the
    % same shape, so a class stating a row of its own is cleared by what
    % it states rather than by an assumption about its shape.
    /.rowclear { % row  .  -
        dup type /stringtype eq {
            0 .zerorow putinterval
        }{
            0 1 2 index length 1 sub {  % row i
                2 copy get 0            % row i plane 0
                .zerorow 3 index get    % row i plane 0 zeroplane
                putinterval pop         % row
            } for
            pop
        } ifelse
    } bind

    % top rows IMAGE  .moveband  -
    % Move the run of the page's rows this device holds.
    %
    % The rows are the ones Create made: one raster the size of a band,
    % standing for one run of the page after another, which is what
    % bounds what a page costs to put out. The rows a device holds are
    % asked of ImgData everywhere they are asked -- a mark is dropped
    % against the row it was about to be written to, and Emit lays the
    % ground over a row that carries no pixel -- so moving the run is
    % moving those rows within the spine and leaving the row that
    % carries no pixel behind at the positions given up.
    %
    % A raster per band would be the shorter way to say this and it does
    % not bound anything. A raster is taken from global virtual memory,
    % which a restore does not rewind (PLRM 3.7.3), and the collector
    % does reach that half -- but a device the page machinery has
    % retired stays reachable, so a collection reclaims none of it: four
    % devices made in turn grow global memory by every one of their
    % rasters, and a collection after them gives nothing back. A device
    % per band therefore leaves each band's rows behind and the loop
    % ends up holding the page it exists not to hold. Measured, not
    % assumed: tests/run-band-loop-test.sh.
    %
    % The run is held to the page and to the rows there are, so a caller
    % naming a run this raster cannot stand for gets the part of it that
    % it can rather than a write past the end of the spine.
    /.moveband { % top rows IMAGE  .  -
    {
        % the row to copy from, and the rows this device made, both
        % taken up at the first move: a device that never moves its band
        % pays nothing for the ability to.
        currentdict /.bandpool known not {
            currentglobal true setglobal
            /.zerorow .rowalloc def
            /.bandpool .bandrows array def
            setglobal
            0 1 .bandrows 1 sub {
                dup .bandtop add ImgData exch get
                .bandpool 3 1 roll put
            } for
        } if
        % the run given up shows the page's ground, which is the row
        % carrying no pixel every row this device does not hold shows
        .bandtop 1 .bandtop .bandrows add 1 sub {
            ImgData exch .emptyrow put
        } for
        /.bandrows exch def
        /.bandtop exch def
        .bandtop 0 lt { /.bandtop 0 def } if
        .bandtop height gt { /.bandtop height def } if
        .bandrows 0 lt { /.bandrows 0 def } if
        .bandtop .bandrows add height gt
            { /.bandrows height .bandtop sub def } if
        .bandrows .bandpool length gt { /.bandrows .bandpool length def } if
        0 1 .bandrows 1 sub {
            dup .bandtop add               % i row-index
            exch .bandpool exch get        % row-index row
            dup .rowclear
            ImgData 3 1 roll put
        } for
    } //.xpostsys /.indict get exec } bind

    /.to-int { floor cvi } bind

    % c  .chan  byte
    % the one fold from a colour component to a stored 8-bit channel.
    % The clamp is not decoration: setgray and its siblings substitute
    % the nearest valid value (PLRM 8.2), but a Separation or DeviceN
    % tint transform is the program's own procedure and returns whatever
    % it computes, so a component outside [0,1] does reach here. Scaled
    % without it, 1.7 stores as 0.69 of full scale, the byte having
    % wrapped past the top of its range. Truncation, not rounding, is
    % what the compiled fills do, so a page painted through either lands
    % on the same byte.
    /.unitclamp { % c  .  c'
        dup 0 lt { pop 0 }{ dup 1 gt { pop 1 } if } ifelse
    } bind
    /.chan { % c  .  byte
        .unitclamp 255 mul cvi
    } bind

    % c1..cN x y  .screenpix  c1'..cN' x y
    % The colour this class stores for a colour painted at a pixel. A
    % class that stores the colour it is handed answers it unchanged; a
    % class that screens answers what its screen leaves at that pixel,
    % which is a function of the position as well as of the colour. The
    % position is a whole one naming a pixel of the device plane, on the
    % page or off it, and it stays behind for the caller, which needs it
    % to reach the row.
    %
    % The write below and the read of a pixel this device holds no
    % storage for both come through here, so the two halves of a screened
    % page are read on the same terms: what a read answers where nothing
    % is stored is what a paint would have stored there, which is what an
    % emitted file carries there. A class states its screen once, in
    % here, rather than once for the paint and again for the read.
    /.screenpix { } bind

    % x y  .onpage  bool
    % Whether a device coordinate names a pixel of the page: the four
    % edges a mark is dropped at, as one answer, for the read that has
    % to go on and produce a value where a write simply stops. The
    % coordinates are tested as they arrive rather than after .to-int:
    % floor is monotone and the edges are whole numbers, so the two
    % orders answer alike, and a coordinate the page does not reach need
    % not be one an integer holds.
    /.onpage { % x y  .  bool
        dup 0 lt exch height ge or
        exch dup 0 lt exch width ge or
        or not
    } bind

    % x y  .groundpix  c1..cN
    % What the page shows at a pixel where this device holds no storage:
    % the colour erasepage last cleared the page to, as this class would
    % have stored it at that pixel, in the channel scale a stored pixel
    % reads back in. The colour goes through .screenpix on its way, the
    % same fold a paint takes, so a class whose stored colour depends on
    % the position answers here what stands at that position rather than
    % what stands at the page at large. The position is put on the pixel
    % grid first, which is the shape a paint reaches .screenpix in.
    %
    % A class whose fold cannot answer for the position leaves the colour
    % as it was recorded. A read is answered rather than refused, and a
    % screen the device cannot address is one the paint does not go
    % through either, so the unfolded colour is what the page carries
    % there.
    %
    % A device that has not been erased has no ground recorded, and its
    % rows stand as they were allocated, which is what it answers.
    /.groundpix { % x y  .  c1..cN
        currentdict /.ground known {
            mark 3 1 roll               % mark x y
            { .to-int exch .to-int exch % mark x y
              .ground aload pop         % mark x y c1..cN
              .ncomp 2 add .ncomp roll  % mark c1..cN x y
              .screenpix pop pop        % mark c1'..cN'
            } stopped {
                cleartomark
                .ground aload pop
            }{
                .ncomp 1 add .ncomp roll pop
            } ifelse
            % each component to its channel in turn, the ones behind it
            % rolling up to follow: .ncomp turns leave them as they lay
            .ncomp { .chan .ncomp 1 roll } repeat
        }{
            pop pop .ncomp { 0 } repeat
        } ifelse
    } bind

    % A mark aimed where this device keeps no pixel is dropped: off the
    % page, and on a row of the page the device does not hold. Each is
    % asked before the write rather than left to fail inside it, so that
    % the operands are still the ncomp+2 the cleanup below pops -- a row
    % carrying no pixel refuses the write partway through .rowput, by
    % which point the stack is a shape no fixed count of pops answers,
    % and what is left over lands in the operands of whatever called.
    /PutPix { % c1..cN x y IMAGE  .  -
    {
        {
            .to-int exch .to-int exch
            dup 0 lt { stop } if
            dup height ge { stop } if
            1 index 0 lt { stop } if
            1 index width ge { stop } if
            .screenpix                  % c1..cN x y
            ImgData exch get            % c1..cN x row
            dup .rowheld not { stop } if
            exch                        % c1..cN row x
            .ncomp 2 add 2 roll         % row x c1..cN
            .rowput
        } stopped {
            .ncomp 2 add { pop } repeat
        } if
    } //.xpostsys /.indict get exec } bind

    % A read answers what the page shows at the named pixel, and never
    % refuses: a mark aimed off the page is dropped, so a read from
    % there is answered the same way, with the ground. A row the device
    % does not hold is the page's own ground as well -- Emit lays it
    % into the file over those rows -- so the read agrees with the file
    % rather than refusing a pixel the file carries. The ground is
    % answered for the pixel that was asked about, not for the page at
    % large: where this class screens what it stores, what the page
    % shows differs from one pixel to the next.
    /GetPix { % x y IMAGE  .  c1..cN
    {
        2 copy .onpage {
            .to-int exch .to-int exch   % x y
            2 copy ImgData exch get     % x y x row
            dup .rowheld
                { 4 2 roll pop pop exch .rowget }
                { pop pop .groundpix }
            ifelse
        }{
            .groundpix
        } ifelse
    } //.xpostsys /.indict get exec } bind

    % The pixels a segment covers are the driver contract's (.linepix,
    % src/lib/xpost_dev_driver.h): the pixel centres the segment spans
    % along its major axis, clipped to the device. This method walks
    % them through PutPix; the window devices walk the same list through
    % their own plot. Neither states the rule.
    /DrawLine { % c1..cN x1 y1 x2 y2 IMAGE  .  -
    { {y2 x2 y1 x1}{exch def}forall .takecolor
        /lp x1 y1 x2 y2 width height //.internaldict /.linepix get exec def
        0 2 lp length 2 sub {
            /li exch def
            .pushcolor lp li get lp li 1 add get currentdict PutPix
        } for
    } //.xpostsys /.indict get exec } bind

    %  -----|
    %  |    |
    %  |    |
    %  |-----
    /DrawRect { % c1..cN x y w h IMAGE  .  -
    { {h w y x}{exch def}forall .takecolor
        0 1 h 1 sub {
            x 2 copy % h x h x
            exch y add .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
            w add
            exch y add 1 add .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
        } for
        1 1 w {
            x add y 2 copy % x+w y x+w y
            .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
            h add exch 1 sub exch
            .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
        } for
    } //.xpostsys /.indict get exec } bind

    % The rectangle a fill covers is the driver contract's (.rectspan,
    % src/lib/xpost_dev_driver.h): a negative extent reflects through
    % the origin and the far corner is inclusive, so an integral w gives
    % w+1 columns. This method walks the span through PutPix; the
    % compiled fills that replace it on a selected device, and the C
    % devices' own, take the same span from the same place. Nothing here
    % restates it, and nothing here has to agree with it by accident.
    /FillRect { % c1..cN x y w h IMAGE  .  -
    { {h w y x}{exch def}forall .takecolor
        x y w h width height //.internaldict /.rectspan get exec {
            /ry1 exch def /rx1 exch def /ry0 exch def /rx0 exch def
            .pushcolor
            ry0 1 ry1 { % c1..cN y
                rx0 1 rx1 { % c1..cN y x
                    .ncomp 2 add copy exch % c1..cN y x c1..cN x y
                    currentdict PutPix % c1..cN y x
                    pop
                } for
                pop
            } for
            .ncomp { pop } repeat
        } if
    } //.xpostsys /.indict get exec } bind

    % expand a running device-space box to include a point; FillPoly
    % seeds minx/miny/maxx/maxy in the instance before the sweep
    /.maxmin { % x y
        2 copy
        dup maxy gt { /maxy exch def }{ pop } ifelse
        dup maxx gt { /maxx exch def }{ pop } ifelse
        dup miny lt { /miny exch def }{ pop } ifelse
        dup minx lt { /minx exch def }{ pop } ifelse
    } bind

    % x1 y1 x2 y2 x3 y3 x4 y4  .  x5 y5 true
    %                             false
    % segment intersection by translating A to the origin and rotating
    % AB onto the x axis; the scratch dictionary is preallocated once
    % for the whole suite, so the scanline sweep allocates nothing
    /.intersect {
		DICT
		{
        {Dy Dx Cy Cx By Bx Ay Ax}{exch def}forall

        { %stopped
            % reject degenerate line
            Ax Bx eq Ay By eq and
            Cx Dx eq Cy Dy eq and or {stop} if

            % reject coinciding endpoints
            Ax Cx eq Ay Cy eq and
            Bx Cx eq By Cy eq and or
            Ax Dx eq Ay Dy eq and or
            Bx Dx eq By Dy eq and or {stop} if

            % translate by -Ax,-Ay
            /Bx Bx Ax sub def /By By Ay sub def
            /Cx Cx Ax sub def /Cy Cy Ay sub def
            /Dx Dx Ax sub def /Dy Dy Ay sub def

            % length of AB
            /distAB Bx Bx mul By By mul add sqrt def

            % rotate AB to x-axis
            /theCos Bx distAB div def
            /theSin By distAB div def
            /newX Cx theCos mul Cy theSin mul add def
            /Cy   Cy theCos mul Cx theSin mul sub def /Cx newX def
            /newX Dx theCos mul Dy theSin mul add def
            /Dy   Dy theCos mul Dx theSin mul sub def /Dx newX def

            % no intersection
            Cy 0 lt Dy 0 lt and Cy 0 ge Dy 0 ge and or {stop} if

            /ABpos Dx Cx Dx sub Dy mul Dy Cy sub div add def
            ABpos 0 lt
            ABpos distAB gt or {stop} if % intersection not on segment

            Ax ABpos theCos mul add
            Ay ABpos theSin mul add
        } stopped not

    } //.xpostsys /.indict get exec }
	dup 0 16 dict put
	bind

    %nb. this implementation is overridden as a device is finished
    %(the .completedevice step in device.ps)
    %see xpost_dev_generic.c:_fillpoly(ctx,poly,dev) for the
    %implementation in current use (10/8/2014)

    /FillPoly { % c1..cN polygon IMAGE  .  -
    { {poly}{exch def}forall .takecolor

        /DEBUGFILL where { pop
            (\nFillPoly)=
            .pushcolor .ncomp 1 sub -1 0 { index =only( )=only } for
            .ncomp { pop } repeat
            poly ==
        } if

        /minx 16#7ffffff def
        /miny minx def
        /maxx minx neg def
        /maxy maxx def
        poly {
            dup type /arraytype eq {
                dup length 2 eq {
                    aload pop .maxmin
                }{
                    pop
                } ifelse
            }{
                pop
            } ifelse
        } forall

        /x_max width .5 add def

        /DEBUGFILL where { pop
            (FillPoly:<intersect polygon edges with scanlines>)=
        } if
        /P poly poly length 1 sub get def
        [
        poly {
            /Q exch def
            /DEBUGFILL where { pop
                (P=)=only P ==
                (Q=)=only Q ==
            } if
            x_max miny floor cvi .5 add % [ x_max miny+.5
            1                           % [ x_max miny+.5 1
            maxy ceiling cvi .5 sub     % [ x_max miny+.5 1 maxy-.5
            {                           % [ ... x_max y
                1 index exch            % [ ... x_max x_max y
                -.5 1 index               % [ ... x_max x_max y -.5 y
                4 2 roll
                P aload pop Q aload pop % [ ... x_max  x_max y  -.5 y  Px Py  Qx Qy
                .intersect {
                    2 array astore exch % [ ... [x y] x_max
                } if
            } for
            pop
            /P Q def
        } forall
        ]        % [list-of-x/y-intersections
        /DEBUGFILL where { pop
            dup ==()=
        } if

        /DEBUGFILL where { pop
            (FillPoly:<sort scanline intersection list>)=
        } if
        {
        dup { % comparitor  % [x1 y1] [x2 y2] . bool
            1 index 1 get
            1 index 1 get
            eq {            % y1 == y2
                exch 0 get
                exch 0 get
                lt             % (x1 < x2)
            }{              % y1 != y2
                exch 1 get
                exch 1 get
                lt             % (y1 < y2)
            } ifelse
        } //.xpostsys /qsort get exec   % [sorted-list-of-intersections]
        } pop
        dup .yxsort
        /DEBUGFILL where { pop
            dup ==()=
        } if

        /DEBUGFILL where { pop
            (FillPoly:<set pixels on each scanline>)=
        } if
        aload length 2 idiv { % repeat
            exch aload pop
            3 2 roll aload pop

            {
                //.internaldict /USEDRAWLINE known {
                    //.internaldict /USEDRAWLINE get {
                        .pushcolor .ncomp 4 add .ncomp roll
                        currentdict DrawLine
                        exit
                    } if
                } if

                pop                        % xa ya xb
                3 2 roll                   % ya xb xa
                exch 1 exch                % ya xa 1 xb
                dup width ge { pop width 1 sub } if
                { % for                    % ya x
                    .pushcolor .ncomp 1 add .ncomp roll % ya c1..cN x
                    .ncomp 1 add index     % ya c1..cN x ya
                    currentdict PutPix
                } for
                pop
            exit } loop

        } repeat

    } //.xpostsys /.indict get exec } bind %FillPoly

    % c1..cN  Ground  -
    % Take up the colour the page is being cleared to; PLRM 8.2 erases
    % the entire page, so this is the colour every row of it carries. A
    % page held in part shows it over the rows that are not held, and the
    % one row standing for those is laid in it here -- through .rowput,
    % the same store the fills reach, so the rows that are held and the
    % rows that are not come out the same colour. It is laid unscreened,
    % which is why Create holds the whole page for a class that screens:
    % one row cannot carry a pattern that changes from row to row.
    %
    % The colour itself is recorded on the instance under /.ground, for
    % the reads that land where the device holds no pixel. Every raster
    % class reaches this, including a sub-class that holds its page some
    % other way: such a class replaces Create and so records no run of
    % rows and has no row to lay, but it has a page whose edge a read can
    % fall off, and the components are the only statement of what that
    % page was cleared to. They are kept in the components' own range,
    % since what a stored channel is differs from class to class.
    %
    % The record is one array, made once and stored into thereafter, and
    % it is made in global VM: a mark survives the restore that ends a
    % save because raster memory is not part of virtual memory (PLRM
    % 3.7.3), and the ground the page was cleared to has to keep to the
    % page it describes.
    /Ground { % c1..cN IMAGE  .  -
    {
        currentdict /.groundrow known {
            0 1 width 1 sub {            % c1..cN x
                .groundrow exch          % c1..cN row x
                % the components stay for the next pixel, so the copy
                % this one stores is taken from where they lie
                .ncomp { .ncomp 1 add index } repeat
                .rowput
            } for
        } if
        currentdict /.ground known not {
            currentglobal true setglobal
            /.ground .ncomp array def
            setglobal
        } if
        .ground astore pop
    } //.xpostsys /.indict get exec } bind

    % Whether the row this device shows over a row it does not hold is
    % the same row whatever the row is. A class that stores the colour
    % it is handed shows one row of that colour wherever it shows the
    % ground; a class that screens leaves a pattern that repeats down
    % the page with its cell, so what it shows at one row of the page is
    % not what it shows at the next.
    /.groundvaries false

    % y  .groundrowat  row
    % The row the page shows at row y where this device holds no pixel
    % of it: the colour erasepage last cleared the page to, laid out as
    % a row of this class's own shape. A class showing one row answers
    % the one Ground laid. A class whose ground differs from one row to
    % the next fills a row for the row it was asked about, and what it
    % answers stands only until the next call fills it again -- which is
    % what /.groundvaries above tells a caller collecting rows.
    /.groundrowat { % y  .  row
        pop .groundrow
    } bind

    % file  .writehead  -
    % The header a raw portable map carries ahead of its rows: the magic
    % naming the format, the extent in pixels, and, where the format has
    % one, the top of the value range -- the full 255 whatever the page
    % holds. A bilevel map's sample is one bit and states no range. The
    % extent is the page's own -- one page is being written whatever it
    % arrives in -- so a page put out a band at a time carries at its
    % head the bytes a page put out whole carries.
    /.pnmmaxval (255\n)
    /.writehead { % file  .  -
        dup .pnmmagic writestring
        dup width 20 string cvs writestring
        dup ( ) writestring
        dup height 20 string cvs writestring
        dup (\n) writestring
        .pnmmaxval writestring
    } bind

    % file  .bandsink  sink
    % Where the rows of the page go. For a format whose rows are the
    % bytes it carries that is the file itself; a format that frames its
    % rows in something else answers whatever takes them -- a compressed
    % strip is the filter that compresses it -- and .writetail below is
    % what finishes that off. The file stays the one the header went to
    % and the one that is closed behind the page.
    /.bandsink { % file  .  sink
    } bind

    % sink file  .writetail  -
    % What the format carries after its rows: nothing, where the header
    % ahead of them said all there was to say. A format whose header
    % points at rows it has not written yet finishes here instead, which
    % is the first moment the rows are all written and their extent is
    % known.
    /.writetail { % sink file  .  -
        pop pop
    } bind

    % img file  .writepage  -
    % The page whole: the header, the rows and whatever the format
    % carries after them, through the same three a page arriving in
    % bands goes out through. The two carry the same bytes because they
    % are the same bytes rather than because two writers agree.
    %
    % A class states its format by stating those three and says nothing
    % here. One that wrote its page here as well would be a second
    % writer to hold in step with the first, and a class that stated
    % only its header would have that header on the page it bands and
    % the inherited one on the page it writes whole -- one device
    % putting out two files for one page, and neither of them wrong
    % anywhere it could be seen.
    /.writepage { % img file  .  -
        3 dict {
        {/f /a}{exch def}forall
        f .writehead
        /snk f .bandsink def
        a snk .writeband
        snk f .writetail
        f (%stdout)(w) file ne { f closefile } if
        } //.xpostsys /.indict get exec
    } bind

    % lo hi  .bandwrite  -
    % Hand one run of the page's rows to the class's row writer. A row
    % the device does not hold is the page's ground, which is what a
    % whole page lays over such a row, so a writer is handed the same
    % rows either way and no writer has to know the difference.
    %
    % The array handed over is kept and reused from one run to the next:
    % a fresh one per run would be a page's worth of them by the end,
    % which is a cost that grows with the page in a mechanism that
    % exists so nothing does.
    %
    % One call covers whatever the file has yet to be given, and that is
    % not always a band: rows nothing painted into are never moved to,
    % so the run between two bands this device did hold can be as long as
    % the page. It is written a bandful at a time against an array as
    % long as the rows this device was made to hold, so the array stays
    % what it was however long a run one call is asked for.
    /.bandwrite { % lo hi  .  -
        /.bandhi exch def
        /.bandlo exch def
        /.bandcap currentdict /.bandpool known
            { .bandpool length }{ .bandrows } ifelse def
        .bandcap 1 lt { /.bandcap 1 def } if
        {
            .bandlo .bandhi gt { exit } if
            /.bandn .bandhi .bandlo sub 1 add def
            .bandn .bandcap gt { /.bandn .bandcap def } if
            % A class whose ground differs from one row to the next
            % fills one row for the row it stands for, so a row this
            % device does not hold cannot be collected beside another:
            % the run one call writes ends at the first such row, or is
            % that one row by itself.
            .groundvaries {
                ImgData .bandlo get .rowheld {
                    /.bandk 1 def
                    {
                        .bandk .bandn ge { exit } if
                        ImgData .bandlo .bandk add get .rowheld not { exit } if
                        /.bandk .bandk 1 add def
                    } loop
                    /.bandn .bandk def
                }{ /.bandn 1 def } ifelse
            } if
            .bandpage /rows 2 copy known
                { get length .bandn lt }{ pop pop true } ifelse
                { .bandpage /rows .bandn array put } if
            /.bandout .bandpage /rows get def
            0 1 .bandn 1 sub {
                /.bandi exch def
                ImgData .bandlo .bandi add get
                dup .rowheld not { pop .bandlo .bandi add .groundrowat } if
                .bandout exch .bandi exch put
            } for
            .bandout 0 .bandn getinterval
            .bandpage /sink get
            .writeband
            /.bandlo .bandlo .bandn add def
        } loop
    } bind

    % -  .emitband  -
    % Put out the rows this device holds, for a page arriving in bands.
    %
    % Emit is called once per band, with the rows the device holds at
    % that moment, and once more at the end with nothing, which is what
    % says the page is finished. So this writes what it can -- the rows
    % from where the file has reached to the last row the device holds --
    % and keeps what it must, which is where the file has reached. That
    % is kept in .bandpage rather than on the device, since it outlives
    % the run of rows the device is standing for at any moment.
    %
    % The file is opened and its header written before the first row
    % goes out, and closed by the call that finds nothing held: a call
    % holding no row is the last one, and what the page has left of its
    % rows goes out as the ground. Whatever the format carries after its
    % rows is written by that same call, which is the first moment every
    % row has gone. A page finished stays finished, so a further call
    % writes nothing rather than a second page into the same file.
    /.emitband { % -  .  -
        .bandpage /done known not {
            .bandpage /file known not {
                .bandpage /file .outputfile (w) file put
                .bandpage /file get .writehead
                .bandpage /sink .bandpage /file get .bandsink put
                .bandpage /next 0 put
            } if
            % the first row this device holds at or after the row the
            % file has reached
            /.bandat .bandpage /next get def
            {
                .bandat height ge { exit } if
                ImgData .bandat get .rowheld { exit } if
                /.bandat .bandat 1 add def
            } loop
            .bandat height ge {
                .bandpage /next get height 1 sub .bandwrite
                .bandpage /next height put
                .bandpage /sink get .bandpage /file get .writetail
                .bandpage /file get
                dup (%stdout) (w) file ne { closefile }{ pop } ifelse
                .bandpage /done true put
            }{
                % ... and the last of the run it begins
                /.bandtail .bandat def
                {
                    .bandtail 1 add height ge { exit } if
                    ImgData .bandtail 1 add get .rowheld not { exit } if
                    /.bandtail .bandtail 1 add def
                } loop
                .bandpage /next get .bandtail .bandwrite
                .bandpage /next .bandtail 1 add put
            } ifelse
        } if
    } bind

    % write the page: open the name settled for this page and hand the
    % rows to the class's .writepage
    %
    % A device whose page is arriving in bands is put out through
    % .emitband instead, which writes the rows this device holds at this
    % moment and keeps the file open for the rows the next call brings.
    % The band loop is what leaves .bandpage on a device (data/recorddev.ps);
    % a device put out the ordinary way carries none and takes the whole
    % page below, which is why a device that has not been asked to band
    % cannot be handed part of a page by accident.
    /Emit { % IMAGE  .  -
    {
        currentdict /.bandpage known { .emitband }{
        .groundvaries {
            % A class whose ground differs from one row to the next
            % cannot show one row over every row it does not hold, so
            % its page goes out through the walk a band's rows go out
            % through, which lays each such row in turn. That walk keeps
            % the file and how far down the page it has reached between
            % calls; here they are made for this page and given up with
            % it, so the device is left as one that was never asked to
            % take its page in bands.
            /.bandpage 4 dict def
            { .bandpage /done known { exit } if .emitband } loop
            currentdict /.bandpage undef
        }{
            % The page a writer is given is the page the program asked
            % for. Where the device holds only some of the page's rows,
            % the rest of it shows the ground, and the whole page is put
            % together here so that no writer has to know the difference.
            %
            % Which rows those are is asked of the rows themselves, one
            % at a time, rather than worked out from the run the device
            % set out to hold. The two answer alike while the rows a
            % device holds are settled once and for all at Create, and
            % only the first stays right when they are not: a page whose
            % held rows are the ones a mark reached does not hold a run
            % at all, and there is no arithmetic over .bandtop and
            % .bandrows that describes it.
            ImgData height array copy
            0 1 height 1 sub {              % page i
                1 index 1 index get         % page i row
                .rowheld
                    { pop }
                    { 1 index exch dup .groundrowat put }
                ifelse
            } for
            .outputfile (w) file
            .writepage
        } ifelse } ifelse
    } //.xpostsys /.indict get exec } bind
>> put

% spec  .makerasterclass  class
% build a raster device class: the shared suite copied from
% .rasterproto, overlaid with the parameter dictionary, then completed
% with the colour take/push helpers its component count calls for.
%
% There are helpers for one component and for three, which is what the
% fleet declares -- the grey and bilevel classes take one, the colour
% and TIFF classes three, and the compiled devices copy one of those.
% Any other count is refused rather than approximated; see below for
% why that is the only honest answer available here.
%
% Load-time only.
.xpostsys /.makerasterclass { % spec  .  class
    //.xpostsys /.rasterproto get
    dup length 2 index length add 8 add dict
    copy
    exch { 2 index 3 1 roll put } forall
    dup /.ncomp get 1 eq {
        dup /.takecolor { /c1 exch def } put
        dup /.pushcolor { c1 } put
    }{
        dup /.ncomp get 3 eq {
            dup /.takecolor { /c3 exch def /c2 exch def /c1 exch def } put
            dup /.pushcolor { c1 c2 c3 } put
        }{
            % There are helpers for one component and for three, and
            % those are the two counts the fleet declares. A class
            % asking for another is refused rather than handed the
            % three, which would be the worst of the answers available:
            % a paint of four components would have one of its values
            % taken in the place of another and three pushed where it
            % wanted four, so the page would come out wrong rather than
            % not come out. The count is a property of the class being
            % built and known
            % here, so it is refused where it is read.
            /.makerasterclass cvx /rangecheck signalerror
    } ifelse } ifelse
} bind put


(/pgmimage.ps) //.xpostsys /.loadmodule get exec
(/pbmimage.ps) //.xpostsys /.loadmodule get exec
(/ppmimage.ps) //.xpostsys /.loadmodule get exec
(/tiffimage.ps) //.xpostsys /.loadmodule get exec

//.internaldict /QUIET known { }{ (eof image.ps\n)print } ifelse
