%!PS
%
% clip.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The clipping region: setting it, resolving it, and meeting a paint against it.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading clip.ps...)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .xpostsys begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The one writer of the clip.
%
%  The clip is a single value wearing three faces. /clipregion is the
%  resolved region every painter meets what it was about to paint
%  against. /clipsource is what a device that clips for itself is handed
%  -- the shape and the rule it is read under, [ path evenodd ] -- or
%  null when there is none to hand over. The rule travels with the shape
%  because a region is an outline AND a way of reading it: one outline
%  under the two rules encloses different area, so a consumer told only
%  the outline would enforce a region the painters here are not.
%  /clipcache holds what has been worked out about the region so far,
%  and belongs to that region and no other. Set one and not the rest and
%  the others go on describing a clip that is no longer in force --
%  which is not a fault that shows up where it is made: the painters
%  keep enforcing the region while a vector device writes the old shape
%  into its page, and no rasterised render of the same job disagrees
%  with anything.
%
%  So no site sets one face. Every site that replaces the clip says what
%  all of it becomes, here, in one call. tests/check-clip-writer.sh holds
%  the tree to that: a put of any of the three names anywhere else fails
%  the build.
%
%  The cache holder is a fresh dictionary each time, not a cleared one,
%  because a graphics state copy shares dictionary values by reference:
%  a gsave takes the holder with it, a clip inside the gsave installs its
%  own, and the grestore brings the outer holder back with whatever it had
%  worked out still in it. The serial names the region for the resolved
%  form the intersection keeps in C, and comes from a counter that never
%  repeats a number.
%
.xpostsys /.setclipregion {  % region source  .  -
    graphicsdict /currgstate get
    dup 3 -1 roll /clipsource exch put
    dup 3 -1 roll /clipregion exch put
    1 dict dup /serial .newregionserial put
    /clipcache exch put
} put

%
%  The clip region in the device FillPoly argument format, for a consumer
%  that wants the region's vertices in an array. .fillpolyargs reads the
%  current path, so the region stands in for it briefly.
%
%  An array's length is a bounded field, so a region of enough vertices
%  has no such form and this refuses. The region intersection does not
%  come this way -- it reads the region's path itself, where no such
%  bound applies -- so what refuses here is a consumer's own question and
%  not a painter's.
%
%  Kept in the clip's own holder once worked out, since building it is
%  the same work every time and the region does not change under it.
%
%  A holder of serial zero is the one every graphics state is built with
%  and shares until its first clip, so nothing is kept there.
%
.xpostsys /.clipregionpoly {  % -  .  poly
    graphicsdict /currgstate get /clipcache get
    dup /poly known {
        /poly get
    }{
        graphicsdict /currgstate get /currpath get
        graphicsdict /currgstate get /currpath
            graphicsdict /currgstate get /clipregion get put
        .fillpolyargs
        exch graphicsdict /currgstate get /currpath 3 -1 roll put
        1 index /serial get 0 ne { 2 copy /poly exch put } if
        exch pop
    } ifelse
} put

%
%  What the clip in force leaves of a region about to be painted. The one
%  way a painter asks that question; the rule it is answered by is stated
%  at .regionmeet.
%
%  The region goes over as the path the graphics state holds it in, and
%  not as a polygon read out of an array. A region cut from another is
%  one pixel-band rectangle per band it covers, and a page divided finely
%  across the rows has more of those than any single array describes;
%  a path carries its extent in a header field of its own and has no
%  such bound. What the answer costs is another matter, and the answer
%  is an array: an intersection too finely divided for one refuses here,
%  and .clipmeetparts below is what asks again in parts.
%
.xpostsys /.clipmeet {  % subjectpoly  .  spanpoly
    graphicsdict /currgstate get
    dup /clipregion get
    exch dup /clipcache get /serial get
    exch /device get dup /height known { /height get }{ pop 0 } ifelse
    % as a count of rows. A raster device's page is a whole number of
    % them, but a vector device adopts the page size exactly and its
    % height is in points, which need not be integral (.adoptexactpage,
    % pdfwrite.ps); rounded up so the count still covers every row the
    % page reaches.
    ceiling cvi
    .regionmeet
} put

%
%  How deep a tile of the page reaches before anything is asked of it.
%  A tile is halved until what it holds fits one array, so this settles
%  where the halving starts and not where it ends.
%
.xpostsys /.cliptilerows 2048 put

%
%  What the clip in force leaves of the subject region inside the tile,
%  in the pixel-band rectangles .clipmeet answers in: one array, or
%  several over shallower tiles when what is left holds more bands than
%  one array's length field describes. A null subject asks for the whole
%  of the tile.
%
%  The cut is across the rows, halving the tile until each piece carries
%  its own bands, so a region divided finely across the rows is resolved
%  as readily as one reaching far down them. A tile one row deep cannot
%  be cut again, so a row holding more runs than an array carries hands
%  its refusal up.
%
%  The tiles meet along row boundaries and no two of them describe the
%  same row, which is what lets their spans be painted one after
%  another: a pixel two tiles both described would be painted twice, and
%  blended twice as dark.
%
.xpostsys /.cliptile {  % subject x0 y0 x1 y1  .  spans ...
    5 dict begin
    /ty1 exch def /tx1 exch def /ty0 exch def /tx0 exch def
    /subj exch def
    count /n0 exch def
    { [ [ tx0 ty0 ] [ tx1 ty0 ] [ tx1 ty1 ] [ tx0 ty1 ] null ]
      subj null ne { subj exch 0
        graphicsdict /currgstate get /device get
        dup /height known { /height get }{ pop 0 } ifelse
        ceiling cvi .regionmeet } if
      //.clipmeet exec
    } stopped {
        count n0 sub { pop } repeat
        ty1 ty0 sub 1 gt {
            /tm ty0 ty1 ty0 sub 2 idiv add def
            subj tx0 ty0 tx1 tm //.xpostsys /.cliptile get exec
            subj tx0 tm tx1 ty1 //.xpostsys /.cliptile get exec
        }{
            stop
        } ifelse
    } if
    end
} put

%
%  What the clip in force leaves of the subject region, in the parts a
%  painter marks one after another. Normally the one array .clipmeet
%  answers with; several, over disjoint bands of rows, when the answer
%  holds more bands than one array's length field describes.
%
%  A band costs five array elements and an array's length is a bounded
%  field, so a fill of a page under a comb or a stipple has an answer
%  too finely divided for any single array to describe. That is a bound
%  on the description and not on the painting: the parts describe the
%  same pixels between them, so what is painted is what PLRM 7.5.1 asks
%  for -- the pixels the operation covers met with the pixels of the
%  region -- whether the answer took one array or twenty.
%
%  The tiles are cut out of the rows and columns the subject reaches,
%  which is where the answer can lie: a tile stretched past the subject
%  would be halved over rows that could hold nothing.
%
.xpostsys /.clipmeetparts {  % subjectpoly  .  [ spans ... ]
    16 dict begin
    /subj exch def
    count /n0 exch def
    /d0 countdictstack def
    {
        { [ subj //.clipmeet exec ] } stopped {
            count n0 sub { pop } repeat
            subj //.xpostsys /.polybounds get exec {
                /yhi exch def /xhi exch def /ylo exch def /xlo exch def
                /sl //.xpostsys /.cliptilerows get def
                /tx0 xlo floor cvi 1 sub def
                /tx1 xhi ceiling cvi 1 add def
                /ylim yhi ceiling cvi 1 add def
                [ ylo floor cvi sl yhi ceiling cvi {
                      /yb exch def
                      subj tx0 yb tx1 yb sl add dup ylim gt { pop ylim } if
                      //.cliptile exec
                  } for ]
            }{
                % a subject with no vertices covers no pixel
                [ ]
            } ifelse
        } if
    } stopped {
        % A tile that handed its refusal up leaves its own dictionaries
        % open behind it, and the caller is owed a clean stack under the
        % failure it is about to be given.
        countdictstack d0 sub { end } repeat
        count n0 sub { pop } repeat
        end
        stop
    } if
    end
} put

%
%  What the clip in force leaves of a subject already stated in parts.
%  Each part is met on its own and the answers stand together: the parts
%  describe disjoint bands of rows, so the answers do too, and a painter
%  marking them one after another marks no pixel twice.
%
.xpostsys /.clippartsmeet {  % [ spans ... ]  .  [ spans ... ]
    [ exch { //.clipmeetparts exec aload pop } forall ]
} put

%
%  Make the parts the clip region: they become one path, which is what a
%  graphics state holds a region in and what the region intersection
%  reads. A region of more bands than one array describes is still one
%  path, since a path carries its extent in a header field of its own.
%
%  The caller is left with the region as its current path, which is where
%  the clip writers each want it.
%
.xpostsys /.clipstoreparts {  % [ spans ... ]  .  -
    newpath
    { //.xpostsys /.polytopath get exec } forall
} put

%
%  Replace the clip region with the whole page (PLRM 8.2). The device
%  reports its dimensions in device pixels, so the rectangle is built with
%  the identity in force and the matrix put back afterwards; the program's
%  own current path is stashed over the construction and restored, since
%  initclip changes the clip and nothing else. The corners are walked
%  counter-clockwise so the region has the winding the painters expect.
%
/initclip [ ] {  % -  .  -
    graphicsdict /currgstate get /currpath get
    matrix currentmatrix

    newpath
    matrix setmatrix
    DEVICE /dimensions get
    aload pop
    0 0 moveto
    1 index 0 rlineto
    0 exch rlineto
    neg 0 rlineto
    closepath

    setmatrix

    % The region is the whole page, which constrains nothing a device has
    % to be told about, so there is no shape to hand one.
    graphicsdict /currgstate get /currpath get
    null //.setclipregion exec
    graphicsdict /currgstate get /currpath 3 -1 roll put
} .defop

%
%  Cut the clip down to the current path under the nonzero rule (PLRM
%  8.2). The path itself survives: what a program painted before
%  clipping it is what a program paints after.
%
/clip [ ] {  % -  .  -
    % The clip machinery consumes line segments, so the region is cut
    % from a flattened working copy; the caller's path is kept aside
    % and put back, undisturbed by flattening or the intersection
    % remember the clip's shape as a path before flattening: a device
    % that clips for itself wants the shape, not the pixel-band spans the
    % region may reduce to below. Intersecting with an existing region
    % can produce a shape no single path describes; the branches below
    % say which case this is, and the record starts as the one shape a
    % clip taken inside a rectangle that already contains it leaves.
    %
    % An empty path encloses nothing and is no shape to hand over: a
    % consumer given a clip with no path in it has nothing to intersect
    % and leaves its clip as it was, which is the whole page -- the
    % opposite of the region in force. Such a clip has no record, and
    % the paint it cuts to nothing travels the polygon route instead.
    .cliptrivial .pathempty not and
        { [ graphicsdict /currgstate get /currpath get .copypath false ] }
        { null }
    ifelse

    graphicsdict /currgstate get /currpath get .copypath
    flattenpath
    .cliptrivial {
        % The region is a rectangle containing the whole path, so the
        % intersection is the flattened path already in hand: nothing to
        % cut, and the region stays a path so a vector device's
        % whole-path output stays exact.
    }{
    % Two overlapping rectangles intersect to a rectangle: build it
    % directly, so the region stays recognizable as one -- the
    % hairline walk and the raster painters read its bounds -- rather
    % than dissolving into pixel-band spans.
    .cliprect { .pathisrect { true }{ 4 { pop } repeat false } ifelse }
              { false } ifelse {
        8 dict begin
        {/py1 /px1 /py0 /px0 /cy1 /cx1 /cy0 /cx0}{exch def}forall
        /px0 px0 cx0 2 copy lt { exch } if pop def
        /py0 py0 cy0 2 copy lt { exch } if pop def
        /px1 px1 cx1 2 copy gt { exch } if pop def
        /py1 py1 cy1 2 copy gt { exch } if pop def
        newpath
        px0 px1 le py0 py1 le and {
            px0 py0 .devmoveto
            px1 py0 .devlineto
            px1 py1 .devlineto
            px0 py1 .devlineto
            closepath
        } if
        end

        % The region is that rectangle, and a rectangle is one path: the
        % record stands even though the region came from an intersection.
        % Without it a fill under crossing rectangles would be cut to the
        % region by the polygon machinery below and reach a vector device
        % flattened, its curves gone. An empty intersection is no shape,
        % as above.
        .pathempty not {
            exch pop
            [ graphicsdict /currgstate get /currpath get .copypath false ]
            exch
        } if
    }{
        % Otherwise intersect span by span, as eoclip does: the
        % resulting pixel-band rectangles are winding-uniform, so
        % stacked regions of any shape combine exactly. The answer
        % arrives in parts where no single array states it, and the
        % parts become the one path the region is held in.
        false //.xpostsys /.fillsubjparts get exec
        //.clippartsmeet exec
        //.clipstoreparts exec
    } ifelse } ifelse

    % Each branch above left the new region as the current path: put the
    % caller's path back and install the clip, both faces at once.
    graphicsdict /currgstate get /currpath get      % Source saved region
    graphicsdict /currgstate get /currpath 3 index put
    exch pop                                        % Source region
    exch //.setclipregion exec
} .defop

%
%  The line through two points, as the coefficients A, B and C of Ax +
%  By + C = 0. The clip walk tests a vertex against an edge by
%  evaluating that form and reading its sign, so an edge is turned into
%  coefficients once and evaluated per vertex rather than the other way
%  about.
%
.xpostsys /.p2abc {  % x0 y0 x1 y1  .  A B C
    exch 3 index sub
    exch 2 index sub  % X0 y0 dx dy
    exch              % X0 y0 A B
    neg
    2 copy 6 2 roll   % A B x0 y0 A B
    3 -1 roll mul     % A B x0 A By0
    3 1 roll mul      % A B By0 Ax0
    add neg           % A B C
} put

%
%  .evaluate and .hodgman-sutherland
%  from Bill Casselman's Mathematical Illustrations, ch. 5.
%
.xpostsys /.evaluate {  % x y [A B C]  .  v
    aload pop          % X y A B C
    5 1 roll           % C x y A B
    3 2 roll mul       % C x A By
    3 1 roll mul       % C By Ax
    add add
} put

%
%  Hodgman-Sutherland keeps the half-plane to the left of each directed
%  clip edge, so a clip polygon's interior must lie to the left of its
%  edges: a positive signed area, the winding initclip produces. A user
%  clip path can arrive in the opposite device-space winding (e.g. after
%  the y-flip), which would keep the exterior and clip everything away.
%  Reverse such a polygon so its winding always matches.
%  doubled signed area of a closed polygon (first point repeated at the
%  end); positive when wound counter-clockwise in device space.
%
.xpostsys /.polyarea2 {  % poly  .  a2
    8 dict begin
    /poly exch def
    /a2 0.0 def
    0 1 poly length 2 sub {
        /i exch def
        poly i get aload pop /yi exch def /xi exch def
        poly i 1 add get aload pop /yj exch def /xj exch def
        /a2 a2 xi yj mul xj yi mul sub add def
    } for
    a2
    end
} put

%
%  A clip polygon wound the way the Sutherland-Hodgman walk expects.
%  That walk keeps the half-plane to the left of each directed edge, so
%  a polygon whose interior lies to the right of its edges would clip
%  away everything. Reversed where the signed area says it is wound the
%  wrong way, and handed back untouched where it is not.
%
%  Called by every site that hands a polygon to the clip walk, so a user
%  clip path that arrived in either winding is normalised once.
%
.xpostsys /.normclipwind {  % poly  .  poly'
    dup //.polyarea2 exec 0 lt {
        4 dict begin
        /poly exch def
        [ poly length 1 sub -1 0 { poly exch get } for ]
        end
    } if
} put

%
%  polygon [A B C]  .  new-polygon
%
%  Canonical Sutherland-Hodgman: clip the closed polygon (points array,
%  first point repeated at the end) against the half-plane where the clip
%  line evaluates <= 0. For each edge P->Q emit Q when it lies inside, and
%  emit the edge's crossing point wherever the edge enters or leaves the
%  half-plane. Correct for any convex clip window and any edge orientation.
%
.xpostsys /.hodgman-sutherland {
    16 dict
    begin
    /f exch def
    /p exch def
    /n p length 1 sub def   % Edge count (p carries a duplicated closing point)
    /DEBUGCLIP where { pop (n=)print n = } if
    n 0 gt {
        /out [
            0 1 n 1 sub {
                /i exch def
                /P p i get def
                /Q p i 1 add get def
                /fP P aload pop f //.evaluate exec def
                /fQ Q aload pop f //.evaluate exec def
                fQ 0 le {
                    fP 0 le not {          % P outside, Q inside: entering crossing
                        /QP fQ fP sub def
                        [
                            fQ P 0 get mul fP Q 0 get mul sub QP div
                            fQ P 1 get mul fP Q 1 get mul sub QP div
                        ]
                    } if
                    Q                      % Q inside
                }{
                    fP 0 le {              % P inside, Q outside: leaving crossing
                        /QP fQ fP sub def
                        [
                            fQ P 0 get mul fP Q 0 get mul sub QP div
                            fQ P 1 get mul fP Q 1 get mul sub QP div
                        ]
                    } if
                } ifelse
            } for
        ] def
        out length 0 gt {                  % Re-close: repeat the first vertex
            [ out aload pop out 0 get ]
        }{
            out
        } ifelse
    }{
        p
    } ifelse
    end
} bind put

%
%  A subpath split off at a closepath enters through the bridge the
%  path walked from the closing point: its leading edge doubles its
%  trailing edge. Peel such pairs until the polygon walks only its own
%  boundary; what remains classifies as a window or hole by winding.
%
.xpostsys /.despike {  % poly  .  poly'
    2 dict begin
    /p exch def
    {  % loop
        p length 4 lt { exit } if
        p 1 get aload pop p p length 2 sub get aload pop
        exch 4 -1 roll eq 3 1 roll eq and not { exit } if
        /p p 1 p length 2 sub getinterval def
    } loop
    p
    end
} put

%
%  Cut the current path to the shape of the clip region, in reals, by the
%  half-plane clipper above: the path becomes a path describing the part
%  of itself inside the region.
%
%  This answers a question about SHAPE, not about pixels. It is not the
%  region intersection and is no substitute for one: .regionmeet resolves
%  both operands to the pixels they cover before meeting them, as PLRM
%  7.5.1 requires of clipping, and this cuts the geometry first and leaves
%  the resolving until afterwards -- so a boundary that runs inside a
%  pixel row survives one and not the other. Where a fill takes this route
%  the difference is a boundary row, and the case that settles which is
%  right is self-consistency: a region painted in pieces must cover the
%  pixels one solid fill of the same path covers.
%
%  What it is for is keeping a shape a shape. A device that clips for
%  itself wants a path, and a fill under a rectangular region stays whole
%  rectangles through here where the pixel route would leave it one
%  subpath per scanline -- which for a vector device is the whole page
%  written out a row at a time.
%
%  Convert the path to an array of polygons (arrays of points)
%  convert clipregion to array of polygons
%  traverse the clipregion
%     convert line to [A B C] form
%     feed polygon and line to .hodgman-sutherland,
%        receiving new polygon.
%  convert polygon array back to path structure.
%
.xpostsys /.doclip {  % -  .  -
    % When the clip region is an axis-aligned rectangle that already
    % contains the whole path, clipping passes every point through
    % unchanged: skip the polygon-clipping machinery.
    .cliptrivial not {
        %DICT
        20 dict
        begin

        flattenpath
        /PA [                           % PAth    polygon array
            [  % Mark
            {
                2 array astore  % ... mark ... [x0 y0]
                counttomark 1 ne {
                    counttomark 1 add 1 roll  % ... [x0 y0] mark ...
                    ] exch  % ... [ ... ] [x0 y0]
                    [ exch  % ... [ ... ] [ [x0 y0]
                } if  % ... mark [x0 y0]

                %pstack()=
            }
            { 2 array astore }  % ... mark [x0 y0] ... [xN yN]
            {}
            { counttomark 1 sub index }  % ... mark [x0 y0] ... [x0 y0]
            //.devpathforall exec
            ]  % /PA mark [...] [...] [...]
        ] def

        % A closepath ends a clip subpath, but need not be followed by a
        % moveto: a segment operator may continue from the closing point
        % (the straight line arc appends is the common case, building a
        % ring as one keyhole path). Split polygons at the close as well
        % as at movetos, so each ring boundary classifies separately.
        /CR                         % Clip Region   region array
        //.clipregionpath exec [
            %{ 2 array astore [ exch } { 2 array astore } {} {]} .devpathforall
            [
            { 2 array astore
                counttomark 1 ne {
                    counttomark 1 add 1 roll
                    ] exch
                    [ exch
                } if
            }
            { 2 array astore }
            {}
            { counttomark 1 sub index ] [ }
            //.devpathforall exec
            ]
        ]
        def

        /DEBUGCLIP where { pop
            (//.xpostsys /.doclip get exec)=
            (PA: )print PA ==
            (CR: )print CR ==

            %hook
        } if

        % A clip path may carry several subpaths: the first is the clip
        % window, and any later subpath wound the opposite way is a hole
        % cut out of it (the nonzero-rule idiom for clipping around a
        % reserved area). Later subpaths with the window's winding are
        % treated as further windows to intersect, as before.
        /wsign 0 def

        % Subtracting a hole meets the subject against each of the hole's
        % edges limited by the edges before it, so the passes rise with the
        % square of the hole's edge count -- and each such pass builds a
        % polygon, dear where meeting a window's edge is cheap. A hole of a
        % few hundred edges already costs what a real hole never does, whose
        % windows are rectangles and glyph outlines and whose holes are the
        % odd reserved rectangle, so a hole past that many edges is refused
        % below rather than squared. Meeting a window's edges stays bounded
        % by the product of the window's edge count and the subject's, cheap
        % per pass but a product a program still sizes, so a running count of
        % all the passes stops the rare enormous one past a number far above
        % any real clip.
        /shn 0 def
        /shnmax 4000000 def
        /holemax 200 def
        CR {  % One clipping polygon
            //.despike exec

            % Fewer than three points bound no area (e.g. the bare pen
            % moveto charpath leaves after its outlines).
            dup length 3 lt {
                pop
            }{
                dup //.polyarea2 exec 0 lt { -1 }{ 1 } ifelse /psign exch def
                wsign 0 eq { /wsign psign def } if
                psign wsign eq {

                % Intersect the subject polygons with the (convex) window
                //.normclipwind exec
                dup 0 get
                /U exch def
                1 1 index length 1 sub getinterval
                {
                    /V exch def
                    U 0 get V 0 get sub abs U 1 get V 1 get sub abs add 0.001 lt {
                        % A degenerate edge (a contour closing on its own start,
                        % exactly or within float noise) has no usable
                        % half-plane.
                    }{
                        [ U aload pop V aload pop //.p2abc exec ]  % Clip-line
                        /CL exch def
                        /DEBUGCLIP where { pop
                            CL ==
                        } if

                        /PA [ PA {  % One subject polygon
                            CL //.xpostsys /.hodgman-sutherland get exec
                            /shn shn 1 add def
                            shn shnmax gt { /clip cvx /limitcheck signalerror } if
                        } forall ] def
                    } ifelse

                    /U V def
                } forall

                }{

                % Subtract the (convex) hole: the difference decomposes into
                % one piece per hole edge - the part beyond that edge,
                % limited by the edges before it.
                //.normclipwind exec
                /HP exch def
                /HL [
                    HP 0 get /U exch def
                    HP 1 HP length 1 sub getinterval {
                        /V exch def
                        U 0 get V 0 get sub abs U 1 get V 1 get sub abs add 0.001 ge {
                            [ U aload pop V aload pop //.p2abc exec ]
                        } if
                        /U V def
                    } forall
                ] def
                HL length holemax gt { /clip cvx /limitcheck signalerror } if
                /PA [
                    PA {
                        /SP exch def
                        0 1 HL length 1 sub {
                            /hi exch def
                            /piece SP [ HL hi get { neg } forall ] //.xpostsys /.hodgman-sutherland get exec def
                            /shn shn 1 add def
                            shn shnmax gt { /clip cvx /limitcheck signalerror } if
                            0 1 hi 1 sub {
                                /piece piece 3 -1 roll HL exch get //.xpostsys /.hodgman-sutherland get exec def
                                /shn shn 1 add def
                                shn shnmax gt { /clip cvx /limitcheck signalerror } if
                            } for
                            piece length 3 gt { piece } if
                        } for
                    } forall
                ] def

            } ifelse } ifelse
        } forall
        newpath

        /DEBUGCLIP where { pop
            PA ==
        } if

        PA {
            dup length 0 gt {
                dup 0 get aload pop .devmoveto
                dup 1 1 index length 1 sub getinterval {
                    aload pop .devlineto
                } forall

                dup dup length 1 sub get aload pop  % P xN yN
                2 index 0 get aload pop  % P xN yN x0 y0
                exch 4 1 roll  % P x0 xN yN y0
                eq 3 1 roll eq and {
                    .retagclose
                } if
                pop
            }{
                pop
            } ifelse
        } forall

        end
    } if

} put

%
%  Append a null-separated polygon array (device-space point pairs) to
%  the current path.
%
.xpostsys /.polytopath {  % poly  .  -
    1 dict begin
    /first true def
    {
        dup type /nulltype eq {
            pop
            closepath
            /first true def
        }{
            aload pop
            first { .devmoveto /first false def }{ .devlineto } ifelse
        } ifelse
    } forall
    end
} put

%
%  Intersect the clip region with the even-odd interior of the current
%  path. The interior resolves to pixel-band rectangles through the
%  fill pipeline's scan-conversion; the rectangles, being
%  winding-uniform, intersect the existing region exactly through the
%  span machinery and serve every later paint the same way. The
%  caller's path survives untouched, as with clip.
%
/eoclip [ ] {  % -  .  -
    % The region a device that clips for itself is handed, and the rule
    % it reads it under. Where the existing region is a rectangle already
    % containing the path, this region is that path's own even-odd
    % interior and the path is the shape of it -- read by the even-odd
    % rule, which is why the record carries the rule and not the shape
    % alone. Intersecting with any other region gives pixel-band spans no
    % single path describes, and that case has nothing to hand over.
    % The empty path is no shape, as at clip.
    .cliptrivial .pathempty not and
        { [ graphicsdict /currgstate get /currpath get .copypath true ] }
        { null }
    ifelse

    graphicsdict /currgstate get /currpath get .copypath
    flattenpath
    true //.xpostsys /.fillsubjparts get exec
    .cliptrivial not {
        //.clippartsmeet exec
    } if
    //.clipstoreparts exec

    % The region is the current path, as at clip: put the caller's path
    % back and install both faces at once.
    graphicsdict /currgstate get /currpath get      % Source saved region
    graphicsdict /currgstate get /currpath 3 index put
    exch pop                                        % Source region
    exch //.setclipregion exec
} .defop

%
%  clipsave/cliprestore (LL3): push and pop the clip region alone,
%  independent of the graphics state stack. Neither takes an operand nor
%  returns a result, so the stack the pushing arithmetic is done on is
%  cleared down again before returning.
%
%  What is pushed is the whole clip and not just the resolved region: the
%  shape a device that clips for itself is handed belongs to the same clip
%  and has to come back with it, or the restored clip would be enforced as
%  one shape and written out as another.
%
/clipsave [ ] {  % -  .  -
    graphicsdict /clipstack 2 copy known { get }{
        2 copy 32 array put get
    } ifelse
    graphicsdict /clipptr 2 copy known { get }{ 2 copy 0 put get } ifelse

    % The stack is a fixed depth, and running out of it is the exhaustion
    % PLRM 8.2 names for this operator; writing past the end would report
    % the index as the fault instead. The stack and the pointer are dropped
    % before signalling: an operator leaves nothing behind when it fails,
    % and the stack is the machinery's own -- a program left holding it
    % could read a saved clip and write into the slot a later cliprestore
    % installs from.
    2 copy exch length ge
        { /clipsave cvx /limitcheck signalerror } if
    2 copy
    [ graphicsdict /currgstate get /clipregion get .copypath
      graphicsdict /currgstate get /clipsource get ]
    put
    pop pop
    graphicsdict /clipptr 2 copy get 1 add put
} .defop

%
%  Put back the clip the matching clipsave took down (PLRM 8.2), and do
%  nothing where there is none to put back: the stack is the graphics
%  state's, and a cliprestore without its clipsave is a program's error
%  to make rather than a state to corrupt.
%
/cliprestore [ ] {  % -  .  -
    graphicsdict /clipptr get 0 gt {
        graphicsdict /clipptr 2 copy get 1 sub put
        graphicsdict /clipstack get graphicsdict /clipptr get get
        aload pop                                   % Region source
        //.setclipregion exec
    } if
} .defop

end end

//.internaldict /QUIET known { }{ (eof clip.ps\n)print } ifelse
