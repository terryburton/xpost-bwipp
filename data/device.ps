%!PS
%
% device.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Device-level operators independent of the device implementation, and showpage semantics.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  This file implements "device-level" operators
%  which are independent of the actual device implementation.
%  It also implements the Showpage Semantics behavior
%  specified in the call to xpost_create().
%
%
%  ---- what a device is, and where each part of it lives ----------------
%
%  A device is three things kept apart on purpose. The C half of this is
%  stated in src/lib/xpost_dev_driver.h; this is the PostScript half.
%
%  THE CLASS is a declaration: the methods the machinery runs on a device
%  of that kind, and the constants it answers with -- how many components
%  a pixel has, what colour space it is native to, whether its page may
%  arrive a band at a time. It is built once, as the boot reads the file
%  that defines it, and is sealed at the lockdown (data/init.ps). Nothing
%  writes a class after that, and nothing needs to: a class states what
%  every device of its kind is, and one that a run could write would be a
%  table a program can put its own method into and have the machinery run
%  at showpage.
%
%  THE INSTANCE is one device: the class's methods and constants, copied,
%  plus what the page-device request asked of it and what construction
%  settled -- its dimensions, the file it writes, the buffer it paints
%  into. It is made by .classinstance, finished by .completedevice, and
%  sealed at the end of installation. From that point a device IS what it
%  is, and reading one tells you what will be true of it for the rest of
%  its life.
%
%  THE STATE is what a page does to the device: reached as /.state on the
%  instance, made fresh for each instance, given up with it. The page
%  number, the settled output name, the run of rows a band walk has
%  reached, the halftone cell in force, the images and patterns a page has
%  filed. If a value is written after the device is installed, it belongs
%  here, and there is nowhere else it can go -- the instance will refuse
%  it.
%
%  A METHOD'S OWN WORKING NAMES belong to neither. A method that binds its
%  operands to names, or works out a page's arithmetic, opens .indevwork:
%  the device, and a dictionary of its own above it. A def in that body
%  lands in the working dictionary and is given up when the call returns;
%  a name the body only reads is found on the device beneath it, at the
%  one lookup it always cost. Inside that bracket currentdict is the
%  working dictionary, so a body wanting the device itself says .dev.
%
%  ---- adding a device --------------------------------------------------
%
%  Declare the constants and the methods in the class. Let Create call
%  .classinstance and specialise the copy it answers with. Put what the
%  page writes in .state, and give any method that names its operands a
%  working dictionary. Then tests/device-facts will ask you to say what
%  each new entry is, and check that a class states it, an instance
%  carries it, or a page writes it -- whichever you said.
%
//.internaldict /QUIET known { }{ (loading device.ps...\n)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The names .imagingrows binds its five operands to.
%
.xpostsys /.imagingrownames [ /ph /sy /off /h /bbox ] readonly put

%
%  What this run settled on for its band budget, and the figure the
%  recording class was stating when it settled. Kept here rather than
%  written back onto that class: a class states what it is and every
%  device made from it copies that statement, so a run's own figure
%  written there would stand in a declaration every later device reads.
%  In the job store because it is what this job settled on, and the next
%  job settles again.
%
.jobstore /.bandstate 2 dict put

%
%  The one number formatter for the vector writers (the PDF, SVG and DSC
%  devices format every coordinate and dimension through it): an integral
%  value prints as an integer; anything else prints with exactly two
%  decimals, never exponential -- round(n*100) sidesteps binary-float
%  print noise.
%
.xpostsys /.num2str {  % num  .  str
    % Rounded to the two places that get written, before it is asked
    % whether the number is whole. A value a hair either side of a whole
    % one is the same number at this precision, and which side it landed
    % on is the arithmetic's business and not the text's: asking first
    % wrote 4 for one and 4.00 for the other, so the same page carried
    % different bytes depending on how wide a real is in the build.
    100 mul round cvi
    dup 100 mod 0 eq {
        100 idiv 20 string cvs
    }{
        dup 0 lt { (-) exch neg }{ () exch } ifelse
        dup 100 idiv 20 string cvs
        3 -1 roll exch //.strcat exec
        exch 100 mod
        dup 10 lt { (.0) }{ (.) } ifelse exch
        20 string cvs //.strcat exec
        //.strcat exec
    } ifelse
} put

%
%  The device-resolution scale carried in the defaultmatrix fixup applied
%  after construction; a raw 1:1 device answers 1 1. Dividing a device
%  dimension by its scale yields the page size in points, which is how
%  the vector writers and the bounding-box device report their pages
%  independently of HWResolution.
%
.xpostsys /.devres-to-points {  % devdict  .  sx sy
    /defaultmatrix 2 copy known {
        get dup 0 get exch 3 get neg
    }{ pop pop 1 1 } ifelse
} put

%
%  The one class-to-instance copy, stored under /.copydict by every
%  device class and called by Create (and by the C drivers, which fetch
%  it from the class dictionary before specialising the copy).
%
%  An instance is a copy of its class with the state the instance
%  accumulates: the output file name in force when it was made, and the
%  device features of the page-device request it is being made for. The
%  page geometry is not among them -- it reaches the instance through
%  .classinstance below, which is what every Create calls. The file name matters to any class
%  whose Emit writes a file, and a class carrying a copy without it
%  produced a device that wrote wherever Emit defaulted to whatever the
%  program had asked for -- which is why this is one procedure rather
%  than a shape each class repeats.
%
%  The features arrive through /.devrequest in graphicsdict, stated
%  there by whichever route is making a device -- the page-device
%  request around the maker it runs (data/init.ps), the recording class
%  around the painter it builds (data/recorddev.ps) -- and TAKEN here,
%  not merely read, so the next device made does not inherit a request
%  that was not asked of it. They are written after the class's own
%  entries, so a request's key overrides the default the class carries;
%  a driver may therefore read a feature as its instance is created and
%  see what the request said. Two kinds of name are skipped: /Private,
%  the handle a device's own state is reached through, issued to the
%  instance holding that state; and any name the class holds a method
%  under -- the machinery reads the instance's methods as its block of
%  state is issued (xpost_handle_cons, src/lib/xpost_handle.c), and the
%  release recorded there is the class's to name, never the request's.
%  What the request asked under a method's name still reaches the
%  finished device, written there after it is built exactly as every
%  feature always was.
%
.xpostsys /.classcopydict {  % dict1  .  dict2
    dup length dict copy

    % The file name this run was started with. A request's own binding
    % is a device feature and arrives through the merge below, writing
    % over this; there is no third source, the output path being a
    % page-device parameter and not a name a program defines.
    /OutputFileName //.hostvalue exec
    dup null eq { pop }{ 1 index exch /OutputFileName exch put } ifelse

    % The request's features, taken, kept on the instance under
    % /.devrequest -- the recording class reads them back there for the
    % painter it builds -- and written over the class's entries.
    graphicsdict /.devrequest 2 copy known {
        get                                 % Copy req
        graphicsdict /.devrequest undef
        dup 2 index exch /.devrequest exch put
        {  % copy key value
            1 index /Private eq

            % A name the class holds something executable under is a
            % method, and a method is not the request's to write here.
            3 index 3 index 2 copy known
                { get xcheck }{ pop pop false } ifelse
            or
                { pop pop }
                { 2 index 3 1 roll put }
            ifelse
        } forall                            % Copy
    }{ pop pop } ifelse
} put

%
%  The one class-to-instance make, called by every Create -- the
%  PostScript ones directly, the compiled ones through the class entry
%  /.instance (xpost_dev_create_begin, src/lib/xpost_dev_generic.c).
%
%  A class is a declaration: the methods every instance of it runs and
%  the constants every instance of it answers with. The page a device
%  was made for belongs to the instance that adopted it, so the geometry
%  arrives here as operands and is written to the copy. A Create that
%  instead defined it into the class would leave the class holding one
%  page's size for the next device made to inherit, and would leave a
%  declaration that cannot be sealed because making a device writes to
%  it.
%
%  width and height are written as well as dimensions: a device's own
%  Create reads them by name out of the instance while it builds the
%  rest of it, and .adoptexactpage (init.ps) restates them there where
%  the page-device machinery published exact ones.
%
%  The copy is opened through the bracket that takes it off again
%  however the body ends, error included (.indict, callout.ps): a copy
%  left current is a dictionary the caller's error handler, and
%  everything after it, would go on defining into.
%
.xpostsys /.classinstance {  % width height class  .  instance
3 dict {
    /ci.class exch def
    /ci.height exch def
    /ci.width exch def
    ci.class //.classcopydict exec
    dup {
        /width ci.width def
        /height ci.height def
        /dimensions [ci.width ci.height] def

        % The device's name for itself. A method reads what the device
        % is through the dictionary stack, which answers whatever is
        % uppermost; where a method has been given a dictionary of its
        % own to work in, that is no longer the device. This name is
        % the device whichever it is, and a working dictionary states
        % it again so the lookup lands on the small dictionary rather
        % than searching the device for it.
        /.dev currentdict def

        % A class that prices its page in bands states the figure it was
        % written with, and the run may have been started with another;
        % the instance is where a run's own answer belongs. A class
        % stating something other than it stated when the run settled is
        % stating it deliberately, and keeps it.
        .dev /.bandbytes known {
            //.bandstate /bytes 2 copy known { get }{ pop pop null } ifelse
            dup null eq {
                pop
            }{
                //.bandstate /declared 2 copy known { get }{ pop pop null } ifelse
                .dev /.bandbytes get eq
                    { .dev exch /.bandbytes exch put }{ pop } ifelse
            } ifelse
        } if

        % Where everything this device writes after it is built goes.
        % A device's own entries are what it is -- its methods and the
        % constants they answer with -- and are settled by the time it
        % is finished; what a page does to it belongs somewhere of its
        % own, reached through this one name. Made fresh for each
        % instance, so nothing a device wrote can reach the next one,
        % and given up with it.
        /.state 8 dict def
    } //.indict exec
} //.indict exec } put

%
%  The bracket a device method runs its own working names in: the
%  device, and a dictionary of its own above it.
%
%  A method that computes a page's worth of intermediate values names
%  them, and naming them with the device current wrote them onto the
%  device -- so a device that had emitted a page carried that page's
%  arithmetic for the rest of the job. They belong to the call. This
%  gives the call a dictionary to hold them, discarded when it returns,
%  and the body needs no changing: a def lands in the working
%  dictionary because it is uppermost, and a name the body only reads --
%  the device's dimensions, its constants, its sibling methods -- is
%  found on the device beneath, at the one lookup it always cost.
%
%  What must OUTLIVE the call does not belong here. That is the
%  instance's state, written through /.state by name, and a method
%  wanting both uses both.
%
%  Inside the bracket currentdict is the working dictionary, so the
%  device is given a name of its own: .dev, for the bodies that hand
%  the device to something else.
%
%  The body is never given a name: naming a procedure runs it, and a
%  bracket that ran its body while trying to hand it to stopped would
%  lose the very unwinding it exists for. It stays on the operand stack.
%
.xpostsys /.indevwork {  % dev nslots {body}  .  -
    3 1 roll exch dup begin exch dict begin /.dev exch def
    stopped { end end //.costop exec }{ end end } ifelse
} put

%
%  Empty a dictionary, keeping the dictionary. A record a page fills and
%  the page after it starts empty is emptied rather than replaced: what
%  reads the record holds the dictionary, and installing a fresh one
%  writes the entry that names it -- on the device, for a record a device
%  keeps -- where emptying the one already there writes nothing outside
%  the record itself.
%
%  The keys are taken before any is removed. A dictionary walked while it
%  is being written is a dictionary whose walk PLRM 3.4 leaves undefined.
%
.xpostsys /.emptydict {  % dict  .  -
2 dict {
    /ed.d exch def
    /ed.keys [ ed.d { pop } forall ] def
    ed.keys { ed.d exch undef } forall
} //.indict exec } put

%
%  Refuse a device whose band budget will not buy one row of its page.
%
%  How deep a band is is the budget divided by what one row of the raster
%  costs, and that division answers one row for everything at or below a
%  row: a budget of a single byte and a budget of a whole row cut the same
%  bands. So a budget under a row is a budget the run did not get, and a
%  run told nothing would have every reason to think it had -- which is a
%  control that appears to select something and does not.
%
%  Asked of every device as it is finished, which is the one point every
%  device made passes through, and answered only for a device carrying a
%  budget: a device holding its page whole has no band for a budget to
%  cut, and puts out the same page at any budget at all.
%
%  The budget and the least it may be are both named, on the standard
%  error, because an error names an operator and a condition and carries
%  no numbers of its own. The page goes to the standard output whenever
%  the run was given no file to write it to, which is why the complaint
%  does not go there.
%
.xpostsys /.bandfits {  % dict  .  -
4 dict {
    /bf.dev exch def
    /bf.budget bf.dev /.bandbytes 2 copy known
        { get }{ pop pop null } ifelse def
    /bf.row bf.budget type /integertype eq
        { bf.dev //.xpostsys /.rowbytes get exec }{ null } ifelse def

    % A class that prices no row in bytes is a class no band arithmetic
    % can be done for, and nothing here can say whether its budget is
    % short.
    bf.row type /integertype eq
        { bf.row 0 gt { bf.budget bf.row lt }{ false } ifelse }
        { false } ifelse
    {
        4 dict begin
            /out (%stderr) (w) file def
            /n 24 string def
            out (xpost: a band budget of ) writestring
            out bf.budget n cvs writestring
            out ( bytes will not buy one row of this page, which costs )
                writestring
            out bf.row n cvs writestring
            out ( bytes\n) writestring
            out flushfile
        end
        /.completedevice cvx /rangecheck signalerror
    } if
} //.indict exec } put

%
%  Finish a freshly created device, on every path that creates one: the
%  device the interpreter starts with and the device setpagedevice makes
%  take the same finishing, so the same device behaves the same however
%  it was selected. sx and sy are the device resolution's scale from
%  points; a raw 1:1 device passes 1 1.
%
%  Written once because it was written twice, and the two were not the
%  same: only one adopted the requested process colour model, so the
%  next key added to one would be missed by the other.
%
%  Local, in privatedict: it freezes a reference to .internaldict to
%  reach the compiled rasterisers, and a global object may not hold a
%  local one.
%
%
%  Close a device that is installed and finished. Everything that says
%  what the device is has been written by this point -- the class it was
%  copied from, the page-device request's features, the post-construction
%  fixups, and whatever an Install procedure set -- and what a page does
%  to it goes to the state beside it. A device left writable is a table a
%  program can put its own method into and have the machinery run at
%  showpage; the class is closed at the lockdown, and closing the class
%  closes nothing an instance holds, a copy carrying its own references.
%
.xpostsys /.sealdevice {  % devdict  .  -
    systemdict /UNSEALEDDEVICES known { pop }{ readonly pop } ifelse
} put

.privatedict /.completedevice {  % devdict sx sy  .  -
    % Whether the budget this device's bands were cut to bought any of
    % them, asked before anything is written on the device and before
    % the scratch dictionary below is opened, so that a refusal leaves
    % nothing to be taken back.
    2 index //.bandfits exec

    % The scratch dictionary and the matrix built below hold the device,
    % which is a local object, so they are made in local VM whatever the
    % caller was allocating in.
    currentglobal false setglobal
    4 dict begin
    /og exch def /sy exch def /sx exch def /dev exch def

    % The page's default matrix: device space runs y-down from the top
    % of the page, scaled by the device resolution, and by the ratio a
    % window device adopted when it opened smaller than the page asked
    % for. The flip translate must match the height the device actually
    % adopted, or marks sit offset within the page.
    dev /windowscale 2 copy known { get }{ pop pop 1 } ifelse
    /ws exch def
    dev /defaultmatrix
        [ ws sx mul 0 0 ws sy mul neg 0 dev /height get ] put

    % A device declaring support for the requested process colour model
    % adopts it as its native space; the colour pipeline then delivers
    % that model's components to the marking methods. Before the fills
    % are chosen below, because which compiled fill fits depends on it.
    % A paint carries one value per component of the space it is made
    % in, so the count moves with the space: a device left saying how
    % many it took in the space it has stopped taking them in would hand
    % its marking methods one value in the place of another. Moved only
    % where the device states a count and the space it has adopted has
    % one -- a device offering the model that is whatever space a paint
    % was made in carries no fixed count to move.
    dev /ProcessColorModel 2 copy known {
        get dev /.colormodels 2 copy known {
            get 1 index known {
                dup dev /nativecolorspace 3 -1 roll put
                dev /.ncomp known {
                    //.xpostsys /.spacecomps get 1 index known {
                        //.xpostsys /.spacecomps get 1 index get
                        dev /.ncomp 3 -1 roll put
                    } if
                } if
                pop
            }{ pop } ifelse
        }{ pop pop pop } ifelse
    }{ pop pop } ifelse

    % Override the class's scanline methods with the compiled
    % rasterizers, except where the device declares it draws nothing:
    % rasterizing into the null device would burn the whole render cost
    % of a page to discard every span.
    %
    % Fetch nativecolorspace with get, and hold it literal: some devices
    % store it as an executable name, which naming it again would
    % execute.
    dev /NoOutput known not {
        /cs dev /nativecolorspace get cvlit def

        % The compiled scanline fill paints in the device's native
        % colour space, and it paints in two of them; a device declaring
        % any other keeps the class's own polygon fill, which takes its
        % component count from the device.
        cs /DeviceGray eq cs /DeviceRGB eq or {
            dev /FillPoly //.internaldict /.fillpoly get put
        } if

        % The compiled rectangle fills write the page as the array of
        % row strings the base classes keep it in under /ImgData
        % (.xpost_PGMIMAGE, PPMIMAGE), so they fit a device whose raster
        % is that array and no other: a device that keeps its raster in
        % a C buffer (bgr, the png family) carries no such array, and a
        % fill reaching for one answers undefined at the first
        % rectangle. A device that brought a compiled rectangle fill of
        % its own keeps that as well -- what it brought reaches the
        % raster it holds. Both conditions are the compiled fill's
        % rather than one colour space's, so they are asked once and the
        % colour space chooses only which fill is installed; erasepage
        % clears the page through whichever the device ends up with.
        dev /ImgData known {
            dev /FillRect 2 copy known
                { get type /operatortype ne }{ pop pop true } ifelse
        }{ false } ifelse {
            cs /DeviceGray eq {
                dev /FillRect //.internaldict /.fillrectgray get put
            } if
            cs /DeviceRGB eq {
                dev /FillRect //.internaldict /.fillrectrgb get put
            } if
        } if
    } if

    og
    end
    setglobal
} bind put

%
%  The run of a page's rows an imaging bounding box reaches.
%
%  PLRM 6.2 gives ImagingBBox as four numbers in the default user
%  coordinate system -- left, bottom, right and top -- and calls it the
%  program's assertion that it paints no marks outside them. Only the
%  vertical pair is read here: a device holding its page as rows can drop
%  whole rows and cannot hold half of one, so what the box buys is the
%  rows above its top edge and below its bottom edge and nothing else.
%
%  h is the page's height and off the vertical page offset, both in the
%  default user space the box is stated in; sy is the rows a unit of it
%  covers, and ph the rows of the whole page. Default user space runs up
%  from the foot of the page and the rows run down from its head, so the
%  top edge gives the first row and the bottom edge the last.
%
%  The answer is null wherever the box says nothing that saves a row --
%  not four numbers, or covering the page already -- and a caller given
%  null holds the whole page. A box that reaches no row of the page at
%  all still leaves a page to paint on, so one row is held rather than
%  none.
%
.xpostsys /.imagingrows {  % bbox h off sy ph  .  [top rows] | null
    12 dict begin
    //.imagingrownames {exch def}forall
    bbox type dup /arraytype eq exch /packedarraytype eq or
    { bbox length 4 eq }{ false } ifelse
    { true bbox { type dup /integertype eq exch /realtype eq or and } forall }
    { false } ifelse
    {
        /y0 bbox 1 get off add def
        /y1 bbox 3 get off add def
        y0 y1 gt { /t y0 def /y0 y1 def /y1 t def } if
        /top h y1 sub sy mul floor cvi def
        /bot h y0 sub sy mul ceiling cvi def
        top 0 lt { /top 0 def } if
        bot ph 1 sub gt { /bot ph 1 sub def } if
        bot top lt { /top 0 def /bot 0 def } if
        top 0 le bot ph 1 sub ge and
            { null }
            { [ top bot top sub 1 add ] }
        ifelse
    }{ null } ifelse
    end
} put

%
%  What has become of the page, kept where the program cannot take it
%  back. Four facts, each written by the machinery as a page is painted
%  and transmitted and read again at the next page: /.pageno the count of
%  pages transmitted, which fills the marker in the output file name;
%  /.plrmpage the count a page device's own handlers are told; /.marked
%  whether anything has been painted since the page began; and /.sent
%  whether any page has been transmitted at all. The accessors below
%  carry them.
%
%  A program brackets its pages in save and restore -- the separation-plate
%  idiom is exactly that -- and restore reverts local virtual memory
%  wholesale (PLRM 3.7.2), so a record parked there is rewound between one
%  page and the next: the page numbering collapses onto one file, and a page
%  the program painted is forgotten. This dictionary is global, which
%  restore leaves alone.
%
.jobstore /.pagestate 1 dict put

%
%  The page-number marker in an output file name: where it begins, and how
%  many digits it asks the number be written in.
%
%  Two spellings are read. %d writes the number as it stands, and %0Nd
%  writes it in N digits with leading zeros, N being one digit from 1 to
%  9. A number too large for the field is written whole rather than cut,
%  so a run longer than the field was written for goes on numbering its
%  pages instead of collapsing them onto one name.
%
%  Nine digits is the whole of the width because the number filling the
%  field is a count of pages transmitted: nine digits is a run of a
%  thousand million pages, which is past what any run reaches, and the
%  field is then never more than nine characters of a name the platform
%  has its own length limit for. A wider one is refused rather than
%  quietly cut back, since a name cut back to fit is a name the run does
%  not write to.
%
%  This reads the name; it never formats with it. The characters are
%  compared one at a time here, the number becomes text through cvs, and
%  the pieces are put back together by concatenation (.pagefilename
%  below), so a name that arrived on a command line or out of a program's
%  /OutputFile is never handed to anything that would read a conversion
%  out of it. That is the reason the marker is parsed here rather than
%  passed along to something that formats.
%
%  One marker, and no more: a page has one number, and a name offering it
%  two places to go says nothing about which. A second is refused.
%
%  A per-cent this does not recognise is left where it stands, because a
%  per-cent opens the names the file operator gives the standard streams
%  -- %stdout and the three beside it (PLRM 3.8.2) -- and a path a URL
%  was encoded into carries a per-cent and two digits. What is refused
%  instead is a per-cent that opens a field width and ends in d: %2d,
%  %5d, %-5d, %.2d, %*d, %0d, %00d, %010d. Every one of those is somebody
%  asking for a page number in a spelling this does not read, and taken
%  as text each puts every page of the run in one file and says nothing.
%
.xpostsys /.pagemarker { 12 dict {  % name  .  index width true | false
    % The name is taken as a copy made where this is running. A caller may
    % be part-way through a piece of work in global memory -- the vector
    % devices decide the shape of their output under it -- and the name it
    % is asking about came from a program's request, which is local; a
    % local object put into the global dictionary opened here is refused
    % (PLRM 3.7.2). The copy carries characters and not a reference, so
    % it belongs wherever it was made.
    /nm exch dup length string copy def
    /n nm length def
    /idx null def
    /wid 0 def
    /i 0 def

    %  Whether a character can stand between the per-cent and the d of a
    %  field width. It is that run ending in d, and not the per-cent
    %  alone, that tells a misspelt marker from a name that merely
    %  carries a per-cent.
    /fieldchar {  % code  .  bool
        dup 48 ge 1 index 57 le and     % a digit
        exch dup 45 eq                  % -
        1 index 43 eq or                % +
        1 index 32 eq or                % a space
        1 index 35 eq or                % #
        1 index 46 eq or                % .
        1 index 42 eq or                % *
        exch 39 eq or                   % '
        or
    } bind def

    %  Say what is wrong with the name and what a page number may be
    %  spelled, and stop. The name is written back so a run with several
    %  output bindings can see which of them this was.
    /refuse {  % reason  .  -   (does not return)
        4 dict begin
            /out (%stderr) (w) file def
            out (xpost: ) writestring
            out nm writestring
            out ( ) writestring
            out exch writestring
            out (. A page number is %d, or %0Nd for N digits with) writestring
            out ( leading zeros, N being 1 to 9, and one name carries) writestring
            out ( one of them\n) writestring
            out flushfile
        end
        /.pagefilename cvx /rangecheck signalerror
    } bind def

    {
        i n 1 sub ge { exit } if
        nm i get 37 eq {
            nm i 1 add get 100 eq {
                idx null ne { (carries a second page number) refuse } if
                /idx i def
                /wid 0 def
                /i i 2 add def
            }{
                nm i 1 add get fieldchar {
                    % the run of field characters, and what ends it
                    /e i 1 add def
                    { e n ge { exit } if
                      nm e get fieldchar not { exit } if
                      /e e 1 add def } loop
                    e n lt { nm e get 100 eq }{ false } ifelse {
                        % a page number, in this spelling or in none
                        e i 3 add eq
                        { nm i 1 add get 48 eq }{ false } ifelse
                        { nm i 2 add get dup 49 ge exch 57 le and }
                        { false } ifelse
                        {
                            idx null ne
                                { (carries a second page number) refuse } if
                            /idx i def
                            /wid nm i 2 add get 48 sub def
                            /i e 1 add def
                        }{ (spells a page number this does not read) refuse }
                        ifelse
                    }{
                        /i i 1 add def
                    } ifelse
                }{
                    /i i 1 add def
                } ifelse
            } ifelse
        }{
            /i i 1 add def
        } ifelse
    } loop

    idx null eq { false }{ idx wid true } ifelse
} //.indict exec } put

%
%  The output file name for the page about to be written: the marker in
%  the name given, replaced by the number of pages transmitted so far and
%  padded to the width the marker asked for. A name without a marker comes
%  back unchanged, and every page then writes the same file with the last
%  one standing.
%
%  The count is the record's, above, and is advanced here as the name is
%  settled: one counter for every device there is, and one a program's
%  restore does not rewind.
%
%  The name is rebuilt from three pieces -- what stood before the marker,
%  the number as text, and what stood after it -- so the only characters
%  this puts into a name are the decimal digits of a page number. There is
%  no route by which a name a program supplied could be read as anything
%  but the text it is.
%
.xpostsys /.pagefilename {  % name  .  name'
    dup //.pagemarker exec {
        8 dict {
            /wid exch def
            /idx exch def
            % copied where this is running, for the reason .pagemarker
            % states above
            /nm exch dup length string copy def
            /no //.pagestate /.pageno 2 copy known
                { get }{ pop pop 1 } ifelse def
            no 1 add //.pagestate exch /.pageno exch put

            % the number, filled out to the width with leading zeros; one
            % wider than the field keeps every digit it has
            /txt no 10 string cvs def
            { txt length wid ge { exit } if
              /txt (0) txt //.strcat exec def } loop

            % %d is two characters of the name and %0Nd is four
            /len wid 0 eq { 2 }{ 4 } ifelse def
            nm 0 idx getinterval
            txt //.strcat exec
            nm idx len add  nm length idx len add sub  getinterval
            //.strcat exec
        } //.indict exec
    } if
} put

%
%  Transmit one page through a device: settle the name this page's output
%  goes to, then run the device's Emit.
%
%  The name is settled here, once, for every device there is. The template
%  is /OutputFileName -- the device's own, put there when it was made from
%  the run's binding or the request's /OutputFile -- and a page-number
%  marker in it is replaced with the page number, from the one counter
%  .pagefilename keeps, so every device numbers its pages alike. A device
%  with no name at all writes to the standard output, which is where a
%  page goes when nobody said where. What comes out is stored in the device's state as
%  /.outputfile, and that -- not the template -- is what an Emit opens.
%
%  Settling the name belongs to the page and not to the device: a device
%  that settled it when it was made wrote every page of a job to the name
%  page one had, and a device written afterwards would have had to
%  remember not to. Every path that transmits a page comes through here,
%  so there is no way to write a page without one.
%
.xpostsys /.transmitpage {  % dict  .  -
    dup /OutputFileName 2 copy known
        { get }
        { pop pop /OutputFileName //.hostvalue exec
          dup null eq { pop (%stdout) } if }
    ifelse
    //.pagefilename exec
    1 index /.state get exch /.outputfile exch put

    % What became of this page, for a run that asked to be told
    //.internaldict /QUIET known
        { }{ dup //.xpostsys /.reportpage get exec } ifelse
    dup /Emit get exec
} put

(/image.ps) //.loadmodule exec  % Image.ps implements device base classes
(/nulldev.ps) //.loadmodule exec  % Nulldevice
(/bboxdev.ps) //.loadmodule exec  % Bounding-box device
(/recorddev.ps) //.loadmodule exec  % Recording device
(/pdfwrite.ps) //.loadmodule exec  % Pdf device
(/svgwrite.ps) //.loadmodule exec  % Svg device
(/dscwrite.ps) //.loadmodule exec  % Distilled-ps device

%
%  Mirror the device class dictionaries into privatedict, where the makers and
%  the C drivers reach them. They stay where they were defined too, for the
%  load-time methods still to come, until .finalize replaces them with local
%  copies in privatedict and drops those anchors. The device files define into
%  the dictionary current here, which is the one the language is being read
%  into.
%  Which dictionaries those are is read off the one they were defined in
%  rather than named here. A class states itself by the name it is
%  defined under; a list beside it is a second statement, and a class
%  added later reaches the first without reaching the second -- it is
%  then never mirrored, and the maker that reaches for it answers
%  undefined at the first page of the only run that selects it.
%
[ currentdict { pop } forall ]
{ dup //.isclassname exec
    { dup currentdict exch get .privatedict 3 1 roll put }
    { pop } ifelse
} forall

%
%  Bring the budget this run works to and the class that works to it into
%  line, and leave the number where both sides of the interpreter read it.
%
%  How deep a band is is that budget divided by what one row of the raster
%  costs, and the same number is what a page is weighed against to decide
%  whether it is held as its marks at all: a page the budget covers
%  arrives in one band, which is the page. So the budget is the one
%  control over both, and lowering it is what holds a smaller page in
%  bands.
%
%  The class carries the budget a run that names none works to, and states
%  what that number rests on (data/recorddev.ps). Where the invocation
%  named one it goes on the class, in place of that; where it named none
%  the class's own goes into the settings. Either way one number stands in
%  both places afterwards, which matters because the two halves of the
%  interpreter reach it by different routes: the band arithmetic takes it
%  off the class or off a device copied from it, and the driver holding a
%  record takes it out of the settings, where what a run decided lives.
%
%  The driver takes it from there and not off the device it is holding,
%  because the two are not the same question. What a device carries is the
%  grid its own page is cut into, and something making a device may cut it
%  as fine as it likes; what bounds the marks is what this run said it
%  would spend on a page, which no page may raise or lower for itself. A
%  record weighed against the grid of a one-row band would put a page's
%  marks in a file at the first of them.
%
%  Done as the run's device is made, and not as this file is read. The
%  language a run is given may have been read whole out of an image of the
%  virtual memory another run built it in, and that other run's
%  invocation is not this one's: a budget written where the class is
%  defined would be written once, into the image, and every run after
%  would band to whatever the run that wrote the file was given. What is
%  settled afresh on every launch lives in the settings this reads from
%  (data/init.ps), and this is the point at which the two are brought into
%  line -- before the first device, which is before the first page is
%  weighed.
%
.xpostsys /.settlebandbudget {  % -  .  -
    .privatedict /.xpost_RECORD known {
        currentglobal true setglobal

        % The figure the class is stating as this run settles, so that a
        % class saying something else afterwards is saying it on purpose
        % and keeps it.
        .privatedict /.xpost_RECORD get /.bandbytes get
        //.bandstate exch /declared exch put

        /MaxBandBytes //.hostvalue exec
        dup type /integertype eq
            { //.bandstate exch /bytes exch put }
            { pop
              //.bandstate /declared get
              dup //.bandstate exch /bytes exch put
              //.hostdict /MaxBandBytes 3 -1 roll put }
        ifelse
        setglobal
    } if
} put

%
%  What one band of a page may cost this run, in bytes of the raster a
%  device holds at once. This is the value currentsystemparams reports as
%  MaxBandBytes.
%
%  Read off the recording class, which is where the budget is settled
%  above and where every reading of it is taken, so a program is told the
%  number the band loop divided rather than a second copy of it.
%
%  A run whose graphics never loaded carries no such class and holds no
%  page in bands, and answers nought -- the same nothing .curbandheight
%  answers for the band it would have reported.
%
.xpostsys /.bandbudget {  % -  .  bytes
    % What the recording class states, and what this run settled on. The
    % run's figure stands where the class still states what it stated as
    % the run settled; a class saying something else is saying it on
    % purpose and is answered with, which is the same rule the instance
    % is made under.
    .privatedict /.xpost_RECORD 2 copy known
        { get /.bandbytes 2 copy known { get }{ pop pop 0 } ifelse }
        { pop pop 0 } ifelse
    dup //.bandstate /declared 2 copy known { get }{ pop pop null } ifelse
    eq {
        //.bandstate /bytes 2 copy known { get }{ pop pop null } ifelse
        dup null eq { pop }{ exch pop } ifelse
    } if
} put

%
%  The rows the device now being painted into holds of its page at once,
%  and zero where it holds the page whole. This is the value
%  currentsystemparams reports as CurBandHeight.
%
%  The rows come from .bandheight (data/recorddev.ps), which is where the
%  band loop takes them. Zero is this reading and not that one: a page
%  held whole is one band covering it, which is a band height only in the
%  sense that there are no bands, and a program asking how its marks were
%  held is asking exactly that.
%
%  A run whose graphics never loaded has no device to ask and no band
%  loop to report on, and answers zero.
%
.xpostsys /.curbandheight {  % -  .  rows
3 dict begin
    /rows 0 def
    % No /graphicsdict where. The lockdown sweeps the name -- it answers
    % with the live graphics state -- so a run-time search for it is
    % always false and everything behind it is dead, which left this
    % answering nought rows however the device was banding. The // below
    % is what survives that: it splices the operator into this body as it
    % is read, while the name still answers, and asks for that one name
    % and no other. Binding the whole body would keep this name too, and
    % would also freeze every other name here and make the body read-only,
    % so the sweep that binds .xpostsys could never come back for the
    % operators this interpreter implements in PostScript.
    //graphicsdict /currgstate get /device get
    dup type /dicttype eq {
            /dev exch def
            dev /height known {
                dev //.bandheight exec
                dup dev /height get lt { /rows exch def }{ pop } ifelse
            } if
        }{ pop } ifelse
    rows
end } put

%
%  What one record costs, in bytes. .recordcost answers with three
%  figures -- the marks, the images among them, and the bytes -- and the
%  bytes are the last of them; every caller here wants that one and no
%  other, so the reaching past the first two is written once.
%
.xpostsys /.recordbytes {  % devdic  .  bytes
    //.internaldict /.recordcost get exec
    exch pop exch pop
} put

%
%  How many bytes the marks of the page now being painted come to. PLRM
%  Appendix C calls this the display list, and CurDisplayList reports it.
%
%  Read from the device holding the record, for the reason MaxFontCache
%  is read from the cache: the figure the spill decision goes by is the
%  one a program is told, rather than a second tally that could disagree
%  with it. A device painting its own page holds no record and answers
%  nought, and so does a run whose graphics never loaded.
%
.xpostsys /.curdisplaylist {  % -  .  bytes
2 dict begin
    /bytes 0 def
    % No /graphicsdict where, and // for the same reason -- see
    % .curbandheight above.
    //graphicsdict /currgstate get /device get
    dup type /dicttype eq {
            dup /.playclass known {
                dup //.xpostsys /.recordbytes get exec
                /bytes exch def
            } if
        } if
    pop
    bytes
end } put

%
%  What the drawings the form cache now holds come to, in bytes, which
%  currentsystemparams reports as CurFormCache.
%
%  Each drawing is held by a recorder, and a recorder already weighs what
%  it holds -- the same number the spill decision goes by. So this asks
%  the recorders rather than keeping a tally beside them: a tally would be
%  a second answer to one question, and the two would part company the
%  first time a restore wound the table back without winding the tally
%  with it.
%
%  Here rather than beside the cache itself in init.ps, and the reason is
%  graphicsdict: the name is an operator this file's bodies can have bind
%  freeze, and init.ps is read before the file that defines it. An entry
%  naming no drawing is one that says a form cannot be held, and is passed
%  over as it is everywhere else.
%
.xpostsys /.formcachebytes {  % -  .  bytes
2 dict begin
    /total 0 def
    % No /graphicsdict where, and // for the same reason -- see
    % .curbandheight above.
    //graphicsdict /.formcache 2 copy known {
        get {
            exch pop
            dup /drawing known {
                /drawing get //.xpostsys /.recordbytes get exec
                total add /total exch def
            }{ pop } ifelse
        } forall
    }{ pop pop } ifelse
    total
end } put

%
%  Where this run wants a retained page's marks held, and where the marks
%  of the page now being painted actually are. These are the values
%  currentsystemparams reports as RecordSpill and CurRecordSpill.
%
%  Two readings rather than one, because they can differ and the
%  difference is what a reader most needs: a run that asked for its marks
%  to be weighed, on a machine that will take no scratch file, holds them
%  in memory and is told so at start-up, and a program given only the
%  state asked for could not tell that from a page that never needed to
%  spill.
%
%  /never, /auto or /always for the first. /memory, /file or /refused for
%  the second: in memory, in a file, or in memory having been refused a
%  file it wanted.
%
%  The device now being painted into answers, since it is the one holding
%  the marks. A device that holds no record -- a page under the band
%  budget, painted directly -- holds its marks nowhere and answers
%  /memory, which is where the pixels of such a page are. A run whose
%  graphics never loaded has no device to ask and answers the same.
%
.xpostsys /.currecordspill {  % -  .  /asked /held
2 dict begin

    % What the run asked for, read from the run: it is the run's answer
    % whatever device happens to be in hand, and a page painted directly
    % carries no record to ask.
    /asked /RecordSpill //.hostvalue exec def
    asked type /nametype ne { /asked /auto def } if

    % Not /where: bind bakes the operator of that name into this body,
    % and a local of the same name would never be the one read back.
    /held /memory def
    % No /graphicsdict where, and // for the same reason -- see
    % .curbandheight above.
    //graphicsdict /currgstate get /device get
    dup type /dicttype eq {
            % a device holding a record is the one to ask; one painting
            % its own page holds its marks nowhere and answers /memory,
            % which is where the pixels of such a page are.
            dup /.playclass known {
                dup //.internaldict /.recordspill get exec
                /held exch def pop
            } if
        } if
        pop
    asked held
end } put

%
%  Name what is about to become of one page: the device the page was
%  asked of, the device that paints it, whether it is held whole or a
%  band at a time, how deep a band is, and how large the page is. The
%  last two are the comparison the choice is made by, so a reader is told
%  what was decided and what decided it rather than only the verdict.
%
%  One line per page, on the standard error. The page itself goes to the
%  standard output whenever the run was given no file to write it to, so
%  a report sharing that stream would arrive inside the page and be read
%  as part of it.
%
%  The device asked of is the one the page description last named, and
%  the one the run was started with where it named none; the device that
%  paints is the target a record plays into, and otherwise the device
%  asked of, which paints its own page.
%
.xpostsys /.reportpage {  % dict  .  -
8 dict begin
    /dev exch def
    /out (%stderr) (w) file def
    /n 20 string def
    /asked
        //graphicsdict /.pagedevice 2 copy known {
            get /OutputDevice 2 copy known
                { get }{ pop pop null } ifelse
        }{ pop pop null } ifelse
        dup null eq {
            % No /graphicsdict where, and // for the same reason -- see
    % .curbandheight above.
            pop //graphicsdict /.outputdevice 2 copy known
                { get }{ pop pop null } ifelse
        } if def
    /paints dev /.playclass known { dev /.playclass get }{ asked } ifelse def
    /pw dev /width known { dev /width get }{ 0 } ifelse def
    /ph dev /height known { dev /height get }{ 0 } ifelse def
    /rows dev //.bandheight exec def
    out (xpost: page ) writestring
    out //.xpostsys /.pageno get exec 1 add n cvs writestring
    out ( to ) writestring
    out asked null eq { (an unnamed device) }{ asked n cvs } ifelse writestring
    out (, painted by ) writestring
    out paints null eq { (itself) }{ paints n cvs } ifelse writestring
    out rows ph lt { (, in bands: ) }{ (, whole: ) } ifelse writestring
    out rows n cvs writestring
    out ( rows held at once of a ) writestring
    out pw n cvs writestring
    out (x) writestring
    out ph n cvs writestring
    out ( page\n) writestring
    out flushfile
end } put

%
%  Make the device this run was started with and install it in the
%  graphics state.
%
%  Apart from the loading above, and after it, because the two are not
%  the same kind of thing. The modules read above are the language, which
%  is the same for every run of this build. A device is not: it is the
%  one this run asked for, at the page this run asked for, and the next
%  run would want a different one. So the loading leaves the graphics
%  state carrying no device and this is what puts one there, which is
%  also what leaves a point between them at which the language stands
%  complete and nothing of the run has been decided yet.
%
%  Which device and which page are read from the settings a run has, the
%  one place a value the invocation decided is kept.
%
%  Once in the life of a context. The graphics state is the record of
%  that: a device already installed -- by this step or by a page-device
%  request afterwards -- is the one serving the run, and building a
%  second would leave the first holding state that is not virtual memory,
%  past the reach of both the collector and a restore.
%
%  A refusal here is carried out to the start-up report in data/init.ps,
%  which names the device and the page this run asked for.
%
%  Global, with the namespace it goes into: the body holds no local
%  object, reaching the local ones through the operators that answer with
%  them.
%
.xpostsys /.startdevice {  % -  .  -
    % The budget this run's pages are cut into bands by, brought into
    % line with what this run was started with before anything is weighed
    % against it (.settlebandbudget above).
    //.settlebandbudget exec
    graphicsdict /currgstate get /device 2 copy known
        { get null ne }{ pop pop false } ifelse
    { }{
        % The device is a local object: a page device's parameters are
        % written into it as the job runs, and a restore has to take
        % them back.
        currentglobal false setglobal

        % The device this run asked for, which is the name a page-device
        % request naming none goes on being made from, and the name a
        % refusal is reported under. The route a page takes is not part
        % of it: a selection whose page may arrive a band at a time is
        % handed to the recording class before it gets here, and taking
        % that back is what the weighing below does.
        /StartDeviceAsked //.hostvalue exec

        % A device the build left the driver out of registers no maker,
        % so the roster the page-device request is held to is the roster
        % here as well.
        //.xpostsys /.devicemakers get 1 index known not
            { /.startdevice cvx /undefined signalerror } if

        % Which device that selection is made through at the page this
        % run opens at. A page too large for the band budget to cover is
        % made through the recording class, which holds it in less memory
        % than the page; a page the budget already covers is made on the
        % device the run asked for, recording nothing (.devicefor,
        % data/recorddev.ps). Every page-device request afterwards is
        % weighed the same way at the page it asks for, so what is named
        % below is the selection and not the route this page took.
        dup /StartPageSize //.hostvalue exec aload pop
        //.devicefor exec
        /StartPageSize //.hostvalue exec aload pop
        3 -1 roll //.xpostsys /.devicemakers get exch get exec

        % The interpreter's own device takes the same finishing
        % setpagedevice gives the ones it makes; the start-up page is at
        % the device's own resolution, so the point-to-device scale is
        % 1:1.
        dup 1 1 .privatedict /.completedevice get exec

        % The template and the live state carry the device; painting and
        % the defaultmatrix operator resolve it through them.
        .privatedict /.gstatetemplate get exec /device 2 index put
        graphicsdict /currgstate get /device 2 index put
        pop
        graphicsdict /.outputdevice 3 -1 roll put
        setglobal
        //.internaldict /QUIET known { }{
            (device made, initialising graphics state\n)print } ifelse

        % The state a newly installed device starts from, which is the
        % state any other device would start from, so it is built the
        % same way.
        //.xpostsys /.initdevicegstate get exec

        % The first page starts clear. Every later one is cleared by
        % showpage; the reset clears none of them, since it resets the
        % graphics state and not raster memory.
        erasepage

        DEVICE //.sealdevice exec
    } ifelse
} put

%
%  Put out what the device is holding without ending its page. A device
%  with nothing to flush has no Flush method and this does nothing.
%
/flushpage {  % -  .  -
    DEVICE /Flush known {
        DEVICE dup /Flush get exec
    } if
} bind def

%
%  The wait the announcing semantics take at a page boundary: name the
%  page on the standard output and read a line from the line editor.
%
%  Both halves are for a person, so both are done where the run has one
%  and neither where it has not. That is the question the run already
%  answers to decide whether to offer an interactive session at all --
%  a terminal on the standard input, and no output file naming something
%  that waits for one -- and it is read here rather than asked again.
%
%  Each half does harm without a person to receive it. The name is
%  addressed to a reader, and a run nobody is reading lands it in the
%  middle of what the program is writing on that same channel. The read
%  is somebody pressing return, and where there is nobody the standard
%  input is carrying something else and the read takes a line of it.
%
.xpostsys /.pagepause {  % (banner)  .  -
    /.interactive //.hostvalue exec
    {
        =print flush
        [ {(%lineedit)(r)file}stopped cleartomark
    }{
        pop
    } ifelse
} put

.xpostsys /.showpagesemanticsdict <<

    % XPOST_SHOWPAGE_DEFAULT
    0 {
        (----showpage----) //.pagepause exec
        DEVICE /.state get /pagenumber
        2 copy known {
            2 copy get 1 add put
        }{
            1 put
        } ifelse
        erasepage
    }

    % XPOST_SHOWPAGE_NOPAUSE
    1 {
        % Don't do it.
        % do not pause right here.
    }

    % XPOST_SHOWPAGE_RETURN
    2 {
        returntocaller
    }
>> put

%
%  copypage transmits the page without erasing it (PLRM 8.2), so it ends
%  a page for the embedder's purposes but not for the program's: it takes
%  the same three behaviours, less the page number and the erasure.
%
.xpostsys /.copypagesemanticsdict <<
    0 { (----copypage----) //.pagepause exec }
    1 { }
    2 { returntocaller }
>> put

%
%  The page device's own handlers (PLRM 6.2.6). A page device may carry a
%  BeginPage procedure to run at the start of each page and an EndPage
%  procedure to run at the end. Each is handed the number of pages the device
%  has transmitted, EndPage is told why the page is ending, and the boolean it
%  returns says whether the page is transmitted at all.
%
%  The count lives beside the page number in the global record, so the
%  save and restore a job wraps around a page does not rewind it, and it
%  starts again at zero for each device activated.
%
%  .pageno reads it and .setpageno writes it.
%

.xpostsys /.pageno {  % -  .  int
    //.pagestate /.plrmpage 2 copy known { get }{ pop pop 0 } ifelse
} put

.xpostsys /.setpageno {  % int  .  -
    //.pagestate exch /.plrmpage exch put
} put

%
%  Two facts about the page, kept beside the count and for the same reason:
%  a job wraps a save and restore around its pages, and what has become of
%  them is not part of what a restore rewinds.
%
%  Whether anything has been painted since the page began, and whether any
%  page has been transmitted at all. Together they say whether a job that
%  ends without asking for its page has one to give: a program that painted
%  and never transmitted has a page nobody has seen, and the alternative to
%  ending it here is throwing it away. A program that did transmit has said
%  where its pages end, and what it painted afterwards is a page it did not
%  finish -- that one is dropped, as it is by the interpreters this follows.
%
%  .pagemarked and .setpagemarked carry the first, .pagesent and
%  .setpagesent the second.
%

.xpostsys /.pagemarked {  % -  .  bool
    //.pagestate /.marked 2 copy known { get }{ pop pop false } ifelse
} put

.xpostsys /.setpagemarked {  % bool  .  -
    //.pagestate exch /.marked exch put
} put

%
%  The same record, reached from where the interpreter's own side reads
%  the local machinery. A rendered glyph's pixels are written to the
%  device by the text machinery rather than by a painting operator, so
%  that machinery records what it left under /.marked itself, and it
%  needs the dictionary the two accessors above read and write. The
%  dictionary is the one object shared, not a copy: what one side writes
%  is what the other reads.
%
.privatedict /.pagestate //.pagestate put

.xpostsys /.pagesent {  % -  .  bool
    //.pagestate /.sent 2 copy known { get }{ pop pop false } ifelse
} put

.xpostsys /.setpagesent {  % bool  .  -
    //.pagestate exch /.sent exch put
} put

%
%  The handler the current page device carries under that name, or null where
%  it carries none.
%
.xpostsys /.pagehandler {  % name  .  proc|null
    graphicsdict /.pagedevice 2 copy known {
        get exch 2 copy known { get }{ pop pop null } ifelse
    }{ pop pop pop null } ifelse
} put

%
%  Which entry of a page-device request an error is about. PLRM 3.11 has
%  an operator that takes a parameter dictionary leave the key and the
%  value of the entry it could not accept in $error, as a two-element
%  array, for the handler to report beside the error; PLRM 8.2 requires
%  it of configurationerror in particular.
%
%  $error is reached by name rather than by a frozen reference: it is a
%  name in systemdict for a dictionary that lives in local VM, and this
%  file's procedures are global.
%
.xpostsys /.setpageinfo {  % key value  .  -
    2 array astore $error exch /errorinfo exch put
} put

%
%  A handler that cannot be executed cannot be run at a page boundary, and
%  finding that out then would leave the page half made; the dictionary is
%  refused as it is offered instead. Install is held to the same rule for
%  the same reason: it runs with the new device already installed, so a
%  request offering one that cannot be run would be refused with the
%  device it was replacing already gone. The entry refused is named in
%  $error, as every entry a page-device request is refused over is.
%
%
%  The page-device parameters a request may carry, and the whole of
%  them. A request naming anything else is accepted and the entry
%  dropped: the parameters are what the device answers for, and a key
%  outside them describes nothing this interpreter renders by.
%
%  Dropping rather than keeping is what stops a request reaching past
%  the parameters into the device itself. A device dictionary holds the
%  procedures the machinery paints through -- FillRect, PaintImage,
%  ClipPath, Destroy and eighty-five more (tests/device-facts) -- under
%  ordinary names in the same dictionary the parameters live in, so a
%  request whose key happened to be one of those names replaced the
%  method with the program's procedure and every later mark went through
%  it. The parameters are enumerated here instead, and nothing else a
%  request names is written anywhere.
%
%  The list is PLRM 6.2 Table 6.1, less the parameters that describe
%  media this interpreter does not select between, plus the device
%  features it reads for itself: the coverage a glyph's edge is sent at,
%  whether an extent-tracking device counts a white mark as ink, and the
%  four codec knobs the compiled writers read. The band budget and the
%  spill choice are not among them -- those are system parameters, asked
%  and answered through currentsystemparams -- and neither are the
%  distiller parameters, which setdistillerparams carries.
%
.xpostsys /.pagedeviceparams <<
    /PageSize 0 /HWResolution 0 /PageOffset 0 /ImagingBBox 0 /Margins 0
    /Orientation 0 /MirrorPrint 0 /NegativePrint 0 /ImageShift 0
    /MediaColor 0 /MediaWeight 0 /MediaType 0 /MediaClass 0
    /MediaPosition 0 /InsertSheet 0 /LeadingEdge 0 /ManualFeed 0
    /InputAttributes 0 /OutputAttributes 0 /DeferredMediaSelection 0
    /NumCopies 0 /Collate 0 /Duplex 0 /Tumble 0 /Jog 0 /OutputType 0
    /OutputFaceUp 0 /TraySwitch 0 /AdvanceMedia 0 /AdvanceDistance 0
    /CutMedia 0 /RollFedMedia 0
    /Policies 0 /PolicyReport 0 /BeginPage 0 /EndPage 0 /Install 0
    /OutputDevice 0 /OutputFile 0 /PageDeviceName 0
    /ProcessColorModel 0 /UseCIEColor 0
    /Separations 0 /SeparationColorNames 0 /SeparationOrder 0
    /MaxSeparations 0 /Trapping 0 /TrappingDetails 0
    /TextAlphaBits 0 /WhiteIsOpaque 0
    /png_compression_level 0 /png_interlaced 0 /png_filter 0
    /jpeg_quality 0

%  Read-only, and that is part of what it is for. The list is what keeps
%  a request from reaching the procedures the machinery paints through,
%  so a list that could be added to is a list that could be made to let
%  one through again. Nothing writes it: it states what the parameters
%  are, and a parameter is added by editing it here.
>> readonly put

.xpostsys /.checkpagehandlers {  % dict  .  dict
    [ /BeginPage /EndPage /Install ] {
        2 copy known {
            2 copy get
            dup xcheck
            1 index type dup /arraytype eq exch /packedarraytype eq or
            and not {
                //.setpageinfo exec
                /setpagedevice cvx /typecheck signalerror
            } if
            pop pop
        }{ pop } ifelse
    } forall
} put

%
%  A device feature the machinery reads as a number is refused as it is
%  offered where the value is not one. PLRM 6.2.7 has setpagedevice raise
%  typecheck as well as refusing a request it cannot satisfy, and this is
%  what that is for: a request is the one place the value has a caller to
%  answer to. Read at the point of use instead, a value that is not a
%  number would be a number the machinery could not find, and finding no
%  number is what it does for a device asking for nothing -- so a request
%  naming its feature and misspelling the value would come out as a
%  request that named nothing, silently and a page later.
%
%  TextAlphaBits, the bits of a glyph's edge coverage a device is sent
%  (data/image.ps, src/lib/xpost_op_font.c), is one such feature. It
%  is refused for its type and not for its size: a number below one asks
%  for no coverage at all and a number above eight for more than a
%  rasterised glyph carries, and each of those is a number the machinery
%  meets with what there is. The codec knobs the compiled writers read
%  as numbers off their device dictionary -- png_compression_level and
%  png_interlaced (src/lib/xpost_dev_png.c), jpeg_quality
%  (src/lib/xpost_dev_jpeg.c) -- are the others; png_filter is a word,
%  and a wrong one is refused by the driver with the roster.
%
.xpostsys /.checkpagefeatures {  % dict  .  dict
    [ /TextAlphaBits /png_compression_level /png_interlaced /jpeg_quality ] {
        2 copy known {
            2 copy get
            dup type /integertype ne {
                //.setpageinfo exec
                /setpagedevice cvx /typecheck signalerror
            } if
            pop
        } if
        pop
    } forall
} put

%
%  The page geometry a request may state, refused as it is offered where
%  it is not the shape PLRM 6.2 Table 6.1 gives it. PageSize is the width
%  and height of the page, HWResolution the device resolution across and
%  down it, and PageOffset the shift of the page image on the medium:
%  each of the three is two numbers. ImagingBBox is four -- the corners
%  of the region the program says it paints within -- or null, which
%  claims nothing and holds the whole page.
%
%  Read here rather than where the page is set up, for the reason the
%  handler and feature checks above are read here: the machinery indexes
%  what it is handed, and a value of the wrong shape indexes without
%  complaining. An array of three numbers gives up its first two and
%  throws the rest away, and a string gives up the bytes it holds as
%  numbers -- so a request naming a page of (abc), read that late, is a
%  page of 97 by 98 points reported back as the page the program asked
%  for. A bounding box of the wrong shape reads as no box at all, which
%  leaves a program that meant to say where its marks fall told nothing
%  about having failed to say it.
%
%  The entry refused is named in $error, as every entry a page-device
%  request is refused over is.
%
.xpostsys /.checkpagegeometry {  % dict  .  dict
    << /PageSize 2 /HWResolution 2 /PageOffset 2 /ImagingBBox 4 >> {
                                        % dict key count
        2 index 2 index known {
            2 index 2 index get         % dict key count value
            % ImagingBBox alone may be null: a program with nothing to
            % say about where its marks fall says so that way.
            dup null eq { 1 index 4 eq }{ false } ifelse
            { pop }{
                dup type dup /arraytype eq exch /packedarraytype eq or
                { dup length 2 index eq }{ false } ifelse
                { true 1 index
                  { type dup /integertype eq exch /realtype eq or and } forall }
                { false } ifelse
                not {                   % dict key count value
                    2 index exch        % dict key count key value
                    //.setpageinfo exec
                    /setpagedevice cvx /typecheck signalerror
                } if
                pop
            } ifelse
        } if
        pop pop
    } forall
} put

%
%  The recovery policies a page device carries before a program asks for
%  any (PLRM 6.2.7, Table 6.9). A parameter the dictionary does not name
%  is governed by PolicyNotFound, which ignores it: that is the usual
%  answer, and it is what lets a page description written for a press
%  print here at all rather than stopping at the first tray it names.
%
%  An output device this interpreter cannot make and a page size it
%  cannot honour are errors instead, because there is no ignoring either
%  -- a page has to be made on something, of some size, and a program
%  cannot see which was chosen for it.
%
%  A fresh dictionary each time it is asked for. The Policies a page
%  device carries is merged into by every request and reverted by a
%  restore, so no two devices may hold the same one.
%
.xpostsys /.defaultpolicies {  % -  .  dict
    << /PolicyNotFound 1 /PageSize 0 /OutputDevice 0 /PolicyReport { pop } >>
} put

%
%  The page-device parameters PLRM 6.2 defines that this interpreter
%  provides no behaviour for. PLRM 6.1.1 has setpagedevice not recognise
%  a request naming a feature the device has not -- whatever value it
%  asks for, a request to turn one off included -- and consult the
%  recovery policies instead. So each name here is an unsatisfied
%  request, and the Policies dictionary says what becomes of it.
%
%  A roster rather than something deduced, because there is nothing here
%  to deduce it from: every key of a request the page machinery does not
%  read itself is handed to the device as a feature, which is how a
%  driver's own knobs are reached, so a key going unread by the machinery
%  is not evidence that nothing wanted it. These are the names of PLRM
%  Table 6.1, less the ones this interpreter acts on -- PageSize,
%  HWResolution, ImagingBBox, PageOffset, OutputDevice,
%  ProcessColorModel, Install, BeginPage, EndPage, and Policies itself.
%
%  A key PLRM does not define is not on it and never becomes an
%  unsatisfied request: this interpreter's page device takes any key, so
%  a name outside the specification is a device feature and reaches the
%  device as one.
%
.xpostsys /.pagedeviceabsent <<
    % media selection
    /DeferredMediaSelection null  /InputAttributes null
    /InsertSheet null             /LeadingEdge null
    /ManualFeed null              /MediaClass null
    /MediaColor null              /MediaPosition null
    /MediaType null               /MediaWeight null
    /TraySwitch null
    % roll-fed media
    /AdvanceDistance null         /AdvanceMedia null
    /CutMedia null                /Orientation null
    /RollFedMedia null
    % page image placement
    /Duplex null                  /ImageShift null
    /Margins null                 /MirrorPrint null
    /NegativePrint null           /Tumble null
    % page delivery
    /Collate null                 /Jog null
    /NumCopies null               /OutputAttributes null
    /OutputFaceUp null            /OutputType null
    % colour support
    /MaxSeparations null          /PageDeviceName null
    /SeparationColorNames null    /SeparationOrder null
    /Separations null             /Trapping null
    /TrappingDetails null         /UseCIEColor null

%  Read-only, as the list of parameters beside it is. This one decides
%  which requests cannot be satisfied and so go to a policy, and a list
%  a program could empty is one that would let those requests through
%  unanswered. Nothing writes it: it states what this interpreter has no
%  behaviour for, and a name is added by editing it here.
>> readonly put

%
%  What a Policies dictionary offered to setpagedevice may say, refused
%  where it says anything else. Read as the request is offered, before
%  any of it is acted on, for the reason the feature check above is: a
%  policy is consulted only when something else could not be met, so a
%  misspelled code left to be read then would be a code found missing at
%  the one moment the program most needs the answer.
%
%  Each entry but PolicyReport is one of the codes PLRM Table 6.9
%  defines: 0 to raise a configurationerror, 1 to ignore the parameter,
%  2 to ask a human operator. PageSize takes the wider set, 0 to 7, which
%  names the compromises available where media are chosen from a tray.
%  PolicyReport is a procedure, and one that cannot be run is refused
%  here rather than at the end of the request that needed it, which is
%  where the two page handlers are refused and for the same reason.
%
%  Each entry stays on the operand stack while it is read rather than
%  being given a name. A name holding a procedure runs it when the name
%  is read, and one of these entries is a procedure -- so a PolicyReport
%  named here would be run by the check meant to decide whether it can be
%  run at all.
%
.xpostsys /.checkpagepolicies {  % dict  .  dict
    dup /Policies 2 copy known {
        get 2 dict begin
        /pol exch def
        pol type /dicttype ne {
            /Policies pol end //.setpageinfo exec
            /setpagedevice cvx /typecheck signalerror
        } if
        pol {                                   % key value
            exch dup /PolicyReport eq {         % value key
                pop
                dup xcheck
                1 index type dup /arraytype eq exch /packedarraytype eq or
                and not {
                    /Policies pol end //.setpageinfo exec
                    /setpagedevice cvx /typecheck signalerror
                } if
                pop
            }{                                  % value key
                exch                            % key value
                dup type /integertype ne {
                    /Policies pol end //.setpageinfo exec
                    /setpagedevice cvx /typecheck signalerror
                } if
                dup 0 lt
                2 index /PageSize eq { 7 }{ 2 } ifelse
                2 index exch gt
                or {
                    /Policies pol end //.setpageinfo exec
                    /setpagedevice cvx /rangecheck signalerror
                } if
                pop pop
            } ifelse
        } forall
        end
    }{ pop pop } ifelse
} put

%
%  The code governing one page-device parameter: the one the Policies
%  dictionary carries for it, or the one PolicyNotFound carries for every
%  parameter it does not name (PLRM 6.2.7).
%
.xpostsys /.policyfor {  % policies key  .  int
    2 copy known { get }{ pop
        /PolicyNotFound 2 copy known { get }{ pop pop 1 } ifelse
    } ifelse
} put

%
%  Changes to a Policies dictionary are cumulative and merge one level
%  down (PLRM 6.1.1): the entries a request names join those already in
%  force rather than displacing the dictionary that holds them.
%
%  The answer is a fresh dictionary, neither of the two handed over. The
%  page device's own has to be revertible by a restore, which wants the
%  slot pointed at a dictionary a save saw; and a program that keeps a
%  reference to the dictionary it asked with must not be able to rewrite
%  the policies in force afterwards.
%
.xpostsys /.mergepolicies {  % policies request  .  policies
    4 dict begin
    /request exch def
    /base exch def
    /extra request /Policies 2 copy known { get }{ pop pop 0 dict } ifelse def
    /out base length extra length add dict def
    base { out 3 1 roll put } forall
    extra { out 3 1 roll put } forall
    out
    end
} put

%
%  Start a page: nothing painted yet, and the BeginPage handler the page
%  device carries run with the count of pages transmitted so far.
%
%  Reached from showpage and copypage once the outgoing page has been
%  dealt with, and from the device installation, so that the first page
%  of a run begins the same way as every later one.
%
.xpostsys /.beginpage {  % -  .  -
    % A page that has just begun carries nothing yet.
    false //.setpagemarked exec
    /BeginPage //.pagehandler exec
    dup null eq { pop }{
        //.pageno exec exch exec
    } ifelse
} put

%
%  Runs the EndPage handler over the page count and the reason, and answers
%  with what it returned. A device carrying no handler transmits a page ended
%  by showpage or copypage and does not transmit one ended by the device going
%  away, which is the standard behaviour. A handler that answers with anything
%  but one boolean has not answered at all.
%
.xpostsys /.endpage {  % outer reason  .  bool
    % The working dictionary is opened through the bracket that takes it
    % off again however the body ends, error included (.indict,
    % callout.ps): a caller that swallows a failing handler is left the
    % dictionary stack it was handed rather than one entry deeper for
    % every handover it swallows.
    %
    % `outer` is how many dictionaries of the CALLER'S OWN stand open over
    % the program's scope. This one knows only about the dictionary it
    % opens itself; a caller holding a working dictionary of its own --
    % setpagedevice, handing a page over as it replaces the device --
    % would otherwise run the program's handler inside it: one entry too
    % deep, with the operator's own names in front of the program's, and
    % every definition the handler makes landing somewhere the program
    % never sees again.
    3 dict
    {
        /reason exch def
        /outer exch def
        /EndPage //.pagehandler exec
        dup null eq {
            % No handler: transmit a page ended by showpage or copypage,
            % and do not transmit one ended by the device going away.
            pop reason 2 ne true
        }{
            /h exch def

            % The handler owes exactly one answer, and only a boolean is
            % one. How many it left is read from how deep the stack stood
            % before it ran, so the verdict does not depend on what the
            % caller happened to have below, and a handler that empties
            % the stack is caught too.
            count /base exch def

            % The handler is the program's, so it goes through the callout
            % bracket (.callout, callout.ps), which names this dictionary
            % as the one to take off while it runs: a definition it makes
            % is the program's to keep and lands in the dictionary the
            % program has current, and the names kept here are neither in
            % its way nor there for it to read.
            %
            % The bracket holds nothing on the operand stack while the
            % handler runs, so the handler is free to leave that stack any
            % way it likes, empty included; it puts this dictionary back
            % however the handler returned, and the bracket around the
            % body closes it where the handler raised.
            %
            % The handler is loaded rather than named: a name whose value
            % is a procedure runs it where it stands, and this one is an
            % operand of the bracket.
            //.pageno exec reason
            /h load null outer 1 add //.callout exec

            count base 1 add eq
            dup { pop dup type /booleantype eq } if
        } ifelse
    } //.indict exec

    % The dictionary is off before anything is refused, so a handler that
    % answers wrongly does not leave the dictionary stack deeper as well.
    { }{ /EndPage cvx /typecheck signalerror } ifelse
} put

%
%  End the page and transmit it (PLRM 8.2), then begin the next.
%
%  The EndPage handler decides whether the page is transmitted at all;
%  where it says no, the marks are still given up and the count still
%  advances, because the page has ended either way.
%
/showpage [ ] {  % -  .  -
    0 0 //.endpage exec {
        DEVICE //.transmitpage exec
        true //.setpagesent exec
        //.showpagesemanticsdict /ShowpageSemantics //.hostvalue exec get exec
    } if

    % a page ended by showpage is counted whether or not it was transmitted
    //.pageno exec 1 add //.setpageno exec
    //.beginpage exec
} //.defop exec

%
%  Transmit the page and keep it (PLRM 8.2): the marks stay, so what
%  follows paints over what is already there.
%
%  Its EndPage handler is told a different reason from showpage's, which
%  is the whole of the difference a page device sees between them.
%
/copypage [ ] {  % -  .  -
    0 1 //.endpage exec {
        DEVICE //.transmitpage exec
        true //.setpagesent exec
        flushpage
        //.copypagesemanticsdict /ShowpageSemantics //.hostvalue exec get exec
    } if

    % copypage ends a page without counting it (PLRM 6.2.6).
    //.beginpage exec
} //.defop exec

%
%  The page a job leaves behind when it ends without asking for one.
%
%  A program that painted and never transmitted has a page nobody has seen,
%  and the job is over: the alternative to ending the page here is discarding
%  what it drew. Files written to be included in another document carry no
%  showpage at all -- the including document supplies it -- so this is the
%  ordinary way such a file arrives, not a corner.
%
%  It is ended as a page ends normally rather than as a device going away, so
%  a page device's EndPage handler is asked about it on the same terms as any
%  other page and may still refuse it.
%
%  A program that did transmit a page has said for itself where its pages end.
%  What it painted after the last one is a page it chose not to finish, and
%  that is left unfinished.
%
.xpostsys /.endjobpage {  % -  .  -
    //.pagesent exec not
    //.pagemarked exec and {
        0 0 //.endpage exec {
            DEVICE //.transmitpage exec
            true //.setpagesent exec
        } if
    } if
} put

end end end

//.internaldict /QUIET known { }{ (eof device.ps\n)print } ifelse
