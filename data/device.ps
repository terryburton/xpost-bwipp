%!PS
%
% device.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Device-level operators independent of the device implementation, and showpage semantics.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  This file implements "device-level" operators
%  which are independent of the actual device implementation.
%  It also implements the Showpage Semantics behavior
%  specified in the call to xpost_create().
%
//.internaldict /QUIET known { }{ (loading device.ps...\n)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .xpostsys begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The one number formatter for the vector writers (the PDF, SVG and DSC
%  devices format every coordinate and dimension through it): an integral
%  value prints as an integer; anything else prints with exactly two
%  decimals, never exponential -- round(n*100) sidesteps binary-float
%  print noise.
%
.xpostsys /.num2str {  % num  .  str
    dup truncate 1 index eq {
        cvi 20 string cvs
    }{
        100 mul round cvi
        dup 0 lt { (-) exch neg }{ () exch } ifelse
        dup 100 idiv 20 string cvs
        3 -1 roll exch //.strcat exec
        exch 100 mod
        dup 10 lt { (.0) }{ (.) } ifelse exch
        20 string cvs //.strcat exec
        //.strcat exec
    } ifelse
} put

%
%  The device-resolution scale carried in the defaultmatrix fixup applied
%  after construction; a raw 1:1 device answers 1 1. Dividing a device
%  dimension by its scale yields the page size in points, which is how
%  the vector writers and the bounding-box device report their pages
%  independently of HWResolution.
%
.xpostsys /.devres-to-points {  % devdict  .  sx sy
    /defaultmatrix 2 copy known {
        get dup 0 get exch 3 get neg
    }{ pop pop 1 1 } ifelse
} bind put

%
%  The one class-to-instance copy, stored under /.copydict by every
%  device class and called by Create (and by the C drivers, which fetch
%  it from the class dictionary before specialising the copy).
%
%  An instance is a copy of its class with the state the instance
%  accumulates: the dimensions it adopted, the output file name in
%  force when it was made, and the device features of the page-device
%  request it is being made for. The file name matters to any class
%  whose Emit writes a file, and a class carrying a copy without it
%  produced a device that wrote wherever Emit defaulted to whatever the
%  program had asked for -- which is why this is one procedure rather
%  than a shape each class repeats.
%
%  The features arrive through /.devrequest in graphicsdict, stated
%  there by whichever route is making a device -- the page-device
%  request around the maker it runs (data/init.ps), the recording class
%  around the painter it builds (data/recorddev.ps) -- and TAKEN here,
%  not merely read, so the next device made does not inherit a request
%  that was not asked of it. They are written after the class's own
%  entries, so a request's key overrides the default the class carries;
%  a driver may therefore read a feature as its instance is created and
%  see what the request said. Two kinds of name are skipped: /Private,
%  the handle a device's own state is reached through, issued to the
%  instance holding that state; and any name the class holds a method
%  under -- the machinery reads the instance's methods as its block of
%  state is issued (xpost_handle_cons, src/lib/xpost_handle.c), and the
%  release recorded there is the class's to name, never the request's.
%  What the request asked under a method's name still reaches the
%  finished device, written there after it is built exactly as every
%  feature always was.
%
%  The dimensions are written with the copy current, and it is opened
%  through the bracket that takes it off again however the body ends,
%  error included (.indict, graphics.ps): a copy left current is a
%  dictionary the caller's error handler, and everything after it, would
%  go on defining into.
%
.xpostsys /.classcopydict {  % dict1  .  dict2
    dup length dict copy
    dup /width known {
        dup { /dimensions [width height] def } //.indict exec
    } if

    % The file name this run was started with. A request's own binding
    % is a device feature and arrives through the merge below, writing
    % over this; there is no third source, the output path being a
    % page-device parameter and not a name a program defines.
    /OutputFileName //.hostvalue exec
    dup null eq { pop }{ 1 index exch /OutputFileName exch put } ifelse

    % The request's features, taken, kept on the instance under
    % /.devrequest -- the recording class reads them back there for the
    % painter it builds -- and written over the class's entries.
    graphicsdict /.devrequest 2 copy known {
        get                                 % Copy req
        graphicsdict /.devrequest undef
        dup 2 index exch /.devrequest exch put
        {  % copy key value
            1 index /Private eq

            % A name the class holds something executable under is a
            % method, and a method is not the request's to write here.
            3 index 3 index 2 copy known
                { get xcheck }{ pop pop false } ifelse
            or
                { pop pop }
                { 2 index 3 1 roll put }
            ifelse
        } forall                            % Copy
    }{ pop pop } ifelse
} put

%
%  Refuse a device whose band budget will not buy one row of its page.
%
%  How deep a band is is the budget divided by what one row of the raster
%  costs, and that division answers one row for everything at or below a
%  row: a budget of a single byte and a budget of a whole row cut the same
%  bands. So a budget under a row is a budget the run did not get, and a
%  run told nothing would have every reason to think it had -- which is a
%  control that appears to select something and does not.
%
%  Asked of every device as it is finished, which is the one point every
%  device made passes through, and answered only for a device carrying a
%  budget: a device holding its page whole has no band for a budget to
%  cut, and puts out the same page at any budget at all.
%
%  The budget and the least it may be are both named, on the standard
%  error, because an error names an operator and a condition and carries
%  no numbers of its own. The page goes to the standard output whenever
%  the run was given no file to write it to, which is why the complaint
%  does not go there.
%
.xpostsys /.bandfits {  % dict  .  -
4 dict {
    /bf.dev exch def
    /bf.budget bf.dev /.bandbytes 2 copy known
        { get }{ pop pop null } ifelse def
    /bf.row bf.budget type /integertype eq
        { bf.dev //.xpostsys /.rowbytes get exec }{ null } ifelse def

    % A class that prices no row in bytes is a class no band arithmetic
    % can be done for, and nothing here can say whether its budget is
    % short.
    bf.row type /integertype eq
        { bf.row 0 gt { bf.budget bf.row lt }{ false } ifelse }
        { false } ifelse
    {
        4 dict begin
            /out (%stderr) (w) file def
            /n 24 string def
            out (xpost: a band budget of ) writestring
            out bf.budget n cvs writestring
            out ( bytes will not buy one row of this page, which costs )
                writestring
            out bf.row n cvs writestring
            out ( bytes\n) writestring
            out flushfile
        end
        /.completedevice cvx /rangecheck signalerror
    } if
} //.indict exec } bind put

%
%  Finish a freshly created device, on every path that creates one: the
%  device the interpreter starts with and the device setpagedevice makes
%  take the same finishing, so the same device behaves the same however
%  it was selected. sx and sy are the device resolution's scale from
%  points; a raw 1:1 device passes 1 1.
%
%  Written once because it was written twice, and the two were not the
%  same: only one adopted the requested process colour model, so the
%  next key added to one would be missed by the other.
%
%  Local, in privatedict: it freezes a reference to .internaldict to
%  reach the compiled rasterisers, and a global object may not hold a
%  local one.
%
.privatedict /.completedevice {  % devdict sx sy  .  -
    % Whether the budget this device's bands were cut to bought any of
    % them, asked before anything is written on the device and before
    % the scratch dictionary below is opened, so that a refusal leaves
    % nothing to be taken back.
    2 index //.bandfits exec

    % The scratch dictionary and the matrix built below hold the device,
    % which is a local object, so they are made in local VM whatever the
    % caller was allocating in.
    currentglobal false setglobal
    4 dict begin
    /og exch def /sy exch def /sx exch def /dev exch def

    % The page's default matrix: device space runs y-down from the top
    % of the page, scaled by the device resolution, and by the ratio a
    % window device adopted when it opened smaller than the page asked
    % for. The flip translate must match the height the device actually
    % adopted, or marks sit offset within the page.
    dev /windowscale 2 copy known { get }{ pop pop 1 } ifelse
    /ws exch def
    dev /defaultmatrix
        [ ws sx mul 0 0 ws sy mul neg 0 dev /height get ] put

    % A device declaring support for the requested process colour model
    % adopts it as its native space; the colour pipeline then delivers
    % that model's components to the marking methods. Before the fills
    % are chosen below, because which compiled fill fits depends on it.
    % A paint carries one value per component of the space it is made
    % in, so the count moves with the space: a device left saying how
    % many it took in the space it has stopped taking them in would hand
    % its marking methods one value in the place of another. Moved only
    % where the device states a count and the space it has adopted has
    % one -- a device offering the model that is whatever space a paint
    % was made in carries no fixed count to move.
    dev /ProcessColorModel 2 copy known {
        get dev /.colormodels 2 copy known {
            get 1 index known {
                dup dev /nativecolorspace 3 -1 roll put
                dev /.ncomp known {
                    //.xpostsys /.spacecomps get 1 index known {
                        //.xpostsys /.spacecomps get 1 index get
                        dev /.ncomp 3 -1 roll put
                    } if
                } if
                pop
            }{ pop } ifelse
        }{ pop pop pop } ifelse
    }{ pop pop } ifelse

    % Override the class's scanline methods with the compiled
    % rasterizers, except where the device declares it draws nothing:
    % rasterizing into the null device would burn the whole render cost
    % of a page to discard every span.
    %
    % Fetch nativecolorspace with get, and hold it literal: some devices
    % store it as an executable name, which naming it again would
    % execute.
    dev /NoOutput known not {
        /cs dev /nativecolorspace get cvlit def

        % The compiled scanline fill paints in the device's native
        % colour space, and it paints in two of them; a device declaring
        % any other keeps the class's own polygon fill, which takes its
        % component count from the device.
        cs /DeviceGray eq cs /DeviceRGB eq or {
            dev /FillPoly //.internaldict /.fillpoly get put
        } if

        % The compiled rectangle fills write the page as the array of
        % row strings the base classes keep it in under /ImgData
        % (.xpost_PGMIMAGE, PPMIMAGE), so they fit a device whose raster
        % is that array and no other: a device that keeps its raster in
        % a C buffer (bgr, the png family) carries no such array, and a
        % fill reaching for one answers undefined at the first
        % rectangle. A device that brought a compiled rectangle fill of
        % its own keeps that as well -- what it brought reaches the
        % raster it holds. Both conditions are the compiled fill's
        % rather than one colour space's, so they are asked once and the
        % colour space chooses only which fill is installed; erasepage
        % clears the page through whichever the device ends up with.
        dev /ImgData known {
            dev /FillRect 2 copy known
                { get type /operatortype ne }{ pop pop true } ifelse
        }{ false } ifelse {
            cs /DeviceGray eq {
                dev /FillRect //.internaldict /.fillrectgray get put
            } if
            cs /DeviceRGB eq {
                dev /FillRect //.internaldict /.fillrectrgb get put
            } if
        } if
    } if
    og
    end
    setglobal
} bind put

%
%  The run of a page's rows an imaging bounding box reaches.
%
%  PLRM 6.2 gives ImagingBBox as four numbers in the default user
%  coordinate system -- left, bottom, right and top -- and calls it the
%  program's assertion that it paints no marks outside them. Only the
%  vertical pair is read here: a device holding its page as rows can drop
%  whole rows and cannot hold half of one, so what the box buys is the
%  rows above its top edge and below its bottom edge and nothing else.
%
%  h is the page's height and off the vertical page offset, both in the
%  default user space the box is stated in; sy is the rows a unit of it
%  covers, and ph the rows of the whole page. Default user space runs up
%  from the foot of the page and the rows run down from its head, so the
%  top edge gives the first row and the bottom edge the last.
%
%  The answer is null wherever the box says nothing that saves a row --
%  not four numbers, or covering the page already -- and a caller given
%  null holds the whole page. A box that reaches no row of the page at
%  all still leaves a page to paint on, so one row is held rather than
%  none.
%
.xpostsys /.imagingrows {  % bbox h off sy ph  .  [top rows] | null
    12 dict begin
    {/ph /sy /off /h /bbox}{exch def}forall
    bbox type dup /arraytype eq exch /packedarraytype eq or
    { bbox length 4 eq }{ false } ifelse
    { true bbox { type dup /integertype eq exch /realtype eq or and } forall }
    { false } ifelse
    {
        /y0 bbox 1 get off add def
        /y1 bbox 3 get off add def
        y0 y1 gt { /t y0 def /y0 y1 def /y1 t def } if
        /top h y1 sub sy mul floor cvi def
        /bot h y0 sub sy mul ceiling cvi def
        top 0 lt { /top 0 def } if
        bot ph 1 sub gt { /bot ph 1 sub def } if
        bot top lt { /top 0 def /bot 0 def } if
        top 0 le bot ph 1 sub ge and
            { null }
            { [ top bot top sub 1 add ] }
        ifelse
    }{ null } ifelse
    end
} put

%
%  Substitute the page number for a %d marker in an output file name,
%  counting the pages transmitted; without the marker every page writes
%  the same file, last page standing
%  the page counter lives in a global dict so it survives the save/restore
%  a program wraps around each page (the separation-plate idiom); a counter
%  kept in the local device dictionary is rewound by restore, and every page
%  then reuses the same %d number.
%
.xpostsys /.pagestate 1 dict put

%
%  The output file name for the page about to be written: the %d marker
%  in the name given, replaced by the number of pages transmitted so
%  far. A name without the marker comes back unchanged, and every page
%  then writes the same file with the last one standing.
%
%  The counter lives in a global dictionary so that the save and restore
%  a program wraps around each page -- the separation-plate idiom --
%  does not rewind it. Kept in the local device dictionary it would be
%  rewound, and every page would reuse the same number.
%
.xpostsys /.pagefilename {  % name  .  name'
    dup (%d) search {
        exch pop
        //.pagestate /.pageno 2 copy known { get }{ pop pop 1 } ifelse
        dup 1 add //.pagestate exch /.pageno exch put
        10 string cvs
        //.strcat exec exch //.strcat exec
        exch pop
    }{
        pop
    } ifelse
} put

%
%  Transmit one page through a device: settle the name this page's output
%  goes to, then run the device's Emit.
%
%  The name is settled here, once, for every device there is. The template
%  is /OutputFileName -- the device's own, put there when it was made from
%  the run's binding or the request's /OutputFile -- and a %d in it is
%  replaced with the page number, from the one counter .pagefilename keeps,
%  so every device numbers its pages alike. A device with no name at all
%  writes to the standard output, which is where a page goes when nobody
%  said where. What comes out is stored on the device as /.outputfile,
%  and that -- not the template -- is what an Emit opens.
%
%  Settling the name belongs to the page and not to the device: a device
%  that settled it when it was made wrote every page of a job to the name
%  page one had, and a device written afterwards would have had to
%  remember not to. Every path that transmits a page comes through here,
%  so there is no way to write a page without one.
%
.xpostsys /.transmitpage {  % dict  .  -
    dup /OutputFileName 2 copy known
        { get }
        { pop pop /OutputFileName //.hostvalue exec
          dup null eq { pop (%stdout) } if }
    ifelse
    //.pagefilename exec
    1 index exch /.outputfile exch put

    % What became of this page, for a run that asked to be told
    //.internaldict /QUIET known
        { }{ dup //.xpostsys /.reportpage get exec } ifelse
    dup /Emit get exec
} put

(/image.ps) //.loadmodule exec  % Image.ps implements device base classes
(/nulldev.ps) //.loadmodule exec  % Nulldevice
(/bboxdev.ps) //.loadmodule exec  % Bounding-box device
(/recorddev.ps) //.loadmodule exec  % Recording device
(/pdfwrite.ps) //.loadmodule exec  % Pdf device
(/svgwrite.ps) //.loadmodule exec  % Svg device
(/dscwrite.ps) //.loadmodule exec  % Distilled-ps device

%
%  Mirror the device class dictionaries into privatedict, where the makers and
%  the C drivers reach them. They stay where they were defined too, for the
%  load-time methods still to come, until .finalize replaces them with local
%  copies in privatedict and drops those anchors. The device files define into
%  the dictionary current here, which is the one the language is being read
%  into.
%  Which dictionaries those are is read off the one they were defined in
%  rather than named here. A class states itself by the name it is
%  defined under; a list beside it is a second statement, and a class
%  added later reaches the first without reaching the second -- it is
%  then never mirrored, and the maker that reaches for it answers
%  undefined at the first page of the only run that selects it.
%
[ currentdict { pop } forall ]
{ dup //.isclassname exec
    { dup currentdict exch get .privatedict 3 1 roll put }
    { pop } ifelse
} forall

%
%  Bring the budget this run works to and the class that works to it into
%  line, and leave the number where both sides of the interpreter read it.
%
%  How deep a band is is that budget divided by what one row of the raster
%  costs, and the same number is what a page is weighed against to decide
%  whether it is held as its marks at all: a page the budget covers
%  arrives in one band, which is the page. So the budget is the one
%  control over both, and lowering it is what holds a smaller page in
%  bands.
%
%  The class carries the budget a run that names none works to, and states
%  what that number rests on (data/recorddev.ps). Where the invocation
%  named one it goes on the class, in place of that; where it named none
%  the class's own goes into the settings. Either way one number stands in
%  both places afterwards, which matters because the two halves of the
%  interpreter reach it by different routes: the band arithmetic takes it
%  off the class or off a device copied from it, and the driver holding a
%  record takes it out of the settings, where what a run decided lives.
%
%  The driver takes it from there and not off the device it is holding,
%  because the two are not the same question. What a device carries is the
%  grid its own page is cut into, and something making a device may cut it
%  as fine as it likes; what bounds the marks is what this run said it
%  would spend on a page, which no page may raise or lower for itself. A
%  record weighed against the grid of a one-row band would put a page's
%  marks in a file at the first of them.
%
%  Done as the run's device is made, and not as this file is read. The
%  language a run is given may have been read whole out of an image of the
%  virtual memory another run built it in, and that other run's
%  invocation is not this one's: a budget written where the class is
%  defined would be written once, into the image, and every run after
%  would band to whatever the run that wrote the file was given. What is
%  settled afresh on every launch lives in the settings this reads from
%  (data/init.ps), and this is the point at which the two are brought into
%  line -- before the first device, which is before the first page is
%  weighed.
%
.xpostsys /.settlebandbudget {  % -  .  -
    .privatedict /.xpost_RECORD known {
        currentglobal true setglobal
        /MaxBandBytes //.hostvalue exec
        dup type /integertype eq
            { .privatedict /.xpost_RECORD get exch /.bandbytes exch put }
            { pop //.hostdict /MaxBandBytes
              .privatedict /.xpost_RECORD get /.bandbytes get put }
        ifelse
        setglobal
    } if
} put

%
%  What one band of a page may cost this run, in bytes of the raster a
%  device holds at once. This is the value currentsystemparams reports as
%  MaxBandBytes.
%
%  Read off the recording class, which is where the budget is settled
%  above and where every reading of it is taken, so a program is told the
%  number the band loop divided rather than a second copy of it.
%
%  A run whose graphics never loaded carries no such class and holds no
%  page in bands, and answers nought -- the same nothing .curbandheight
%  answers for the band it would have reported.
%
.xpostsys /.bandbudget {  % -  .  bytes
    .privatedict /.xpost_RECORD 2 copy known
        { get /.bandbytes 2 copy known { get }{ pop pop 0 } ifelse }
        { pop pop 0 } ifelse
} put

%
%  The rows the device now being painted into holds of its page at once,
%  and zero where it holds the page whole. This is the value
%  currentsystemparams reports as CurBandHeight.
%
%  The rows come from .bandheight (data/recorddev.ps), which is where the
%  band loop takes them. Zero is this reading and not that one: a page
%  held whole is one band covering it, which is a band height only in the
%  sense that there are no bands, and a program asking how its marks were
%  held is asking exactly that.
%
%  A run whose graphics never loaded has no device to ask and no band
%  loop to report on, and answers zero.
%
.xpostsys /.curbandheight {  % -  .  rows
3 dict begin
    /rows 0 def
    /graphicsdict where {
        pop graphicsdict /currgstate get /device get
        dup type /dicttype eq {
            /dev exch def
            dev /height known {
                dev //.bandheight exec
                dup dev /height get lt { /rows exch def }{ pop } ifelse
            } if
        }{ pop } ifelse
    } if
    rows
end } bind put

%
%  Where this run wants a retained page's marks held, and where the marks
%  of the page now being painted actually are. These are the values
%  currentsystemparams reports as RecordSpill and CurRecordSpill.
%
%  Two readings rather than one, because they can differ and the
%  difference is what a reader most needs: a run that asked for its marks
%  to be weighed, on a machine that will take no scratch file, holds them
%  in memory and is told so at start-up, and a program given only the
%  state asked for could not tell that from a page that never needed to
%  spill.
%
%  /never, /auto or /always for the first. /memory, /file or /refused for
%  the second: in memory, in a file, or in memory having been refused a
%  file it wanted.
%
%  The device now being painted into answers, since it is the one holding
%  the marks. A device that holds no record -- a page under the band
%  budget, painted directly -- holds its marks nowhere and answers
%  /memory, which is where the pixels of such a page are. A run whose
%  graphics never loaded has no device to ask and answers the same.
%
.xpostsys /.currecordspill {  % -  .  /asked /held
2 dict begin

    % What the run asked for, read from the run: it is the run's answer
    % whatever device happens to be in hand, and a page painted directly
    % carries no record to ask.
    /asked /RecordSpill //.hostvalue exec def
    asked type /nametype ne { /asked /auto def } if

    % Not /where: bind bakes the operator of that name into this body,
    % and a local of the same name would never be the one read back.
    /held /memory def
    /graphicsdict where {
        pop graphicsdict /currgstate get /device get
        dup type /dicttype eq {
            % a device holding a record is the one to ask; one painting
            % its own page holds its marks nowhere and answers /memory,
            % which is where the pixels of such a page are.
            dup /.playclass known {
                dup //.internaldict /.recordspill get exec
                /held exch def pop
            } if
        } if
        pop
    } if
    asked held
end } bind put

%
%  Name what is about to become of one page: the device the page was
%  asked of, the device that paints it, whether it is held whole or a
%  band at a time, how deep a band is, and how large the page is. The
%  last two are the comparison the choice is made by, so a reader is told
%  what was decided and what decided it rather than only the verdict.
%
%  One line per page, on the standard error. The page itself goes to the
%  standard output whenever the run was given no file to write it to, so
%  a report sharing that stream would arrive inside the page and be read
%  as part of it.
%
%  The device asked of is the one the page description last named, and
%  the one the run was started with where it named none; the device that
%  paints is the target a record plays into, and otherwise the device
%  asked of, which paints its own page.
%
.xpostsys /.reportpage {  % dict  .  -
8 dict begin
    /dev exch def
    /out (%stderr) (w) file def
    /n 20 string def
    /asked
        graphicsdict /.pagedevice 2 copy known {
            get /OutputDevice 2 copy known
                { get }{ pop pop null } ifelse
        }{ pop pop null } ifelse
        dup null eq {
            pop /graphicsdict where {
                pop graphicsdict /.outputdevice 2 copy known
                    { get }{ pop pop null } ifelse
            }{ null } ifelse
        } if def
    /paints dev /.playclass known { dev /.playclass get }{ asked } ifelse def
    /pw dev /width known { dev /width get }{ 0 } ifelse def
    /ph dev /height known { dev /height get }{ 0 } ifelse def
    /rows dev //.bandheight exec def
    out (xpost: page ) writestring
    out //.xpostsys /.pageno get exec 1 add n cvs writestring
    out ( to ) writestring
    out asked null eq { (an unnamed device) }{ asked n cvs } ifelse writestring
    out (, painted by ) writestring
    out paints null eq { (itself) }{ paints n cvs } ifelse writestring
    out rows ph lt { (, in bands: ) }{ (, whole: ) } ifelse writestring
    out rows n cvs writestring
    out ( rows held at once of a ) writestring
    out pw n cvs writestring
    out (x) writestring
    out ph n cvs writestring
    out ( page\n) writestring
    out flushfile
end } bind put

%
%  Make the device this run was started with and install it in the
%  graphics state.
%
%  Apart from the loading above, and after it, because the two are not
%  the same kind of thing. The modules read above are the language, which
%  is the same for every run of this build. A device is not: it is the
%  one this run asked for, at the page this run asked for, and the next
%  run would want a different one. So the loading leaves the graphics
%  state carrying no device and this is what puts one there, which is
%  also what leaves a point between them at which the language stands
%  complete and nothing of the run has been decided yet.
%
%  Which device and which page are read from the settings a run has, the
%  one place a value the invocation decided is kept.
%
%  Once in the life of a context. The graphics state is the record of
%  that: a device already installed -- by this step or by a page-device
%  request afterwards -- is the one serving the run, and building a
%  second would leave the first holding state that is not virtual memory,
%  past the reach of both the collector and a restore.
%
%  A refusal here is carried out to the start-up report in data/init.ps,
%  which names the device and the page this run asked for.
%
%  Global, with the namespace it goes into: the body holds no local
%  object, reaching the local ones through the operators that answer with
%  them.
%
.xpostsys /.startdevice {  % -  .  -
    % The budget this run's pages are cut into bands by, brought into
    % line with what this run was started with before anything is weighed
    % against it (.settlebandbudget above).
    //.settlebandbudget exec
    graphicsdict /currgstate get /device 2 copy known
        { get null ne }{ pop pop false } ifelse
    { }{
        % The device is a local object: a page device's parameters are
        % written into it as the job runs, and a restore has to take
        % them back.
        currentglobal false setglobal

        % The device this run asked for, which is the name a page-device
        % request naming none goes on being made from, and the name a
        % refusal is reported under. The route a page takes is not part
        % of it: a selection whose page may arrive a band at a time is
        % handed to the recording class before it gets here, and taking
        % that back is what the weighing below does.
        /StartDeviceAsked //.hostvalue exec

        % A device the build left the driver out of registers no maker,
        % so the roster the page-device request is held to is the roster
        % here as well.
        //.xpostsys /.devicemakers get 1 index known not
            { /.startdevice cvx /undefined signalerror } if

        % Which device that selection is made through at the page this
        % run opens at. A page too large for the band budget to cover is
        % made through the recording class, which holds it in less memory
        % than the page; a page the budget already covers is made on the
        % device the run asked for, recording nothing (.devicefor,
        % data/recorddev.ps). Every page-device request afterwards is
        % weighed the same way at the page it asks for, so what is named
        % below is the selection and not the route this page took.
        dup /StartPageSize //.hostvalue exec aload pop
        //.devicefor exec
        /StartPageSize //.hostvalue exec aload pop
        3 -1 roll //.xpostsys /.devicemakers get exch get exec

        % The interpreter's own device takes the same finishing
        % setpagedevice gives the ones it makes; the start-up page is at
        % the device's own resolution, so the point-to-device scale is
        % 1:1.
        dup 1 1 .privatedict /.completedevice get exec

        % The template and the live state carry the device; painting and
        % the defaultmatrix operator resolve it through them.
        .privatedict /.gstatetemplate get exec /device 2 index put
        graphicsdict /currgstate get /device 2 index put
        pop
        graphicsdict /.outputdevice 3 -1 roll put
        setglobal
        //.internaldict /QUIET known { }{
            (device made, initialising graphics state\n)print } ifelse

        % The state a newly installed device starts from, which is the
        % state any other device would start from, so it is built the
        % same way.
        //.xpostsys /.initdevicegstate get exec

        % The first page starts clear. Every later one is cleared by
        % showpage; the reset clears none of them, since it resets the
        % graphics state and not raster memory.
        erasepage
    } ifelse
} put

%
%  Put out what the device is holding without ending its page. A device
%  with nothing to flush has no Flush method and this does nothing.
%
/flushpage {  % -  .  -
    DEVICE /Flush known {
        DEVICE dup /Flush get exec
    } if
} bind def

%
%  The wait the announcing semantics take at a page boundary: name the
%  page on the standard output and read a line from the line editor.
%
%  Both halves are for a person, so both are done where the run has one
%  and neither where it has not. That is the question the run already
%  answers to decide whether to offer an interactive session at all --
%  a terminal on the standard input, and no output file naming something
%  that waits for one -- and it is read here rather than asked again.
%
%  Each half does harm without a person to receive it. The name is
%  addressed to a reader, and a run nobody is reading lands it in the
%  middle of what the program is writing on that same channel. The read
%  is somebody pressing return, and where there is nobody the standard
%  input is carrying something else and the read takes a line of it.
%
.xpostsys /.pagepause {  % (banner)  .  -
    /.interactive //.hostvalue exec
    {
        =print flush
        [ {(%lineedit)(r)file}stopped cleartomark
    }{
        pop
    } ifelse
} put

.xpostsys /ShowpageSemanticsDict <<

    % XPOST_SHOWPAGE_DEFAULT
    0 {
        (----showpage----) //.pagepause exec
        DEVICE /pagenumber
        2 copy known {
            2 copy get 1 add put
        }{
            1 put
        } ifelse
        erasepage
    }

    % XPOST_SHOWPAGE_NOPAUSE
    1 {
        % Don't do it.
        % do not pause right here.
    }

    % XPOST_SHOWPAGE_RETURN
    2 {
        returntocaller
    }
>> put

%
%  copypage transmits the page without erasing it (PLRM 8.2), so it ends
%  a page for the embedder's purposes but not for the program's: it takes
%  the same three behaviours, less the page number and the erasure.
%
.xpostsys /CopypageSemanticsDict <<
    0 { (----copypage----) //.pagepause exec }
    1 { }
    2 { returntocaller }
>> put

%
%  The page device's own handlers (PLRM 6.2.6). A page device may carry a
%  BeginPage procedure to run at the start of each page and an EndPage
%  procedure to run at the end. Each is handed the number of pages the device
%  has transmitted, EndPage is told why the page is ending, and the boolean it
%  returns says whether the page is transmitted at all.
%
%  The count lives beside the %d page number in the global record, so the
%  save and restore a job wraps around a page does not rewind it, and it
%  starts again at zero for each device activated.
%
%  .pageno reads it and .setpageno writes it.
%

.xpostsys /.pageno {  % -  .  int
    //.pagestate /.plrmpage 2 copy known { get }{ pop pop 0 } ifelse
} put

.xpostsys /.setpageno {  % int  .  -
    //.pagestate exch /.plrmpage exch put
} put

%
%  Two facts about the page, kept beside the count and for the same reason:
%  a job wraps a save and restore around its pages, and what has become of
%  them is not part of what a restore rewinds.
%
%  Whether anything has been painted since the page began, and whether any
%  page has been transmitted at all. Together they say whether a job that
%  ends without asking for its page has one to give: a program that painted
%  and never transmitted has a page nobody has seen, and the alternative to
%  ending it here is throwing it away. A program that did transmit has said
%  where its pages end, and what it painted afterwards is a page it did not
%  finish -- that one is dropped, as it is by the interpreters this follows.
%
%  .pagemarked and .setpagemarked carry the first, .pagesent and
%  .setpagesent the second.
%

.xpostsys /.pagemarked {  % -  .  bool
    //.pagestate /.marked 2 copy known { get }{ pop pop false } ifelse
} put

.xpostsys /.setpagemarked {  % bool  .  -
    //.pagestate exch /.marked exch put
} put

%
%  The same record, reached from where the interpreter's own side reads
%  the local machinery. A rendered glyph's pixels are written to the
%  device by the text machinery rather than by a painting operator, so
%  that machinery records what it left under /.marked itself, and it
%  needs the dictionary the two accessors above read and write. The
%  dictionary is the one object shared, not a copy: what one side writes
%  is what the other reads.
%
.privatedict /.pagestate //.pagestate put

.xpostsys /.pagesent {  % -  .  bool
    //.pagestate /.sent 2 copy known { get }{ pop pop false } ifelse
} put

.xpostsys /.setpagesent {  % bool  .  -
    //.pagestate exch /.sent exch put
} put

%
%  The handler the current page device carries under that name, or null where
%  it carries none.
%
.xpostsys /.pagehandler {  % name  .  proc|null
    graphicsdict /.pagedevice 2 copy known {
        get exch 2 copy known { get }{ pop pop null } ifelse
    }{ pop pop pop null } ifelse
} put

%
%  A handler that cannot be executed cannot be run at a page boundary, and
%  finding that out then would leave the page half made; the dictionary is
%  refused as it is offered instead.
%
.xpostsys /.checkpagehandlers {  % dict  .  dict
    [ /BeginPage /EndPage ] {
        2 copy known {
            2 copy get
            dup xcheck
            exch type dup /arraytype eq exch /packedarraytype eq or
            and not { /setpagedevice cvx /typecheck signalerror } if
            pop
        }{ pop } ifelse
    } forall
} put

%
%  A device feature the machinery reads as a number is refused as it is
%  offered where the value is not one. PLRM 6.2.7 has setpagedevice raise
%  typecheck as well as refusing a request it cannot satisfy, and this is
%  what that is for: a request is the one place the value has a caller to
%  answer to. Read at the point of use instead, a value that is not a
%  number would be a number the machinery could not find, and finding no
%  number is what it does for a device asking for nothing -- so a request
%  naming its feature and misspelling the value would come out as a
%  request that named nothing, silently and a page later.
%
%  TextAlphaBits, the bits of a glyph's edge coverage a device is sent
%  (data/image.ps, src/lib/xpost_op_font.c), is one such feature. It
%  is refused for its type and not for its size: a number below one asks
%  for no coverage at all and a number above eight for more than a
%  rasterised glyph carries, and each of those is a number the machinery
%  meets with what there is. The codec knobs the compiled writers read
%  as numbers off their device dictionary -- png_compression_level and
%  png_interlaced (src/lib/xpost_dev_png.c), jpeg_quality
%  (src/lib/xpost_dev_jpeg.c) -- are the others; png_filter is a word,
%  and a wrong one is refused by the driver with the roster.
%
.xpostsys /.checkpagefeatures {  % dict  .  dict
    [ /TextAlphaBits /png_compression_level /png_interlaced /jpeg_quality ] {
        2 copy known {
            2 copy get type /integertype ne
                { /setpagedevice cvx /typecheck signalerror } if
        } if
        pop
    } forall
} put

%
%  Start a page: nothing painted yet, and the BeginPage handler the page
%  device carries run with the count of pages transmitted so far.
%
%  Reached from showpage and copypage once the outgoing page has been
%  dealt with, and from the device installation, so that the first page
%  of a run begins the same way as every later one.
%
.xpostsys /.beginpage {  % -  .  -
    % A page that has just begun carries nothing yet.
    false //.setpagemarked exec
    /BeginPage //.pagehandler exec
    dup null eq { pop }{
        //.pageno exec exch exec
    } ifelse
} put

%
%  Runs the EndPage handler over the page count and the reason, and answers
%  with what it returned. A device carrying no handler transmits a page ended
%  by showpage or copypage and does not transmit one ended by the device going
%  away, which is the standard behaviour. A handler that answers with anything
%  but one boolean has not answered at all.
%
.xpostsys /.endpage {  % reason  .  bool
    3 dict begin
    /reason exch def
    /EndPage //.pagehandler exec
    dup null eq {
        % No handler: transmit a page ended by showpage or copypage, and
        % do not transmit one ended by the device going away.
        pop reason 2 ne true
    }{
        /h exch def

        % The handler owes exactly one answer, and only a boolean is one.
        % How many it left is read from how deep the stack stood before it
        % ran, so the verdict does not depend on what the caller happened to
        % have below, and a handler that empties the stack is caught too.
        count /base exch def
        //.pageno exec reason
        h exec
        count base 1 add eq
        dup { pop dup type /booleantype eq } if
    } ifelse

    % The dictionary comes off before anything is refused, so a handler that
    % answers wrongly does not leave the dictionary stack deeper as well.
    end
    { }{ /EndPage cvx /typecheck signalerror } ifelse
} put

%
%  End the page and transmit it (PLRM 8.2), then begin the next.
%
%  The EndPage handler decides whether the page is transmitted at all;
%  where it says no, the marks are still given up and the count still
%  advances, because the page has ended either way.
%
/showpage [ ] {  % -  .  -
    0 //.endpage exec {
        DEVICE //.transmitpage exec
        true //.setpagesent exec
        //ShowpageSemanticsDict /ShowpageSemantics //.hostvalue exec get exec
    } if

    % a page ended by showpage is counted whether or not it was transmitted
    //.pageno exec 1 add //.setpageno exec
    //.beginpage exec
} //.defop exec

%
%  Transmit the page and keep it (PLRM 8.2): the marks stay, so what
%  follows paints over what is already there.
%
%  Its EndPage handler is told a different reason from showpage's, which
%  is the whole of the difference a page device sees between them.
%
/copypage [ ] {  % -  .  -
    1 //.endpage exec {
        DEVICE //.transmitpage exec
        true //.setpagesent exec
        flushpage
        //CopypageSemanticsDict /ShowpageSemantics //.hostvalue exec get exec
    } if

    % copypage ends a page without counting it (PLRM 6.2.6).
    //.beginpage exec
} //.defop exec

%
%  The page a job leaves behind when it ends without asking for one.
%
%  A program that painted and never transmitted has a page nobody has seen,
%  and the job is over: the alternative to ending the page here is discarding
%  what it drew. Files written to be included in another document carry no
%  showpage at all -- the including document supplies it -- so this is the
%  ordinary way such a file arrives, not a corner.
%
%  It is ended as a page ends normally rather than as a device going away, so
%  a page device's EndPage handler is asked about it on the same terms as any
%  other page and may still refuse it.
%
%  A program that did transmit a page has said for itself where its pages end.
%  What it painted after the last one is a page it chose not to finish, and
%  that is left unfinished.
%
.xpostsys /.endjobpage {  % -  .  -
    //.pagesent exec not
    //.pagemarked exec and {
        0 //.endpage exec {
            DEVICE //.transmitpage exec
            true //.setpagesent exec
        } if
    } if
} put

end end

//.internaldict /QUIET known { }{ (eof device.ps\n)print } ifelse
