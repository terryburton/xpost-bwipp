%!PS
%
% color.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Colour spaces and colour selection, including the CIE-based spaces.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading color.ps...)print } ifelse

%
%  The names currenthsbcolor binds the components it reads back to.
%
.xpostsys /.rgbnames [ /b /g /r ] readonly put

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The names sethsbcolor binds its three components to.
%
.xpostsys /.hsbnames [ /b /s /h ] readonly put

%
%  --- CIE-based colour spaces ---------------------------------------
%
%  The four CIE-based families reduce a colour to X Y Z the way the
%  language describes: per-component clamps to the declared ranges,
%  the decode procedures, and the matrix stages. The X Y Z then becomes
%  device colour under the colour rendering dictionary the graphics state
%  holds, which is the conversion PLRM 7.1 puts there.
%

.xpostsys begin

%
%  Run one of a colour space's decode procedures. Each family reduces a
%  colour under a dictionary of its own, and the decode procedures are
%  the program's, so they go through the bracket: the names this
%  reduction works under are not theirs to inherit, and what they define
%  belongs where the program's other definitions go.
%
/.decode {  % v {proc}  .  v'
    null 1 //.pcallout exec
} def

%
%  A value brought inside the range a CIE space states for it. Every CIE
%  conversion below clamps its inputs through here, because a Decode or
%  a tint transform is the program's own procedure and may return
%  anything at all.
%
/.cieclamp {  % v l h  .  v'
    3 dict begin
    /h exch def /l exch def
    dup l lt { pop l } if
    dup h gt { pop h } if
    end
} def

%
%  A value within its range, over a table of n steps: the bracketing
%  indices and the fraction between them.
%
/.cietblpos {  % v lo hi n  .  i0 i1 f
    5 dict begin
    /n exch def /hi exch def /lo exch def
    lo hi //.cieclamp exec
    lo sub hi lo sub div n 1 sub mul
    dup 0 lt { pop 0 } if
    dup n 1 sub gt { pop n 1 sub } if
    /p exch def
    /i0 p floor cvi def
    i0
    i0 1 add dup n 1 sub gt { pop n 1 sub } if
    p i0 sub
    end
} def

%
%  One entry of a CIE table interpolated between its bounds: the
%  fraction of the way along, scaled into the range the table's axis
%  covers.
%
/.cietblval {  % byte-fraction lo hi  .  v
    1 index sub mul add
} def

%
%  CIE XYZ to the device's RGB, against a white point: the matrix every
%  CIE family below funnels into once it has reduced its own colour to
%  XYZ, followed by the gamma the sRGB primaries want.
%
%  One conversion rather than one per family, so the families differ
%  only in how they reach XYZ.
%
/.ciexyzrgb {  % X Y Z whitepoint  .  r g b
    5 dict begin
    /wp exch def /Z exch def /Y exch def /X exch def
    /X X 0.9505 wp 0 get div mul def
    /Y Y 1.0    wp 1 get div mul def
    /Z Z 1.089  wp 2 get div mul def
    X  3.2406 mul Y -1.5372 mul add Z -0.4986 mul add
    X -0.9689 mul Y  1.8758 mul add Z  0.0415 mul add
    X  0.0557 mul Y -0.2040 mul add Z  1.0570 mul add
    3 {
        3 -1 roll
        dup 0 lt { pop 0 } if
        dup 1 gt { pop 1 } if
        0.45 exp
    } repeat
    end
} def

%
%  --- the colour rendering dictionary --------------------------------
%
%  PLRM 7.1.2 makes a type 1 colour rendering dictionary the conversion
%  from the X Y Z a CIE-based colour reduces to into device colour, in
%  three stages: the white point adaptation of MatrixPQR and
%  TransformPQR, the render colour space of MatrixLMN, EncodeLMN,
%  MatrixABC and EncodeABC, and either a RenderTable lookup or the A B C
%  components taken as the device colour outright.
%
%  The render colour space here is DeviceRGB, or DeviceCMYK where a
%  RenderTable delivers four components. A device whose own space is
%  neither converts onward from it (PLRM 7.2), which is the same route a
%  device colour set anywhere else takes.
%
%  RangePQR is not read. The specification gives it as a statement to the
%  TransformPQR procedures about the values they will see rather than as
%  a clamp, and says outright that they must accept values outside it.
%

%
%  An entry of a colour rendering dictionary, or the default the
%  specification gives where the dictionary leaves it out.
%
/.crdget {  % dict key default  .  value
    3 1 roll 2 copy known { get exch pop }{ pop pop } ifelse
} def

%
%  Two diffuse points that state the same thing. What this decides is
%  whether the white point adaptation runs at all: PLRM 7.1.2 step 2
%  says that where the source and the device state the same white and
%  black points the step is the identity and MatrixPQR and TransformPQR
%  go unread.
%
/.crdsame {  % a b  .  bool
    3 dict begin
    /b exch def /a exch def
    a length 3 eq b length 3 eq and {
        a 0 get b 0 get eq
        a 1 get b 1 get eq and
        a 2 get b 2 get eq and
    }{ false } ifelse
    end
} def

%
%  A three-element vector through a three-by-three matrix laid out as the
%  specification lays one out: the first output reads the first, fourth
%  and seventh entries, so the array is the matrix by columns.
%
/.crdmul {  % x y z matrix  .  a b c
    4 dict begin
    /m exch def /z3 exch def /y3 exch def /x3 exch def
    x3 m 0 get mul y3 m 3 get mul add z3 m 6 get mul add
    x3 m 1 get mul y3 m 4 get mul add z3 m 7 get mul add
    x3 m 2 get mul y3 m 5 get mul add z3 m 8 get mul add
    end
} def

%
%  The inverse of such a matrix, which is what carries the transformed
%  P Q R back to X Y Z. A matrix with no inverse describes no adaptation
%  at all, and is refused where it is read rather than left to divide by
%  zero part way through a colour.
%
/.crdinv3 {  % matrix  .  matrix'
    8 dict begin
    /m exch def
    /k0 m 4 get m 8 get mul m 7 get m 5 get mul sub def
    /k1 m 1 get m 8 get mul m 7 get m 2 get mul sub def
    /k2 m 1 get m 5 get mul m 4 get m 2 get mul sub def
    /dt m 0 get k0 mul m 3 get k1 mul sub m 6 get k2 mul add def
    dt 0 eq { /setcolor cvx /undefinedresult signalerror } if
    [
        k0 dt div
        k1 neg dt div
        k2 dt div
        m 3 get m 8 get mul m 6 get m 5 get mul sub neg dt div
        m 0 get m 8 get mul m 6 get m 2 get mul sub dt div
        m 0 get m 5 get mul m 3 get m 2 get mul sub neg dt div
        m 3 get m 7 get mul m 6 get m 4 get mul sub dt div
        m 0 get m 7 get mul m 6 get m 1 get mul sub neg dt div
        m 0 get m 4 get mul m 3 get m 1 get mul sub dt div
    ]
    end
} def

%
%  The white point adaptation (PLRM 7.1.2 step 2): the colour's X Y Z
%  carried into the P Q R representation by MatrixPQR, each component
%  transformed by its TransformPQR procedure against the source's and the
%  device's white and black points, and carried back by the inverse.
%
%  Each of the four points reaches the procedure as six numbers -- the
%  point in X Y Z and the same point in P Q R -- which is what the
%  specification hands one.
%
/.crdpqr {  % X Y Z ciedict crd  .  X' Y' Z'
    16 dict begin
    /crd exch def /cd exch def
    /ws cd /WhitePoint get def
    /bs cd /BlackPoint [0 0 0] //.crdget exec def
    /wd crd /WhitePoint get def
    /bd crd /BlackPoint [0 0 0] //.crdget exec def
    ws wd //.crdsame exec bs bd //.crdsame exec and {
        end
    }{
        /mp crd /MatrixPQR [1 0 0 0 1 0 0 0 1] //.crdget exec def
        /tp crd /TransformPQR get def
        /Ws [ ws aload pop ws aload pop mp //.crdmul exec ] def
        /Bs [ bs aload pop bs aload pop mp //.crdmul exec ] def
        /Wd [ wd aload pop wd aload pop mp //.crdmul exec ] def
        /Bd [ bd aload pop bd aload pop mp //.crdmul exec ] def
        mp //.crdmul exec
        /Rs exch def /Qs exch def /Ps exch def
        Ws Bs Wd Bd Ps tp 0 get //.decode exec
        Ws Bs Wd Bd Qs tp 1 get //.decode exec
        Ws Bs Wd Bd Rs tp 2 get //.decode exec
        mp //.crdinv3 exec //.crdmul exec
        end
    } ifelse
} def

%
%  The render colour space (PLRM 7.1.2 step 3): X Y Z through MatrixLMN
%  and the EncodeLMN procedures to L M N, then through MatrixABC and the
%  EncodeABC procedures to A B C, each brought inside the range the
%  dictionary states for it.
%
/.crdabc {  % X Y Z crd  .  A B C
    10 dict begin
    /crd exch def
    crd /MatrixLMN [1 0 0 0 1 0 0 0 1] //.crdget exec //.crdmul exec
    crd /EncodeLMN null //.crdget exec
    dup null ne {
        /el exch def
        /NN exch def /MM exch def /LL exch def
        LL el 0 get //.decode exec
        MM el 1 get //.decode exec
        NN el 2 get //.decode exec
    }{ pop } ifelse
    crd /MatrixABC [1 0 0 0 1 0 0 0 1] //.crdget exec //.crdmul exec
    crd /EncodeABC null //.crdget exec
    dup null ne {
        /ea exch def
        /CC exch def /BB exch def /AA exch def
        AA ea 0 get //.decode exec
        BB ea 1 get //.decode exec
        CC ea 2 get //.decode exec
    }{ pop } ifelse
    /ra crd /RangeABC [0 1 0 1 0 1] //.crdget exec def
    /CC exch def /BB exch def /AA exch def
    AA ra 0 get ra 1 get //.cieclamp exec
    BB ra 2 get ra 3 get //.cieclamp exec
    CC ra 4 get ra 5 get //.cieclamp exec
    end
} def

%
%  A RenderTable lookup (PLRM 7.1.2 step 4): the A B C components index a
%  three-dimensional table of m-component entries, the eight surrounding
%  entries are interpolated trilinearly, and each interpolated byte goes
%  through its own procedure to become a device component.
%
%  The axis a value falls on is found the same way a CIEBasedDEF Table's
%  is, so the same helper decides both; what differs is that the bounds
%  come from RangeABC and the entries lie m to a cell rather than three.
%
/.crdtable {  % A B C crd  .  d1..dm m
    24 dict begin
    /crd exch def
    /rt crd /RenderTable get def
    /na rt 0 get def /nb rt 1 get def /nc rt 2 get def
    /tv rt 3 get def
    /mm rt 4 get def

    % A table entry is three components or four, which is what says
    % whether it is a DeviceRGB colour or a DeviceCMYK one (PLRM 7.1.2).
    % A table of any other width names no device space, so nothing can be
    % done with its entries and the colour is refused rather than set
    % from however many components happened to come out. The count is
    % read here and not where the dictionary was set, because the
    % dictionary is the program's and it may write the entry after
    % setting it.
    mm 3 eq mm 4 eq or not
        { /setcolor cvx /rangecheck signalerror } if
    /ra crd /RangeABC [0 1 0 1 0 1] //.crdget exec def
    /CC exch def /BB exch def /AA exch def
    AA ra 0 get ra 1 get na //.cietblpos exec /af exch def /a1 exch def /a0 exch def
    BB ra 2 get ra 3 get nb //.cietblpos exec /bf exch def /b1 exch def /b0 exch def
    CC ra 4 get ra 5 get nc //.cietblpos exec /cf exch def /c1 exch def /c0 exch def
    0 1 mm 1 sub { /k exch def
        0
        0 1 1 { /sa exch def
            /aa sa 0 eq { a0 }{ a1 } ifelse def
            /aw sa 0 eq { 1 af sub }{ af } ifelse def
        0 1 1 { /sb exch def
            /bb sb 0 eq { b0 }{ b1 } ifelse def
            /bw sb 0 eq { 1 bf sub }{ bf } ifelse def
        0 1 1 { /sc exch def
            /cc sc 0 eq { c0 }{ c1 } ifelse def
            /cw sc 0 eq { 1 cf sub }{ cf } ifelse def
            tv aa get bb nc mul cc add mm mul k add get
            aw mul bw mul cw mul add
        } for } for } for
        255 div rt 5 k add get //.decode exec
        0.0 1.0 //.cieclamp exec
    } for
    mm
    end
} def

%
%  The device colour a CIE-based colour's X Y Z renders to, under the
%  colour rendering dictionary the graphics state holds.
%
%  The default dictionary describes the conversion above rather than
%  asking for another one, so when it is the one in force that conversion
%  runs and the dictionary's procedures go unread. PLRM 7.1.2 says the
%  stages are performed in combination rather than in sequence and that
%  an implementation detects the cases where they cancel; this is that
%  case, and it is the case every job that never sets a dictionary of its
%  own is in. tests/crd_render_test.ps holds the two descriptions to each
%  other by rendering the same colour through a copy of the dictionary,
%  which is not the dictionary and so takes the general route.
%
/.cierender {  % X Y Z ciedict  .  comps... space
    2 dict begin
    /cd exch def
    /crd graphicsdict /currgstate get /colorrendering get def
    crd //.crddefault eq {
        cd /WhitePoint get //.ciexyzrgb exec
        /DeviceRGB
    }{
        cd crd //.crdpqr exec
        crd //.crdabc exec
        crd /RenderTable known {
            crd //.crdtable exec
            4 eq { /DeviceCMYK }{ /DeviceRGB } ifelse
        }{
            /DeviceRGB
        } ifelse
    } ifelse
    end
} def

%
%  CIEBasedABC's second stage and CIEBasedDEF's third: the LMN
%  components through their DecodeLMN procedures and MatrixLMN, which is
%  what leaves the XYZ the rendering dictionary above converts.
%
/.cielmndev {  % L M N ciedict  .  comps... space
    8 dict begin
    /cd exch def /NN exch def /MM exch def /LL exch def
    /rl cd /RangeLMN 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /LL LL rl 0 get rl 1 get //.cieclamp exec def
    /MM MM rl 2 get rl 3 get //.cieclamp exec def
    /NN NN rl 4 get rl 5 get //.cieclamp exec def
    cd /DecodeLMN 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dl exch def
        /LL LL dl 0 get //.decode exec def
        /MM MM dl 1 get //.decode exec def
        /NN NN dl 2 get //.decode exec def
    }{ pop } ifelse
    /ml cd /MatrixLMN 2 copy known { get }{ pop pop [1 0 0 0 1 0 0 0 1] } ifelse def
    LL ml 0 get mul MM ml 3 get mul add NN ml 6 get mul add
    LL ml 1 get mul MM ml 4 get mul add NN ml 7 get mul add
    LL ml 2 get mul MM ml 5 get mul add NN ml 8 get mul add
    cd //.cierender exec
    end
} def

%
%  A CIEBasedABC colour to device colour (PLRM 4.8.3): the ABC
%  components through DecodeABC and MatrixABC, then the LMN stage above.
%
/.cieabcdev {  % A B C ciedict  .  comps... space
    8 dict begin
    /cd exch def /CC exch def /BB exch def /AA exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /AA AA ra 0 get ra 1 get //.cieclamp exec def
    /BB BB ra 2 get ra 3 get //.cieclamp exec def
    /CC CC ra 4 get ra 5 get //.cieclamp exec def
    cd /DecodeABC 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /da exch def
        /AA AA da 0 get //.decode exec def
        /BB BB da 1 get //.decode exec def
        /CC CC da 2 get //.decode exec def
    }{ pop } ifelse
    /ma cd /MatrixABC 2 copy known { get }{ pop pop [1 0 0 0 1 0 0 0 1] } ifelse def
    AA ma 0 get mul BB ma 3 get mul add CC ma 6 get mul add
    AA ma 1 get mul BB ma 4 get mul add CC ma 7 get mul add
    AA ma 2 get mul BB ma 5 get mul add CC ma 8 get mul add
    cd //.cielmndev exec
    end
} def

%
%  A CIEBasedA colour to device colour (PLRM 4.8.3). One component
%  through DecodeA and MatrixA, which produces the LMN the shared stage
%  takes.
%
/.cieadev {  % A ciedict  .  comps... space
    6 dict begin
    /cd exch def /AA exch def
    /ra cd /RangeA 2 copy known { get }{ pop pop [0 1] } ifelse def
    /AA AA ra 0 get ra 1 get //.cieclamp exec def
    cd /DecodeA 2 copy known { get }{ pop pop null } ifelse
    dup null ne { AA exch //.decode exec /AA exch def }{ pop } ifelse
    /ma cd /MatrixA 2 copy known { get }{ pop pop [1 1 1] } ifelse def
    AA ma 0 get mul
    AA ma 1 get mul
    AA ma 2 get mul
    cd //.cielmndev exec
    end
} def

%
%  A CIEBasedDEF colour to device colour (PLRM 4.8.5): the DEF components
%  through DecodeDEF, then looked up in the three-dimensional Table with
%  trilinear interpolation between the eight surrounding entries, which
%  gives the ABC the stage above takes.
%
/.ciedefdev {  % D E F ciedict  .  comps... space
    24 dict begin
    /cd exch def /FF exch def /EE exch def /DD exch def
    /rd cd /RangeDEF 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /DD DD rd 0 get rd 1 get //.cieclamp exec def
    /EE EE rd 2 get rd 3 get //.cieclamp exec def
    /FF FF rd 4 get rd 5 get //.cieclamp exec def
    cd /DecodeDEF 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dd exch def
        /DD DD dd 0 get //.decode exec def
        /EE EE dd 1 get //.decode exec def
        /FF FF dd 2 get //.decode exec def
    }{ pop } ifelse
    /rh cd /RangeHIJ 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /tb cd /Table get def
    /nh tb 0 get def /ni tb 1 get def /nj tb 2 get def
    /tv tb 3 get def
    DD rh 0 get rh 1 get nh //.cietblpos exec /hf exch def /h1 exch def /h0 exch def
    EE rh 2 get rh 3 get ni //.cietblpos exec /if_ exch def /i1 exch def /i0 exch def
    FF rh 4 get rh 5 get nj //.cietblpos exec /jf exch def /j1 exch def /j0 exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def

    % The eight surrounding table entries, weighted trilinearly by
    % iteration -- clamped duplicate indices then weigh nothing extra.
    0 1 2 { /c exch def
        0
        0 1 1 { /ah exch def
            /hh ah 0 eq { h0 }{ h1 } ifelse def
            /hw ah 0 eq { 1 hf sub }{ hf } ifelse def
        0 1 1 { /ai exch def
            /ii ai 0 eq { i0 }{ i1 } ifelse def
            /iw ai 0 eq { 1 if_ sub }{ if_ } ifelse def
        0 1 1 { /aj exch def
            /jj aj 0 eq { j0 }{ j1 } ifelse def
            /jw aj 0 eq { 1 jf sub }{ jf } ifelse def
            tv hh get ii nj mul jj add 3 mul c add get
            hw mul iw mul jw mul add
        } for } for } for
        255 div ra c 2 mul get ra c 2 mul 1 add get //.cietblval exec
    } for
    cd //.cieabcdev exec
    end
} def

%
%  A CIEBasedDEFG colour to device colour (PLRM 4.8.5): the same as
%  CIEBasedDEF with a fourth input, so the table is four-dimensional and
%  the interpolation is over sixteen surrounding entries.
%
/.ciedefgdev {  % D E F G ciedict  .  comps... space
    28 dict begin
    /cd exch def /GG exch def /FF exch def /EE exch def /DD exch def
    /rd cd /RangeDEFG 2 copy known { get }{ pop pop [0 1 0 1 0 1 0 1] } ifelse def
    /DD DD rd 0 get rd 1 get //.cieclamp exec def
    /EE EE rd 2 get rd 3 get //.cieclamp exec def
    /FF FF rd 4 get rd 5 get //.cieclamp exec def
    /GG GG rd 6 get rd 7 get //.cieclamp exec def
    cd /DecodeDEFG 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dd exch def
        /DD DD dd 0 get //.decode exec def
        /EE EE dd 1 get //.decode exec def
        /FF FF dd 2 get //.decode exec def
        /GG GG dd 3 get //.decode exec def
    }{ pop } ifelse
    /rh cd /RangeHIJK 2 copy known { get }{ pop pop [0 1 0 1 0 1 0 1] } ifelse def
    /tb cd /Table get def
    /nh tb 0 get def /ni tb 1 get def /nj tb 2 get def /nk tb 3 get def
    /tv tb 4 get def
    DD rh 0 get rh 1 get nh //.cietblpos exec /hf exch def /h1 exch def /h0 exch def
    EE rh 2 get rh 3 get ni //.cietblpos exec /if_ exch def /i1 exch def /i0 exch def
    FF rh 4 get rh 5 get nj //.cietblpos exec /jf exch def /j1 exch def /j0 exch def
    GG rh 6 get rh 7 get nk //.cietblpos exec /kf exch def /k1 exch def /k0 exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    0 1 2 { /c exch def
        0
        0 1 1 { /ah exch def
            /hh ah 0 eq { h0 }{ h1 } ifelse def
            /hw ah 0 eq { 1 hf sub }{ hf } ifelse def
        0 1 1 { /ai exch def
            /ii ai 0 eq { i0 }{ i1 } ifelse def
            /iw ai 0 eq { 1 if_ sub }{ if_ } ifelse def
        0 1 1 { /aj exch def
            /jj aj 0 eq { j0 }{ j1 } ifelse def
            /jw aj 0 eq { 1 jf sub }{ jf } ifelse def
        0 1 1 { /ak exch def
            /kk ak 0 eq { k0 }{ k1 } ifelse def
            /kw ak 0 eq { 1 kf sub }{ kf } ifelse def
            tv hh get ii get jj nk mul kk add 3 mul c add get
            hw mul iw mul jw mul kw mul add
        } for } for } for } for
        255 div ra c 2 mul get ra c 2 mul 1 add get //.cietblval exec
    } for
    cd //.cieabcdev exec
    end
} def

%
%  The family dispatch, keyed by the space's own name.
%
/.ciefams <<
    /CIEBasedA //.cieadev
    /CIEBasedABC //.cieabcdev
    /CIEBasedDEF //.ciedefdev
    /CIEBasedDEFG //.ciedefgdev
>> def

%
%  The device colour a CIE-based colour renders to, whichever of the
%  families the space belongs to, and the space those components belong
%  in: the family is read off the space's own name and dispatched through
%  .ciefams below.
%
/.ciedev {  % comps... space  .  comps... space'
    dup 1 get exch 0 get
    //.ciefams exch get exec
} def

%
%  The range a CIE-based space declares its components over. Each family
%  names the entry that carries it and has its own default for a
%  dictionary that leaves the entry out (PLRM 4.8.3).
%
/.cierangekeys <<
    /CIEBasedA    [ /RangeA    [0 1] ]
    /CIEBasedABC  [ /RangeABC  [0 1 0 1 0 1] ]
    /CIEBasedDEF  [ /RangeDEF  [0 1 0 1 0 1] ]
    /CIEBasedDEFG [ /RangeDEFG [0 1 0 1 0 1 0 1] ]
>> readonly def

%
%  The range a CIE space states for its own inputs, or the default the
%  specification gives where the dictionary states none. The clamp above
%  reads it, so a space that omits the entry is clamped to the same
%  bounds as one that spells it out.
%
/.cierange {  % space  .  range
    dup 0 get //.cierangekeys exch get
    aload pop
    3 -1 roll 1 get
    3 -1 roll 2 copy known
        { get exch pop }{ pop pop } ifelse
} def

%
%  Each component of a CIE-based colour brought inside the range its space
%  declares: a value outside it is the nearest one inside, and no error
%  (PLRM 4.8.3).
%
/.cieclampcomps {  % space comps  .  comps
    3 dict begin
    /cc exch def
    /rg exch //.cierange exec def
    0 1 cc length 1 sub {
        dup cc exch get
        1 index 2 mul rg exch get
        2 index 2 mul 1 add rg exch get
        //.cieclamp exec
        cc 3 1 roll put
    } for
    cc
    end
} def
end

%
%  --- setting a colour that has to be converted first ----------------
%
%  An Indexed, Separation, DeviceN or CIE-based colour cannot be recorded
%  as it stands: it converts, through a procedure the program wrote, into
%  a colour of a space the device paints in, and it is that colour the
%  graphics state ends up holding. But currentcolorspace must still
%  report the space that was set, and currentcolor the components as they
%  were given, so both have to survive the conversion -- and they cannot
%  ride the operand stack, which the conversion procedure works on.
%
%  So they go in a pair of graphicsdict slots and the conversion runs
%  inside the bracket, which puts back whatever the caller had parked
%  there. The conversion may set a colour of its own, in a space of the
%  same kind, which comes through here against the same pair.
%
.xpostsys /.cskeys [ /.csspace /.csstash /.convdepth ] readonly put

%
%  comps is the components as the program gave them.
%
.xpostsys /.withspace {  % space comps {conv}  .  -
    //.xpostsys /.withspacebody get
    //.cskeys 0
    //.callout exec
} put

%
%  Run a colour conversion with the space and its components parked
%  where the conversion can reach them, and the depth counted.
%
%  The count is what bounds procedure-driven conversion: a tint
%  transform, a CIE Decode or an Indexed lookup may set a colour in a
%  space whose own conversion re-enters here, and without a bound that
%  grows virtual memory without end and raises no catchable error. The
%  count is a slot the bracket saves and restores, so each re-entry is
%  counted and each return gives its level back.
%
.xpostsys /.withspacebody {  % space comps {conv}  .  -
    % Bound the depth of procedure-driven colour conversion. A tint
    % transform (or a CIE Decode, an Indexed lookup) may set a colour in a
    % space whose own conversion re-enters here; the callout keeps the
    % operand and dictionary stacks level across each re-entry, so neither
    % overflow bounds it, and a transform that sets a colour in its own
    % space would grow virtual memory without end and raise no catchable
    % error. The count is a slot the callout saves and restores around this
    % body (/.convdepth is in .cskeys), so it falls back as the conversion
    % unwinds, whether that unwinds by returning or by this refusal.
    graphicsdict /.convdepth known
        { graphicsdict /.convdepth get 1 add }{ 1 } ifelse
    dup 256 gt { pop /setcolor cvx /limitcheck signalerror } if
    graphicsdict exch /.convdepth exch put
    3 1 roll
    graphicsdict exch /.csstash exch put
    graphicsdict exch /.csspace exch put
    exec
    graphicsdict /currgstate get /setspace graphicsdict /.csspace get put
    graphicsdict /currgstate get /tintcomps graphicsdict /.csstash get put
} put

%
%  Enter the space the conversion's result belongs in, if the procedure
%  left another one in force. The procedure is the program's and may set
%  a colour of its own; the components it returned are in the space
%  stated, and that is the space the setcolor consuming them has to run
%  in.
%
.xpostsys /.csalt {  % -  .  -
    dup graphicsdict /currgstate get /setspace get eq
        { pop }{ setcolorspace } ifelse
} put

%
%  The palette entry an Indexed index names, in the base space
%
.xpostsys /.idxconv {  % -  .  -
    3 dict begin
    /cs graphicsdict /.csspace get def
    /ix graphicsdict /.csstash get 0 get def
    cs 1 get setcolorspace
    cs 3 get dup type /stringtype eq {
        /lk exch def
        //.xpostsys /.ncomponents get exec /n exch def
        0 1 n 1 sub {
            lk exch n ix mul add get 255 div
        } for
    }{
        ix exch null 1 //.pcallout exec
        cs 1 get //.csalt exec
    } ifelse
    end
    setcolor
} put

%
%  Each tint of a Separation or DeviceN colour brought inside 0.0 to 1.0,
%  the range PLRM 4.8.4 states a tint lies in. The transform is called
%  with what comes out: its domain is that range, and the tint the
%  graphics state ends up holding is the one it was called with.
%
.xpostsys /.tintsclamp {  % comps  .  comps
    1 dict begin
    /tc exch def
    0 1 tc length 1 sub {
        dup tc exch get 0.0 1.0 //.cieclamp exec
        tc 3 1 roll put
    } for
    tc
    end
} put

%
%  The alternative-space colour a Separation or DeviceN tint transforms to
%
%  The tint transform is the program's, so it runs beneath the boundary:
%  what fails in there is the program's own object failing, the operand
%  stack goes back to what the transform found (PLRM 3.11.1), and the
%  operator that carried the colour in keeps the components it consumed.
%  Everything around it here is the machinery's, and a refusal in that --
%  on the components the space was handed, or on what the transform
%  returned -- is that operator's own refusal.
%
.xpostsys /.sepconv {  % -  .  -
    graphicsdict /.csstash get aload pop
    graphicsdict /.csspace get
    dup 0 get /Separation eq { DEVICE /.registersep known } { false } ifelse {
        % A device that preserves separations also receives the
        % (tint, space) pair: convert first (the device-space
        % setters clear the gstate's separation record), then
        % register with the device and record its index and the
        % tint for the marking methods.
        2 copy dup 2 get setcolorspace
        3 get //.pexec exec
        graphicsdict /.csspace get 2 get //.csalt exec
        setcolor
        1 index exch                       % Tint tint space
        DEVICE dup /.registersep get exec  % Tint index true | tint false
        {
            graphicsdict /currgstate get exch /sepindex exch put
            graphicsdict /currgstate get exch /septint exch put
        }{
            pop
        } ifelse
    }{
        dup 2 get setcolorspace
        3 get //.pexec exec
        graphicsdict /.csspace get 2 get //.csalt exec
        setcolor
    } ifelse
} put

%
%  The device colour a CIE-based colour renders to
%
%  Which device space that is is the rendering dictionary's to say: a
%  RenderTable delivering four components names DeviceCMYK, and
%  everything else DeviceRGB (PLRM 7.1.2).
%
.xpostsys /.cieconv {  % -  .  -
    graphicsdict /.csstash get aload pop
    graphicsdict /.csspace get
    //.ciedev exec
    dup setcolorspace
    /DeviceCMYK eq { setcmykcolor }{ setrgbcolor } ifelse
} put

%
%  Make a colour space current and set its initial colour (PLRM 8.2),
%  which for most spaces is black and for Pattern is no pattern at all.
%
%  The space is recorded twice: as the program set it, which is what
%  currentcolorspace reports, and as the space the components are
%  actually recorded in, which is what the painting machinery reads.
%  They differ wherever a space reduces -- Indexed through its base,
%  Separation and DeviceN through their alternative.
%
/setcolorspace [ /anytype ] {  % array|name  .  -
    dup //.xpostsys /.csvalidate get exec

    %[ currentcolor SetColorDict currentcolorspace get counttomark 2 add -1 roll
    % record the space as set (what currentcolorspace reports), then the
    % space the colour components are recorded in: setcolor converts an
    % Indexed colour through its base and a Separation or DeviceN tint
    % through its alternative, so reduce through any such chain.
    graphicsdict /currgstate get 1 index /setspace exch put
    dup //.xpostsys /.spaceispattern get exec {
        % A pattern space: setcolor stores the pattern for the
        % painting machinery; a second element names the underlying
        % space an uncoloured pattern's cells paint with.
        1 dict begin
        /sp exch def
        graphicsdict /currgstate get /colorspace /Pattern put
        graphicsdict /currgstate get /patbase
            sp //.xpostsys /.spacebeneath get exec
        put
        end
    }{
    //.xpostsys /.spacereduce get exec
    graphicsdict /currgstate get exch /colorspace exch put
    } ifelse
    graphicsdict /currgstate get /colorcomp1 0.0 put
    graphicsdict /currgstate get /colorcomp2 0.0 put
    graphicsdict /currgstate get /colorcomp3 0.0 put
    graphicsdict /currgstate get /colorcomp4 0.0 put
    graphicsdict /currgstate get /sepindex null put
    graphicsdict /currgstate get /tintcomps null put

    % and the colour the space is entered holding, which the space
    % itself decides.
    //.xpostsys /.csinitcolor get exec

    %exec pop
} .defop

%
%  The colour space as the program set it (PLRM 8.2), not the space its
%  components ended up recorded in.
%
/currentcolorspace [ ] {  % -  .  array
    % The space is reported as an array even when it was set as a bare
    % family name and has no parameters (PLRM 8.2), so that indexing the
    % result to ask which family it is works for every space rather than
    % for the parameterised ones only.
    graphicsdict /currgstate get /setspace get
    dup type /arraytype ne { 1 array astore } if
} .defop

.xpostsys /SetColorDict <<
    /DeviceGray /setgray cvx
    /DeviceRGB /setrgbcolor cvx
    /DeviceCMYK /setcmykcolor cvx
    /Pattern {  % comp1..compn pattern  .  -
        % comp1..compn pattern (components only under an uncoloured
        % pattern, in its underlying space), or the null object that
        % stands for an empty tiling pattern (PLRM 4.9.1). The null
        % carries no PaintType and so is not an uncoloured pattern; it
        % takes the coloured arm, whose stored state is what a Pattern
        % space is entered holding.
        2 dict begin
        /pat exch def
        graphicsdict /currgstate get /patdict pat put
        pat type /nulltype eq { false }
        { pat /PaintType 2 copy known { get 2 eq }{ pop pop false } ifelse }
        ifelse {
            /bs graphicsdict /currgstate get /patbase get def
            /n bs //.xpostsys /.spacecomponents get exec def
            n array astore
            graphicsdict /currgstate get exch /patcomps exch put

            % What currentcolor answers with: the components beneath an
            % uncoloured pattern, and the pattern itself.
            [ graphicsdict /currgstate get /patcomps get aload pop pat ]
        }{
            graphicsdict /currgstate get /patcomps null put
            [ pat ]
        } ifelse
        graphicsdict /currgstate get exch /tintcomps exch put
        end
    }
>> put

%
%               pattern  .  -
%  comp1..compn pattern  .  -
%
%  Shorthand for entering the pattern colour space and setting the
%  pattern as the colour; an uncoloured pattern takes the current
%  colour space as its underlying space, with the components beneath
%  The components beneath vary with the underlying space, so the
%  pattern itself is the operand stated.
%
/setpattern [ /dicttype ] {
    % A pattern dictionary, which is one that has been through
    % makepattern. The same question makepattern asked, asked the same
    % way: this operator is reached with dictionaries that never went
    % through it, and one of those must be refused for the reason it is
    % wrong rather than for whichever entry a later site happened to want.
    dup /setpattern /typecheck //.xpostsys /.patterntype get exec pop
    dup /PaintType 2 copy known { get 2 eq }{ pop pop false } ifelse not {
        [ /Pattern ] setcolorspace
    }{
        % The underlying space is the current one -- or, when that is
        % already a pattern space, its own underlying space.
        currentcolorspace
        dup //.xpostsys /.spaceispattern get exec {
            //.xpostsys /.spacebeneath get exec
            dup null eq { pop /DeviceGray } if
        } if
        [ /Pattern 3 -1 roll ] setcolorspace
    } ifelse
    setcolor
} .defop

%
%
%  The number of colour components the current colour space takes: an
%  Indexed colour is one index, a Separation one tint, a DeviceN one
%  tint per named colorant.
%
%  The body is left unbound at its definition and frozen by the lockdown's
%  sweep instead. currentcolorspace is written in PostScript and is still a
%  procedure while this file loads, so a bind here would substitute nothing
%  for it and would make the array read-only, which is what stops a later
%  sweep from finishing the job -- and the name would stay dynamic for the
%  rest of the run, inside every operator reaching this helper.
%  The colour space families, and what kind of thing each one is.
%
%  Every other statement about a space follows from its kind: a device
%  space states its own component count, a CIE family states one and
%  reduces to device RGB, an indexed space carries one index and reduces
%  through its base, a tint space carries its tints and reduces through
%  its alternative, and a pattern space carries a pattern. The kind is
%  what the machinery is really asking whenever it tests a family name,
%  and the tables below answer the rest.
%
%  Written down as a table because a family that is only ever a name in
%  an equality test cannot be enumerated. Four of these -- the indexed,
%  the two tints and the pattern -- existed nowhere but in such tests,
%  which is why nothing could ask whether they had all been considered,
%  and why an uncoloured pattern over three of them was found broken one
%  at a time. tests/check-colour-spaces.sh holds this table and the two
%  below to each other, so a family cannot be in one and missing from
%  another.
%
.xpostsys /.spacekinds <<
    /DeviceGray   /device
    /DeviceRGB    /device
    /DeviceCMYK   /device
    /CIEBasedA    /cie
    /CIEBasedABC  /cie
    /CIEBasedDEF  /cie
    /CIEBasedDEFG /cie
    /Indexed      /indexed
    /Separation   /tint
    /DeviceN      /tint
    /Pattern      /pattern
>> readonly put

%
%  The kind of a colour space, given as a bare family name or as an array
%  carrying the family and its parameters. A space naming no known family
%  answers null, which is what the validator refuses on.
%
.xpostsys /.spacekind {  % space  .  /device|/cie|/indexed|/tint|/pattern|null
    dup type /arraytype eq { 0 get } if
    dup type /nametype eq {
        //.spacekinds 1 index known {
            //.spacekinds exch get
        }{ pop null } ifelse
    }{ pop null } ifelse
} put

.xpostsys /.spacecomps <<
    /DeviceGray 1
    /DeviceRGB 3
    /DeviceCMYK 4
>> readonly put

.xpostsys /.ciecomps <<
    /CIEBasedA 1
    /CIEBasedABC 3
    /CIEBasedDEF 3
    /CIEBasedDEFG 4
>> readonly put

%
%  How many components the current colour space takes. Read wherever a
%  run of components has to be counted off the stack rather than
%  assumed.
%
.xpostsys /.ncomponents {  % -  .  int
    currentcolorspace //.xpostsys /.spacecomponents get exec
} put

%
%  How many components a colour in this space carries. An Indexed colour
%  is one index and a Separation one tint whatever they reduce to; a
%  DeviceN carries one per name; a CIE-based family and a device space
%  each state their own count. The space may be a bare family name or an
%  array carrying parameters, since both reach here.
%
%  One count rather than one per caller. What a space costs in components
%  decides how many numbers are read off the stack, how many are stored,
%  and how many are handed to a device, so two callers counting
%  differently is a colour read at one width and written at another.
%
.xpostsys /.spacecomponents {  % space  .  n
    dup type /arraytype eq {
        dup 0 get /Indexed eq { pop 1 }{
        dup 0 get /Separation eq { pop 1 }{
        dup 0 get /DeviceN eq { 1 get length }{
        dup 0 get //.ciecomps exch known {
            0 get //.ciecomps exch get }{
        0 get //.spacecomps exch get
        } ifelse } ifelse } ifelse } ifelse
    }{
        //.spacecomps exch get
    } ifelse
} put

%
%  Whether a colour space is a pattern space, asked of the space as the
%  program gave it: a family name on its own, or an array carrying the
%  family and its parameters. Both forms reach setcolorspace, so both
%  have to be understood wherever the question is asked, and asking it
%  two ways is how one site comes to understand a form another does not.
%
.xpostsys /.spaceispattern {  % space  .  bool
    dup type /arraytype eq { 0 get } if
    /Pattern eq
} put

%
%  What each composing family is built over, and what may not be there.
%
%  PLRM 4.8.1 calls Indexed, Separation, DeviceN and Pattern the special
%  colour spaces, and each of them is a space built over another one.
%  Which element carries that other space differs, and so does what may
%  sit there: an Indexed base may not be a Pattern or another Indexed
%  space (PLRM 4.8.4), a Separation or DeviceN alternative may not be any
%  special space at all (PLRM 4.8.5), and the space underlying a Pattern
%  may not itself be a Pattern space (PLRM 4.9.2).
%
%  Three statements of one shape, so one table rather than a test at each
%  of three sites -- three sites is how one of them comes to be written
%  and the other two forgotten, which is the state this found the
%  interpreter in.
%
%  Keyed by KIND rather than by family name, so that a new family of a
%  kind already here is answered by the line already here rather than by
%  a line nobody remembered to add. tests/check-colour-spaces.sh holds
%  the keys to the roster in both directions.
%
%    <kind>  [ <element the space beneath sits at>  <kinds refused there>... ]
%
.xpostsys /.spaceunder <<
    /indexed  [ 1 /indexed /pattern ]
    /tint     [ 2 /indexed /tint /pattern ]
    /pattern  [ 1 /pattern ]
>> readonly put

%
%  The colour space a composing space is built over, or null where it
%  carries none.
%
%  An Indexed space's base, a Separation or DeviceN space's alternative,
%  a Pattern space's underlying space. A Pattern space may leave it out
%  (PLRM 4.9.1) and any space given as a bare family name carries no
%  parameters at all, so an answer of null is an ordinary one and not a
%  fault.
%
%  One reader rather than one per caller: the validator, the graphics
%  state and setpattern all have to find the same space there, and two
%  of them digging it out differently is a space validated as one thing
%  and painted in another.
%
.xpostsys /.spacebeneath {  % space  .  space'|null
    2 dict begin
    /sp exch def
    /at //.spaceunder /sp load //.spacekind exec 2 copy known
        { get 0 get }{ pop pop null } ifelse def
    at null eq { null }{
        /sp load type /arraytype ne { null }{
            /sp load length at le { null }{ /sp load at get } ifelse
        } ifelse
    } ifelse
    end
} put

%
%  Whether a colour set in this space can produce visible output at all.
%
%  PLRM 4.8.5 gives the colorant name None exactly this meaning: painting
%  in a Separation space named None "has no effect on the current page",
%  and the space ignores its alternative space and tint transform. So the
%  answer follows from the space and nothing else -- not from the tint, and
%  not from what the transform would have returned, which is the reason
%  this can be settled once when the space is set. The name arrives as a
%  name or as a string, because PLRM 4.8.5 admits either.
%
%  The sibling special name All is NOT this: it paints in every available
%  colorant, which is the opposite of painting in none.
%
.xpostsys /.spacenomarks {  % space  .  bool
    dup type /arraytype eq {
        dup length 2 ge {
            dup 0 get /Separation eq {
                1 get
                dup type /stringtype eq { cvn } if
                /None eq
            }{ pop false } ifelse
        }{ pop false } ifelse
    }{ pop false } ifelse
} put

%
%  Walk a colour space down to the one a colour in it is finally recorded
%  in: an Indexed space through its base, a Separation or DeviceN through
%  its alternative, a CIE-based family to device RGB. A space that reduces
%  to nothing is handed back as it stands, and so is anything that is not
%  an array.
%
%  One walk rather than one per caller. setcolorspace reduces to decide
%  what the graphics state records a colour in, and the validator reduces
%  to decide what it is validating; the two asking differently would be a
%  space accepted as one thing and recorded as another, which no program
%  could see until it used that space.
%
.xpostsys /.spacereduce {  % space  .  space
    % A colour space reaches its device space in as many steps as it
    % nests, which is a handful. A space that reached itself would reduce
    % forever -- a loop with no end and no allocation to trip a limit --
    % and what keeps one from arriving here is the rule about what may
    % sit beneath a composing space, which admits no nesting order a
    % space can appear twice in. The count is the floor under this walk
    % rather than that rule: it refuses a space that has not reduced in
    % far more steps than any real space nests. It rides under the space
    % on the stack and is dropped at either exit, so a caller sees only
    % the space it passed reduced.
    256 exch
    {
        exch 1 sub dup 0 lt
            { pop /setcolorspace cvx /typecheck signalerror } if
        exch
        dup type /arraytype ne { exch pop exit } if
        dup 0 get /Indexed eq { 1 get }{
        dup 0 get dup /Separation eq exch /DeviceN eq or {
            2 get
        }{
        //.ciefams 1 index 0 get known {
            pop /DeviceRGB
        }{
            exch pop exit
        } ifelse } ifelse } ifelse
    } loop
} put

%
%  A procedure where the specification asks for one.
%
%  The language calls a procedure an executable array, so an array that
%  is not executable is not one and neither is anything of another type.
%  Asked in one place because every entry that has to be a procedure is
%  the same question -- a tint transform, a CIE decode -- and each site
%  spelling the test again is each site free to spell it differently.
%
.xpostsys /.csproc {  % obj  .  -
    dup type dup /arraytype eq exch /packedarraytype eq or
    exch xcheck and not
        { /setcolorspace cvx /typecheck signalerror } if
} put

%
%  A colorant name where the specification asks for one.
%
%  PLRM 4.8.5 states a Separation's name, and every entry of a DeviceN
%  names array, as a name or a string object -- the two interchangeably,
%  a string being the form for a colorant whose name carries spaces or
%  other characters a name cannot hold. Nothing else is one.
%
%  Asked in one place for the reason .csproc is: it is one statement made
%  at two sites, and a colorant read as a name at one and as anything at
%  all at the other is the same space refused by one family and taken by
%  the other.
%
.xpostsys /.csname {  % obj  .  -
    type dup /nametype eq exch /stringtype eq or not
        { /setcolorspace cvx /typecheck signalerror } if
} put

%
%  Where each tint family carries its colorants, and whether it carries
%  one or many.
%
%  A Separation names a single colorant (PLRM 4.8.5) and a DeviceN an
%  array of them (PLRM 4.8.5, DeviceN Color Spaces), both at the second
%  element. That difference is the whole of what separates the two
%  families, and it is exactly the kind of thing a reader written for one
%  and used for the other gets wrong -- a name has a length, so a bare
%  name where an array of names belongs is counted as though it were an
%  array of that many colorants.
%
%  Keyed by FAMILY rather than by kind, because the kind is what the two
%  share and the carriage is what they do not.
%  tests/check-colour-spaces.sh holds the keys to the roster, so a tint
%  family arriving without a line is reported.
%
%    <family>  [ <element the colorants sit at>  <one|many> ]
%
.xpostsys /.colorantsat <<
    /Separation [ 1 /one ]
    /DeviceN    [ 1 /many ]
>> readonly put

%
%  Every colorant a tint space names is a colorant name, and a space that
%  carries an array of them carries at least one.
%
%  A DeviceN space names the colorants it paints with, and the length of
%  that array is the number of components a colour in the space carries
%  (PLRM 4.8.5). An empty array names no colorant and prices the space at
%  no components: setcolor would read nothing off the stack, the tint
%  transform would be called with nothing, and the space would paint with
%  no colorant at all. That is not a colour space, and the fault is in
%  the value rather than in its type, so it is refused as out of range.
%
%  Checked where the space is set rather than where a colour is painted,
%  because this is the last moment the operator the program named is
%  still the one a refusal will be reported against.
%
.xpostsys /.cscolorants {  % space  .  -
    3 dict begin
    /sp exch def
    /at //.colorantsat /sp load 0 get get def
    /nm /sp load at 0 get get def
    at 1 get /one eq {
        /nm load //.csname exec
    }{
        /nm load type dup /arraytype ne exch /packedarraytype ne and
            { /setcolorspace cvx /typecheck signalerror } if
        /nm load length 0 eq
            { /setcolorspace cvx /rangecheck signalerror } if
        0 1 /nm load length 1 sub {
            /nm load exch get //.csname exec
        } for
    } ifelse
    end
} put

%
%  An Indexed space's palette: how far it may be indexed, and what the
%  colour at an index is read out of.
%
%  PLRM 4.8.4 states hival as an integer no greater than 4095, and lookup
%  as either a procedure or a string of m x (hival + 1) bytes, where m is
%  the number of components in the base space. Each of the three is a
%  fault a program can only be usefully told about here. A hival above
%  4095 is a table wider than a 12-bit sample can address. A palette
%  shorter than the entries it is priced for holds colours nothing wrote:
%  an index into the part that is not there raises against whichever
%  painting operator reached it, having accepted the space that was
%  already wrong. A lookup that is neither a string nor a procedure is
%  executed anyway: a number leaves itself, so the base space is handed
%  one component where it wanted m, and what the program is told about is
%  the stack.
%
%  The base's component count is MEASURED from the base rather than
%  assumed, because the length the specification asks for is written in
%  terms of it; the base has been validated as a colour space in its own
%  right before this is asked, so it has a count to give.
%
.xpostsys /.csindexed {  % space  .  -
    4 dict begin
    /sp exch def

    % the four-element form is the only one PLRM 4.8.4 states, and the
    % parameters below are not there to be read in any other
    /sp load length 4 lt
        { /setcolorspace cvx /typecheck signalerror } if

    /hv /sp load 2 get def
    /hv load type /integertype ne
        { /setcolorspace cvx /typecheck signalerror } if
    /hv load 4095 gt
        { /setcolorspace cvx /rangecheck signalerror } if

    /lu /sp load 3 get def
    /lu load type /stringtype eq {
        /m /sp load 1 get //.spacecomponents exec def
        /lu load length m /hv load 1 add mul lt
            { /setcolorspace cvx /rangecheck signalerror } if
    }{
        /lu load //.csproc exec
    } ifelse
    end
} put

%
%  The decode entries each CIE-based family may carry, and how many
%  procedures each entry holds. A count of zero means the entry is the
%  procedure itself rather than an array of them.
%
%  PLRM Tables 4.5 to 4.8 give every one of these the type procedure,
%  and a value of another type is not one. A number in particular is
%  taken in silence: executing a number leaves that number, so the
%  component the decode was to have transformed becomes a constant and
%  every colour set in the space is wrong with nothing raised.
%
%  A table because it is one rule over four families and eight entries,
%  and a family whose entries are listed nowhere is a family the rule
%  cannot reach. tests/check-colour-spaces.sh holds the keys to the
%  roster, so a CIE family arriving without a line is reported.
%
.xpostsys /.ciedecodes <<
    /CIEBasedA    [ /DecodeA 0 /DecodeLMN 3 ]
    /CIEBasedABC  [ /DecodeABC 3 /DecodeLMN 3 ]
    /CIEBasedDEF  [ /DecodeDEF 3 /DecodeABC 3 /DecodeLMN 3 ]
    /CIEBasedDEFG [ /DecodeDEFG 4 /DecodeABC 3 /DecodeLMN 3 ]
>> readonly put

%
%  Every decode entry a CIE-based space carries is a procedure, and an
%  entry holding several holds as many as its family asks for.
%
%  Checked where the space is set rather than where a colour is
%  converted, because a decode runs at unpredictable times (PLRM 4.8.3)
%  and a fault found then is reported against whichever painting
%  operator reached it instead of against the operator that supplied it.
%
.xpostsys /.cieprocs {  % space  .  -
    8 dict begin
    /sp exch def
    /sp load length 2 lt
        { /setcolorspace cvx /rangecheck signalerror } if
    /pd /sp load 1 get def
    /ks //.ciedecodes /sp load 0 get get def
    0 2 ks length 2 sub {
        /i exch def
        /k ks i get def
        /n ks i 1 add get def
        /pd load k known {
            % the entry rides the stack rather than a name: it is the
            % program's object and a procedure reached through a name
            % would be run rather than looked at
            /pd load k get
            n 0 eq {
                //.csproc exec
            }{
                dup type dup /arraytype ne exch /packedarraytype ne and
                    { /setcolorspace cvx /typecheck signalerror } if
                dup length n lt
                    { /setcolorspace cvx /rangecheck signalerror } if
                0 1 n 1 sub { 1 index exch get //.csproc exec } for
                pop
            } ifelse
        } if
    } for
    end
} put

%
%  Whether a colour space is one, refused where it is not.
%
%  Every statement a family makes about its own shape is asked here: what
%  may sit beneath a composing space, that a tint transform and a CIE
%  decode are procedures, and that the family a colour finally lands in
%  is one this interpreter can record a colour in. A family none of those
%  knows is undefined.
%
%  All of it at the moment the space is SET rather than at the moment a
%  colour in it is painted, because this is the last moment the operator
%  the program named is still the one a refusal will be reported against
%  -- and because a graphics state left holding a space that answers
%  nothing tells the program at a place it cannot connect to the cause.
%
.xpostsys /.csvalidate {  % space  .  -
    3 dict begin
    /sp exch def

    % Every name here is read back through `load`. What is being
    % validated is the program's own object, and an executable one --
    % which a colour space may perfectly well be, since setcolorspace
    % states its operand as any type -- would be RUN rather than looked
    % at were it reached the ordinary way.

    % The space this one is built over, where it is built over one at
    % all: an Indexed base, a Separation or DeviceN alternative, the
    % space underlying a Pattern. Not every space may sit there, and
    % which ones may not is .spaceunder's to say (PLRM 4.8.4, 4.8.5 and
    % 4.9.2). Refused here because this is the last moment the operator
    % the program named is still the one that will be reported.
    /un /sp load //.spacebeneath exec def
    /un load null ne {
        /ru //.spaceunder /sp load //.spacekind exec get def
        1 1 ru length 1 sub {
            ru exch get /un load //.spacekind exec eq
                { /setcolorspace cvx /rangecheck signalerror } if
        } for

        % and it is then a colour space in its own right, which is what
        % PLRM 4.8.4 and 4.8.5 ask for when they say a base or an
        % alternative is given exactly as it would be given to
        % setcolorspace itself.
        %
        % The walk ends because the rule above leaves one nesting order
        % and no other: a Pattern over an Indexed over a tint space over
        % a device or CIE space. No space can appear beneath itself, so
        % none can be reached twice.
        /un load //.xpostsys /.csvalidate get exec
    } if

    /sp load //.spaceispattern exec not {
        % A tint space reaches its alternative space by calling a
        % procedure the program supplied (PLRM 4.8.5), so a fourth
        % element that cannot be called is not a tint transform and the
        % array is not a colour space. The refusal is here because this
        % is the last moment the operator that supplied it is still the
        % one the program named; called later, the failure would be
        % reported against whichever painting operator reached it.
        %
        % The two special colorant names do not exempt it. A Separation
        % named All or None ignores its alternative space and transform,
        % and PLRM still requires dummy values to be provided; a dummy
        % of a kind that could never be called is not one, and admitting
        % it here would admit it for every colorant name alike.
        /sp load //.spacekind exec /tint eq {
            /sp load length 4 lt
                { /setcolorspace cvx /typecheck signalerror } if
            % and the colorants the space is named for, which is the
            % element the two tint families carry differently
            /sp load //.cscolorants exec
            /sp load 3 get //.csproc exec
        } if
        % An Indexed space's palette is stated in terms of its base --
        % how far it may be indexed, and how many bytes an entry takes
        % (PLRM 4.8.4) -- so it is asked after the base above, which is
        % what leaves the base validated and able to give a count. Asked
        % of the parameterised form only, for the same reason the CIE
        % entries below are.
        /sp load //.spacekind exec /indexed eq { /sp load type /arraytype eq
            { /sp load //.csindexed exec } if } if
        % asked of the parameterised form only: a CIE family named on
        % its own carries no dictionary to hold entries at all, and is
        % refused below for naming a family nothing can reduce
        /sp load //.spacekind exec /cie eq { /sp load type /arraytype eq
            { /sp load //.cieprocs exec } if } if
        /sp /sp load //.spacereduce exec def

        % An array still standing here names a family nothing reduced
        /sp load type /arraytype eq { /sp /sp load 0 get def } if
        /sp load type /nametype ne
            { /setcolorspace cvx /typecheck signalerror } if
        //.spacecomps /sp load known not
            { /setcolorspace cvx /undefined signalerror } if
    } if
    end
} put

%
%  The component count follows the current colour space, so the operand
%  stated is the topmost one: a component, or the pattern of a pattern
%  space, or the null object a pattern space holds before a pattern is
%  set.
%
%  comp1..compN  .  -
%       pattern  .  -
%          null  .  -
%
/setcolor [ [ /numbertype ] [ /dicttype ] [ /nulltype ] ] {
    currentcolorspace

    % PLRM 4.9.1: the colour value in a Pattern space is a null object,
    % treated as an empty tiling pattern, and a program may set that
    % value itself. No other family gives null a meaning, so the operand
    % statement admits it for all of them and it is narrowed here, in the
    % operator that knows which space is current. Refusing it in the
    % family's own arm instead would report the fault as a component of
    % the wrong type, which is a different mistake.
    1 index type /nulltype eq {
        dup //.spaceispattern exec not
            { /setcolor cvx /typecheck signalerror } if
    } if
    dup //.spacekind exec /indexed eq {
        % [/Indexed base hival lookup] index setcolor: the index names a
        % palette entry, resolved and set in the base space. A real index
        % is the nearest whole number to it and an index outside 0 to
        % hival is the nearer of those two bounds (PLRM 4.8.4); the
        % rounding and the clipping are both done before the integer is
        % taken, so an index with no integer in it still names an entry.
        exch round
        dup 0 lt { pop 0 } if
        1 index 2 get 1 index lt { pop dup 2 get } if
        cvi
        1 array astore
        //.idxconv //.withspace exec
    }{
    dup //.spacekind exec /tint eq
    {
        % [/Separation name alt tint] or [/DeviceN names alt tint]: the
        % tints convert through the transform into the alternative space.
        dup 0 get /Separation eq { pop 1 }{ 1 get length } ifelse
        array astore
        //.tintsclamp exec
        currentcolorspace exch
        //.sepconv //.withspace exec
    } {
    dup //.spacekind exec /cie eq
    {
        % A CIE-based colour: the family pipeline runs it down to device
        % RGB, which is a different component count in every family but ABC.
        pop //.ncomponents exec
        array astore
        currentcolorspace exch
        1 index exch
        //.cieclampcomps exec
        //.cieconv //.withspace exec
    }{
        % A pattern space arrives as an array: dispatch on the family
        dup type /arraytype eq { 0 get } if
        //SetColorDict exch get exec
    } ifelse } ifelse } ifelse
} .defop

%
%  Set the colour the current colour space is entered holding. Every
%  space has one and setcolorspace installs it (PLRM 8.2): black in a
%  device space, which in DeviceCMYK is three zeros and a one; a tint of
%  1.0 in a Separation and in every component of a DeviceN (PLRM 4.8.4);
%  index zero in an Indexed space; and zero in each component of a
%  CIE-based space, moved to the nearest value the space's own Range
%  declares valid where zero is not one (PLRM 4.8.3). A Pattern space is
%  entered holding a null object, which paints nothing (PLRM 4.9).
%
%  The colour is resolved here rather than left for the first setcolor.
%  What a space carries a colour through -- a tint transform, a palette
%  lookup, a CIE pipeline -- decides both what the page is painted in and
%  what currentcolor answers, and a space entered and painted in without
%  a setcolor has to paint the colour it was entered holding.
%  The space and its family ride the operand stack rather than a
%  dictionary of this procedure's own: the colour goes through the
%  program's tint transform, palette procedure or decoding procedure on
%  its way in, and a procedure of the program's runs against the
%  program's dictionaries and defines into them.
%
.xpostsys /.csinitcolor {  % -  .  -
    currentcolorspace
    dup //.spacekind exec
    dup /pattern eq {
        % The null pattern, which is what currentcolor answers with
        % until a pattern is set. Set through setcolor like every other
        % family's entry colour, so the state a Pattern space is entered
        % holding is written in one place and is by construction the
        % state a program reaches by setting null itself.
        pop pop
        null //setcolor exec
    }{
    dup /indexed eq {
        pop pop 0 //setcolor exec
    }{
    dup /tint eq {
        % A Separation enters at full tint, a DeviceN at full in each of
        % its names, so the count comes from the space rather than the
        % kind.
        pop dup 0 get /Separation eq
            { pop 1.0 }{ 1 get length { 1.0 } repeat } ifelse
        //setcolor exec
    }{
    dup /cie eq {
        % The space itself is kept: clamping a CIE colour needs the
        % range its space declares.
        pop
        [ //.ncomponents exec { 0.0 } repeat ]
        //.cieclampcomps exec
        aload pop //setcolor exec
    }{
        pop
        dup type /arraytype eq { 0 get } if
        dup /DeviceCMYK eq { pop 0.0 0.0 0.0 1.0 }{
        /DeviceRGB eq { 0.0 0.0 0.0 }{
        0.0 } ifelse } ifelse
        //setcolor exec
    } ifelse } ifelse } ifelse } ifelse
} put

.xpostsys /CurrentColorDict <<
    /DeviceGray /currentgray cvx
    /DeviceRGB /currentrgbcolor cvx
    /DeviceCMYK /currentcmykcolor cvx

    % A device with the /Process native space takes each paint in the
    % space it was set in: deliver the current colour unconverted (one
    % grey component, three RGB or four CMYK).
    /Process /currentcolor cvx
>> put

%
%  The current colour's components, in the space the program set (PLRM
%  8.2) -- so a Separation or DeviceN colour answers the tints it was
%  set with, not the alternative-space colour they were transformed to.
%
/currentcolor [ ] {  % -  .  comp1..compN
    % A colour whose space records its components elsewhere than it
    % takes them -- Separation, DeviceN, Indexed, any CIE-based family --
    % reads back as the components it was set with, which setcolor put
    % aside; everything else delivers the recorded components, keyed by
    % the space they are recorded in.
    graphicsdict /currgstate get /tintcomps get type /arraytype eq {
        graphicsdict /currgstate get /tintcomps get aload pop
    }{
        //CurrentColorDict graphicsdict /currgstate get /colorspace get get exec
    } ifelse
} .defop

%
%  The lesser of two numbers. A pure global helper, so it lives in
%  .xpostsys beside the colour conversions that freeze a reference to
%  it.
%
.xpostsys /.min {  % x y  .  min
        %        y (otherwise)
    2 copy gt{exch}if pop
} put

%
%  A colour component is clamped to the unit range (PLRM: values outside
%  0 to 1 are adjusted to the nearest valid value). A pure global helper, so it
%  lives in .xpostsys beside .min and the colour conversions that freeze it in.
%
.xpostsys /.c01 {  % component  .  real in [0,1]
    cvr dup 0.0 lt { pop 0.0 } if dup 1.0 gt { pop 1.0 } if
} put

.xpostsys /ColorConversionDict <<  % <</dest <</source {source-to-dest conversion}>> >>
    /DeviceGray <<
        /DeviceGray {  % -  .  gray
            graphicsdict /currgstate get /colorcomp1 get
        } bind
        /DeviceRGB {  % -  .  gray
            graphicsdict /currgstate get /colorcomp1 get
            .3 mul
            graphicsdict /currgstate get /colorcomp2 get
            .59 mul add
            graphicsdict /currgstate get /colorcomp3 get
            .11 mul add
        } bind
        /DeviceCMYK {  % -  .  gray
            1
            graphicsdict /currgstate get /colorcomp1 get
            .3 mul
            graphicsdict /currgstate get /colorcomp2 get
            .59 mul add
            graphicsdict /currgstate get /colorcomp3 get
            .11 mul add
            graphicsdict /currgstate get /colorcomp4 get
            add
            1 //.min exec sub
        } bind

        % A pattern is a procedure tiled over the region rather than a
        % colour a component can be read out of, so there is nothing
        % here to convert: PLRM 8.2 says these operators cannot convert
        % from a special colour space. What they answer with is the
        % colour the graphics state starts at, black, which is what a
        % program reads before it sets one. Answering rather than
        % refusing is what lets a program ask after the current colour
        % without first having to ask what space it is in.
        /Pattern {  % -  .  gray
            0.0
        } bind
    >>
    /DeviceRGB <<
        /DeviceGray {  % -  .  r g b
            graphicsdict /currgstate get /colorcomp1 get
            dup
            dup
        } bind
        /DeviceRGB {  % -  .  r g b
            graphicsdict /currgstate get /colorcomp1 get
            graphicsdict /currgstate get /colorcomp2 get
            graphicsdict /currgstate get /colorcomp3 get
        } bind
        /DeviceCMYK {  % -  .  r g b
            graphicsdict /currgstate get /colorcomp4 get  % K
            1 graphicsdict /currgstate get /colorcomp1 get  % K 1 c
            2 index add 1 //.min exec sub  % K 1-min(1,c+k)
            1 graphicsdict /currgstate get /colorcomp2 get  % K R 1 m
            3 index add 1 //.min exec sub  % K R 1-min(1,m+k)
            1 graphicsdict /currgstate get /colorcomp3 get  % K R G 1 y
            5 4 roll add 1 //.min exec sub  % R G 1-min(1,y+k)
        } bind

        % A pattern is a procedure tiled over the region rather than a
        % colour a component can be read out of, so there is nothing
        % here to convert: PLRM 8.2 says these operators cannot convert
        % from a special colour space. What they answer with is the
        % colour the graphics state starts at, black, which is what a
        % program reads before it sets one. Answering rather than
        % refusing is what lets a program ask after the current colour
        % without first having to ask what space it is in.
        /Pattern {  % -  .  r g b
            0.0 0.0 0.0
        } bind
    >>
    /DeviceCMYK <<
        /DeviceGray {  % -  .  c m y k
            0
            0
            0
            1 graphicsdict /currgstate get /colorcomp1 get sub
        } bind
        /DeviceRGB {  % -  .  c m y k
            % Full black generation and undercolor removal: the common
            % component moves entirely into the black channel, so black
            % separates as pure K rather than four inks.
            1 graphicsdict /currgstate get /colorcomp1 get sub
            1 graphicsdict /currgstate get /colorcomp2 get sub //.min exec
            1 graphicsdict /currgstate get /colorcomp3 get sub //.min exec  % K
            dup dup dup                                              % K k k k
            1 graphicsdict /currgstate get /colorcomp1 get sub exch sub  % K k k c'
            4 1 roll                                                 % C' k k k
            1 graphicsdict /currgstate get /colorcomp2 get sub exch sub  % C' k k m'
            3 1 roll                                                 % C' m' k k
            1 graphicsdict /currgstate get /colorcomp3 get sub exch sub  % C' m' k y'
            exch                                                     % C' m' y' k
        } bind
        /DeviceCMYK {  % -  .  c m y k
            graphicsdict /currgstate get /colorcomp1 get
            graphicsdict /currgstate get /colorcomp2 get
            graphicsdict /currgstate get /colorcomp3 get
            graphicsdict /currgstate get /colorcomp4 get
        } bind

        % A pattern is a procedure tiled over the region rather than a
        % colour a component can be read out of, so there is nothing
        % here to convert: PLRM 8.2 says these operators cannot convert
        % from a special colour space. What they answer with is the
        % colour the graphics state starts at, black, which is what a
        % program reads before it sets one. Answering rather than
        % refusing is what lets a program ask after the current colour
        % without first having to ask what space it is in.
        /Pattern {  % -  .  c m y k
            0.0 0.0 0.0 1.0
        } bind
    >>
>> put

%
%  Enter DeviceGray and set one component (PLRM 8.2). The Level 1
%  operators are each a space and a colour set together, which is why
%  they may be used without a setcolorspace before them.
%
/setgray [ /numbertype ] {  % num  .  -
    graphicsdict /currgstate get /setspace /DeviceGray put
    graphicsdict /currgstate get /colorspace /DeviceGray put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} .defop

%
%  The current colour as a grey (PLRM 8.2), converted from whatever
%  space it is actually in.
%
/currentgray [ ] {  % -  .  gray
    //ColorConversionDict /DeviceGray get
        graphicsdict /currgstate get /colorspace get
        get exec
} .defop

%
%  Enter DeviceRGB and set three components (PLRM 8.2).
%
/setrgbcolor [ /numbertype /numbertype /numbertype ] {  % r g b  .  -
    graphicsdict /currgstate get /setspace /DeviceRGB put
    graphicsdict /currgstate get /colorspace /DeviceRGB put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp3 exch put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp2 exch put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} .defop

%
%  The current colour as RGB (PLRM 8.2), converted from whatever space
%  it is actually in.
%
/currentrgbcolor [ ] {  % -  .  r g b
    //ColorConversionDict /DeviceRGB get
        graphicsdict /currgstate get /colorspace get
        get exec
} .defop

%
%  The components are recorded in RGB, converted with the usual
%  hexcone model (hue scaled to a sector 0-5; the sector's fractional
%  part blends between the derived p, q and t values). Each component is
%  clamped to [0,1] first: hue is clamped rather than wrapped, so a hue
%  above 1 is the same colour as a hue of 1 and not the same as a hue of 0.
%
/sethsbcolor [ /numbertype /numbertype /numbertype ] {  % hue saturation brightness  .  -
    3 { //.c01 exec 3 1 roll } repeat
    7 dict begin
    //.hsbnames {exch def}forall
    /h h h truncate sub 6 mul def       % Scale hue to sector 0-5 (1 maps to 0)
    /i h truncate cvi def
    /f h i sub def
    /p b 1 s sub mul def
    /q b 1 s f mul sub mul def
    /t b 1 s 1 f sub mul sub mul def
    i 0 eq { b t p }{
    i 1 eq { q b p }{
    i 2 eq { p b t }{
    i 3 eq { p q b }{
    i 4 eq { t p b }{
             b p q } ifelse } ifelse } ifelse } ifelse } ifelse
    end
    setrgbcolor
} .defop

%
%  The current colour as hue, saturation and brightness (PLRM 8.2). The
%  components are recorded in RGB and converted here, so a colour set by
%  sethsbcolor and read back may differ in the last place.
%
/currenthsbcolor [ ] {  % -  .  h s b
    currentrgbcolor
    3 dict begin
    //.rgbnames {exch def}forall
    /v r g 2 copy lt {exch} if pop b 2 copy lt {exch} if pop def
    /d v r g 2 copy gt {exch} if pop b 2 copy gt {exch} if pop sub def
    d 0 eq {
        0.0 0.0 v
    }{
        v r eq { g b sub d div 6 add
        }{ v g eq { b r sub d div 2 add
        }{ r g sub d div 4 add } ifelse } ifelse
        6 div dup truncate sub          % Hue
        d v div                         % Saturation
        v                               % Brightness
    } ifelse
    end
} .defop

%
%  Enter DeviceCMYK and set four components (PLRM 8.2).
%
/setcmykcolor [ /numbertype /numbertype /numbertype /numbertype ] {  % c m y k  .  -
    graphicsdict /currgstate get /setspace /DeviceCMYK put
    graphicsdict /currgstate get /colorspace /DeviceCMYK put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp4 exch put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp3 exch put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp2 exch put
    graphicsdict /currgstate get exch //.c01 exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} .defop

%
%  The current colour as CMYK (PLRM 8.2), converted from whatever space
%  it is actually in.
%
/currentcmykcolor [ ] {  % -  .  c m y k
    //ColorConversionDict /DeviceCMYK get
        graphicsdict /currgstate get /colorspace get
        get exec
} .defop

%
%  Custom-colour convenience operators. A custom colour is a named spot ink
%  with a device fallback: findcmykcustomcolor and findrgbcustomcolor package
%  the fallback components with the name, and setcustomcolor enters the
%  Separation colour space (PLRM 4.8.4) whose alternate is that fallback and
%  whose tint transform scales the fallback by the tint. Because it is
%  shorthand over the Separation space, a separation-preserving device
%  receives the named colorant and a composite device reduces through the
%  alternate. The packaged object is [c m y k name] for CMYK and [r g b name]
%  for RGB, told apart by length. The tint transform bakes the components in,
%  mapping a tint t to [ct mt yt kt] (or [rt gt bt]), so the space carries its
%  own reduction.
%

%
%  The Separation space a custom-colour object is shorthand for.
%  setcustomcolor and customcolorimage share it so the object is unpacked
%  one way only.
%
.xpostsys /.customcolorspace {  % obj /operator  .  [/Separation name alt {transform}]
    % The name of the operator that asked goes under the object, so the
    % refusal below reports it rather than the one this is written for
    % (PLRM 3.11.1); the branches that succeed drop it again at the tail.
    exch
    dup length 5 eq {
        aload pop                               % C m y k name
        6 dict begin
        /nm exch def /kk exch def /yy exch def /mm exch def /cc exch def
        [ /Separation /nm load /DeviceCMYK
          [ /dup load cc /mul load /exch load
            /dup load mm /mul load /exch load
            /dup load yy /mul load /exch load
                      kk /mul load ] cvx ]
        end
    }{
        dup length 4 eq {
            aload pop                           % R g b name
            5 dict begin
            /nm exch def /bb exch def /gg exch def /rr exch def
            [ /Separation /nm load /DeviceRGB
              [ /dup load rr /mul load /exch load
                /dup load gg /mul load /exch load
                          bb /mul load ] cvx ]
            end
        }{
            pop cvx /rangecheck signalerror
    } ifelse } ifelse
    exch pop
} put

%
%  A custom-colour object: a named spot colour together with the CMYK it
%  prints as where the device has no such separation. An Adobe extension
%  the separation workflow uses, not a Level 3 operator.
%
%  The object is what setcustomcolor and customcolorimage take; nothing
%  else reads it.
%
/findcmykcustomcolor [ /numbertype /numbertype /numbertype /numbertype /stringtype ] {  % c m y k name  .  object
    5 array astore
} .defop

%
%  The same, for a spot colour whose alternative is stated in RGB.
%
/findrgbcustomcolor [ /numbertype /numbertype /numbertype /stringtype ] {  % r g b name  .  object
    4 array astore
} .defop

%
%  Set a custom-colour object at a tint (an Adobe extension): shorthand
%  for entering the Separation space the object describes and setting
%  that one component.
%
/setcustomcolor [ /arraytype /numbertype ] {  % object tint  .  -
    exch                                        % Tint obj
    /setcustomcolor //.customcolorspace exec setcolorspace
    setcolor                                    % Tint setcolor
} .defop

%
%  A custom-colour image paints a one-channel picture in the custom colour:
%  its samples are read as coverage, a dark sample laying down the full
%  colorant and a light one leaving the page, so the decode runs 1 to 0. The
%  object comes last, over the same operands image takes; the space it
%  installs is undone afterwards.
%
/customcolorimage [ /integertype /integertype /integertype /arraytype /anytype /arraytype ] {  % w h bits matrix datasrc obj  .  -
    % w h bits matrix datasrc obj -- resolve the object's space first, before
    % any begin or gsave, so a malformed object leaves nothing to unwind.
    /customcolorimage //.customcolorspace exec        % ... space
    6 dict begin
    /.sp exch def /.src exch def /.mtx exch def
    /.bits exch def /.h exch def /.w exch def
    gsave
    .sp setcolorspace
    << /ImageType 1 /Width .w /Height .h /BitsPerComponent .bits
       /Decode [ 1 0 ] /ImageMatrix .mtx /DataSource /.src load >> image
    grestore
    end
} .defop

%
%  A separation image paints a one-channel picture in the current colour
%  space, its samples read straight as the single tint (decode 0 to 1). Unlike
%  the one-operand image form it honours a Separation or DeviceN space rather
%  than reading the samples as grey.
%
/separationimage [ /integertype /integertype /integertype /arraytype /anytype ] {  % w h bits matrix datasrc  .  -
    5 dict begin
    /.src exch def /.mtx exch def
    /.bits exch def /.h exch def /.w exch def
    << /ImageType 1 /Width .w /Height .h /BitsPerComponent .bits
       /Decode [ 0 1 ] /ImageMatrix .mtx /DataSource /.src load >> image
    end
} .defop

%
%  SetColorDict and CurrentColorDict dispatch a device colour through the
%  operator named for its space. A program may redefine setgray/setrgbcolor/
%  setcmykcolor (and the current* readers) -- a common trick for remapping the
%  colours a document paints -- and where such a redefinition re-enters the colour
%  machinery (as casselman ch8's setrgbcolor does, mapping RGB back into a DeviceN
%  space) the internal reduction of an Indexed, Separation or DeviceN colour loops
%  until the exec stack overflows. `bind` freezes the operator names in a procedure
%  body, but not names held as data in a dispatch dictionary; so capture the real
%  operators here by value, before any redefinition, the way font.ps does for show
%  and setfont. The internal reduction then always reaches the real operators,
%  while a program's own set*/current* calls still see its redefinition.
%
.xpostsys /SetColorDict get
    dup /DeviceGray  /setgray      load put
    dup /DeviceRGB   /setrgbcolor   load put
        /DeviceCMYK  /setcmykcolor  load put
.xpostsys /CurrentColorDict get
    dup /DeviceGray  /currentgray      load put
    dup /DeviceRGB   /currentrgbcolor   load put
    dup /DeviceCMYK  /currentcmykcolor  load put

%
%  A /Process-native device takes each paint in the space its components
%  were recorded in. That is the marking pipeline's fetch, not the public
%  currentcolor: a Separation or DeviceN paint must deliver the RECORDED
%  tint-transformed components here, where currentcolor reads back the
%  tints the colour was set with.
%
/Process {  % -  .  comp1..compN
    //CurrentColorDict
    graphicsdict /currgstate get /colorspace get get exec
} bind put

end end end

%
%  The colour space families this file implements, as PLRM Table 3.8 has a
%  program ask after them (the same shape as the type categories elsewhere).
%
%  /ICCBased is absent because it is not implemented; the eleven here were
%  each entered with setcolorspace to get on the list. Two of them nearly did
%  not: a CIEBasedDEF or DEFG built with a Table of the wrong shape is refused
%  the same way an unsupported family would be, so a careless probe reports
%  them missing when they work.
%
currentglobal true setglobal
[ /DeviceGray /DeviceRGB /DeviceCMYK
  /CIEBasedA /CIEBasedABC /CIEBasedDEF /CIEBasedDEFG
  /Separation /DeviceN /Indexed /Pattern ]
{ dup /ColorSpaceFamily defineresource pop } forall
setglobal

//.internaldict /QUIET known { }{ (eof color\n)print } ifelse
