//.internaldict /QUIET known { }{ (loading color.ps...)print } ifelse


% --- CIE-based colour spaces ---------------------------------------
% The four CIE-based families reduce a colour to X Y Z the way the
% language describes: per-component clamps to the declared ranges,
% the decode procedures, and the matrix stages. The X Y Z then
% renders to device RGB through fixed daylight primaries with the
% white point adapted by channel scaling; rendering dictionaries
% beyond the recorded stub take no part.

% v lo hi  .cieclamp  v'
currentglobal true setglobal
.xpostsys begin
% v {proc}  .decode  v'
% run one of a colour space's decode procedures. Each family reduces a
% colour under a dictionary of its own, and the decode procedures are
% the program's, so they go through the bracket: the names this
% reduction works under are not theirs to inherit, and what they define
% belongs where the program's other definitions go.
/.decode {
    null 1 //.xpostsys /.pcallout get exec
} bind def
/.cieclamp {
    3 dict begin
    /h exch def /l exch def
    dup l lt { pop l } if
    dup h gt { pop h } if
    end
} bind def

% X Y Z whitepoint  .ciexyzrgb  r g b
/.ciexyzrgb {
    5 dict begin
    /wp exch def /Z exch def /Y exch def /X exch def
    /X X 0.9505 wp 0 get div mul def
    /Y Y 1.0    wp 1 get div mul def
    /Z Z 1.089  wp 2 get div mul def
    X  3.2406 mul Y -1.5372 mul add Z -0.4986 mul add
    X -0.9689 mul Y  1.8758 mul add Z  0.0415 mul add
    X  0.0557 mul Y -0.2040 mul add Z  1.0570 mul add
    3 {
        3 -1 roll
        dup 0 lt { pop 0 } if
        dup 1 gt { pop 1 } if
        0.45 exp
    } repeat
    end
} bind def

% L M N ciedict  .cielmnxyzrgb  r g b
/.cielmnxyzrgb {
    8 dict begin
    /cd exch def /NN exch def /MM exch def /LL exch def
    /rl cd /RangeLMN 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /LL LL rl 0 get rl 1 get //.cieclamp exec def
    /MM MM rl 2 get rl 3 get //.cieclamp exec def
    /NN NN rl 4 get rl 5 get //.cieclamp exec def
    cd /DecodeLMN 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dl exch def
        /LL LL dl 0 get //.decode exec def
        /MM MM dl 1 get //.decode exec def
        /NN NN dl 2 get //.decode exec def
    }{ pop } ifelse
    /ml cd /MatrixLMN 2 copy known { get }{ pop pop [1 0 0 0 1 0 0 0 1] } ifelse def
    LL ml 0 get mul MM ml 3 get mul add NN ml 6 get mul add
    LL ml 1 get mul MM ml 4 get mul add NN ml 7 get mul add
    LL ml 2 get mul MM ml 5 get mul add NN ml 8 get mul add
    cd /WhitePoint get
    //.ciexyzrgb exec
    end
} bind def

% A B C ciedict  .cieabcrgb  r g b
/.cieabcrgb {
    8 dict begin
    /cd exch def /CC exch def /BB exch def /AA exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /AA AA ra 0 get ra 1 get //.cieclamp exec def
    /BB BB ra 2 get ra 3 get //.cieclamp exec def
    /CC CC ra 4 get ra 5 get //.cieclamp exec def
    cd /DecodeABC 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /da exch def
        /AA AA da 0 get //.decode exec def
        /BB BB da 1 get //.decode exec def
        /CC CC da 2 get //.decode exec def
    }{ pop } ifelse
    /ma cd /MatrixABC 2 copy known { get }{ pop pop [1 0 0 0 1 0 0 0 1] } ifelse def
    AA ma 0 get mul BB ma 3 get mul add CC ma 6 get mul add
    AA ma 1 get mul BB ma 4 get mul add CC ma 7 get mul add
    AA ma 2 get mul BB ma 5 get mul add CC ma 8 get mul add
    cd //.cielmnxyzrgb exec
    end
} bind def

% A ciedict  .ciearpgb  r g b
/.ciearpgb {
    6 dict begin
    /cd exch def /AA exch def
    /ra cd /RangeA 2 copy known { get }{ pop pop [0 1] } ifelse def
    /AA AA ra 0 get ra 1 get //.cieclamp exec def
    cd /DecodeA 2 copy known { get }{ pop pop null } ifelse
    dup null ne { AA exch //.decode exec /AA exch def }{ pop } ifelse
    /ma cd /MatrixA 2 copy known { get }{ pop pop [1 1 1] } ifelse def
    AA ma 0 get mul
    AA ma 1 get mul
    AA ma 2 get mul
    cd //.cielmnxyzrgb exec
    end
} bind def

% v lo hi n  .cietblpos  i0 i1 f
% a value within its range, over a table of n steps: the bracketing
% indices and the fraction between them
/.cietblpos {
    5 dict begin
    /n exch def /hi exch def /lo exch def
    lo hi //.cieclamp exec
    lo sub hi lo sub div n 1 sub mul
    dup 0 lt { pop 0 } if
    dup n 1 sub gt { pop n 1 sub } if
    /p exch def
    /i0 p floor cvi def
    i0
    i0 1 add dup n 1 sub gt { pop n 1 sub } if
    p i0 sub
    end
} bind def

% byte-fraction lo hi  .cietblval  v
/.cietblval {
    1 index sub mul add
} bind def

% D E F ciedict  .ciedefrgb  r g b
/.ciedefrgb {
    24 dict begin
    /cd exch def /FF exch def /EE exch def /DD exch def
    /rd cd /RangeDEF 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /DD DD rd 0 get rd 1 get //.cieclamp exec def
    /EE EE rd 2 get rd 3 get //.cieclamp exec def
    /FF FF rd 4 get rd 5 get //.cieclamp exec def
    cd /DecodeDEF 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dd exch def
        /DD DD dd 0 get //.decode exec def
        /EE EE dd 1 get //.decode exec def
        /FF FF dd 2 get //.decode exec def
    }{ pop } ifelse
    /rh cd /RangeHIJ 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    /tb cd /Table get def
    /nh tb 0 get def /ni tb 1 get def /nj tb 2 get def
    /tv tb 3 get def
    DD rh 0 get rh 1 get nh //.cietblpos exec /hf exch def /h1 exch def /h0 exch def
    EE rh 2 get rh 3 get ni //.cietblpos exec /if_ exch def /i1 exch def /i0 exch def
    FF rh 4 get rh 5 get nj //.cietblpos exec /jf exch def /j1 exch def /j0 exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    % the eight surrounding table entries, weighted trilinearly by
    % iteration -- clamped duplicate indices then weigh nothing extra
    0 1 2 { /c exch def
        0
        0 1 1 { /ah exch def
            /hh ah 0 eq { h0 }{ h1 } ifelse def
            /hw ah 0 eq { 1 hf sub }{ hf } ifelse def
        0 1 1 { /ai exch def
            /ii ai 0 eq { i0 }{ i1 } ifelse def
            /iw ai 0 eq { 1 if_ sub }{ if_ } ifelse def
        0 1 1 { /aj exch def
            /jj aj 0 eq { j0 }{ j1 } ifelse def
            /jw aj 0 eq { 1 jf sub }{ jf } ifelse def
            tv hh get ii nj mul jj add 3 mul c add get
            hw mul iw mul jw mul add
        } for } for } for
        255 div ra c 2 mul get ra c 2 mul 1 add get //.cietblval exec
    } for
    cd //.cieabcrgb exec
    end
} bind def

% D E F G ciedict  .ciedefgrgb  r g b
/.ciedefgrgb {
    28 dict begin
    /cd exch def /GG exch def /FF exch def /EE exch def /DD exch def
    /rd cd /RangeDEFG 2 copy known { get }{ pop pop [0 1 0 1 0 1 0 1] } ifelse def
    /DD DD rd 0 get rd 1 get //.cieclamp exec def
    /EE EE rd 2 get rd 3 get //.cieclamp exec def
    /FF FF rd 4 get rd 5 get //.cieclamp exec def
    /GG GG rd 6 get rd 7 get //.cieclamp exec def
    cd /DecodeDEFG 2 copy known { get }{ pop pop null } ifelse
    dup null ne {
        /dd exch def
        /DD DD dd 0 get //.decode exec def
        /EE EE dd 1 get //.decode exec def
        /FF FF dd 2 get //.decode exec def
        /GG GG dd 3 get //.decode exec def
    }{ pop } ifelse
    /rh cd /RangeHIJK 2 copy known { get }{ pop pop [0 1 0 1 0 1 0 1] } ifelse def
    /tb cd /Table get def
    /nh tb 0 get def /ni tb 1 get def /nj tb 2 get def /nk tb 3 get def
    /tv tb 4 get def
    DD rh 0 get rh 1 get nh //.cietblpos exec /hf exch def /h1 exch def /h0 exch def
    EE rh 2 get rh 3 get ni //.cietblpos exec /if_ exch def /i1 exch def /i0 exch def
    FF rh 4 get rh 5 get nj //.cietblpos exec /jf exch def /j1 exch def /j0 exch def
    GG rh 6 get rh 7 get nk //.cietblpos exec /kf exch def /k1 exch def /k0 exch def
    /ra cd /RangeABC 2 copy known { get }{ pop pop [0 1 0 1 0 1] } ifelse def
    0 1 2 { /c exch def
        0
        0 1 1 { /ah exch def
            /hh ah 0 eq { h0 }{ h1 } ifelse def
            /hw ah 0 eq { 1 hf sub }{ hf } ifelse def
        0 1 1 { /ai exch def
            /ii ai 0 eq { i0 }{ i1 } ifelse def
            /iw ai 0 eq { 1 if_ sub }{ if_ } ifelse def
        0 1 1 { /aj exch def
            /jj aj 0 eq { j0 }{ j1 } ifelse def
            /jw aj 0 eq { 1 jf sub }{ jf } ifelse def
        0 1 1 { /ak exch def
            /kk ak 0 eq { k0 }{ k1 } ifelse def
            /kw ak 0 eq { 1 kf sub }{ kf } ifelse def
            tv hh get ii get jj nk mul kk add 3 mul c add get
            hw mul iw mul jw mul kw mul add
        } for } for } for } for
        255 div ra c 2 mul get ra c 2 mul 1 add get //.cietblval exec
    } for
    cd //.cieabcrgb exec
    end
} bind def

% the family dispatch: comps [ /Family dict ]  .ciergb  r g b
/.ciefams <<
    /CIEBasedA //.ciearpgb
    /CIEBasedABC //.cieabcrgb
    /CIEBasedDEF //.ciedefrgb
    /CIEBasedDEFG //.ciedefgrgb
>> def
/.ciergb {
    dup 1 get exch 0 get
    //.ciefams exch get exec
} bind def

% space  .cierange  range
% The range a CIE-based space declares its components over. Each family
% names the entry that carries it and has its own default for a
% dictionary that leaves the entry out (PLRM 4.8.3).
/.cierangekeys <<
    /CIEBasedA    [ /RangeA    [0 1] ]
    /CIEBasedABC  [ /RangeABC  [0 1 0 1 0 1] ]
    /CIEBasedDEF  [ /RangeDEF  [0 1 0 1 0 1] ]
    /CIEBasedDEFG [ /RangeDEFG [0 1 0 1 0 1 0 1] ]
>> def
/.cierange {
    dup 0 get //.cierangekeys exch get
    aload pop
    3 -1 roll 1 get
    3 -1 roll 2 copy known
        { get exch pop }{ pop pop } ifelse
} bind def

% space comps  .cieclampcomps  comps
% Each component of a CIE-based colour brought inside the range its space
% declares: a value outside it is the nearest one inside, and no error
% (PLRM 4.8.3).
/.cieclampcomps {
    3 dict begin
    /cc exch def
    /rg exch //.cierange exec def
    0 1 cc length 1 sub {
        dup cc exch get
        1 index 2 mul rg exch get
        2 index 2 mul 1 add rg exch get
        //.cieclamp exec
        cc 3 1 roll put
    } for
    cc
    end
} bind def
end
setglobal

% --- setting a colour that has to be converted first ----------------
% An Indexed, Separation, DeviceN or CIE-based colour cannot be recorded
% as it stands: it converts, through a procedure the program wrote, into
% a colour of a space the device paints in, and it is that colour the
% graphics state ends up holding. But currentcolorspace must still
% report the space that was set, and currentcolor the components as they
% were given, so both have to survive the conversion -- and they cannot
% ride the operand stack, which the conversion procedure works on.
%
% So they go in a pair of graphicsdict slots and the conversion runs
% inside the bracket, which puts back whatever the caller had parked
% there. The conversion may set a colour of its own, in a space of the
% same kind, which comes through here against the same pair.
currentglobal true setglobal
.xpostsys /.cskeys [ /.csspace /.csstash ] put

% space comps {conv}  .withspace  -
% comps is the components as the program gave them.
.xpostsys /.withspace {
    //.xpostsys /.withspacebody get
    //.xpostsys /.cskeys get 0
    //.xpostsys /.callout get exec
} bind put

.xpostsys /.withspacebody {
    3 1 roll
    graphicsdict exch /.csstash exch put
    graphicsdict exch /.csspace exch put
    exec
    graphicsdict /currgstate get /setspace graphicsdict /.csspace get put
    graphicsdict /currgstate get /tintcomps graphicsdict /.csstash get put
} bind put

% -  .csalt  -
% Enter the space the conversion's result belongs in, if the procedure
% left another one in force. The procedure is the program's and may set
% a colour of its own; the components it returned are in the space
% stated, and that is the space the setcolor consuming them has to run
% in.
.xpostsys /.csalt {
    dup graphicsdict /currgstate get /setspace get eq
        { pop }{ setcolorspace } ifelse
} bind put

% the palette entry an Indexed index names, in the base space
.xpostsys /.idxconv {
    3 dict begin
    /cs graphicsdict /.csspace get def
    /ix graphicsdict /.csstash get 0 get def
    cs 1 get setcolorspace
    cs 3 get dup type /stringtype eq {
        /lk exch def
        //.xpostsys /.ncomponents get exec /n exch def
        0 1 n 1 sub {
            lk exch n ix mul add get 255 div
        } for
    }{
        ix exch null 1 //.xpostsys /.pcallout get exec
        cs 1 get //.xpostsys /.csalt get exec
    } ifelse
    end
    setcolor
} bind put

% comps  .tintsclamp  comps
% Each tint of a Separation or DeviceN colour brought inside 0.0 to 1.0,
% the range PLRM 4.8.4 states a tint lies in. The transform is called
% with what comes out: its domain is that range, and the tint the
% graphics state ends up holding is the one it was called with.
.xpostsys /.tintsclamp {
    1 dict begin
    /tc exch def
    0 1 tc length 1 sub {
        dup tc exch get 0.0 1.0 //.xpostsys /.cieclamp get exec
        tc 3 1 roll put
    } for
    tc
    end
} bind put

% the alternative-space colour a Separation or DeviceN tint transforms to
%
% The tint transform is the program's, so it runs beneath the boundary:
% what fails in there is the program's own object failing, the operand
% stack goes back to what the transform found (PLRM 3.11.1), and the
% operator that carried the colour in keeps the components it consumed.
% Everything around it here is the machinery's, and a refusal in that --
% on the components the space was handed, or on what the transform
% returned -- is that operator's own refusal.
.xpostsys /.sepconv {
    graphicsdict /.csstash get aload pop
    graphicsdict /.csspace get
    dup 0 get /Separation eq { DEVICE /.registersep known } { false } ifelse {
        % a device that preserves separations also receives the
        % (tint, space) pair: convert first (the device-space
        % setters clear the gstate's separation record), then
        % register with the device and record its index and the
        % tint for the marking methods
        2 copy dup 2 get setcolorspace
        3 get //.xpostsys /.pexec get exec
        graphicsdict /.csspace get 2 get //.xpostsys /.csalt get exec
        setcolor
        1 index exch                       % tint tint space
        DEVICE dup /.registersep get exec  % tint index true | tint false
        {
            graphicsdict /currgstate get exch /sepindex exch put
            graphicsdict /currgstate get exch /septint exch put
        }{
            pop
        } ifelse
    }{
        dup 2 get setcolorspace
        3 get //.xpostsys /.pexec get exec
        graphicsdict /.csspace get 2 get //.xpostsys /.csalt get exec
        setcolor
    } ifelse
} bind put

% the device RGB a CIE-based colour renders to
.xpostsys /.cieconv {
    graphicsdict /.csstash get aload pop
    graphicsdict /.csspace get
    //.xpostsys /.ciergb get exec
    /DeviceRGB setcolorspace
    setrgbcolor
} bind put
setglobal

/setcolorspace [ /anytype ] {
    dup //.xpostsys /.csvalidate get exec
    %[ currentcolor setcolordict currentcolorspace get counttomark 2 add -1 roll
    % record the space as set (what currentcolorspace reports), then the
    % space the colour components are recorded in: setcolor converts an
    % Indexed colour through its base and a Separation or DeviceN tint
    % through its alternative, so reduce through any such chain
    graphicsdict /currgstate get 1 index /setspace exch put
    dup //.xpostsys /.spaceispattern get exec {
        % a pattern space: setcolor stores the pattern for the
        % painting machinery; a second element names the underlying
        % space an uncoloured pattern's cells paint with
        1 dict begin
        /sp exch def
        graphicsdict /currgstate get /colorspace /Pattern put
        graphicsdict /currgstate get /patbase
            sp type /arraytype eq { sp length 1 gt { sp 1 get }{ null } ifelse }
                                  { null } ifelse
        put
        end
    }{
    //.xpostsys /.spacereduce get exec
    graphicsdict /currgstate get exch /colorspace exch put
    } ifelse
    graphicsdict /currgstate get /colorcomp1 0.0 put
    graphicsdict /currgstate get /colorcomp2 0.0 put
    graphicsdict /currgstate get /colorcomp3 0.0 put
    graphicsdict /currgstate get /colorcomp4 0.0 put
    graphicsdict /currgstate get /sepindex null put
    graphicsdict /currgstate get /tintcomps null put
    % and the colour the space is entered holding, which the space
    % itself decides
    //.xpostsys /.csinitcolor get exec
    %exec pop
} //.xpostsys /.defop get exec

/currentcolorspace [ ] {
    % The space is reported as an array even when it was set as a bare
    % family name and has no parameters (PLRM 8.2), so that indexing the
    % result to ask which family it is works for every space rather than
    % for the parameterised ones only.
    graphicsdict /currgstate get /setspace get
    dup type /arraytype ne { 1 array astore } if
} //.xpostsys /.defop get exec

.xpostsys /setcolordict <<
    /DeviceGray /setgray cvx
    /DeviceRGB /setrgbcolor cvx
    /DeviceCMYK /setcmykcolor cvx
    /Pattern {
        % comp1..compn pattern (components only under an uncoloured
        % pattern, in its underlying space), or the null object that
        % stands for an empty tiling pattern (PLRM 4.9.1). The null
        % carries no PaintType and so is not an uncoloured pattern; it
        % takes the coloured arm, whose stored state is what a Pattern
        % space is entered holding.
        2 dict begin
        /pat exch def
        graphicsdict /currgstate get /patdict pat put
        pat type /nulltype eq { false }
        { pat /PaintType 2 copy known { get 2 eq }{ pop pop false } ifelse }
        ifelse {
            /bs graphicsdict /currgstate get /patbase get def
            /n bs //.xpostsys /.spacecomponents get exec def
            n array astore
            graphicsdict /currgstate get exch /patcomps exch put
            % what currentcolor answers with: the components beneath an
            % uncoloured pattern, and the pattern itself
            [ graphicsdict /currgstate get /patcomps get aload pop pat ]
        }{
            graphicsdict /currgstate get /patcomps null put
            [ pat ]
        } ifelse
        graphicsdict /currgstate get exch /tintcomps exch put
        end
    }
>> put

%   pattern  setpattern  -
%   comp1..compn pattern  setpattern  -
% shorthand for entering the pattern colour space and setting the
% pattern as the colour; an uncoloured pattern takes the current
% colour space as its underlying space, with the components beneath
% The components beneath vary with the underlying space, so the
% pattern itself is the operand stated.
/setpattern [ /dicttype ] {
    % a pattern dictionary, which is one that has been through
    % makepattern. The same question makepattern asked, asked the same
    % way: this operator is reached with dictionaries that never went
    % through it, and one of those must be refused for the reason it is
    % wrong rather than for whichever entry a later site happened to want
    dup /setpattern /typecheck //.xpostsys /.patterntype get exec pop
    dup /PaintType 2 copy known { get 2 eq }{ pop pop false } ifelse not {
        [ /Pattern ] setcolorspace
    }{
        % the underlying space is the current one -- or, when that is
        % already a pattern space, its own underlying space
        currentcolorspace
        dup //.xpostsys /.spaceispattern get exec {
            dup type /arraytype eq { dup length 1 gt }{ false } ifelse
                { 1 get }{ pop /DeviceGray } ifelse
        } if
        [ /Pattern 3 -1 roll ] setcolorspace
    } ifelse
    setcolor
} //.xpostsys /.defop get exec

% -  .ncomponents  n
% the number of colour components the current colour space takes: an
% Indexed colour is one index, a Separation one tint, a DeviceN one
% tint per named colorant.
%
% The body is left unbound at its definition and frozen by the lockdown's
% sweep instead. currentcolorspace is written in PostScript and is still a
% procedure while this file loads, so a bind here would substitute nothing
% for it and would make the array read-only, which is what stops a later
% sweep from finishing the job -- and the name would stay dynamic for the
% rest of the run, inside every operator reaching this helper.
currentglobal true setglobal
% The colour space families, and what kind of thing each one is.
%
% Every other statement about a space follows from its kind: a device
% space states its own component count, a CIE family states one and
% reduces to device RGB, an indexed space carries one index and reduces
% through its base, a tint space carries its tints and reduces through
% its alternative, and a pattern space carries a pattern. The kind is
% what the machinery is really asking whenever it tests a family name,
% and the tables below answer the rest.
%
% Written down as a table because a family that is only ever a name in
% an equality test cannot be enumerated. Four of these -- the indexed,
% the two tints and the pattern -- existed nowhere but in such tests,
% which is why nothing could ask whether they had all been considered,
% and why an uncoloured pattern over three of them was found broken one
% at a time. tests/check-colour-spaces.sh holds this table and the two
% below to each other, so a family cannot be in one and missing from
% another.
.xpostsys /.spacekinds <<
    /DeviceGray   /device
    /DeviceRGB    /device
    /DeviceCMYK   /device
    /CIEBasedA    /cie
    /CIEBasedABC  /cie
    /CIEBasedDEF  /cie
    /CIEBasedDEFG /cie
    /Indexed      /indexed
    /Separation   /tint
    /DeviceN      /tint
    /Pattern      /pattern
>> put

% space  .spacekind  /device|/cie|/indexed|/tint|/pattern|null
% The kind of a colour space, given as a bare family name or as an array
% carrying the family and its parameters. A space naming no known family
% answers null, which is what the validator refuses on.
.xpostsys /.spacekind {
    dup type /arraytype eq { 0 get } if
    dup type /nametype eq {
        //.xpostsys /.spacekinds get 1 index known {
            //.xpostsys /.spacekinds get exch get
        }{ pop null } ifelse
    }{ pop null } ifelse
} put

.xpostsys /.spacecomps <<
    /DeviceGray 1
    /DeviceRGB 3
    /DeviceCMYK 4
>> put
.xpostsys /.ciecomps <<
    /CIEBasedA 1
    /CIEBasedABC 3
    /CIEBasedDEF 3
    /CIEBasedDEFG 4
>> put
.xpostsys /.ncomponents {
    currentcolorspace //.xpostsys /.spacecomponents get exec
} put

% space  .spacecomponents  n
% How many components a colour in this space carries. An Indexed colour
% is one index and a Separation one tint whatever they reduce to; a
% DeviceN carries one per name; a CIE-based family and a device space
% each state their own count. The space may be a bare family name or an
% array carrying parameters, since both reach here.
%
% One count rather than one per caller. What a space costs in components
% decides how many numbers are read off the stack, how many are stored,
% and how many are handed to a device, so two callers counting
% differently is a colour read at one width and written at another.
.xpostsys /.spacecomponents {
    dup type /arraytype eq {
        dup 0 get /Indexed eq { pop 1 }{
        dup 0 get /Separation eq { pop 1 }{
        dup 0 get /DeviceN eq { 1 get length }{
        dup 0 get //.xpostsys /.ciecomps get exch known {
            0 get //.xpostsys /.ciecomps get exch get }{
        0 get //.xpostsys /.spacecomps get exch get
        } ifelse } ifelse } ifelse } ifelse
    }{
        //.xpostsys /.spacecomps get exch get
    } ifelse
} put

% space  .spaceispattern  bool
% Whether a colour space is a pattern space, asked of the space as the
% program gave it: a family name on its own, or an array carrying the
% family and its parameters. Both forms reach setcolorspace, so both
% have to be understood wherever the question is asked, and asking it
% two ways is how one site comes to understand a form another does not.
.xpostsys /.spaceispattern {
    dup type /arraytype eq { 0 get } if
    /Pattern eq
} put

% space  .spacenomarks  bool
% Whether a colour set in this space can produce visible output at all.
%
% PLRM 4.8.5 gives the colorant name None exactly this meaning: painting
% in a Separation space named None "has no effect on the current page",
% and the space ignores its alternative space and tint transform. So the
% answer follows from the space and nothing else -- not from the tint, and
% not from what the transform would have returned, which is the reason
% this can be settled once when the space is set. The name arrives as a
% name or as a string, because PLRM 4.8.5 admits either.
%
% The sibling special name All is NOT this: it paints in every available
% colorant, which is the opposite of painting in none.
.xpostsys /.spacenomarks {
    dup type /arraytype eq {
        dup length 2 ge {
            dup 0 get /Separation eq {
                1 get
                dup type /stringtype eq { cvn } if
                /None eq
            }{ pop false } ifelse
        }{ pop false } ifelse
    }{ pop false } ifelse
} put

% space  .spacereduce  space
% Walk a colour space down to the one a colour in it is finally recorded
% in: an Indexed space through its base, a Separation or DeviceN through
% its alternative, a CIE-based family to device RGB. A space that reduces
% to nothing is handed back as it stands, and so is anything that is not
% an array.
%
% One walk rather than one per caller. setcolorspace reduces to decide
% what the graphics state records a colour in, and the validator reduces
% to decide what it is validating; the two asking differently would be a
% space accepted as one thing and recorded as another, which no program
% could see until it used that space.
.xpostsys /.spacereduce {
    % A colour space reaches its device space in as many steps as it
    % nests, which is a handful; a space that reaches itself would reduce
    % forever. Count the steps and refuse a space that has not reduced in
    % far more than any real space nests -- it names itself -- rather than
    % follow the cycle with no end and no allocation to trip a limit. The
    % count rides under the space on the stack and is dropped at either
    % exit, so a caller sees only the space it passed reduced.
    256 exch
    {
        exch 1 sub dup 0 lt
            { pop /setcolorspace cvx /typecheck signalerror } if
        exch
        dup type /arraytype ne { exch pop exit } if
        dup 0 get /Indexed eq { 1 get }{
        dup 0 get dup /Separation eq exch /DeviceN eq or {
            2 get
        }{
        //.xpostsys /.ciefams get 1 index 0 get known {
            pop /DeviceRGB
        }{
            exch pop exit
        } ifelse } ifelse } ifelse
    } loop
} put

% space  .csvalidate  -
% walk a colour space down to the device space a colour in it is finally
% recorded in, without touching the graphics state: an Indexed space
% reduces through its base, a Separation or DeviceN through its
% alternative, and a CIE-based family to device RGB. A family none of
% those knows is undefined
.xpostsys /.csvalidate {
    1 dict begin
    /sp exch def
    sp //.xpostsys /.spaceispattern get exec {
        % a pattern space carries the space its uncoloured cells paint
        % with as a second element, when it carries one at all
        sp type /arraytype eq {
            sp length 1 gt { sp 1 get //.xpostsys /.csvalidate get exec } if
        } if
    }{
        % a tint space reaches its alternative space by calling a
        % procedure the program supplied (PLRM 4.8.5), so a fourth
        % element that cannot be called is not a tint transform and the
        % array is not a colour space. The refusal is here because this
        % is the last moment the operator that supplied it is still the
        % one the program named; called later, the failure would be
        % reported against whichever painting operator reached it.
        %
        % The two special colorant names do not exempt it. A Separation
        % named All or None ignores its alternative space and transform,
        % and PLRM still requires dummy values to be provided; a dummy
        % of a kind that could never be called is not one, and admitting
        % it here would admit it for every colorant name alike.
        sp //.xpostsys /.spacekind get exec /tint eq {
            sp length 4 lt
                { /setcolorspace cvx /typecheck signalerror } if
            sp 3 get
            dup type dup /arraytype eq exch /packedarraytype eq or
            exch xcheck and not
                { /setcolorspace cvx /typecheck signalerror } if
        } if
        /sp sp //.xpostsys /.spacereduce get exec def
        % an array still standing here names a family nothing reduced
        sp type /arraytype eq { /sp sp 0 get def } if
        sp type /nametype ne
            { /setcolorspace cvx /typecheck signalerror } if
        //.xpostsys /.spacecomps get sp known not
            { /setcolorspace cvx /undefined signalerror } if
    } ifelse
    end
} put
setglobal
% The component count follows the current colour space, so the operand
% stated is the topmost one: a component, or the pattern of a pattern
% space, or the null object a pattern space holds before a pattern is
% set.
/setcolor [ [ /numbertype ] [ /dicttype ] [ /nulltype ] ] {
    currentcolorspace
    % PLRM 4.9.1: the colour value in a Pattern space is a null object,
    % treated as an empty tiling pattern, and a program may set that
    % value itself. No other family gives null a meaning, so the operand
    % statement admits it for all of them and it is narrowed here, in the
    % operator that knows which space is current. Refusing it in the
    % family's own arm instead would report the fault as a component of
    % the wrong type, which is a different mistake.
    1 index type /nulltype eq {
        dup //.xpostsys /.spaceispattern get exec not
            { /setcolor cvx /typecheck signalerror } if
    } if
    dup //.xpostsys /.spacekind get exec /indexed eq {
        % [/Indexed base hival lookup] index setcolor: the index names a
        % palette entry, resolved and set in the base space. A real index
        % is the nearest whole number to it and an index outside 0 to
        % hival is the nearer of those two bounds (PLRM 4.8.4); the
        % rounding and the clipping are both done before the integer is
        % taken, so an index with no integer in it still names an entry
        exch round
        dup 0 lt { pop 0 } if
        1 index 2 get 1 index lt { pop dup 2 get } if
        cvi
        1 array astore
        //.xpostsys /.idxconv get //.xpostsys /.withspace get exec
    }{
    dup //.xpostsys /.spacekind get exec /tint eq
    {
        % [/Separation name alt tint] or [/DeviceN names alt tint]: the
        % tints convert through the transform into the alternative space
        dup 0 get /Separation eq { pop 1 }{ 1 get length } ifelse
        array astore
        //.xpostsys /.tintsclamp get exec
        currentcolorspace exch
        //.xpostsys /.sepconv get //.xpostsys /.withspace get exec
    } {
    dup //.xpostsys /.spacekind get exec /cie eq
    {
        % a CIE-based colour: the family pipeline runs it down to device
        % RGB, which is a different component count in every family but ABC
        pop //.xpostsys /.ncomponents get exec
        array astore
        currentcolorspace exch
        1 index exch
        //.xpostsys /.cieclampcomps get exec
        //.xpostsys /.cieconv get //.xpostsys /.withspace get exec
    }{
        % a pattern space arrives as an array: dispatch on the family
        dup type /arraytype eq { 0 get } if
        //.xpostsys /setcolordict get exch get exec
    } ifelse
    } ifelse
    } ifelse
} //.xpostsys /.defop get exec

% -  .csinitcolor  -
% Set the colour the current colour space is entered holding. Every
% space has one and setcolorspace installs it (PLRM 8.2): black in a
% device space, which in DeviceCMYK is three zeros and a one; a tint of
% 1.0 in a Separation and in every component of a DeviceN (PLRM 4.8.4);
% index zero in an Indexed space; and zero in each component of a
% CIE-based space, moved to the nearest value the space's own Range
% declares valid where zero is not one (PLRM 4.8.3). A Pattern space is
% entered holding a null object, which paints nothing (PLRM 4.9).
%
% The colour is resolved here rather than left for the first setcolor.
% What a space carries a colour through -- a tint transform, a palette
% lookup, a CIE pipeline -- decides both what the page is painted in and
% what currentcolor answers, and a space entered and painted in without
% a setcolor has to paint the colour it was entered holding.
% The space and its family ride the operand stack rather than a
% dictionary of this procedure's own: the colour goes through the
% program's tint transform, palette procedure or decoding procedure on
% its way in, and a procedure of the program's runs against the
% program's dictionaries and defines into them.
.xpostsys /.csinitcolor {
    currentcolorspace
    dup //.xpostsys /.spacekind get exec
    dup /pattern eq {
        % the null pattern, which is what currentcolor answers with
        % until a pattern is set. Set through setcolor like every other
        % family's entry colour, so the state a Pattern space is entered
        % holding is written in one place and is by construction the
        % state a program reaches by setting null itself
        pop pop
        null //setcolor exec
    }{
    dup /indexed eq {
        pop pop 0 //setcolor exec
    }{
    dup /tint eq {
        % a Separation enters at full tint, a DeviceN at full in each of
        % its names, so the count comes from the space rather than the
        % kind
        pop dup 0 get /Separation eq
            { pop 1.0 }{ 1 get length { 1.0 } repeat } ifelse
        //setcolor exec
    }{
    dup /cie eq {
        % the space itself is kept: clamping a CIE colour needs the
        % range its space declares
        pop
        [ //.xpostsys /.ncomponents get exec { 0.0 } repeat ]
        //.xpostsys /.cieclampcomps get exec
        aload pop //setcolor exec
    }{
        pop
        dup type /arraytype eq { 0 get } if
        dup /DeviceCMYK eq { pop 0.0 0.0 0.0 1.0 }{
        /DeviceRGB eq { 0.0 0.0 0.0 }{
        0.0 } ifelse } ifelse
        //setcolor exec
    } ifelse } ifelse } ifelse } ifelse
} put

.xpostsys /currentcolordict <<
    /DeviceGray /currentgray cvx
    /DeviceRGB /currentrgbcolor cvx
    /DeviceCMYK /currentcmykcolor cvx
    % a device with the /Process native space takes each paint in the
    % space it was set in: deliver the current colour unconverted (one
    % grey component, three RGB or four CMYK)
    /Process /currentcolor cvx
>> put
/currentcolor [ ] {
    % a colour whose space records its components elsewhere than it
    % takes them -- Separation, DeviceN, Indexed, any CIE-based family --
    % reads back as the components it was set with, which setcolor put
    % aside; everything else delivers the recorded components, keyed by
    % the space they are recorded in
    graphicsdict /currgstate get /tintcomps get type /arraytype eq {
        graphicsdict /currgstate get /tintcomps get aload pop
    }{
        //.xpostsys /currentcolordict get graphicsdict /currgstate get /colorspace get get exec
    } ifelse
} //.xpostsys /.defop get exec

currentglobal true setglobal
.xpostsys /.min { % x y  . x (if x < y)
        %        y (otherwise)
    2 copy gt{exch}if pop
} bind put
setglobal
% component  .c01  real in [0,1]
% a colour component is clamped to the unit range (PLRM: values outside
% 0 to 1 are adjusted to the nearest valid value). A pure global helper, so it
% lives in .xpostsys beside .min and the colour conversions that freeze it in.
currentglobal true setglobal
.xpostsys /.c01 {
    cvr dup 0.0 lt { pop 0.0 } if dup 1.0 gt { pop 1.0 } if
} bind put
setglobal

.xpostsys /ColorConversion << % <</dest <</source {source-to-dest conversion}>> >>
    /DeviceGray <<
        /DeviceGray {
            graphicsdict /currgstate get /colorcomp1 get
        } bind
        /DeviceRGB {
            graphicsdict /currgstate get /colorcomp1 get
            .3 mul
            graphicsdict /currgstate get /colorcomp2 get
            .59 mul add
            graphicsdict /currgstate get /colorcomp3 get
            .11 mul add
        } bind
        /DeviceCMYK {
            1
            graphicsdict /currgstate get /colorcomp1 get
            .3 mul
            graphicsdict /currgstate get /colorcomp2 get
            .59 mul add
            graphicsdict /currgstate get /colorcomp3 get
            .11 mul add
            graphicsdict /currgstate get /colorcomp4 get
            add
            1 //.xpostsys /.min get exec sub
        } bind
    >>
    /DeviceRGB <<
        /DeviceGray {
            graphicsdict /currgstate get /colorcomp1 get
            dup
            dup
        } bind
        /DeviceRGB {
            graphicsdict /currgstate get /colorcomp1 get
            graphicsdict /currgstate get /colorcomp2 get
            graphicsdict /currgstate get /colorcomp3 get
        } bind
        /DeviceCMYK {
            graphicsdict /currgstate get /colorcomp4 get % k
            1 graphicsdict /currgstate get /colorcomp1 get % k 1 c
            2 index add 1 //.xpostsys /.min get exec sub % k 1-min(1,c+k)
            1 graphicsdict /currgstate get /colorcomp2 get % k R 1 m
            3 index add 1 //.xpostsys /.min get exec sub % k R 1-min(1,m+k)
            1 graphicsdict /currgstate get /colorcomp3 get % k R G 1 y
            5 4 roll add 1 //.xpostsys /.min get exec sub % R G 1-min(1,y+k)
        } bind
    >>
    /DeviceCMYK <<
        /DeviceGray {
            0
            0
            0
            1 graphicsdict /currgstate get /colorcomp1 get sub
        } bind
        /DeviceRGB {
            % full black generation and undercolor removal: the common
            % component moves entirely into the black channel, so black
            % separates as pure K rather than four inks
            1 graphicsdict /currgstate get /colorcomp1 get sub
            1 graphicsdict /currgstate get /colorcomp2 get sub //.xpostsys /.min get exec
            1 graphicsdict /currgstate get /colorcomp3 get sub //.xpostsys /.min get exec  % k
            dup dup dup                                              % k k k k
            1 graphicsdict /currgstate get /colorcomp1 get sub exch sub % k k k c'
            4 1 roll                                                 % c' k k k
            1 graphicsdict /currgstate get /colorcomp2 get sub exch sub % c' k k m'
            3 1 roll                                                 % c' m' k k
            1 graphicsdict /currgstate get /colorcomp3 get sub exch sub % c' m' k y'
            exch                                                     % c' m' y' k
        } bind
        /DeviceCMYK {
            graphicsdict /currgstate get /colorcomp1 get
            graphicsdict /currgstate get /colorcomp2 get
            graphicsdict /currgstate get /colorcomp3 get
            graphicsdict /currgstate get /colorcomp4 get
        } bind
    >>
>> put

/setgray [ /numbertype ] {
    graphicsdict /currgstate get /setspace /DeviceGray put
    graphicsdict /currgstate get /colorspace /DeviceGray put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} //.xpostsys /.defop get exec

/currentgray [ ] {
    //.xpostsys /ColorConversion get /DeviceGray get
        graphicsdict /currgstate get /colorspace get
        get exec
} //.xpostsys /.defop get exec

/setrgbcolor [ /numbertype /numbertype /numbertype ] {
    graphicsdict /currgstate get /setspace /DeviceRGB put
    graphicsdict /currgstate get /colorspace /DeviceRGB put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp3 exch put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp2 exch put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} //.xpostsys /.defop get exec

/currentrgbcolor [ ] {
    //.xpostsys /ColorConversion get /DeviceRGB get
        graphicsdict /currgstate get /colorspace get
        get exec
} //.xpostsys /.defop get exec

% hue saturation brightness  sethsbcolor  -
% the components are recorded in RGB, converted with the usual
% hexcone model (hue scaled to a sector 0-5; the sector's fractional
% part blends between the derived p, q and t values). Each component is
% clamped to [0,1] first, as the reference interpreters clamp hue rather
% than wrap it.
/sethsbcolor [ /numbertype /numbertype /numbertype ] {
    3 { //.xpostsys /.c01 get exec 3 1 roll } repeat
    7 dict begin
    {/b /s /h}{exch def}forall
    /h h h truncate sub 6 mul def       % scale hue to sector 0-5 (1 maps to 0)
    /i h truncate cvi def
    /f h i sub def
    /p b 1 s sub mul def
    /q b 1 s f mul sub mul def
    /t b 1 s 1 f sub mul sub mul def
    i 0 eq { b t p }{
    i 1 eq { q b p }{
    i 2 eq { p b t }{
    i 3 eq { p q b }{
    i 4 eq { t p b }{
             b p q } ifelse } ifelse } ifelse } ifelse } ifelse
    end
    setrgbcolor
} //.xpostsys /.defop get exec

/currenthsbcolor [ ] {
    currentrgbcolor
    3 dict begin
    {/b /g /r}{exch def}forall
    /v r g 2 copy lt {exch} if pop b 2 copy lt {exch} if pop def
    /d v r g 2 copy gt {exch} if pop b 2 copy gt {exch} if pop sub def
    d 0 eq {
        0.0 0.0 v
    }{
        v r eq { g b sub d div 6 add
        }{ v g eq { b r sub d div 2 add
        }{ r g sub d div 4 add } ifelse } ifelse
        6 div dup truncate sub          % hue
        d v div                         % saturation
        v                               % brightness
    } ifelse
    end
} //.xpostsys /.defop get exec

/setcmykcolor [ /numbertype /numbertype /numbertype /numbertype ] {
    graphicsdict /currgstate get /setspace /DeviceCMYK put
    graphicsdict /currgstate get /colorspace /DeviceCMYK put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp4 exch put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp3 exch put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp2 exch put
    graphicsdict /currgstate get exch //.xpostsys /.c01 get exec /colorcomp1 exch put
    graphicsdict /currgstate get /sepindex null put
} //.xpostsys /.defop get exec

/currentcmykcolor [ ] {
    //.xpostsys /ColorConversion get /DeviceCMYK get
        graphicsdict /currgstate get /colorspace get
        get exec
} //.xpostsys /.defop get exec

% Custom-colour convenience operators. A custom colour is a named spot ink
% with a device fallback: findcmykcustomcolor and findrgbcustomcolor package
% the fallback components with the name, and setcustomcolor enters the
% Separation colour space (PLRM 4.8.4) whose alternate is that fallback and
% whose tint transform scales the fallback by the tint. Because it is
% shorthand over the Separation space, a separation-preserving device
% receives the named colorant and a composite device reduces through the
% alternate. The packaged object is [c m y k name] for CMYK and [r g b name]
% for RGB, told apart by length. The tint transform bakes the components in,
% mapping a tint t to [ct mt yt kt] (or [rt gt bt]), so the space carries its
% own reduction.

% obj  .customcolorspace  [/Separation name alt {transform}] : the Separation
% space a custom-colour object is shorthand for. setcustomcolor and
% customcolorimage share it so the object is unpacked one way only.
.xpostsys /.customcolorspace {
    dup length 5 eq {
        aload pop                               % c m y k name
        6 dict begin
        /nm exch def /kk exch def /yy exch def /mm exch def /cc exch def
        [ /Separation /nm load /DeviceCMYK
          [ /dup load cc /mul load /exch load
            /dup load mm /mul load /exch load
            /dup load yy /mul load /exch load
                      kk /mul load ] cvx ]
        end
    }{
        dup length 4 eq {
            aload pop                           % r g b name
            5 dict begin
            /nm exch def /bb exch def /gg exch def /rr exch def
            [ /Separation /nm load /DeviceRGB
              [ /dup load rr /mul load /exch load
                /dup load gg /mul load /exch load
                          bb /mul load ] cvx ]
            end
        }{
            pop /setcustomcolor cvx /rangecheck signalerror
        } ifelse
    } ifelse
} put

/findcmykcustomcolor [ /numbertype /numbertype /numbertype /numbertype /stringtype ] {
    5 array astore
} //.xpostsys /.defop get exec

/findrgbcustomcolor [ /numbertype /numbertype /numbertype /stringtype ] {
    4 array astore
} //.xpostsys /.defop get exec

/setcustomcolor [ /arraytype /numbertype ] {
    exch                                        % tint obj
    //.xpostsys /.customcolorspace get exec setcolorspace
    setcolor                                    % tint setcolor
} //.xpostsys /.defop get exec

% A custom-colour image paints a one-channel picture in the custom colour:
% its samples are read as coverage, a dark sample laying down the full
% colorant and a light one leaving the page, so the decode runs 1 to 0. The
% object comes last, over the same operands image takes; the space it
% installs is undone afterwards.
/customcolorimage [ ] {
    % w h bits matrix datasrc obj -- resolve the object's space first, before
    % any begin or gsave, so a malformed object leaves nothing to unwind.
    //.xpostsys /.customcolorspace get exec        % ... space
    6 dict begin
    /.sp exch def /.src exch def /.mtx exch def
    /.bits exch def /.h exch def /.w exch def
    gsave
    .sp setcolorspace
    << /ImageType 1 /Width .w /Height .h /BitsPerComponent .bits
       /Decode [ 1 0 ] /ImageMatrix .mtx /DataSource /.src load >> image
    grestore
    end
} //.xpostsys /.defop get exec

% A separation image paints a one-channel picture in the current colour
% space, its samples read straight as the single tint (decode 0 to 1). Unlike
% the one-operand image form it honours a Separation or DeviceN space rather
% than reading the samples as grey.
/separationimage [ ] {
    5 dict begin
    /.src exch def /.mtx exch def
    /.bits exch def /.h exch def /.w exch def
    << /ImageType 1 /Width .w /Height .h /BitsPerComponent .bits
       /Decode [ 0 1 ] /ImageMatrix .mtx /DataSource /.src load >> image
    end
} //.xpostsys /.defop get exec

% setcolordict and currentcolordict dispatch a device colour through the
% operator named for its space. A program may redefine setgray/setrgbcolor/
% setcmykcolor (and the current* readers) -- a common trick for remapping the
% colours a document paints -- and where such a redefinition re-enters the colour
% machinery (as casselman ch8's setrgbcolor does, mapping RGB back into a DeviceN
% space) the internal reduction of an Indexed, Separation or DeviceN colour loops
% until the exec stack overflows. `bind` freezes the operator names in a procedure
% body, but not names held as data in a dispatch dictionary; so capture the real
% operators here by value, before any redefinition, the way font.ps does for show
% and setfont. The internal reduction then always reaches the real operators,
% while a program's own set*/current* calls still see its redefinition.
.xpostsys /setcolordict get
    dup /DeviceGray  /setgray      load put
    dup /DeviceRGB   /setrgbcolor   load put
        /DeviceCMYK  /setcmykcolor  load put
.xpostsys /currentcolordict get
    dup /DeviceGray  /currentgray      load put
    dup /DeviceRGB   /currentrgbcolor   load put
    dup /DeviceCMYK  /currentcmykcolor  load put
    % a /Process-native device takes each paint in the space its components
    % were recorded in. That is the marking pipeline's fetch, not the public
    % currentcolor: a Separation or DeviceN paint must deliver the RECORDED
    % tint-transformed components here, where currentcolor reads back the
    % tints the colour was set with
    /Process {
        //.xpostsys /currentcolordict get
        graphicsdict /currgstate get /colorspace get get exec
    } bind put

//.internaldict /QUIET known { }{ (eof color\n)print } ifelse
