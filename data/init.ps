%!PS
%
% init.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Interpreter start-up, run before systemdict is sealed; builds the systemdict procedures.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  ---- how the interpreter comes up -----------------------------------
%
%  xpost_interpreter.c reads this file as a context is created, and what
%  it does is build the language. Reading it top to bottom is reading
%  the boot; it runs in this order.
%
%  systemdict is opened and the bank set to global. Everything the
%  language is made of belongs to the interpreter rather than to any one
%  job, so it is allocated where a job's restore cannot reach it. The
%  bank stays global until the handover at the foot of the file.
%
%  The private namespaces come first, because everything after them is
%  filed in one: .xpostsys for the global machinery, privatedict for the
%  local kind, .internaldict for the C operators that are not part of
%  the language a program sees, and .gscratch for the state a render
%  mutates. Each is described where it is made.
%
%  .defopin and .defop follow. They define an operator together with the
%  operand shapes it takes, so a wrong operand is refused by the
%  definition rather than by the body, and every operator below is
%  defined through them.
%
%  Then the parts a program reaches, in the order they come to depend on
%  each other: statusdict and serverdict; the Level 2 shared-VM aliases,
%  which are this interpreter's global VM under its other name; err.ps,
%  because nothing after it can refuse properly without the error
%  machinery; the printing family (=, ==, stack, pstack) and the
%  execution dictionary; the job procedures a host calls to run one
%  (start, startstdin, startfilename, startfile, and the no-graphics
%  variants of each); and the page-device and system parameter
%  operators.
%
%  Where the build has display PostScript, .dpsenabled is true and the
%  context operators are defined next -- locks, conditions, notify,
%  monitor and wait. A build without it defines none of them, and the
%  names are simply absent.
%
%  The font directories, then resource.ps for the resource machinery,
%  then findfont, which reaches through both. qsort.ps comes in beside
%  them, for the one caller that sorts.
%
%  The remaining operators that need no graphics: user objects, forms,
%  user paths, and the rectangle operators.
%
%  .loadgraphics, which reads callout.ps and everything under it. It is
%  a PROCEDURE and not a call: graphics is loaded on demand, so a run
%  that never paints never pays for it and a run that does pays once.
%
%  .finalize, the lockdown. It promotes the procedure-implemented
%  operators to real operators, binds what is left, moves the private C
%  operators out of systemdict into .internaldict, and seals what a
%  program may not change. A procedure too, run after loadgraphics.
%
%  The handover: the bank goes local, which is where a program's own
%  allocations belong, and the interactive helpers are defined. prepr.ps
%  is read last, because the prompt is the last thing needed.
%
%  ---------------------------------------------------------------------
%

%
%  QUIET is a job convention, not machinery state: real-world job streams
%  execute it as a bare name -- tests/corpus/ghostscript/waterfal.ps reads
%  `QUIET not { ... } if` -- so it must resolve by ordinary dictionary
%  lookup, and a definition of it (-q writes systemdict, a -D definition
%  lands in userdict) is deliberately left where a program's lookup finds
%  it. The probe honours the same convention.
%
/QUIET where { pop }{ (loading init.ps...\n) print } ifelse

%
%  The namespace is made before the first begin, so the wrapper below can
%  open at the depth this file starts from. Nothing it does afterwards pops
%  past that depth, so one region covers the whole file.
%
currentglobal true setglobal
userdict /.xpostsys 400 dict put
setglobal

%
%  The job store: the machinery's writable state, all of it, in one place.
%
%  Two lifetimes are enforced and only two. Local virtual memory is taken
%  back by a restore and again at the job boundary; global memory only at
%  the boundary. So state a restore must NOT take back -- the page a job
%  has reached, the advance a glyph declared -- is global, and lives here.
%  State a restore SHOULD take back is a render's, and lives in .gscratch.
%
%  Keeping it together is what makes the rest sayable: the namespaces the
%  machinery's procedures and constants live in hold nothing writable, and
%  the lockdown is told about this one dictionary instead of about each
%  thing inside it. A writable object anywhere else is then a mistake
%  rather than a decision, which is a question a test can ask.
%
currentglobal true setglobal
16 dict .setjobstore
setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys below

systemdict begin  % Make these definitions in systemdict
true setglobal   % Systemdict is global, so these allocations must be global

%
%  .xpostsys -- the interpreter's private namespace. Internal helper procedures
%  and their static tables live here, out of the names a program may use; only
%  the dotted anchor name is visible and the helpers hide behind it. A GLOBAL
%  dictionary anchored in userdict, sealed read-only and dropped from userdict at
%  lockdown; its mutable per-render state lives in .gscratch instead. It is global
%  so a global systemdict procedure may freeze a // reference to it (a global
%  object may not reference a local one); local machinery lives in privatedict.
%
%  Naming -- what a member holds is read off its name. A procedure is dotted, as
%  are most of the static tables the procedures read; a name that is not dotted
%  ends in Dict and carries a dictionary. The interpreter's flags are neither and
%  live elsewhere again: those are UPPER_CASE members of .internaldict.
%  tests/check-dict-homes.sh holds this dictionary to the rule, so a member
%  arrives under the name its value asks for rather than acquiring one later.
%
%  Convention -- a helper .h is reached through a frozen // reference, in either of
%  two forms:
%      .xpostsys /.h { ... } put       ...  //.xpostsys /.h get exec  % define, call
%      .xpostsys begin /.h { ... } def ...  //.h exec ... end         % define, bake
%  The // freezes the dictionary (get form) or the helper object itself (baked
%  form) into the caller at scan time, so a program cannot shadow it. The get form
%  resolves .h at run time, which mutual recursion and forward references need;
%  baking costs no run-time lookup but cannot express them.
%
%  A file bakes by opening this dictionary for the whole of its own reading:
%      currentdict .xpostsys begin begin   ...   end end
%  The current dictionary goes back on top of it because .defop defines into
%  whatever is current, and a module's operators belong in systemdict rather than
%  among the helpers; this dictionary is still searched one below, which is all
%  the // needs. A file opening it says so in one line and points here.
%
%  What a file cannot bake it leaves in the get form. There are five such cases:
%  a name a later module defines, a name defined only once every module has
%  loaded, a helper's calls to itself -- the put that closes a body is what
%  defines its name, so while that body is being read the name is not there yet
%  -- a helper whose value is an operator rather than a procedure, since // puts
%  the object in the body where an operator runs and a get hands it over as data,
%  and a helper a test redefines by appending to the data tree, which a baked
%  reference cannot see.
%
%  No helper is bound where it is defined. A body bound there is read-only before
%  the standard operators are promoted, so every name it calls stays a name for
%  the rest of the run, reachable by a program redefining it, and the lockdown
%  sweep cannot come back for a read-only body. .finalize binds this dictionary
%  once the promotion is done, which is the only point at which binding
%  substitutes anything. tests/check-helper-bind.sh holds the tree to it.
%

%
%  Recorded in the context as well, where the collector roots it and the C
%  reaches it. The anchor below is dropped at lockdown and what holds the
%  namespace afterwards is the references frozen into procedure bodies, which
%  no C code has; the caches C keeps here must be reachable from both sides.
%
userdict /.xpostsys get .setglobalprivatedict

%
%  .hostdict -- what this run's host settles, and nothing else.
%
%  The dictionaries around it hold the language: the same names with the
%  same values however the interpreter was started. A few values are not
%  like that -- the directory the boot files were found in, the
%  directories a resource search covers, whether there is a user at the
%  other end of standard input -- and they are decided afresh on every
%  launch by the command line, the environment, the caller, or the state
%  of the process. Keeping them here and nowhere else is what makes
%  "is this the same for every run of this build?" a question about which
%  dictionary a name is in, rather than one about what the name means.
%
%  Every member is written by the host (xpost_interpreter.c,
%  _record_host_config and _record_session_kind), from the one table
%  there, once the language is in place; a setting the host has nothing
%  to say about is written as a null rather than left out. So nothing a
%  run reads here was settled by anything but this run.
%
%  Global, with the namespace holding it. A setting is made before the
%  program runs and read for the whole life of the context, so it has to
%  outlive the restores that end a job; local memory would revert it with
%  whichever job happened to be running.
%
.jobstore /.hostdict 16 dict put

%
%  What the host settled for this run under key. Every setting a run has
%  is written before a program runs, so a key that is not here is one no
%  run settles: the caller is asking for something that was never a
%  setting, and is told so where it asked instead of carrying a null off
%  somewhere else. A setting the host said nothing about answers null,
%  which is a value and reads as one.
%
.xpostsys /.hostvalue {  % /key  .  value
    //.hostdict exch 2 copy known
        { get }
        { exch pop cvx /undefined signalerror }
    ifelse
} put

%
%  The operands each operator takes. The definitions fill this through
%  .defop, so the statement sits beside the body it describes; lockdown
%  reads it when it wraps them.
%
.jobstore /.opsigs 200 dict put

%
%  A forked context runs its top-level procedure through this, so an error the
%  procedure raises is reported by handleerror and ends the context rather than
%  unwinding into the interpreter with no stopped context to catch the stop.
%  op_fork leaves the procedure on the operand stack and pushes this above it
%  (PLRM 2nd ed 7.1: a forked procedure runs effectively as
%  `proc stopped { handleerror quit } if`). `currentcontext detach` plays the
%  role of that quit: after reporting the error the context detaches itself, so
%  when .childrun returns it terminates outright instead of waiting to be
%  joined, and a later join of it is invalidcontext -- as PLRM requires of a
%  context that ended on an error rather than running to a clean return. detach
%  of the current context is permitted, and it only marks the context to free
%  itself on return, so the error's stop has already unwound when it runs. The
%  names are late-bound, so this line parses when the context operators are
%  absent (a default run never forks, so .childrun never runs).
%
.xpostsys /.childrun { stopped { handleerror currentcontext detach } if } put  % proc  .  -

%
%  The operators whose bodies arrived already read-only. A body is bound
%  once the whole set has been promoted, which is the only moment at which
%  a call from one standard operator to another can be frozen; a body bound
%  at its definition is read-only by then, and bind ignores a read-only
%  array, so it keeps the names it was written with for the rest of the
%  run. Recording the name here rather than refusing on the spot is what
%  lets the whole set be reported at once, and what lets the check work in
%  the window before the error machinery is loaded. .finalize holds this
%  register to empty.
%
.jobstore /.boundatdef 32 dict put

%
%  Define an operator into a named dictionary and record the operands it
%  takes, in one place. The dictionary is a parameter because an operator
%  does not always belong to the one that happens to be current: the
%  shading and page-device operators are written inside a block that has
%  made a private namespace current so their helper references resolve as
%  they are read, and they still have to land in systemdict.
%
.xpostsys /.defopin {  % dict /name [ specs ] { proc }  .  -
    4 dict begin
    /d.proc exch def /d.sig exch def /d.name exch def /d.dict exch def

    % The statements are filed in a global dictionary, so a statement must
    % be global itself or the file is refused. Most are: a module is read
    % with global allocation in force. One written where the allocation is
    % local -- the page device operators are defined while the graphics
    % load runs, which is local throughout -- would otherwise have to know
    % that and say so, which is the sort of thing every caller gets wrong
    % once. Copy it instead, and only when it needs copying. The copy is
    % one level deep, which covers a statement naming its operand types
    % directly. A multi-shape statement written where allocation is local
    % would keep local arrays inside the copy and still be refused; none
    % is written that way, and the refusal says so if one ever is.
    d.sig gcheck not {
        currentglobal true setglobal
        d.sig dup length array copy /d.sig exch def
        setglobal
    } if
    //.opsigs d.name d.sig put
    /d.proc load wcheck not
        { //.boundatdef d.name true put } if
    d.dict d.name /d.proc load put
    end
} put

%
%  The same, into the dictionary the definition is being read in, which is
%  where an operator belongs unless something says otherwise.
%
.xpostsys /.defop {  % /name [ specs ] { proc }  .  -
    currentdict 4 1 roll
    //.defopin exec
} put

%
%  The callout boundary alone, for a caller that hands control to the
%  program part-way through a body of its own: a Type 3 glyph's build
%  procedure, a transfer function or spot function being sampled, a
%  colour space's conversion, a pattern's PaintProc, or the procedure
%  resourceforall runs over each instance. The bracket around such a body
%  is the caller's, and what it does about the graphics state and the
%  dictionary stack is the caller's business; only this much of it
%  belongs to the program.
%
%  So the boundary stands where the program's object runs and nowhere
%  else. What the caller does before and after -- reading what the
%  procedure returned, and refusing on it -- is the caller refusing, and
%  its operands come back. The object runs exactly as exec would run it,
%  and nothing of this sits on the operand stack while it does.
%
%  It is defined here, and not with the other three brackets in
%  callout.ps, because two of its callers are the language rather than
%  the graphics: the resource machinery runs a program's procedure over
%  every instance, and that has to work in a configuration that never
%  loads the graphics at all. A bracket reachable only when the graphics
%  are loaded would leave resourceforall raising undefined under
%  --no-graphics, which is exactly where nothing else would look for it.
%  Only the .coexec operator is baked in, so it depends on nothing this
%  file has not already built.
%
%  Fetched out of .xpostsys by cid.ps, color.ps, font.ps, gstate.ps,
%  halftone.ps, init.ps, path.ps and resource.ps, and running under the
%  dictionary stack its caller had: it opens no dictionary and closes
%  none.
%
.xpostsys /.pexec {  % obj  .  -
    { exec } //.coexec
} put

%
%  privatedict -- the interpreter's private LOCAL machinery dictionary. Recorded
%  in the context (where the collector roots it and C reaches it) but never placed
%  on the dict stack, so a program can neither name nor enumerate its members. It
%  is LOCAL because it holds local objects (the device class dictionaries, the
%  graphics scratch and template, the wrapped-operator anchor procedures) that a
%  global private dictionary may not hold. Reached from PostScript through the
%  .privatedict operator.
%
currentglobal false setglobal
256 dict .setprivatedict
setglobal

%
%  DATA_DIR, the directory this run found its boot files in, is handed in by the
%  bootstrap through userdict -- the only dictionary there is that early. Seed
%  the run's settings with it here, so the loader below can find the rest of the
%  modules, and drop the handover so it does not sit among the program's names.
%  The host writes it again, with everything else it settles, once the language
%  is in place; the copy is global because the settings are.
%
userdict /DATA_DIR known {
    //.hostdict /DATA_DIR userdict /DATA_DIR get dup length string copy put
    userdict /DATA_DIR undef
} if

%
%  .gscratch returns the local scratch dictionary the machinery mutates each
%  render (strokedict, caches, local resources); it is a LOCAL object the
%  collector reclaims. A bound reference to the operator resists shadowing.
%  Defined before any module loads.
%
%  The operator is public, so what this dictionary holds is what a program
%  may write: state and caches, and no procedure the machinery goes on to
%  execute. A procedure kept here would be the program's to replace, and
%  replacing it would put the program's own body inside a standard
%  operator. The machinery's procedures live in .xpostsys, which is sealed
%  and unnamed once the interpreter is locked down; the stroke switch is
%  there for that reason. What is written here is data, and it is written
%  in local virtual memory, so a restore and the end of the job take a
%  program's writes back.
%
currentglobal false setglobal

%
%  Both are local, and privatedict is the local dictionary the machinery
%  lives in, so they go there outright. The procedure takes the scratch
%  dictionary as a value: a // reference would have needed the name on the
%  dictionary stack, which is what forced the userdict anchor before. Only
%  the .gscratch operator that wraps it is a simple object fit for systemdict.
%
.privatedict /.gscratchdict 64 dict put
%
%  The procedure the .gscratch operator wraps: it answers the scratch
%  dictionary as a baked reference rather than by lookup, so nothing a
%  program defines can be reached instead.
%
.privatedict /.gscratchproc [ .privatedict /.gscratchdict get ] cvx put
/.gscratch dup .privatedict /.gscratchproc get .wrapop def
setglobal

%
%  The private C operators live under dot-prefixed names. Near the end of
%  graphics loading they are relocated out of systemdict into .internaldict, so
%  a program sees only the standard operators in systemdict while a font program
%  still reaches them through 1183615869 internaldict. The few operators fetched
%  by name during graphics loading are seeded here first, before that pass.
%  .rundied is seeded for the same reason from the other end: it records a
%  failure the caller is to see, and the failures it records include the
%  ones that stop graphics loading before the relocation pass is reached.
%
userdict /.internaldict 256 dict put

%  ...and the dictionary the PLRM operator answers with, which is NOT that
%  one. PLRM 8 says what a program may expect of internaldict: that its
%  contents are undocumented and change at any time, that it is referenced
%  only in special circumstances such as constructing a Type 1 font program,
%  and that some interpreters do not have the operator at all. None of that
%  entitles a program to a member, and holding the machinery's own working
%  dictionary there published every operator the machinery happened to need.
%  The machinery keeps its own, reached only through the //.internaldict
%  reference frozen into the bodies that use it.
%  A run asked to report on the interpreter is handed the machinery's own
%  dictionary here: its registers and tests ask for entry points a run has
%  no other use for, and the flag saying so arrives in systemdict from the
%  C before this file runs. Any other run is handed a dictionary holding
%  nothing, which is the whole of what PLRM 8 entitles a program to.
userdict /.plrminternaldict 8 dict put
systemdict /CENSUS known
    { userdict /.plrminternaldict userdict /.internaldict get put
      %  and out of systemdict at once: it is a fact about how the run was
      %  started, not a name the language has, and a program reading it
      %  would learn only that it is being measured. It is kept in the
      %  machinery's own dictionary, where the lockdown reads it again.
      userdict /.internaldict get /CENSUS true put
      systemdict /CENSUS undef } if
[ /.fillpoly /.fillrectgray /.fillrectrgb /.blendpixgray /.blendpixrgb
  /.pdfinit /.pdfput /.flatecompress /.vmreserve /.rundied ]
{ dup systemdict exch get .internaldict 3 1 roll put } forall

%
%  The guarded accessor by which a font program reaches the private
%  operators; the password is part of the language folklore.
%
/internaldict [ /integertype ] {  % int  .  dict
    1183615869 eq { //.plrminternaldict }{
        /internaldict cvx /invalidaccess signalerror
    } ifelse
} .defop

%
%  Debug aids and the internal context-state markers are C operators, not part of
%  the language, and must not sit in a program's lookup path. The machinery
%  operators above are moved out of systemdict by the lockdown step, once its
%  bind pass has frozen the procedures that use them; these are graphics-independent
%  and used by nothing, so they move into .internaldict here, during init, and are
%  hidden whether or not graphics is ever loaded.
%
1 dict begin
[ /dumpnames /dumpvm /debugloadon /debugloadoff /breakhere
  /_i_am_zombie_ /_i_am_free_ ]
{ /nm exch def
    systemdict nm known {
        .internaldict nm systemdict nm get put
        systemdict nm undef
    } if
} forall
end

%
%  QUIET, the -q startup flag, is handed in through systemdict by the C -- the
%  only dictionary that exists that early. It guards the interpreter's own
%  load-time progress messages and a program never needs it, so move it into
%  .internaldict now, before any banner guard runs. The guards below read it
%  through a frozen //.internaldict reference that no program can see or shadow.
%
systemdict /QUIET known
    { .internaldict /QUIET systemdict /QUIET get put systemdict /QUIET undef }
if

currentglobal false setglobal

%
%  statusdict holds device/product status a program may change, so it is a local
%  dictionary -- save and restore isolate a job's changes -- that systemdict names
%  (copyudtosd), like $error, errordict and userdict.
%
userdict /statusdict <<
    /manualfeed false
    /product (Xpost)
>> put
setglobal

%
%  The page-size convenience operators of the printer products, which
%  driver prologs invoke from their PPD feature blocks.
%
<<
    /letter      [ 612  792]
    /lettersmall [ 612  792]
    /note        [ 612  792]
    /legal       [ 612 1008]
    /ledger      [1224  792]
    /11x17       [ 792 1224]
    /a3          [ 842 1191]
    /a4          [ 595  842]
    /a4small     [ 595  842]
    /a5          [ 420  595]
    /b4          [ 728 1032]
    /b5          [ 516  729]
>> {
    1 dict dup /PageSize 4 -1 roll put
    /setpagedevice cvx 2 array astore cvx def
} forall

%
%  The job server's dictionary. exitserver ends the encapsulated job and
%  starts an unencapsulated one, so the definitions made after it outlive
%  the job -- the idiom every driver prolog uses. It is `true password
%  startjob`, which the interpreter answers by folding the run's state into
%  the baseline at its end (see xpost_run); on a wrong password it raises
%  invalidaccess. A successful exitserver announces that permanent state may
%  change and, because startjob has reset the dictionary stack to the job's
%  base depth, no longer stands with serverdict begun. serverdict is a local
%  dictionary named in systemdict.
%
currentglobal false setglobal
userdict /serverdict 2 dict put

%
%  End the encapsulated job a server started, so that what follows is
%  outside it and survives the job (PLRM 3.7.7). The password is the one
%  startjob was given.
%
%  The idiom is a prolog's: a job that wants its definitions to outlive
%  itself exits the server, defines them, and lets the next job find
%  them.
%
serverdict /exitserver {  % password  .  -
    true exch startjob not
    { /exitserver errordict /invalidaccess get exec }
    if
    $error /binary 2 copy known { get not }{ pop pop true } ifelse
    { (%%[ exitserver: permanent state may be changed ]%%\n) print flush } if
} put
setglobal

%
%  startjob is a C operator (xpost_op_save.c): it is registered into
%  systemdict before this file runs, so nothing is defined for it here.
%

%
%  The interpreter answers for the whole language
%
/languagelevel 3 def

%
%  The shared-VM view of global VM, one and the same here.
%
/setshared /setglobal load def
/currentshared /currentglobal load def
/scheck /gcheck load def
/shareddict globaldict def

%
%  Concatenate two strings -- a pure global helper, so it lives in .xpostsys
%
.xpostsys /.strcat {  % a b  .  ab
    2 copy
    length exch length exch 1 index add  % A b an bn+an
    string dup 0 6 -1 roll putinterval  % B an str
    dup 4 2 roll exch putinterval  % (ab)
} put

%
%  The three parts of a colour rendering dictionary's name, joined with
%  the separator PLRM 8.2 spells the name with. Each part may arrive as a
%  name or as a string and contributes its text either way, so the intent
%  goes in verbatim however the program supplied it.
%
.xpostsys /.crdname {  % intent deviceconfig halftone  .  name
    4 dict begin
    /astext { dup type /stringtype ne { dup length string cvs } if } bind def  % obj  .  string
    /ht exch astext def
    /dc exch astext def
    astext
    (.) //.strcat exec
    dc //.strcat exec
    (.) //.strcat exec
    ht //.strcat exec
    cvn
    end
} put

%
%  Take the page as the page device machinery measured it, where it has
%  been measured. A page is points and need not come to whole numbers of
%  them; a device whose marks carry a fraction says so by asking for the
%  exact extent here, and one whose page is rows of pixels has no use for
%  it and does not. Where nothing published an extent -- a device made
%  before any page device was installed -- the whole numbers the device
%  was created with are what it keeps.
%
%  /width and /height are written into the dictionary the caller is in,
%  which is the device being built: a procedure does not stand a
%  dictionary of its own between the two.
%
.xpostsys /.adoptexactpage {  % -  .  -
    graphicsdict /.exactpagedims 2 copy known {
        get
        dup 0 get /width exch def
        1 get /height exch def
    }{ pop pop } ifelse
} put

%
%  .loadmodule -- pull in one of the interpreter's own .ps files by name,
%  factoring the "(/x.ps) //.xpostsys /.loadmodule get exec" idiom that
%  appears throughout the machinery. In .xpostsys like every other
%  helper, and global with it.
%
.xpostsys /.loadmodule {  % (/name.ps)  .  -
    /DATA_DIR //.hostvalue exec
    exch //.strcat exec run
} put

%
%  Whether a dictionary key names a device class. A class is defined
%  under a name of one shape and nothing else in the dictionaries the
%  mirror and the lockdown walk carries it, so the shape is what says
%  which keys are classes and no list of them has to be kept anywhere.
%
%  What it reads is the spelling of a name, so it is about the language
%  rather than about graphics, and it lives here rather than beside the
%  device classes for that reason: the lockdown walks systemdict and asks
%  this of every key it finds, on a run that has loaded the device
%  classes and on one that has loaded no graphics at all. A predicate
%  reached only through a graphics module would answer the first and
%  raise on the second, taking the lockdown -- and with it every start
%  procedure -- down with it.
%
.xpostsys /.isclassname {  % key  .  bool
    dup type /nametype eq {
        60 string cvs dup length 7 ge {
            0 7 getinterval (.xpost_) eq
        }{ pop false } ifelse
    }{ pop false } ifelse
} put

%
%  The bind sweep the module loaders and the lockdown share. .bindone freezes
%  one value: bind substitutes an operator wherever a name in a procedure
%  currently resolves to one, so a program's later redefinition governs what
%  the program calls, never what the machinery calls; names holding procedures
%  or dictionaries stay dynamic, and non-procedures pass through untouched.
%  .bindscope descends nested dictionaries recursively, so a dispatch table
%  inside a dispatch table is covered structurally rather than by a remembered
%  per-procedure bind at its definition; the depth cap bounds the sweep on any
%  cyclic dictionary graph. Init-time helpers only -- nothing calls them while
%  a program runs.
%
.xpostsys /.bindone {  % value  .  -
    dup type /arraytype eq 1 index xcheck and { bind } if pop
} put

%
%  Bind every executable array a dictionary holds, and the ones the
%  dictionaries it holds hold, down to the depth given. The depth is
%  what stops the walk: a dictionary graph may be cyclic, and a walk
%  without a bound would not come back.
%
.xpostsys /.bindscoped {  % dict depth  .  -
    exch {
        exch pop
        dup type /dicttype eq {
            1 index 0 gt
            { 1 index 1 sub //.xpostsys /.bindscoped get exec }
            { pop }
            ifelse
        }{
            //.bindone exec
        } ifelse
    } forall
    pop
} put

%
%  Bind a dictionary's procedures to a depth deep enough for the tables
%  this interpreter nests -- device classes inside registries inside
%  systemdict -- and no deeper. The lockdown sweep calls it once per
%  dictionary it seals.
%
.xpostsys /.bindscope {  % dict  .  -
    8 //.bindscoped exec
} put

%
% Predefined in xpost_interpreter.c:setlocalconfig()
%
% /DATA_DIR
%     /PACKAGE_DATA_DIR dup where { %PACKAGE_DATA_DIR is passed from the config if is_installed is true
%         exch get
%     }{
%         pop
%         %EXE_DIR (/../../data) strcat
%         %(./data)  % if is_installed is false, and no PACKAGE_DATA_DIR is defined, look for ps data in CWD/data
%         false mark [
%             /WIN32 where { pop
%                 (../../../data) %visual_studio/vc10/Debug
%             } if
%             (data) %repo root
%             (../../data) %src/bin
%             (../../../data) %visual_studio/vc10/Debug
%         ]
%         {
%             {
%                 dup (/err.ps) strcat (r) file % false mark ... (DIR) file
%                 pop counttomark 2 add 1 roll cleartomark pop true mark % (DIR) true mark
%             } stopped not { exit } if
%         } forall
%         cleartomark
%         not { () } if % none of the above, try CWD
%     } ifelse
% def
%

%
% (EXE_DIR =) print EXE_DIR print (\n) print
%
//.internaldict /QUIET known { }{ (DATA_DIR =) print
    /DATA_DIR //.hostvalue exec print (\n) print } ifelse

%
%  Read and execute a file by name (PLRM 8.2). The file is executed
%  rather than merely read, so what it defines lands in whatever
%  dictionary is current when run is called.
%
/run [ /stringtype ] { (r) file cvx exec } .defop  % string  .  -

%
% (2\n)print
%
.jobstore /.=string 128 string put
.jobstore /.es1 1 string put
.jobstore /.es3 3 string put

%
%  The scratch string serves every cvs in the machinery: as an operator
%  pushing it, procedures binding as they load freeze the reference,
%  and a program may take the name for itself. Anchor the pusher procedure in
%  internaldict rather than systemdict so a program enumerating systemdict does
%  not see it; .wrapop freezes the procedure into the =string operator, and
%  internaldict keeps it alive thereafter.
%
%  Read-only: it is what the operator runs, and the string it hands back
%  is the one = and == format through. It lives in global virtual memory,
%  which a restore does not reach, so a body a program could write into
%  is one whose replacement would stand for the rest of the job.
.internaldict /.=stringproc [ //.=string ] cvx readonly put
/=string dup .internaldict /.=stringproc get .wrapop def

%
%  Print an object's value the way = does, without the newline: the
%  printing = and == are both built on this and on the type table below.
%
/=print {  % obj  .  -
    dup type /stringtype ne {
        //.=string cvs
    } if
    print
} bind def
/=only //=print def

%
% (3\n)print
%
/= [ /anytype ] {  % obj  .  -
    //=print exec
    (\n) print
} .defop

%
% dumpnames dumpvm
% debugloadon
%

%
% (/err.ps)
% (.) [ {
%     (XPOSTDIR) getenv %env
%     exch pop exch pop
% } stopped {cleartomark} if
% exch strcat Run
% (../../data)
%

%
% (4\n)print
%
(/err.ps) //.loadmodule exec

%
% (5\n)print
%
/stack [ ] { count dup 1 add copy //= repeat pop } .defop  % -  .  -

%
% (6\n)print
%
systemdict begin

%
%  ==
%
%
%  The counters a print is bounded by live apart from the procedures that
%  read them. A dictionary the machinery writes as it runs cannot be
%  sealed, and one holding what the machinery executes must be: a program
%  reaching an unsealed table could put its own procedure where == looks
%  one up. So ==dict holds procedures and nothing else, and the three
%  counters a single == spends are written here.
%
.jobstore /.==state 4 dict put
//.==state /cp 0 put
//.==state /depth 0 put
//.==state /spent 0 put

24 dict begin
/==dict currentdict def
    /rmargin 72 def
    /NL (\n) def

    /cvsprint {  % obj  .  -
        =string cvs tprint
    } def
    /tprint {  % string  .  -
        dup length //.==state /cp get add rmargin gt {
            NL print
            //.==state /cp 0 put
        } if
        dup length //.==state /cp get add //.==state exch /cp exch put
        print
    } def
    /typeprint {  % obj  .  -
        //.==state /spent 2 copy get 1 add put
        dup type exec
    } def

    % What one == may spend before it gives up on the rest: how deep it
    % descends, and how much printing it does. Each bounds a shape the
    % other does not. Depth bounds a structure that nests without end. It
    % does not bound one that branches, since every level re-expands
    % every branch, nor one that is merely wide, since a single array
    % costs as much to print as it is long -- so what is printed is
    % counted too, wherever in the descent it is reached. An object
    % counts as one and a string as its length, because a string prints a
    % byte at a time and a long one is the work of many objects. The
    % budget is far past what a program prints on purpose -- the widest
    % array and the longest string a narrow build can hold each print
    % whole inside it -- and past it an array prints abbreviated and an
    % element list stops short. That is what lets == of a structure
    % containing itself finish, which handleerror printing the operand
    % stack (data/err.ps) asks of it on an ordinary error. PLRM 8.2
    % leaves how == formats its output intentionally unspecified.
    /maxdepth 24 def
    /budget 65536 def
    /arraytype {  % array  .  -
        dup rcheck {
            //.==state /depth get maxdepth ge //.==state /spent get budget gt or {
                pop (-array-) tprint
            }{
                //.==state /depth 2 copy get 1 add put
                1 dict begin
                /first true def
                dup xcheck /isproc exch def
                isproc { ({) }{ ([) } ifelse tprint
                {
                    //.==state /spent get budget gt {
                        pop first not { ( ) tprint } if (...) tprint exit
                    } if
                    first { /first false def }{ ( ) tprint } ifelse typeprint
                } forall
                isproc { (}) }{ (]) } ifelse tprint
                end
                //.==state /depth 2 copy get 1 sub put
            } ifelse
        }{ pop (-array-) tprint } ifelse
    } def

    % A packed array prints as an array does: the delimiters follow its
    % executability and the elements print in turn
    /packedarraytype /arraytype load def
    { cvsprint }
    dup /booleantype exch def
    dup /integertype exch def
    /realtype exch def

    /invalidtype { pop (@INVALID@) tprint } def  % obj  .  -
    /nulltype { pop (null) tprint } def  % null  .  -
    /dicttype { pop (-dict-) tprint } def  % dict  .  -
    /filetype { pop (-file-) tprint } def  % file  .  -
    /marktype { pop (-mark-) tprint } def  % mark  .  -
    /fonttype { pop (-font-) tprint } def  % font  .  -
    /contexttype { pop (-context-) tprint } def  % context  .  -

    /nametype {  % name  .  -
        dup xcheck not {
            (/) tprint
        } if
        cvsprint
    } def

    /operatortype {  % operator  .  -
        (--) tprint
        =string cvs tprint
        (--) tprint
    } def

    /savetype {  % save  .  -
        pop (-savelevel-) tprint
    } def

    % Re-readable string escaping for ==: a byte becomes \\ \( \) for
    % those three, a named escape for the five control characters that
    % have one, its own character when printable, and \ddd octal
    % otherwise -- so the output scans back to the same string
    % The two the escaping writes a byte into, in the job store with the
    % rest of the machinery's writable state: a buffer kept beside the
    % procedures is a buffer that cannot be sealed with them.
    /.escbyte {  % byte  .  -
        dup 92 eq { pop (\\\\) print }{
        dup 40 eq { pop (\\\() print }{
        dup 41 eq { pop (\\\)) print }{
        dup 10 eq { pop (\\n) print }{
        dup 13 eq { pop (\\r) print }{
        dup  9 eq { pop (\\t) print }{
        dup  8 eq { pop (\\b) print }{
        dup 12 eq { pop (\\f) print }{
        dup 32 ge 1 index 127 lt and {
            //.es1 exch 0 exch put //.es1 print
        }{
            (\\) print
            dup 64 idiv 48 add //.es3 exch 0 exch put
            dup  8 idiv 8 mod 48 add //.es3 exch 1 exch put
            8 mod 48 add //.es3 exch 2 exch put
            //.es3 print
        } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse
    } def

    /stringtype {  % string  .  -
        dup rcheck {
            (\() tprint
            dup length //.==state /spent get add //.==state exch /spent exch put
            { .escbyte } forall
            (\)) print
        }{
            pop (-string- ) tprint
        } ifelse
    } def

    % The == machinery is the interpreter's own; a program redefining an
    % operator it uses (forall, type, exec, print, ...) must not have that
    % redefinition honoured when == or pstack or an error report runs. This
    % dict is anonymous, so the systemdict/userdict bind sweep never reaches
    % it: bind its procedures here, as =string already is, freezing every
    % operator name to the operator.
    currentdict .bindscope

%
%  Print an object in re-readable form without the newline -- strings
%  with their escapes, arrays with their brackets, an executable array
%  as a procedure -- so that what comes out could be read back in.
%
%  The budgets above are what make it safe on a structure that refers to
%  itself: a cyclic array printed without them is not slow, it does not
%  finish.
%
/==only {  % obj  .  -
    %traceon
    //==dict begin
        //.==state /cp 0 put
        //.==state /depth 0 put
        //.==state /spent 0 put
        { typeprint } stopped
    end            % Pop ==dict whether typeprint succeeded or errored,
    { stop } if    % So an error inside == does not strand it on the
                   % dict stack; re-raise once the dict stack is clean
} end def  % Remove ==dict, installing == in userdict

%
%  Print an object in re-readable form and a newline (PLRM 8.2).
%
/== [ /anytype ] { ==only (\n) print } .defop  % obj  .  -

%
%  Print the whole operand stack in re-readable form, deepest first,
%  leaving it as it was (PLRM 8.2).
%
/pstack [ ] { count dup 1 add copy //== repeat pop } .defop  % -  .  -
end  % Back to systemdict

%
%  The executive's state, and the one procedure that reads it.
%
%  .execstate is a state dictionary: the executive opens it and writes
%  the flag that ends the loop, the depth it has recursed to, and the
%  file a statement is being read from. A dictionary the machinery
%  writes as it runs cannot be sealed, so nothing the machinery
%  EXECUTES may live in it -- a program reaching it could put its own
%  procedure where the executive looks one up. The procedure lives in
%  the private namespace with the rest of the machinery, where the
%  lockdown seals it, and reads the state through a frozen reference
%  the way every other helper does. The state itself lives in the job
%  store, which is where a dictionary written as the machinery runs
%  belongs: writable, global, and given back at the job boundary.
%
.jobstore /.execstate 6 dict put
.jobstore /.execstate get begin
    /quitflag false def
    /execdepth 0 def
end

.xpostsys /.checkquit {  % -  .  -
    //.execstate /quitflag get
    { exit } if
} put

%
%  Report a start-up that never reached a program: the graphics language
%  could not be loaded, or the page device the run was started with could
%  not be built.
%
%  The device and the page it was asked for are named, and so is the error
%  the attempt ended in. A caller that has to ask for something else needs
%  all three -- which device refused, what it was asked for and what limit
%  that reached -- and none of them is anything it can go and read
%  afterwards, because the run that knew them is over and wrote nothing.
%  PLRM 8.2 gives limitcheck for a limit of the implementation, which is
%  the name a page larger than a device can address comes back under; a
%  page larger than the memory to hold it comes back as VMerror. The
%  report names whichever was reached rather than deciding between them,
%  since a device refuses for its own reasons. Whatever the attempt ended
%  in, the name is read from $error.
%
%  The failure is recorded as well as printed. A start-up that produced no
%  page must not end with the status of a job that ran, or a caller
%  reading the status alone takes an interpreter that never started for a
%  program that started and drew nothing.
%
%  Reporting is given a stopped context of its own, for the reason
%  .handlejoberror is: the naming below asks for names and dictionaries
%  that a run stopped at an implementation limit may not have to give, and
%  a failure part way through the sentence must still reach the recording
%  that the exit status is read from.
%
%  In the private global namespace, reached by the start procedures below
%  through a frozen reference, so it does not sit visible in systemdict.
%
.xpostsys /.reportloadfailure {  % -  .  -
    {
        (unable to load graphics) print

        % The request is read from the settings this run has, which is
        % where a value the invocation decided is kept, so it is there to
        % be named whether or not the attempt reached the device
        % the device the run asked for rather than the one its page was
        % given to: a selection that can arrive a band at a time is made
        % through the recording class, and naming that back at a caller
        % would be reporting a choice made on its behalf.
        (: device ) print
        /StartDeviceAsked //.hostvalue exec
        dup null eq { pop /StartDevice //.hostvalue exec } if
        =print
        ( asked for a page of ) print
        /StartPageSize //.hostvalue exec aload pop
        exch =print ( by ) print =print ( pixels) print
        $error /newerror get $error /errorname known and {
            (: ) print $error /errorname get =print
        } if
        (\n) print flush
    } stopped { (\n) print flush } if
    //.internaldict /.rundied get exec
} put

%
%  Initiate an interactive session with prompt a postscript 'executive'
%  session.
%
/start {  % -  .  -
    currentglobal
    false setglobal
    {
        //.xpostsys /.loadgraphics get exec
        //.xpostsys /.finalize get exec
        //.xpostsys /.startdevice get exec
    } stopped {
        //.reportloadfailure exec
        handleerror
        pstack
        quit
    } if

    % Shadow the `quit` operator with this procedure which checks the
    % depth of 'executive' nesting.
    userdict /quit {
        %exit
        //.execstate /quitflag true put
        $error /newerror false put
        stop
    } put
    setglobal

    /executive load stopped
    pop //quit  % The operator
} def

%
%  Report a top-level job error the way a job server does: the standard
%  error line (through handleerror), then -- only when an error really
%  occurred, not on a normal quit -- the notice that the rest of the job
%  is flushed to end of file. An interactive executive keeps going, so it
%  reports without this line.
%
%  Whether an error occurred is read before anything else runs and the
%  rest of the report happens inside that answer, because nothing here may
%  rely on the operand stack surviving: an error recovers by restoring the
%  stack it recorded, so a report that raises one comes back to a stack
%  that is not the one it left.
%
%  Reporting is given a stopped context of its own. The branch this runs
%  from has spent the job's, so an error raised while reporting -- the
%  standard handler is a program's to replace, and even the standard one
%  asks for names, strings and dictionaries a run at an implementation
%  limit may not have to give -- would find no context to stop into and
%  take the remainder of the report with it, ending the job's output
%  mid-sentence with nothing to say it had ended. What survives that is
%  what this procedure holds in its own body: the two notices below are
%  its own strings and print without asking for anything.
%
%  In the private global namespace, reached by the start procedures
%  below through a frozen reference, so it does not sit visible in
%  systemdict.
%
.xpostsys /.handlejoberror {  % -  .  -
    $error /newerror get {
        { handleerror } stopped {
            (%%[ Report incomplete: reporting this error raised another ]%%\n)
            print flush
        } if
        //.internaldict /.rundied get exec
        (%%[ Flushing: rest of job \(to end-of-file\) will be ignored ]%%\n)
        print flush
    } if
} put

%
%
%  What a job does after its program: the page it painted and never asked
%  for is ended, and the stacks are put back to the state a job begins
%  with (PLRM 3.7.7, which clears the operand stack and resets the
%  dictionary stack as the last thing a job does before its virtual
%  memory reverts).
%
%  Ending the page is allowed to fail and the failure is not reported:
%  the job is over and the program is no longer there to be told. What it
%  leaves behind is another matter. The page goes out through the
%  device's own methods, each of which makes the device dictionary
%  current while it works, and a method that stops part way -- an output
%  file that cannot be opened is the ordinary way for one to -- leaves
%  that dictionary current and the operands the failure met still on the
%  stack. A caller whose context outlives the job then begins the next
%  one on a dictionary stack a device sits on top of, where every
%  definition it makes lands in the device rather than in its own
%  namespace.
%
%  Both stacks, and not the dictionary stack alone: the two are disturbed
%  by the same failure and are put back by the same act.
%
%  The two operators are taken as they stand here, before any program has
%  run: a job's own definitions are still in reach at this point, and a
%  program that redefined either name would otherwise decide what
%  resetting the stacks means.
%
%  In the private global namespace, reached by the start procedures
%  below through a frozen reference, so it does not sit visible in
%  systemdict.
%
.xpostsys /.endjob {  % -  .  -
    { //.xpostsys /.endjobpage get exec } stopped { } if
    { //.xpostsys /.formcachedrop get exec } stopped { } if
    //clear
    //cleardictstack
} put

%
%  Execute postscript program from stdin, and handle errors,
%  but do not assume an interactive session.
%
/startstdin {  % -  .  -
    {
        //.xpostsys /.loadgraphics get exec
        //.xpostsys /.finalize get exec
        //.xpostsys /.startdevice get exec
    } stopped {
        //.reportloadfailure exec
        quit
    } if
    {
        (%stdin) run
    } stopped {
        //.handlejoberror exec
    } if

    % A page the program painted and never asked for is ended here, and
    % the stacks the job used go back to the state a job begins with
    //.endjob exec
    quit
} def

%
%  Execute postscript program from a named file, and handle errors.
%
%  The named program is a job and the job ends where the program ends (PLRM
%  3.7.7). A run with a user at the other end of it is offered the interactive
%  executive first, which is a session and not part of the job: it reads
%  standard input and executes what it finds, so it is offered only where
%  standard input is somebody typing. The C settles that before the run and
%  leaves the answer in privatedict.
%
/startfilename {  % string  .  -
    {
        //.xpostsys /.loadgraphics get exec
        //.xpostsys /.finalize get exec
        //.xpostsys /.startdevice get exec
    } stopped {
        //.reportloadfailure exec
        quit
    } if
    {
        (r) file cvx exec        % (filename) has stayed on the stack
        /.interactive //.hostvalue exec { executive } if
    } stopped {
        //.handlejoberror exec
    } if

    % A page the program painted and never asked for is ended here, and
    % the stacks the job used go back to the state a job begins with.
    //.endjob exec
    quit
} def
%
% currentfile flushfile
%

%
%  Execute a postscript program from a file object, which may represent
%  a stream with no associated "name".
%
/startfile {  % file  .  -
    //.internaldict /QUIET known { }{ (startfile\n)print } ifelse
    {
        //.xpostsys /.loadgraphics get exec
        //.xpostsys /.finalize get exec
        //.xpostsys /.startdevice get exec
    } stopped {
        //.reportloadfailure exec
        quit
    } if
    {
        cvx exec        % The file object has stayed on the stack
    } stopped {
        //.internaldict /.rundied get exec
        //.handlejoberror exec
    } if

    % A page the program painted and never asked for is ended here, and
    % the stacks the job used go back to the state a job begins with.
    //.endjob exec
    quit
} def

%
%  No-graphics start procedures, selected by --no-graphics. Each mirrors its
%  graphics-loading counterpart above but runs .finalize alone, without
%  .loadgraphics: the interpreter is still locked down -- the standard operators
%  are promoted, the machinery's references frozen and the private namespaces
%  sealed and hidden -- while the graphics modules are never loaded.
%  This exercises the path in which .loadgraphics is genuinely optional,
%  and lets a program that needs no graphics avoid the cost.
%
%  startstdinnographics, startfilenamenographics and startfilenographics
%  answer the three ways a job arrives, and loadlanguagenographics is
%  the same for a host that only wants the language built.
%
/startstdinnographics {  % -  .  -
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter\n)print flush
        //.internaldict /.rundied get exec
        quit
    } if
    {
        (%stdin) run
    } stopped {
        //.handlejoberror exec
    } if
    quit
} def

/startfilenamenographics {  % string  .  -
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter\n)print flush
        //.internaldict /.rundied get exec
        quit
    } if
    {
        (r) file cvx exec        % (filename) has stayed on the stack
        /.interactive //.hostvalue exec { executive } if
    } stopped {
        //.handlejoberror exec
    } if
    quit
} def

/startfilenographics {  % file  .  -
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter\n)print flush
        //.internaldict /.rundied get exec
        quit
    } if
    {
        cvx exec        % The file object has stayed on the stack
    } stopped {
        //.internaldict /.rundied get exec
        //.handlejoberror exec
    } if
    quit
} def

%
%  Load the language and lock the interpreter down, and run no program.
%  Each start procedure above begins by doing this, and both halves are
%  idempotent, so one that has already run here repeats nothing. It is
%  separated out for a caller that has to have the language standing
%  before the run begins rather than as its first act: the load happens
%  once in the life of a context and leaves state behind it that virtual
%  memory does not hold, so it is not something a run can be made to do
%  again. Failure is left unreported here -- the start procedure that
%  follows meets it too, and reports it there as it does on its own.
%
%  The language and nothing else. Which device this run has and which
%  page it is at are not language; making the device is the step below.
%
/loadlanguage {  % -  .  -
    { //.xpostsys /.loadgraphics get exec
      //.xpostsys /.finalize get exec } stopped pop
    quit
} def

/loadlanguagenographics {  % -  .  -
    { //.xpostsys /.finalize get exec } stopped pop
    quit
} def

%
%  Make the device this run was started with, and run no program. The
%  counterpart of the language load above, for the same caller and for
%  the same reason: a device is made once in the life of a context, and
%  what it reaches through a handle is not virtual memory, so a device
%  made inside the bracket a job is run in would be unmade by the rewind
%  that ends the job while the state it held stayed where it was. The
%  step is idempotent -- a run that has a device keeps it -- so a start
%  procedure that has already been through this repeats nothing.
%  Failure is left unreported for the reason it is above.
%
/startdevice {  % -  .  -
    { //.xpostsys /.startdevice get exec } stopped pop
    quit
} def

%
%  What the interactive executive prints before reading a line: PS, the
%  depth of the operand stack where it is not empty, and one closing
%  bracket per level of nested execution.
%
%  prepr.ps replaces it at the foot of this file with a prompt that
%  digests the stack by type as well. This one stands for the run that
%  never reaches prepr.ps.
%
/prompt [ ] {  % -  .  -
    (PS) print
    count dup 0 eq { pop } { (<) print //=print exec } ifelse
    //.execstate /execdepth get {
        (>) print
    } repeat
    flush
} .defop

%
%  System and device parameters. The current* operators return a fresh
%  dictionary of the present values; the set* operators apply the parameters they
%  recognise from the supplied dictionary and ignore the rest. The user
%  parameters belong to the context and revert with a restore, so
%  currentuserparams and setuserparams are operators over that state and are
%  not defined here.
%
%  setdevparams and currentdevparams are the device pair, and
%  setsystemparams and currentsystemparams the system one.
%
%  This interpreter carries no writable device parameters, so the device
%  pair answers an empty dictionary and applies nothing. What it may not
%  do is answer for a parameter set it does not have: PLRM 8.2 gives both
%  operators the undefined error, and a program asks after a device
%  precisely to find out whether it is there. Answering an empty
%  dictionary for every string it is handed tells a program that every
%  device exists, which is a worse answer than none.
%
%  The sets are the special files this interpreter opens by name, which is
%  what a parameter set corresponds to (PLRM C.4). Everything else a
%  program may name is an ordinary path.
%
/.devparamsets [ (%stdin) (%stdout) (%stderr) (%lineedit) (%statementedit) ] readonly def

.xpostsys /.knowndevparam {  % string /op  .  -
    3 dict begin
    /op exch def
    /s exch def
    /found false def
    //.devparamsets { s eq { /found true store } if } forall
    found not { op cvx /undefined signalerror } if
    end
} put

/setdevparams [ /stringtype /dicttype ] {  % string dict  .  -
    pop /setdevparams //.xpostsys /.knowndevparam get exec
} .defop
/currentdevparams [ /stringtype ] {  % string  .  dict
    /currentdevparams //.xpostsys /.knowndevparam get exec
    0 dict
} .defop

%
%  MaxBandBytes and CurBandHeight are the pair a program asks about
%  banding: the first says what one band of a page may cost, in bytes of
%  raster held at once, and the second the rows that bought on the device
%  now being painted into -- zero where it holds the page whole. They sit
%  with the Max* limits and the Cur* values, and mean what those mean: a
%  limit says what may be spent and a Cur* value says what is being spent.
%
%  Both are reported and neither is set. PLRM Appendix G declares the
%  band-device setup operators obsolete and bars them from a page
%  description, so a program may not choose how its marks are held;
%  nothing bars it from being told what happened, and setsystemparams
%  below recognises no parameter at all, so there is no way to write
%  either one back. What chooses is the invocation.
%
%  Each is read where the band loop reads it -- the budget from
%  .bandbudget and the rows from .curbandheight, which asks .bandheight
%  (data/recorddev.ps, data/device.ps) -- so a program is told what the
%  loop went by rather than what a second copy of the arithmetic would
%  say. A run whose graphics never loaded has no band loop and no device
%  to ask, and answers nought to both.
%
/currentsystemparams [ ] {  % -  .  dict
    << /RealFormat (IEEE) /ByteOrder true

       % MaxFontCache is the glyph cache's byte capacity, read from the
       % cache itself rather than stated here, so that this and
       % currentcacheparams (data/font.ps) cannot tell a program two
       % different numbers for the one parameter. Of the seven figures
       % .cachestatus reports it is the second; the reference is frozen
       % here because the private operators move out of systemdict during
       % the lockdown and a run whose graphics never loaded leaves them
       % where they are.
       /MaxFontCache //.cachestatus pop pop pop pop pop exch pop

       % Where external resources are found: the first resource directory,
       % separated by /. Reported, not set -- the search path is the host's.
       /GenericResourceDir //.xpostsys /.genericresourcedir get exec
       /GenericResourcePathSep (/)
       /MaxBandBytes
           //.xpostsys /.bandbudget 2 copy known
               { get exec }{ pop pop 0 } ifelse
       /CurBandHeight
           //.xpostsys /.curbandheight 2 copy known
               { get exec }{ pop pop 0 } ifelse

       % RecordSpill says where a retained page's marks are to be held
       % and CurRecordSpill where the page in hand has them. Reported and
       % never set, for the reason CurBandHeight is: PLRM Appendix G bars
       % a page description from choosing how its marks are held, and
       % setsystemparams below recognises no parameter at all. What
       % chooses is the invocation.
       //.xpostsys /.currecordspill 2 copy known
           { get exec }{ pop pop /auto /memory } ifelse
       exch /RecordSpill exch 3 -1 roll /CurRecordSpill exch
    >>
} .defop
/setsystemparams [ /dicttype ] { pop } .defop  % dict  .  -

%
%  Display PostScript synchronisation (PLRM 2nd ed 7.1). lock and condition are
%  the two synchronisation objects; monitor, wait and notify coordinate contexts
%  through them. Scheduling is cooperative, so mutual exclusion between yields is
%  inherent -- a monitor's procedure runs atomically unless it yields or waits --
%  and these enforce it only across a context's own yield or wait, where they
%  block by yielding and re-checking, the way join does. The objects are ordinary
%  dictionaries whose value the shared VM shares between contexts exactly as PLRM
%  requires of a lock or condition; only these operators read or write them.
%  Installed on the --enable-dps opt-in, beside fork and join, so a default run
%  leaves the names undefined.
%
.dpsenabled {
    % A lock, free and unowned.
    /lock [ ] { << /held false /owner null >> } //.defop exec  % -  .  lock

    % A condition.
    /condition [ ] { << /gen 0 >> } //.defop exec  % -  .  condition

    % Resume every context waiting on the condition.
    /notify [ /dicttype ] {  % condition  .  -
        dup /gen exch /gen get 1 add put
    } //.defop exec

    % Acquire the lock, run proc, release it.
    /monitor [ /dicttype /arraytype ] {  % lock proc  .  -
        exch                                   % Proc lock
        % monitor of a lock this context already holds is invalidcontext
        dup /held get 1 index /owner get currentcontext eq and
            { /monitor cvx /invalidcontext signalerror } if
        % Acquire: wait while another context holds it, then take it
        { dup /held get not { exit } if yield } loop
        dup /held true put
        dup /owner currentcontext put

        % Run the procedure, releasing the lock however it ends. The release
        % is `{ theLock /held false put }` with the lock captured, so the whole
        % is `{ proc } stopped { release stop } { release } ifelse` built with
        % the lock embedded. It is assembled in a scratch dictionary popped
        % before it runs, so the procedure runs in the caller's own dictionary
        % and operand stack, disturbed by neither the lock nor this machinery.
        % Releasing sets only /held: /owner is overwritten on the next acquire
        % and read only while held, so leaving it stale is harmless.
        3 dict begin
            /m.lk exch def                     % Proc
            /m.pr exch def                     %
            /m.td [ /m.lk load /held false /put load ] cvx def
            [ [ /m.pr load /exec load ] cvx
              /stopped load
              [ /m.td load /exec load /stop load ] cvx
              [ /m.td load /exec load ] cvx
              /ifelse load ] cvx
        end
        exec
    } //.defop exec

    % Release the lock, await notify, reacquire it.
    /wait [ /dicttype /dicttype ] {  % lock condition  .  -
        2 dict begin
        /.wcond exch def                       % Lock
        /.wlk exch def                         %

        % Wait on a lock this context does not hold is invalidcontext
        .wlk /held get .wlk /owner get currentcontext eq and not
            { end /wait cvx /invalidcontext signalerror } if

        % Release the lock and wait for a notify issued after this point
        .wcond /gen get                        % Startgen
        .wlk /held false put
        .wlk /owner null put
        { .wcond /gen get 1 index gt { exit } if yield } loop
        pop

        % Reacquire the lock before returning to the monitor
        { .wlk /held get not { exit } if yield } loop
        .wlk /held true put
        .wlk /owner currentcontext put
        end
    } //.defop exec
} if

%
%  Move the start procedures into privatedict, off the dict stack: the C fetches
%  them there (through ctx->privatedict) to prime a run, so a program never sees
%  them among systemdict's names. They bind with the rest of privatedict in
%  .finalize, before any program can shadow the operator names they call.
%
[ /start /startstdin /startfilename /startfile
  /startstdinnographics /startfilenamenographics /startfilenographics
  /loadlanguage /loadlanguagenographics /startdevice ]
{ dup systemdict exch known
    { dup dup systemdict exch get .privatedict 3 1 roll put systemdict exch undef }
    { pop } ifelse
} forall

end  % systemdict

userdict begin
false setglobal
% traceon
% debugloadon

currentglobal true setglobal

%
%  //.xpostsys /.fontsubstitutions get: findfont's substitute-face table, hidden in the private
%  global namespace where a program cannot reach it
%
.xpostsys /.fontsubstitutions <<
    /Times-Roman (Nimbus Roman No9 L)
    dup (URW Bookman L)

    /Courier (Liberation Mono)
    dup /FreeMono
    dup (Hershey\\-Plain\\-Triplex)
    dup (DejaVu Sans Mono)

    /Helvetica (DejaVu Sans)
    dup (Nimbus Sans L)

    /Palatino-Roman (URW Palladio L)

    % The compressed spellings of the standard 35 that a host is unlikely
    % to know under those names: it holds the family spelled out, and
    % nothing maps one onto the other, so the name reaches the default
    % face of its kind instead of the face meant for it.
    /NewCenturySchlbk-Roman (New Century Schoolbook)
    dup (Century Schoolbook L)
    dup (C059)
    /NewCenturySchlbk-Italic (New Century Schoolbook)
    /NewCenturySchlbk-Bold (New Century Schoolbook)
    /NewCenturySchlbk-BoldItalic (New Century Schoolbook)
>> readonly put
setglobal

%
%  The FontDirectory holds defined fonts; findfont dictionaries for
%  host faces state the type of the program that backs them. It is a local
%  dictionary: a font defined in local VM goes away with the save level
%  that defined it.
%
/FontDirectory
<<
>> def

end  % Userdict

currentglobal true setglobal

%
%  GlobalFontDirectory holds the fonts defined while the allocation mode was
%  global, and only those (PLRM 3.7). It is itself a global dictionary, so it
%  survives the restores that empty the local one, and it is a different
%  dictionary -- a program reading it must not see the local fonts.
%  SharedFontDirectory is the same dictionary under an older name.
%
systemdict /GlobalFontDirectory << >> put
systemdict /SharedFontDirectory systemdict /GlobalFontDirectory get put
setglobal

%
%  The rest of the boot file defines the language too, so it goes where the
%  language lives. systemdict is still writeable here -- the interpreter
%  seals it only after this file has been read.
%
systemdict begin

currentglobal true setglobal

%
%  executive is a global procedure in systemdict. It reaches $error by name,
%  not with a frozen reference: $error is a name in systemdict for a dictionary
%  in local VM, and a global procedure may not freeze a local object.
%
/executive [ ] {  % -  .  -
    //.execstate begin

    /execdepth execdepth 1 add def
    //.internaldict /QUIET known { }{
        product print
        ( version ) print version print
        (.) print revision =print
        (\n) print
    } ifelse

    {  % loop
        /quitflag false def
        $error /newerror false put
        /prompt load stopped {
            (Error during prompt execution\n) print
            handleerror
            exit
        } if
        {
            mark
            /stmtfile (%statementedit) (r) file def
        } stopped {
            cleartomark
            $error /newerror get {
                $error /errorname get
                /undefinedfilename ne {  % ^d at prompt
                    handleerror
                } if
                $error /newerror false put
                exit
            } if
        }{
            pop stmtfile end
            {
                cvx exec
            } stopped //.execstate begin {
                handleerror
                stmtfile closefile
            } if
        } ifelse
        //.checkquit exec
    } loop
    /quitflag false def
    //.execstate /execdepth 2 copy get 1 sub put

    end
    $error /doclose false put
    stop
} .defop
setglobal

(/qsort.ps) //.loadmodule exec

%
%  Named Resources: the Level 2 resource operators live in their own
%  data file
%
(/resource.ps) //.loadmodule exec

%
%  The device parameter sets, as the IODevice resource category (PLRM
%  Table 3.8), so a program can enumerate what setdevparams and
%  currentdevparams answer for rather than guess at it. Declared from the
%  one list those operators are held to, so the two cannot disagree --
%  and declared here rather than beside them, because the category has to
%  exist first and the resource machinery is what has just arrived.
%
currentglobal true setglobal
//.devparamsets { dup /IODevice defineresource pop } forall
setglobal

%
%  The font a name stands for (PLRM 8.2): from the font directory where
%  it has been defined, and otherwise loaded through the Font resource
%  category, which is where a font program on the search path is found.
%
%  A name nothing can supply is substituted rather than refused, because
%  PLRM 8.2 has findfont produce a font in every case; the substitution
%  table is the one init.ps built above.
%
/findfont [ /anytype ] {  % key  .  font
    % A resource key is an object of any type except null (PLRM 3.9),
    % so only null is refused here; anything else is looked up and, not
    % being found, substituted for like any other unknown name
    dup type /nulltype eq { /findfont cvx /typecheck signalerror } if

    % Both directories are consulted: the local one first, as the
    % specification says, then the global one for a font a prolog defined
    % while the allocation mode was global
    FontDirectory 1 index known {
        FontDirectory exch get
    }{
    GlobalFontDirectory 1 index known {
        GlobalFontDirectory exch get
    }{
        {   % Try the operator, which states FontType, FontMatrix
            % and FontBBox for the face behind the name
            dup //findfont              % name font

            % A name the host has nothing for reaches the default face of
            % its kind, and the font answers by that face's name rather
            % than the one asked for -- a name the host does resolve keeps
            % its own. So the two differing says this build was handed a
            % substitute, and where the table names a family that stands
            % in for the name, that family is asked for instead. The name
            % asked for is then stamped back on: the table is this build's
            % own aliasing, and a name it aliases is a name this build
            % has, exactly as a name the host aliases is one the host has.
            % Asked once. The answer to the second question stands
            % whatever it is, so a family the host also lacks cannot send
            % this round again.
            dup /FontName get 2 index ne {
                //.fontsubstitutions 2 index known {
                    pop                                  % name
                    dup //.fontsubstitutions exch get    % name family
                    //findfont                           % name font
                    dup 3 -1 roll /FontName exch put     % font
                }{ exch pop } ifelse                     % font
            }{ exch pop } ifelse                         % font

            % The encoding the face itself supplies (PLRM 5.2): the
            % name it gives each character code, which is what a
            % program reads /Encoding to learn. A face naming no
            % glyphs of its own usually says nothing about codes
            % either, and the standard encoding stands for it -- as it
            % does for a build with no face library at all, where the
            % operator above answered from the substitution table.
            %
            % Either way the array is this font's own and not the
            % shared one, so a program re-encoding in place touches
            % nothing but its own font.
            dup dup StandardEncoding .faceencoding
            dup null eq { pop StandardEncoding dup length array copy } if
            /Encoding exch put
            dup /BuildChar {} put
        } stopped {  % Operator failed:
            //.fontsubstitutions exch 2 copy known {  % Try substitution
                get
                findfont  % Call proc (tail-)recursively
            }{
                % Nothing found and nothing to substitute: the
                % operator yields a font or says why not
                exch pop pop
                /findfont cvx /invalidfont signalerror
            } ifelse
        } if
    } ifelse } ifelse
} .defop

%
%  The user-object table lives in userdict, growing as indices demand.
%
/defineuserobject [ /integertype /anytype ] {  % index any  .  -
    exch
    dup 0 lt { /defineuserobject cvx /rangecheck signalerror } if
    userdict /UserObjects known not {
        userdict /UserObjects 10 array put
    } if
    dup UserObjects length ge {
        dup 1 add UserObjects length 2 mul 2 copy lt { exch } if pop
        array dup 0 UserObjects putinterval
        userdict /UserObjects 3 -1 roll put
    } if
    UserObjects exch 3 -1 roll put
} .defop

%
%  Execute the user object at an index (PLRM 8.2) -- the array a program
%  filled with defineuserobject, which is how a compiled job names its
%  own procedures by number rather than by dictionary lookup.
%
/execuserobject [ /integertype ] {  % index  .  -
    UserObjects exch get exec
} .defop

%
%  Give up the user object at an index (PLRM 8.2). The slot stays,
%  holding null, so the numbering of the objects around it does not
%  shift.
%
/undefineuserobject [ /integertype ] {  % index  .  -
    UserObjects exch null put
} .defop

currentglobal true setglobal

%
%  Paint the form afresh: its matrix concatenates, its bounding box
%  clips, and the paint procedure runs with the dictionary at hand.
%  The paint procedure is the program's, so it runs beneath the
%  boundary: a failure inside it is that procedure's own object
%  failing, and the operand stack goes back to what the procedure
%  found rather than to execform's operand.
%
%  The graphics state this opens is execform's own, and the grestore
%  written after the paint is not reached when the procedure raises, so
%  the whole body goes through the callout bracket -- which closes what
%  the body opened whichever way the body ends.
%
.xpostsys /.execformdirect {  % formdict  .  -
    {
    gsave
    dup /Matrix get concat
    dup /BBox get aload pop     % Form llx lly urx ury
    2 index sub                 % Form llx lly urx h
    exch 3 index sub exch       % Form llx lly w h
    rectclip
    dup /PaintProc get //.xpostsys /.pexec get exec
    grestore
    } null 0 //.xpostsys /.callout get exec
} put

%
%  Paint a form for keeping: its matrix concatenates and the paint
%  procedure runs, and the bounding box does not clip.
%
%  What the box would cut is nothing -- a form paints inside the box it
%  declares -- but cutting is not free of consequence. A shape the clip
%  has to cut is resolved into whole pixel rows above the device, where a
%  shape the clip leaves alone arrives as itself; the two paint the same
%  pixels, and only one of them can be carried somewhere else. A drawing
%  held for placing has to be the marks and not the rows they came to,
%  since the rows a shape covers depend on where it falls between pixels.
%
%  The caller clips instead, to the box out to whole pixels and one
%  further, so that a procedure painting outside the box it declared is
%  still held to about the box while a procedure painting inside it is
%  not cut at all.
%
.xpostsys /.execformcapture {  % formdict  .  -
    {
    gsave
    dup /Matrix get concat
    newpath
    dup /PaintProc get //.xpostsys /.pexec get exec
    grestore
    } null 0 //.xpostsys /.callout get exec
} put
setglobal

currentglobal true setglobal

%
%  The device pixel box holding the form's bounding box under the
%  current transformation and the form's own matrix.
%
.xpostsys /.execformbox {  % formdict  .  bx by w h
    8 dict begin
    /fd exch def
    gsave
    fd /Matrix get concat
    /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
    fd /BBox get aload pop
    /ury exch def /urx exch def /lly exch def /llx exch def
    [ [llx lly] [urx lly] [urx ury] [llx ury] ] {
        aload pop transform
        dup mxy gt { dup /mxy exch def } if
        dup mny lt { dup /mny exch def } if pop
        dup mxx gt { dup /mxx exch def } if
        dup mnx lt { dup /mnx exch def } if pop
    } forall
    grestore
    mnx floor mny floor
    mxx ceiling mnx floor sub cvi
    mxy ceiling mny floor sub cvi
    end
} put
setglobal

currentglobal true setglobal

%
%  Give up every drawing the form cache is holding.
%
%  A drawing is held by a recorder, and what a recorder holds is not
%  virtual memory: the collector neither reaches it nor gives it back, so
%  a drawing the cache stops naming would stay held for the life of the
%  run. The cache gives each one up before it stops naming it.
%
%  An entry naming no drawing is one that says a form cannot be held --
%  it paints outside the box it declared, so what a drawing carried would
%  differ from what painting it afresh does. There is nothing to give
%  back for such an entry, and it is passed over.
%
%  Called where the cache stops standing for anything: at the end of a
%  job, and where the page device is replaced, since a drawing is the
%  marks a form made for one device and carries that device's colour
%  space -- placing it in another would be a colour nobody named, and is
%  refused rather than painted.
%
.xpostsys /.formcachedrop {  % -  .  -
    graphicsdict /.formcache 2 copy known {
        get { exch pop dup /drawing known
                { /drawing get dup /Destroy get exec }{ pop } ifelse } forall
        graphicsdict /.formcache undef
    }{ pop pop } ifelse
} put
setglobal

%
%  Paint a form.
%
%  The paint procedure runs once for each form and each linear
%  transformation it is used under. What it paints is captured as a
%  drawing -- the marks it made, in the device's own coordinates, held by
%  a recorder standing in for the device -- and every execution after
%  that places the drawing where it is wanted rather than running the
%  procedure again. PLRM 4.7 permits saved output to stand in for
%  re-executing the procedure, and this is that latitude: it also says
%  that a change to the translation of the transformation does not
%  require the procedure to be run again, which is why the key carries
%  the linear part and the placement carries the position.
%
%  A placement is a reference and not a copy. The drawing is held once
%  however many places it is put, and a form whose paint procedure uses a
%  form places that form's drawing inside its own -- so a page built of
%  forms inside forms costs each distinct form once, at its own
%  transformation, rather than their product. A placement is resolved
%  when the page is painted, which is what makes that true at any depth.
%
%  What is placed is the marks, not a picture of them, so each placement
%  is painted at its own position rather than at the position the
%  procedure was run at. A form at a fractional position is therefore the
%  page the procedure would have painted there.
%
%  The cache serves where a drawing can be held for the device
%  (.newformrecord, src/lib/xpost_dev_record.c) and where the clip is a
%  rectangle holding the whole of the form's box: what reaches the
%  recorder is already cut to the clip, so a form the clip cuts would be
%  captured cut and placed cut somewhere the clip is not. Anything else
%  -- a device given whole paths, one that screens, a form dictionary
%  that cannot take its serial -- paints afresh.
%
/execform [ /dicttype ] {  % formdict  .  -
    dup /FormType 2 copy known { get 1 eq }{ pop pop false } ifelse
    not { /execform cvx /rangecheck signalerror } if
    dup wcheck
    not {
        //.execformdirect exec
    }{
        % The form's paint procedure is the program's, and runs inside
        % this dictionary: an error out of it is a way out of the body
        % like returning is, so the dictionary comes off either way
        20 dict {
        /fd exch def

        % The serial naming this form, stamped only where the dictionary
        % carries none. A form dictionary is the program's, so what is
        % there may be a serial this never issued: a program may write
        % its own, and a copy of a form carries the original's.
        %
        % The counter is the interpreter's own (.newformserial) and only
        % ever moves forward, so no number is ever handed out twice and no
        % form can be served a drawing another form was filed under. It
        % cannot be a value in a dictionary. The number is stamped into
        % the form dictionary, which is the program's and may be in either
        % bank, while a counter would be in one of them: a restore past
        % the execform that raised it winds the counter back, a dictionary
        % the restore does not reach carries the old number forward, and
        % the next form is issued the number that dictionary is still
        % holding. The two then name one entry and whichever was captured
        % first is painted for both. Nothing reports that; it is a wrong
        % shape on a page. The glyph masks are keyed the same way and for
        % the same reason (.newfontserial).
        %
        % The cache stays in graphicsdict and is wound back by a restore,
        % which costs a re-capture and never a wrong drawing, since the
        % serial an entry was filed under is not issued again.
        %
        % The last number seen is kept beside the cache so that the two
        % are wound back together. A counter that has run its range starts
        % again below what it has already handed out, and what is held is
        % then no longer distinguishable from what the reissued numbers
        % will name, so the cache is given up. Keeping the two in one
        % dictionary is what makes that test agree with what the cache
        % actually holds: a restore that takes the entries back takes the
        % remembered number with them.
        fd /.formid known not {
            //.internaldict /.newformserial get exec
            graphicsdict /.formlast 2 copy known { get }{ pop pop 0 } ifelse
            1 index le not { //.formcachedrop exec } if
            graphicsdict /.formlast 2 index put
            fd /.formid 3 -1 roll put
        } if

        % The key: the form and the linear part of the transformation,
        % written out in full rather than rounded, so two executions
        % share a drawing only where the transformation that made it is
        % the same one. A drawing is the marks the procedure made under
        % one transformation, and marks made under another are another
        % drawing.
        %
        % The position is not in the key. PLRM 4.7 says a change to the
        % translation of the transformation usually does not require the
        % procedure to be run again, and here it never does: the drawing
        % is the marks the procedure made, held in the coordinates they
        % were made in, and a placement carries them. So a form used at
        % any position is the same drawing placed there, at whatever
        % point between pixels that position falls.
        %
        % It is the capture not cutting the marks that makes this true.
        % A shape the bounding box has to cut is resolved into whole
        % pixel rows before it reaches a device, and rows cannot be
        % carried a fraction of a pixel and stay the rows the shape
        % covers there; marks can (.execformcapture above).
        %
        % Nothing else of the graphics state is in the key, and a
        % description that reads any of it is a description this paints
        % at whatever it read the first time. PLRM 4.7 asks a form to be
        % self-contained -- to depend only on what its own dictionary
        % holds, and to paint the same thing every time it is called --
        % and this is where that is relied on. A description setting its
        % own colour, line width and font, which is what self-contained
        % comes to, is unaffected; one inheriting the colour in force is
        % painted in the colour that was in force when it was first
        % used.
        /cm matrix currentmatrix def
        /key fd /.formid get 20 string cvs
        [ cm 0 get cm 1 get cm 2 get cm 3 get ] {
            40 string cvs
            exch (:) //.strcat exec exch //.strcat exec
        } forall def
        /fc graphicsdict /.formcache 2 copy known { get }{
            pop pop 32 dict graphicsdict /.formcache 2 index put
        } ifelse def
        fd //.execformbox exec
        /fh exch def /fw exch def /fby exch def /fbx exch def

        % Whether the clip holds the whole of the form's box. What
        % reaches a recorder is already cut to the clip, so a drawing
        % captured under a clip that cuts it is cut wherever it is
        % placed; and a drawing placed where the clip would cut it is
        % placed whole. Both are the same question, asked of the capture
        % and of every placement.
        /fits //.internaldict /.cliprect get exec {
            /cy1 exch def /cx1 exch def /cy0 exch def /cx0 exch def
            fbx cx0 ge fby cy0 ge and
            fbx fw add cx1 le and fby fh add cy1 le and
        }{ false } ifelse def
        fits fc key known not and {
            % A recorder standing in for the device, at the page's own
            % extent: the marks are the device's coordinates and the
            % clip they are cut to is the page's.
            % the extent as whole pixels: a device that writes paths
            % rather than pixels states its page as a measurement, and a
            % recorder holds rows
            /cap DEVICE /dimensions get aload pop cvi exch cvi exch
                DEVICE //.internaldict /.newformrecord get exec def
            cap null ne {
                % What the page weighs its own marks against, given to
                % the drawing captured for it. A drawing is part of what
                % the page holds -- held once rather than once per place,
                % but held -- so it is weighed by the same number, and a
                % drawing large enough to be worth more than the raster
                % the page is saving goes where the page's own marks
                % would go. A capture made for a device that holds no
                % record has no such number and is not weighed.
                DEVICE /.playclass known {
                    cap DEVICE //.internaldict /.recordsaving get exec
                        //.internaldict /.playsaving get exec
                } if

                % The table is full: the entry captured longest ago
                % gives up its place -- and its drawing with it, since
                % what a recorder holds is not virtual memory and
                % nothing else would give it back -- rather than the
                % whole table. A run using more forms than the table
                % holds then keeps the ones it captured most recently,
                % instead of paying every capture again from nothing.
                % Each entry carries seq, its place in the order of
                % capture, which is how the oldest is known: the
                % stamps live in the entries themselves, so a restore
                % that winds the table back winds the order back with
                % it.
                % (a key is an executable name, so it is read back with
                % load rather than by its name, which would run it)
                fc length 32 ge {
                    /ek null def /es 0 def
                    fc { /seq get /ek load null eq 1 index es lt or
                         { /es exch def /ek exch def }{ pop pop } ifelse
                    } forall
                    /ek load null ne {
                        fc /ek load get dup /drawing known
                            { /drawing get dup /Destroy get exec }
                            { pop } ifelse
                        fc /ek load undef
                    } if
                } if

                % The graphics state opened here is execform's own,
                % and it holds the recorder standing in for the device.
                % The grestore written after the capture is not reached
                % when the paint procedure raises, and the state left
                % open leaves the recorder current: the rest of the job
                % paints into a drawing nobody will place, and the page
                % it meant to make is lost. So the body goes through the
                % callout bracket, which closes what it opened whichever
                % way the body ends, and the recorder is given up when it
                % does not end normally -- what a recorder holds is not
                % virtual memory and nothing else would give it back.
                {
                {
                gsave

                % What the clip has cut so far: a shape the clip cuts is
                % resolved into whole pixel rows before it reaches a
                % device, and rows cannot be carried a fraction of a
                % pixel and stay the rows the shape covers there. So a
                % capture in which anything was cut is not one to carry
                % -- a clip the description set for itself, and a form
                % inside it painted afresh under its own box, are the
                % two ways that happens.
                graphicsdict /currgstate get /device cap put

                % The clip the capture paints under: the form's box, out
                % to whole pixels and one further, in the device's own
                % coordinates. It holds a procedure that paints outside
                % the box it declared to about the box, and leaves a
                % procedure that paints inside it uncut -- which is what
                % keeps the marks carryable.
                /cm2 matrix currentmatrix def
                matrix setmatrix
                newpath fbx 1 sub fby 1 sub fw 2 add fh 2 add rectclip
                cm2 setmatrix

                % Counted from here, once that box is in force, so that
                % what is measured is what the description painted and not
                % the box itself. The box reaches one pixel beyond the
                % form on every side, so for a form placed against the low
                % edge of the page it starts at a negative coordinate and
                % the page cuts it -- a cut belonging to the margin, not
                % to any mark, and one that would otherwise be read as the
                % description painting outside its box. That reading costs
                % more than holding nothing: the capture is made, judged
                % unusable, and the description is run again for every
                % placement, so the form pays for a capture it never uses.
                /cuts //.internaldict /.clipcuts get exec def
                fd //.execformcapture exec
                grestore
                } null 0 //.xpostsys /.callout get exec
                } stopped {
                    { cap dup /Destroy get exec } stopped pop
                    stop
                } if

                % Whether what it painted stays inside the box it
                % declared. A drawing is placed whole and nothing cuts
                % it where it lands, so a description that paints
                % outside its box would carry what the box cuts to
                % every place it is put -- and a page is not the page
                % it would have been. Such a form is painted afresh
                % every time, which is what it costs a run that holds
                % no description at all; the entry says so, so that
                % the description is not run twice for the answer.
                /held //.internaldict /.clipcuts get exec cuts eq
                    cap //.internaldict /.recordbox get exec {
                        /by1 exch def /bx1 exch def
                        /by0 exch def /bx0 exch def
                        bx0 fbx ge by0 fby ge and
                        bx1 fbx fw add le and by1 fby fh add le and
                    }{ true } ifelse and def

                % One past the newest capture held, so the entries read
                % out in the order they were made. Read after the
                % capture, since a form painting forms captures theirs
                % inside it and those entries are in the table by now.
                /seq 0 def
                fc { /seq get dup seq gt
                     { /seq exch def }{ pop } ifelse pop } forall
                /seq seq 1 add def
                held
                    { fc key << /drawing cap /seq seq
                                /tx cm 4 get /ty cm 5 get >> put }
                    { cap dup /Destroy get exec
                      fc key << /seq seq >> put }
                ifelse
            } if
        } if
        fits fc key known and { fc key get /drawing known }{ false } ifelse {
            /fe fc key get def

            % Where this execution puts the drawing: how far it is from
            % the position the drawing was painted at, in the device's
            % own coordinates. Not rounded to a pixel -- which pixels a
            % coordinate names is settled when the mark is played, so a
            % placement paints at the point between pixels it was asked
            % for rather than at the one the drawing was made at.
            /dx cm 4 get fe /tx get sub def
            /dy cm 5 get fe /ty get sub def
            DEVICE /.recordplace known {
                % A device holding a record of its own is given the
                % placement to write down, so the drawing is held once
                % for the page rather than played once per placement
                fe /drawing get dx dy DEVICE dup /.recordplace get exec
            }{
                fe /drawing get DEVICE dx dy
                    //.internaldict /.replayplace get exec
            } ifelse
        }{
            fd //.execformdirect exec
        } ifelse
        } //.xpostsys /.indict get exec
    } ifelse
} .defop

%
%  The form types execform implements, as PLRM Table 3.8 has a program ask
%  after them (see the note in shade.ps). One, which is the only form type
%  PLRM defines.
%
currentglobal true setglobal
[ 1 ] { dup /FormType defineresource pop } forall
setglobal

%
%  The filters this build has, as PLRM Table 3.8 has a program ask after them:
%  /FlateDecode /Filter resourcestatus is how a program finds out whether it
%  may send compressed data before it sends any. The instance of an implicit
%  resource is the capability itself, so each answers with its own name.
%
%  Every one of these was exercised to get on the list, which is not the same
%  as reading the names out of the source: a name the C mentions may be a
%  name it refuses. The encoders were built over a writable target and the
%  decoders over data, because a filter refuses the other way round and would
%  otherwise have looked absent.
%
currentglobal true setglobal
[ /ASCIIHexDecode /ASCIIHexEncode /ASCII85Decode /ASCII85Encode
  /LZWDecode /LZWEncode /RunLengthDecode /RunLengthEncode
  /FlateDecode /FlateEncode /CCITTFaxDecode /CCITTFaxEncode
  /DCTDecode /DCTEncode /NullEncode /SubFileDecode /ReusableStreamDecode ]
{ dup /Filter defineresource pop } forall
setglobal

%
%  User paths: the self-describing form is an executable array of the
%  path operators below; the encoded form pairs an operand source (a
%  number array or encoded number string) with a string of opcodes,
%  where an opcode of 32 or more repeats the following operator that
%  many fewer than its value times
%
% The box is advisory here.
/setbbox [ /numbertype /numbertype /numbertype /numbertype ] { pop pop pop pop } .defop  % llx lly urx ury  .  -

%
%  Ask that the user path being built be cached (PLRM 8.2). This
%  interpreter caches no user paths, so the request is accepted and
%  nothing is done with it.
%
/ucache [ ] {} .defop  % -  .  -

currentglobal true setglobal
.xpostsys /.upathops [ /setbbox /moveto /rmoveto /lineto /rlineto /curveto
             /rcurveto /arc /arcn /arct /closepath /ucache ] readonly put
setglobal
currentglobal true setglobal
.xpostsys /.upathargs [ 4 2 2 2 2 6 6 5 5 5 0 0 ] readonly put

%
%  A spec names an object type, or one of two families: numbertype for
%  either number, proctype for an executable array.
%
.xpostsys /.argok {  % obj /spec  .  bool
    dup /anytype eq { pop pop true }{
    dup /numbertype eq {
        pop type dup /integertype eq exch /realtype eq or
    }{
    dup /proctype eq {
        pop dup xcheck exch type dup /arraytype eq exch /packedarraytype eq or and
    }{
        exch type eq
    } ifelse } ifelse } ifelse
} put

%
%  The operands an operator takes, listed in operand order. The count is
%  settled before the types, so a short stack reports the shortage.
%
.xpostsys /.checkargs {  % /opname [ specs ]  .  -
    2 dict begin
    /a.t exch def /a.op exch def
    count a.t length lt { a.op cvx /stackunderflow signalerror } if
    0 1 a.t length 1 sub {
        /a.i exch def
        a.t length 1 sub a.i sub index
        a.t a.i get
        //.argok exec not
            { a.op cvx /typecheck signalerror } if
    } for
    end
} put

%
%  Install the procedure as an operator stating the operands it takes, in
%  operand order, so the dispatcher enforces the statement before the
%  procedure runs, exactly as for an operator written in C. The statement
%  is the one the definition recorded in .opsigs, and the promotion runs
%  over those statements, so there is always one to read. The operator
%  goes back into the dictionary its name was found in, which is not
%  always userdict: some of the standard operators written in PostScript
%  are defined straight into systemdict.
%
.xpostsys /.wrapwithsig {  % dict name proc  .  -
    3 dict begin
    /w.proc exch def /w.name exch def /w.dict exch def
    w.dict w.name
    w.name /w.proc load
    //.opsigs w.name get .wrapopsig
    put
    end
} put

.xpostsys /.upathopset <<
    /setbbox 4 /moveto 2 /rmoveto 2 /lineto 2 /rlineto 2 /curveto 6
    /rcurveto 6 /arc 5 /arcn 5 /arct 5 /closepath 0 /ucache 0
>> readonly put
setglobal

currentglobal true setglobal

%
%  A user path is an executable array of numbers and user-path operator
%  names, or the encoded pair of an argument list and an operator string.
%
%  .upathops names the operators a user path may carry and .upathargs
%  how many numbers each of them takes, in the same order.
%
.xpostsys /.upathcheck {  % obj  .  obj
    4 dict begin
    /u.p exch def
    /u.pend 0 def
    /u.p load type dup /arraytype ne exch /packedarraytype ne and
        { /uappend cvx /typecheck signalerror } if
    /u.p load xcheck {
        0 1 /u.p load length 1 sub {
            /u.p load exch get
            dup type dup /integertype eq exch /realtype eq or {
                pop /u.pend u.pend 1 add def
            }{
                dup type /nametype eq not
                    { /uappend cvx /typecheck signalerror } if
                //.upathopset 1 index known not
                    { /uappend cvx /typecheck signalerror } if
                //.upathopset exch get u.pend ne
                    { /uappend cvx /typecheck signalerror } if
                /u.pend 0 def
            } ifelse
        } for
        u.pend 0 ne { /uappend cvx /typecheck signalerror } if
    }{
        /u.p load length 2 ne { /uappend cvx /typecheck signalerror } if
        /u.p load 0 get type dup /stringtype ne exch /arraytype ne and
            { /uappend cvx /typecheck signalerror } if
        /u.p load 1 get type dup /stringtype ne exch /arraytype ne and
            { /uappend cvx /typecheck signalerror } if
    } ifelse
    /u.p load
    end
} put
setglobal

%
%  Append a user path to the current path (PLRM 8.2). A user path is an
%  executable array of numbers and path-operator names, or the encoded
%  pair of an argument list and an operator string; both forms are
%  checked before anything is appended, so a malformed one leaves the
%  current path alone.
%
%  ufill, ueofill, ustroke and their insideness counterparts all reach
%  the current path through here.
%
/uappend [ /arraytype ] {  % userpath  .  -
    //.upathcheck exec
    dup xcheck {
        exec
    }{
        8 dict begin
        dup 0 get dup type /stringtype eq { .numstring2array } if
        /args exch def
        1 get /ops exch def
        /ai 0 def
        /rep 1 def
        0 1 ops length 1 sub {
            ops exch get
            dup 31 gt {
                32 sub /rep exch def
            }{
                % A repeat count precedes an operator so that one run of
                % arguments feeds it several times -- three coordinate pairs
                % through one lineto. An operator that takes no arguments,
                % closepath or ucache, consumes nothing however often it is
                % repeated, so it never reaches the argument that would run
                % out and bound the count: a single token could ask for it
                % two billion times. An operator that does take arguments is
                % bounded already, by the arguments running out. So a repeat
                % of a no-argument operator is refused; an out-of-range
                % operator is refused by the .upathargs fetch below.
                /op exch def
                //.upathargs op get 0 eq  rep 1 gt  and {
                    /uappend cvx /rangecheck signalerror
                } if
                rep {
                    //.upathargs op get { args ai get /ai ai 1 add def } repeat
                    //.upathops op get cvx exec
                } repeat
                /rep 1 def
            } ifelse
        } for
        end
    } ifelse
} .defop

currentglobal true setglobal

%
%  Matrix and user path operands tell apart by shape: a matrix is a
%  six-element literal array of numbers.
%
.xpostsys /.isupmat {  % obj  .  obj bool
    dup type /arraytype eq
    1 index xcheck not and
    1 index length 6 eq and
    { dup 0 get type dup /integertype eq exch /realtype eq or }
    { false } ifelse
} put
setglobal

%  Each paints on a graphics state of its own so the caller's path is
%  left alone, and each goes through the callout bracket for the same
%  reason rectfill does: a pattern's paint procedure may raise from
%  inside that state, and the grestore written after the paint is not
%  reached then.
/ufill [ /arraytype ] {  % userpath  .  -
    { gsave newpath uappend fill grestore }
    null 0 //.xpostsys /.callout get exec } .defop
/ueofill [ /arraytype ] {  % userpath  .  -
    { gsave newpath uappend eofill grestore }
    null 0 //.xpostsys /.callout get exec } .defop

%
%       userpath  .  -
%  userpath matrix  .  -
%
%
%  Stroke a user path (PLRM 8.2), optionally under a matrix concatenated
%  to the CTM after the path is built and before it is stroked -- which
%  is how a program strokes a shape at one scale with a pen at another.
%
/ustroke [ /arraytype ] {
    {
    //.isupmat exec {
        gsave newpath exch uappend concat stroke grestore
    }{
        gsave newpath uappend stroke grestore
    } ifelse
    } null 0 //.xpostsys /.callout get exec
} .defop

%
%       userpath  .  -
%  userpath matrix  .  -
%
%
%  The outline ustroke would paint, left as the current path (PLRM 8.2),
%  so that a caller may fill or clip with it.
%
/ustrokepath [ /arraytype ] {
    //.isupmat exec {
        matrix currentmatrix 3 1 roll
        exch newpath uappend
        concat strokepath
        setmatrix
    }{
        newpath uappend strokepath
    } ifelse
} .defop

%
%  The current path, written as a user path in current user space.
%
/upath [ /booleantype ] {  % bool  .  userpath
    [ exch { /ucache cvx } if
      pathbbox /setbbox cvx
      { /moveto cvx }{ /lineto cvx }{ /curveto cvx }{ /closepath cvx }
      pathforall
    ] cvx
} .defop

%
%  Route document metadata to a device that can carry it (the pdfwrite
%  device collects DOCINFO into its trailer); every other mark type,
%  and marks on devices without metadata, are consumed without effect.
%  The body is bound by the sweep that runs once graphics has loaded,
%  not here: DEVICE is not yet an operator at this point, and a bind
%  here would leave the name loose and the body read-only, so the sweep
%  could never come back for it and a program redefining DEVICE would
%  reach inside this one.
%
/pdfmark {  % mark key value ... /TYPE  .  -
    counttomark 0 gt {
        dup /DOCINFO eq DEVICE /.docinfo known and {
            pop
            counttomark 2 idiv {
                DEVICE /.docinfo get 3 1 roll put
            } repeat
        } if
    } if
    cleartomark
} def

%
%
%  The parameters that steer PDF production. This build produces PDF through the
%  pdfwrite device, which setpagedevice configures; setdistillerparams records
%  whatever a program sets and currentdistillerparams hands the set back, so a
%  program that configures production through them runs. Only the parameters
%  this build acts on are seeded, so a default read reports what is honoured
%  rather than a knob that does nothing: CompressPages leaves the pdfwrite
%  content stream uncompressed, PreserveOverprintSettings keeps the overprint
%  state in the output, and LockDistillerParams, once true, holds the recorded
%  set against further change. Any other parameter a program sets is still
%  accepted and read back.
%
.jobstore /.distillerparams <<
    /CompressPages true
    /PreserveOverprintSettings true
    /LockDistillerParams false
>> put

%
%  Record the distiller parameters a job asks for (an Adobe extension).
%  The entries are kept and read back; the PDF writer consults the ones
%  it implements and the rest are carried for the job's own sake.
%
/setdistillerparams [ /dicttype ] {  % dict  .  -
    //.distillerparams /LockDistillerParams get {
        pop
    }{
        { //.distillerparams 3 1 roll put } forall
    } ifelse
} .defop

%
%  The distiller parameters recorded, as a dictionary the job may read.
%
/currentdistillerparams [ ] {  % -  .  dict
    //.distillerparams dup length dict copy
} .defop

%
%  /fontname size  .  -
%  /fontname matrix  .  -
%
%
%  findfont and scalefont and setfont in one (PLRM 8.2), taking either a
%  size or a matrix.
%
%  A font already scaled the way it is asked for is used as it stands,
%  which is what makes selectfont worth having over spelling the three
%  out.
%
/selectfont [ [ /anytype /numbertype ] [ /anytype /arraytype ] ] {
    dup type /arraytype eq {
        exch findfont
        exch makefont
        setfont
    }{
        exch findfont
        exch scalefont
        setfont
    } ifelse
} .defop

%
%  x y w h
%
currentglobal true setglobal   % Global .xpostsys helpers

%
%  .n2a decodes an encoded-number-string into a plain array, for the numstring forms
%
.xpostsys /.n2a /.numstring2array load put

%
%  Counter-clockwise in device space; appends one rectangle subpath.
%
.xpostsys /.rect1 {  % x y w h  .  -
    dtransform 4 2 roll transform 4 2 roll
    dup 0 gt { neg 3 2 roll 1 index sub 3 1 roll } if
    1 index 0 lt { exch neg 4 3 roll 1 index sub 4 1 roll exch } if
    idtransform 4 2 roll itransform
    2 copy 6 2 roll
    moveto
    1 index 0 rlineto
    0 exch rlineto
    neg 0 rlineto
    lineto
} put

%
%    x y w h  .  -
%   numarray  .  -
%  numstring  .  -
%
%  One rectangle from four numbers, or n rectangles from a numarray or
%  numstring holding 4n numbers (PLRM 8.2).
%
.xpostsys /.rect {
    dup type /stringtype eq { //.xpostsys /.n2a get exec } if
    dup type /arraytype eq {
        1 dict begin /.a exch def
        0 4 .a length 1 sub {
            .a exch 4 getinterval aload pop //.rect1 exec
        } for
        end
    }{
        //.rect1 exec
    } ifelse
} put
setglobal

%
%  The painting pair works on its own path and leaves the caller's untouched;
%  rectclip clips by the rectangles alone and clears the path, as the language
%  specifies. rectstroke also accepts a trailing matrix, which is concatenated
%  to the CTM after the path is built but before stroking (PLRM 8.2).
%  Each takes four numbers, or the same numbers gathered into an array
%  or encoded in a string; rectstroke takes the matrix on top of any of
%  those, so its longer shapes are stated first to get first refusal.
%
%  rectfill fills them, rectstroke strokes them, and rectclip clips to
%  them.
%
%  The pair that paints works on a graphics state of its own, so the
%  caller's path is left alone. That state is the operator's and not the
%  program's: a callback the fill reaches -- a pattern's paint procedure
%  is the one that escapes -- may raise from inside it, and the grestore
%  written after the fill is not reached then. So the whole body goes
%  through the callout bracket, which closes what the body opened
%  whichever way the body ends.
/rectfill [ [ /numbertype /numbertype /numbertype /numbertype ]
            [ /arraytype ] [ /stringtype ] ]
    {  % x y w h | numarray | numstring  .  -
      { gsave newpath //.rect exec fill grestore }
      null 0 //.xpostsys /.callout get exec }
    .defop
/rectstroke [ [ /numbertype /numbertype /numbertype /numbertype /arraytype ]
              [ /numbertype /numbertype /numbertype /numbertype ]
              [ /arraytype /arraytype ] [ /stringtype /arraytype ]
              [ /arraytype ] [ /stringtype ] ] {  % x y w h [matrix] | numarray [matrix] | numstring [matrix]  .  -
    {
    gsave newpath

    % A trailing matrix is a six-element array; a numarray always holds 4n
    % numbers, so length six is unambiguously the optional stroke matrix
    dup type /arraytype eq { dup length 6 eq }{ false } ifelse
        { 1 dict begin /.m exch def //.rect exec .m concat end }
        { //.rect exec }
    ifelse
    stroke grestore
    } null 0 //.xpostsys /.callout get exec
} .defop
/rectclip [ [ /numbertype /numbertype /numbertype /numbertype ]
            [ /arraytype ] [ /stringtype ] ]
    {  % x y w h | numarray | numstring  .  -
      newpath //.rect exec clip newpath }
    .defop

currentglobal true setglobal

%
%  Load graphics support. Global: the device-maker procedures baked into this
%  body are global, matching the global .xpostsys their table installs into.
%
.xpostsys /.loadgraphics {  % -  .  -
    % The load records its own completion below, so a lockdown that stops
    % after it does not send it round again. A locked-down interpreter is
    % the other answer to the same question: systemdict is shut for good
    % by then, so the language it has is the language it keeps.
    //.internaldict /GRAPHICS_LOADED known
    //.internaldict /LOCKDOWN_DONE known or { }{
        % A load that stopped is not attempted again, and every attempt
        % after the first answers with what stopped the first. The load
        % happens once in the life of a context because not all of what
        % it leaves behind is virtual memory: the writeable window on
        % systemdict closes on a one-shot held in the context, and once
        % that is spent a second reading has nowhere to define and stops
        % at its first definition, under a name of its own. $error holds
        % one error, the most recent, so that name would be the one the
        % caller is told about instead of the limit the interpreter
        % really reached.
        //.internaldict /GRAPHICS_LOAD_STOPPED known {
            //.internaldict /GRAPHICS_LOAD_STOPPED get
            dup null eq
                { pop stop }
                { /.loadgraphics cvx exch signalerror }
            ifelse
        } if

        % The depth the dictionary stack has here is the depth it is put
        % back to below. The language is read with systemdict open and
        % current, so a reading that stopped part way and left it current
        % would leave every definition made afterwards aimed at a
        % dictionary that has just been closed.
        .internaldict /GRAPHICS_LOAD_DEPTH countdictstack put
        {
            % Open the writeable window on systemdict before the language is
            % read. The finalizer closes it, and closing it spends the
            % one-shot, so a program cannot reopen it.
            .sysdictunlock

            (/callout.ps) //.loadmodule exec

            currentglobal true setglobal

            % Page device selection and configuration. Keys:
            %   /OutputDevice   name from the device table (defaults to the
            %                   device the interpreter started with)
            %   /PageSize       [w h] points (default 612x792)
            %   /HWResolution   [rx ry] dots per inch (default [72 72])
            %   /OutputFile     output path for the device
            %   /PageOffset     [x y] points, translated after initgraphics
            %   /ImagingBBox    [llx lly urx ury] points, or null for the whole
            %                   page: the boundary the program says it paints
            %                   within, which a device may hold less than the
            %                   page for (PLRM 6.2)
            % Every other key is stored on the device dictionary, which is how
            % device features (TextAlphaBits, WhiteIsOpaque, the codec knobs
            % png_compression_level, png_interlaced, png_filter, jpeg_quality,
            % ...) are reached. They arrive there twice: written onto the
            % instance as it is copied from its class, so a driver reading one
            % as the device is created sees it, and again on the finished
            % device.
            % Same-device requests merge over the previous ones, so a partial
            % dictionary adjusts the page; switching OutputDevice starts from
            % the new device's defaults. The outgoing device is destroyed, the
            % new device is installed in the graphics state template, and the
            % page is reinitialised.
            % The device roster. -d and setpagedevice are two spellings of one
            % selection, so this names every device the interpreter can be
            % started with (xpost_interpreter.c setlocalconfig, held to it by
            % tests/check-device-roster.sh). A device selectable only by -d is
            % worse than merely unreachable by name: a request naming no device
            % defaults to the running one, so on such a device every
            % setpagedevice raises rangecheck and the page cannot be resized.
            %
            % Move the features a page-device request left pending into the
            % slot the class-to-instance copy takes (.devrequest). Run by every
            % device maker, after whatever driver loading the maker does: a
            % driver's class build copies through the same procedure an
            % instance does, so features armed across a load would be taken
            % onto the class -- becoming a device's defaults -- and the
            % instance they were asked for would never see them. A maker asked
            % for with nothing pending arms nothing.
            .xpostsys /.armdevrequest {  % -  .  -
                graphicsdict /.devpending 2 copy known {
                    2 copy get 3 1 roll undef
                    graphicsdict /.devrequest 3 -1 roll put
                }{ pop pop } ifelse
            } bind put
            setglobal

            currentglobal true setglobal

            % Every maker lives in privatedict, the ones the boot files define
            % and the ones a C driver registers alike. A driver's is not there
            % until its loader has run -- the driver is brought in on first use
            % rather than at startup -- so those makers look first and load on
            % a miss, the load leaving the maker where the look looked. The
            % dictionary is sealed at the lockdown and the loader writes it
            % through the interpreter's own store, so what a name here answers
            % with is what the interpreter put there.
            %
            % Each entry arms the request: the features a page-device request
            % left pending are moved into the slot the class-to-instance copy
            % takes (.armdevrequest), after whatever loading the entry does.
            % After, because a driver's class build copies through the same
            % procedure an instance does: a build that ran with the features
            % armed would take them onto the class -- a device's defaults --
            % and the instance they were asked for would never see them.
            .xpostsys /.devicemakers <<
                /pgm {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newPGMIMAGEdevice get exec }
                /pbm {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newPBMIMAGEdevice get exec }
                /ppm {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newPPMIMAGEdevice get exec }
                /tiff {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newTIFFIMAGEdevice get exec }
                /null {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newnulldevice get exec }
                /bbox {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newbboxdevice get exec }
                /pdfwrite {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newPDFWRITEdevice get exec }
                /svgwrite {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newSVGWRITEdevice get exec }
                /dscwrite {  % width height  .  device
                       //.xpostsys /.armdevrequest get exec
                       .privatedict /newDSCWRITEdevice get exec }
                /png {  % width height  .  device
                       .privatedict /newpngdevice 2 copy known not
                       { loadpngdevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /pngalpha {  % width height  .  device
                       .privatedict /newpngalphadevice 2 copy known not
                       { loadpngalphadevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /jpeg {  % width height  .  device
                       .privatedict /newjpegdevice 2 copy known not
                       { loadjpegdevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /bgr {  % width height  .  device
                       .privatedict /newbgrdevice 2 copy known not
                       { loadbgrdevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /raster {  % width height  .  device
                       .privatedict /newrasterdevice 2 copy known not
                       { loadrasterdevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /record {  % width height  .  device
                       .privatedict /newrecorddevice 2 copy known not
                       { loadrecorddevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /xcb {  % width height  .  device
                       .privatedict /newxcbdevice 2 copy known not
                       { loadxcbdevice } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /gdi {  % width height  .  device
                       .privatedict /newwin32device 2 copy known not
                       { loadwin32device } if
                       //.xpostsys /.armdevrequest get exec get exec }
                /gl {  % width height  .  device
                       .privatedict /newwin32device 2 copy known not
                       { loadwin32device } if
                       //.xpostsys /.armdevrequest get exec get exec }
            >> put

            % A driver the build left out registers no loader, so the maker
            % above would answer undefined. Drop those entries instead, and an
            % unbuilt device gets the same rangecheck as a name that was never
            % a device at all.
            <<
                /png /loadpngdevice  /pngalpha /loadpngalphadevice
                /jpeg /loadjpegdevice
                /bgr /loadbgrdevice  /raster /loadrasterdevice
                /record /loadrecorddevice
                /xcb /loadxcbdevice
                /gdi /loadwin32device  /gl /loadwin32device
            >> {
                where { pop pop }{ .xpostsys /.devicemakers get exch undef } ifelse
            } forall

            % Sealed now the roster is settled. Each entry is a procedure a
            % page-device request runs to build the device it names, so a
            % roster a program could write into is one that decides what runs
            % as the device: an entry of the program's own would be executed
            % by the next setpagedevice. The roster is in global virtual
            % memory, where a restore does not reach, so a write would stand
            % for the rest of the job. It is complete here -- the entries are
            % stated above and the drivers this build left out have just been
            % dropped -- and nothing writes it afterwards.
            % Each maker is sealed before the roster is, because a
            % procedure's access is the reference's own rather than the
            % object's: an array read back out of a sealed dictionary is
            % writable unless the sealed one was put there sealed. A
            % maker whose body could be written is a maker that decides
            % what runs as the device just as an entry of the program's
            % own would.
            [ .xpostsys /.devicemakers get { pop } forall ] {
                .xpostsys /.devicemakers get exch 2 copy get readonly put
            } forall
            .xpostsys /.devicemakers get readonly pop
            setglobal

            systemdict begin

            % The language is read into systemdict, but this pair is defined here,
            % by .loadgraphics itself, after callout.ps has returned and closed the
            % block that made systemdict current. They name it so they land with the
            % operators they belong beside rather than in the program's namespace.
            /setpagedevice [ /dicttype ] {  % pagedevicedict  .  -
                % A handler that cannot be run is refused here, not at the page
                % boundary where finding out would leave the page half made. The
                % refusal comes before the working dictionary is opened, so a
                % caught one does not leave the dictionary stack deeper than it
                % was found.
                dup //.xpostsys /.checkpagehandlers get exec pop

                % And a device feature whose value is not of the type the
                % machinery reads it as, refused where the request naming it can
                % still be told about it.
                dup //.xpostsys /.checkpagefeatures get exec pop

                % And the page geometry, held to the shape PLRM 6.2
                % Table 6.1 gives it: two numbers each for PageSize,
                % HWResolution and PageOffset, four or null for
                % ImagingBBox. The arithmetic below indexes whatever it
                % is handed, so a value of another shape read there is a
                % page nobody asked for rather than a request that could
                % be answered.
                dup //.xpostsys /.checkpagegeometry get exec pop

                % And the recovery policies the request revises, held to the
                % codes PLRM 6.2.7 defines for them. A policy is consulted
                % only where something else could not be met, so a misspelled
                % one left to be read then would be found missing at the one
                % moment a program most needs the answer.
                dup //.xpostsys /.checkpagepolicies get exec pop

                % The working dictionary is opened through the bracket that
                % takes it off again however the body ends, error included
                % (.indict, callout.ps): a program that catches a refused
                % request, or the failure of a device that could not be made,
                % is left the dictionary stack it called with.
                28 dict {
                /pd exch def

                % PLRM 6.2.6: an operator that deactivates the page device calls
                % EndPage as its first action, and transmits the page it ends only
                % if EndPage says to. The standard answer for a device going away
                % is not to, so a device carrying no handler emits nothing here.
                %
                % A handler that fails is not allowed to stop the device standing
                % down. Letting the failure out would leave the page device
                % impossible to replace -- every later attempt would run the same
                % handler and fail the same way -- so the device would be stuck
                % behind a procedure the program can no longer reach to fix. The
                % page is ending regardless, so a failure is read as the standard
                % answer and the handover goes ahead. showpage and copypage do let
                % such a failure out, where the program can catch it and try again.
                %
                % What the call left behind is dropped by counting back to
                % where the operand stack stood rather than back to a mark:
                % the handler is the program's and may empty the stack, a
                % mark included, and the operator would then fail over the
                % mark it could not find -- which is the device stuck behind
                % its handler again, by the other road.
                /xmit false def
                /xbase count def
                % 1: setpagedevice's own working dictionary stands open
                % over the program's scope here, and the handler is the
                % program's, so it comes off too while the handler runs.
                { 1 2 //.xpostsys /.endpage get exec /xmit exch store }
                stopped { } if
                count xbase sub dup 0 gt { { pop } repeat }{ pop } ifelse
                xmit {
                    /DEVICE where { pop
                        DEVICE type /dicttype eq { DEVICE //.xpostsys /.transmitpage get exec } if
                    } if
                } if

                % PLRM 6.2.7: the revisions a request makes to Policies take
                % effect before the rest of it is looked at, so what governs
                % this request is the policies in force as this request leaves
                % them. They are settled before the merge below because one of
                % the questions they answer -- whether the request may have the
                % output device it names -- decides how that merge goes.
                /policies
                    graphicsdict /.pagedevice 2 copy known {
                        get /Policies 2 copy known { get }
                        { pop pop //.xpostsys /.defaultpolicies get exec } ifelse
                    }{ pop pop //.xpostsys /.defaultpolicies get exec } ifelse
                    pd //.xpostsys /.mergepolicies get exec
                def

                % Each parameter of this request that could not be satisfied,
                % against the code that governed it, for the PolicyReport this
                % request ends with.
                /report 8 dict def

                % A parameter this interpreter cannot provide, under a policy
                % that will not have it ignored. Code 0 abandons the request,
                % and code 2 -- interact with a human operator -- abandons it
                % too, there being no operator to ask and no panel to ask on,
                % which PLRM 6.2.7 gives as what a device without one does.
                % Both name the entry in $error first (PLRM 8.2).
                %
                % The bracket around the body closes the working dictionary
                % as the error leaves it, so a program that catches the
                % refusal is not left standing in it.
                /refuse {  % key value  .  -
                    //.xpostsys /.setpageinfo get exec
                    /setpagedevice cvx /configurationerror signalerror
                } def

                % A request naming an output device this interpreter cannot
                % make is an unsatisfied request for OutputDevice. Ignoring it
                % keeps the device already installed, so the request goes on as
                % one that named no device at all -- which is why it is settled
                % here, ahead of the merge that a device change would empty.
                /keepdev false def
                pd /OutputDevice 2 copy known {
                    get dup //.xpostsys /.devicemakers get exch known
                    { pop }{
                        policies /OutputDevice //.xpostsys /.policyfor get exec
                        1 eq {
                            /keepdev true store
                            report /OutputDevice 1 put
                            pop
                        }{ /OutputDevice exch refuse } ifelse
                    } ifelse
                }{ pop pop } ifelse

                % Requests merge with the accumulated parameters, except that
                % switching OutputDevice reinstalls the new device's defaults:
                % nothing carries across a device change.
                /switching
                keepdev not
                pd /OutputDevice 2 copy known {
                    get graphicsdict /.pagedevice 2 copy known {
                        get /OutputDevice 2 copy known
                        { get }{ pop pop null } ifelse
                    }{ pop pop null } ifelse ne
                }{ pop pop false } ifelse
                and def
                /merged switching
                { pd length 8 add dict }
                { graphicsdict /.pagedevice 2 copy known
                    { get dup length pd length add dict copy }
                    { pop pop pd length 8 add dict }
                    ifelse }
                ifelse def
                % A key that is not a page-device parameter is dropped
                % rather than carried onto the device (.pagedeviceparams,
                % data/device.ps): the parameters are what a request may
                % state, and a device dictionary holds its painting
                % procedures under ordinary names beside them.
                pd {
                    1 index /Policies eq
                    2 index /OutputDevice eq keepdev and or
                    2 index //.xpostsys /.pagedeviceparams get exch known not or
                    { pop pop }{ merged 3 1 roll put } ifelse
                } forall

                % Policies is merged rather than replaced, and a device change
                % starts from this interpreter's own again: nothing carries
                % across one, these no more than the rest.
                merged /Policies
                    switching
                    { //.xpostsys /.defaultpolicies get exec pd
                      //.xpostsys /.mergepolicies get exec }
                    { policies } ifelse
                put
                /policies merged /Policies get store

                % A BOUND ON WHAT ACCUMULATES, AND WHY IT CANNOT GO.
                %
                % The accumulated parameters are copied whole on every
                % call, so that a restore can revert the slot to the
                % dictionary a save saw, and .mergepolicies rebuilds the
                % policies into a dictionary of its own for the same
                % reason and to keep a program that held on to the
                % dictionary it asked with from rewriting what is in
                % force. Both copies are load-bearing; neither can be
                % skipped.
                %
                % Policies is what grows. Its entries are cumulative
                % (PLRM 6.1.1) and its keys are not held to the
                % parameters this interpreter has: a policy may be stated
                % for a parameter it does not provide, and is kept, so a
                % program naming a fresh one on every call adds a key
                % each time. Copying a dictionary that grows by one per
                % call costs the square of the calls, and there is no
                % ceiling short of the dictionary size limit.
                %
                % So the count is bounded here, over the parameters and
                % the policies together, well above the parameters there
                % are and any policy a page description would state. It
                % is not the top-level key count that needs this -- those
                % are held to the parameter list already -- which is why
                % the bound counts the policies too.
                merged length
                merged /Policies 2 copy known { get length }{ pop pop 0 } ifelse
                add 512 gt {
                    /setpagedevice cvx /limitcheck signalerror
                } if

                % PLRM 6.1.1: a request naming a page-device parameter this
                % interpreter provides no behaviour for cannot be satisfied --
                % whatever value it asks for, one turning the feature off
                % included -- and the policy governing it says what becomes of
                % it. Ignoring one leaves it off the page device, there being
                % no value of this interpreter's own to report for a feature it
                % has not.
                pd {
                    1 index //.xpostsys /.pagedeviceabsent get exch known {
                        policies 2 index //.xpostsys /.policyfor get exec
                        1 eq {
                            merged 2 index undef
                            report 2 index 1 put
                            pop pop
                        }{ refuse } ifelse
                    }{ pop pop } ifelse
                } forall

                /dev merged /OutputDevice 2 copy known { get }{ pop pop
                    graphicsdict /.outputdevice 2 copy known
                    { get }{ pop pop /pgm } ifelse
                } ifelse def
                % The device the request named was held to the roster above.
                % This holds the one the run itself settled on, which a request
                % naming no device inherits.
                //.xpostsys /.devicemakers get dev known not {
                    /setpagedevice cvx /rangecheck signalerror
                } if
                /res merged /HWResolution 2 copy known { get }{ pop pop [72 72] } ifelse def
                /size merged /PageSize 2 copy known { get }{ pop pop [612 792] } ifelse def
                /off merged /PageOffset 2 copy known { get }{ pop pop [0 0] } ifelse def
                /sx res 0 get 72 div def
                /sy res 1 get 72 div def
                % raster buffers need whole pixels, but the page itself need not
                % be integral: a vector device adopts the exact dimensions (its
                % width and height are points, written into its output syntax)
                /pwf size 0 get sx mul def
                /phf size 1 get sy mul def
                % The medium is the nearest whole pixel to the page.
                % PLRM 6.2.7 describes both a nearest medium and a next
                % larger one and does not choose between them, so the page a
                % program describes is the same either way and only the medium
                % under it differs. Rounded down, the far edge of the page
                % falls outside the medium and is clipped, which is what that
                % section says of a medium smaller than the page.
                /pw pwf 0.5 add floor cvi def
                /ph phf 0.5 add floor cvi def

                graphicsdict /.exactpagedims [pwf phf] put

                % PLRM 6.2: a program supplying an imaging bounding box asserts
                % that it paints no marks outside it, and applications are asked
                % to supply one wherever they can, since a device is then free to
                % hold less of the page than the page. The run of rows the box
                % reaches is left here for the device about to be made; a device
                % that holds its page some other way never asks for it.
                merged /ImagingBBox 2 copy known {
                    get size 1 get off 1 get sy ph
                    //.xpostsys /.imagingrows get exec
                    dup null eq { pop }{ graphicsdict /.rasterband 3 -1 roll put } ifelse
                }{ pop pop } ifelse

                % The device features of this request: every accumulated key the
                % page machinery does not read itself. Split out once, because
                % they go to the device twice -- left pending here, armed by the
                % maker below after any driver loading it does (.armdevrequest,
                % which is what keeps a driver's own class build from taking
                % them), and taken by the class-to-instance copy, which writes
                % them onto the instance as it is born (.classcopydict,
                % data/device.ps), so that a key a device reads as it is
                % created is on its dictionary by then; and put onto the
                % finished device again below, where the completion reads
                % them. A maker that stops between the arming and the copy
                % leaves the armed entry standing, which is the .rasterband
                % residue again: every route that makes a device arms before
                % its Create, so a leaving is overwritten and never inherited.
                /feat merged length dict def
                merged {  % key value
                    1 index /OutputDevice eq
                    2 index /PageSize eq or
                    2 index /HWResolution eq or
                    2 index /OutputFile eq or
                    2 index /PageOffset eq or
                    2 index /Policies eq or
                    { pop pop }{ feat 3 1 roll put } ifelse
                } forall

                % The output binding is a page-device parameter: a request's
                % /OutputFile is the one way a program changes it, and it goes
                % to the device among the features, under the spelling the
                % machinery reads. What is stored is a copy made read-only
                % here, so the path the file-permit machinery vets at the open
                % is the path the page goes to -- a program keeping a reference
                % to its request's own string cannot steer the output after the
                % request was checked. The copy is stored back on the
                % accumulated request as well, which is what currentpagedevice
                % reports; like every parameter it accumulates on the device
                % and a device switch starts from the new device's defaults,
                % the run's own -o binding among them.
                merged /OutputFile 2 copy known {
                    get dup length string copy readonly
                    dup merged /OutputFile 3 -1 roll put
                    feat /OutputFileName 3 -1 roll put
                }{ pop pop } ifelse
                graphicsdict /.devpending feat put

                % The new device builds under its own local name -- DEVICE
                % everywhere means the accessor reading the graphics state, and
                % the machinery's frozen references to it must not see the
                % half-configured newcomer.
                % The incumbent is still whole here, and stays whole until this
                % returns: a maker can fail at run time -- no display to open, an
                % output path that will not take a file, dimensions that admit no
                % buffer -- and a program that catches that error goes on painting
                % on the device it already had. Retiring the incumbent first would
                % leave the graphics state naming a device whose buffers are freed,
                % so the next mark made after the caught error reads freed memory.
                % Which device that name is made through at the page this request
                % asks for. A page too large for the band budget to cover is made
                % through the recording class, which holds it in less memory than
                % the page, and a page the budget covers is made on the device
                % named, recording nothing (.devicefor, data/recorddev.ps). It is
                % weighed here as well as where the run's own device was made
                % (.startdevice, data/device.ps), because declaring a page is how
                % a program states one: a job that opens at the standard page and
                % asks for a long one is a job whose pages are the one it asked
                % for, and weighing only the page it opened at would hold every
                % one of them whole.
                %
                % Here rather than anywhere else in the job, because this is
                % where a page description has already given up what it knew of
                % the device before: the page is erased and the device replaced
                % whatever the answer is, so nothing has been painted that a
                % change of route could lose. What PLRM Appendix G bars a page
                % description from -- choosing how its marks are held -- it is no
                % nearer to here, since the same page is weighed the same way
                % whatever the request was trying to arrange.
                %
                % The name below is the device the request asked of, and this
                % answer is only which device is made from it, so the route is
                % nowhere recorded as a device name and every later request is
                % weighed from the selection again.
                /made dev pw ph //.xpostsys /.devicefor get exec def
                /newdev pw ph //.xpostsys /.devicemakers get made get exec def
                graphicsdict /.exactpagedims undef
                graphicsdict /.rasterband undef

                % Retire the outgoing device (Destroy frees its buffers; a
                % vector device's output was written by showpage's Emit)
                /DEVICE where { pop
                    DEVICE type /dicttype eq {
                        DEVICE dup /Destroy 2 copy known { get exec }{ pop pop pop } ifelse
                    } if
                } if

                % The device features again, on the finished device before the
                % completion reads them: the process colour model arrives among
                % them, and which marking methods fit the device depends on it.
                % The copy above already wrote them onto the instance the maker
                % built; this writes the same values, and is what puts them on a
                % device whose class carries a copy procedure of its own.
                feat { newdev 3 1 roll put } forall
                merged /OutputDevice dev put
                graphicsdict /.pagedevice merged put

                % Post-construction fixups, the same ones the device the
                % interpreter started with receives (data/device.ps).
                newdev sx sy .privatedict /.completedevice get exec

                % The template and the live gstate carry the device; painting
                % and the defaultmatrix operator resolve it through them
                % what was held for the device being replaced, given up before
                % anything can reach for it: a drawing carries the colour space
                % of the device its marks were made for.
                //.formcachedrop exec
                .privatedict /.gstatetemplate get exec /device newdev put
                graphicsdict /currgstate get /device newdev put

                % Record the installed device against the save depth it was
                % installed at. A restore back past this point puts the previous
                % device into the template again and leaves this one holding a
                % raster or a content accumulator that is not virtual memory, so
                % the collector will neither reach it nor free it; the record is
                % what lets restore retire it there. After the two puts above,
                % because it names the device the template now carries.
                newdev //.internaldict /.devinstalled get exec

                % Installing a device reinitialises the whole graphics state
                % barring the font parameter, which is more than initgraphics
                % resets: the device-dependent parameters go back to defaults
                % too, since they described the device being retired.
                //.xpostsys /.initdevicegstate get exec

                % PLRM 6.2.6: the page device's Install procedure runs once
                % the device is set up and installed in the graphics state,
                % and before the page is erased and the graphics state
                % reinitialised. It is the place a program sets the
                % device-dependent parameters that describe how this device
                % renders -- the halftone screen, the colour rendering
                % dictionary, the flatness -- since the reset above has just
                % put them back to their defaults and the reinitialisation
                % below leaves them where the procedure puts them.
                %
                % The procedure run is the accumulated one and not this
                % request's, so a request naming no Install runs the one
                % already in force; and it runs before the page begins,
                % which is where BeginPage is run.
                %
                % It goes through the callout bracket (.callout,
                % callout.ps), which names the working dictionary as the one
                % to take off while the procedure runs. The procedure is the
                % program's, so a definition it makes is the program's to
                % keep, and one made into this operator's scratch dictionary
                % would go when the operator returned; and the names kept
                % there are neither in the procedure's way nor there for it
                % to read.
                %
                % The bracket holds nothing on the operand stack while the
                % procedure runs, so the procedure is free to leave that
                % stack any way it likes, empty included, and the operator is
                % not finished with the dictionary: the bracket puts it back
                % however the procedure returned, and the bracket around this
                % body closes it where the procedure raised.
                /Install //.xpostsys /.pagehandler get exec
                dup null eq { pop }{
                    null 1 //.xpostsys /.callout get exec

                    % PLRM 6.2.6: the transformation matrix is the one
                    % device-independent parameter the procedure can
                    % usefully set, because what it leaves becomes the
                    % device's default matrix -- which is what the
                    % reinitialisation that follows sets the current one
                    % from, and what initgraphics goes back to ever after.
                    % The matrix is made in local VM, a device being a
                    % local object and this one of its own.
                    currentglobal false setglobal
                    newdev /defaultmatrix matrix currentmatrix put
                    setglobal

                    % Every other device-independent parameter goes back to
                    % its standard value, which is where a line width, a
                    % colour or a path the procedure left behind is undone.
                    initgraphics
                } ifelse

                % The page a device is installed on starts clear: resetting the
                % graphics state does not touch raster memory, so without this
                % the job paints onto whatever the buffer was created holding,
                % and emits it.
                erasepage
                off aload pop translate

                % The device is installed and everything that describes it
                % has been written: the request's features, the fixups, and
                % whatever an Install procedure set. What a page does to it
                % from here goes to the state beside it, so the device is
                % closed. A device left writable is a table a program can
                % put its own method into and have the machinery run at
                % showpage -- and closing the class it was copied from
                % closes nothing this holds, a copy carrying its own
                % references.
                newdev //.xpostsys /.sealdevice get exec

                % The page count belongs to the device, so an activation starts
                % it again at zero.
                0 //.xpostsys /.setpageno get exec

                % PLRM 6.2.6: BeginPage is setpagedevice's last action before
                % returning, save for the report below.
                %
                % PLRM 6.2.7: a request that had to consult the recovery
                % policies ends by running PolicyReport over a dictionary
                % naming each parameter it could not satisfy and the code that
                % governed it. A request that met everything it asked for runs
                % nothing.
                %
                % It runs after the page device is installed and its BeginPage
                % has run, so a report may read the device it is reporting on.
                %
                % Both are the program's procedures, and each of them goes
                % through the callout bracket (.callout, callout.ps) naming
                % the working dictionary as the one to take off while it
                % runs: a definition either makes is the program's to keep,
                % and the names kept here are neither in their way nor there
                % for them to read.
                %
                % Neither bracket holds anything on the operand stack while
                % the procedure runs, so a procedure is free to leave that
                % stack any way it likes, empty included, and the report
                % still runs after a BeginPage that emptied it. Each bracket
                % puts the working dictionary back however its procedure
                % returned, and the bracket around this body closes it where
                % one raised.
                //.xpostsys /.beginpage get null 1
                //.xpostsys /.callout get exec

                report length 0 gt
                policies /PolicyReport known and {
                    report policies /PolicyReport get null 1
                    //.xpostsys /.callout get exec
                } if
                } //.xpostsys /.indict get exec
            } //.defop exec

            % PLRM 6.1.1: what a device reports carries an entry for every
            % page-device parameter it supports, so the recovery policies are
            % there before a program has asked for anything -- the ones a
            % first request merges its own into.
            /currentpagedevice [ ] {  % -  .  dict
                graphicsdict /.pagedevice 2 copy known { get
                    dup length 1 add dict copy
                }{ pop pop
                    << /PageSize [ DEVICE /dimensions get aload pop ]
                       /Policies //.xpostsys /.defaultpolicies get exec >>
                } ifelse
                % PLRM 6.1: what this returns is read-only. It is already a
                % copy, so a program writing to it would change nothing that
                % survives the next call -- refusing the write says that,
                % where letting it through quietly loses it.
                readonly
            } //.defop exec
            end  % Systemdict

            % The language stands. Recorded by the load itself, as the last thing
            % it does, so that the step after it stopping leaves this true: a
            % reading that finished is not a reading to do again.
            .internaldict /GRAPHICS_LOADED true put

        } stopped {

            % The load is over however it ended, so what it opened closes
            % here. The dictionaries it left open go back to the depth
            % recorded above, and the writeable window on systemdict closes
            % whether or not the interpreter's own error handler has already
            % closed it: a fault raised in PostScript never passes through
            % that handler, and would otherwise leave systemdict open for the
            % rest of the run.
            countdictstack //.internaldict /GRAPHICS_LOAD_DEPTH get sub
            dup 0 gt { { end } repeat }{ pop } ifelse
            .sysdictrelock

            % Kept where the attempt that met it can still name it: this is
            % the last point at which $error holds this load's own error.
            .internaldict /GRAPHICS_LOAD_STOPPED
            $error /newerror get $error /errorname known and
            { $error /errorname get }{ null } ifelse
            put
            stop
        } if
    } ifelse
} put

%
%  The interpreter lockdown. Runs once, after .loadgraphics has loaded whatever it
%  is going to (or on its own if graphics is never loaded), when every helper the
%  machinery needs has been defined. It freezes the machinery's operator
%  references, promotes the procedure-implemented standard operators to real
%  operators, moves the private C operators into .internaldict, seals and hides
%  the private namespaces, and returns the device classes to local VM. The
%  language itself needs no moving: it is read into systemdict to begin with. .loadgraphics does the loading; this does the
%  locking down -- so nothing unrelated to graphics is tied to loading it. Each
%  step records its own completion, the load in GRAPHICS_LOADED and this in
%  LOCKDOWN_DONE, which is what keeps each idempotent without either standing
%  for the other.
%
%  A start-up step whose order matters says so here. The steps below have
%  to run in one order and no other -- a name has to be an operator before
%  anything can freeze a reference to it, systemdict has to be open before
%  a name can be taken out of it -- and getting it wrong does not fail
%  where it happened. It fails later, somewhere unrelated, or not at all:
%  the interpreter finishes starting and answers wrongly ever after. So
%  each rule is checked where it is relied on, and a broken one stops the
%  run there rather than leaving a working-looking interpreter behind.
%
.xpostsys /.mustbe {  % bool (what)  .  -
    exch { pop }{
        (start-up ordering broken: ) print print (\n) print flush
        /.finalize cvx /undefined signalerror
    } ifelse
} put

%
%  The lockdown: the last thing done to the language before a program
%  sees it.
%
%  It promotes the procedure-implemented standard operators to real
%  operators, so that load answers operatortype for them and bind
%  substitutes them; binds what is left; moves the private C operators
%  out of systemdict into .internaldict; drops the userdict anchors the
%  boot used to reach its own dictionaries; and closes the writeable
%  window on systemdict, spending a one-shot so that nothing can reopen
%  it.
%
%  It runs once in the life of a context and records that it has: a
%  lockdown that stopped part way is not attempted again, because what
%  it leaves behind is not all virtual memory and a second attempt would
%  not start from where the first did.
%
.xpostsys /.finalize {  % -  .  -
    //.internaldict /LOCKDOWN_DONE known { }{
        % A lockdown that stopped is not attempted again, and every attempt
        % after the first answers with what stopped the first. The lockdown
        % happens once in the life of a context because not all of what it
        % leaves behind is virtual memory: the writeable window on
        % systemdict closes on a one-shot held in the context, and once
        % that is spent a second attempt finds systemdict shut and stops at
        % its own ordering check, under a name of its own. $error holds one
        % error, the most recent, so that name would be the one the caller
        % is told about instead of what really stopped the lockdown.
        //.internaldict /LOCKDOWN_STOPPED known {
            //.internaldict /LOCKDOWN_STOPPED get
            dup null eq
                { pop stop }
                { /.finalize cvx exch signalerror }
            ifelse
        } if

        % The depth the dictionary stack has here is the depth it is put
        % back to below. The promotion opens a working dictionary around
        % each operator it moves, so a lockdown that stopped part way
        % would otherwise leave one current and every definition made
        % afterwards would be aimed at it.
        //.internaldict /LOCKDOWN_DEPTH countdictstack put
        {

            % Open a writeable window on systemdict. .loadgraphics opens the same
            % one before reading the language into it; this call covers the run
            % that never loads graphics, and is what lets the steps below undefine
            % the private C operators from systemdict once they are copied into
            % .internaldict. The matching relock below closes it, and closing it
            % spends the one-shot so a program cannot reopen it.
            .sysdictunlock
            systemdict wcheck
            (systemdict must be open for the steps below to take names out of it)
            //.mustbe exec
            % Promote the procedure-implemented standard operators to real
            % operators: load answers operatortype for them and bind
            % substitutes them, so the classic self-redefinition idiom
            % /stroke { 1 2 scale stroke } bind def captures the standard
            % behaviour instead of recursing into itself. Only names holding
            % executable arrays promote; the procedures stay defed in
            % .wrappedprocs, keeping them inside the collector's view (the
            % operator table is outside it).
            % The register keeps the procedures inside the collector's view, the
            % operator table being outside it. It lives in privatedict, with the
            % rest of the interpreter's own machinery, and exists whether or not
            % graphics was loaded.
            .privatedict /.wrappedprocs 256 dict put

            % Which operators these are is not stated here. An operator written in
            % PostScript states the operands it takes where it is defined, through
            % .defop, and that statement going into .opsigs is what makes it one of
            % these: the promotion runs over the statements. A list of names beside
            % them would be the same fact written twice, and the two copies could
            % disagree in either direction with nothing to notice -- a name wrapped
            % without a statement takes whatever it is given, and a name stated
            % without being wrapped states its operands to nobody. Neither is
            % expressible now.
            %
            % The statements are a dictionary, so the promotion order is the
            % dictionary's rather than an author's. That is what the second pass
            % below is for: nothing is bound until every one of them is promoted,
            % so no outcome depends on the order they came out in.
            //.opsigs {
                pop                                  % The statement; the key is the name
                dup where {
                    exch 2 copy get
                    dup type /arraytype eq 1 index xcheck and {
                        .privatedict /.wrappedprocs get 2 index 2 index put
                        % An operator that states its operands is wrapped with
                        % the statement, so the dispatcher enforces it before
                        % the procedure runs, exactly as for one written in C.
                        % It goes back into the dictionary it was found in: the
                        % language is read into systemdict, but the boot file
                        % defines a few of these into userdict first.
                        //.wrapwithsig exec
                    }{ pop pop pop } ifelse
                }{ pop } ifelse
            } forall

            % Now, and not before, freeze each promoted body. bind replaces a name
            % with an operator only where the name already answers with one, and it
            % makes what it binds read-only, so it gets one chance at each body: a
            % body bound while its neighbours were still procedures would keep
            % their names for good, dynamic and reachable by a program redefining
            % them, and the later .bindscope sweep could not come back for it. The
            % pass above promoted every one of them, so every call between them
            % freezes here. The operator holds the same array the register does,
            % so binding it in place is binding what the operator runs; the bound
            % (now read-only) reference goes back into the register, which is what
            % tells the sweep below this body is finished.
            [ .privatedict /.wrappedprocs get { pop } forall ]
            { .privatedict /.wrappedprocs get exch 2 copy get bind put } forall

            % With the standard operators now operator-typed, freeze the
            % machinery's own references to them with the shared recursive
            % sweep: every procedure table it can reach through nested
            % dictionaries -- the wrapped implementations, the device makers,
            % the graphics state template, the error handlers, and any table
            % inside a table -- has its operator references resolved now.
            % Every name the promotion pass covered is an operator by now. Binding
            % substitutes operators and leaves names alone, so a name still holding
            % its procedure here would keep a dynamic reference in every machinery
            % procedure that calls it, reachable by a program redefining the name.
            % counted in a scratch dictionary, so the check leaves no name behind
            1 dict begin
            /n 0 def
            .privatedict /.wrappedprocs get {
                pop                                  % The value; the key is the name
                dup type /nametype eq {
                    dup where {
                        1 index get type /operatortype ne { /n n 1 add store } if
                    }{ } ifelse
                } if
                pop
            } forall
            n 0 eq
            end
            (every promoted name must be an operator before references are frozen)
            //.mustbe exec

            % The other half of the same post-condition. The gate above says every
            % name the promotion took is an operator; this says the promotion took
            % every name it should have. An operator that states its operands is
            % one by now, or is not defined in this run at all -- a --no-graphics
            % run loads none of the graphics modules, and the statements they
            % record when they do load are the same statements either way. A name
            % still holding its procedure would be an operator the dispatcher had
            % been told about and the promotion passed over.
            1 dict begin
            /n 0 def
            //.opsigs {
                pop                                  % The statement; the key is the name
                dup where {
                    1 index get type /operatortype ne { /n n 1 add store } if
                }{ } ifelse
                pop
            } forall
            n 0 eq
            end
            (every operator that states its operands must be one after the promotion)
            //.mustbe exec

            % The third post-condition, and the one that makes the binding below
            % worth doing. A body bound at its own definition is read-only before
            % any of the names it calls answers with an operator, and bind ignores
            % a read-only array -- so no later pass can finish it and it keeps
            % those names for the rest of the run, which is a program's
            % redefinition waiting to be picked up from inside a standard
            % operator. .defop records any body that arrives read-only; holding
            % that register to empty is what stops a bind being put back at a
            % definition, where it reads like caution and costs the opposite.
            //.boundatdef length 0 eq
            (no operator body may be bound before the promotion binds it)
            //.mustbe exec

            systemdict //.bindscope exec
            userdict //.bindscope exec

            % graphicsdict exists only once graphics has loaded; without it there is
            % nothing to bind and this step is simply skipped
            /graphicsdict where { pop graphicsdict //.bindscope exec } if
            errordict //.bindscope exec

            % The private helper namespace too, so a helper's own operator references
            % (the get and exec of //.xpostsys /.h get exec, and everything else) freeze
            % and survive a program shadowing an operator name. The stroke switch
            % is in here, so this is the sweep that binds it.
            .xpostsys //.bindscope exec

            % The scratch dictionary is not swept, and has nothing to sweep: what
            % it holds is the state of the render in hand and the caches and
            % resources a job builds, and no procedure of the machinery's. A
            % procedure the interpreter runs and a program may name is a procedure
            % the program may replace, and the scratch is named by a public
            % operator. tests/gscratch_procedures_test.ps holds it to that.

            % privatedict holds machinery procedures too -- the gstate-template accessor,
            % the device class methods -- so bind them against a shadowed operator name
            % the same way. The anchor procedures moved here below were bound in userdict
            % before the move, so they carry their frozen references with them.
            .privatedict //.bindscope exec

            % Install idiom recognition. The plain bind is kept in .internaldict and
            % /bind becomes an operator that runs it and then offers the result to
            % IdiomSet substitution (PLRM 3.12.1, LanguageLevel 3). This is done here,
            % after every sweep above has bound the machinery with the plain operator,
            % so only a program's own binds from now on carry the substitution step;
            % it names the operand it takes so a non-procedure is refused as bind.
            .internaldict /.cbind systemdict /bind get put
            systemdict /bind
            /bind .xpostsys /.bindwrap get [ /proctype ] .wrapopsig
            put

            % userdict, errordict, $error and FontDirectory are names in systemdict for
            % local dictionaries; the userdict copies are dropped so each name resolves
            % in systemdict.
            [ /userdict /errordict /$error /FontDirectory /statusdict /serverdict ] {
                dup systemdict exch known { userdict exch undef }{ pop } ifelse
            } forall

            % Relocate the private C operators from systemdict into .internaldict. Every
            % machinery reference to them is now frozen -- the standard operators bound
            % above and .bindscope over the loaded procedures -- so a program
            % enumerating systemdict sees only the standard names, while a font program
            % reaches them through 1183615869 internaldict. Two operators stay, both
            % dotted, so no program name collides with them. The local-state accessors
            % (.gscratch/.privatedict) are the operators the machinery reaches its
            % per-render scratch and its private dictionary through: driver prologs and
            % machinery name them at run time, past the reach of the bind pass, so
            % relocating them breaks rendering (verified). The C core reaches privatedict
            % through the context field, not by name. .sysdictunlock and .sysdictrelock
            % relocate with the rest: the unlock has already run, and the relock below is
            % reached through .internaldict.
            %
            % What is swept is every dotted name, whatever it holds, and not
            % the dotted operators alone. A dotted name carrying data rather
            % than an operator is machinery just the same -- the roster of
            % standard IODevice names is one -- and a sweep that asked for an
            % operator would leave it sitting in the program's base
            % dictionary, which is the one state nothing else would catch:
            % it is on no list, so no list would report it missing.
            %
            % The device classes are the exception, and not because they
            % are data: a later step of this same lockdown takes them into
            % privatedict as LOCAL copies, which is what makes a job's page
            % setup revert with the save level. A sweep that took them
            % first would leave that step copying out of global VM, and the
            % classes would be global dictionaries a program could not put
            % a local value into.
            %
            % Where a swept name lands is decided by what it holds, not by
            % what swept it. An operator goes to .internaldict, which holds
            % the operators relocated out of systemdict and is registered
            % as holding those and the latches and nothing else; a name
            % carrying data goes to .xpostsys, the private helper
            % namespace, which is where a global static value belongs.
            [ systemdict {
                    exch dup type /nametype eq
                    { dup 60 string cvs 0 get 46 eq
                      % graphicsdict and DEVICE carry no dot and are not
                      % the language's: PLRM names neither, and each
                      % answers with live machinery -- the graphics state,
                      % whose currgstate a program may WRITE and whose
                      % device slot decides what the marks go to, and the
                      % device instance itself. A census keyed on the dot
                      % is exactly what would not see them, which is why
                      % they are named here rather than derived.
                      1 index /graphicsdict eq or
                      1 index /DEVICE eq or
                      1 index //.isclassname exec not and
                      1 index /.lockdown ne and
                      1 index /.permitfileread ne and
                      1 index /.permitfilewrite ne and
                      1 index /.resourcefileopen ne and
                      % These two answer with the machinery's own
                      % dictionaries, so they belong out of systemdict with
                      % the rest. They are kept there only for a run taking
                      % a census, whose suites name them as they stand in
                      % the sources; every other run relocates them, and
                      % since the password no longer opens .internaldict
                      % that puts them out of reach rather than merely out
                      % of sight.
                      1 index /.gscratch ne //.internaldict /CENSUS known not or and
                      1 index /.privatedict ne //.internaldict /CENSUS known not or and
                      1 index /graphicsdict ne //.internaldict /CENSUS known not or and
                      1 index /DEVICE ne //.internaldict /CENSUS known not or and
                    }{ false } ifelse
                    { exch pop }{ pop pop } ifelse
                } forall ]
            dup { dup systemdict exch get
                  dup type /operatortype eq
                      { .internaldict }{ .xpostsys } ifelse
                  3 1 roll put } forall

            % ...except the job store's accessor, which goes nowhere. The
            % store is the machinery's own writable state, and .internaldict
            % is reachable by any program that knows the password -- so
            % relocating it there published a door onto everything the
            % machinery writes: MEASURED, a plain program reached the store
            % and wrote the page counter through it. Nothing needs the name
            % after this point: the data files use it while they load, and
            % the C side reaches the store through the context. What the
            % registers need of it -- the names it holds, whether a member
            % is still writable, what the host said -- they ask for by name
            % and are answered with names and values, never the dictionary.
            .internaldict /.jobstore known
              { .internaldict /.jobstore undef } if

            % ...and the three that INSTALL machinery state. Each replaces
            % a dictionary the machinery then reads for the rest of the job:
            % the graphics state, the private dictionary, the job store. The
            % lockdown and the boot files are the only callers and they have
            % bound the operator by now, so nothing needs the name. Left
            % where a program could reach them, a program installs its own
            % and the machinery reads it: MEASURED, a plain program replaced
            % the graphics state and held a writable currgstate and the
            % device slot with it.
            .internaldict /.setgraphicsdict known
              { .internaldict /.setgraphicsdict undef } if
            .internaldict /.setprivatedict known
              { .internaldict /.setprivatedict undef } if
            .internaldict /.setjobstore known
              { .internaldict /.setjobstore undef } if
            .internaldict /.graphicsdictroot known
              { .internaldict /.graphicsdictroot undef } if

            % ...and .vmseal, which REDUCES access wherever it is asked.
            % The lockdown above is the only caller and it has run by now;
            % leaving the operator where a program can reach it leaves the
            % machinery's own access under a program's hand.
            .internaldict /.vmseal known
              { .internaldict /.vmseal undef } if
            { systemdict exch undef } forall

            % The internal draw-line flag is interpreter state a program has no use
            % for; it goes into .internaldict, out of a program's sight, while it is
            % still writable here. .internaldict is sealed below, so the flag cannot
            % be removed or overwritten afterwards.
            .internaldict /USEDRAWLINE true put

            % device -- so a job's page setup does not leak into the next. In local VM the
            % ordinary save/restore reverts those writes; a global home does not.
            % Rebind each to a local copy in privatedict now that the device modules have
            % finished loading, with headroom for the parameters setpagedevice adds, and
            % drop the userdict anchor: the classes leave the program's namespace entirely
            % and the makers, the C drivers and setpagedevice reach them through
            % privatedict.
            currentglobal false setglobal

            % Which dictionaries those are is read off the one holding them
            % rather than named here, for the reason data/device.ps reads the
            % mirror the same way: a class states itself by the name it is
            % defined under, and a list beside it is a second statement a class
            % added later does not reach. The keys are taken before any of them
            % is dropped, since what is walked here is what is being written to.
            [ systemdict { pop } forall ]
            { dup //.isclassname exec
                { dup systemdict 1 index get dup length 16 add dict copy  % Name name localcopy
                  .privatedict 3 1 roll put                              % Name (privatedict/name = localcopy)
                  systemdict exch undef }                                % Drop the load-time anchor
                { pop } ifelse
            } forall

            .internaldict /.sysdictrelock get exec

            % Return the device class dictionaries to local VM. setpagedevice records the
            % page geometry into them at run time, and that state must be subject to save
            % and restore -- a restore to before a setpagedevice reinstates the earlier
            % Move the remaining local machinery anchors into privatedict as well: the
            % graphics scratch and the wrapped-operator anchor procedures. These are
            % reached only through frozen references and the operator table, both of
            % which the privatedict root keeps alive, so the objects move by reference
            % (no copy) and dropping the userdict anchor hides them without breaking a
            % thing.
            [ /.error ]
            { dup userdict exch known
                { dup dup userdict exch get .privatedict 3 1 roll put userdict exch undef }
                { pop } ifelse
            } forall

            % The gstate-template dictionary is frozen into its accessor proc (already in
            % privatedict), so only its userdict anchor remains -- drop it
            userdict /.gstatetemplate known { userdict /.gstatetemplate undef } if
            setglobal

            % Freeze the bodies privatedict holds in GLOBAL virtual memory.
            % These are the machinery the interpreter reaches by name while a
            % program is running -- the device makers a page-device request
            % executes to build the device it asked for, and the start
            % procedures each job is primed with. A program reads the
            % dictionary through the .privatedict operator, which is public so
            % that a driver prolog can name it, and an array read out of a
            % dictionary carries the access of the reference that was stored
            % rather than the dictionary's: sealing the dictionary below holds
            % which body each name answers with, and this holds the body
            % itself. A restore does not reach global virtual memory
            % (PLRM 3.7.2), so a body written into there decides what the
            % machinery runs for the rest of the job.
            %
            % The local members are left as they are, and the bank is the whole
            % of the reason: the device classes take a job's page geometry and
            % the scratch is rewritten at every render, and a write to either
            % is reverted by the restore that ends the save level it was made
            % in.
            %
            % Which bodies these are is read off the dictionary rather than
            % listed here, so a body added later is held to the same rule
            % without a list beside it having to be remembered.
            currentglobal false setglobal
            [ .privatedict { pop } forall ]
            { .privatedict 1 index get
                dup type /arraytype eq
                { dup gcheck
                    { dup wcheck
                        { readonly .privatedict 3 1 roll put }
                        { pop pop } ifelse }
                    { pop pop } ifelse }
                { pop pop } ifelse
            } forall
            setglobal

            % Sealed, so that what the machinery reaches by name in
            % privatedict is what the interpreter put there. What lives here
            % is the device class dictionaries and the procedures that make a
            % device from one, the graphics dictionary and the template a new
            % graphics state is copied from, the wrapped-operator register and
            % the error handler: a page-device request executes the maker it
            % finds under the device's name, and that maker executes the class
            % it finds under the class's name, so a slot a program could write
            % is a slot that decides what runs as the device. The dictionary
            % is local, so the restore that ends a job would reach a write
            % made in it -- but a device is built and a page is painted inside
            % that job, which is where a substituted body would run, so the
            % bank is no protection here.
            %
            % The values are not sealed with it, and that is the point of
            % sealing the dictionary rather than them: a device class takes
            % the page geometry a job asks for and the machinery's own tables
            % are written as a page is painted. What may not change is which
            % object each name answers with.
            %
            % The interpreter goes on writing it, through its own store rather
            % than through the language (xpost_dict_put_internal): a driver
            % brought in on first use installs its class and its maker here, a
            % wrapped call makes the array its operands are copied into, and
            % setobjectformat records the parameter it is given. The scratch
            % a render mutates is .gscratch, a dictionary held under a name in
            % here rather than this dictionary, and it is written as before.
            .privatedict readonly pop

            % Nothing the machinery executes is left writable.
            %
            % A restore does not reach global virtual memory (PLRM 3.7.2), so
            % an executable array living there that a program can write is one
            % whose replacement decides what the interpreter runs for the rest
            % of the job -- and these namespaces are not out of reach, because
            % bind freezes the dictionary a helper names into the helper's own
            % body and a program can read a body.
            %
            % Sealing the dictionaries above does not answer it: an array's
            % access belongs to the reference and not to the value (PLRM 3.3.2,
            % and PLRM 8.2 readonly says so of the operator), so what a name
            % answers with is settled there and the body is not. Nor can the
            % language answer it, because storing a sealed reference back is a
            % write, and by this point most of the containers refuse one.
            %
            % So the interpreter reduces the access of each stored reference
            % itself, over everything the four roots reach. There is no list to
            % be forgotten from and no depth to be short: the population is
            % whatever the walk finds, and tests/check-vm-forbidden.sh holds
            % the count of what is left.
            %
            % Data is not touched, and the distinction is what a program could
            % make the machinery DO. A table the machinery reads is written as
            % a page is painted -- the record a page is counted in has to
            % outlive a restore, so it is global and writable on purpose -- and
            % no program can make the interpreter run a number.
            %
            % Last, after every bind sweep: bind ignores a read-only array
            % (PLRM 8.2), so a body sealed while a sweep is still to come is a
            % body that sweep stops reaching, and binding is what keeps a
            % program's redefinition away from what the machinery calls.
            %
            % The exception is storage the language hands programs to write.
            % The resource registry and its per-category instance stores are
            % written by defineresource (PLRM 3.9), and they hold procedure
            % sets, so a rule reading only "leads to something executable"
            % would take them. They are declared instead of sealed, derived
            % from the registry rather than named, so a category added later
            % is covered without this list being revisited. The walk still
            % descends through them: what a resource holds is held to the rule.
            % The roots of the walk, named once and kept, because the seal
            % here and the census in tests/vm_forbidden_test.ps have to ask
            % over the SAME graph. Two lists drift, and when they did, the
            % difference read as objects becoming reachable rather than as
            % the two walks disagreeing about where to start. The job store
            % is among them so that what the machinery writes is walked too:
            % it is exempt from the rule about constants, not from the rule
            % about what can be made to run.
            % No roots are named here. The walk takes them from the
            % context, so the seal and the census cannot start from
            % different places, and no list of them exists for a program
            % to read: one kept in .privatedict put the machinery's own
            % namespaces and the job store within reach of anything that
            % could read that dictionary.
            % No exemption is passed either. The sweep derives it -- the job
            % store and what it holds, and the resource registry's
            % per-category instance stores, which defineresource writes
            % (PLRM 3.9) -- because a list has to be kept where whoever
            % passes it can reach it, and .vmdeclaredcount is how its size
            % is asked for without holding it.
            % Recorded BEFORE the sweep. The sweep reaches .internaldict
            % through the body of the procedure that answers the password
            % and seals it like any other namespace, so a put here
            % afterwards is refused.
            % A device class is a declaration once the interpreter is
            % up: the methods the machinery runs on a device of that
            % kind, and the entries it answers with. What a page does to
            % a device goes to that instance's own state, and what a run
            % settled on goes where the run's answers are kept, so
            % nothing writes a class after this point. One left writable
            % is a table a program can put its own method into and have
            % the machinery run, for the rest of the job.
            %
            % Sealed by what a class IS -- a table the local machinery
            % holds that knows how to make an instance of itself -- so a
            % device added later is sealed without this naming it. The
            % sweep below cannot ask this question: its table rule is for
            % global virtual memory, and these are local because an
            % instance made from one is local.
            %
            % A run that asked to instrument the machinery keeps them
            % writable, because a program has no other way to watch a
            % device method: the private namespaces refuse a program's
            % writes, so it can neither register a class of its own nor
            % reach one already made. That is the invocation's decision
            % and not the program's -- nothing a program does can reach
            % the setting -- and check-vm-forbidden holds the ordinary
            % run, which is the one that ships.
            % Read from systemdict, and taken out of it here: the flag
            % is put there by the C before the boot runs, and a run that
            % loaded a built image never ran the boot, so this is the one
            % place that sees it either way. Taken out so that what a
            % program can read of systemdict does not include it as
            % anything it can set: by the time the lockdown runs the
            % window on systemdict has closed, so this is read and left
            % where it is, and what it tells a program is only what
            % trying to write a class would tell it anyway.
            systemdict /UNSEALEDDEVICES known not {
                .privatedict {
                    exch pop
                    dup type /dicttype eq {
                        dup /.instance known { readonly } if
                    } if
                    pop
                } forall
            } if

            .internaldict /LOCKDOWN_DONE true put

            0 16#7FFFFFFF .vmseal pop

            % And ask, once, how much of the arena the sweep just walked:
            % the collector marks from the roots the INTERPRETER has -- the
            % stacks, the save stack, the name stack -- and what it reaches
            % that the sweep did not is a root the sweep has not been given.
            % Asked here, where no program has run, because the mark covers
            % whatever is on the stacks at the moment it is taken, and a
            % program measuring it would be counting itself.
            .vmblind

            % The interpreter is locked down. Recorded last, so that a lockdown
            % which stopped anywhere above records instead what stopped it.

            % Seal the private namespaces, as the last act of all. They are fully
            % populated now -- init and the graphics modules have defined every helper,
            % the C operators have been relocated into .internaldict and the local
            % machinery anchors have moved into privatedict -- and the machinery only
            % reads them hereafter, always through a frozen // reference to the object.
            % Freeze each read-only so a program cannot overwrite a helper, and drop its
            % userdict anchor so a program cannot reach or even enumerate it. The frozen
            % references keep the objects alive and working; .gscratchdict stays writable
            % and anchored, as the machinery mutates it every render.
            %
            % Last because .internaldict is where a lockdown that stopped writes what
            % stopped it: sealed any earlier, a stop between the seal and the end would
            % have nowhere to record and the attempt after it would start over.
            userdict /.internaldict get readonly pop
            userdict /.xpostsys get readonly pop
            userdict /.internaldict undef
            userdict /.xpostsys undef
            % The dictionary the PLRM operator answers with goes the same
            % way: the operator holds it through the reference frozen into
            % its own body, so the name in userdict is only a way for a
            % program to reach it under another route.
            % Not sealed: PLRM 8 states the internal dictionary is
            % writeable, and a program writing into one that holds
            % nothing the machinery reads writes into its own corner.
            userdict /.plrminternaldict undef

            % The graphics state is not initialised here. It is initialised by
            % the device being installed, which is what settles the parameters
            % that describe how a device renders, and no device has been made
            % yet: the lockdown is language work and runs whether or not this
            % run ever has one.

        } stopped {
            % The lockdown is over however it ended, so what it opened closes
            % here. The dictionaries it left open go back to the depth
            % recorded above, and the writeable window on systemdict closes
            % whether or not the interpreter's own error handler has already
            % closed it: a fault raised in PostScript never passes through
            % that handler, and would otherwise leave systemdict open for the
            % rest of the run.
            countdictstack //.internaldict /LOCKDOWN_DEPTH get sub
            dup 0 gt { { end } repeat }{ pop } ifelse

            % The relock as the operator itself: the steps above take the
            % dotted operators out of systemdict, so by this point the name
            % answers from .internaldict rather than from the dictionary
            % stack, and this reaches it either way.
            //.sysdictrelock

            % Kept where the attempt that met it can still name it: this is
            % the last point at which $error holds this lockdown's own error.
            //.internaldict /LOCKDOWN_STOPPED
            $error /newerror get $error /errorname known and
            { $error /errorname get }{ null } ifelse
            put
            stop
        } if
    } ifelse
} put
setglobal

$error/initializing false put  % Ready to go!

%
%  The bank userland starts in. Everything above this line ran with
%  global allocation in force, because the language it built belongs to
%  the interpreter and outlives any job. What a program allocates is the
%  program's, and belongs where save and restore can reach it, so the
%  boot hands over in local VM.
%
%  This is load-bearing rather than tidy: without it the interpreter
%  comes up global, and nothing a program drops is ever reclaimed.
%
false setglobal

currentglobal true setglobal

%
%  Debug ps functions -- interpreter aids, not language operators, so private
%
.xpostsys /.doprompt {  % -  .  -
    (\nbreak>)print flush
    (%lineedit)(r)file
    cvx {exec}stopped pop } put

%
%  Stop and wait for a keypress, for a person stepping through a program
%  by hand. The same as .doprompt above under the name a debugging
%  convention reaches for.
%
.xpostsys /.pause { //.doprompt exec } put  % -  .  -
setglobal

currentglobal true setglobal

%
%  Print the names of the files the run can reach, for a person at the
%  interactive prompt.
%
.xpostsys /.dir {  % -  .  -
    (*) { = } 128 string filenameforall
} put
setglobal

currentglobal true setglobal

%
%  The greeting the interactive executive prints, telling a person at
%  the prompt how to run a file.
%
.xpostsys /.xpost {  % -  .  -
    (Xpost is running. Type '(filename)run' to run a program.\n)print
} put
setglobal

(/prepr.ps) //.loadmodule exec  % Use nifty preview prompt!

end  % systemdict

end end end

//.internaldict /QUIET known { }{ (eof init.ps\n)print } ifelse
