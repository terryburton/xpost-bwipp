%!PS
%
% shade.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Smooth shading (PLRM 4.9.3): shfill resolves a gradient to a stack of flat-colour fills.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  shfill paints a shading dictionary
%  over the current clip region. The gradient resolves to a stack of
%  flat-colour fills through the ordinary paint pipeline: an axial
%  shading as bands across its axis, a radial one as circles painted
%  outside in, a triangle mesh by recursive subdivision. The band and
%  step counts follow the device size of the geometry, so the steps
%  stay within a device pixel or two.
%
//.internaldict /QUIET known { }{ (loading shade.ps...)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  Evaluate a PostScript function dictionary at t: exponential
%  interpolation (type 2), stitching (type 3), and one-input sampled
%  (type 0, byte-aligned sample depths) functions serve the shading
%  dictionaries producers write.
%
.xpostsys begin

%
%  The position is the caller's, so this opens no dictionary of its own:
%  a local one would take the /bp definitions with it and the stream
%  would be read from the same place for ever.
%
%  Accumulated in a real, most significant bit first.
%
/.mrdbits {  % nbits  .  v
    dup 8 mod 0 eq bp 8 mod 0 eq and {
        8 idiv 0.0 exch {
            256 mul ds bp 8 idiv get add
            /bp bp 8 add def
        } repeat
    }{
        0.0 exch {
            2 mul
            ds bp 8 idiv get 7 bp 8 mod sub neg bitshift 1 and
            add
            /bp bp 1 add def
        } repeat
    } ifelse
} def

%
%  The widths PLRM 3.10.1 allows a sample to be. A sampled function's
%  DataSource is a continuous bit stream with no padding at a byte
%  boundary, so these are read by counting bits, the way a mesh stream is.
%
/.fnsamplebits << 1 true 2 true 4 true 8 true 12 true 16 true 24 true 32 true >> readonly def

%
%  What a sampled function needs, defined in the CALLER's dictionary from
%  the f it holds: the sample width, the range and how many components
%  that makes, the interval each component's samples are read out into,
%  and the source the samples come out of. It opens no dictionary of its
%  own, because what it defines is what the caller reads -- and both
%  evaluators read the same things.
%
%  Decode is what a sample means. PLRM 3.10.1 maps a sample from the
%  whole width of its representation onto the interval Decode gives for
%  that component, and a dictionary that names no Decode is read out over
%  its Range instead. The two are the same interval only by default, so a
%  function that gives one is asking for something else.
%
/.fnsampled {  % -  .  -
    /bps f /BitsPerSample get def
    //.fnsamplebits bps known not { /shfill cvx /rangecheck signalerror } if
    /rng f /Range get def
    /nc rng length 2 idiv def
    /dec f /Decode 2 copy known { get }{ pop pop rng } ifelse def
    /ds f /DataSource get def
    /litds false def
    /max 2 bps exp 1 sub def
} def

%
%  The sample at that index, as it stands in the stream. The samples are
%  adjacent with nothing between them, so an index names a bit position
%  and not a byte one. What scales it to its range is left to the caller,
%  which interpolates between two samples first and divides once.
%
/.fnsample {  % index  .  value
    bps mul /bp exch def
    bps //.mrdbits exec
} def

%
%  A function's outputs, held to the Range it declares. PLRM 3.10 gives
%  Range as one interval of two numbers per output value and puts each
%  value inside its own interval, an outlying one taking the nearer
%  boundary; a function that declares no Range is not clipped at all,
%  which is why the callers ask before calling.
%
%  It is asked of the answer rather than of each branch that computes
%  one, because Range belongs to the function dictionary and not to the
%  arithmetic of a type: a stitching function clips what its
%  subfunctions gave it, and those clip themselves first.
%
/.fnclip {  % c0..cn-1 n  .  c0..cn-1 n
    4 dict begin
    /cn exch def
    /rg f /Range get def
    cn array astore /vs exch def
    0 1 cn 1 sub { /jx exch def
        vs jx get
        dup rg jx 2 mul get lt { pop rg jx 2 mul get } if
        dup rg jx 2 mul 1 add get gt { pop rg jx 2 mul 1 add get } if
    } for
    cn
    end
} def

%
%  Evaluate a PostScript function dictionary at t, and answer the
%  components it gives together with how many there are (PLRM 3.10).
%  Exponential interpolation (type 2), stitching (type 3) and one-input
%  sampled (type 0) functions are served; the count comes back because a
%  function's output arity is the function's own and the caller cannot
%  know it in advance.
%
%  The axial and radial shadings evaluate their colour through here, one
%  call per band.
%
%
%  A type 2 function's C0 and C1 as arrays. PLRM Table 3.14 gives each as
%  an array of n numbers, and a function of one output therefore states a
%  one-element array. A dictionary that writes the number itself is saying
%  what that array holds, so it is read as holding it: the alternative is
%  to refuse a function whose values are not in dispute, over the brackets
%  around them.
%
%  Only a number is taken this way, and what is neither number nor array is
%  refused here. Refusing it here is the point: before, a value of the wrong
%  type failed further on, and only because the OTHER entry was reached
%  first -- a string C0 was refused because C1 was a number, and reading a
%  bare C1 would have let the string through to paint character codes as
%  colour. What the entry may be is now said once, where it is read.
%
/.fn1array {  % any  .  array
    dup type dup /integertype eq exch /realtype eq or
        { 1 array astore }
        { dup type dup /arraytype eq exch /packedarraytype eq or not
            { /shfill cvx /typecheck signalerror } if }
    ifelse
} def

/.fneval {  % t fn  .  c0..cn-1 n
    dup type /arraytype eq {
        % The alternative form PLRM Tables 4.13 and 4.14 allow: an array
        % of n functions of one input and one output, one per colour
        % component, in place of one function of n outputs. Each is
        % evaluated at the same value and contributes its component.
        3 dict begin
        /fa exch def /tt exch def
        0 1 fa length 1 sub { /k exch def
            tt fa k get //.xpostsys /.fneval get exec pop
        } for
        fa length
        end
    }{
    10 dict begin
    /f exch def
    /d0 f /Domain get 0 get def
    /d1 f /Domain get 1 get def
    dup d0 lt { pop d0 } if
    dup d1 gt { pop d1 } if
    /t exch def
    f /FunctionType get
    dup 2 eq {
        pop
        /c0 f /C0 2 copy known { get }{ pop pop [ 0.0 ] } ifelse
            //.fn1array exec def
        /c1 f /C1 2 copy known { get }{ pop pop [ 1.0 ] } ifelse
            //.fn1array exec def
        /tn t f /N get exp def
        0 1 c0 length 1 sub { /i exch def
            c0 i get
            c1 i get c0 i get sub tn mul add
        } for
        c0 length
    }{ dup 3 eq {
        pop
        /bs f /Bounds get def
        /k 0 def
        0 1 bs length 1 sub { /j exch def
            t bs j get ge { /k j 1 add def } if
        } for
        /lo k 0 eq { d0 }{ bs k 1 sub get } ifelse def
        /hi k bs length eq { d1 }{ bs k get } ifelse def
        /e0 f /Encode get k 2 mul get def
        /e1 f /Encode get k 2 mul 1 add get def
        hi lo eq { e0 }{ t lo sub hi lo sub div e1 e0 sub mul e0 add } ifelse
        f /Functions get k get //.xpostsys /.fneval get exec
    }{ 0 eq {
        % Sampled with one input. PLRM 3.10.1 places the parameter in the
        % sample table through Encode, clips the placed position to the
        % table's own extent, and interpolates between the samples that
        % bracket it. The default Encode spans the table, which is why a
        % dictionary that names none behaves as though it named [0 Size-1].
        /size f /Size get 0 get def
        //.fnsampled exec
        /enc f /Encode 2 copy known { get }{ pop pop [ 0 size 1 sub ] } ifelse def
        /x t d0 sub d1 d0 sub dup 0 eq { pop 1 } if div
           enc 1 get enc 0 get sub mul enc 0 get add def
        x 0 lt { /x 0 def } if
        x size 1 sub gt { /x size 1 sub def } if
        /i0 x floor cvi def
        i0 size 1 sub ge { /i0 size 2 sub def } if
        i0 0 lt { /i0 0 def } if
        % The sample after i0, except at the end of a table and in a
        % table of one, where the nearest sample on that side is i0
        % itself and there is nothing further to reach for.
        /i1 i0 1 add def
        i1 size 1 sub ge { /i1 size 1 sub def } if
        /fr x i0 sub def
        0 1 nc 1 sub { /c exch def
            i0 nc mul c add //.fnsample exec
            i1 nc mul c add //.fnsample exec
            1 index sub fr mul add max div
            dec c 2 mul 1 add get dec c 2 mul get sub mul
            dec c 2 mul get add
        } for
        nc
    }{
        /shfill cvx /rangecheck signalerror
    } ifelse } ifelse } ifelse
    f /Range known { //.fnclip exec } if
    end
    } ifelse
} def

%
%  How many inputs a function declares. PLRM 3.10 gives a function's
%  Domain as one interval of two numbers per input, so the count is half
%  its length.
%
/.fnindim {  % fn  .  int
    /Domain get length 2 idiv
} def

%
%  Hold a shading's Function to the number of inputs its type calls for,
%  in either of the two forms the specification allows: one function of
%  that many inputs, or an array of functions each taking one input and
%  giving one component (PLRM Tables 4.12 to 4.19).
%
%  A function of the wrong arity is not a function the shading can be
%  painted from: what the painter has to give it is a point of the
%  domain, and a function wanting two numbers cannot be handed one. It
%  is refused rather than evaluated with whatever the painter happens to
%  have, which would paint a page the program did not ask for.
%
/.fncheckin {  % fn nin  .  -
    exch dup type /arraytype eq {
        exch pop
        {
            dup type /dicttype ne
                { /shfill cvx /typecheck signalerror } if
            //.fnindim exec 1 ne
                { /shfill cvx /rangecheck signalerror } if
        } forall
    }{
        dup type /dicttype ne
            { /shfill cvx /typecheck signalerror } if
        //.fnindim exec ne
            { /shfill cvx /rangecheck signalerror } if
    } ifelse
} def

%
%  The same question asked of a shading dictionary, by its type. A
%  function-based shading takes a function of two inputs, the domain it
%  covers being a rectangle (PLRM Table 4.12); every other type takes one
%  of a single input, the parametric variable along an axis, between two
%  circles, or across a mesh element (PLRM Tables 4.13 to 4.19).
%
%  A Function that is absent is not asked about here. Whether a type
%  demands one is the painter's to say, and the two types that require it
%  already answer for its absence.
%
/.fncheckshading {  % shdict type  .  -
    1 eq { 2 }{ 1 } ifelse
    exch /Function 2 copy known
    { get exch //.fncheckin exec }{ pop pop pop } ifelse
} def

%
%  evaluate a two-input function: a sampled function with a 2-D Size,
%  bilinear between the four bracketing samples, or an array of
%  two-input single-output functions, one per component.
%
/.fneval2 {  % x y fn  .  c0..cn-1 n
    dup type /arraytype eq {
        4 dict begin
        /fa exch def /yy exch def /xx exch def
        0 1 fa length 1 sub { /k exch def
            xx yy fa k get //.xpostsys /.fneval2 get exec pop
        } for
        fa length
        end
    }{
        16 dict begin
        /f exch def
        /yy exch def /xx exch def
        f /FunctionType get 0 ne { /shfill cvx /rangecheck signalerror } if
        /d f /Domain get def
        xx d 0 get 2 copy lt { exch } if pop d 1 get 2 copy gt { exch } if pop /xx exch def
        yy d 2 get 2 copy lt { exch } if pop d 3 get 2 copy gt { exch } if pop /yy exch def
        /sx f /Size get 0 get def
        /sy f /Size get 1 get def
        //.fnsampled exec
        /enc f /Encode 2 copy known { get }{ pop pop
            [ 0 sx 1 sub 0 sy 1 sub ] } ifelse def
        /ex xx d 0 get sub d 1 get d 0 get sub dup 0 eq { pop 1 } if div
            enc 1 get enc 0 get sub mul enc 0 get add def
        /ey yy d 2 get sub d 3 get d 2 get sub dup 0 eq { pop 1 } if div
            enc 3 get enc 2 get sub mul enc 2 get add def
        ex 0 lt { /ex 0 def } if
        ex sx 1 sub gt { /ex sx 1 sub def } if
        ey 0 lt { /ey 0 def } if
        ey sy 1 sub gt { /ey sy 1 sub def } if
        /i0 ex floor cvi def
        /j0 ey floor cvi def
        /i1 i0 1 add sx 1 sub 2 copy gt { exch } if pop def
        /j1 j0 1 add sy 1 sub 2 copy gt { exch } if pop def
        /fx ex i0 sub def
        /fy ey j0 sub def

        % The sample scaled to 0..1.
        /samp {  % i j c  .  v
            3 1 roll sx mul add nc mul add //.fnsample exec max div
        } def
        0 1 nc 1 sub { /c exch def
            i0 j0 c samp 1 fx sub mul i1 j0 c samp fx mul add
            1 fy sub mul
            i0 j1 c samp 1 fx sub mul i1 j1 c samp fx mul add
            fy mul add
            dec c 2 mul 1 add get dec c 2 mul get sub mul
            dec c 2 mul get add
        } for
        nc
        f /Range known { //.fnclip exec } if
        end
    } ifelse
} def

%
%  Function-based shading (type 1): the domain rectangle, taken
%  through the optional Matrix, paints as a grid of cells a few
%  device pixels across, each filled flat with the function's colour
%  at its centre.
%
/.fnsh {  % shdict  .  -
    14 dict begin
    /sh exch def
    /fn sh /Function get def
    /dom sh /Domain 2 copy known { get }{ pop pop [ 0 1 0 1 ] } ifelse def
    sh /Matrix 2 copy known { get concat }{ pop pop } ifelse
    /x0 dom 0 get def /x1 dom 1 get def
    /y0 dom 2 get def /y1 dom 3 get def
    /nx x1 x0 sub 0 dtransform dup mul exch dup mul add sqrt
        3 div ceiling cvi 1 2 copy lt { exch } if pop 200 2 copy gt { exch } if pop def
    /ny 0 y1 y0 sub dtransform dup mul exch dup mul add sqrt
        3 div ceiling cvi 1 2 copy lt { exch } if pop 200 2 copy gt { exch } if pop def
    /dx x1 x0 sub nx div def
    /dy y1 y0 sub ny div def
    0 1 nx 1 sub { /i exch def
        0 1 ny 1 sub { /j exch def
            /cx x0 i dx mul add def
            /cy y0 j dy mul add def
            cx dx 2 div add cy dy 2 div add fn //.fneval2 exec pop setcolor
            newpath
            cx cy moveto
            cx dx add cy lineto
            cx dx add cy dy add lineto
            cx cy dy add lineto
            closepath fill
        } for
    } for
    end
} def

%
%  Set the colour the current shading's function gives at t; a mesh
%  shading passes components directly and skips the function.
%
/.shcolor {  % t  .  -
    shfn null eq {
        pop
    }{
        shfn //.fneval exec pop setcolor
    } ifelse
} def

%
%  a radius from the given point that covers the whole clip region:
%  the farthest corner of the region's box, plus a margin. A region
%  covering no pixels bounds nothing and is covered by a radius of zero.
%
/.clipbig {  % x y  .  r
    6 dict begin
    /py exch def /px exch def
    gsave //.clipregionpath exec flattenpath
    .pathempty { grestore 0 }{
    pathbbox grestore
    /y1 exch def /x1 exch def /y0 exch def /x0 exch def
    x0 px sub dup mul y0 py sub dup mul add sqrt
    x0 px sub dup mul y1 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    x1 px sub dup mul y0 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    x1 px sub dup mul y1 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    1 add
    } ifelse
    end
} def

%
%  Bands across the axis, each a strip of the plane perpendicular to
%  it, painted with the function's colour at its midpoint; extended
%  ends paint half-plane caps in the end colours.
%
/.axialsh {  % shdict  .  -
    20 dict begin
    /sh exch def
    /shfn sh /Function get def
    /co sh /Coords get def
    /x0 co 0 get def /y0 co 1 get def
    /x1 co 2 get def /y1 co 3 get def
    /t0 sh /Domain 2 copy known { get 0 get }{ pop pop 0 } ifelse def
    /t1 sh /Domain 2 copy known { get 1 get }{ pop pop 1 } ifelse def
    /ex sh /Extend 2 copy known { get }{ pop pop [ false false ] } ifelse def
    /dx x1 x0 sub def
    /dy y1 y0 sub def
    /len dx dy dtransform dup mul exch dup mul add sqrt def
    len 0 ne {
    /nb len round cvi 16 2 copy lt { exch } if pop
        256 2 copy gt { exch } if pop def

    % Unit vectors along and across the axis, and a breadth that
    % covers the clip.
    /ax dx dup mul dy dup mul add sqrt def
    /ux dx ax div def
    /uy dy ax div def
    /px uy neg def
    /py ux def
    /big x0 y0 //.clipbig exec def

    % sa and sb are fractions of the axis.
    /band {  % sa sb  .  -
        6 dict begin
        /sb exch def /sa exch def
        newpath
        x0 dx sa mul add px big mul add
        y0 dy sa mul add py big mul add moveto
        x0 dx sb mul add px big mul add
        y0 dy sb mul add py big mul add lineto
        x0 dx sb mul add px big mul sub
        y0 dy sb mul add py big mul sub lineto
        x0 dx sa mul add px big mul sub
        y0 dy sa mul add py big mul sub lineto
        closepath fill
        end
    } def
    ex 0 get {
        t0 //.shcolor exec
        big ax div neg 0 band
    } if
    ex 1 get {
        t1 //.shcolor exec
        1 1 big ax div add band
    } if
    0 1 nb 1 sub { /i exch def
        /sa i nb div def
        /sb i 1 add nb div def
        sa sb add 2 div t1 t0 sub mul t0 add //.shcolor exec
        sa sb band
    } for
    } if
    end
} def

%
%  The circle family painted outside in: each step fills its whole
%  circle, the next smaller covering the centre, so the last leaves
%  the gradient; an extended outer end floods the clip first and an
%  extended inner end is the innermost circle itself.
%
/.radialsh {  % shdict  .  -
    20 dict begin
    /sh exch def
    /shfn sh /Function get def
    /co sh /Coords get def
    /cx0 co 0 get def /cy0 co 1 get def /cr0 co 2 get def
    /cx1 co 3 get def /cy1 co 4 get def /cr1 co 5 get def
    /t0 sh /Domain 2 copy known { get 0 get }{ pop pop 0 } ifelse def
    /t1 sh /Domain 2 copy known { get 1 get }{ pop pop 1 } ifelse def
    /ex sh /Extend 2 copy known { get }{ pop pop [ false false ] } ifelse def

    /dr cr1 cr0 sub def

    % How far beyond each end the blend circles run, where Extend asks for
    % them (PLRM 4.9.3): at the smaller end as far as the s whose radius is
    % zero, at the larger end as far as the s whose circle covers what is
    % being painted. A family whose radius never changes has no smaller
    % end, and is carried until the moving centre has taken it clear; one
    % that neither grows nor moves extends nowhere.
    /big cx1 cy1 //.clipbig exec
         cx0 cy0 //.clipbig exec 2 copy lt { exch } if pop def
    /dc cx1 cx0 sub dup mul cy1 cy0 sub dup mul add sqrt def
    /slo 0 def
    /shi 1 def
    ex 0 get {
        dr 0 ne
            { /slo dr 0 gt { cr0 neg dr div }{ big cr0 sub dr div } ifelse def }
            { dc 0 gt { /slo big dc div neg def } if }
        ifelse
    } if
    ex 1 get {
        dr 0 ne
            { /shi dr 0 gt { big cr0 sub dr div }{ cr0 neg dr div } ifelse def }
            { dc 0 gt { /shi 1 big dc div add def } if }
        ifelse
    } if

    %  A point takes the colour of the greatest s whose circle it lies ON
    %  (PLRM 4.9.3: the circles are painted in order of increasing s, each
    %  over those before it). What is laid down for each step is therefore
    %  the region the rim SWEEPS between that step and the next -- the
    %  symmetric difference of the two discs, which is what filling both
    %  circles under the even-odd rule gives -- and the steps go in
    %  increasing s, so where a rim passes a point twice the later pass is
    %  the one left showing.
    %
    %  Filling whole discs instead answers with the greatest s CONTAINING
    %  the point. The two agree only while the family is shrinking: for a
    %  growing one every interior point is inside every later disc, so the
    %  answer is s = 1 everywhere and the shading comes out flat.
    %
    %  Each circle is begun from its own start point rather than continued
    %  from the last, so the two are separate subpaths and the rule has two
    %  boundaries to count rather than one figure joined by a line.
    /.blendcircle {  % s  .  -
        dup cr0 exch dr mul add /rr exch def
        dup cx0 exch cx1 cx0 sub mul add /xx exch def
        cy0 exch cy1 cy0 sub mul add /yy exch def
        rr 0 gt {
            xx rr add yy moveto
            xx yy rr 0 360 arc closepath
        } if
    } def

    %  How many steps a stretch of the parameter is worth: what the rim
    %  moves across the device over it, in whole device units, held between
    %  a floor that keeps a short stretch from being one jump and a ceiling
    %  that keeps a long extension from running away.
    /.blendsteps {  % s0 s1  .  int
        exch sub abs dc dr abs add mul
        0 dtransform dup mul exch dup mul add sqrt
        round cvi 8 2 copy lt { exch } if pop
        1024 2 copy gt { exch } if pop
    } def

    %  One stretch, painted in increasing s. Beyond either end the colour
    %  is that end's own: the extension carries the starting or ending
    %  colour outward rather than reading the function outside its domain.
    /.blendrun {  % s0 s1  .  -
        2 copy .blendsteps /bn exch def
        /bhi exch def /blo exch def
        0 1 bn 1 sub { /bi exch def
            /sa blo bhi blo sub bi bn div mul add def
            /sb blo bhi blo sub bi 1 add bn div mul add def
            sa 0 lt { t0 }{ sa 1 gt { t1 }{ sa t1 t0 sub mul t0 add } ifelse } ifelse
            //.shcolor exec
            newpath sa .blendcircle sb .blendcircle eofill
        } for
    } def

    %  The stretches are painted in increasing s, and the declared range is
    %  given its own steps so that extending the shading cannot coarsen the
    %  part the function actually describes.
    slo 0 lt { slo 0 .blendrun } if
    0 1 .blendrun
    shi 1 gt { 1 shi .blendrun } if
    end
} def

%
%  Mesh vertex readers.
%
%  A packed DataSource is a bit stream, not a byte stream: PLRM 4.9.3
%  lets a coordinate be 1, 2, 4, 8, 12, 16, 24 or 32 bits and a colour
%  component 1, 2, 4, 8, 12 or 16, and the fields of one vertex are
%  packed against each other with no gaps. Only the END of a vertex is
%  padded to a byte, and for a patch only the end of the patch.
%
%  So the position is held in BITS. Two readers would drift, so there is
%  one, and the byte-at-a-time reading every stream written today needs
%  is a path through it rather than a second one: a field that begins on
%  a byte boundary and is a whole number of bytes is read a byte at a
%  time and everything else a bit at a time, which are the same number by
%  construction.
%  The field widths PLRM 4.9.3 allows, one set per entry. They are sets
%  rather than a range because the reader must be able to say which
%  widths it takes, and a program's data is unreadable if it guesses.
%
/.mrdcoordbits << 1 true 2 true 4 true 8 true 12 true 16 true 24 true 32 true >> readonly def
/.mrdcompbits << 1 true 2 true 4 true 8 true 12 true 16 true >> readonly def
/.mrdflagbits << 2 true 4 true 8 true >> readonly def

%
%  Step over the padding at the end of a vertex or a patch: what follows
%  begins on a byte boundary whatever the fields before it came to.
%
/.mrdalign {  % -  .  -
    litds not { /bp bp 7 add 8 idiv 8 mul def } if
} def

%
%  Whether any of the source is still unread, counted in whichever unit
%  this source is read by.
%
/.mrdmore {  % -  .  bool
    litds { dp ds length lt }{ bp ds length 8 mul lt } ifelse
} def

%
%  Field k of Decode applied.
%
/.mrddec {  % k nbits  .  value
    dup //.mrdbits exec
    exch 2 exch exp 1 sub div
    /frv exch def /kk exch def
    dec kk 2 mul 1 add get dec kk 2 mul get sub frv mul
    dec kk 2 mul get add
} def

%
%  a mesh DataSource may instead be an array of the flag, coordinate and
%  colour values directly (PLRM 4.9.3): then BitsPer* and Decode are ignored
%  and each field is one array element. /litds selects which reading applies.
%
/.mrdflag {  % -  .  flag
    litds { ds dp get cvi /dp dp 1 add def }
          { bpf //.mrdbits exec cvi } ifelse

    % PLRM gives each mesh type the values its edge flag may take -- 0, 1
    % and 2 for a triangle, and 3 as well for a patch -- and flagmax is
    % the painter's own. A value outside them says which edge is shared
    % with a shape the data does not describe, so there is nothing to
    % paint and nothing to guess.
    dup 0 lt 1 index flagmax gt or {
        /shfill cvx /rangecheck signalerror
    } if
} def

%
%  One vertex coordinate pair out of the mesh's data source, advancing
%  the read position past it. A literal-array source hands the numbers
%  over as they stand; an encoded one reads BitsPerCoordinate for each
%  and maps it through Decode.
%
/.mrdpt {  % -  .  [x y]
    litds { [ ds dp get ds dp 1 add get ] /dp dp 2 add def }
          { [ 0 bpc //.mrddec exec 1 bpc //.mrddec exec ] } ifelse
} def

%
%  One vertex colour out of the mesh's data source, advancing past it:
%  as many components as the shading's space takes, read the same two
%  ways .mrdpt reads a coordinate.
%
/.mrdcolor {  % -  .  [c0..cn-1]
    litds { [ ds dp ncomp getinterval aload pop ] /dp dp ncomp add def }
           { [ 0 1 ncomp 1 sub { /c exch def
                 c 2 add bpcm //.mrddec exec
             } for ] } ifelse
} def

%
%  One whole vertex: its coordinate pair and its colour, in the order a
%  mesh states them.
%
%  A vertex occupies a whole number of bytes, so the read position is
%  stepped to the next boundary afterwards -- and for a free-form mesh
%  the flag read just before the vertex belongs to the same vertex, so
%  it is that flag's byte the padding is measured from.
%
/.mrdvertex {  % -  .  [x y c0..cn-1]
    [ //.mrdpt exec aload pop //.mrdcolor exec aload pop ]

    % a vertex occupies a whole number of bytes, and for a free-form
    % mesh the flag read just before it belongs to the same one.
    //.mrdalign exec
} def

%
%  Set the reader up for a shading whose shape arrives as a DataSource.
%  What it defines -- the shading, its Function, the source and the
%  position in it, and for a packed source the Decode array, the field
%  widths and the component count -- is defined in the CALLER's
%  dictionary, because the caller is what reads them. So this opens none
%  of its own.
%
%  flagrequired says whether every type this painter takes carries a
%  per-vertex edge flag. A lattice mesh carries none, and its BitsPerFlag
%  may be absent; a patch mesh must state one. flagmax is the largest
%  value that flag may take for this painter's types.
%
/.mrdinit {  % sh flagrequired  .  -
    /flagmax exch def
    /flagreq exch def
    /sh exch def
    /shfn sh /Function 2 copy known { get }{ pop pop null } ifelse def
    /ds sh /DataSource get def
    /dp 0 def
    /bp 0 def
    /litds ds type /arraytype eq def
    litds {
        % An array DataSource: flag, coordinates and colours are literal
        % numbers, one parametric value per vertex under a Function or
        % one per colour-space component otherwise (BitsPer* and Decode
        % ignored, PLRM).
        /ncomp shfn null eq { //.ncomponents exec }{ 1 } ifelse def
    }{
        /dec sh /Decode get def
        /bpc sh /BitsPerCoordinate get def
        /bpcm sh /BitsPerComponent get def
        /bpf flagreq
            { sh /BitsPerFlag get }
            { sh /BitsPerFlag 2 copy known { get }{ pop pop 8 } ifelse }
            ifelse def
        /ncomp dec length 4 sub 2 idiv def

        % a width the specification does not give is one no producer can
        % have meant, and reading it would be reading somebody else's
        % field.
        //.mrdcoordbits bpc known
        //.mrdcompbits bpcm known and
        flagreq { //.mrdflagbits bpf known and } if not {
            /shfill cvx /rangecheck signalerror
        } if
    } ifelse
} def

%
%  A mesh's colour space, resolved once for the whole shading.
%
%  A Separation or DeviceN colour is not recorded as it stands: its tints
%  run through the space's transform into an alternative space, and it is
%  the alternative-space colour the graphics state holds. Reached through
%  setcolor, the alternative space is entered afresh at every triangle,
%  and part of entering a space is asking questions of the space alone --
%  whether it is a space at all, and which space a colour in it is
%  finally recorded in. A mesh settles its space before its first
%  triangle is read, so those questions have one answer for the whole of
%  it, and this is where the answer is taken.
%
%  A Separation the device registers keeps the general route. That route
%  files each tint with the device and records the index the marking
%  methods read, and a mesh's tints are not one tint.
%
%  Answers [space alternative {transform}] for a mesh whose colours take
%  the short way round, and null for one whose colours go the way every
%  other colour goes.
%
/.gtintspace {  % -  .  [space alt {transform}] | null
    currentcolorspace
    dup //.spacekind exec /tint eq {
        dup 0 get /Separation eq {
            graphicsdict /currgstate get /device get /.registersep known
        }{ false } ifelse
        { pop null }
        { dup dup 2 get exch 3 get 3 array astore } ifelse
    }{ pop null } ifelse
} def

%
%  Set one triangle's tint colour: the tints clamped to the range a tint
%  lies in (PLRM 4.8.4), the space's transform run on them beneath the
%  boundary, and the colour it returns set in the alternative space.
%
%  The alternative space is made current, holding the colour a space is
%  entered holding and no record of a colour set in another, before the
%  transform runs: the transform is the program's and may read the
%  graphics state as well as its tints, and what it reads here is what it
%  reads when a colour of this space is set anywhere else. That much is
%  done at every triangle because the triangle before this one moved the
%  colour away from it; what the resolved space above carries is the rest
%  of entering a space, which no triangle can move.
%
%  The space the program set goes back afterwards, with the tints as
%  given: it is that space a painting operator reads to decide whether
%  the colour marks at all, and those tints that currentcolor answers
%  with. The transform may set a space of its own, so the alternative is
%  entered again behind it rather than assumed still current.
%
/.gtintcolor {  % [c0..cn-1]  .  -
    //.tintsclamp exec
    graphicsdict /currgstate get /setspace gtint 1 get put
    graphicsdict /currgstate get /sepindex null put
    graphicsdict /currgstate get /tintcomps null put
    //.csinitcolor exec
    dup aload pop
    gtint 2 get //.pexec exec
    gtint 1 get //.csalt exec
    setcolor
    graphicsdict /currgstate get /setspace gtint 0 get put
    graphicsdict /currgstate get /tintcomps 3 -1 roll put
} def

%
%  Set a mesh colour: components directly, or -- when the shading
%  carries a Function -- a single parametric value through it. The
%  mesh painters bind /shfn and /gtint before any triangle paints.
%
/.gsetcolor {  % [c0..cn-1]  .  -
    shfn null eq {
        gtint null eq
            { aload pop setcolor }
            { //.gtintcolor exec } ifelse
    }{
        0 get shfn //.fneval exec pop setcolor
    } ifelse
} def

%
%  paint a Gouraud triangle: subdivide at the edge midpoints until the
%  triangle sits within a couple of device pixels, then fill flat with
%  the corner average.
%
/.gmid {  % va vb  .  vm
    2 dict begin
    /b exch def /a exch def
    [ 0 1 a length 1 sub { /i exch def
        a i get b i get add 2 div
    } for ]
    end
} def

%
%  How finely to subdivide a Gouraud triangle, from the size the triangle
%  comes to on the device. Each level halves an edge, so a triangle L
%  device units across needs log2(L/k) levels to bring its flat fills
%  down to k across, and a triangle already smaller than k needs none.
%
%  k is half a device unit. The fills are flat, so what they approximate
%  is a colour that varies across every pixel, and a fill smaller than a
%  pixel is what lets each pixel take a colour of its own. MEASURED
%  against a mesh of small triangles carrying a full colour range: at one
%  unit the page is further from a per-pixel rendering than the constant
%  depth this replaced, and at half a unit it is the same page. At two
%  units it is worse and cheaper, at a quarter better and four times
%  dearer.
%
%  The cap is a cost bound and nothing else: 4^7 fills is the most one
%  triangle may ask for. MEASURED on a triangle covering a 384-unit page,
%  where the depth this asks for is exactly 7: the page stops changing
%  there -- 8 gives the same bytes -- because the flatness test below
%  takes over. Both painters ask this, so a patch's grid cells and a
%  mesh's triangles are subdivided by one rule.
%
/.tridepthcap 7 def

%
%  How many times a triangle must be halved before its colour is flat
%  enough to paint: the depth is taken from how far the corner colours
%  are apart, and capped, because the cost doubles with each level and
%  the page stops changing well before the cap.
%
%  Both mesh painters ask this, so a patch's grid cells and a mesh's
%  triangles are subdivided by one rule.
%
/.tridepth {  % va vb vc  .  depth
    8 dict begin
    /vc exch def /vb exch def /va exch def
    /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
    [ va vb vc ] {
        dup 0 get exch 1 get transform
        dup mxy gt { dup /mxy exch def } if dup mny lt { dup /mny exch def } if pop
        dup mxx gt { dup /mxx exch def } if dup mnx lt { dup /mnx exch def } if pop
    } forall
    /ext mxx mnx sub mxy mny sub 2 copy lt { exch } if pop def
    ext 0.5 div dup 1 le
        { pop 0 }
        { log 2 log div ceiling cvi } ifelse
    dup //.tridepthcap gt { pop //.tridepthcap } if
    end
} def

%
%  What a mesh can mark, in the user space it states its triangles in: a
%  box a triangle lying wholly past one edge of marks no pixel within.
%  Two device units of margin absorb the inverse transform's rounding,
%  and a rotated CTM only widens the box, so it never excludes a point
%  that can be marked. A device that states no size disables the test
%  with a null.
%
%  A device that scan-converts has the box narrowed to the clip region
%  as well, where that region is a rectangle: a triangle outside the clip
%  marks no pixel just as one off the page does, and a mesh is commonly
%  painted through a clip far smaller than the page it sits on -- a
%  figure's own box -- where the page alone prunes nothing and every
%  triangle beyond the figure is subdivided, coloured and filled for the
%  clip to throw away. A clip region that is not a rectangle leaves the
%  box the page, its own bounds being no narrower a statement of what it
%  holds.
%
%  A device that takes whole paths keeps the page box alone. It writes
%  the path it is given and is handed the clip beside it, and what it is
%  handed is the shape the clip was made from rather than the region
%  itself; a triangle withheld here is a triangle missing from what it
%  wrote, and the two are only the same page while those agree.
%
/.gtriclip {  % -  .  [uminx uminy umaxx umaxy] or null
    16 dict begin
    graphicsdict /currgstate get /device get /d exch def
    d /width known d /height known and {
        /dx0 -2 def /dy0 -2 def
        /dx1 d /width get 2 add def /dy1 d /height get 2 add def
        d /FillPath known not {
            //.internaldict /.cliprect get exec {
                /cy1 exch 2 add def /cx1 exch 2 add def
                /cy0 exch 2 sub def /cx0 exch 2 sub def
                cx0 dx0 gt { /dx0 cx0 def } if  cy0 dy0 gt { /dy0 cy0 def } if
                cx1 dx1 lt { /dx1 cx1 def } if  cy1 dy1 lt { /dy1 cy1 def } if
            } if
        } if
        /uminx 9e99 def /uminy 9e99 def /umaxx -9e99 def /umaxy -9e99 def
        [ [ dx0 dy0 ] [ dx1 dy0 ] [ dx1 dy1 ] [ dx0 dy1 ] ] {
            aload pop itransform /uy exch def /ux exch def
            ux uminx lt { /uminx ux def } if  ux umaxx gt { /umaxx ux def } if
            uy uminy lt { /uminy uy def } if  uy umaxy gt { /umaxy uy def } if
        } forall
        [ uminx uminy umaxx umaxy ]
    }{ null } ifelse
    end
} def

%
%  What a mesh's flat fills paint through, or a null conversion where its
%  triangles take the general route instead.
%
%  A mesh paints one flat fill per subdivided cell, and every one of them
%  asks the same questions of the graphics state before it paints
%  anything: which route the colour takes, whether the device takes whole
%  paths, which of the device's native spaces the colour is delivered in,
%  which device it is, and which methods that device fills and flushes
%  with. None of them can move while a mesh paints. The colour route
%  reads the space a colour was set in and the space it is recorded in,
%  and both are settled for the whole mesh before its first triangle: a
%  tint mesh restores them at every triangle, and every other kind never
%  leaves them. The rest are the device's, and a mesh already resolves
%  the device once, above, to decide what its triangles can mark. So the
%  answers are taken here, once, and the triangles below paint through
%  them.
%
%  A null conversion where any of it says the general route: a pattern or
%  a colour that marks nothing is a fill of its own, a device that takes
%  whole paths writes the triangle rather than scan-converting it, and a
%  device with no polygon fill to call, or none this can call, has
%  nothing here to call it through.
%
/.gflatplan {  % -  .  conv dev fillpoly flushes
    DEVICE /FillPath known
    DEVICE /FillPoly known not or
    DEVICE /FillPoly 2 copy known { get xcheck not }{ pop pop true } ifelse or
    //.xpostsys /.colorroute get exec /direct ne or
    { null null null false }{
        //.currentcolordict DEVICE /nativecolorspace get
        2 copy known { get }{ pop pop null } ifelse

        % The conversion is registered as the name of the operator that
        % reads the colour back, and the name is resolved here rather
        % than at every triangle. It resolves to what it resolves to now:
        % nothing a mesh does between here and its last triangle reaches
        % the dictionaries the lookup would walk.
        dup type /nametype eq { load } if

        DEVICE
        DEVICE /FillPoly get
        DEVICE /Flush known
    } ifelse
} def

%
%  Fill the triangle va vb vc, flat, in the colour already set. One of
%  these is bound to /gflat for the whole of a mesh, and the triangles
%  below reach it by that name; both read the triangle out of the
%  dictionary the caller holds it in rather than taking it as operands,
%  so the caller hands the painter nothing and the choice between them
%  costs a name.
%
%  The general painter is the path and the fill operator, which is what
%  every other painting in this file does and what a mesh does where the
%  plan above found any reason not to shorten it.
%
/.gflatgeneral {  % -  .  -
    newpath
    va 0 get va 1 get moveto
    vb 0 get vb 1 get lineto
    vc 0 get vc 1 get lineto
    closepath fill
} def

%
%  The short painter is that fill with the questions taken out of it:
%  the three points become the polygon the device fills, the colour goes
%  through the conversion the plan resolved, and the device and its
%  methods are the ones the plan holds. What is left is what the fill
%  does that a triangle cannot settle in advance -- the colour of this
%  triangle, and the polygon of these three points.
%
%  A triangle the clip region can cut is not shortened: the polygon step
%  answers false for one, and it is painted by the general painter,
%  which cuts it.
%
/.gflatfast {  % -  .  -
    va vb vc gtripoly {
        % as .fillparts paints a part: the components go under the
        % polygon, and a part too small to enclose area is nothing to
        % paint.
        dup length 2 gt {
            [ gconv
            //.applytransfer exec
            counttomark 2 add -1 roll
            gdev gfpoly
            true //.setpagemarked exec
            pop
        }{
            pop
        } ifelse
        gflush { gdev dup /Flush get exec } if
    }{
        //.gflatgeneral exec
    } ifelse
} def

%
%  Paint one triangle, subdividing it dpt times: at depth zero the
%  triangle is filled in the colour of its corners, and above zero it is
%  cut into four on its edge midpoints and each painted a level down.
%
%  A triangle that lies wholly off the page is skipped rather than
%  subdivided, which is what holds a mesh's cost to the page when a
%  Decode range or a stray coordinate throws one a long way out.
%
/.gtri {  % va vb vc dpt  .  -
    6 dict begin
    /dpt exch def /vc exch def /vb exch def /va exch def

    % A triangle lying wholly past one edge of the page marks nothing
    % there, so its subdivision is skipped. This holds a mesh's cost to
    % the page when a Decode or a stray coordinate throws a triangle's
    % far corner an enormous distance off it, where the colour never
    % comes flat over so wide a span and the depth cap alone would spend
    % its whole budget subdividing fills the device only discards.
    gclipbox dup null eq { pop false }{
        aload pop /gy1 exch def /gx1 exch def /gy0 exch def /gx0 exch def
        va 0 get gx0 lt vb 0 get gx0 lt and vc 0 get gx0 lt and
        va 0 get gx1 gt vb 0 get gx1 gt and vc 0 get gx1 gt and or
        va 1 get gy0 lt vb 1 get gy0 lt and vc 1 get gy0 lt and or
        va 1 get gy1 gt vb 1 get gy1 gt and vc 1 get gy1 gt and or
    } ifelse
    { end }{
    /dd 0 def
    2 1 va length 1 sub { /i exch def
        va i get vb i get sub abs dup dd gt { /dd exch def }{ pop } ifelse
        va i get vc i get sub abs dup dd gt { /dd exch def }{ pop } ifelse
    } for
    dpt 0 le dd 0.015 le or {
        % flat: fill with the corner average
        [ 2 1 va length 1 sub { /i exch def
            va i get vb i get add vc i get add 3 div
        } for ] //.gsetcolor exec

        % The fill of a flat triangle, through whichever painter the
        % plan bound for this mesh.
        gflat
    }{
        /mab va vb //.gmid exec def
        /mbc vb vc //.gmid exec def
        /mca vc va //.gmid exec def
        va mab mca dpt 1 sub //.xpostsys /.gtri get exec
        mab vb mbc dpt 1 sub //.xpostsys /.gtri get exec
        mca mbc vc dpt 1 sub //.xpostsys /.gtri get exec
        mab mbc mca dpt 1 sub //.xpostsys /.gtri get exec
    } ifelse
    end
    } ifelse
} def

%
%  Free-form (type 4) and lattice-form (type 5) triangle meshes with
%  per-vertex colours.
%
/.meshsh {  % shdict  .  -
    29 dict begin
    /gclipbox //.gtriclip exec def
    //.gflatplan exec
    /gflush exch def /gfpoly exch def /gdev exch def

    % The conversion is executable, so it is read here while it is still
    % on the operand stack: naming it would run it.
    dup null eq { //.gflatgeneral }{ //.gflatfast } ifelse /gflat exch def
    /gconv exch def
    /gtripoly //.internaldict /.tripoly get def
    /gtint //.gtintspace exec def

    % a lattice (type 5) mesh carries no per-vertex flag, so BitsPerFlag
    % may be absent from one of the two types this paints.
    false 2 //.mrdinit exec
    sh /ShadingType get 5 eq {
        /vpr sh /VerticesPerRow get def

        % PLRM 4.9.3: a lattice mesh has at least two vertices per row.
        % A row of fewer consumes no vertices from the source, so the read
        % position never advances and the row loop below never reaches its
        % source-exhausted exit -- a single shfill that spins for ever.
        vpr 2 lt { /shfill cvx /rangecheck signalerror } if
        /prev null def
        {
            //.mrdmore exec not { exit } if
            /row [ vpr { //.mrdvertex exec } repeat ] def
            prev null ne {
                0 1 vpr 2 sub { /i exch def
                    prev i get prev i 1 add get row i get
                    3 copy //.tridepth exec //.gtri exec
                    prev i 1 add get row i get row i 1 add get
                    3 copy //.tridepth exec //.gtri exec
                } for
            } if
            /prev row def
        } loop
    }{
        /va null def /vb null def /vc null def
        {
            //.mrdmore exec not { exit } if
            /flag //.mrdflag exec def
            flag 0 eq {
                //.mrdmore exec not { exit } if
                /va //.mrdvertex exec def
                //.mrdflag exec pop
                /vb //.mrdvertex exec def
                //.mrdflag exec pop
                /vc //.mrdvertex exec def
            }{
                flag 1 eq {
                    /va vb def /vb vc def
                }{
                    /vb vc def
                } ifelse
                /vc //.mrdvertex exec def
            } ifelse
            va vb vc 3 copy //.tridepth exec //.gtri exec
        } loop
    } ifelse
    end
} def

%
%  a cubic Bezier component at parameter t
%
/.bez1 {  % a0 a1 a2 a3 t  .  v
    5 dict begin
    /t exch def /a3 exch def /a2 exch def /a1 exch def /a0 exch def
    /u 1 t sub def
    a0 u u mul u mul mul
    a1 3 mul u u mul t mul mul add
    a2 3 mul u t t mul mul mul add
    a3 t t mul t mul mul add
    end
} def

%
%  The 4x4 control grid slot (row-major, rows pairing with u) for
%  each patch point p1..p16 in the data-stream order: the boundary
%  counterclockwise from the first corner, then the four interior
%  points.
%
/.pgridmap [ 0 1 2 3 7 11 15 14 13 12 8 4 5 6 10 9 ] readonly def

%
%  a weighted combination of grid points, divided by 9: the Coons
%  interior points are ninths of boundary sums.
%
/.pmix {  % [w slot w slot ...]  .  [x y]
    4 dict begin
    /spec exch def
    /sx 0 def /sy 0 def
    0 2 spec length 2 sub { /i exch def
        /w spec i get def
        /p g spec i 1 add get get def
        /sx sx p 0 get w mul add def
        /sy sy p 1 get w mul add def
    } for
    [ sx 9 div sy 9 div ]
    end
} def

%
%  Paint the current 4x4 grid g with corner colours cols: collapse
%  the grid's columns at each u by .bez1, sweep the resulting curve
%  in v, and hand the cells to the Gouraud triangles with corner
%  colours blended bilinearly.
%
/.patchpaint {  % -  .  -
    15 dict begin
    /gclipbox //.gtriclip exec def
    //.gflatplan exec
    /gflush exch def /gfpoly exch def /gdev exch def

    % The conversion is executable, so it is read here while it is still
    % on the operand stack: naming it would run it.
    dup null eq { //.gflatgeneral }{ //.gflatfast } ifelse /gflat exch def
    /gconv exch def
    /gtripoly //.internaldict /.tripoly get def

    % Subdivision from the device size of the boundary points
    /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
    0 1 11 { //.pgridmap exch get g exch get aload pop transform
        dup mxy gt { dup /mxy exch def } if dup mny lt { dup /mny exch def } if pop
        dup mxx gt { dup /mxx exch def } if dup mnx lt { dup /mnx exch def } if pop
    } for
    /n mxx mnx sub mxy mny sub 2 copy lt { exch } if pop
       6 div ceiling cvi
       3 2 copy lt { exch } if pop
       12 2 copy gt { exch } if pop def
    /verts [ 0 1 n { /iu exch def
        /u iu n div def
        /q [ 0 1 3 { /j exch def
            [ g j get 0 get g j 4 add get 0 get
              g j 8 add get 0 get g j 12 add get 0 get u //.bez1 exec
              g j get 1 get g j 4 add get 1 get
              g j 8 add get 1 get g j 12 add get 1 get u //.bez1 exec ]
        } for ] def
        [ 0 1 n { /iv exch def
            /v iv n div def
            [
            q 0 get 0 get q 1 get 0 get q 2 get 0 get q 3 get 0 get v //.bez1 exec
            q 0 get 1 get q 1 get 1 get q 2 get 1 get q 3 get 1 get v //.bez1 exec
            0 1 ncomp 1 sub { /c exch def
                cols 0 get c get 1 u sub mul 1 v sub mul
                cols 1 get c get 1 u sub mul v mul add
                cols 2 get c get u mul v mul add
                cols 3 get c get u mul 1 v sub mul add
            } for
            ]
        } for ]
    } for ] def
    0 1 n 1 sub { /iu exch def
        0 1 n 1 sub { /iv exch def
            verts iu get iv get
            verts iu 1 add get iv get
            verts iu get iv 1 add get
            3 copy //.tridepth exec //.gtri exec
            verts iu 1 add get iv get
            verts iu 1 add get iv 1 add get
            verts iu get iv 1 add get
            3 copy //.tridepth exec //.gtri exec
        } for
    } for
    end
} def

%
%  Coons (type 6) and tensor-product (type 7) patch meshes. A Coons
%  patch completes to a tensor patch by the standard interior points,
%  so one surface serves both.
%
/.patchsh {  % shdict  .  -
    30 dict begin
    /gtint //.gtintspace exec def

    % Both patch types carry a flag on every patch, so BitsPerFlag is
    % required of them.
    true 3 //.mrdinit exec
    /tensor sh /ShadingType get 7 eq def

    % pts: p1..p16 as [x y] in data order; cols: c1..c4; g: the grid
    /pts 16 array def
    /cols 4 array def
    /g 16 array def
    /np tensor { 15 }{ 11 } ifelse def
    {
        //.mrdmore exec not { exit } if
        /flag //.mrdflag exec def
        //.mrdmore exec not { exit } if
        flag 0 eq {
            0 1 np { pts exch //.mrdpt exec put } for
            0 1 3 { cols exch //.mrdcolor exec put } for
        }{
            % The shared edge is the previous patch's: its four
            % points become p1..p4 and its two colours c1..c2.
            /oldp [ [ 3 4 5 6 ] [ 6 7 8 9 ] [ 9 10 11 0 ] ] flag 1 sub get
                   [ exch { pts exch get } forall ] def
            /oldc [ [ 1 2 ] [ 2 3 ] [ 3 0 ] ] flag 1 sub get
                   [ exch { cols exch get } forall ] def
            4 1 np { pts exch //.mrdpt exec put } for
            2 1 3 { cols exch //.mrdcolor exec put } for
            0 1 3 { /k exch def pts k oldp k get put } for
            0 1 1 { /k exch def cols k oldc k get put } for
        } ifelse

        % a patch, flag and all, occupies a whole number of bytes
        //.mrdalign exec
        0 1 np { /k exch def g //.pgridmap k get pts k get put } for
        tensor not {
            % The Coons interior points, as ninths of boundary sums
            g 5 [ -4 0 6 1 6 4 -2 3 -2 12 3 13 3 7 -1 15 ] //.pmix exec put
            g 6 [ -4 3 6 2 6 7 -2 0 -2 15 3 4 3 14 -1 12 ] //.pmix exec put
            g 9 [ -4 12 6 13 6 8 -2 15 -2 0 3 1 3 11 -1 3 ] //.pmix exec put
            g 10 [ -4 15 6 14 6 11 -2 12 -2 3 3 2 3 8 -1 0 ] //.pmix exec put
        } if
        //.patchpaint exec
    } loop
    end
} def
end

%
%  Paint the shading over the current clip region; the current path
%  survives untouched.
%
.xpostsys begin

%
%  Which procedure paints each shading type (PLRM 4.9.3). Written as a
%  table rather than a chain of tests: the chain asked five questions of
%  one number and each arm had to leave the stack as the next one found
%  it, which two of them did not.
%
%
%  Whether the device would rather have the shading than the fills it
%  decomposes to. A consumer that holds shadings natively draws the gradient
%  with its own arithmetic, which is smooth where a decomposition is banded
%  and small where it is enormous -- a page of flat cells carries one path
%  per cell and the gradient is gone from it either way.
%
%  Only the three analytic types are offered. The mesh types carry their
%  geometry in a stream a writer would have to restate, and restating it is
%  not this.
%
%  The function is offered with them, and a function the writer cannot state
%  keeps the whole shading here: a shading written without its function is
%  not the shading, and half of one is worse than the decomposition.
%
%  Which of them a device takes is the device's own answer, stated on it as
%  /ShadingTypes: what one writer holds natively another has no way to say,
%  and a device that answers for a type it cannot write would put a name in
%  its output that its output never defines. A device that states nothing
%  takes none, and is painted by the walk as it always was.
/.shdevtypes {  % type  .  bool
    DEVICE /ShadingTypes 2 copy known
        { get exch known }{ pop pop pop false } ifelse
} def

%  Only the device spaces are offered. A shading in a space that would need
%  a resource of its own alongside it is decomposed as before: written
%  without that resource it would not be the shading, and writing half of
%  one is worse than the decomposition.
/.shdevcs << /DeviceGray true /DeviceRGB true /DeviceCMYK true >> readonly def

%  The device space a shading paints in, or null where it paints in
%  something a writer would have to state a resource for. PLRM 4.8 lets a
%  device space be written as the bare name or as an array holding it, and
%  a shading dictionary in the corpus does both, so both are read here.
/.shdevcsname {  % any  .  name | null
    dup type /nametype eq {
        //.shdevcs 1 index known { }{ pop null } ifelse
    }{
        dup type dup /arraytype eq exch /packedarraytype eq or {
            dup length 1 eq {
                0 get dup type /nametype eq
                    { //.shdevcs 1 index known { }{ pop null } ifelse }
                    { pop null } ifelse
            }{ pop null } ifelse
        }{ pop null } ifelse
    } ifelse
} def

/.shdevfn1 {  % fndict  .  bool
    dup type /dicttype ne { pop false }{
    dup /FunctionType known not { pop false }{
    dup /FunctionType get
    dup 2 eq { pop pop true }{
    dup 3 eq { pop /Functions get //.xpostsys /.shdevfnok get exec }{
    0 eq {
        % A sampled function is written out as a stream, so its samples have
        % to be readable more than once: a string source can be, a file or a
        % procedure cannot.
        /DataSource get type /stringtype eq
    }{ pop false } ifelse } ifelse } ifelse } ifelse } ifelse
} def

/.shdevfnok {  % fn  .  bool
    dup type dup /arraytype eq exch /packedarraytype eq or {
        true exch { //.xpostsys /.shdevfn1 get exec and } forall
    }{ //.shdevfn1 exec } ifelse
} def

%  The mesh types carry their geometry rather than a function of it, and
%  PLRM 4.9.3 lets that geometry arrive as an array of numbers instead of a
%  stream of packed samples. A writer states it packed, so the array is
%  offered only where the writer can restate it; a stream source is not
%  offered at all, being readable once and already spent by the time this
%  is asked.
/.shmeshtypes << 4 true 5 true 6 true 7 true >> readonly def

/.shdevmeshok {  % shdict  .  bool
    dup /ShadingType get //.shmeshtypes exch known {
        dup /DataSource 2 copy known {
            get type dup /arraytype eq exch /packedarraytype eq or
        }{ pop pop false } ifelse
    }{ pop false } ifelse
} def

/.shtodevice {  % shdict  .  bool
    DEVICE /ShadingPaint known {
        dup /ShadingType get //.shdevtypes exec
        1 index /ColorSpace get //.shdevcsname exec dup null ne
            exch pop and {
            % an analytic type is offered with its function; a mesh type
            % carries its colours at its vertices and has none to check
            dup //.shdevmeshok exec
                { true }
                { dup /Function 2 copy known { get //.shdevfnok exec }{ pop pop false } ifelse }
            ifelse
            { DEVICE dup /ShadingPaint get exec true }{ pop false } ifelse
        }{ pop false } ifelse
    }{ pop false } ifelse
} def

/.shadepainters <<
    1 //.fnsh      2 //.axialsh   3 //.radialsh
    4 //.meshsh    5 //.meshsh
    6 //.patchsh   7 //.patchsh
>> def

%
%  Paint a shading over the current clip region (PLRM 8.2). The current
%  path is not touched: what a program had before the shading is what it
%  has after.
%
%  The dictionary's ShadingType selects one of seven painters, and the
%  type is settled before the gsave: an error unwinds the operand,
%  dictionary and execution stacks but not the graphics stack, so
%  raising after the gsave would leave it unmatched and a program that
%  caught the rangecheck would go on painting in whatever state that
%  left.
%
systemdict /shfill [ /dicttype ] {  % dict  .  -
    //.uncoloredcell /on get { /shfill cvx /undefined signalerror } if
    % The type is settled before the gsave, because an error unwinds the
    % operand, dictionary and execution stacks and not the graphics
    % stack. Raising after the gsave would leave it unmatched, and a
    % program that caught the rangecheck would go on painting in whatever
    % colour and clip the shading was given.
    dup /ShadingType get
    //.shadepainters 1 index known not
        { pop pop /shfill cvx /rangecheck signalerror } if

    % And the Function is held to the arity its type calls for, here for
    % the reason the type itself is settled here: before the gsave, so a
    % program that catches the refusal is not left painting in a graphics
    % state nothing closed.
    2 copy //.fncheckshading exec

    //.shadepainters exch get exch          % Proc shdict

    {
    gsave
    dup /ColorSpace get setcolorspace
    dup /BBox 2 copy known {
        get
        newpath
        dup 0 get 1 index 1 get moveto
        dup 2 get 1 index 1 get lineto
        dup 2 get 1 index 3 get lineto
        dup 0 get 1 index 3 get lineto
        pop closepath clip newpath
    }{ pop pop } ifelse
    dup //.shtodevice exec
    { pop pop }{ exch exec } ifelse
    grestore
    } null 0 //.xpostsys /.callout get exec
} .defopin
end

end end end

%
%  What this file can be asked for, as PLRM Table 3.8 has a program ask it.
%  An implicit resource's instance is the capability itself: 7
%  /ShadingType findresource answers 7 where type 7 shadings are painted and
%  raises undefined where they are not, so a program can settle what it is
%  talking to without painting anything to find out.
%
%  Declared here rather than beside the categories, because what is true of
%  these is decided by the code in this file.
%
%  The shading types are not listed at all: they are read off the dispatch
%  dictionary that decides which painter a type reaches, so the set a
%  program can discover and the set the interpreter paints are one
%  statement and cannot come apart. A type added to that dictionary is
%  discoverable the moment it is dispatched, with nothing else to write.
%
%  The function types are still a list, there being no such dictionary to
%  read -- the type is settled by a chain of comparisons rather than by a
%  lookup -- so the list is held to what the interpreter evaluates by
%  tests/check-function-facts.sh instead.
%
currentglobal true setglobal
//.shadepainters { pop dup /ShadingType defineresource pop } forall
[ 0 2 3 ] { dup /FunctionType defineresource pop } forall
setglobal

//.internaldict /QUIET known { }{ (eof shade.ps\n)print } ifelse
