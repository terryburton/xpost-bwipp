%!PS
%
% shade.ps
%
% Smooth shading (PLRM 4.9.3): shfill resolves a gradient to a stack of flat-colour fills.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  shfill paints a shading dictionary
%  over the current clip region. The gradient resolves to a stack of
%  flat-colour fills through the ordinary paint pipeline: an axial
%  shading as bands across its axis, a radial one as circles painted
%  outside in, a triangle mesh by recursive subdivision. The band and
%  step counts follow the device size of the geometry, so the steps
%  stay within a device pixel or two.
%
//.internaldict /QUIET known { }{ (loading shade.ps...)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

%
%  t fndict  .fneval  c0..cn-1
%  evaluate a PostScript function dictionary at t: exponential
%  interpolation (type 2), stitching (type 3), and one-input sampled
%  (type 0, byte-aligned sample depths) functions serve the shading
%  dictionaries producers write
%
.xpostsys begin

%
%  The position is the caller's, so this opens no dictionary of its own:
%  a local one would take the /bp definitions with it and the stream
%  would be read from the same place for ever.
%
%  Accumulated in a real, most significant bit first.
%
/.mrdbits {  % nbits  .  v
    dup 8 mod 0 eq bp 8 mod 0 eq and {
        8 idiv 0.0 exch {
            256 mul ds bp 8 idiv get add
            /bp bp 8 add def
        } repeat
    }{
        0.0 exch {
            2 mul
            ds bp 8 idiv get 7 bp 8 mod sub neg bitshift 1 and
            add
            /bp bp 1 add def
        } repeat
    } ifelse
} def
%
%  The widths PLRM 3.10.1 allows a sample to be. A sampled function's
%  DataSource is a continuous bit stream with no padding at a byte
%  boundary, so these are read by counting bits, the way a mesh stream is.
%
/.fnsamplebits << 1 true 2 true 4 true 8 true 12 true 16 true 24 true 32 true >> def

%
%  What a sampled function needs, defined in the CALLER's dictionary from
%  the f it holds: the sample width, the range and how many components
%  that makes, and the source the samples come out of. It opens no
%  dictionary of its own, because what it defines is what the caller
%  reads -- and both evaluators read the same things.
%
/.fnsampled {  % -  .  -
    /bps f /BitsPerSample get def
    //.fnsamplebits bps known not { /shfill cvx /rangecheck signalerror } if
    /rng f /Range get def
    /nc rng length 2 idiv def
    /ds f /DataSource get def
    /litds false def
    /max 2 bps exp 1 sub def
} def

%
%  The sample at that index, as it stands in the stream. The samples are
%  adjacent with nothing between them, so an index names a bit position
%  and not a byte one. What scales it to its range is left to the caller,
%  which interpolates between two samples first and divides once.
%
/.fnsample {  % index  .  value
    bps mul /bp exch def
    bps //.mrdbits exec
} def

/.fneval {  % t fn  .  c0..cn-1 n
    10 dict begin
    /f exch def
    /d0 f /Domain get 0 get def
    /d1 f /Domain get 1 get def
    dup d0 lt { pop d0 } if
    dup d1 gt { pop d1 } if
    /t exch def
    f /FunctionType get
    dup 2 eq {
        pop
        /c0 f /C0 2 copy known { get }{ pop pop [ 0.0 ] } ifelse def
        /c1 f /C1 2 copy known { get }{ pop pop [ 1.0 ] } ifelse def
        /tn t f /N get exp def
        0 1 c0 length 1 sub { /i exch def
            c0 i get
            c1 i get c0 i get sub tn mul add
        } for
        c0 length
    }{ dup 3 eq {
        pop
        /bs f /Bounds get def
        /k 0 def
        0 1 bs length 1 sub { /j exch def
            t bs j get ge { /k j 1 add def } if
        } for
        /lo k 0 eq { d0 }{ bs k 1 sub get } ifelse def
        /hi k bs length eq { d1 }{ bs k get } ifelse def
        /e0 f /Encode get k 2 mul get def
        /e1 f /Encode get k 2 mul 1 add get def
        hi lo eq { e0 }{ t lo sub hi lo sub div e1 e0 sub mul e0 add } ifelse
        f /Functions get k get //.xpostsys /.fneval get exec
    }{ 0 eq {
        % sampled with one input: linear interpolation between the
        % bracketing samples
        /size f /Size get 0 get def
        //.fnsampled exec
        /x t d0 sub d1 d0 sub dup 0 eq { pop 1 } if div
           size 1 sub mul def
        /i0 x floor cvi def
        i0 size 1 sub ge { /i0 size 2 sub def } if
        i0 0 lt { /i0 0 def } if
        /fr x i0 sub def
        0 1 nc 1 sub { /c exch def
            i0 nc mul c add //.fnsample exec
            i0 1 add nc mul c add //.fnsample exec
            1 index sub fr mul add max div
            rng c 2 mul 1 add get rng c 2 mul get sub mul
            rng c 2 mul get add
        } for
        nc
    }{
        /shfill cvx /rangecheck signalerror
    } ifelse } ifelse } ifelse
    end
} def

%
%  evaluate a two-input function: a sampled function with a 2-D Size,
%  bilinear between the four bracketing samples, or an array of
%  two-input single-output functions, one per component
%
/.fneval2 {  % x y fn  .  c0..cn-1 n
    dup type /arraytype eq {
        4 dict begin
        /fa exch def /yy exch def /xx exch def
        0 1 fa length 1 sub { /k exch def
            xx yy fa k get //.xpostsys /.fneval2 get exec pop
        } for
        fa length
        end
    }{
        16 dict begin
        /f exch def
        /yy exch def /xx exch def
        f /FunctionType get 0 ne { /shfill cvx /rangecheck signalerror } if
        /d f /Domain get def
        xx d 0 get 2 copy lt { exch } if pop d 1 get 2 copy gt { exch } if pop /xx exch def
        yy d 2 get 2 copy lt { exch } if pop d 3 get 2 copy gt { exch } if pop /yy exch def
        /sx f /Size get 0 get def
        /sy f /Size get 1 get def
        //.fnsampled exec
        /enc f /Encode 2 copy known { get }{ pop pop
            [ 0 sx 1 sub 0 sy 1 sub ] } ifelse def
        /ex xx d 0 get sub d 1 get d 0 get sub dup 0 eq { pop 1 } if div
            enc 1 get enc 0 get sub mul enc 0 get add def
        /ey yy d 2 get sub d 3 get d 2 get sub dup 0 eq { pop 1 } if div
            enc 3 get enc 2 get sub mul enc 2 get add def
        ex 0 lt { /ex 0 def } if
        ex sx 1 sub gt { /ex sx 1 sub def } if
        ey 0 lt { /ey 0 def } if
        ey sy 1 sub gt { /ey sy 1 sub def } if
        /i0 ex floor cvi def
        /j0 ey floor cvi def
        /i1 i0 1 add sx 1 sub 2 copy gt { exch } if pop def
        /j1 j0 1 add sy 1 sub 2 copy gt { exch } if pop def
        /fx ex i0 sub def
        /fy ey j0 sub def

        % The sample scaled to 0..1.
        /samp {  % i j c  .  v
            3 1 roll sx mul add nc mul add //.fnsample exec max div
        } def
        0 1 nc 1 sub { /c exch def
            i0 j0 c samp 1 fx sub mul i1 j0 c samp fx mul add
            1 fy sub mul
            i0 j1 c samp 1 fx sub mul i1 j1 c samp fx mul add
            fy mul add
            rng c 2 mul 1 add get rng c 2 mul get sub mul
            rng c 2 mul get add
        } for
        nc
        end
    } ifelse
} def

%
%  function-based shading (type 1): the domain rectangle, taken
%  through the optional Matrix, paints as a grid of cells a few
%  device pixels across, each filled flat with the function's colour
%  at its centre
%
/.fnsh {  % shdict  .  -
    14 dict begin
    /sh exch def
    /fn sh /Function get def
    /dom sh /Domain 2 copy known { get }{ pop pop [ 0 1 0 1 ] } ifelse def
    sh /Matrix 2 copy known { get concat }{ pop pop } ifelse
    /x0 dom 0 get def /x1 dom 1 get def
    /y0 dom 2 get def /y1 dom 3 get def
    /nx x1 x0 sub 0 dtransform dup mul exch dup mul add sqrt
        3 div ceiling cvi 1 2 copy lt { exch } if pop 200 2 copy gt { exch } if pop def
    /ny 0 y1 y0 sub dtransform dup mul exch dup mul add sqrt
        3 div ceiling cvi 1 2 copy lt { exch } if pop 200 2 copy gt { exch } if pop def
    /dx x1 x0 sub nx div def
    /dy y1 y0 sub ny div def
    0 1 nx 1 sub { /i exch def
        0 1 ny 1 sub { /j exch def
            /cx x0 i dx mul add def
            /cy y0 j dy mul add def
            cx dx 2 div add cy dy 2 div add fn //.fneval2 exec pop setcolor
            newpath
            cx cy moveto
            cx dx add cy lineto
            cx dx add cy dy add lineto
            cx cy dy add lineto
            closepath fill
        } for
    } for
    end
} def

%
%  set the colour the current shading's function gives at t; a mesh
%  shading passes components directly and skips the function
%
/.shcolor {  % t  .  -
    shfn null eq {
        pop
    }{
        shfn //.fneval exec pop setcolor
    } ifelse
} def

%
%  a radius from the given point that covers the whole clip region:
%  the farthest corner of the region's box, plus a margin. A region
%  covering no pixels bounds nothing and is covered by a radius of zero
%
/.clipbig {  % x y  .  r
    6 dict begin
    /py exch def /px exch def
    gsave //.xpostsys /.clipregionpath get exec flattenpath
    .pathempty { grestore 0 }{
    pathbbox grestore
    /y1 exch def /x1 exch def /y0 exch def /x0 exch def
    x0 px sub dup mul y0 py sub dup mul add sqrt
    x0 px sub dup mul y1 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    x1 px sub dup mul y0 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    x1 px sub dup mul y1 py sub dup mul add sqrt
    2 copy lt { exch } if pop
    1 add
    } ifelse
    end
} def

%
%  bands across the axis, each a strip of the plane perpendicular to
%  it, painted with the function's colour at its midpoint; extended
%  ends paint half-plane caps in the end colours
%
/.axialsh {  % shdict  .  -
    20 dict begin
    /sh exch def
    /shfn sh /Function get def
    /co sh /Coords get def
    /x0 co 0 get def /y0 co 1 get def
    /x1 co 2 get def /y1 co 3 get def
    /t0 sh /Domain 2 copy known { get 0 get }{ pop pop 0 } ifelse def
    /t1 sh /Domain 2 copy known { get 1 get }{ pop pop 1 } ifelse def
    /ex sh /Extend 2 copy known { get }{ pop pop [ false false ] } ifelse def
    /dx x1 x0 sub def
    /dy y1 y0 sub def
    /len dx dy dtransform dup mul exch dup mul add sqrt def
    len 0 ne {
    /nb len round cvi 16 2 copy lt { exch } if pop
        256 2 copy gt { exch } if pop def
    % unit vectors along and across the axis, and a breadth that
    % covers the clip
    /ax dx dup mul dy dup mul add sqrt def
    /ux dx ax div def
    /uy dy ax div def
    /px uy neg def
    /py ux def
    /big x0 y0 //.clipbig exec def

    % sa and sb are fractions of the axis.
    /band {  % sa sb  .  -
        6 dict begin
        /sb exch def /sa exch def
        newpath
        x0 dx sa mul add px big mul add
        y0 dy sa mul add py big mul add moveto
        x0 dx sb mul add px big mul add
        y0 dy sb mul add py big mul add lineto
        x0 dx sb mul add px big mul sub
        y0 dy sb mul add py big mul sub lineto
        x0 dx sa mul add px big mul sub
        y0 dy sa mul add py big mul sub lineto
        closepath fill
        end
    } def
    ex 0 get {
        t0 //.shcolor exec
        big ax div neg 0 band
    } if
    ex 1 get {
        t1 //.shcolor exec
        1 1 big ax div add band
    } if
    0 1 nb 1 sub { /i exch def
        /sa i nb div def
        /sb i 1 add nb div def
        sa sb add 2 div t1 t0 sub mul t0 add //.shcolor exec
        sa sb band
    } for
    } if
    end
} def

%
%  the circle family painted outside in: each step fills its whole
%  circle, the next smaller covering the centre, so the last leaves
%  the gradient; an extended outer end floods the clip first and an
%  extended inner end is the innermost circle itself
%
/.radialsh {  % shdict  .  -
    20 dict begin
    /sh exch def
    /shfn sh /Function get def
    /co sh /Coords get def
    /cx0 co 0 get def /cy0 co 1 get def /cr0 co 2 get def
    /cx1 co 3 get def /cy1 co 4 get def /cr1 co 5 get def
    /t0 sh /Domain 2 copy known { get 0 get }{ pop pop 0 } ifelse def
    /t1 sh /Domain 2 copy known { get 1 get }{ pop pop 1 } ifelse def
    /ex sh /Extend 2 copy known { get }{ pop pop [ false false ] } ifelse def
    % step count from the device size of the swept ring
    /nb cx1 cx0 sub cy1 cy0 sub dtransform dup mul exch dup mul add sqrt
        cr1 cr0 sub 0 dtransform dup mul exch dup mul add sqrt add
        round cvi 16 2 copy lt { exch } if pop
        256 2 copy gt { exch } if pop def
    /inout cr1 cr0 ge def
    ex inout { 1 }{ 0 } ifelse get {
        inout { t1 }{ t0 } ifelse //.shcolor exec
        newpath
        inout { cx1 cy1 }{ cx0 cy0 } ifelse
        2 copy //.clipbig exec 0 360 arc fill
    } if
    % paint from the larger circle to the smaller
    nb -1 0 { /i exch def
        /s i nb div def
        inout not { /s 1 s sub def } if
        s t1 t0 sub mul t0 add //.shcolor exec
        newpath
        cx0 cx1 cx0 sub s mul add
        cy0 cy1 cy0 sub s mul add
        cr0 cr1 cr0 sub s mul add
        dup 0 gt { 0 360 arc fill }{ pop pop pop } ifelse
    } for
    end
} def

%
%  mesh vertex readers.
%
%  A packed DataSource is a bit stream, not a byte stream: PLRM 4.9.3
%  lets a coordinate be 1, 2, 4, 8, 12, 16, 24 or 32 bits and a colour
%  component 1, 2, 4, 8, 12 or 16, and the fields of one vertex are
%  packed against each other with no gaps. Only the END of a vertex is
%  padded to a byte, and for a patch only the end of the patch.
%
%  So the position is held in BITS. Two readers would drift, so there is
%  one, and the byte-at-a-time reading every stream written today needs
%  is a path through it rather than a second one: a field that begins on
%  a byte boundary and is a whole number of bytes is read a byte at a
%  time and everything else a bit at a time, which are the same number by
%  construction.
%  The field widths PLRM 4.9.3 allows, one set per entry. They are sets
%  rather than a range because the reader must be able to say which
%  widths it takes, and a program's data is unreadable if it guesses.
%
/.mrdcoordbits << 1 true 2 true 4 true 8 true 12 true 16 true 24 true 32 true >> def
/.mrdcompbits << 1 true 2 true 4 true 8 true 12 true 16 true >> def
/.mrdflagbits << 2 true 4 true 8 true >> def

%
%  Step over the padding at the end of a vertex or a patch: what follows
%  begins on a byte boundary whatever the fields before it came to.
%
/.mrdalign {  % -  .  -
    litds not { /bp bp 7 add 8 idiv 8 mul def } if
} def

%
%  Whether any of the source is still unread, counted in whichever unit
%  this source is read by.
%
/.mrdmore {  % -  .  bool
    litds { dp ds length lt }{ bp ds length 8 mul lt } ifelse
} def

%
%  Field k of Decode applied.
%
/.mrddec {  % k nbits  .  value
    dup //.mrdbits exec
    exch 2 exch exp 1 sub div
    /frv exch def /kk exch def
    dec kk 2 mul 1 add get dec kk 2 mul get sub frv mul
    dec kk 2 mul get add
} def

%
%  a mesh DataSource may instead be an array of the flag, coordinate and
%  colour values directly (PLRM 4.9.3): then BitsPer* and Decode are ignored
%  and each field is one array element. /litds selects which reading applies.
%
/.mrdflag {  % -  .  flag
    litds { ds dp get cvi /dp dp 1 add def }
          { bpf //.mrdbits exec cvi } ifelse
    % PLRM gives each mesh type the values its edge flag may take -- 0, 1
    % and 2 for a triangle, and 3 as well for a patch -- and flagmax is
    % the painter's own. A value outside them says which edge is shared
    % with a shape the data does not describe, so there is nothing to
    % paint and nothing to guess
    dup 0 lt 1 index flagmax gt or {
        /shfill cvx /rangecheck signalerror
    } if
} def
/.mrdpt {  % -  .  [x y]
    litds { [ ds dp get ds dp 1 add get ] /dp dp 2 add def }
          { [ 0 bpc //.mrddec exec 1 bpc //.mrddec exec ] } ifelse
} def
/.mrdcolor {  % -  .  [c0..cn-1]
    litds { [ ds dp ncomp getinterval aload pop ] /dp dp ncomp add def }
           { [ 0 1 ncomp 1 sub { /c exch def
                 c 2 add bpcm //.mrddec exec
             } for ] } ifelse
} def
/.mrdvertex {  % -  .  [x y c0..cn-1]
    [ //.mrdpt exec aload pop //.mrdcolor exec aload pop ]
    % a vertex occupies a whole number of bytes, and for a free-form
    % mesh the flag read just before it belongs to the same one
    //.mrdalign exec
} def

%
%  Set the reader up for a shading whose shape arrives as a DataSource.
%  What it defines -- the shading, its Function, the source and the
%  position in it, and for a packed source the Decode array, the field
%  widths and the component count -- is defined in the CALLER's
%  dictionary, because the caller is what reads them. So this opens none
%  of its own.
%
%  flagrequired says whether every type this painter takes carries a
%  per-vertex edge flag. A lattice mesh carries none, and its BitsPerFlag
%  may be absent; a patch mesh must state one. flagmax is the largest
%  value that flag may take for this painter's types.
%
/.mrdinit {  % sh flagrequired  .  -
    /flagmax exch def
    /flagreq exch def
    /sh exch def
    /shfn sh /Function 2 copy known { get }{ pop pop null } ifelse def
    /ds sh /DataSource get def
    /dp 0 def
    /bp 0 def
    /litds ds type /arraytype eq def
    litds {
        % an array DataSource: flag, coordinates and colours are literal
        % numbers, one parametric value per vertex under a Function or
        % one per colour-space component otherwise (BitsPer* and Decode
        % ignored, PLRM)
        /ncomp shfn null eq { //.ncomponents exec }{ 1 } ifelse def
    }{
        /dec sh /Decode get def
        /bpc sh /BitsPerCoordinate get def
        /bpcm sh /BitsPerComponent get def
        /bpf flagreq
            { sh /BitsPerFlag get }
            { sh /BitsPerFlag 2 copy known { get }{ pop pop 8 } ifelse }
            ifelse def
        /ncomp dec length 4 sub 2 idiv def
        % a width the specification does not give is one no producer can
        % have meant, and reading it would be reading somebody else's
        % field
        //.mrdcoordbits bpc known
        //.mrdcompbits bpcm known and
        flagreq { //.mrdflagbits bpf known and } if not {
            /shfill cvx /rangecheck signalerror
        } if
    } ifelse
} def

%
%  set a mesh colour: components directly, or -- when the shading
%  carries a Function -- a single parametric value through it. The
%  mesh painters bind /shfn before any triangle paints
%
/.gsetcolor {  % [c0..cn-1]  .  -
    shfn null eq {
        aload pop setcolor
    }{
        0 get shfn //.fneval exec pop setcolor
    } ifelse
} def

%
%  va vb vc depth  .gtri  -
%  paint a Gouraud triangle: subdivide at the edge midpoints until the
%  triangle sits within a couple of device pixels, then fill flat with
%  the corner average
%
/.gmid {  % va vb  .  vm
    2 dict begin
    /b exch def /a exch def
    [ 0 1 a length 1 sub { /i exch def
        a i get b i get add 2 div
    } for ]
    end
} def
%
%  va vb vc  .tridepth  depth
%  How finely to subdivide a Gouraud triangle, from the size the triangle
%  comes to on the device. Each level halves an edge, so a triangle L
%  device units across needs log2(L/k) levels to bring its flat fills
%  down to k across, and a triangle already smaller than k needs none.
%
%  k is half a device unit. The fills are flat, so what they approximate
%  is a colour that varies across every pixel, and a fill smaller than a
%  pixel is what lets each pixel take a colour of its own. MEASURED
%  against a mesh of small triangles carrying a full colour range: at one
%  unit the page is further from a per-pixel rendering than the constant
%  depth this replaced, and at half a unit it is the same page. At two
%  units it is worse and cheaper, at a quarter better and four times
%  dearer.
%
%  The cap is a cost bound and nothing else: 4^7 fills is the most one
%  triangle may ask for. MEASURED on a triangle covering a 384-unit page,
%  where the depth this asks for is exactly 7: the page stops changing
%  there -- 8 gives the same bytes -- because the flatness test below
%  takes over. Both painters ask this, so a patch's grid cells and a
%  mesh's triangles are subdivided by one rule.
%
/.tridepthcap 7 def
/.tridepth {  % va vb vc  .  depth
    8 dict begin
    /vc exch def /vb exch def /va exch def
    /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
    [ va vb vc ] {
        dup 0 get exch 1 get transform
        dup mxy gt { dup /mxy exch def } if dup mny lt { dup /mny exch def } if pop
        dup mxx gt { dup /mxx exch def } if dup mnx lt { dup /mnx exch def } if pop
    } forall
    /ext mxx mnx sub mxy mny sub 2 copy lt { exch } if pop def
    ext 0.5 div dup 1 le
        { pop 0 }
        { log 2 log div ceiling cvi } ifelse
    dup //.tridepthcap gt { pop //.tridepthcap } if
    end
} def

%
%  The page, in the user space a mesh states its triangles in: a box a
%  triangle lying wholly past one edge of marks no pixel within. Two
%  device units of margin absorb the inverse transform's rounding, and a
%  rotated CTM only widens the box, so it never excludes a point the page
%  holds. A device that states no size disables the test with a null.
%
/.gtriclip {  % -  .  [uminx uminy umaxx umaxy] or null
    8 dict begin
    graphicsdict /currgstate get /device get /d exch def
    d /width known d /height known and {
        /W d /width get def /H d /height get def
        /uminx 9e99 def /uminy 9e99 def /umaxx -9e99 def /umaxy -9e99 def
        [ [ -2 -2 ] [ W 2 add -2 ] [ W 2 add H 2 add ] [ -2 H 2 add ] ] {
            aload pop itransform /uy exch def /ux exch def
            ux uminx lt { /uminx ux def } if  ux umaxx gt { /umaxx ux def } if
            uy uminy lt { /uminy uy def } if  uy umaxy gt { /umaxy uy def } if
        } forall
        [ uminx uminy umaxx umaxy ]
    }{ null } ifelse
    end
} def
/.gtri {  % va vb vc dpt  .  -
    6 dict begin
    /dpt exch def /vc exch def /vb exch def /va exch def
    % A triangle lying wholly past one edge of the page marks nothing
    % there, so its subdivision is skipped. This holds a mesh's cost to
    % the page when a Decode or a stray coordinate throws a triangle's
    % far corner an enormous distance off it, where the colour never
    % comes flat over so wide a span and the depth cap alone would spend
    % its whole budget subdividing fills the device only discards.
    gclipbox dup null eq { pop false }{
        aload pop /gy1 exch def /gx1 exch def /gy0 exch def /gx0 exch def
        va 0 get gx0 lt vb 0 get gx0 lt and vc 0 get gx0 lt and
        va 0 get gx1 gt vb 0 get gx1 gt and vc 0 get gx1 gt and or
        va 1 get gy0 lt vb 1 get gy0 lt and vc 1 get gy0 lt and or
        va 1 get gy1 gt vb 1 get gy1 gt and vc 1 get gy1 gt and or
    } ifelse
    { end }{
    /dd 0 def
    2 1 va length 1 sub { /i exch def
        va i get vb i get sub abs dup dd gt { /dd exch def }{ pop } ifelse
        va i get vc i get sub abs dup dd gt { /dd exch def }{ pop } ifelse
    } for
    dpt 0 le dd 0.015 le or {
        % flat: fill with the corner average
        [ 2 1 va length 1 sub { /i exch def
            va i get vb i get add vc i get add 3 div
        } for ] //.gsetcolor exec
        newpath
        va 0 get va 1 get moveto
        vb 0 get vb 1 get lineto
        vc 0 get vc 1 get lineto
        closepath fill
    }{
        /mab va vb //.gmid exec def
        /mbc vb vc //.gmid exec def
        /mca vc va //.gmid exec def
        va mab mca dpt 1 sub //.xpostsys /.gtri get exec
        mab vb mbc dpt 1 sub //.xpostsys /.gtri get exec
        mca mbc vc dpt 1 sub //.xpostsys /.gtri get exec
        mab mbc mca dpt 1 sub //.xpostsys /.gtri get exec
    } ifelse
    end
    } ifelse
} def

%
%  free-form (type 4) and lattice-form (type 5) triangle meshes with
%  per-vertex colours
%
/.meshsh {  % shdict  .  -
    24 dict begin
    /gclipbox //.gtriclip exec def
    % a lattice (type 5) mesh carries no per-vertex flag, so BitsPerFlag
    % may be absent from one of the two types this paints
    false 2 //.mrdinit exec
    sh /ShadingType get 5 eq {
        /vpr sh /VerticesPerRow get def
        % PLRM 4.9.3: a lattice mesh has at least two vertices per row.
        % A row of fewer consumes no vertices from the source, so the read
        % position never advances and the row loop below never reaches its
        % source-exhausted exit -- a single shfill that spins for ever.
        vpr 2 lt { /shfill cvx /rangecheck signalerror } if
        /prev null def
        {
            //.mrdmore exec not { exit } if
            /row [ vpr { //.mrdvertex exec } repeat ] def
            prev null ne {
                0 1 vpr 2 sub { /i exch def
                    prev i get prev i 1 add get row i get
                    3 copy //.tridepth exec //.gtri exec
                    prev i 1 add get row i get row i 1 add get
                    3 copy //.tridepth exec //.gtri exec
                } for
            } if
            /prev row def
        } loop
    }{
        /va null def /vb null def /vc null def
        {
            //.mrdmore exec not { exit } if
            /flag //.mrdflag exec def
            flag 0 eq {
                //.mrdmore exec not { exit } if
                /va //.mrdvertex exec def
                //.mrdflag exec pop
                /vb //.mrdvertex exec def
                //.mrdflag exec pop
                /vc //.mrdvertex exec def
            }{
                flag 1 eq {
                    /va vb def /vb vc def
                }{
                    /vb vc def
                } ifelse
                /vc //.mrdvertex exec def
            } ifelse
            va vb vc 3 copy //.tridepth exec //.gtri exec
        } loop
    } ifelse
    end
} def

%
%  a cubic Bezier component at parameter t
%
/.bez1 {  % a0 a1 a2 a3 t  .  v
    5 dict begin
    /t exch def /a3 exch def /a2 exch def /a1 exch def /a0 exch def
    /u 1 t sub def
    a0 u u mul u mul mul
    a1 3 mul u u mul t mul mul add
    a2 3 mul u t t mul mul mul add
    a3 t t mul t mul mul add
    end
} def

%
%  the 4x4 control grid slot (row-major, rows pairing with u) for
%  each patch point p1..p16 in the data-stream order: the boundary
%  counterclockwise from the first corner, then the four interior
%  points
%
/.pgridmap [ 0 1 2 3 7 11 15 14 13 12 8 4 5 6 10 9 ] def

%
%  a weighted combination of grid points, divided by 9: the Coons
%  interior points are ninths of boundary sums
%
/.pmix {  % [w slot w slot ...]  .  [x y]
    4 dict begin
    /spec exch def
    /sx 0 def /sy 0 def
    0 2 spec length 2 sub { /i exch def
        /w spec i get def
        /p g spec i 1 add get get def
        /sx sx p 0 get w mul add def
        /sy sy p 1 get w mul add def
    } for
    [ sx 9 div sy 9 div ]
    end
} def

%
%  paint the current 4x4 grid g with corner colours cols: collapse
%  the grid's columns at each u by .bez1, sweep the resulting curve
%  in v, and hand the cells to the Gouraud triangles with corner
%  colours blended bilinearly
%
/.patchpaint {  % -  .  -
    10 dict begin
    /gclipbox //.gtriclip exec def
    % subdivision from the device size of the boundary points
    /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
    0 1 11 { //.pgridmap exch get g exch get aload pop transform
        dup mxy gt { dup /mxy exch def } if dup mny lt { dup /mny exch def } if pop
        dup mxx gt { dup /mxx exch def } if dup mnx lt { dup /mnx exch def } if pop
    } for
    /n mxx mnx sub mxy mny sub 2 copy lt { exch } if pop
       6 div ceiling cvi
       3 2 copy lt { exch } if pop
       12 2 copy gt { exch } if pop def
    /verts [ 0 1 n { /iu exch def
        /u iu n div def
        /q [ 0 1 3 { /j exch def
            [ g j get 0 get g j 4 add get 0 get
              g j 8 add get 0 get g j 12 add get 0 get u //.bez1 exec
              g j get 1 get g j 4 add get 1 get
              g j 8 add get 1 get g j 12 add get 1 get u //.bez1 exec ]
        } for ] def
        [ 0 1 n { /iv exch def
            /v iv n div def
            [
            q 0 get 0 get q 1 get 0 get q 2 get 0 get q 3 get 0 get v //.bez1 exec
            q 0 get 1 get q 1 get 1 get q 2 get 1 get q 3 get 1 get v //.bez1 exec
            0 1 ncomp 1 sub { /c exch def
                cols 0 get c get 1 u sub mul 1 v sub mul
                cols 1 get c get 1 u sub mul v mul add
                cols 2 get c get u mul v mul add
                cols 3 get c get u mul 1 v sub mul add
            } for
            ]
        } for ]
    } for ] def
    0 1 n 1 sub { /iu exch def
        0 1 n 1 sub { /iv exch def
            verts iu get iv get
            verts iu 1 add get iv get
            verts iu get iv 1 add get
            3 copy //.tridepth exec //.gtri exec
            verts iu 1 add get iv get
            verts iu 1 add get iv 1 add get
            verts iu get iv 1 add get
            3 copy //.tridepth exec //.gtri exec
        } for
    } for
    end
} def

%
%  Coons (type 6) and tensor-product (type 7) patch meshes. A Coons
%  patch completes to a tensor patch by the standard interior points,
%  so one surface serves both
%
/.patchsh {  % shdict  .  -
    30 dict begin
    % both patch types carry a flag on every patch, so BitsPerFlag is
    % required of them
    true 3 //.mrdinit exec
    /tensor sh /ShadingType get 7 eq def
    % pts: p1..p16 as [x y] in data order; cols: c1..c4; g: the grid
    /pts 16 array def
    /cols 4 array def
    /g 16 array def
    /np tensor { 15 }{ 11 } ifelse def
    {
        //.mrdmore exec not { exit } if
        /flag //.mrdflag exec def
        //.mrdmore exec not { exit } if
        flag 0 eq {
            0 1 np { pts exch //.mrdpt exec put } for
            0 1 3 { cols exch //.mrdcolor exec put } for
        }{
            % the shared edge is the previous patch's: its four
            % points become p1..p4 and its two colours c1..c2
            /oldp [ [ 3 4 5 6 ] [ 6 7 8 9 ] [ 9 10 11 0 ] ] flag 1 sub get
                   [ exch { pts exch get } forall ] def
            /oldc [ [ 1 2 ] [ 2 3 ] [ 3 0 ] ] flag 1 sub get
                   [ exch { cols exch get } forall ] def
            4 1 np { pts exch //.mrdpt exec put } for
            2 1 3 { cols exch //.mrdcolor exec put } for
            0 1 3 { /k exch def pts k oldp k get put } for
            0 1 1 { /k exch def cols k oldc k get put } for
        } ifelse
        % a patch, flag and all, occupies a whole number of bytes
        //.mrdalign exec
        0 1 np { /k exch def g //.pgridmap k get pts k get put } for
        tensor not {
            % the Coons interior points, as ninths of boundary sums
            g 5 [ -4 0 6 1 6 4 -2 3 -2 12 3 13 3 7 -1 15 ] //.pmix exec put
            g 6 [ -4 3 6 2 6 7 -2 0 -2 15 3 4 3 14 -1 12 ] //.pmix exec put
            g 9 [ -4 12 6 13 6 8 -2 15 -2 0 3 1 3 11 -1 3 ] //.pmix exec put
            g 10 [ -4 15 6 14 6 11 -2 12 -2 3 3 2 3 8 -1 0 ] //.pmix exec put
        } if
        //.patchpaint exec
    } loop
    end
} def
end

%
%    shdict  shfill  -
%  paint the shading over the current clip region; the current path
%  survives untouched
%
.xpostsys begin
%
%  Which procedure paints each shading type (PLRM 4.9.3). Written as a
%  table rather than a chain of tests: the chain asked five questions of
%  one number and each arm had to leave the stack as the next one found
%  it, which two of them did not.
%
/.shadepainters <<
    1 //.fnsh      2 //.axialsh   3 //.radialsh
    4 //.meshsh    5 //.meshsh
    6 //.patchsh   7 //.patchsh
>> def

systemdict /shfill [ /dicttype ] {  % dict  .  -
    % The type is settled before the gsave, because an error unwinds the
    % operand, dictionary and execution stacks and not the graphics
    % stack. Raising after the gsave would leave it unmatched, and a
    % program that caught the rangecheck would go on painting in whatever
    % colour and clip the shading was given.
    dup /ShadingType get
    //.shadepainters 1 index known not
        { pop pop /shfill cvx /rangecheck signalerror } if
    //.shadepainters exch get exch          % Proc shdict

    gsave
    dup /ColorSpace get setcolorspace
    dup /BBox 2 copy known {
        get
        newpath
        dup 0 get 1 index 1 get moveto
        dup 2 get 1 index 1 get lineto
        dup 2 get 1 index 3 get lineto
        dup 0 get 1 index 3 get lineto
        pop closepath clip newpath
    }{ pop pop } ifelse
    exch exec
    grestore
} //.xpostsys /.defopin get exec
end

//.internaldict /QUIET known { }{ (eof shade.ps\n)print } ifelse
