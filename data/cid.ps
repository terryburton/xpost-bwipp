%!PS
%
% cid.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% CID-keyed composite fonts (PLRM 5.11): CIDInit, composefont, and the Type 0 composite show.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  The CIDInit procedure set builds CMap dictionaries, composefont
%  assembles a Type 0 font from a CMap and its descendant CIDFonts, and
%  the composite show machinery decodes character codes through the CMap
%  to CIDs, maps them to glyph indices through the descendant's CIDMap,
%  and paints the glyphs by index. A CIDFontType 2 descendant carries a
%  TrueType template in /sfnts with its outlines delivered incrementally
%  in /GlyphDirectory; the face is assembled (and reassembled as the
%  directory grows) by .cidface.
%
//.internaldict /QUIET known { }{ (loading cid.ps...)print } ifelse

%
%  Everything here defines into global VM.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The resource categories the composite font machinery keeps its
%  instances in. Stated here because this is the code that needs them,
%  through the one operation that brings a category into existence; each
%  is already there, made with the rest of the standard categories when
%  resource.ps loaded, and .defcategory leaves an existing one alone.
%
[ /CIDFont /CMap /ProcSet ] { //.defcategory exec } forall

%
%  The CIDInit procedure set: a program begins a dictionary, invokes
%  these operators to accumulate the code spaces and ranges into it,
%  and defines the result as a /CMap resource instance. The bracketed
%  operand lists arrive on the stack; each end operator gathers them
%  into (or appends to) an array in the dictionary under construction.
%
/CIDInit <<
    % The glyph data block that ends a CIDFont resource file: read it,
    % attach it to the dictionary under construction as /GlyphData,
    % close the dictionary and the procedure set, and define the
    % completed CIDFont resource.
    /StartData {  % (Binary)|(Hex) length  .  -
        currentdict /.sdn 3 -1 roll put
        (Hex) eq {
            currentdict /.sdf currentfile /ASCIIHexDecode filter put
            currentdict /.sdhex true put
        }{
            currentdict /.sdf currentfile put
            currentdict /.sdhex false put
        } ifelse
        .sdn 65000 le {
            currentdict /GlyphData .sdf .sdn string readstring pop put
        }{
            currentdict /GlyphData [
                {
                    .sdn 0 le { exit } if
                    .sdf .sdn 65000 min string readstring pop
                    currentdict /.sdn .sdn 65000 sub put
                } loop
            ] put
        } ifelse

        % The in-band terminator of a hex block belongs to it
        .sdhex { .sdf flushfile } if
        currentdict /.sdn undef
        currentdict /.sdf undef
        currentdict /.sdhex undef
        currentdict /CIDFontName get currentdict
        end end
        /CIDFont defineresource pop
    }

    % A CMap's code spaces, ranges and single-code assignments arrive in
    % blocks, and each block joins the ones before it. Rebuilding one array
    % from all of them per block re-copied every entry gathered so far each
    % time, so a CMap of N blocks cost 1+2+...+N -- the square of the count
    % -- in time and in discarded arrays. Keep each block apart instead, in
    % a list that grows a slot at a time, and join the blocks once when the
    % CMap is closed. A CMap a large font carries in hundreds of blocks, or
    % a program builds in thousands, then costs the number of entries rather
    % than its square.
    /.cmapaddblock {  % block /blkkey  .  -
        currentdict exch 2 copy known not { 2 copy 8 dict put } if
        get dup length 3 -1 roll put
    }
    /.cmapflatten {  % /blkkey /flatkey  .  -
        currentdict 3 1 roll
        6 dict begin
        /fk exch def /bk exch def /cd exch def
        cd bk known {
            cd bk get /bd exch def
            /tot 0 def
            0 1 bd length 1 sub { bd exch get length tot add /tot exch store } for
            tot array /fa exch def
            /at 0 def
            0 1 bd length 1 sub {
                bd exch get /blk exch def
                fa at blk putinterval
                /at at blk length add store
            } for
            cd fk fa put
            cd bk undef
        } if
        end
    }
    /begincmap {}  % -  .  -
    /endcmap {  % -  .  -
        /.codespaceblk /.codespaces .cmapflatten
        /.cidrangeblk /.cidranges .cmapflatten
        /.cidcharblk /.cidchars .cmapflatten
    }
    /begincodespacerange { pop mark }  % int  .  mark
    /endcodespacerange {  % mark lo hi ...  .  -
        counttomark array astore exch pop
        /.codespaceblk .cmapaddblock
    }
    /begincidrange { pop mark }  % int  .  mark
    /endcidrange {  % mark lo hi cid ...  .  -
        counttomark array astore exch pop
        /.cidrangeblk .cmapaddblock
    }
    /beginnotdefrange { pop mark }  % int  .  mark
    /endnotdefrange {  % mark lo hi cid ...  .  -
        counttomark array astore exch pop
        /.notdefranges exch def
    }

    %  The same mapping written one code at a time rather than as ranges
    %  (PLRM 8.2, p.539 and p.579; PLRM 5.11.4). A notdef mapping is what
    %  a CMap offers when a code selects a CID the descendant has no glyph
    %  for; it is recorded here as the range form beside it is.
    /beginnotdefchar { pop mark }  % int  .  mark
    /endnotdefchar {  % mark code cid ...  .  -
        counttomark array astore exch pop
        /.notdefchars exch def
    }
    /begincidchar { pop mark }  % int  .  mark
    /endcidchar {  % mark code cid ...  .  -
        counttomark array astore exch pop
        /.cidcharblk .cmapaddblock
    }

    % Single-descendant jobs select font 0; the association of later
    % ranges with other descendants is not kept.
    /usefont { pop }  % int  .  -

    %  A transformation to use with one descendant (PLRM 8.2, p.539 and
    %  p.580; PLRM 5.11.4). The font number goes the way usefont's does --
    %  a single-descendant job has only font 0 to apply it to -- so the
    %  matrix is taken and not applied. Taking it is what keeps a CMap
    %  that carries one readable: left undefined, the matrix and the
    %  operator name would be executed as though they were a program.
    /beginusematrix { pop mark }  % fontnum  .  mark
    /endusematrix { cleartomark }  % mark matrix  .  -

    % Adopt the mapping of another CMap. Its code spaces, CID ranges
    % and single-CID assignments join those of the CMap under
    % construction where the naming appears, so a CMap that carries
    % only the codes it substitutes reaches the rest of its mapping
    % through the one it names. The other CMap is finished, so each of its
    % joined mappings enters as a single further block.
    /usecmap {  % name|cmap  .  -
        dup type /nametype eq { /CMap findresource } if
        /usecmap [ /dicttype ] //.checkargs exec
        currentdict exch
        3 dict begin
        /src exch def
        /dst exch def
        [ [ /.codespaces /.codespaceblk ]
          [ /.cidranges /.cidrangeblk ]
          [ /.cidchars /.cidcharblk ] ] {
            aload pop /bk exch def /fk exch def
            src fk known {
                dst begin src fk get bk .cmapaddblock end
            } if
        } forall
        end
    }

    % Base-font character mappings (ToUnicode tables) pass through
    % this procedure set too: accept and discard them.
    /beginbfchar { pop mark }  % int  .  mark
    /endbfchar { cleartomark }  % mark obj...  .  -
    /beginbfrange { pop mark }  % int  .  mark
    /endbfrange { cleartomark }  % mark obj...  .  -
    /beginrearrangedfont { pop pop mark }  % /name int  .  mark
    /endrearrangedfont { cleartomark }  % mark obj...  .  -
>> /ProcSet defineresource pop

%
%  The BitmapFontInit procedure set (PLRM Table 3.10 and Table A.1), which
%  is how a Type 4 CIDFont is filled.
%
%  A Type 4 CIDFont carries no glyph descriptions at all (PLRM 5.11, "Type
%  4 CIDFonts"): its glyphs arrive one at a time from addglyph, already
%  rendered as device pixel arrays, and are painted as stencil masks. PLRM
%  says the result is essentially what a Type 3 font's BuildGlyph produces
%  by calling imagemask, and that is the route they take here -- so the
%  cache the painting machinery already keeps for repeated stencils serves
%  them without being told they are glyphs.
%
%  WHERE THE BITMAPS ARE KEPT, and what that costs. PLRM has them go
%  straight into the font cache rather than into virtual memory, and gives
%  the reason: a Type 4 font is meant to cost only its dictionary, where
%  the equivalent Type 3 font pays for every bitmap twice, once in VM and
%  again in the cache. These are kept in virtual memory, in a table beside
%  the font rather than in it -- defineresource leaves a registered font
%  read-only, so there is nowhere in the font to put them, which is the
%  same reason PLRM gives for not putting them there. The saving PLRM
%  describes is therefore not had; the behaviour is: glyphs paint, the two
%  removers take them away again, and charpath over them marks nothing,
%  because there is no outline to take.
%
%  The table is keyed by the font dictionary itself, so two fonts of one
%  CIDFontName do not share glyphs, and lives in the local scratch
%  dictionary, so a job's glyphs go when the job does.
%
.xpostsys /.t4store {  % -  .  dict
    .gscratch /.t4glyphs 2 copy known
        { get }
        { 8 dict dup 4 1 roll put } ifelse
} put

%  The glyph table of one Type 4 CIDFont, made on first use.
%
%  Keyed by CIDFontName and not by the dictionary, because composefont
%  takes a working copy of every descendant: keyed by identity, glyphs
%  added before the font was composed would be invisible to the composite
%  and glyphs added after it invisible to the original. The name is what
%  both copies agree on, and is what defineresource registered the font
%  under in the first place. A font with no CIDFontName falls back to
%  itself, which is the best identity there is for one.
.xpostsys /.t4glyphs {  % cidfont  .  dict
    /CIDFontName 2 copy known { get }{ pop } ifelse
    //.xpostsys /.t4store get exec
    exch 2 copy known
        { get }
        { 2 copy 32 dict put get } ifelse
} put

%  A Type 4 CIDFont, or the error PLRM names for anything else.
.xpostsys /.t4font {  % any /op  .  cidfont
    exch dup type /dicttype ne
        { pop cvx /invalidfont signalerror } if
    dup /CIDFontType 2 copy known { get }{ pop pop -1 } ifelse 4 ne
        { pop cvx /invalidfont signalerror } if
    exch pop
} put

%
%  Paint one Type 4 glyph: the bitmap addglyph left for this CID, as a
%  stencil mask at the current point, and the current point moved on by
%  the width the metrics declare.
%
%  The bitmap is a device pixel array (PLRM 5.11), so it is painted under
%  a transform of its own rather than under the font's: the current point
%  goes to device space, the mask is laid there one bit to one pixel with
%  its corner at (llx, lly), and the width is carried back through the
%  font matrix so the advance is in the text space the caller is writing
%  in. A glyph the font has not been given marks nothing and advances
%  nothing.
%
.xpostsys /.t4show {  % cidfont cid  .  -
    8 dict begin
    /cid exch def
    /f exch def
    /g f //.xpostsys /.t4glyphs get exec def
    g cid known {
        /e g cid get def
        /mx e 0 get def
        /bm e 1 get def
        /llx mx 2 get def /lly mx 3 get def
        /w mx 4 get llx sub cvi def
        /h mx 5 get lly sub cvi def
        w 0 gt h 0 gt and
        .gscratch /.t4nopaint known not and {
            gsave
                currentpoint translate
                f /FontMatrix 2 copy known { get }{ pop pop matrix } ifelse
                concat
                llx lly translate
                % one sample to one unit of glyph space, which is one
                % device pixel under the transform the font was drawn for
                % (PLRM 5.11)
                w h true [ 1 0 0 -1 0 h ] bm imagemask
            grestore
        } if
        % the advance is the metrics', carried into text space
        currentpoint
        mx 0 get mx 1 get
        f /FontMatrix 2 copy known { get }{ pop pop matrix } ifelse
        dtransform
        3 -1 roll add 3 1 roll add exch moveto
    } if
    end
} put

%
%  The FontSetInit procedure set (PLRM Table 3.10), whose one documented
%  operator is StartData (PLRM 8.2; PLRM 5.8, "FontSet Resources", p.345).
%  PLRM says outright that StartData is the only entry of this set that is
%  part of the language and that the rest are private, so this set holds
%  the one and no invented neighbours.
%
%  A FontSet resource file is minimal PostScript wrapped around binary
%  font data: the program says how many bytes follow and StartData reads
%  them, builds the FontSet and registers it under the given name.
%
%  WHAT THIS DOES AND DOES NOT DO -- a stated deviation. It reads the
%  bytes and defines nothing. This build cannot assemble a font set out of
%  them: the data is a compact font format container, and nothing here
%  reads one.
%
%  The reading is the whole of what it can usefully do. The data sits in
%  the program's own file, so a StartData that did not consume it would
%  leave the interpreter reading font bytes as PostScript and lose
%  everything after the block, not just the font. Having consumed them the
%  file goes on being a program.
%
%  It does NOT raise. Raising would be the louder answer and a worse one:
%  the error abandons the rest of the job, which is exactly what consuming
%  the bytes was for, so the two together cancel out. A program that asks
%  for a font from the set is told at the asking -- findresource answers
%  undefinedresource for a FontSet that was never defined, and findfont
%  the same for a font that was to have come from one -- which is where a
%  program can do something about it.
%
/FontSetInit <<
    %  key nbytes StartData  .  -
    %  key nbytes mastername StartData  .  -   (Chameleon descriptors)
    /StartData {
        4 dict begin
        % The three-operand form names the master font, and a name is the
        % only thing that operand is (PLRM 8.2), so a name is what tells
        % the two forms apart. Anything else on top stands where the byte
        % count stands and is held to being one.
        dup type /nametype eq { pop } if
        /n exch def
        /key exch def
        n type /integertype ne
            { /StartData cvx /typecheck signalerror } if
        n 0 lt
            { /StartData cvx /rangecheck signalerror } if

        % Take the declared bytes out of the program's own file, so what
        % follows them is read as the PostScript it is.
        currentfile n 0 gt { n string readstring pop pop }{ pop } ifelse
        key pop
        end
    }
>> /ProcSet defineresource pop

/BitmapFontInit <<
    %  metrics bitmap cid cidfont addglyph  .  -
    %
    %  The metrics are setcachedevice's six numbers or setcachedevice2's
    %  ten (PLRM 8.2). The bitmap is one bit per pixel, rows starting on a
    %  byte boundary, painted with its (0,0) corner at (llx, lly).
    /addglyph {
        6 dict begin
        /f exch /addglyph //.xpostsys /.t4font get exec def
        /cid exch def
        /bm exch def
        /mx exch def
        cid type /integertype ne { /addglyph cvx /typecheck signalerror } if
        bm type /stringtype ne { /addglyph cvx /typecheck signalerror } if
        mx type dup /arraytype ne exch /packedarraytype ne and
            { /addglyph cvx /typecheck signalerror } if
        mx length dup 6 ne exch 10 ne and
            { /addglyph cvx /rangecheck signalerror } if
        mx { type dup /integertype ne exch /realtype ne and
             { /addglyph cvx /typecheck signalerror } if } forall

        % A CID outside what the font declares names no glyph.
        cid 0 lt
        f /CIDCount 2 copy known { get }{ pop pop 0 } ifelse
            dup 0 gt { cid le }{ pop false } ifelse
        or { /addglyph cvx /rangecheck signalerror } if

        % The box the metrics give, and the bitmap that has to fill it.
        /llx mx 2 get def /lly mx 3 get def
        /urx mx 4 get def /ury mx 5 get def
        urx llx lt ury lly lt or
            { /addglyph cvx /rangecheck signalerror } if
        /w urx llx sub cvi def
        /h ury lly sub cvi def
        bm length w 7 add 8 idiv h mul lt
            { /addglyph cvx /rangecheck signalerror } if

        % Replaces the bitmap already there for that character, if any.
        f //.xpostsys /.t4glyphs get exec
        cid [ mx bm ] put
        end
    }

    %  cidfont removeall  .  -
    /removeall {
        2 dict begin
        % the table first, then the name to bind it to: a literal name
        % pushed ahead of the operands would be read as one of them
        /removeall //.xpostsys /.t4font get exec
        //.xpostsys /.t4glyphs get exec /g exch def
        % the keys are read out before any is removed: a dictionary being
        % walked is not a dictionary to delete from
        [ g { pop } forall ] { g exch undef } forall
        end
    }

    %  firstcid lastcid cidfont removeglyphs  .  -
    %
    %  No error arises from a reference to a glyph that is not there
    %  (PLRM 8.2); only the range itself is held to.
    /removeglyphs {
        4 dict begin
        /removeglyphs //.xpostsys /.t4font get exec
        //.xpostsys /.t4glyphs get exec /g exch def
        /last exch def
        /first exch def
        first type /integertype ne last type /integertype ne or
            { /removeglyphs cvx /typecheck signalerror } if
        last first lt first 0 lt or
            { /removeglyphs cvx /rangecheck signalerror } if
        first 1 last { g exch undef } for
        end
    }
>> /ProcSet defineresource pop

%
%  The composite show machinery lives in the private global namespace,
%  reached across files by a frozen //.xpostsys reference, so a program
%  cannot see or disturb it. composefont and cshow below are public.
%
.xpostsys begin

%
%  Decode one character code: the code space whose byte width brackets
%  the bytes at pos names the width, the cid ranges (and single-cid
%  assignments) supply the CID; an unmapped code is CID 0.
%
/.cmapnext {  % str pos cmapdict  .  cid nbytes
    20 dict begin
    /cm exch def /p exch def /s exch def
    /cs cm /.codespaces 2 copy known { get }{ pop pop [ <00> <FF> ] } ifelse def
    /w 1 def
    /code s p get def
    /matched false def
    0 2 cs length 2 sub { /k exch def
        matched not {
            /lo cs k get def
            /hi cs k 1 add get def
            /wl lo length def
            p wl add s length le {
                /c 0 def /clo 0 def /chi 0 def
                0 1 wl 1 sub { /b exch def
                    /c c 256 mul s p b add get add def
                    /clo clo 256 mul lo b get add def
                    /chi chi 256 mul hi b get add def
                } for
                c clo ge c chi le and {
                    /matched true def /w wl def /code c def
                } if
            } if
        } if
    } for
    /cid 0 def
    /rgs cm /.cidranges 2 copy known { get }{ pop pop [] } ifelse def
    0 3 rgs length 3 sub { /k exch def
        rgs k get length w eq {
            /rlo 0 def /rhi 0 def
            0 1 w 1 sub { /b exch def
                /rlo rlo 256 mul rgs k get b get add def
                /rhi rhi 256 mul rgs k 1 add get b get add def
            } for
            code rlo ge code rhi le and {
                /cid rgs k 2 add get code rlo sub add def
                exit
            } if
        } if
    } for
    /rgs cm /.cidchars 2 copy known { get }{ pop pop [] } ifelse def
    0 2 rgs length 2 sub { /k exch def
        rgs k get length w eq {
            /rlo 0 def
            0 1 w 1 sub { /b exch def
                /rlo rlo 256 mul rgs k get b get add def
            } for
            code rlo eq { /cid rgs k 1 add get def exit } if
        } if
    } for
    cid w
    end
} def

%
%  Assemble (or reassemble) the descendant's face around the glyphs
%  delivered so far: the directory flattens into a glyph-indexed
%  array for the synthesizer, and the count is remembered so a grown
%  directory triggers a rebuild.
%
/.cidface {  % ciddict  .  -
    4 dict begin
    /d exch def
    /gd d /GlyphDirectory 2 copy known { get }{ pop pop 0 dict } ifelse def
    gd length 0 eq {
        % No incremental glyphs: the template is the whole program
        d .loadfont42
    }{
        /mx 0 def
        gd { pop dup mx gt { /mx exch def }{ pop } ifelse } forall

        % The assembled face holds a glyph per directory key up to the
        % largest, so its arrays are sized by that key, not by how many
        % glyphs the directory carries. A glyph is named to a face by a
        % sixteen-bit index, so a key past 65535 names no glyph the face
        % could hold; refuse the font rather than size its arrays to a
        % number a program chose, which on the wide build is memory with
        % no upper bound.
        mx 65535 gt { /show cvx /invalidfont signalerror } if
        /ga mx 1 add array def
        gd { ga 3 1 roll put } forall
        d ga .loadcidfont2
    } ifelse
    d /.gdcount gd length put
    end
} def

%
%  Decode one character of a byte-mapped composite font: the font
%  selector, the code for the selected font, and the bytes consumed.
%  8/8 splits two bytes, 1/7 and 9/7 split the top bit or nine of a
%  one- or two-byte code, and the SubsVector mapping walks its ranges
%  -- the leading byte gives the code width less one, each following
%  width-sized big-endian entry one range -- subtracting until the
%  code falls within one. The modal mappings thread their selection:
%  fidx0 is the selector in force, escape sequences (doubled under a
%  double-escape mapping to reach past 255) and shift bytes replace
%  it and belong to the code that follows, and a string ending inside
%  a prefix answers a code of -1, which paints nothing. Bytes past
%  the string's end read as zero.
%
/.fmapnext {  % str p fnt fidx0  .  fidx code w
    12 dict begin
    /fidx exch def /fnt exch def /p exch def /str exch def
    /p0 p def

    % Zero past the end.
    /nb {  % i  .  byte
        dup str length lt { str exch get }{ pop 0 } ifelse
    } def
    /fm fnt /FMapType get def
    /code -1 def
    fm 2 eq {
        /fidx p nb def
        /code p 1 add nb def
        /p p 2 add def
    }{ fm 4 eq {
        /fidx p nb -7 bitshift def
        /code p nb 127 and def
        /p p 1 add def
    }{ fm 5 eq {
        /fidx p nb 1 bitshift p 1 add nb -7 bitshift add def
        /code p 1 add nb 127 and def
        /p p 2 add def
    }{ fm 6 eq {
        /sv fnt /SubsVector get def
        /wd sv 0 get 1 add def
        /nr sv length 1 sub wd idiv def
        /t 0 def
        0 1 wd 1 sub { p add nb t 256 mul add /t exch def } for
        /fidx 0 def
        {
            fidx nr ge { exit } if
            /rs 0 def
            0 1 wd 1 sub { fidx wd mul add 1 add sv exch get
                          rs 256 mul add /rs exch def } for
            t rs lt { exit } if
            /t t rs sub def
            /fidx fidx 1 add def
        } loop
        /code t def
        /p p wd add def
    }{ fm 3 eq fm 7 eq or {
        /esc fnt /EscChar 2 copy known { get }{ pop pop 255 } ifelse def
        {
            p str length ge { exit } if
            p nb esc ne {
                /code p nb def
                /p p 1 add def
                exit
            } if
            /fidx p 1 add nb def
            /p p 2 add def
            fm 7 eq fidx esc eq and {
                /fidx p nb 256 add def
                /p p 1 add def
            } if
        } loop
    }{ fm 8 eq {
        /si fnt /ShiftIn 2 copy known { get }{ pop pop 15 } ifelse def
        /so fnt /ShiftOut 2 copy known { get }{ pop pop 14 } ifelse def
        {
            p str length ge { exit } if
            p nb si eq { /fidx 0 def /p p 1 add def }{
            p nb so eq { /fidx 1 def /p p 1 add def }{
                /code p nb def
                /p p 1 add def
                exit
            } ifelse } ifelse
        } loop
    }{
        /show cvx /rangecheck signalerror
    } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse
    fidx code p p0 sub
    end
} def

%
%  The descendant the font selector names through Encoding, with its
%  matrix carried through the composite's.
%
/.fmapdesc {  % fnt fidx  .  font'
    3 dict begin
    /fidx exch def /fnt exch def
    /desc fnt /FDepVector get fnt /Encoding get fidx get get def
    desc dup length dict copy
    dup /FontMatrix desc /FontMatrix get
        fnt /FontMatrix get matrix concatmatrix put
    end
} def

%
%  Paint a string through a byte-mapped composite font: each decoded
%  code paints as a one-byte show under the selected descendant, so
%  any descendant kind -- including a nested composite -- renders
%  through the ordinary dispatch
%  .showhook is the composite walkers' per-character callback, invoked after
%  each character paints with its full (multi-byte, big-endian) code. A spacing
%  show operator binds it in its own scratch dictionary to advance the pen;
%  otherwise each walker defaults it to a no-op in its own scope (below), so the
%  name never reaches userdict.
%
/.showfmap {  % fnt str  .  -
    12 dict begin
    /.showhook where { pop }{ /.showhook { pop } def } ifelse
    /str exch def /fnt exch def
    /dc fnt /Encoding get length array def
    /cs 1 string def
    /p 0 def
    /curf 0 def
    {
        p str length ge { exit } if
        str p fnt curf //.fmapnext exec
        /w exch def /code exch def /curf exch def
        code 0 ge {
            dc curf get null eq {
                dc curf fnt curf //.fmapdesc exec put
            } if
            cs 0 code put
            graphicsdict /currgstate get /currfont dc curf get put
            cs show
            graphicsdict /currgstate get /currfont fnt put
            /fc 0 def
            0 1 w 1 sub { str p 3 -1 roll add get fc 256 mul add /fc exch def } for
            fc .showhook
        } if
        /p p w add def
    } loop
    end
} def

%
%  Walk a string through a CMap-mapped composite font (the FMapType 9
%  of composefont), calling the procedure with each glyph's CID and its
%  index in the descendant's face. Each code decodes to a CID, the CID
%  maps to a glyph index through the descendant's CIDMap (GDBytes bytes
%  per entry, across the array of segments), and the descendant is the
%  font in force while the procedure runs, its face carried through the
%  composite's matrix.
%
%  Both selectors go to the procedure because both are needed and only
%  the walk holds both: the index is what names the glyph to the face,
%  and the CID is what names its metrics to the descendant's /Metrics
%  dictionary (PLRM 5.11.3), which is keyed by CID and not by glyph
%  name. Nothing after the walk can recover the CID from the index --
%  the CIDMap runs one way.
%
%  What becomes of the glyph is the procedure's and not the walk's,
%  because this is the only way to a CID-keyed glyph: a string names it
%  no other way, so taking its outline goes through here as painting it
%  does. The walk itself paints nothing.
%
/.cmapwalk {  % font str proc  .  -
    20 dict begin
    /.showhook where { pop }{ /.showhook { pop } def } ifelse
    /gproc exch def
    /str exch def
    /fnt exch def
    /cm fnt /CMap get def
    /desc fnt /FDepVector get 0 get def

    % The walk paints each glyph with the descendant current, and the
    % font a glyph was painted from is not the caller's to lose. What
    % goes back at the end is what was current on the way in, which is
    % not always the font walked: a show under cshow's measure walks the
    % composite that stands for the descendant while the descendant is
    % what is current, and glyphshow through a CIDFont walks a composite
    % that stands for the CIDFont in the same way.
    /prev graphicsdict /currgstate get /currfont get def

    % A CIDFontType 2 descendant renders through an assembled face,
    % rebuilt when its glyph directory has grown since.
    desc /CIDFontType 2 copy known { get 2 eq }{ pop pop false } ifelse {
        desc /GlyphDirectory 2 copy known { get length }{ pop pop 0 } ifelse
        desc /.gdcount 2 copy known { get }{ pop pop -1 } ifelse
        ne { desc //.cidface exec } if
    } if

    % A CIDFontType 0 descendant carries its charstrings in the
    % GlyphData block; the face assembles once and serves by CID.
    desc /CIDFontType 2 copy known { get 0 eq }{ pop pop false } ifelse
    desc /GlyphData known and
    desc /Private known not and {
        desc .loadcidfont0
    } if
    /wrap desc dup length 2 add dict copy def
    wrap /FontMatrix
        desc /FontMatrix 2 copy known { get }{ pop pop matrix } ifelse
        fnt /FontMatrix get matrix concatmatrix put
    /gdb desc /GDBytes 2 copy known { get }{ pop pop 1 } ifelse def
    /cidmap desc /CIDMap 2 copy known { get }{ pop pop null } ifelse def

    % What the descendant says its CIDs run to. A CIDFont declares the
    % number of them it has, and the valid ones are 0 to one less than
    % that; the rest "are treated as undefined glyphs" (PLRM 5.11.2,
    % 5.11.3). A descendant declaring no count is not held to one.
    /ccount desc /CIDCount 2 copy known { get }{ pop pop null } ifelse def
    graphicsdict /currgstate get /currfont wrap put
    /p 0 def
    {
        p str length ge { exit } if
        str p cm //.cmapnext exec
        /w exch def
        /cid exch def

        % A CID the descendant does not have is answered by the glyph for
        % CID 0, which a CIDFont is required to carry (PLRM 5.11.4,
        % "Handling Undefined Characters"). The substitution is made here,
        % before the CIDMap is read and before the face is asked, because
        % what a CID outside the declared range resolves to is whatever
        % the bytes past the end of the map happen to be.
        ccount type /integertype eq
            { cid 0 lt cid ccount ge or { /cid 0 def } if } if

        /gid cid def
        cidmap null ne {
            /off cid gdb mul def
            /gid 0 def
            cidmap type /stringtype eq {
                off gdb add cidmap length le {
                    0 1 gdb 1 sub { /b exch def
                        /gid gid 256 mul cidmap off b add get add def
                    } for
                } if
            }{
                /seg 0 def
                {
                    seg cidmap length ge { exit } if
                    off cidmap seg get length lt { exit } if
                    /off off cidmap seg get length sub def
                    /seg seg 1 add def
                } loop
                seg cidmap length lt {
                    off gdb add cidmap seg get length le {
                        0 1 gdb 1 sub { /b exch def
                            /gid gid 256 mul cidmap seg get off b add get add def
                        } for
                    } if
                } if
            } ifelse
        } if
        % A Type 4 descendant has no glyph descriptions to route: its
        % glyphs are the bitmaps addglyph left, painted as stencil masks
        % (PLRM 5.11). A CID with nothing loaded marks nothing, which is
        % what a font whose glyph has not been sent yet has to do.
        desc /CIDFontType 2 copy known { get 4 eq }{ pop pop false } ifelse {
            desc gid //.t4show exec
        }{
            cid gid gproc
        } ifelse
        /fc 0 def
        0 1 w 1 sub { str p 3 -1 roll add get fc 256 mul add /fc exch def } for
        fc .showhook
        /p p w add def
    } loop
    graphicsdict /currgstate get /currfont prev put
    end
} def

%
%  Paint a string through a composite font: a CMap-mapped one goes by
%  the walk above, each glyph painted by the route the graphics state
%  settles; the byte-mapped FMapTypes decode and dispatch per
%  descendant instead.
%
/.showtype0 {  % font str /opname  .  -
    % cshow's special measure (PLRM 8.2), if this is the composite that
    % stands for it: the string "must consist of a single byte equal to
    % the code given to proc, or a rangecheck error occurs", so it is
    % held to that byte before the walk reaches a code the measure never
    % meant. Every show variant comes through here, so the refusal
    % reports the operator the program called rather than a name they
    % would share.
    .gscratch /.cshmeas get
    dup null eq { pop false }{ 1 get 3 index eq } ifelse {
        .gscratch /.cshmeas get 2 get
        2 index ne { dup cvx /rangecheck signalerror } if
    } if
    2 index /FMapType get 9 ne {
        pop
        //.showfmap exec
    }{
        pop
        % the CID the walk hands over stays beneath the index it hands
        % over, so it reaches whichever operator the route settles on:
        % .glyphshowidx below, or the outline operator .showroute sends
        % a pattern colour and an outline font to instead
        { null { .glyphshowidx } //.showroute exec }
        //.cmapwalk exec
    } ifelse
} def

%
%  Paint the one glyph a CID names in a CIDFont that is itself the
%  current font. PLRM 8.2 says glyphshow then "proceeds as show would
%  for a CID-keyed font whose mapping algorithm yields this CIDFont
%  with cid as the character selector", so that is the route it takes:
%  a mapping that yields this CID and no other, over the single code
%  that reaches it, walked by the walk above. Assembling the
%  descendant's face, resolving the CID through the CIDMap, reading
%  the metrics the CID names and settling the route the colour and the
%  font ask for are then each done in the one place that does them for
%  a string, rather than a second time here.
%
%  The walk keeps the assembled face in the descendant dictionary, so a
%  CIDFont a program set straight from its resource -- read-only, as
%  defineresource leaves what it registers -- is walked through a
%  working copy, as composefont walks its descendants through the
%  copies it takes of them.
%
/.cidglyphshow {  % cidfont cid  .  -
    3 dict begin
    /cid exch def
    dup wcheck not { dup length 4 add dict copy } if
    /desc exch def
    <<
        /FontType 0
        /FMapType 9
        /FontMatrix matrix
        /Encoding [ 0 ]
        /WMode 0
        /FDepVector [ desc ]
        /CMap << /.codespaces [ <00> <FF> ]
                 /.cidranges [ <00> <00> cid ] >>
    >>
    <00>
    /glyphshow //.showtype0 exec
    end
} def

end

%
%  Assemble a Type 0 composite font: names resolve through their
%  resource categories, the CMap decodes the codes, the descendants
%  carry the glyphs.
%
%  PLRM 5.10 is the font this builds: a Type 0 whose CMap maps the codes
%  in a string onto a descendant font and a character within it (5.10.1),
%  and whose descendants may themselves be composite (5.10.3). The
%  operator is 8.2, which takes the CMap by name, by string or as a
%  dictionary -- the three forms the signature admits.
%
%  An operand that names its resource rather than being it is looked up
%  where PLRM 8.2 says to look: the CMap in the CMap category, and each
%  descendant in the CIDFont category and then, if it is not there, in
%  the Font category. A name and a string are the same key written two
%  ways, so both are looked up and only a dictionary is taken as it
%  stands.
%
%  A descendant neither category carries is asked of the CIDFont
%  category, so that the refusal names the category a descendant is
%  looked for in first. Asked of the Font category it would not be a
%  refusal at all: that category answers an unavailable font with a
%  substitute rather than with an error, and a composite silently built
%  over a substitute is a page of the wrong glyphs and nothing said.
%
/composefont [ /anytype /anytype /arraytype ] {  % key cmap fonts  .  font
    1 index type dup /nametype ne exch dup /stringtype ne exch /dicttype ne and and
        { /composefont cvx /typecheck signalerror } if

    % Each descendant becomes the composite font's own working copy. A
    % descendant arrives read-only, as defineresource and definefont both
    % leave what they register, and the show machinery assembles its face
    % into it on first use; the copy is where that face goes. The copy is
    % shallow, so the glyph directory stays the one object the program adds
    % to, and glyphs delivered after the font is composed still arrive.
    [ exch { dup type dup /nametype eq exch /stringtype eq or
             { dup /CIDFont resourcestatus
                   { pop pop /CIDFont }
                   { dup /Font resourcestatus
                         { pop pop /Font }{ /CIDFont } ifelse } ifelse
               findresource } if
             dup length 4 add dict copy } forall ]
    exch dup type dup /nametype eq exch /stringtype eq or
        { /CMap findresource } if
    exch
    8 dict begin
    /FDepVector exch def
    /CMap exch def
    /FontType 0 def
    /FMapType 9 def
    /FontMatrix matrix def
    % PLRM 8.2 gives the entry as an identity mapping the length of
    % FDepVector, consecutive integers from zero, so that the font number
    % the mapping algorithm yields indexes the descendant it names.
    /Encoding [ 0 1 FDepVector length 1 sub { } for ] def
    /WMode CMap /WMode 2 copy known { get }{ pop pop 0 } ifelse def
    currentdict end
    definefont
} .defop

%
%  The character's advance, which is the width cshow reports for it,
%  measured without marking. It is read off a show of the glyph rather
%  than added up, so the font the show goes through is the font that
%  answers for the width -- through a CID-keyed composite, the mapping
%  in force when the measurement is taken decides which glyph is
%  measured and whose metrics govern it.
%
%  Stack-pure, so a compiled program can run it with a caller's
%  leavings below its operands.
%
.xpostsys /.cshmeasure {  % font charstring  .  wx wy
    gsave
    nulldevice
    exch graphicsdict /currgstate get /currfont 3 -1 roll put
    0 0 moveto show currentpoint
    grestore
} put

%
%  Make a font the current one, without the rest of setfont's work: a
%  composite show has already resolved the descendant it wants.
%
.xpostsys /.cshsetfont {  % font  .  -
    graphicsdict /currgstate get /currfont 3 -1 roll put
} put

%
%  Park a measure in the slot font.ps keeps for it, remembering in the
%  measure itself what stood there before, so that the walk which parked
%  it can put that back however it ends.
%
%  A compiled walk reaches the slot through here rather than by embedding
%  the scratch dictionary in the program it builds: that dictionary is a
%  local object and the program may be built in global VM, where a local
%  object may not be stored (PLRM 3.7.2).
%
.xpostsys /.cshhold {  % meas  .  -
    dup 3 .gscratch /.cshmeas get put
    .gscratch exch /.cshmeas exch put
} put

%
%  cshow's walks compile into programs that run after the private dict
%  ends, so the procedure executes on the caller's stacks with no
%  machinery state live anywhere: no names for its defs to collide
%  with, its defs reaching the caller's dictionaries, its stack
%  leavings preserved -- every compiled operand is pushed just before
%  its consumer. The helper procedures embed at scan time as arrays,
%  which the programs push and exec as data.
%
%  cshow is a looping context (PLRM 8.2), so the procedure may end the
%  walk with exit, and exit unwinds the execution stack to the frame of
%  the operator that runs the procedure repeatedly. A flattened program
%  has no such frame of its own, so each walk runs as the body of a loop
%  that its own end leaves: an exit from the procedure reaches the same
%  frame and abandons the rest of the walk, and the private dict is
%  already ended by then, so there is nothing of cshow's own left for the
%  exit to strand.
%
%  Through a CID-keyed composite the operator makes the special measure
%  PLRM 8.2 describes, so that a procedure may show what the walk chose
%  even though a CIDFont is what the mapping selected and a string
%  reaches no glyph in one. What the procedure is given is "the
%  character code from string (or its last byte, if the code is more
%  than 1 byte long)", and a show of that one byte, with the font the
%  operator leaves current, paints "the one identified by the originally
%  selected CID". The byte is a byte and the CID is whatever the CMap
%  resolved, so a CID above 255 is shown, and measured, as the CID it is.
%
%  The two halves are made of different things. The font is the
%  descendant the mapping selected, which is what currentfont must answer
%  with, and it is the program's from the moment the procedure asks for
%  it. The measure is a mapping under which that one byte, and no other
%  code, stands for that CID -- and it is parked in the scratch slot
%  font.ps keeps for it, not written on the font, because a font is
%  something the program may keep, write, scale and define under a name
%  of its own long after this call is over. Only the operators that
%  resolve a string through the current font read the slot, and only
%  while the call runs; the slot goes back to what it held on the way in
%  however the walk ends, so a nested cshow gets its own measure and
%  gives this one back.
%
%  The string a show under the measure is given is held to the one byte
%  -- "or a rangecheck error occurs" -- which is done where the walk
%  starts rather than here, so that every show variant reports the
%  refusal under its own name.
%
/cshow [ /proctype /stringtype ] {  % proc string  .  -
    /cshow //.needfont exec
    graphicsdict /currgstate get /currfont get
    dup //.fontroute exec /composite eq {
    dup /FMapType get 9 ne {
        % a byte-mapped composite: the procedure runs with the
        % selected descendant current, as the mapping chose it.
        20 dict begin
        /fnt exch def /str exch def /proc exch def
        /exe /exec load def
        /ppexec //.pexec def
        /dc fnt /Encoding get length array def
        /p 0 def
        /curf 0 def
        [
        {
            p str length ge { exit } if
            str p fnt curf //.fmapnext exec
            /w exch def /code exch def /curf exch def
            code 0 ge {
                dc curf get null eq {
                    dc curf fnt curf //.fmapdesc exec put
                } if
                code
                dc curf get
                1 string dup 0 code put
                //.cshmeasure currentdict /exe get
                dc curf get //.cshsetfont currentdict /exe get
                currentdict /proc get currentdict /ppexec get currentdict /exe get
                currentdict /fnt get //.cshsetfont currentdict /exe get
            } if
            /p p w add def
        } loop
        ] cvx
        end
        { exec exit } loop
    }{
        20 dict begin
        /fnt exch def /str exch def /proc exch def
        /exe /exec load def
        /ppexec //.pexec def
        /cm fnt /CMap get def

        % The font the procedure runs under is the descendant the walk
        % selected, because PLRM 8.2 has currentfont answer with "the
        % current descendant base font or CIDFont" while it runs. It is a
        % copy, so that what a show of it does to a font -- assembling a
        % face on it, for one -- does not reach the descendant the
        % composite keeps. One copy serves the whole call: it says which
        % font the measure is for and nothing about which character.
        /bw fnt /FDepVector get 0 get dup length 4 add dict copy def

        % The descendant carries its own matrix and the composite carries
        % the size, because scalefont scales a composite's FontMatrix and
        % leaves its descendants alone: what a glyph is painted at is the
        % two concatenated. The copy is made current on its own, so it
        % takes the product rather than half of it.
        bw /FontMatrix
            bw /FontMatrix get fnt /FontMatrix get matrix concatmatrix put

        % The mapping the measure is: this composite over a CMap in which
        % one byte, and no other code, names one CID. The composite is
        % otherwise the one that was set, so the writing mode, the
        % matrix and the descendant the face is assembled on are the ones
        % a show of the same text goes through.
        %
        % A byte cannot name a CID above 255 and most CIDs in a real font
        % are above 255, so a mapping that sent each byte to the CID of
        % the same number would be one the CID could not be reached
        % through; what makes the byte enough is that it has only one CID
        % to stand for. Which byte and which CID is one character's
        % business, so the string and the range the mapping is made of
        % are rewritten per character, in the compiled program rather
        % than here; the operator that rewrites them is embedded the way
        % exec is.
        /cs 1 string def
        /rng [ cs cs 0 ] def
        /mfnt fnt dup length 1 add dict copy def
        mfnt /CMap << /.codespaces [ <00> <FF> ] /.cidranges rng >> put

        % What the slot holds while the procedure runs: the font it runs
        % under, the composite that stands for it, the code that
        % composite maps -- and, so the walk can put it back however it
        % ends, whatever the slot held on the way in.
        /meas [ bw mfnt cs null ] def
        /putin /put load def
        /p 0 def
        [
        currentdict /meas get //.cshhold currentdict /exe get
        {
            p str length ge { exit } if
            str p cm //.cmapnext exec
            /w exch def /cid exch def
            /code str p w add 1 sub get def
            currentdict /cs get 0 code currentdict /putin get
            currentdict /rng get 2 cid currentdict /putin get
            code
            currentdict /bw get
            1 string dup 0 code put
            //.cshmeasure currentdict /exe get
            currentdict /bw get //.cshsetfont currentdict /exe get
            currentdict /proc get currentdict /ppexec get currentdict /exe get
            currentdict /fnt get //.cshsetfont currentdict /exe get
            /p p w add def
        } loop
        ] cvx
        end

        % However the walk ends -- run out, left by an exit from the
        % procedure, or abandoned by an error in it -- the measure it
        % parked goes back to what stood there before it, and the error
        % is raised again for the caller's own handling.
        { { exec exit } loop } stopped
        .gscratch /.cshmeas 2 copy get 3 get put
        { stop } if
    } ifelse
    }{
        10 dict begin
        /fnt exch def /str exch def /proc exch def
        /exe /exec load def
        /ppexec //.pexec def
        [
        0 1 str length 1 sub { /p exch def
            str p get
            currentdict /fnt get
            str p 1 getinterval
            //.cshmeasure currentdict /exe get
            currentdict /proc get currentdict /ppexec get currentdict /exe get
        } for
        ] cvx
        end
        { exec exit } loop
    } ifelse
} .defop

end end end

%
%  The composite font mapping algorithms a show string is walked by, as
%  PLRM Table 3.8 has a program ask after them (see the note in
%  shade.ps). PLRM Table 5.9 names the algorithm each FMapType value
%  selects; these are the ones that decode here -- the byte mappings
%  through .fmapnext and the CMap mapping through .cmapwalk. A code
%  outside them selects no algorithm, and a string shown through a font
%  carrying one raises rangecheck rather than painting.
%
%  A list, and for the reason the function types are one: the algorithm
%  is settled by a chain of comparisons rather than by a lookup, so
%  there is no dispatch dictionary to read the set off. The list is held
%  to what a string actually decodes through by
%  tests/check-font-facts.sh, which offers a composite of every code and
%  compares what walks against what is declared here.
%
currentglobal true setglobal
[ 2 3 4 5 6 7 8 9 ] { dup /FMapType defineresource pop } forall
setglobal

%
%  The font dictionary types this interpreter has machinery for, as PLRM
%  Table 3.8 has a program ask after them. PLRM Table 5.1 gives the base
%  font types and PLRM Table 5.11 the FontType a CIDFont carries for each
%  CIDFontType; both are keys of the one category, because both are
%  values a FontType entry may take. A CIDFont is not a base font, and
%  the number stamped into it is still a font type a program is handed
%  and can ask after.
%
%  Declared here rather than beside the machinery that settles it,
%  because it is not one file's to settle: the base types are validated
%  by definefont and the CIDFont types come from the table a CIDFont is
%  stamped from, both in data/font.ps, and this file is the next the boot
%  reads, so it is the first point at which the whole set stands.
%
%  The CIDFont half is not written down at all -- it is read off
%  .cidtypemap, which is what decides the stamp, so a CIDFontType added
%  there is answered for from the moment it is stamped and there is
%  nothing else to say. The base half is a list, definefont settling the
%  type by a chain of comparisons rather than by a lookup, and
%  tests/check-font-facts.sh holds it to what definefont takes, to what
%  the text operators paint with, and to what the stamp issues.
%
currentglobal true setglobal
[ 0 1 2 3 42 ] { dup /FontType defineresource pop } forall
//.cidtypemap { exch pop dup /FontType defineresource pop } forall
setglobal

%
%  The two identity mappings, which every CID-keyed font that carries no
%  language-specific encoding is named with: a two-byte code is the CID of
%  the same value, horizontally in one and vertically in the other. A
%  program that names one of these is not supplying it -- it is asking for
%  the mapping every such font is built against -- so they are stated here
%  rather than left to be found.
%
%  Built through the procedure set a program would build them with, so what
%  is defined is what that route defines and there is no second way to make
%  a CMap that could drift from the first.
%
currentglobal true setglobal

/CIDInit /ProcSet findresource begin
12 dict begin
begincmap
/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> def
/CMapName /Identity-H def
/CMapType 1 def
/WMode 0 def
1 begincodespacerange <0000> <FFFF> endcodespacerange
1 begincidrange <0000> <FFFF> 0 endcidrange
endcmap
CMapName currentdict readonly end /CMap defineresource pop
end

/CIDInit /ProcSet findresource begin
12 dict begin
begincmap
/CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> def
/CMapName /Identity-V def
/CMapType 1 def
/WMode 1 def
1 begincodespacerange <0000> <FFFF> endcodespacerange
1 begincidrange <0000> <FFFF> 0 endcidrange
endcmap
CMapName currentdict readonly end /CMap defineresource pop
end

setglobal

//.internaldict /QUIET known { }{ (eof cid.ps\n)print } ifelse
