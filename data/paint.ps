%!PS
%
% paint.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The painting pipeline: colour folding, sampling, and the fill/stroke/image span machinery.
%
% The model these serve is PLRM 4.1: a program builds a page by placing
% paint on it in selected areas, each mark covering what was there. The
% general-purpose operators are stroke and fill (4.5).
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% Copyright (c) 2026 Terry Burton
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading paint.ps...)print } ifelse

%
%  Everything here defines into global VM, except the local routines
%  wrapped below.
%
true setglobal

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  The names these procedures bind their operands to. Literal
%  arrays: a list forall walks is data, and a list in braces is an
%  executable array a body may not read once the machinery is closed.
%
.xpostsys /.paintbind0 [ /interp /datasrc /mat /polarity /height /width ] readonly put
.xpostsys /.paintbind1 [ /operator /mranges /mh /mw /mbits /ncomp /decode /datasrc /mat /bits /height /width ] readonly put

%
%  A colour component folded into the unit range, the nearest valid value
%  standing in for one outside it as setgray and its siblings substitute
%  (PLRM 8.2). This is the fold every component crosses on its way to a
%  device, and the last chance to make one: a raster device scales the
%  component to a channel and an unclamped one wraps the byte, while a
%  vector writer prints it, and prints whatever it was handed.
%
.xpostsys /.cunit {  % v  .  v'
    dup 0 lt { pop 0 }{ dup 1 gt { pop 1 } if } ifelse
} put

%
%  Apply the transfer functions to the marked colour components: three
%  components pass through the red, green and blue transfers, four to
%  red, green, blue and grey in the CMYK order, anything else through
%  the grey transfer. The painting machinery refreshes the screening
%  cell here first, so a bilevel device screens against the current screen.
%
%  The components leave here for a device, and leave in range. A transfer
%  function is called with a number in [0,1] and must return one in the
%  same range (PLRM 7.3), but it is the program's own procedure and
%  returns whatever it computes; the same is true of a Separation or
%  DeviceN tint transform feeding the components in.
%
.xpostsys /.applytransfer {  % mark c1..cn  .  mark c1'..cn'
    //.refreshscreencell exec

    % One component is a case of the walk below and is written out
    % rather than walked, for the same reason three and four are: it is
    % what a device whose native space is a grey takes at every mark it
    % is given, and the walk over one component is the walk's whole
    % apparatus -- the count, the rotation that brings the next one up,
    % and the second pass over the same one component -- around a single
    % transfer and a single fold.
    counttomark 1 eq {
        /transfer //.marktransfer exec exec //.cunit exec
    }{
    counttomark 3 eq {
        /bluetransfer //.marktransfer exec exec
        3 1 roll
        /greentransfer //.marktransfer exec exec
        3 1 roll
        /redtransfer //.marktransfer exec exec
        3 1 roll
    }{
    counttomark 4 eq {
        /transfer //.marktransfer exec exec 4 1 roll
        /bluetransfer //.marktransfer exec exec 4 1 roll
        /greentransfer //.marktransfer exec exec 4 1 roll
        /redtransfer //.marktransfer exec exec 4 1 roll
    }{
        counttomark {
            /transfer //.marktransfer exec exec
            counttomark 1 roll
        } repeat
    } ifelse } ifelse
    counttomark { //.cunit exec counttomark 1 roll } repeat
    } ifelse
} put

%
%  Leave the current colour where a coverage painter reads it: the
%  components in the device's own space with the transfer functions
%  applied, gathered into an array.
%
%  It is the same colour a fill of the same graphics state hands the
%  device, and it is assembled here rather than there because a fill and
%  a coverage raster take it at different moments. A fill builds the
%  components on the operand stack immediately below the device call, so
%  the two cannot come apart. A raster of coverage is one colour over
%  many pixels and the colour has to be settled before the coverage is
%  walked, so the painter is given it through a slot instead, filled
%  immediately before the call that reads it.
%
.xpostsys /.setmarkedcolor {  % -  .  -
    graphicsdict /.markedcolor
    [ //.currentcolordict DEVICE /nativecolorspace get get exec
      //.applytransfer exec ]
    put
} put

%
%  Painting Operators
%

%
%  Paint current page white
%
%  PLRM 8.2, erasepage: the whole page is painted with gray level 1.0,
%  which is ordinarily white -- the page, not the area the clipping path
%  admits, and a gray level rather than the current colour.
%
/erasepage [ ] {  % -  .  -
    % The page is being cleared, so whatever had been painted on it is
    % no longer there to end a job with.
    false //.setpagemarked exec

    % A device with an Erase method resets the page itself (the alpha
    % device clears to transparent); otherwise paint the page white.
    DEVICE /Erase known {
        DEVICE dup /Erase get exec
        flushpage
    }{
    gsave
        1 setgray
        [ //.currentcolordict DEVICE /nativecolorspace get
        get exec
        //.applytransfer exec

        % The entire page is erased (PLRM 8.2). A device holding only
        % part of the page shows the ground over the rest of it, and the
        % colour the page is being cleared to is what that ground is.
        % The components are above the mark, so how many there are is
        % counted from it rather than assumed.
        DEVICE /Ground known {
            counttomark copy DEVICE dup /Ground get exec
        } if

        % a fill's extent operands name an inclusive pixel span, so the
        % rectangle covering a page of w columns is spanned by w-1 (the
        % driver contract, src/lib/xpost_dev_driver.h).
        0 0 DEVICE /dimensions get aload pop
        1 sub exch 1 sub exch
        DEVICE dup /FillRect get exec
        pop
        flushpage
    grestore
    } ifelse
} .defop

%
%  Whether the clip in force is the page itself.
%
%  A page-based format's consumer draws nothing outside the page: the
%  page box is a clip, and one the file states once at its head rather
%  than around every mark. So a clip that is the whole page has nothing
%  to hand over, and a drawing that runs off the page can still go over
%  whole.
%
%  This matters because the trivial-accept question below is asked of
%  the PATH and not of the clip: a path that leaves the page fails it,
%  and a page's own clip carries no shape to hand over instead, so such
%  a drawing was dissolved into spans and its curves went with them.
%  MEASURED, the same stroked curve either way: written as one curve
%  where it stayed on the page, and as three hundred and eighty-one line
%  segments where it did not.
%
.xpostsys /.clipispage {  % -  .  bool
8 dict {
    //.internaldict /.cliprect get exec {
        /cp.y1 exch def /cp.x1 exch def /cp.y0 exch def /cp.x0 exch def
        DEVICE /dimensions get aload pop
        /cp.h exch def /cp.w exch def
        cp.x0 0 le
        cp.y0 0 le and
        cp.x1 cp.w ge and
        cp.y1 cp.h ge and
    }{ false } ifelse
} //.indict exec } put

%
%  Whether the clip in force can be HANDED to the device to draw
%  beneath. A trivial clip has nothing to hand over and needs nothing;
%  any other region needs both a device that clips for itself and a
%  clip that is still a path to give it.
%
%  The page's own clip is not such a region: it carries no shape to
%  hand over. A drawing may still go over whole beneath it, there being
%  nothing there to clip against, and .devtakespath says so -- but a
%  decision that turns on the clip REACHING the device, rather than on
%  the drawing surviving whole, asks this instead.
%
.xpostsys /.devhandsclip {  % -  .  bool
    .cliptrivial
    { true }
    { DEVICE /ClipPath known
      graphicsdict /currgstate get /clipsource get null ne and }
    ifelse
} put

%
%  Whether the device may take the whole path. A trivial clip needs
%  nothing further; a clip that is still a path can be handed to a device
%  that clips for itself (ClipPath), which is far better than dissolving
%  the fill into per-scanline bands the device would emit one subpath per
%  row. Any other region has to be cut by the polygon machinery below.
%
.xpostsys /.devtakespath {  % -  .  bool
    DEVICE /FillPath known {
        //.devhandsclip exec //.clipispage exec or
    }{ false } ifelse
} put

%
%  Whether the device may take the whole stroke. The line a stroke is drawn
%  along is not a polygon, and cutting it to the clip the way a fill's
%  outline is cut does not give the clipped stroke: the stroke of a cut line
%  is not the cut stroke, and a line enclosing the clip window cuts down to
%  the window itself, which drawn puts the clip's own boundary on the page.
%
%  So the stroke goes over whole, under a clip the device is given to draw
%  it beneath. A device that cannot be given one takes the outline route
%  below instead, which resolves the stroke to a shape before clipping it
%  and is exact for any region.
%
.xpostsys /.devtakesstroke {  % -  .  bool
    DEVICE /StrokePath known {
        //.devhandsclip exec //.clipispage exec or
    }{ false } ifelse
} put

%
%  Give the device the clip shape when the fill is about to hand it a
%  whole path under a non-trivial clip; a trivial clip needs no call.
%  The record holds the shape and the rule together, and the device is
%  given both: an outline read by the wrong rule is a different region.
%
%  The region's identity goes over with them, for a device that can
%  write a shape down once and refer to it again: without it a page of
%  shapes under one clip carries that clip once per shape.
%
.xpostsys /.devsendclip {  % -  .  -
    .cliptrivial not
    graphicsdict /currgstate get /clipsource get null ne and {
        graphicsdict /currgstate get dup /clipsource get aload pop
        3 -1 roll /clipcache get /serial get
        DEVICE dup /ClipPath get exec
    } if
} put

%
%  poly  .  xlo ylo xhi yhi true
%            false
%
%  The device-space box a polygon's own vertices reach, or false when it
%  has none. This is where an answer about the polygon can lie, so it is
%  what the tiling walks cut their tiles out of: a tile stretched past it
%  would be halved over rows that could hold nothing.
%
.xpostsys /.polybounds {
    8 dict begin
    /any false def
    {
        dup null eq { pop }{
            aload pop /py exch def /px exch def
            any {
                px xlo lt { /xlo px def } if
                px xhi gt { /xhi px def } if
                py ylo lt { /ylo py def } if
                py yhi gt { /yhi py def } if
            }{
                /xlo px def /xhi px def /ylo py def /yhi py def
                /any true def
        } ifelse } ifelse
    } forall
    any { xlo ylo xhi yhi true }{ false } ifelse
    end
} put

%
%  The even-odd interior of the subject within the rows from y0 up to y1,
%  in the pixel-band rectangles .eospanpoly answers in: one array, or
%  several over shallower windows when what is left holds more bands than
%  one array's length field describes.
%
%  The cut is across the rows, halving the window until each piece
%  carries its own bands. A window one row deep cannot be cut again, so a
%  row holding more runs than an array carries hands its refusal up.
%
%  The windows meet along row boundaries and no two of them describe the
%  same row, which is what lets their spans be painted one after another:
%  a pixel two windows both described would be painted twice, and blended
%  twice as dark.
%
.xpostsys /.eospantile {  % subject y0 y1  .  spans ...
    8 dict begin
    /ty1 exch def /ty0 exch def /subj exch def
    count /n0 exch def
    { subj ty0 ty1 .eospanpoly } stopped {
        count n0 sub { pop } repeat
        ty1 ty0 sub 1 gt {
            /tm ty0 ty1 ty0 sub 2 idiv add def
            subj ty0 tm //.xpostsys /.eospantile get exec
            subj tm ty1 //.xpostsys /.eospantile get exec
        }{
            stop
        } ifelse
    } if
    end
} put

%
%  The even-odd interior of the subject, in the parts a painter marks one
%  after another. Normally the one array .eospanpoly answers with;
%  several, over disjoint bands of rows, when the interior holds more
%  bands than one array's length field describes.
%
%  The even-odd rule has no scan conversion of its own downstream: an
%  interior is stated as pixel-band rectangles here and the rectangles,
%  winding-uniform, travel the ordinary pipeline. So a comb or a stipple
%  has an interior too finely divided for any single array to describe
%  before any region is consulted -- fifty teeth over three hundred rows
%  are fifteen thousand bands and five elements apiece. That is a bound
%  on the description and not on the painting: the parts describe the
%  same pixels between them, so what is painted is what one array would
%  have given.
%
.xpostsys /.eospanparts {  % subjectpoly  .  [ spans ... ]
    16 dict begin
    /subj exch def
    count /n0 exch def
    /d0 countdictstack def

    % Only the rows the device holds carry a span; a subject reaching far
    % above or below the page -- a program sizes its bounding box -- has its
    % interior resolved over those rows and no others. Off-page bands
    % describe no pixel and paint nothing, so meeting the interior to the
    % page changes no mark while it bounds the work by the page's height
    % rather than the subject's, which the program could make vast.
    DEVICE /dimensions get 1 get /ph exch def
    {
        { [ subj 0 ph .eospanpoly ] } stopped {
            count n0 sub { pop } repeat
            subj //.polybounds exec {
                /yhi exch def pop /ylo exch def pop
                ylo 0 lt { /ylo 0 def } if
                yhi ph gt { /yhi ph def } if
                yhi ylo le {
                    [ ]
                }{
                    /sl //.xpostsys /.cliptilerows get def
                    /ylim yhi ceiling cvi 1 add def
                    [ ylo floor cvi sl yhi ceiling cvi {
                        /yb exch def
                        subj yb yb sl add dup ylim gt { pop ylim } if
                        //.eospantile exec
                    } for ]
                } ifelse
            }{
                % a subject with no vertices covers no pixel
                [ ]
            } ifelse
        } if
    } stopped {
        % a window that handed its refusal up leaves its own dictionaries
        % open behind it, and the caller is owed a clean stack under the
        % failure it is about to be given.
        countdictstack d0 sub { end } repeat
        count n0 sub { pop } repeat
        end
        stop
    } if
    end
} put

%
%  The region the current path encloses under the named rule, in the
%  parts a painter marks one after another. This is the one way the
%  current path becomes a subject: what fill and eofill paint, what clip
%  and eoclip keep, and what a pattern colour tiles across.
%
%  Normally one part, and the polygon .fillpolyargs reads the path into
%  -- the fill's own subject, and what the device scan-converts.
%
%  A path of more points than that polygon's array describes has no such
%  form. A LanguageLevel 2 path has no length of its own to exceed --
%  path storage competes with other uses of memory (PLRM 4.4) and a path
%  carries its extent in a header field of its own -- so the bound in the
%  way is the array's and not the path's, and a path that outruns it is
%  resolved to its pixel-band rectangles instead, in as many parts as
%  they need. That is a bound on the description and not on the
%  painting: the parts describe the same pixels between them, so what is
%  painted is what one polygon would have given.
%
%  This is the length a stroke reaches first. A stroke of nonzero width
%  fills the outline it encloses, and that outline runs to about a dozen
%  points a segment -- the body of each segment and the join at each end
%  of it -- so a polyline outruns one polygon at a few thousand segments,
%  well before the path itself grows large.
%
.xpostsys /.fillsubjparts {  % evenodd  .  [ spans ... ]
    4 dict begin
    /eo exch def
    count /n0 exch def
    /d0 countdictstack def
    {
        {
            eo { .fillpolyargs //.eospanparts exec }
               { [ .fillpolyargs ] } ifelse
        } stopped {
            count n0 sub { pop } repeat
            graphicsdict /currgstate get /currpath get eo .pathspanparts
        } if
    } stopped {
        % a refusal handed up from either route leaves its own
        % dictionaries open behind it, and the caller is owed a clean
        % stack under the failure it is about to be given.
        countdictstack d0 sub { end } repeat
        count n0 sub { pop } repeat
        end
        stop
    } if
    end
} put

%
%  Paint the parts of a region in the current colour, through the
%  device's polygon fill. A region that no single array describes
%  arrives in several, over disjoint bands of rows; each is painted in
%  turn, and a part holding no band is nothing to paint.
%
.xpostsys /.fillparts {  % [ spans ... ]  .  -
    DEVICE /DiscardsMarks known {
        %  A device that drops the marks it is handed has no colour to
        %  convert one for.
        %  The parts are dropped here rather than at the device, which
        %  reaches the same answer without converting a colour and
        %  applying a transfer for each of them. The page is still
        %  marked: what marks a page is that something was painted, not
        %  where the paint went.
        { dup length 2 gt { true //.setpagemarked exec } if pop } forall
    }{
    {
        dup length 2 gt {
            [ //.currentcolordict DEVICE /nativecolorspace get get exec
            //.applytransfer exec
            counttomark 2 add -1 roll
            DEVICE dup /FillPoly get exec
            true //.setpagemarked exec
            pop
        }{
            pop
        } ifelse
    } forall
    } ifelse
} put

%
%  Fill the current path with the current colour (PLRM 8.2).
%
%  A device with a FillPath method consumes the whole path itself,
%  and a vector device then fills with its curves preserved rather
%  than flattened. That route is open where the path lies wholly
%  inside a rectangular clip, and where the device clips for itself
%  and is handed the region as a shape; any other clip region is cut
%  by the polygon machinery, at the cost of flattening.
%
%  A path that cannot reach the region marks nothing, and the two
%  routes reach that page differently. The polygon route resolves the
%  fill against the region and is left with no span to paint, so the
%  device is never called. The whole-path route would hand the consumer
%  a fill and a clip that cancel, and the consumer would carry both to
%  arrive at the same blank. So the whole-path route asks first, and a
%  fill with no possible intersection goes no further than here.
%
/fill [ ] {  % -  .  -
    //.xpostsys /.colorroute get exec
    dup /pattern eq { pop //.xpostsys /.patternfill get exec }{
    % a colour that can never produce visible output: the path is
    % consumed, as fill consumes it, and nothing is painted.
    /nomarks eq { newpath }{
    closepath
    //.devtakespath exec {
    .clipmisses { flushpage newpath }{
        //.devsendclip exec
        [ //.currentcolordict DEVICE /nativecolorspace get get exec
        //.applytransfer exec
        DEVICE dup /FillPath get exec
        true //.setpagemarked exec
        pop
        flushpage
        newpath
    } ifelse
    }{
    flattenpath

    % Subpaths merged into one point list, separated by null, so that
    % FillPoly scans them together and interior subpaths produce holes.
    % A rectangular clip region is a single convex window: clip the fill
    % polygon against it geometrically, so it stays whole rectangles
    % rather than dissolving into per-scanline bands -- which a vector
    % device would otherwise emit as one subpath per row. A disjoint or
    % concave clip region has no single convex half-plane set, so it
    % intersects span-by-span in the fill's own scan-conversion, exact
    % for any region the nonzero rule can describe.
    .cliptrivial not {
        .cliprect { pop pop pop pop true }{ false } ifelse {
            //.doclip exec
            false //.fillsubjparts exec
        }{
            false //.fillsubjparts exec
            //.clippartsmeet exec
        } ifelse
    }{
        false //.fillsubjparts exec
    } ifelse
    /DEBUGFILL where { pop
        (fill)=
        pstack()=
        hook
    } if

    //.fillparts exec

    flushpage
    newpath
    } ifelse } ifelse } ifelse
} .defop

%
%  fill using the even-odd rule
%  The even-odd interior resolves to pixel-band rectangles through the
%  same scan-conversion as the nonzero fill, and the rectangles --
%  winding-uniform -- then travel the ordinary pipeline: clip span
%  intersection and the device FillPoly. A vector device consuming
%  whole paths through FillPath carries the rule to its consumer.
%
%  The rule itself is PLRM 4.5.2's other one: a point is inside where a
%  ray from it crosses the path an odd number of times, counted without
%  regard to direction, where the nonzero rule counts direction and asks
%  for a total other than zero.
%
/eofill [ ] {  % -  .  -
    //.xpostsys /.colorroute get exec
    dup /pattern eq { pop //.xpostsys /.patterneofill get exec }{
    /nomarks eq { newpath }{
    //.devtakespath exec {
        graphicsdict /currgstate get /.eorule true put

        % This implementation's own fill, immune to a program's
        % redefinition of the name (which may itself invoke eofill).
        //fill exec
        graphicsdict /currgstate get /.eorule false put
    }{
        closepath
        flattenpath
        true //.fillsubjparts exec
        .cliptrivial not {
            //.clippartsmeet exec
        } if

        //.fillparts exec

        flushpage
        newpath
    } ifelse } ifelse } ifelse
} .defop

%
%   x y proc  .  bool
%  upath proc  .  bool
%  The insideness core: proc resolves the subject region -- the spans
%  the corresponding painting operator would mark, in the parts that
%  operator would mark them in -- and the probe is either the device
%  pixel holding the point or the region an aperture user path encloses.
%  The point's pixel is inset by the fill grid's quantum so mere boundary
%  contact stays outside, and insideness is any span of any part
%  surviving the intersection. The clip does not participate: the test
%  asks about the painting operator's own marks
%
.xpostsys /.intest {
    8 dict begin
    /.insp exch def
    dup type dup /integertype eq exch /realtype eq or {
        transform
        floor 0.00390625 add /.iny exch def
        floor 0.00390625 add /.inx exch def
        [ [.inx .iny]
          [.inx 0.9921875 add .iny]
          [.inx 0.9921875 add .iny 0.9921875 add]
          [.inx .iny 0.9921875 add] ]
    }{
        gsave newpath uappend flattenpath .fillpolyargs grestore
    } ifelse
    /.inprobe exch def
    gsave .insp exec grestore
    /.inany false def
    /.inh graphicsdict /currgstate get /device get
        dup /height known { /height get }{ pop 0 } ifelse def
    { .inprobe 0 .inh .regionmeet length 2 gt { /.inany true def } if } forall
    .inany
    end
} put

%
%  Would fill -- or, for ineofill, eofill -- of the current path mark
%  the point's pixel, or any of the aperture's region. Each takes the
%  probe as a point or as an aperture user path.
%
%  infill reads the nonzero rule, ineofill the even-odd one.
%
/infill [ [ /numbertype /numbertype ] [ /arraytype ] ]
    {  % x y | upath  .  bool
      { flattenpath .fillpolyargs [ exch ] } //.intest exec }
     .defop
/ineofill [ [ /numbertype /numbertype ] [ /arraytype ] ]
    {  % x y | upath  .  bool
      { closepath flattenpath .fillpolyargs
        //.eospanparts exec } //.intest exec }
     .defop

%
%  The stroke and user-path forms wrap the two above: the subject
%  becomes the current path inside a gsave -- the stroke outline fills
%  by the nonzero rule -- and the probe operands pass through beneath.
%  The user-path forms take their subject on top, so what lies beneath
%  is either the probe point or the aperture, and both shapes are
%  stated; inustroke states the optional matrix that may follow.
%
%  instroke asks it of a stroke's outline, inufill and inueofill of a
%  user path filled by each rule, and inustroke of a user path's
%  stroke.
%
%  PLRM 4.5.3 is what they answer: whether a point or an aperture would
%  be painted, decided by the same rule the corresponding painting
%  operator uses, and answered without marking the page.
%
/instroke [ [ /numbertype /numbertype ] [ /arraytype ] ]
    {  % x y | upath  .  bool
      gsave strokepath infill grestore }
     .defop
/inufill [ [ /numbertype /numbertype /arraytype ] [ /arraytype /arraytype ] ]
    {  % x y upath | upath' upath  .  bool
      gsave newpath uappend infill grestore }
     .defop
/inueofill [ [ /numbertype /numbertype /arraytype ] [ /arraytype /arraytype ] ]
    {  % x y upath | upath' upath  .  bool
      gsave newpath uappend ineofill grestore }
     .defop
/inustroke [ [ /numbertype /numbertype /arraytype /arraytype ]
             [ /numbertype /numbertype /arraytype ]
             [ /arraytype /arraytype /arraytype ]
             [ /arraytype /arraytype ] ]
    {  % x y upath [matrix] | upath' upath [matrix]  .  bool
      gsave ustrokepath infill grestore }
     .defop

%
%  x1 y1 x2 y2 rect  .  x1' y1' x2' y2' true
%                        false
%
%  The portion of the segment within the rectangle [x0 y0 x1 y1],
%  found by walking the parameter range against each edge; an
%  endpoint on the boundary stays, so a segment ending on a shared
%  tile edge still marks the boundary pixel, as the unclipped walk
%  would.
%
.xpostsys /.hairsegclip {
    12 dict begin
    aload pop
    /ey exch def
    /ex exch def
    /by exch def /bx exch def
    /qy exch def /qx exch def /py exch def /px exch def
    /dx qx px sub def /dy qy py sub def
    /t0 0 def /t1 1 def /ok true def
    [ [ dx neg px bx sub ] [ dx ex px sub ]
      [ dy neg py by sub ] [ dy ey py sub ] ]
    {
        aload pop /q exch def /p exch def
        p 0 eq {
            q 0 lt { /ok false def } if
        }{
            /r q p div def
            p 0 lt {
                r t1 gt { /ok false def }{ r t0 gt { /t0 r def } if } ifelse
            }{
                r t0 lt { /ok false def }{ r t1 lt { /t1 r def } if } ifelse
        } ifelse } ifelse
    } forall
    ok t0 t1 le and {
        px dx t0 mul add py dy t0 mul add
        px dx t1 mul add py dy t1 mul add
        true
    }{ false } ifelse
    end
} put

%
%  draw line along current path
%
%  PLRM 4.5.1: the stroked line is centred on each segment with its sides
%  parallel to it, and each subpath is stroked on its own. What the line
%  looks like at its ends and its corners is the graphics state's, which
%  is why the parameters this reads are the ones 4.2 lists rather than
%  operands.
%
%  A device with a StrokePath method consumes the whole path itself
%  (vector devices stroke with true joins, caps and width); a raster
%  device fills the stroked outline, except at a device-space width of
%  zero, which takes the hairline DrawLine walk.
%
%  Zero is the only width that walk may take. A painting operation marks
%  every pixel whose square region the shape meets, however small the
%  intersection, so that the area marked is never less than the shape's
%  own; the rule holds for fills and for strokes of nonzero width alike,
%  and only a zero-width stroke is left to the device and allowed to
%  mark fewer pixels than it asks for (PLRM 7.5.1). A one-pixel walk
%  down the path does mark fewer: a band a fraction of a pixel wide
%  lying across a pixel boundary meets two rows of pixels, and the walk
%  marks one of them. Filling the outline marks both, which is also what
%  the same band gets when it arrives as a filled rectangle instead of a
%  stroke. At width zero the walk is what the width asks for -- the
%  thinnest line the device can draw -- and the outline it would fill
%  encloses no area at all.
%
/stroke [ ] {  % -  .  -
    //.xpostsys /.colorroute get exec
    dup /pattern eq {
        pop strokepath //.xpostsys /.patternfill get exec
    }{
    /nomarks eq { newpath }{
    //.devtakesstroke exec {
        % Dashing consumes line segments, so a dashed path is flattened and
        % cut into its dashes before it goes over. An undashed one passes
        % through unflattened, so curves reach the device.
        currentdash pop length 0 eq not {
            flattenpath
            //.dashpath exec
        } if

        % The clip goes to the device, not into the path: see
        % .devtakesstroke above.
        //.devsendclip exec

        [ //.currentcolordict DEVICE /nativecolorspace get get exec
        //.applytransfer exec
        DEVICE dup /StrokePath get exec
        true //.setpagemarked exec
        pop
        flushpage
        newpath
    }{
    % The hairline walk clips each segment against the rectangular
    % clip region before plotting it: a complex clip takes the outline
    % fill below, whose span intersection is exact for any region.
    currentlinewidth 0 dtransform
    dup mul exch dup mul exch add sqrt
    0 eq
    .cliprect { 4 array astore }{ null } ifelse
    .gscratch /.hairrect 3 -1 roll put
    .gscratch /.hairrect get null ne and {
        flattenpath
        //.dashpath exec
        mark
        {          % x0 y0
            2 copy  % X0 y0 x0 y0

            %pstack(M)=
        }
        {          % ... xN-1 yN-1 xN yN
            4 copy  % ... xN-1 yN-1 xN yN xN-1 yN-1 xN yN
            .gscratch /.hairrect get //.hairsegclip exec {
                [ //.currentcolordict DEVICE /nativecolorspace get get exec
                //.applytransfer exec
                counttomark 5 add -4 roll

                %5 1 roll  % ... xN-1 yN-1 xN yN gray xN-1 yN-1 xN yN
                %pstack(L)=
                DEVICE dup /DrawLine get exec  % ... xN-1 yN-1 xN yN
                true //.setpagemarked exec
                pop
            } if
            4 2 roll pop pop  % ... xN yN
        }
        {}
        {            % x0 y0 xN yN
            4 2 roll  % XN yN x0 y0
            .gscratch /.hairrect get //.hairsegclip exec {
                [ //.currentcolordict DEVICE /nativecolorspace get get exec
                //.applytransfer exec
                counttomark 5 add -4 roll

                %5 1 roll % gray xN yN x0 y0
                %pstack(C)=
                DEVICE dup /DrawLine get exec  % -
                true //.setpagemarked exec
                pop
            } if
        }
        //.devpathforall exec
        cleartomark
        flushpage
    }{
        strokepath
        //fill exec
    } ifelse

    newpath
    } ifelse } ifelse } ifelse
} .defop

%
%  Row machinery: image data arrives from datasrc in arbitrary
%  chunks; .fill assembles exact raw rows and .rownorm unpacks a
%  row's samples to one byte per sample. Samples pack high-order
%  first within each byte, and every row of samples begins on a byte
%  boundary (PLRM 4.10), so a sub-byte depth unpacks per row and the
%  pad bits fall off with the row's tail. Both run inside a
%  dictionary holding datasrc, pend, rawrow, buf, bits and
%  rowsamples; rows keep the raster within the string size limit
%  however large the image.
%

%
%  Assemble the next raw row into rawrow from the source's chunks,
%  carrying any surplus in pend; a dry source leaves the tail zeroed.
%
.xpostsys /.fill {  % -  .  -
    /got 0 def
    {
        got rawrow length ge { exit } if
        pend length 0 eq {
            % run the source on the caller's stacks: its defs are the
            % program's own business, and the machinery's scratch names
            % stay out of its reach.
            currentdict /datasrc get null 1 //.pcallout exec
            /pend exch def
        } if
        pend length 0 eq {
            got 1 rawrow length 1 sub { rawrow exch 0 put } for
            exit
        } if
        /take pend length rawrow length got sub
              2 copy gt { exch } if pop def
        rawrow got pend 0 take getinterval putinterval
        /pend pend take pend length take sub getinterval def
        /got got take add def
    } loop
} put

%
%
%  Unpack rawrow's rowsamples samples at depth bits into buf, one
%  byte per sample: sub-byte depths spread to the byte range, twelve
%  bits keep their high byte
%  The widths a sample may be, PLRM Table 4.20: "Allowed values are 1, 2,
%  4, 8, and 12.".
%
%  This is a SHORTER list than a sampled function's, which the language
%  extends to 16, 24 and 32, so the two cannot share one table even though
%  they share the problem. The reader below has a case per width and a
%  final branch that reads twelve bits; without this table a width outside
%  the list reached that branch and was read at the wrong stride, which
%  does not fail -- it paints a page from samples that were never there.
%
.xpostsys /.imgbits << 1 true 2 true 4 true 8 true 12 true >> readonly put

%
%  Unpack one raw row of image samples into one byte a sample, whatever
%  depth the source states. The eight-bit case is a copy; the narrower
%  depths spread their samples out, and twelve bits is the odd one, two
%  samples spanning three bytes.
%
%  Reads rawrow and writes buf, both of the caller's dictionary, so it
%  takes and leaves nothing: the image walk calls it once per row and
%  the row it filled is where the walk already looks. The depths it
%  serves are the ones .imgbits above names, and a depth outside that
%  list never reaches here.
%
.xpostsys /.rownorm {  % -  .  -
    bits 8 eq {
        buf 0 rawrow putinterval
    }{ bits 1 eq {
        0 1 rowsamples 1 sub { /s exch def
            buf s
            rawrow s 8 idiv get 7 s 7 and sub neg bitshift 1 and 255 mul
            put
        } for
    }{ bits 2 eq {
        0 1 rowsamples 1 sub { /s exch def
            buf s
            rawrow s 4 idiv get 3 s 3 and sub 2 mul neg bitshift 3 and 85 mul
            put
        } for
    }{ bits 4 eq {
        0 1 rowsamples 1 sub { /s exch def
            buf s
            rawrow s 2 idiv get s 1 and 0 eq { -4 bitshift }{ 15 and } ifelse
            17 mul
            put
        } for
    }{
        % Twelve bits: an even sample owns a byte and the next
        % nibble, an odd one the low nibble and the next byte.
        0 1 rowsamples 1 sub { /s exch def
            /k s 3 mul 2 idiv def
            buf s
            s 1 and 0 eq {
                rawrow k get
            }{
                rawrow k get 15 and 4 bitshift
                rawrow k 1 add get -4 bitshift or
            } ifelse
            put
        } for
    } ifelse } ifelse } ifelse } ifelse
} put

%
%  Read one row of an image's samples into the buffers the painters read
%  from. A row arrives either as one stream carrying every component of a
%  sample together, or as one stream per component (PLRM 4.10,
%  MultipleDataSources), and which it is decides how many reads a row
%  takes and where each lands. That is the only difference, so it is
%  settled once here: three places read a row, and each had written the
%  same two arms out again.
%
.xpostsys /.imgrowread {  % -  .  -
    multi {
        0 1 ncomp 1 sub { /c exch def
            /datasrc srcs c get def
            /pend pends c get def
            /rawrow rawrows c get def
            /buf bufs c get def
            //.fill exec //.rownorm exec
            pends c pend put
        } for
    }{
        //.fill exec //.rownorm exec
    } ifelse
} put

%
%  Normalize an image data source: a file becomes a chunk-reading
%  procedure, a string a procedure delivering it, a procedure passes
%  through unchanged.
%
.xpostsys /.imgsource {  % src  .  proc
    dup type /arraytype eq 1 index xcheck not and {
        % a literal array carries one source per component
        [ exch { //.xpostsys /.imgsource get exec } forall ]
    }{
    dup type /filetype eq {
        [ exch 4096 string /readstring cvx /pop cvx ] cvx
    }{
        dup type /stringtype eq {
            [ exch ] cvx
        } if
    } ifelse } ifelse
} put

%
%  The clip region resolved to rectangle spans, as flat device-space
%  quads (x0 y0 x1 y1 each): the region path -- a stored user path or
%  already-resolved spans -- runs through the fill machinery's
%  scan-conversion either way.
%
.xpostsys /.clipspans {  % -  .  array
    % The page met against the region is the region resolved: the
    % rectangle covers every pixel the device has, and the meeting
    % scan-converts the region as the fills themselves do -- by the
    % nonzero rule, so a region holding overlapping subpaths (a
    % stencil's adjacent runs under magnification) keeps the pixels an
    % even-odd resolver would cancel. The answer arrives in parts when
    % no single array describes it, and the quads run on across them.
    [ [0 0]
      [DEVICE /dimensions get 0 get 0]
      [DEVICE /dimensions get 0 get DEVICE /dimensions get 1 get]
      [0 DEVICE /dimensions get 1 get] null ]
    //.clipmeetparts exec
    8 dict begin
    /parts exch def
    [
    parts {
    /q exch def
    /i 0 def
    {
        i q length ge { exit } if
        /mnx 9e99 def /mny 9e99 def /mxx -9e99 def /mxy -9e99 def
        /got false def
        {
            i q length ge { exit } if
            q i get dup type /nulltype eq { pop /i i 1 add def exit } if
            aload pop
            dup mny lt { dup /mny exch def } if
            dup mxy gt { dup /mxy exch def } if
            pop
            dup mnx lt { dup /mnx exch def } if
            dup mxx gt { dup /mxx exch def } if
            pop
            /got true def
            /i i 1 add def
        } loop
        got { mnx mny mxx mxy } if
    } loop
    } forall
    ]
    end
} put

%
%  .cunit's fold scaled to a byte, rounded. The clamp is written out
%  rather than reached through .cunit because this runs once per
%  component per pixel of an image.
%
%  The tables a sampled image's bytes are read through: one per component,
%  each mapping a sample to the value the Decode entry puts it at, and each
%  already carried into the range the device paints in.
%
%  PLRM 4.10.5 gives Decode as a min-max pair per component and a sample as
%  its place between them, so what a device writer needs is the same 256
%  answers per component however it goes on to write them. Three writers
%  wanted the identical table and each built its own; it is built here once
%  and they read it.
%
.xpostsys /.decodeluts {  % decode ncomp  .  [ lut ... ]
    2 dict begin
    /dlnc exch def /dldec exch def
    [ 0 1 dlnc 1 sub { /c exch def
        /dlt 256 string def
        0 1 255 { /v exch def
            dlt v
            v 255 div
            dldec c 2 mul 1 add get dldec c 2 mul get sub mul
            dldec c 2 mul get add
            //.xpostsys /.c255 get exec
            put
        } for dlt
    } for ]
    end
} put

%
.xpostsys /.c255 {  % v  .  byte
    dup 0 lt { pop 0 } if dup 1 gt { pop 1 } if
    255 mul round cvi
} put

%
%  One normalized component of the pixel in hand, from its plane's
%  row buffer or the interleaved one.
%
.xpostsys /.sampleat {  % c  .  value
    multi { bufs exch get x get }{ base add buf exch get } ifelse
} put

%
%  The shared image painter: the collectors normalize every sample
%  depth to one byte, so each pixel reads ncomp bytes, maps each
%  through its Decode range, and delivers the components to setcolor
%  in the current colour space. Two masking controls, null when
%  unused: mbits is a string of one bit per mask sample in byte-padded
%  row order (a set bit leaves the pixel unpainted) over a grid of mw by
%  mh samples covering the page area the image's own grid covers, and
%  mranges an array of min,max pairs of normalized sample values (a
%  pixel whose every raw component falls within its pair is left
%  unpainted).
%
%  The mask keeps its own grid rather than being read onto the image's,
%  since the two need not have the same resolution (PLRM 4.10.6). Which
%  mask sample decides a device pixel follows from where that pixel
%  falls, so a mask finer than the image decides pixel by pixel at its
%  own resolution and a coarser one spreads over the pixels it covers.
%
.xpostsys /.imagepaintm {  % width height bits mat datasrc decode ncomp mbits mw mh mranges /operator  .  -
    % The data source is the program's procedure: the whole painting
    % goes through the bracket, so a source that raises cannot leave
    % this graphics state open or this dictionary current.
    {
    gsave
        newpath
        32 dict begin
        //.refreshscreencell exec
        //.paintbind1 {exch def} forall

        % The width is refused here, where it is first known and before
        % any row is read, because every route into this painter -- the
        % dictionary forms, the five-operand form, colorimage and the two
        % masked types -- arrives through it. The route hands over its own
        % name, so the refusal reports the operator the program called
        % rather than the one this painter is written for (PLRM 3.11.1).
        //.imgbits bits known not {
            operator cvx /rangecheck signalerror
        } if

        % The dictionary image form leaves its Interpolate request in
        % the graphics scratch for this one painting; anything else
        % paints stepped.
        /interp .gscratch /.imginterp 2 copy known { get }{ pop pop false } ifelse def
        .gscratch /.imginterp false put

        % a literal array of sources delivers each component from its
        % own plane; a single source interleaves them. The source is
        % loaded through the dictionary, never by name: an executable
        % array is a procedure and a bare lookup would run it.
        /multi currentdict /datasrc get
               dup type /arraytype eq exch xcheck not and def
        multi {
            /rowsamples width def
            /prb width bits mul 7 add 8 idiv def
            /srcs currentdict /datasrc get def
            /rawrows [ ncomp { prb string } repeat ] def
            /bufs [ ncomp { width string } repeat ] def
            /pends [ ncomp { () } repeat ] def
        }{
            /rowsamples width ncomp mul def
            /rawrow rowsamples bits mul 7 add 8 idiv string def
            /buf rowsamples string def
            /pend () def
        } ifelse
        % the mask's own row stride, since the bits are held on the
        % mask's grid; without a mask there is no stride to state
        /mrow mbits null eq { width }{ mw } ifelse 7 add 8 idiv def

        % whether the mask decides a device pixel at a finer step than
        % the image samples do, which is where a pixel has to be placed
        % against the mask rather than taken from the sample it lies in
        /mfine mbits null ne mw width ne mh height ne or and def

        % a device that consumes whole images -- the vector writers --
        % takes the sample rows and the image-to-device matrix and
        % paints nothing here; the masked forms keep the painting path.
        %
        % What such a device is handed is the samples and the matrix that
        % places them, so what the clip admits is settled where the
        % document is written and not here. A clip admitting nothing has
        % nothing to write down that says so -- an outline with no
        % elements in it is read by one consumer as a region enclosing
        % nothing and by another as no clip at all -- so an image under
        % one is not handed over: PLRM 4.8.1 paints an image only where
        % the clipping path admits it, and none of this one is painted.
        %  A device that writes what it is asked to paint can be given a
        %  masked image whole, where it says it can take one: both kinds of
        %  mask are things a written document can carry, and the route
        %  below would otherwise put one rectangle per sample into it. What
        %  it is handed is the mask as it stands -- the bits on their own
        %  grid, or the ranges -- since a writer states them as they are
        %  rather than resolving them against the samples.
        DEVICE /PaintImage known
        mbits null eq mranges null eq and
            DEVICE /PaintImageMasked known or
        and {
            /m mat matrix invertmatrix matrix currentmatrix
               matrix concatmatrix def
            /allrows height array def
            0 1 height 1 sub { /y exch def
                //.imgrowread exec
                multi {
                    /irow width ncomp mul string def
                    0 1 width 1 sub { /x exch def
                        0 1 ncomp 1 sub { /c exch def
                            irow x ncomp mul c add
                            bufs c get x get put
                        } for
                    } for
                    allrows y irow put
                }{
                    allrows y buf dup length string copy put
                } ifelse
            } for
            % An image of no samples paints nothing, which is settled here
            % rather than in each device: a device is not asked to paint
            % it, exactly as it is not asked when the clip admits nothing.
            % Asked, the devices did not agree -- most took the empty grid
            % and marked nothing, and the one that hands its samples to an
            % encoder refused a picture of no width.
            //.clipvoid exec not width 0 gt and height 0 gt and {
                width height ncomp m allrows decode interp
                mbits null eq mranges null eq and {
                    DEVICE dup /PaintImage get exec
                }{
                    mbits mw mh mranges
                    DEVICE dup /PaintImageMasked get exec
                } ifelse
                true //.setpagemarked exec
            } if
        }{

        % Per-component decode as base + sample x scale over 0..255
        /dbase ncomp array def
        /dscale ncomp array def
        0 1 ncomp 1 sub { /c exch def
            /dmin decode c 2 mul get def
            dbase c dmin put
            dscale c decode c 2 mul 1 add get dmin sub 255 div put
        } for

        % Direct raster path: an axis-aligned mapping, a rectangular
        % clip region and a raster device with a page buffer let each
        % row write straight into the raster through .blitrow, the
        % colour pipeline baked into tables up front: a one-component
        % space bakes decode, colour conversion and transfer into one
        % table by running each of its 256 samples through the
        % interpreter's own machinery; RGB and CMYK samples take
        % per-component decode tables, convert in the operator and
        % pass through the transfer table after.
        %
        % A device that writes down what it is asked to paint takes the
        % same route as far as the rows, and is handed the rows and the
        % dictionary describing them instead of having them written into
        % a raster it does not keep. It has to be: the route below paints
        % a device without rows one rectangle per sample, and a page
        % written down that way costs tens of bytes a sample against the
        % one to three bytes a pixel of the page being escaped.
        %
        % A device keeping its raster in a buffer of its own -- the
        % compiled writers, and the ones that hand their buffer to
        % whoever embedded the interpreter -- has no rows to write into
        % either, and takes the same route through its own rectangle
        % fill: the writer above states one run of columns per sample
        % and per device row, and such a device is handed each of them
        % as a fill rather than having the bytes stored into a row. The
        % fill has to be compiled, since what runs a method written as a
        % procedure is the interpreter and the writer is a C function;
        % the devices that put out a page as drawing instructions rather
        % than as pixels declare theirs as procedures and so keep the
        % rectangle per sample, which is what they turn into their own
        % marks.
        /blitok false def
        /blitrec DEVICE /.recordimage known def
        /blitdev
            blitrec not DEVICE /ImgData known not and {
                DEVICE /FillRect known {
                    DEVICE /FillRect get type /operatortype eq
                }{ false } ifelse
            }{ false } ifelse def
        DEVICE /ImgData known blitrec or blitdev or {
            DEVICE /nativecolorspace get
            dup /DeviceRGB eq exch /DeviceGray eq or {
                /m mat matrix invertmatrix matrix currentmatrix
                   matrix concatmatrix def
                m 1 get abs 0.000001 lt m 2 get abs 0.000001 lt and {
                    /cspansv null def
                    .cliprect {
                        /ccy1 exch def /ccx1 exch def
                        /ccy0 exch def /ccx0 exch def
                    }{
                        % a non-rectangular region: its resolved spans
                        % clamp each raster write instead.
                        /ccx0 0 def /ccy0 0 def
                        /ccx1 DEVICE /dimensions get 0 get def
                        /ccy1 DEVICE /dimensions get 1 get def
                        /cspansv //.clipspans exec def
                    } ifelse
                    /csname currentcolorspace
                        dup type /arraytype eq { 0 get } if def
                    ncomp 1 eq
                    ncomp 3 eq csname /DeviceRGB eq and or
                    ncomp 4 eq csname /DeviceCMYK eq and or
                    { /blitok true def } if
                } if
            } if
        } if
        blitok {
            /nat DEVICE /nativecolorspace get /DeviceRGB eq { 3 }{ 1 } ifelse def
            /tlut 256 string def
            0 1 255 { /v exch def
                tlut v
                v 255 div currenttransfer exec //.c255 exec
                put
            } for
            nat 3 eq {
                /tlutr 256 string def
                /tlutg 256 string def
                /tlutb 256 string def
                0 1 255 { /v exch def
                    tlutr v v 255 div
                        graphicsdict /currgstate get /redtransfer get exec
                        //.c255 exec put
                    tlutg v v 255 div
                        graphicsdict /currgstate get /greentransfer get exec
                        //.c255 exec put
                    tlutb v v 255 div
                        graphicsdict /currgstate get /bluetransfer get exec
                        //.c255 exec put
                } for
            } if
            ncomp 1 eq {
                /lut 256 nat mul string def
                0 1 255 { /v exch def
                    v dscale 0 get mul dbase 0 get add setcolor
                    //.currentcolordict DEVICE /nativecolorspace get get exec
                    nat 3 eq {
                        /bb exch def /gg exch def /rr exch def
                        lut v 3 mul       tlutr rr //.c255 exec get put
                        lut v 3 mul 1 add tlutg gg //.c255 exec get put
                        lut v 3 mul 2 add tlutb bb //.c255 exec get put
                    }{
                        lut v 3 -1 roll //.c255 exec tlut exch get put
                    } ifelse
                } for
            }{
                /dluts [ ncomp { 256 string } repeat ] def
                0 1 ncomp 1 sub { /c exch def
                    /dl dluts c get def
                    0 1 255 { /v exch def
                        dl v
                        v dscale c get mul dbase c get add //.c255 exec
                        put
                    } for
                } for
            } ifelse
            /bd 24 dict def
            blitrec not {
                blitdev
                    { bd /dev DEVICE put }
                    { bd /rows DEVICE /ImgData get put } ifelse
            } if
            bd /devw DEVICE /dimensions get 0 get put
            bd /devh DEVICE /dimensions get 1 get put
            bd /nat nat put
            bd /rgbrows nat 3 eq put
            bd /w width put
            bd /ncomp ncomp put
            multi { bd /bufs bufs put }{ bd /buf buf put } ifelse
            bd /xoff m 4 get put
            bd /xscale m 0 get put
            bd /yoff m 5 get put
            bd /yscale m 3 get put
            bd /cx0 ccx0 put
            bd /cy0 ccy0 put
            bd /cx1 ccx1 put
            bd /cy1 ccy1 put
            cspansv null ne { bd /cspans cspansv put } if
            bd /mbits currentdict /mbits get put
            bd /mrowb mrow put
            bd /h height put
            bd /mw mbits null eq { width }{ mw } ifelse put
            bd /mh mbits null eq { height }{ mh } ifelse put
            bd /mranges currentdict /mranges get put
            bd /cmyk ncomp 4 eq put
            ncomp 1 eq {
                bd /lut lut put
            }{
                bd /dluts dluts put
            } ifelse
            bd /tlut tlut put
            DEVICE /.state get /.htcell known {
                bd /.htcell DEVICE /.state get /.htcell get put
                bd /.htw DEVICE /.state get /.htw get put
                bd /.hth DEVICE /.state get /.hth get put
            } if
            nat 3 eq {
                bd /tlutr tlutr put
                bd /tlutg tlutg put
                bd /tlutb tlutb put
            } if
            bd /y 0 put
            /interpok interp def
            interpok {
                bd /interp true put

                % A device that writes the image down is handed every row
                % and blends them where it plays them, so the buffer a
                % blend reads the row before from is the player's and is
                % not made here.
                blitrec not {
                    multi {
                        /pbufs [ ncomp { width string } repeat ] def
                        bd /prevs pbufs put
                    }{
                        /pbuf rowsamples string def
                        bd /prev pbuf put
                    } ifelse

                    % Keep this row's samples for the next call's blend.
                    /.keeprow {  % -  .  -
                        multi {
                            0 1 ncomp 1 sub { /c exch def
                                pbufs c get 0 bufs c get putinterval
                            } for
                        }{
                            pbuf 0 buf putinterval
                        } ifelse
                    } def
                } if
            } if

            % The rows to hand over, where they are being written down
            % rather than written into a raster: each is the painter's
            % own buffer, refilled for the row after, so each is taken
            % as it stands.
            blitrec {
                /recrows multi { height ncomp mul }{ height } ifelse
                    array def
            } if
            0 1 height 1 sub { /y exch def
                //.imgrowread exec
                blitrec {
                    multi {
                        0 1 ncomp 1 sub { /c exch def
                            recrows y ncomp mul c add
                                bufs c get dup length string copy put
                        } for
                    }{
                        recrows y buf dup length string copy put
                    } ifelse
                }{
                    bd /y y put
                    interpok {
                        y 0 eq { .keeprow } if
                        bd /last y height 1 sub eq put
                    } if
                    bd .blitrow
                    interpok { .keeprow } if
                } ifelse
            } for
            blitrec { bd recrows DEVICE dup /.recordimage get exec } if

            % A row written here goes straight into the raster and passes
            % none of the painting operators, so what it leaves on the
            % page is recorded here instead. What it leaves is the box the
            % mapping puts the image in, met with the region the rows are
            % written through: an image the clip keeps nothing of reaches
            % the page nowhere and leaves it as it found it.
            /ibx0 m 4 get def
            /ibx1 ibx0 width m 0 get mul add def
            ibx1 ibx0 lt { ibx0 ibx1 /ibx0 exch def /ibx1 exch def } if
            /iby0 m 5 get def
            /iby1 iby0 height m 3 get mul add def
            iby1 iby0 lt { iby0 iby1 /iby0 exch def /iby1 exch def } if
            ibx0 ccx0 lt { /ibx0 ccx0 def } if
            ibx1 ccx1 gt { /ibx1 ccx1 def } if
            iby0 ccy0 lt { /iby0 ccy0 def } if
            iby1 ccy1 gt { /iby1 ccy1 def } if
            ibx1 ibx0 gt iby1 iby0 gt and
            { true //.setpagemarked exec } if
        }{
        % Invert into a fresh matrix: the operand matrix belongs to
        % the caller, who may reuse it (a Type 3 font mutating one
        % shared matrix per glyph is the classic case).
        mat matrix invertmatrix concat

        % The colour a sample paints is a fixed function of the sample, so
        % a run of one sample value need be selected as a colour only once:
        % remember the last painted sample and skip setcolor while it holds.
        % For a CIE, Separation or DeviceN image that runs the conversion
        % once a run rather than once a pixel.
        /prevsamp ncomp array def
        /prevset false def
        %  A device that drops the marks it is handed is handed none.
        %  Every sample below is painted with a rectfill of its own, so
        %  an image costs one fill per pixel here -- which is the price
        %  of turning samples into marks, and there is nothing to turn
        %  them into. The rows are still read: the data source is the
        %  program's procedure and what it consumes is observable, so it
        %  is run exactly as often as it would have been.
        /discardsmarks DEVICE /DiscardsMarks known def
        discardsmarks { true //.setpagemarked exec } if
        0 1 height 1 sub { /y exch def
            //.imgrowread exec
            discardsmarks not {
            0 1 width 1 sub { /x exch def
                /base x ncomp mul def
                /paintit true def
                mbits null ne mfine not and {
                    mbits y mrow mul x 8 idiv add get
                    7 x 7 and sub neg bitshift 1 and 1 eq
                    { /paintit false def } if
                } if
                paintit mranges null ne and {
                    /inrange true def
                    0 1 ncomp 1 sub { /c exch def
                        c //.sampleat exec
                        dup mranges c 2 mul get lt
                        exch mranges c 2 mul 1 add get gt or
                        { /inrange false def } if
                    } for
                    inrange { /paintit false def } if
                } if
                paintit {
                    /samesamp prevset def
                    0 1 ncomp 1 sub { /c exch def
                        c //.sampleat exec
                        dup prevsamp c get ne { /samesamp false def } if
                        prevsamp exch c exch put
                    } for
                    samesamp not {
                        0 1 ncomp 1 sub { /c exch def
                            prevsamp c get dscale c get mul dbase c get add
                        } for
                        setcolor
                        /prevset true def
                    } if
                    mfine {
                        % The sample lies under a run of mask cells, and
                        % each is painted over just the part of the
                        % sample it covers: a mask finer than the image
                        % divides the sample, a coarser one leaves it
                        % whole. The extents are met rather than assumed
                        % to nest, since neither grid need divide the
                        % other.
                        /mc0 x mw mul width idiv def
                        /mc1 x 1 add mw mul width add 1 sub width idiv
                            1 sub def
                        /mr0 y mh mul height idiv def
                        /mr1 y 1 add mh mul height add 1 sub height idiv
                            1 sub def
                        mr0 1 mr1 { /mr exch def
                            /py0 mr height mul mh div
                                 dup y lt { pop y } if def
                            /py1 mr 1 add height mul mh div
                                 dup y 1 add gt { pop y 1 add } if def
                            py1 py0 gt {
                                mc0 1 mc1 { /mc exch def
                                    mbits mr mrow mul mc 8 idiv add get
                                    7 mc 7 and sub neg bitshift 1 and
                                    0 eq {
                                        /px0 mc width mul mw div
                                             dup x lt { pop x } if def
                                        /px1 mc 1 add width mul mw div
                                             dup x 1 add gt
                                             { pop x 1 add } if def
                                        px1 px0 gt {
                                            px0 py0
                                            px1 px0 sub py1 py0 sub
                                            rectfill
                                        } if
                                    } if
                                } for
                            } if
                        } for
                    }{
                        x y 1 1 rectfill
                    } ifelse
                } if
            } for
            } if
        } for
        } ifelse } ifelse

        end
    grestore
    } null 0 //.callout exec
} put

%
%  The unmasked form: the same paint with no mask bits and no colour-key
%  ranges, which is what an ImageType 1 image is.
%
.xpostsys /.imagepaint {  % width height bits mat datasrc decode ncomp  .  -
    null 0 0 null /image //.imagepaintm exec
} put

%
%  What an image dictionary says its grid is. PLRM Table 4.25 types Width
%  and Height as integers, and they are counts of samples: a value that is
%  not an integer is not a count, and one below zero counts nothing. A
%  grid of no samples at all is a different matter and is left alone --
%  that paints nothing, which is an answer.
%
%  Asked in one place because every image type states the same two
%  entries, and a grid refused for one of them is not a grid for any of
%  the others. The fault is handed back rather than raised, so each caller
%  raises it as its own operator and leaves what it opened the way it
%  leaves it for every other refusal.
%
%  A grid is also held to a size. A count that is not a count is refused
%  above; a count larger than this describes an image no medium carries and
%  no program means, and the row walk below would take it a row at a time
%  for as long as it was asked to. Four million and some is a hundred times
%  the samples across a page at the finest resolution anything prints at,
%  so the limit turns an unbounded walk into a refusal without standing in
%  front of any image.
.xpostsys /.imgextentmax 4194304 put

.xpostsys /.imgextentfault {  % dict  .  null | /typecheck | /rangecheck
    dup /Width get exch /Height get
    2 copy type /integertype eq exch type /integertype eq and not
        { pop pop /typecheck }
        { 2 copy 0 lt exch 0 lt or
            { pop pop /rangecheck }
            { //.imgextentmax ge exch //.imgextentmax ge or
                { /rangecheck }{ null } ifelse }
          ifelse }
    ifelse
} put

%
%  scale a raw sample value as the collectors scale samples to bytes
%
.xpostsys /.mcscale {  % raw bits  .  normalized
    dup 12 eq { pop -4 bitshift }{
    dup 8 eq { pop }{
    dup 4 eq { pop 17 mul }{
    2 eq { 85 mul }{ 255 mul } ifelse } ifelse } ifelse } ifelse
} put

%
%  Colour-key masking: a pixel whose every raw component falls within
%  the MaskColor ranges leaves the page untouched. MaskColor holds one
%  value per component (an exact colour) or min,max pairs.
%
%  The data source a dictionary names, held to what the dictionary says
%  about it.
%
%  PLRM Table 4.20 has MultipleDataSources say whether DataSource carries
%  one source or one per colour component, and it is the dictionary's word
%  that decides. Reading the shape of DataSource instead and letting the
%  flag mean nothing accepts two dictionaries that describe themselves
%  wrongly -- a true flag over a single string, and a false one (or none,
%  which is false) over an array of sources -- and paints something for
%  both rather than refusing. Each is a typecheck, as is a flag that is not
%  a boolean at all.
%
.xpostsys /.imgdatasource {  % dict /op  .  proc
    2 dict begin
    /op exch def
    /d exch def
    /multi d /MultipleDataSources 2 copy known { get }{ pop pop false } ifelse def
    multi type /booleantype ne { op cvx /typecheck signalerror } if
    /src d /DataSource get def
    % /src load, never src: the common case is a procedure delivering a row
    % at a time, and naming it would run it here instead of handing it on.
    % A literal array is several sources; an executable one is that
    % procedure, and is a single stream.
    /src load type /arraytype eq /src load xcheck not and multi ne
        { op cvx /typecheck signalerror } if
    /src load //.imgsource exec
    end
} put

%
.xpostsys /.imagetype4 {  % imagedict  .  -
    8 dict begin
    /d exch def
    d /Interpolate 2 copy known { get }{ pop pop false } ifelse
    dup type /booleantype eq { .gscratch /.imginterp 3 -1 roll put }{ pop } ifelse
    /itbits d /BitsPerComponent get def
    /itn //.ncomponents exec def

    % MaskColor names a colour in the current space, exactly or as a
    % range per component, so it is one or two values a component
    % (PLRM Table 4.25), and each is a sample value the image could
    % carry. An array of some other length pairs the values up against
    % components they do not belong to, and a value the depth cannot
    % reach names a colour no sample can be, so neither describes what
    % the entry is for.
    /itmc d /MaskColor get def
    itmc length itn ne itmc length itn 2 mul ne and
        { end /image cvx /rangecheck signalerror } if
    /itmax 1 itbits bitshift 1 sub def
    itmc { dup 0 lt exch itmax gt or
           { end /image cvx /rangecheck signalerror } if } forall

    /itrange [
        itmc length itn eq {
            itmc { itbits //.mcscale exec dup } forall
        }{
            itmc { itbits //.mcscale exec } forall
        } ifelse
    ] def
    d //.imgextentfault exec dup null ne
        { end /image cvx exch signalerror }{ pop } ifelse
    d /Width get d /Height get itbits d /ImageMatrix get
    d /image //.imgdatasource exec
    d /Decode get
    itn null 0 0 itrange
    end
    /image //.imagepaintm exec
} put

%
%  Explicit masking: MaskDict describes a one-bit-deep stencil over
%  the same image space as DataDict's samples; a mask value decoding
%  to 1 leaves the pixel unpainted. The three interleaves place the
%  mask sample-by-sample in the one stream (1, at the image depth),
%  row-by-row in the one stream (2), or in MaskDict's own DataSource
%  (3). Under 2 and 3 the mask's grid may differ from the image's, and
%  the bits are kept on the mask's grid whichever it is.
%
.xpostsys /.it1row {  % statedict  .  datarow
    begin
    //.fill exec //.rownorm exec
    0 1 iw 1 sub { /i exch def
        % The mask sample carries the image's depth with every bit set
        % to the same value, and a sample that is neither all 0 nor all
        % 1 stands for all 1 (PLRM Table 4.22). What decides the pixel
        % is therefore whether the sample is zero, not where it sits in
        % the range: a threshold would paint through half the values
        % the table sends the other way.
        /mv buf i nc 1 add mul get 0 ne def
        iminv { /mv mv not def } if
        mv {
            imbits iy imrow mul i 8 idiv add 2 copy get
            128 i 7 and neg bitshift or put
        } if
        drow i nc mul buf i nc 1 add mul 1 add nc getinterval putinterval
    } for
    /iy iy 1 add def
    drow
    end
} put

%
%  One row of an ImageType 3 image whose mask arrives row-by-row in the
%  same stream as the samples (InterleaveType 2). The stream is a run of
%  interleave blocks, all of one shape, and within a block every mask
%  row precedes every image row (PLRM Table 4.22). The two heights
%  decide the shape: one is a multiple of the other, so a block is
%  either several mask rows and one image row or one mask row and
%  several image rows.
%
%  A block's mask rows are read when its first image row is asked for,
%  and every one of them is kept, on the mask's own grid and in the
%  order the stream states them, inverted where the mask's Decode asks
%  for it so that everything downstream reads one polarity. A block
%  carrying several mask rows to one image row is a mask finer than the
%  image, and keeping only the row nearest each image row would throw
%  away exactly the detail the finer mask was given for.
%
.xpostsys /.it2row {  % statedict  .  datarow
    begin
    iy ipb mod 0 eq {
        0 1 mpr 1 sub { /k exch def
            /rawrow mraw def //.fill exec
            iminv {
                0 1 mraw length 1 sub { /j exch def
                    imbits my imrow mul j add mraw j get 255 xor put
                } for
            }{
                imbits my imrow mul mraw putinterval
            } ifelse
            /my my 1 add def
        } for
    } if
    /rawrow draw def //.fill exec
    /iy iy 1 add def
    draw
    end
} put

%
%  Paint an image under an explicit mask (PLRM 4.10.3): MaskDict
%  describes a one-bit stencil over the same image space as DataDict's
%  samples, and a mask sample decoding to 1 leaves its pixel unpainted.
%
%  InterleaveType says where the mask's bits come from -- sample by
%  sample in the one stream, row by row in the one stream, or out of
%  MaskDict's own DataSource, where the mask may be on a different grid
%  from the image. The bits are kept on whatever grid they arrive on and
%  the painter places each device pixel against it.
%
.xpostsys /.imagetype3 {  % dict  .  -
    20 dict begin
    /d exch def
    /md d /MaskDict get def
    /dd d /DataDict get def
    dd /Interpolate 2 copy known { get }{ pop pop false } ifelse
    dup type /booleantype eq { .gscratch /.imginterp 3 -1 roll put }{ pop } ifelse
    /il d /InterleaveType get def
    dd //.imgextentfault exec dup null ne
        { end /image cvx exch signalerror }{ pop } ifelse
    md //.imgextentfault exec dup null ne
        { end /image cvx exch signalerror }{ pop } ifelse
    /w dd /Width get def
    /h dd /Height get def
    /bpc dd /BitsPerComponent get def
    % The depth is asked for here because interleave type 1 does not hand
    % it to the painter: its row procedure de-interleaves the mask from the
    % samples and yields the row already at eight bits, so the painter --
    % where every other route has its depth checked -- is told eight and
    % never sees what the dictionary declared. PLRM Table 4.25 allows 1, 2,
    % 4, 8 and 12, and Table 4.24 has the mask carry the image's own depth
    % under this interleave, so the one check answers for both.
    //.imgbits bpc known not
        { end /image cvx /rangecheck signalerror } if
    /n //.ncomponents exec def
    /mw md /Width get def
    /mh md /Height get def

    % The three dictionaries describe one image between them, and the
    % restrictions PLRM Tables 4.22 to 4.24 place on them are what makes
    % the description one image rather than three. A description that
    % breaks one of them is refused here: painting it anyway means
    % reading a stream laid out one way as though it were laid out
    % another, which does not fail -- it paints a page from samples that
    % were never there, and the mask that was the point of the type
    % falls where nothing asked for it.
    il 1 eq il 2 eq or il 3 eq or not
        { end /image cvx /rangecheck signalerror } if
    dd /ImageType get 1 ne md /ImageType get 1 ne or
        { end /image cvx /rangecheck signalerror } if

    % A grid of no samples in either dimension is refused, whichever of
    % the two states it. PLRM Table 4.24 has the mask's ImageMatrix
    % align the mask's corners with the image's, and a grid with no rows
    % or no columns has no corners to align: there is nothing to say
    % which of the image's pixels the mask would leave unpainted, and
    % every ratio taken between the two grids divides by nothing -- the
    % interleave-2 block shape below is that ratio. The alignment is
    % between two grids and reads the same from either end, so the
    % image's dimensions answer for it as the mask's do; an image
    % dictionary whose entries are inconsistent with each other is a
    % rangecheck (PLRM 4.10.5, above Table 4.20, where Width and Height
    % are the image's extent in samples).
    %
    % Unmasked, an image of no samples is not refused: nothing about it
    % contradicts anything else in its dictionary, and it paints a
    % rectangle of no area, which is a page.
    w 1 lt h 1 lt or mw 1 lt or mh 1 lt or
        { end /image cvx /rangecheck signalerror } if
    il 3 ne {
        % the mask travels in the image's stream, so the image has one
        % stream to travel in
        dd /MultipleDataSources 2 copy known { get }{ pop pop false } ifelse
        dup type /booleantype ne exch true eq or
            { end /image cvx /typecheck signalerror } if
    } if
    il 1 eq {
        % sample by sample in the one stream: one grid, one depth
        md /Width get w ne md /Height get h ne or
        md /BitsPerComponent get bpc ne or
            { end /image cvx /typecheck signalerror } if
    }{
        md /BitsPerComponent get 1 ne
            { end /image cvx /typecheck signalerror } if
        il 2 eq {
            % row by row in the one stream: the block shape is the ratio
            % of the heights, so one height is a multiple of the other.
            % Both are at least one, refused above, so the ratio is a
            % ratio and this asks only whether it is whole
            mh h ge { mh h mod }{ h mh mod } ifelse 0 ne
                { end /image cvx /typecheck signalerror } if
        } if
    } ifelse
    /minv md /Decode 2 copy known { get }{ pop pop [0 1] } ifelse
           0 get 1 eq def
    % the mask's bits are held on the mask's own grid, whatever ratio
    % stands between it and the image's
    /mrow mw 7 add 8 idiv def
    /mbits mrow mh mul string def
    il 1 eq {
        % One stream, a mask sample at the image depth before each
        % pixel's components: a row procedure de-interleaves as the
        % painter pulls, filing each mask row and yielding the data
        % row normalized (the painter reads it at eight bits).
        /st 16 dict def
        st begin
            /datasrc dd /DataSource get //.imgsource exec def
            /pend () def
            /bits bpc def
            /rowsamples w n 1 add mul def
            /rawrow rowsamples bpc mul 7 add 8 idiv string def
            /buf rowsamples string def
            /drow w n mul string def
            /iw w def /nc n def /imrow mrow def
            /imbits mbits def /iminv minv def
            /iy 0 def
        end
        w h 8 dd /ImageMatrix get
        [ st //.it1row /exec load ] cvx
        dd /Decode get n
        mbits mw mh null
    }{ il 2 eq {
        % One stream of interleave blocks, each row of mask and of
        % image padded separately to a byte boundary: the row procedure
        % files a block's mask rows and yields the raw image rows.
        /st 24 dict def
        st begin
            /datasrc dd /DataSource get //.imgsource exec def
            /pend () def
            /mraw mw 7 add 8 idiv string def
            /mpr mh h ge { mh h idiv }{ 1 } ifelse def
            /ipb h mh gt { h mh idiv }{ 1 } ifelse def
            /draw w n mul bpc mul 7 add 8 idiv string def
            /imrow mrow def
            /imbits mbits def /iminv minv def
            /iy 0 def
            /my 0 def
        end
        w h bpc dd /ImageMatrix get
        [ st //.it2row /exec load ] cvx
        dd /Decode get n
        mbits mw mh null
    }{
        % Separate streams: the whole one-bit mask is read up front,
        % row by row into the grid it states, inverted where its own
        % Decode asks for it. Nothing is resampled: the painter places
        % each device pixel against this grid, so a mask finer than the
        % image keeps the detail a reduction onto the image's grid would
        % have dropped.
        /datasrc md /DataSource get //.imgsource exec def
        /pend () def
        /rawrow mrow string def
        0 1 mh 1 sub { /my exch def
            //.fill exec
            minv {
                0 1 mrow 1 sub { /k exch def
                    mbits my mrow mul k add rawrow k get 255 xor put
                } for
            }{
                mbits my mrow mul rawrow putinterval
            } ifelse
        } for
        w h bpc dd /ImageMatrix get
        dd /image //.imgdatasource exec
        dd /Decode get n
        mbits mw mh null
    } ifelse } ifelse
    end
    /image //.imagepaintm exec
} put

%
%  width height bits/sample matrix datasrc  .  -
%                                imagedict  .  -
%  The five-operand form paints grey samples; the dictionary forms
%  paint samples in the colour space current when image is invoked:
%  ImageType 1 plainly, 3 under an explicit mask, 4 under colour-key
%  masking
%
/image [ [ /integertype /integertype /integertype /arraytype /anytype ]
         [ /dicttype ] ] {
    //.uncoloredcell /on get { /image cvx /undefined signalerror } if
    {
    dup type /dicttype eq {
        dup /ImageType get
        dup 1 eq {
            pop

            % Every entry is fetched from the image dictionary by name
            % through the dictionary itself, never as a bare name. Making
            % the dictionary current would put it above whatever the
            % program already had on the dictionary stack, and a bare
            % lookup then finds the program's own Width or Decode when
            % the image has none -- painting from a value that was never
            % part of it. A procedure source is also fetched rather than
            % looked up, since a bare lookup would run it instead of
            % handing it over. The two masked types read their entries
            % this way already.
            1 dict begin
            /d exch def
            d /Interpolate 2 copy known { get }{ pop pop false } ifelse
            dup type /booleantype eq { .gscratch /.imginterp 3 -1 roll put }{ pop } ifelse
            d //.imgextentfault exec dup null ne
                { end /image cvx exch signalerror }{ pop } ifelse
            d /Width get d /Height get
            d /BitsPerComponent get d /ImageMatrix get
            d /image //.imgdatasource exec
            d /Decode get
            end
            //.ncomponents exec //.imagepaint exec
        }{ dup 3 eq {
            pop //.imagetype3 exec
        }{ 4 eq {
            //.imagetype4 exec
        }{
            pop /image cvx /rangecheck signalerror
        } ifelse } ifelse } ifelse
    }{
        gsave
        /DeviceGray setcolorspace
        //.imgsource exec [ 0 1 ] 1 //.imagepaint exec
        grestore
    } ifelse
    } null 0 //.callout exec
} .defop

%
%  paint samples in the device space matching the component count: one
%  grey, three RGB or four CMYK components per pixel through the shared
%  painter, in its own colour space like the five-operand image. The
%  samples arrive interleaved in a single source, or with multi true from
%  one source per component, which are gathered into an array the painter
%  reads a plane at a time.
%
.xpostsys /.identdecode <<
    1 [ 0 1 ]
    3 [ 0 1 0 1 0 1 ]
    4 [ 0 1 0 1 0 1 0 1 ]
>> readonly put

%
%  The source count varies with multi and ncomp, so the effect states the
%  two operands that are always there and shows the sources as a run; how
%  many there are is the body's to check.
%
%  PLRM 4.10.2 is where the two trailing operands come from: colorimage
%  states the component count itself as ncomp, and multi says whether the
%  samples arrive interleaved from one source or from one source per
%  component -- which is why the number of sources is not fixed by the
%  signature.
%
/colorimage [ /booleantype /integertype ] {  % width height bits matrix datasrc... multi ncomp  .  -
    //.uncoloredcell /on get { /colorimage cvx /undefined signalerror } if
    {
    4 dict begin
    /nc exch def
    /msrc exch def
    nc //.identdecode exch known not {
        end /colorimage cvx /rangecheck signalerror
    } if
    msrc {
        % Gather the per-component sources into one literal array
        /srcs nc array def
        nc 1 sub -1 0 { srcs exch 3 -1 roll //.imgsource exec put } for
    }{
        /srcs exch //.imgsource exec def
    } ifelse
    gsave
    nc 4 eq { /DeviceCMYK }{
    nc 3 eq { /DeviceRGB }{ /DeviceGray } ifelse } ifelse
    setcolorspace

    % The source loads through the dictionary, never by name: an
    % executable array is a procedure and a bare lookup would run it,
    % leaving its first chunk standing in for the whole image.
    currentdict /srcs get //.identdecode nc get nc
    end
    null 0 0 null /colorimage //.imagepaintm exec
    grestore
    } null 0 //.callout exec
} .defop

%
%  paint the current colour through a one-bit stencil: samples equal to
%  the polarity mark unit squares of image space, the rest leave the
%  page untouched. Each row of samples begins on a byte boundary.
%  the runs of small stencils, resolved once per distinct mask: text
%  shown through Type 3 bitmap fonts paints the same few masks over
%  and over, and scanning their bits again for every occurrence is
%  where such jobs spend their time. Keyed by a content hash, verified
%  against the stored copy of the mask; runs of consecutive rows
%  sharing one extent merge into taller rectangles, whose union is the
%  very region the row runs cover.
%
currentglobal false setglobal
.gscratch /.stencilcache 64 dict put
setglobal

%
%  The rectangles a stencil mask covers, as a run-length reading of its
%  bits: consecutive rows sharing one extent merge into one taller
%  rectangle, so the union of what comes back is the region the set bits
%  describe. The reading itself is a function of the bits alone and is
%  compiled; what is decided here is when it need not be done again.
%
%  Answers from the cache in .gscratch where the same mask has been read
%  before. A job that paints one small stencil over and over -- which is
%  what a pattern of glyph-like marks is -- would otherwise rescan its
%  bits at every occurrence, and that is where such jobs spend their
%  time. The key is a content hash, verified against the stored copy, so
%  a collision costs a rescan rather than the wrong region.
%
.xpostsys /.stencilruns {  % buf width height ink  .  rects
    10 dict begin
    /kink exch def /kh exch def /kw exch def /kbuf exch def
    /hh kw 31 mul kh add 33 mul kink add def
    0 1 kbuf length 1 sub {
        kbuf exch get hh 33 mul add 16#FFFFFF and /hh exch def
    } for
    /found null def
    .gscratch /.stencilcache get hh 2 copy known {
        get {
            dup 0 get kw eq 1 index 1 get kh eq and
            1 index 2 get kink eq and {
                dup 3 get kbuf eq {
                    4 get /found exch def exit
                } if
            } if
            pop
        } forall
    }{ pop pop } ifelse
    found null ne {
        found
    }{
        /rects kbuf kw kh kink .stencilscan def
        .gscratch /.stencilcache get length 200 ge { .gscratch /.stencilcache 64 dict put } if
        /tuple [ kw kh kink kbuf dup length string copy rects ] def
        .gscratch /.stencilcache get hh 2 copy known {
            get [ exch aload pop tuple ]
        }{
            pop pop [ tuple ]
        } ifelse
        .gscratch /.stencilcache get hh 3 -1 roll put
        rects
    } ifelse
    end
} put

%
%  Paint a stencil: the set bits of a one-bit source take the current
%  colour and the clear bits leave the page alone, under the image-to-
%  device matrix (PLRM 8.2 imagemask).
%
%  The whole of it runs inside a gsave, because the mask installs a clip
%  of its own to paint through and the caller's clip has to come back
%  afterwards however the paint ended.
%
.xpostsys /.stencilmask {  % width height polarity mat datasrc interp  .  -
    {
    gsave
        newpath
        10 dict begin
        //.paintbind0 {exch def} forall
        /rowbytes width 7 add 8 idiv def
        /buf rowbytes height mul string def
        /bp 0 def
        {  % Collect the sample data
            bp buf length ge {exit} if

            % The source runs on the caller's stacks (see .fill)
            currentdict /datasrc get null 1 //.pcallout exec
            dup length 0 eq {pop exit} if
            dup length bp add buf length gt {
                0 buf length bp sub getinterval
            } if
            buf exch bp exch
            dup length bp add /bp exch def
            putinterval
        } loop

        % A device that consumes a whole stencil -- a writer whose output
        % language has one -- takes the bits and the image-to-device
        % matrix and paints nothing here. The runs below are how a
        % stencil reaches a device that has no such thing, and they cost
        % a mark per run: bitmap text through a vector writer comes out
        % as thousands of little paths where the language it is written
        % in could have said imagemask once.
        %
        % Offered before the matrix is concatenated, because what the
        % device wants is the matrix as the caller gave it, not the
        % state this procedure is about to put the graphics state into.
        %  Not under a pattern colour. What a device is handed here is
        %  the bits and the matrix, and what says which colour they are
        %  painted in is the graphics state -- which a pattern is not in
        %  the terms this hand-over has for one. A device given the
        %  stencil would paint it in whatever plain colour lies under
        %  the pattern, which is a silhouette where the program asked
        %  for the tiling to show through the mask.
        %
        %  The walk below already has the answer: under a pattern the
        %  runs assemble into one path and the tiling runs once over it,
        %  so the mask reaches a writer as a pattern fill of the shape
        %  the bits describe. That is one fill, not a mark per run.
        DEVICE /PaintStencil known
        //.xpostsys /.patternactive get exec not and {
            % A clip admitting nothing is not handed over, for the reason
            % an image under one is not (see .imagepaintm): what the
            % device is given is the bits and the matrix, and there is no
            % clip to write beside them that every consumer reads as
            % admitting nothing.
            //.clipvoid exec not {
                % the same transform an image is handed: sample space to
                % device space, which is the image matrix undone and the
                % current one applied
                width height polarity
                mat matrix invertmatrix matrix currentmatrix
                    matrix concatmatrix
                buf interp
                DEVICE dup /PaintStencil get exec
                true //.setpagemarked exec
            } if
        }{
        % A device that drops what it is handed is handed nothing. The
        % runs below cost a mark each and every one would go nowhere;
        % the samples above are read whatever happens, because the data
        % source is the program's procedure and what it consumes is
        % observable, so only the painting is skipped.
        DEVICE /DiscardsMarks known {
            true //.setpagemarked exec
        }{

        % Invert into a fresh matrix: the operand matrix belongs to
        % the caller, who may reuse it (a Type 3 font mutating one
        % shared matrix per glyph is the classic case).
        mat matrix invertmatrix concat
        /ink polarity {1}{0} ifelse def

        % Consecutive set samples paint as one run; under a pattern
        % colour the runs assemble into a single path so the tiling
        % runs once over the whole stencil.
        /paintpat //.xpostsys /.patternactive get exec def

        % a glyph-context stencil blends its edges when the device
        % blends text, the transform is axis-aligned, and nothing
        % clips: the coverage painter writes pixels directly.
        /aadone false def
        paintpat not
        graphicsdict /.inglyph 2 copy known { get }{ pop pop 0 } ifelse 0 gt
        interp or and
        .cliptrivial and {
            //.xpostsys /.setmarkedcolor get exec
            << /buf buf /width width /height height
               /ink ink /interp interp
               /mat matrix currentmatrix >> .stencilaa
            { /aadone true def } if
        } if
        aadone not {
        % The runs a stencil resolves into are merged and painted by
        % the compiled run-finder, whatever the stencil's size. It is
        % asked a band of rows at a time so that what it answers is
        % bounded: a mask alternating every pixel resolves a run per
        % pixel, and a whole page of that would be an array of millions
        % where a band of it is an array of thousands.
        %
        % The band is sized by area rather than by rows so that a wide
        % stencil takes fewer rows and a narrow one more, and every
        % band answers about the same number of runs.
        /bandrows width 0 gt { 16384 width idiv }{ 1 } ifelse def
        bandrows 1 lt { /bandrows 1 def } if
        paintpat { newpath } if
        0 bandrows height 1 sub { /by exch def
            /bh height by sub def
            bh bandrows gt { /bh bandrows def } if
            /rects buf by rowbytes mul bh rowbytes mul getinterval
                   width bh ink //.stencilruns exec def
            rects length 0 gt {
                % The band's rectangles go over together. They are the
                % same rectangles either way, and the whole band is one
                % pass through the scan converter where a rectangle at a
                % time was a pass each -- with the path built, filled and
                % thrown away again for every one of them.
                %
                % A band counts its rows from its own first, so the space
                % is moved to the band rather than each rectangle being
                % moved into the page's. The current path is the caller's
                % under a pattern colour, and a matrix put back by hand
                % leaves it standing where a grestore would drop it.
                /cm matrix currentmatrix def
                0 by translate
                paintpat {
                    0 4 rects length 1 sub { /i exch def
                        rects i get  rects i 1 add get
                        rects i 2 add get  rects i 3 add get
                        /rh exch def /rw exch def /ry exch def /rx exch def
                        rx ry moveto rx rw add ry lineto
                        rx rw add ry rh add lineto rx ry rh add lineto closepath
                    } for
                }{
                    rects rectfill
                } ifelse
                cm setmatrix
            } if
        } for
        paintpat { //.xpostsys /.patternfill get exec } if
        } if
        } ifelse
        } ifelse
        end
    grestore
    } null 0 //.callout exec
} put

%
%  width height polarity matrix datasrc  .  -
%                             maskdict  .  -
%  The dictionary form (ImageType 1) states its polarity through
%  Decode: [1 0] paints where the sample is one, as operand polarity
%  true does; [0 1] paints the zeroes.
%
/imagemask [ [ /integertype /integertype /booleantype /arraytype /anytype ]
             [ /dicttype ] ] {
    dup type /dicttype eq {
        % As in image: every entry comes from the dictionary by name and
        % none as a bare name, so a stencil missing a required entry
        % cannot be completed from whatever the program had on the
        % dictionary stack. ImageType leaked that way too, which meant a
        % program defining it for its own purposes could get a stencil out
        % of a dictionary that named no type at all.
        1 dict begin
        /d exch def
        d /ImageType get 1 ne { end /imagemask cvx /rangecheck signalerror } if

        % PLRM Table 4.20 states three things of a stencil that the path
        % below has no way to honour: one bit to a sample, one data source,
        % and a Decode that is exactly [0 1] or [1 0]. The path is wired to
        % one bit and reads a single source, so a dictionary saying anything
        % else is not painted the way it asked -- it is painted the only way
        % there is, and the difference is silent. Each is asked for here.
        %
        % A sample is one bit. The entry is required, so its absence is
        % undefined and a width that is not one is out of range: two faults,
        % two answers.
        d /BitsPerComponent 2 copy known not
            { pop pop end /imagemask cvx /undefined signalerror } if
        get 1 ne { end /imagemask cvx /rangecheck signalerror } if

        % Decode says which way round the mask reads, and only its first
        % element is consulted below. A Decode of another length describes
        % something this cannot express, and the first element alone would
        % quietly stand for the whole of it.
        d /Decode get length 2 ne
            { end /imagemask cvx /rangecheck signalerror } if
        d //.imgextentfault exec dup null ne
            { end /imagemask cvx exch signalerror }{ pop } ifelse
        d /Width get d /Height get
        d /Decode get 0 get 0 ne
        d /ImageMatrix get
        d /imagemask //.imgdatasource exec
        d /Interpolate 2 copy known { get }{ pop pop false } ifelse
        dup type /booleantype ne { pop false } if
        end
    }{
        //.imgsource exec false
    } ifelse
    //.stencilmask exec
} .defop

end end end

%
%  The image types this file implements, as PLRM Table 3.8 has a program ask
%  after them (see the note in shade.ps). 1 is the plain image and the
%  stencil mask, 3 the explicitly masked image, 4 the colour-keyed one.
%
currentglobal true setglobal
[ 1 3 4 ] { dup /ImageType defineresource pop } forall
setglobal

//.internaldict /QUIET known { }{ (eof paint.ps\n)print } ifelse
