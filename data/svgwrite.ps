%!PS
%
% svgwrite.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The svgwrite device: emit an SVG document from the recorded page.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading svgwrite.ps...)print } ifelse

currentdict .xpostsys begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  Make an instance of the SVG writer: the class copied, with the extent
%  it is asked for written onto the copy.
%
%  This is the maker the page-device machinery reaches: init.ps files it
%  in .devicemakers under the name a -d option or a setpagedevice
%  request selects the device by, and calls it through privatedict.
%
.privatedict /newSVGWRITEdevice {  % width height  .  IMAGE-device-dict
    .privatedict /.xpost_SVGWRITE get dup /Create get exec
} put

%
%  .xpost_SVGWRITE writes a single-page vector SVG: the marking methods append
%  path and rect elements and Emit wraps them in the document structure.
%  A sibling of the .xpost_PDFWRITE device sharing its content accumulator (the
%  .pdfinit/.pdfput/.pdfchunks/.pdffree ops are format-agnostic); only
%  the emitted syntax differs. Device coordinates are y-down, as SVG's
%  are, so they pass through unchanged -- no device-matrix prefix.
%
%  Emit reports the page size in points (unscaling the device resolution
%  from the defaultmatrix fixup, as the bbox device does) with a viewBox
%  in device units, so any HWResolution yields the same physical page.
%
%  A method runs its body with the device dictionary current, and opens it
%  through the bracket that takes it off again however the body ends, error
%  included (.indict, callout.ps).
%
/.xpost_SVGWRITE <<
    /nativecolorspace /DeviceRGB
    /dimensions [0 0]
    /NoOutput true  % Keep this device's own vector FillPoly (no rasterizing)
    /VectorGlyphs true   % Text operators emit glyph outlines, not bitmaps
    /VectorSyntax /svg   % ... spelled as SVG path data

    /.copydict //.classcopydict

    /Create {  % width height IMAGE  .  IMAGE'
    { {/height /width}{exch def}forall

    % The page dimensions are points and need not be integral; adopt the
    % exact values when the page device machinery published them.
    //.adoptexactpage exec
    currentdict } //.indict exec
    dup /.copydict get exec
    {
        currentdict //.internaldict /.pdfinit get exec    % Create the content accumulator (outside VM)

        % Where the identities written into the document are counted
        % from. A clipPath is referenced by identity, so no two of them
        % in one document may be named alike; and what has been written
        % cannot be taken back, since the accumulator above is not
        % virtual memory. A counter that a restore reaches would be wound
        % back under the elements already written and hand their numbers
        % out again, and a reference then resolves to whichever element
        % came first -- a fill cut by another clip's shape, with nothing
        % raised and a well formed document. So the counter is kept in
        % global memory, which a restore of local memory does not reach,
        % as the vector output record is (data/pdfwrite.ps). It is held
        % here rather than shared, so each device counts its own document
        % and two of them open at once cannot take each other's numbers.
        currentglobal true setglobal
        /.svgids 1 dict def
        setglobal
        .svgids /clipid 0 put
        .svgids /maskid 0 put
        /.svgmasks 64 dict def  % masks already written, so a repeated glyph is written once
    currentdict
    } //.indict exec } bind

    /Destroy {  % IMAGE  .  -
        dup //.internaldict /.pdffree get exec pop
    } bind

    % Append a string to the content accumulator (held outside VM via /Private)
    /.put {  % str  .  -
        currentdict //.internaldict /.pdfput get exec
    } bind

    % Append a number in SVG syntax (integer, or two decimals; never
    % exponential), through the vector writers' shared formatter.
    /.svgnum {  % num  .  -
        //.num2str exec .put
    } bind

    % Append a colour as an rgb() percentage triple, quoted
    /.svgrgb {  % r g b  .  -
        ("rgb\() .put
        3 -1 roll 100 mul .svgnum (%,) .put
        exch 100 mul .svgnum (%,) .put
        100 mul .svgnum (%\)") .put
    } bind

    /PutPix {  % r g b x y IMAGE  .  -
    { {y x b g r}{exch def}forall
        (<rect fill=) .put r g b .svgrgb
        ( x=") .put x .svgnum (" y=") .put y .svgnum
        (" width="1" height="1"/>\n) .put
    } //.indict exec }

    /GetPix {  % x y IMAGE  .  r g b
        pop pop pop  0 0 0
    }

    /DrawLine {  % r g b x1 y1 x2 y2 IMAGE  .  -
    { {y2 x2 y1 x1 b g r}{exch def}forall
        (<path fill="none" stroke=) .put r g b .svgrgb
        ( d="M) .put x1 .svgnum ( ) .put y1 .svgnum
        (L) .put x2 .svgnum ( ) .put y2 .svgnum ("/>\n) .put
    } //.indict exec }

    /DrawRect {  % r g b x y w h IMAGE  .  -
    { {h w y x b g r}{exch def}forall
        (<rect fill="none" stroke=) .put r g b .svgrgb
        ( x=") .put x .svgnum (" y=") .put y .svgnum
        (" width=") .put w .svgnum (" height=") .put h .svgnum ("/>\n) .put
    } //.indict exec }

    % The operands name an inclusive pixel span and an SVG rect is
    % half-open, so the rect that covers the pixels a raster device
    % would paint is one unit wider and taller (the driver contract,
    % src/lib/xpost_dev_driver.h). Emitting w and h unchanged left this
    % device painting a rect a pixel short in each direction of every
    % other device's.
    /FillRect {  % r g b x y w h IMAGE  .  -
    { {h w y x b g r}{exch def}forall
        w 0 lt { /x x w add def /w w neg def } if
        h 0 lt { /y y h add def /h h neg def } if
        (<rect fill=) .put r g b .svgrgb
        ( x=") .put x .svgnum (" y=") .put y .svgnum
        (" width=") .put w 1 add .svgnum
        (" height=") .put h 1 add .svgnum ("/>\n) .put
    } //.indict exec }

    % Append one path element: the fill colour, the subpaths as M/L
    % commands each closed with Z, and a nonzero fill rule. The
    % per-coordinate formatting is the hot loop, so it is done in C
    % (.svgfillpoly), appending to the accumulator.
    /FillPoly {  % r g b polygon IMAGE  .  -
        //.internaldict /.svgfillpoly get exec
    } bind

    % Append collected path elements (coordinates then a /m /l /c /h
    % name each, from the .devpathforall walker) as SVG path commands
    % Walk the device path and append its path-data commands as they are
    % reached -- Mx y, Lx y, C and the six control points, Z -- returning
    % how many elements it wrote. The path was built whole as an array
    % first and handed to a collector, so a path of more elements than an
    % array holds overran it and aborted the job on every vector device,
    % where the fill of the same path did not; the same bytes are written
    % here, only without the array between the walk and the output.
    /.emitdevpath {  % -  .  n
        /.dpstr //.xpostsys /.cpath get exec def
        /.dpoff 0 def
        /.dpn 0 def
        {
            .dpstr .dpoff .pathnext not { exit } if
            /.dpoff exch def
            dup 2 eq {
                pop
                {spy3 spx3 spy2 spx2 spy1 spx1}{exch def}forall
                (C) .put
                spx1 .svgnum ( ) .put spy1 .svgnum ( ) .put
                spx2 .svgnum ( ) .put spy2 .svgnum ( ) .put
                spx3 .svgnum ( ) .put spy3 .svgnum
            }{
                dup 3 eq {
                    pop (Z) .put
                }{
                    /spcmd exch def
                    spcmd 0 eq { (M) }{ (L) } ifelse .put
                    exch .svgnum ( ) .put .svgnum
            } ifelse } ifelse
            /.dpn .dpn 1 add def
        } loop
        .dpn
    } bind

    % Count the device path's elements without emitting or collecting them,
    % so the stroke emitter can tell an empty path from one to draw before
    % it walks the path to draw it.
    /.pathelems {  % -  .  n
        /.pcstr //.xpostsys /.cpath get exec def
        /.pcoff 0 def
        /.pcn 0 def
        {
            .pcstr .pcoff .pathnext not { exit } if
            /.pcoff exch def
            dup 2 eq { pop 6 { pop } repeat }
            { dup 3 eq { pop }{ pop pop pop } ifelse }
            ifelse
            /.pcn .pcn 1 add def
        } loop
        .pcn
    } bind

    % Take a whole sampled image as an embedded bitmap: the samples
    % decode to rgb, pack as a bottom-up 24-bit BMP, and ride a base64
    % data URI under the image-to-device matrix.
    /PaintImage {  % w h ncomp mat rows decode interp IMAGE  .  -
    { {siint sidec sirows sim sinc sih siw}{exch def}forall

        % Per-component decode tables to bytes
        /siluts [ 0 1 sinc 1 sub { /c exch def
            /silt 256 string def
            0 1 255 { /v exch def
                silt v
                v 255 div
                sidec c 2 mul 1 add get sidec c 2 mul get sub mul
                sidec c 2 mul get add
                //.xpostsys /.c255 get exec
                put
            } for silt
        } for ] def
        % PNG where this build can write one, since that is a format a
        % reader of this document is required to have (SVG 1.1 4.6), and
        % the bitmap below where it cannot: a document with a picture
        % some readers show beats one with no picture at all.
        [ 0 1 sih 1 sub { /y exch def
            /sr sirows y get def
            /sipr siw 3 mul string def
            0 1 siw 1 sub { /x exch def
                sinc 1 eq {
                    /sv siluts 0 get sr x get get def
                    sipr x 3 mul sv put
                    sipr x 3 mul 1 add sv put
                    sipr x 3 mul 2 add sv put
                }{ sinc 4 eq {
                    /sk siluts 3 get sr x 4 mul 3 add get get def
                    sipr x 3 mul
                        255 siluts 0 get sr x 4 mul get get sk add
                        dup 255 gt { pop 255 } if sub put
                    sipr x 3 mul 1 add
                        255 siluts 1 get sr x 4 mul 1 add get get sk add
                        dup 255 gt { pop 255 } if sub put
                    sipr x 3 mul 2 add
                        255 siluts 2 get sr x 4 mul 2 add get get sk add
                        dup 255 gt { pop 255 } if sub put
                }{
                    sipr x 3 mul       siluts 0 get sr x 3 mul get get put
                    sipr x 3 mul 1 add siluts 1 get sr x 3 mul 1 add get get put
                    sipr x 3 mul 2 add siluts 2 get sr x 3 mul 2 add get get put
                } ifelse } ifelse
            } for
            sipr
        } for ]
        siw sih //.internaldict /.pngencode get exec
        {
            /sipng exch def
            (<image transform="matrix\() .put
            sim 0 get .svgnum (,) .put sim 1 get .svgnum (,) .put
            sim 2 get .svgnum (,) .put sim 3 get .svgnum (,) .put
            sim 4 get .svgnum (,) .put sim 5 get .svgnum
            (\)" x="0" y="0" width=") .put siw .svgnum
            (" height=") .put sih .svgnum
            (" preserveAspectRatio="none" image-rendering=") .put
            siint { (auto") }{ (pixelated") } ifelse .put
            ( xlink:href="data:image/png;base64,) .put
            sipng { //.internaldict /.base64 get exec .put } forall
            ("/>\n) .put
        }{

        /sipad siw 3 mul 3 add cvi 4 idiv 4 mul siw 3 mul sub def
        /sirowb siw 3 mul sipad add def
        /sisz 54 sirowb sih mul add def
        (<image transform="matrix\() .put
        sim 0 get .svgnum (,) .put sim 1 get .svgnum (,) .put
        sim 2 get .svgnum (,) .put sim 3 get .svgnum (,) .put
        sim 4 get .svgnum (,) .put sim 5 get .svgnum
        (\)" x="0" y="0" width=") .put siw .svgnum
        (" height=") .put sih .svgnum
        (" preserveAspectRatio="none" image-rendering=") .put
        siint { (auto") }{ (pixelated") } ifelse .put
        % Referred to through the xlink namespace, which is where the
        % version this document declares puts it. The bare href a later
        % version allows is read by some viewers and passed over by
        % others, and a viewer that passes over it leaves the picture
        % out of a document it otherwise reads whole.
        ( xlink:href="data:image/bmp;base64,) .put

        % Header: BITMAPFILEHEADER + BITMAPINFOHEADER, little-endian
        /sihdr 54 string def
        /sip 0 def
        /sb1 {  % byte  .  -
            sihdr sip 3 -1 roll put /sip sip 1 add def
        } def
        /sb2 {  % n  .  -
            dup 256 mod sb1 256 idiv sb1
        } def
        /sb4 {  % n  .  -
            dup 65536 mod sb2 65536 idiv sb2
        } def
        66 sb1 77 sb1 sisz sb4 0 sb4 54 sb4
        40 sb4 siw sb4 sih sb4 1 sb2 24 sb2 0 sb4
        sirowb sih mul sb4 2835 sb4 2835 sb4 0 sb4 0 sb4

        % Accumulate bmp bytes into 48000-byte chunks and base64 each;
        % a partial flush keeps a three-byte alignment so the padding
        % appears only at the very end.
        /sibuf 48000 string def
        /sibp 0 def
        /siflush {  % -  .  -
            /sic sibp 3 idiv 3 mul def
            sic 0 gt {
                sibuf 0 sic getinterval //.internaldict /.base64 get exec .put
                sibuf 0 sibuf sic sibp sic sub getinterval putinterval
                /sibp sibp sic sub def
            } if
        } def
        /siput {  % str  .  -
            dup length sibp add 48000 gt { siflush } if
            sibuf sibp 2 index putinterval
            length sibp add /sibp exch def
        } def
        sihdr siput
        /sirow sirowb string def
        sih 1 sub -1 0 { /y exch def
            /sr sirows y get def
            0 1 siw 1 sub { /x exch def
                sinc 1 eq {
                    /sv siluts 0 get sr x get get def
                    sirow x 3 mul sv put
                    sirow x 3 mul 1 add sv put
                    sirow x 3 mul 2 add sv put
                }{ sinc 4 eq {
                    /sk siluts 3 get sr x 4 mul 3 add get get def
                    sirow x 3 mul
                        255 siluts 2 get sr x 4 mul 2 add get get sk add
                        dup 255 gt { pop 255 } if sub put
                    sirow x 3 mul 1 add
                        255 siluts 1 get sr x 4 mul 1 add get get sk add
                        dup 255 gt { pop 255 } if sub put
                    sirow x 3 mul 2 add
                        255 siluts 0 get sr x 4 mul get get sk add
                        dup 255 gt { pop 255 } if sub put
                }{
                    sirow x 3 mul siluts 2 get sr x 3 mul 2 add get get put
                    sirow x 3 mul 1 add siluts 1 get sr x 3 mul 1 add get get put
                    sirow x 3 mul 2 add siluts 0 get sr x 3 mul get get put
                } ifelse } ifelse
            } for
            sirow siput
        } for
        sibp 0 gt { sibuf 0 sibp getinterval //.internaldict /.base64 get exec .put } if
        /sibp 0 def
        ("/>\n) .put
        } ifelse
    } //.indict exec }

    % Take a stencil. SVG has no stencil of its own, so the bits go in
    % as a mask -- an image whose light samples are the ones that let
    % paint through -- and the paint is a rectangle of the current
    % colour drawn through it. That is one element and one image per
    % distinct stencil, against the fill per run of set samples a device
    % without this is painted through: a page of bitmap glyphs came out
    % as thousands of little rectangles.
    %
    % The mask is written once and referred to again. Its content is in
    % the user space of whatever refers to it, and each placement refers
    % from under its own matrix with the stencil at the same place in
    % it, so one mask serves every placement of the same bits.
    /PaintStencil {  % w h polarity mat data interp DEVICE  .  -
    { {smint smdata smm smpol smh smw}{exch def}forall

        % keyed by a sum over the bits, held inside sixteen bits so the
        % running total cannot leave the integers, and the candidate
        % compared in full so a collision costs a comparison
        /smkey 0 def
        0 1 smdata length 1 sub {
            smdata exch get smkey 31 mul add 16#ffff and /smkey exch def
        } for
        /smkey smkey smw 131 mul add smh 17 mul add
               smpol { 1 add } if 16#ffff and def
        /smid -1 def
        .svgmasks smkey known {
            .svgmasks smkey get {
                aload pop /smcd exch def /smch exch def
                /smcw exch def /smcp exch def /smci exch def
                smid 0 lt smcw smw eq and smch smh eq and
                smcp smpol eq and smcd smdata eq and
                    { /smid smci def } if
            } forall
        } if

        smid 0 lt {
            /smid .svgids /maskid get def
            .svgids /maskid smid 1 add put
            .svgmasks smkey
                .svgmasks smkey known { .svgmasks smkey get }{ [ ] } ifelse
                [ exch aload pop [ smid smpol smw smh smdata ] ] put

            /smstride smw 7 add 8 idiv def

            % The mask holds a path and not an image. A raster would have
            % to be embedded as one of the formats a viewer is required
            % to have, and the one this device embeds a sampled image as
            % is not among them (SVG 1.1 4.6: PNG and JPEG are the
            % required ones), so a stencil written that way would go
            % blank in a viewer that reads the rest of the document
            % perfectly well. A path of the set samples is understood
            % everywhere, and what makes this worth doing is not the
            % encoding but that it is written once however many times
            % the stencil is painted.
            (<mask id="xm) .put smid 20 string cvs .put
            (" maskUnits="userSpaceOnUse" x="0" y="0" width=") .put smw .svgnum
            (" height=") .put smh .svgnum
            ("><path fill="rgb\(100%,100%,100%\)" d=") .put
            0 1 smh 1 sub { /smy exch def
                /smx 0 def
                { smx smw ge { exit } if
                    % the next run of samples the stencil paints
                    { smx smw ge { exit } if
                      smdata smy smstride mul smx 8 idiv add get
                      7 smx 7 and sub neg bitshift 1 and
                      smpol { 1 eq }{ 0 eq } ifelse { exit } if
                      /smx smx 1 add def
                    } loop
                    smx smw ge { exit } if
                    /smrs smx def
                    { smx smw ge { exit } if
                      smdata smy smstride mul smx 8 idiv add get
                      7 smx 7 and sub neg bitshift 1 and
                      smpol { 1 eq }{ 0 eq } ifelse not { exit } if
                      /smx smx 1 add def
                    } loop
                    (M) .put smrs .svgnum ( ) .put smy .svgnum
                    (L) .put smx .svgnum ( ) .put smy .svgnum
                    (L) .put smx .svgnum ( ) .put smy 1 add .svgnum
                    (L) .put smrs .svgnum ( ) .put smy 1 add .svgnum (Z) .put
                } loop
            } for
            ("/></mask>\n) .put
        } if

        % the paint: a rectangle of the state's colour through the mask
        /smg graphicsdict /currgstate get def
        (<g transform="matrix\() .put
        smm 0 get .svgnum (,) .put smm 1 get .svgnum (,) .put
        smm 2 get .svgnum (,) .put smm 3 get .svgnum (,) .put
        smm 4 get .svgnum (,) .put smm 5 get .svgnum
        (\)"><rect x="0" y="0" width=") .put smw .svgnum
        (" height=") .put smh .svgnum
        (" fill=) .put
        smg /colorcomp1 get smg /colorcomp2 get smg /colorcomp3 get .svgrgb
        ( mask="url\(#xm) .put smid 20 string cvs .put
        (\)"/></g>\n) .put
    } //.indict exec }

    % r g b IMAGE . -  ; fill the current path as one path element with
    % curves preserved (the flattening fill goes through FillPoly
    % instead), subpaths closed implicitly by the nonzero fill rule --
    % the rule the flattening fill applies. The per-element formatting
    % walks the path in C (.svgfillpath), appending to the accumulator,
    % so subpath count costs no operand stack.
    /FillPath {  % r g b IMAGE  .  -
        dup 5 1 roll            % Keep the device for the clip close below
        //.internaldict /.svgfillpath get exec

        % a clip adopted for this fill ends with it
        {
            currentdict /.svgclipopen 2 copy known { get }{ pop pop false } ifelse {
                (</g>\n) .put
                /.svgclipopen false def
            } if
        } //.indict exec
    } bind

    % clippath IMAGE . -  ; adopt a clip shape the interpreter could not
    % reduce to a rectangle, as a clipPath the fill's group references.
    % Without this the fill would be cut to pixel-band spans before
    % reaching the device and arrive as one path per scanline; the shape
    % costs one element and keeps its curves.
    /ClipPath {  % path IMAGE  .  -
    {
        % The next identity this document has not used: the counter is
        % the one made at Create, which a restore does not reach.
        currentdict /.svgids get /clipid 2 copy get 1 add put
        /.svgcid currentdict /.svgids get /clipid get def

        % The path walker reads the current path, so install the clip
        % shape for the walk and put the working path back after.
        graphicsdict /currgstate get /currpath get
        exch
        graphicsdict /currgstate get exch /currpath exch put
        (<clipPath id="xc) .put .svgcid 20 string cvs .put ("><path d=") .put
        .emitdevpath pop
        ("/></clipPath>\n) .put
        (<g clip-path="url\(#xc) .put .svgcid 20 string cvs .put (\)">\n) .put
        graphicsdict /currgstate get exch /currpath exch put
        /.svgclipopen true def
    } //.indict exec } bind

    % r g b IMAGE . -  ; stroke the current path as one path element with
    % the device-space line width and the graphics state's cap, join and
    % miter limit, so joints between segments are drawn by the consumer
    % rather than lost to per-segment strokes. The path is collected
    % first (the walker runs in its own dictionary, away from this
    % device's methods) and emitted afterwards.
    /StrokePath {  % r g b IMAGE  .  -
    { {spb spg spr}{exch def}forall
        .pathelems 0 gt {
            (<path fill="none" stroke=) .put spr spg spb .svgrgb
            ( stroke-width=") .put
            currentlinewidth 0 dtransform dup mul exch dup mul add sqrt
            .svgnum
            (" stroke-linecap=") .put
            currentlinecap dup 0 eq { pop (butt) }{ 1 eq { (round) }{ (square) } ifelse } ifelse .put
            (" stroke-linejoin=") .put
            currentlinejoin dup 0 eq { pop (miter) }{ 1 eq { (round) }{ (bevel) } ifelse } ifelse .put
            (" stroke-miterlimit=") .put
            currentmiterlimit .svgnum
            (" d=") .put
            .emitdevpath pop
            ("/>\n) .put
        } if
    } //.indict exec }

    /Emit {  % IMAGE  .  -
    {
        % An SVG document holds one page, so successive pages are written
        % to separate files: the name settled for this page carries the
        % page number where the output name has a %d, and without one
        % every page rewrites the same file.
        /F .outputfile (w) file def
        /.w {  % str  .  -
            F exch writestring
        } def

        % page size in points: unscale the device resolution carried in
        % the defaultmatrix fixup; a raw 1:1 device is unaffected.
        currentdict //.xpostsys /.devres-to-points get exec
        /sy exch def /sx exch def

        (<?xml version="1.0" encoding="UTF-8"?>\n) .w
        % The xlink namespace is declared because an image refers to its
        % content through it. This document says it is SVG 1.1, and that
        % is where 1.1 puts the reference; the bare href a later version
        % allows is read by some viewers and passed over by others, which
        % leaves the picture out of a document they otherwise read whole.
        (<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width=") .w
        /.wnum {  % num  .  -
            //.num2str exec .w
        } def
        width sx div .wnum (pt" height=") .w
        height sy div .wnum (pt" viewBox="0 0 ) .w
        width .wnum ( ) .w height .wnum (">\n) .w

        currentdict //.internaldict /.pdfchunks get exec { .w } forall

        (</svg>\n) .w
        F (%stdout) (w) file ne { F closefile } if

        % start the next page fresh: showpage's page clear and later
        % marks must not stack on the emitted content (a later Emit
        % rewrites the output with the then-current page).
        currentdict //.internaldict /.pdfreset get exec

        % and with it the identities, since a document holds one page and
        % an identity need only be unique within the document it is
        % written into. Counting from the same place for each of them is
        % what keeps a page's output the same wherever it falls in a job.
        currentdict /.svgids get /clipid 0 put
    } //.indict exec }
>> def

end end

//.internaldict /QUIET known { }{ (eof svgwrite.ps\n)print } ifelse
