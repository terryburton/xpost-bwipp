%!PS
%
% err.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The error dictionaries, installed from init.ps.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading err.ps...\n) print } ifelse

currentglobal
false setglobal
userdict begin

/$error 16 dict def
$error begin
    /ostackarray null def
    /newerror false def
    /command null def
    /errorname null def
    /initializing true def

    % The standard entries an error dictionary carries: whether
    % an error records the stacks into $error (settable to skip the
    % snapshot), and the extra context certain errors leave behind.
    /recordstacks true def
    /errorinfo null def
    /ostack null def
    /estack null def
    /dstack null def

    % Whether the standard handler reports an error as a binary object
    % sequence rather than as text; the sequence needs binary encoding
    % to be enabled as well.
    /binary false def
end

//.internaldict /QUIET known { }{ ($error installed...)print } ifelse

%
%  Record an error in $error, hand it to the handler, and stop.
%
%  The local error hook. It is anchored in privatedict, off the
%  dictionary stack, and reached as .privatedict /.error get exec: by
%  signalerror below, and by every name in the errordict table below
%  that, each of which bakes it in by immediate evaluation as the table
%  is built.
%
%  It runs in local VM and records into the local $error, which is why it
%  lives here rather than with the language in systemdict.
%
%  It does not return. The last thing it does is stop, so what called it
%  is unwound and the caller's own error handling sees the error.
%
/.error {  % command errorname  .  -
    false setglobal
    //$error exch /errorname exch put
    //$error exch /command exch put

    % An operator leaves nothing behind when it refuses. The stacks go
    % back to their depths at the innermost live wrapped call, which for
    % an operator written in PostScript drops what its body had pushed
    % before it signalled -- values a program never made, and for the
    % machinery's own operators structures it has no business holding.
    % Taken before the snapshot below, so $error records the stacks a
    % handler will actually find. Captured here rather than named,
    % because the name moves off the dictionary stack later.
    //.errorunwind
    //$error /newerror true put
    //$error /errorname get /VMerror ne
    //$error /recordstacks get and {
        //$error /ostackarray get null eq {
            //$error /estackarray 600 array put
            //$error /ostackarray 1000 array put
            //$error /dstackarray 50 array put
        } if

        % The snapshots must never raise inside the error machinery itself:
        % clamp each stack to its snapshot array's capacity. A clamped
        % operand snapshot keeps the topmost entries only; the deeper
        % entries stay on the stack and survive the aload round-trip.
        count dup //$error /ostackarray get length gt {
            pop //$error /ostackarray get length
        } if
        //$error /ostackarray get exch 0 exch getinterval astore
        //$error exch /ostack exch put
        countdictstack //$error /dstackarray get length le {
            //$error /dstack //$error /dstackarray get dictstack put
        } {
            //$error /dstack null put
        } ifelse
        countexecstack //$error /estackarray get length le {
            //$error /estack //$error /estackarray get execstack
            dup length 2 sub 0 exch getinterval put  % Trim 1:{ //$err... 2:{ //$err... execstack
        } {
            //$error /estack null put  % Too deep to snapshot
        } ifelse
        //$error /ostack get aload pop
    } if
    //$error /initializing get {
        handleerror
    } if
    //$error /errorname get dup /stackoverflow eq { clear }{
        /dictstackoverflow eq {
            end end
        } if
    } ifelse
    stop
} def

%
%  signalerror is the standard operator programs call to raise an error; it
%  belongs in systemdict, so it is global and relocates there. The private
%  .error hook stays local (it runs the handler in local VM and records into
%  the local $error). It lives in privatedict, off the dict stack, reached
%  through the .privatedict operator; a global procedure may use the result
%  transiently. Mirror it in now so an error during graphics loading still
%  finds it; .finalize drops the userdict anchor.
%
.privatedict /.error userdict /.error get put

%
%  signalerror is a global operator and belongs with the language, so the
%  block the local error dictionaries need closes around it. errordict
%  below takes its value, so it has to be defined before that.
%
end
currentglobal true setglobal

%
%  Raise an error the way a program does (PLRM 8.2): the object that
%  failed and the name of the error, and the interpreter takes it from
%  there.
%
%  It is a thin call to the local .error hook, which is where the work
%  is. The operator has to be global because it belongs to the language
%  and lives in systemdict; the hook has to be local because it records
%  into the local $error, so the two cannot be one procedure.
%
/signalerror {  % any errorname  .  -
    .privatedict /.error get exec
} def
setglobal
userdict begin
//.internaldict /QUIET known { }{ (.error installed...)print } ifelse

/errordict 32 dict def
errordict begin
    /signalerror /signalerror load def

    % Report the error $error is holding, in the way PLRM 3.11.1 asks:
    % the message a program sees when nothing of its own caught the
    % error. The systemdict operator of the same name, at the foot of
    % this file, is what a program reaches; it fetches this one.
    %
    % It answers nothing and takes nothing: what it reports it reads out
    % of $error, which .error filled before it stopped.
    /handleerror {  % -  .  -
        %traceon
        //$error begin
            newerror {
                /newerror false def

                % A binary object sequence when one is asked for and
                % binary encoding is enabled: a four element array under
                % tag 250 carrying the class of error, its name, what
                % was executing, and a boolean.
                currentdict /binary known { binary }{ false } ifelse
                currentobjectformat 0 ne and {
                    [ /Error errorname
                      /command load dup type
                      dup /nulltype eq exch
                      dup /integertype eq exch
                      dup /realtype eq exch
                      dup /nametype eq exch
                      dup /booleantype eq exch
                      dup /stringtype eq exch
                          /arraytype eq
                      or or or or or or not {
                          % An operator, or anything else no sequence
                          % can carry, stands in as its name.
                          128 string cvs cvn
                      } if
                      false ]
                    250 printobject
                    flush
                    /errorinfo null def
                }{
                (%%[ Error: ) print
                errorname //=print exec
                (; OffendingCommand: ) print
                /command load //=print exec
                ( ]%%\n) print

                % A program may raise an error by setting newerror,
                % errorname and errorinfo in $error directly and then
                % executing stop, without passing through .error: the
                % stack snapshots are absent in that case.
                currentdict /errorinfo known {
                    errorinfo null ne {
                        (Additional information: ) print
                        errorinfo ==
                    } if
                } if

                % A snapshot entry is present and null wherever the error
                % recorded no stack: $error defines all three, .error
                % skips the whole snapshot for VMerror (PLRM 8.2: the
                % default handler for that error, alone among them, does
                % not snapshot the stacks) and leaves an individual entry
                % null where the stack was too deep for its array. So the
                % value is what says whether there is a stack to print;
                % the key is there either way, and a heading printed on
                % the strength of the key alone is followed by a
                % typecheck that ends the report.
                currentdict /ostack known {
                    ostack null ne {
                        (Stack:\n) print
                        ostack { == } forall
                    } if
                } if
                currentdict /estack known {
                    estack null ne {
                        (ExecStack:\n) print
                        estack { == } forall
                    } if
                } if
                flush

                % The context belongs to the error just reported
                /errorinfo null def
                } ifelse
            } if
        end
    } def

    % The errors a program can catch, each named once. The standard
    % handler is the same procedure for all of them -- name the error,
    % run .error, which records it in $error and stops -- so it is built
    % from the name rather than written out again beside every name.
    % Adding an error here is adding it to this list.
    %
    % tests/check-error-names.sh holds the list to the interpreter's own
    % error enumeration, ERRORS in src/lib/xpost_error.h, so a name the C
    % side gains cannot be left without a handler and a name it loses
    % cannot be left with one.
    [ /dictfull /dictstackoverflow /dictstackunderflow
      /execstackoverflow /execstackunderflow
      /invalidaccess /invalidcontext /invalidexit /invalidfileaccess /invalidfont
      /invalidrestore /ioerror /limitcheck /nocurrentpoint /rangecheck
      /stackoverflow /stackunderflow /syntaxerror /typecheck
      /undefined /undefinedfilename /undefinedresource /undefinedresult
      /unmatchedmark /unregistered /unknownerror /VMerror ]
    { dup [ 3 -1 roll //.error /exec cvx ] cvx def } forall

    % Two errors are initiated by events outside the interpreter, and
    % PLRM 3.11.1 has it omit steps 1 and 2 for them: it neither restores
    % the operand stack nor pushes the object being executed, so neither
    % handler has an object below it to report as the command. interrupt
    % reports nothing and stops; timeout names itself in the command's
    % place. Anywhere else the doubled name would be a typo.
    /interrupt {  % -  .  -
        stop
    } def
    /timeout {  % -  .  -
        /timeout /timeout //.error exec
    } def
end
//.internaldict /QUIET known { }{ (errordict installed...)print } ifelse

end
setglobal

currentglobal true setglobal

%
%  handleerror is a global operator in systemdict that calls the procedure
%  of the same name in errordict, so it is defined out here rather than
%  inside the userdict block the local error dictionaries needed.
%
/handleerror {  % -  .  -
    errordict /handleerror get exec
} def
setglobal

//.internaldict /QUIET known { }{ (\neof err.ps\n)print } ifelse
