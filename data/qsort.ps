%!PS
%
% qsort.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% Quicksort for comparable base types; exports one procedure.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  The file exports one name into the private .xpostsys namespace, in
%  global VM. Everything else it defines -- partition, quicksort, and the
%  cmp slot they share -- lives in qsortdict, which qsort opens around the
%  whole sort and closes after it, so none of it is reachable between
%  sorts and none of it can be taken by a definition of the program's own.
%
.xpostsys /qsort known { currentfile flushfile } if

currentglobal true setglobal
7 dict begin
/qsortdict currentdict def

%
%  Move the elements that compare below the pivot to the front of the
%  range and answer where the boundary fell.
%
%  A helper of quicksort below and of nothing else. It reads cmp by name
%  out of qsortdict, so it runs only while that dictionary is current --
%  which is to say only inside a qsort, never on its own.
%
%  The exchange is .swap, a private C operator that bind freezes into
%  this body as the file loads. That timing is the whole of why it works:
%  the private operators are relocated out of systemdict into
%  .internaldict near the end of graphics loading, after this file has
%  been read, so the frozen operator goes on running once the name has
%  stopped resolving.
%
/partition {  % array left right pivotIndex  .  storeIndex
    3 index 1 index get  % A l r pI p
    4 index 3 index 3 index  % A l r pI p  a r pI
    .swap
    3 index  % A l r pI p sI
    dup 1 5 index 1 sub {  % a l r pI p sI  i
        6 index 1 index get 3 index cmp {  % a l r pI p sI  i
            6 index exch 2 index  % A l r pI p sI  a i sI
            .swap
            1 add  % A l r pI p sI+1
        }{ pop } ifelse
    } for  % A l r pI p sI
    5 index 1 index 5 index  % A l r pI p sI  a sI r
    .swap
    6 1 roll pop pop pop pop pop
} bind def

%
%  Sort the range in place: partition it, then sort each side.
%
%  A helper of qsort below, and of itself -- the two recursive calls are
%  by name, resolved out of qsortdict every time, where partition above
%  is baked in by immediate evaluation. So this too runs only while
%  qsortdict is current. The range is consumed, array and all.
%
/quicksort {  % array left right  .  -
    2 copy ge { pop pop pop }{
        3 copy
            2 copy exch sub 2 idiv  % A l r arr left right pivotIndex
            2 index add  % PivotIndex = l + _(r-l)/2_
            //partition exec  % A l r newpivotIndex
        4 copy 1 add 3 2 roll pop exch  % A l r p a p+1 r
        7 3 roll  % A p+1 r a l r p
        exch pop 1 sub  % A p+1 r  a l p-1
        quicksort
        quicksort
    } ifelse
} bind def

%
%       array  .  -
%  array proc  .  -
%
%  Sort an array in place, comparing elements with proc, or with lt when
%  none is given. The array is consumed: what has been sorted is the
%  array object the caller still holds, and nothing is left behind.
%
%  The one name this file exports, reached as //.xpostsys /qsort get exec.
%  gstate.ps calls it, to rank the samples of a halftone's spot function
%  when a screen cell is built; the call in image.ps sits inside a
%  procedure literal that is discarded, the scanline sweep having moved
%  to the .yxsort operator. It opens qsortdict around the sort and closes
%  it after, which is what gives partition and quicksort above the
%  dictionary they need.
%
%  cmp is held in a dictionary of this call's own rather than in
%  qsortdict, which buys two things. The comparison procedure may be in
%  either VM bank: qsortdict is global, a global dictionary refuses a
%  local value, so cmp kept there would refuse a local comparison
%  procedure with invalidaccess rather than sort with it. And a comparison
%  procedure may start a sort of its own: the inner sort's cmp is a slot
%  of its own and goes away with it, where one shared slot would have
%  left the outer sort comparing with the inner one's procedure.
%
%  The array is subject to neither: it travels on the stack and is never
%  stored, so it sorts from either bank.
%
/qsort {
    //qsortdict begin
    1 dict begin
    dup xcheck not{ {lt} }if
    /cmp exch def
    0 1 index length 1 sub quicksort
    end
    end
} bind
end  % Qsortdict
.xpostsys 3 1 roll put
setglobal
