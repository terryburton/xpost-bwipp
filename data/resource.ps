%!PS
%
% resource.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The Level 2 resource machinery: named instances per category, held in global VM.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

//.internaldict /QUIET known { }{ (loading resource.ps...)print } ifelse

%
%  Level 2 resource machinery: named instances per category, held in
%  global VM. /Category is itself a category whose instances are
%  category implementation dictionaries: defining an instance there
%  brings a new category into existence, which is how programs register
%  private categories (typically copying /Generic as a starting point).
%  On-disk resource storage is not implemented: resourceforall
%  enumerates the defined instances only.
%
%  The instance tables live in the private global namespace, out of a
%  program's reach; only the operators below are public. Everything here
%  is global, and global VM stays selected on return: the font machinery
%  loaded next in init.ps is defined in global VM too.
%
true setglobal

currentdict .xpostsys begin begin  % Bake the helper names; see .xpostsys in init.ps

.xpostsys /.resources 32 dict put

%
%  The font machinery caches, beside them and for the same reason: a face
%  is opened once and the objects synthesized from it -- the CharStrings
%  dictionary a Type 1 or CFF face publishes, the sfnts array a Type 42
%  one carries -- are shared by every font dictionary the name produces.
%  The cache's other half is the face itself, which the font library
%  holds and the collector knows nothing of, so the objects are kept here
%  where it does: a member of a namespace whose read-only seal is shallow
%  is still writable, and one made after that seal could not be added at
%  all. A face's entries share a dictionary of their own, so that a face
%  name is never a name in the namespace.
%
.xpostsys /.facecache 32 dict put
//.resources /Category 32 dict put

%
%  /Category is itself one of the categories it lists: PLRM Table 3.9 calls it
%  recursive, so it carries an implementation dictionary of its own alongside
%  the ones it holds for everything else.
%
//.resources /Category get /Category << /Category /Category >> put

%
%  A category is two things made together: a table of its own instances,
%  and an implementation dictionary registered as an instance of
%  /Category. A category with only one of them answers /Category
%  resourcestatus and then raises undefinedresource the moment anything
%  asks it for an instance, so neither half is written anywhere but here.
%

%
%  Give a category the table its instances live in, if it has not one
%  already. This is the half both routes into existence share: the
%  standard categories below, and a program defining an instance of
%  /Category, which is how PLRM 3.9.2 has a program register a category
%  of its own.
%
.xpostsys /.catinstances {  % name  .  -
    //.resources exch 2 copy known
        { pop pop }{ 32 dict put } ifelse
} put

%
%  The primary resource directory a program reads through GenericResourceDir:
%  the first entry of the host's resource search path, ended with the path
%  separator as PLRM C.3.6 requires. When the path is empty the build holds no
%  external resources, which PLRM writes as %null.
%
.xpostsys /.genericresourcedir {  % -  .  string
    /.resourcepath //.hostvalue exec
    dup length 0 gt {
        0 get
        dup length 0 gt { dup dup length 1 sub get 47 eq }{ true } ifelse
        { }{
            dup length 1 add string
            dup 0 3 index putinterval
            dup 2 index length 47 put
            exch pop
        } ifelse
    }{
        pop (%null)
    } ifelse
} put

%
%  The ResourceFileName every category carries: build GenericResourceDir, the
%  category name, the path separator and the instance name into the scratch
%  string and return the part used -- where the instance would be installed or
%  found. Runs with the category implementation dictionary current, so Category
%  resolves. The name is taken verbatim, not folded or rewritten.
%
.xpostsys /.resourcefilename {  % name scratch  .  substring
    exch dup type /stringtype ne { 128 string cvs } if   % Scratch namestr
    exch 0                                                % Namestr scratch 0
    currentsystemparams /GenericResourceDir get      3 copy putinterval length add
    Category 128 string cvs                           3 copy putinterval length add
    currentsystemparams /GenericResourcePathSep get  3 copy putinterval length add
    2 index                                          3 copy putinterval length add
    0 exch getinterval exch pop
} put

%
%  Bring a resource category into existence with an implementation
%  dictionary that need only name the category it implements. A category
%  that already exists is left alone, instances and all, which is what
%  lets a module state the categories it keeps instances in without
%  having to know whether another module has already asked for them.
%
.xpostsys /.defcategory {  % name  .  -
    dup //.resources exch known { pop }{
        dup //.catinstances exec
        //.resources /Category get exch dup
            << /Category 3 -1 roll /ResourceFileName //.resourcefilename >> put
    } ifelse
} put

%
%  The standard regular categories exist from the start, empty until
%  instances are defined into them. /Generic is among them: a program
%  copies its implementation dictionary to seed a category of its own
%  (PLRM 3.9.3), and it is a category in its own right, taking instances
%  of any type, so it is made the same way as the rest rather than
%  written straight into the /Category table with no instances of its own
%  /IODevice holds the parameter sets setdevparams and currentdevparams reach
%  (PLRM 3.8.5), which are the special files this interpreter opens by name.
%  It is filled where those operators are defined rather than here, so the
%  list a program can enumerate and the list they answer for cannot come
%  apart: a device in one and not the other would be a program told a thing
%  exists by one operator and denied it by the next.
%
%  FOUR OF THESE ARE DECLARED AND HOLD NOTHING, and that is a decision
%  rather than an omission. /Halftone, /Pattern, /Form and /FontSet take
%  instances a program defines; PLRM requires no particular ones to be
%  supplied, and the two implementations this tree is adjudicated against
%  do not agree on what to supply -- one ships a halftone and no colour
%  spaces, the other ten colour spaces and no halftone. So an instance
%  here would be this interpreter's invention rather than the language's
%  requirement. The categories exist so that a program defining its own
%  is answered, and so that one asking after a name is told there is no
%  such instance rather than no such category.
%
%  /FontSet is empty for a further reason: StartData, which is what fills
%  it, reads its data and defines nothing on this build. That is written
%  down in doc/COMPLIANCE with the rest of the deviations.
%
%  The last row is PLRM Table 3.8's implicit categories, whose instances are
%  not objects a program defines but capabilities this interpreter either has
%  or does not: an integer key that answers findresource is a type it
%  implements. They are how a program asks what it is talking to -- 7
%  /ShadingType resourcestatus is the question "do you do type 7 shadings"
%  and, without the category, it raises an error instead of answering. The
%  instances are defined by whichever module implements the capability, not
%  here, so the answer cannot drift from the code that has to be true for it.
%
%  Absent by intent: /TrappingType, which this interpreter has no trapping to
%  report; and /FMapType and /FontType, whose support has not been established
%  to the standard the others were -- definefont accepts a dictionary without
%  proving the type behind it is implemented, so a declaration made on that
%  evidence would be a guess.
%
[ /Font /CIDFont /CMap /FontSet /Encoding /Form /Pattern /ProcSet
  /ColorSpace /Halftone /ColorRendering /IdiomSet /InkParams /TrapParams
  /OutputDevice /ControlLanguage /Localization /PDL /HWOptions
  /Filter /ColorSpaceFamily /Emulator /IODevice
  /ColorRenderingType /FormType /HalftoneType /ImageType /PatternType
  /FunctionType /ShadingType
  /Generic ]
{ //.defcategory exec } forall

%
%  What each category takes, from PLRM Tables 3.7, 3.8 and 3.9. A category
%  named here constrains its instances to the one type; one absent from the
%  list -- /Generic -- takes any, which PLRM 3.9.3 states by noting that the
%  generic implementation dictionary carries no InstanceType entry.
%
<< /Font /dicttype /CIDFont /dicttype /CMap /dicttype /FontSet /dicttype
   /Encoding /arraytype /Form /dicttype /Pattern /dicttype /ProcSet /dicttype
   /ColorSpace /arraytype /Halftone /dicttype /ColorRendering /dicttype
   /IdiomSet /dicttype /ControlLanguage /dicttype /Localization /dicttype
   /PDL /dicttype /Category /dicttype
   /InkParams /dicttype /TrapParams /dicttype /OutputDevice /dicttype
   /HWOptions /dicttype
   /Filter /nametype /ColorSpaceFamily /nametype /Emulator /nametype
   /IODevice /stringtype
   /ColorRenderingType /integertype /FormType /integertype
   /HalftoneType /integertype /ImageType /integertype
   /PatternType /integertype /FunctionType /integertype
   /ShadingType /integertype >>
{
    //.resources /Category get 3 -1 roll get
    /InstanceType 3 -1 roll put
} forall

%
%  The type a category holds its instances to, or null where it holds them
%  to none.
%
.xpostsys /.instancetype {  % category  .  name|null
    //.resources /Category get exch 2 copy known {
        get /InstanceType 2 copy known { get }{ pop pop null } ifelse
    }{ pop pop null } ifelse
} put

%
%  The table of instances a category holds, or undefinedresource if no
%  such category has been defined. Every resource operator below reaches
%  its category through here, so the refusal for a category that is not
%  there is written once -- and is raised under the name of the operator
%  that asked, which the caller hands over, because PLRM 3.11.1 has the
%  error name the operator the program actually called.
%
.xpostsys /.instof {  % category /operator  .  instances
    exch //.resources exch 2 copy known not {
        pop pop cvx /undefinedresource signalerror
    } if
    get exch pop
} put

%
%  instances defined in local VM live beside the global table and go
%  away with restore, as the local dictionary holding them does.
%
currentglobal false setglobal
.gscratch /.lresources 32 dict put
setglobal

%
%  The local table of a category, created on first use
%
.xpostsys /.linstof {  % category  .  instances
    .gscratch /.lresources get exch 2 copy known not {
        2 copy 8 dict put
    } if
    get
} put

%
%  File an instance in a category under a key, and answer the instance
%  (PLRM 3.9).
%
%  Defining an instance of /Category is defining a category, so that
%  case makes the table its instances will live in. An instance is held
%  to the type its category states, where the category states one; a
%  category that names no type takes any, which is what PLRM 8.2 means
%  by the category verifying the instance.
%
/defineresource [ /anytype /anytype /nametype ] {  % key instance category  .  instance
    dup /Category eq {
        % Defining an instance of /Category is defining a category, so it
        % gets the table its instances will live in; the implementation
        % dictionary is the instance being defined.
        2 index //.catinstances exec
    } if
    dup /defineresource //.instof exec pop     % The category must exist either way

    % PLRM 8.2: "Before defining the resource instance, defineresource
    % verifies that the instance object is the correct type." A category
    % holding its instances to no type takes any.
    dup //.instancetype exec
    dup null eq { pop }{
        2 index type ne { /defineresource cvx /typecheck signalerror } if
    } ifelse

    % PLRM 5.9: a CIDFont dictionary also carries a FontType, inserted by
    % definefont or by defineresource. This is the other of the two. The
    % question is asked of the CATEGORY rather than of the dictionary,
    % because a CIDFont defined here is one by virtue of the category it is
    % being defined into; the correspondence itself belongs with the font
    % machinery and is fetched from there rather than repeated. It has to
    % happen before the instance is made read-only below.
    dup /CIDFont eq {
        1 index /defineresource //.xpostsys /.cidstamp get exec pop
    } if
    currentglobal { /defineresource //.instof exec }{ //.linstof exec } ifelse
    2 index 2 index put exch pop

    % PLRM 8.2: defineresource "makes the object read-only if its access is
    % not already restricted", so what a category hands out cannot be altered
    % behind the back of whoever holds it. Access belongs to composites, and a
    % category constraining nothing takes instances of any type; an instance
    % already executeonly or noaccess is left as it was found.
    dup type /dicttype eq 1 index type /arraytype eq or
    1 index type /stringtype eq or 1 index type /packedarraytype eq or
    { dup wcheck { readonly } if } if
} .defop

%
%  category -> a dict of instance names known ABSENT from the search path. A
%  miss records here so a repeated lookup of a resource that is not on the path
%  answers without walking it again -- the path is fixed for a run. Present
%  instances are cached by defineresource in the instance table, which every
%  caller consults first, so this holds only negatives; a name defined later is
%  found there and never reaches this.
%
.xpostsys /.resourcemissing 16 dict put

%
%  The instance is identified by name; a key given as a string interns to the
%  same name a name key would, so the memo keys on the name and matches either.
%
.xpostsys /.resourceknownmissing {  % key category  .  bool
    exch dup type /stringtype eq { cvn } if exch
    //.resourcemissing exch 2 copy known
        { get exch known }{ pop pop pop false } ifelse
} put

%
%  .resourcemissing is global (it outlives restore, as the instance table does);
%  create the per-category sub-dict and intern the name in global VM so the
%  global memo never holds a local object.
%
.xpostsys /.resourcemarkmissing {  % key category  .  -
    currentglobal true setglobal
    3 1 roll exch dup type /stringtype eq { cvn } if exch
    //.resourcemissing exch 2 copy known not
        { 2 copy 16 dict put } if
    get exch true put
    setglobal
} put

%  The open is reached with // rather than by name, and that is
%  load-bearing. The C undefines .resourcefileopen from systemdict at
%  lockdown so a program cannot name the raw open afterwards, so a
%  run-time lookup would find nothing and findresource could open nothing.
%  The // resolves it while the name still answers and puts the operator
%  itself in this body, which is the reference that survives. Which
%  operators the C takes away is read out of the C by
%  tests/check-helper-bind.sh, which holds each of them to being reached
%  this way.
%
%
%  Walk the resource search path for the named instance and return the OPEN,
%  confined file (not run) or false. This is the ONE place the path is walked
%  and the confined open (.resourcefileopen) is reached: findresource's load
%  and resourcestatus's probe both go through here, so the file-access decision
%  has a single site. The directories are what the run's host settled, in order
%  (empty until it names one: xpost_add_resource_dir, -I).
%
.xpostsys /.resourcefind {  % key category  .  file true | false
    2 dict begin
    /category exch def
    /key exch def
    /.rf false def
    /.rok false def
    /.resourcepath //.hostvalue exec {
        % dir
        category 128 string cvs
        key 128 string cvs
        //.resourcefileopen { /.rf exch def /.rok true def exit } if
    } forall
    .rok { .rf true }{ false } ifelse
    end
} put

%
%  On a findresource miss, load the named instance from the search path via
%  .resourcefind and run it in global VM -- so its defineresource lands in the
%  shared instance table and persists across restore. A miss is recorded so the
%  path is not walked again for the same absent name.
%
.xpostsys /.loadresource {  % key category  .  bool
    2 copy //.resourceknownmissing exec {
        pop pop false
    }{
        2 copy //.resourcefind exec {
            % key category file -- run the already-opened, confined file
            % directly; running it by name would reopen it outside the path.
            currentglobal exch true setglobal cvx exec setglobal
            pop pop true
        }{
            //.resourcemarkmissing exec
            false
    } ifelse } ifelse
} put

%
%  The instance a category holds under a key, loading it from the
%  resource search path on a miss and raising undefinedresource where
%  there is none to load (PLRM 3.9).
%
%  A category is itself an instance -- of /Category -- so a reference to
%  a category nothing has defined yet loads its implementation first,
%  and the same undefinedresource answers whether it was the category or
%  the instance that could not be found.
%
/findresource [ /anytype /nametype ] {  % key category  .  instance
  {  % loop, so the local-shadow path can exit early
    2 dict begin
    /category exch def
    /key exch def

    % Ensure the category is defined. A category is itself an instance of
    % /Category, stored under Category/<name> in the resource layout, so a
    % reference to an as-yet-unloaded category loads its implementation.
    //.resources category known not {
        category /Category //.loadresource exec pop
    } if
    //.resources category known not {
        end /findresource cvx /undefinedresource signalerror
    } if

    % a local instance shadows a global one of the same name
    .gscratch /.lresources get category known {
        .gscratch /.lresources get category get dup key known
            { key get end exit }{ pop } ifelse
    } if
    category /findresource //.instof exec /instances exch def
    instances key known not {
        % Miss: load the instance from the search path. The instance table
        % is shared, so a successful defineresource populates instances.
        key category //.loadresource exec not
        { end /findresource cvx /undefinedresource signalerror } if
        instances key known not
        { end /findresource cvx /undefinedresource signalerror } if
    } if
    instances key get
    end
    exit
  } loop
} .defop

%
%  Whether a category holds an instance under a key, and if so its
%  status and size (PLRM 3.9). An instance already in VM reports status
%  0 and size 0: it cost nothing to find and occupies no file.
%
%  Unlike findresource this does not raise for a missing instance --
%  answering false is the point of it -- but a category that does not
%  exist is still undefined, because the question cannot be asked.
%
/resourcestatus [ /anytype /nametype ] {  % key category  .  status size true | false
    % Querying a category that does not exist is an undefined error (PLRM);
    % only a present-but-absent instance yields false. Ensure the category is
    % defined the same way findresource does before reporting on an instance.
    2 dict begin
    /category exch def
    /key exch def
    //.resources category known not {
        category /Category //.loadresource exec pop
    } if
    //.resources category known not {
        end /resourcestatus cvx /undefined signalerror
    } if

    % An instance in VM reports status 0, size 0 (a local instance shadows a
    % global one). An instance not in VM but available as a file on the search
    % path reports status 2, size -1 -- its presence without loading it -- the
    % way findresource would reach it, through the one search-and-open site.
    % An unavailable instance is remembered so a repeat query does not re-walk
    % the path.
    .gscratch /.lresources get category 2 copy known { get }{ pop pop << >> } ifelse
    key known {
        end 0 0 true
    }{
        //.resources category get key known {
            end 0 0 true
        }{
            key category //.resourceknownmissing exec {
                end false
            }{
                key category //.resourcefind exec {
                    closefile end 2 -1 true
                }{
                    key category //.resourcemarkmissing exec
                    end false
    } ifelse } ifelse } ifelse } ifelse
} .defop

%
%  Take an instance out of a category (PLRM 3.9).
%
%  The local table is preferred over the global one where both hold the
%  key, so a job that shadowed a global instance takes back its own and
%  leaves the shared one standing. Where only the global table holds it,
%  that is the one that gives it up.
%
/undefineresource [ /anytype /nametype ] {  % key category  .  -
    % Each arm reaches the same shape before it acts: the key and the
    % category, in that order, so that the instance dictionary the
    % category names is what the key is removed from. The three arms
    % arrive here holding different amounts, which is the whole of what
    % the pops below are for.
    2 copy .gscratch /.lresources get exch 2 copy known {
        get 1 index known {
            % key category key -- a local instance of this key
            pop //.linstof exec exch undef
        }{
            % key category key -- the category is local, this key is not
            pop /undefineresource //.instof exec exch undef
        } ifelse
    }{
        % key category key .lresources category -- no local category
        pop pop pop /undefineresource //.instof exec exch undef
    } ifelse
} .defop

%
%  Hand one instance to the program's procedure (PLRM 8.2).
%
%  A name or string key is written into the scratch string the program
%  supplied and the substring handed over; any other key -- an implicit
%  category is keyed by integer (PLRM Table 3.8) -- is handed over as it
%  is, because the number is what findresource takes back and its text
%  is not.
%
%  It takes all three as operands rather than reading them out of a
%  dictionary, so that resourceforall can close its own dictionary before
%  the program's procedure runs. What the procedure defines belongs to
%  the program, and it must see the dictionary stack its caller had.
%
.xpostsys /.rfhand {  % key scratch proc  .  -
    3 1 roll
    1 index type dup /nametype eq exch /stringtype eq or
        { cvs }{ pop } ifelse
    exch //.pexec exec
} put

%
%  Match a name against a resourceforall template: ? matches any one
%  character, * any run (backtracking iteratively over the most recent
%  star), and \ makes the following character literal.
%
.xpostsys /.wcmatch {  % string template  .  bool
    8 dict begin
    /t exch def /s exch def
    /sl s length def /tl t length def
    /si 0 def /ti 0 def /star -1 def /smk 0 def
    /res null def
    {  % loop
        si sl lt {
            /adv false def
            ti tl lt {
                t ti get dup 42 eq {  % *
                    pop /star ti def /smk si def /ti ti 1 add def /adv true def
                }{
                    dup 92 eq ti 1 add tl lt and {  % Escaped literal
                        pop
                        t ti 1 add get s si get eq {
                            /ti ti 2 add def /si si 1 add def /adv true def
                        } if
                    }{
                        dup 63 eq exch s si get eq or {  % ? or same character
                            /ti ti 1 add def /si si 1 add def /adv true def
                        } if
                } ifelse } ifelse
            } if
            adv not {
                star 0 ge {
                    /ti star 1 add def
                    /smk smk 1 add def
                    /si smk def
                }{
                    /res false def exit
                } ifelse
            } if
        }{
            exit
        } ifelse
    } loop
    res null eq {
        {  % loop: trailing stars match the empty remainder
            ti tl lt { t ti get 42 eq { /ti ti 1 add def }{ exit } ifelse }{ exit } ifelse
        } loop
        /res ti tl eq def
    } if
    res
    end
} put

%
%  Enumerate the category's instances whose names match the template,
%  copying each name into scratch and calling proc with the substring.
%  The keys are snapshotted first, so the proc may define or undefine
%  resources; whether such changes are enumerated is unspecified, as
%  the language allows. The proc is the program's, so it runs beneath
%  the boundary: a failure inside it is that procedure's own object
%  failing, and the operand stack goes back to what the procedure
%  found rather than to resourceforall's four operands.
%
/resourceforall [ /stringtype /proctype /stringtype /nametype ] {  % template proc scratch category  .  -
    % Merge the global table with any local instances over it
    dup /resourceforall //.instof exec exch
    .gscratch /.lresources get exch 2 copy known {
        get exch dup length 2 index length add 1 add dict
        exch { 2 index 3 1 roll put } forall
        exch { 2 index 3 1 roll put } forall
    }{ pop pop } ifelse
    5 dict begin
    /.rfinst exch def /.rfscr exch def /.rfproc exch def /.rftmpl exch def
    /.rfbuf 127 string def

    % Which instances the template names, settled here and in one pass, so
    % that nothing the program's procedure defines can change what the
    % enumeration was over.
    %
    % PLRM 8.2: a key that is neither a name nor a string matches only the
    % template (*). That is not a corner -- an implicit category's
    % instances are the capability itself and are keyed by integer (PLRM
    % Table 3.8), so it is the ordinary case for /ShadingType and its
    % neighbours. The matching writes through .rfbuf and not through the
    % scratch string the program supplied, which is the procedure's to
    % read and must not be scribbled on before it is handed anything.
    [ .rfinst { pop
        dup type dup /nametype eq exch /stringtype eq or {
            dup .rfbuf cvs .rftmpl //.wcmatch exec { }{ pop } ifelse
        }{
            .rftmpl (*) eq { }{ pop } ifelse
        } ifelse
    } forall ]

    % A runner with the scratch string and the program's own procedure
    % frozen into it -- load, not lookup, so a bare name cannot run the
    % procedure early. Everything this operator needs is now either in
    % that runner or in the array beside it, so its own dictionary comes
    % off before a line of the program runs: the procedure sees the
    % dictionary stack its caller had, and what it defines lands where the
    % program will look for it. A private dictionary left open here is
    % visible to the program, and a definition the procedure makes would
    % go into it and be thrown away with it.
    [ .rfscr /.rfproc load //.rfhand /exec load ] cvx
    end
    forall
} .defop

%
%  In-RIP trapping (PLRM 6.3). The trapping operators are defined in the
%  Trapping procedure set; a program reaches them with
%    /Trapping /ProcSet findresource begin ... end
%  The trapping parameter dictionary is not directly accessible: it is read and
%  altered only through currenttrapparams and settrapparams. This interpreter
%  keeps that parameter state and accepts trapping zones, but generates no traps
%  -- a conformant answer for a device without in-RIP trapping.
%
/Trapping <<
    % The cumulative trapping-parameter dictionary. The language prescribes no
    % default values (they are device-specific), so it starts empty.
    /.trapparams 15 dict

    % Merge a request dictionary's entries into the trapping parameters.
    % The effect is cumulative across calls; a key given a null value is
    % set to null (cancelled), an omitted key is left unchanged.
    /settrapparams {  % dict  .  -
        /settrapparams [ /dicttype ] //.xpostsys /.checkargs get exec
        { .trapparams 3 1 roll put } forall
    } bind

    % Return a dictionary reflecting the current trapping parameters.
    /currenttrapparams {  % -  .  dict
        .trapparams dup length 1 add dict copy
    } bind

    % Establish a trapping zone from the current path with the current
    % parameters. This device emits no traps, so nothing is produced.
    /settrapzone {  % -  .  -
    } bind
>> /ProcSet defineresource pop

%
%  ---- idiom recognition (PLRM 3.12.1) -----------------------------------
%
%  bind, when the IdiomRecognition user parameter is true, compares the
%  procedure it has just bound against every template procedure held in the
%  IdiomSet resource instances in view, and where one matches returns the
%  paired substitute procedure in its place. The comparison is by value, not
%  by key -- the one resource category selected that way -- so every instance
%  is walked. Only the top-level bound procedure is compared, not the nested
%  ones bind descended into; the substitute is returned as bind's result.
%

%
%  Two procedures match when corresponding elements are equal in the sense
%  of eq, or are both arrays whose corresponding elements match in turn, to
%  a depth of ten. Attributes are disregarded, as eq disregards them, so the
%  working copies are taken literal to compare their contents without running
%  them. The depth bound also stops a procedure that refers to itself.
%
.xpostsys /.idiommatch {  % a b depth  .  bool
    6 dict begin
    /dep exch def /bb exch cvlit def /aa exch cvlit def
    aa bb eq {
        true
    }{
        aa type dup /arraytype eq exch /packedarraytype eq or
        bb type dup /arraytype eq exch /packedarraytype eq or
        and dep 10 lt and {
            aa length bb length eq {
                /res true def
                0 1 aa length 1 sub {
                    /ii exch def
                    aa ii get bb ii get dep 1 add
                    //.xpostsys /.idiommatch get exec
                    not { /res false def exit } if
                } for
                res
            }{ false } ifelse
        }{ false } ifelse
    } ifelse
    end
} put

%
%  Walk one IdiomSet instance dictionary, whose every value is a two-element
%  array of a template and a substitute, and return the first substitute
%  whose template matches the candidate. A substitute in local VM is not
%  offered for a candidate in global VM (it would outlive its home), which is
%  the one visibility rule bind applies beyond the allocation mode below.
%
.xpostsys /.idiomsearch {  % cand instances  .  substitute true | false
    4 dict begin
    /instances exch def /cand exch def /repl null def /found false def
    instances {
        exch pop                      % The value; the key is disregarded
        dup 0 get                     % Value template
        /cand load exch 1 //.idiommatch exec {
            1 get                     % The paired substitute
            /cand load gcheck 1 index gcheck not and
            { pop }
            { /repl exch def /found true def exit }
            ifelse
        }{ pop } ifelse
    } forall
    found { /repl load true }{ false } ifelse
    end
} put

%
%  Walk the instances held in one IdiomSet resource table -- each value an
%  instance dictionary of template/substitute pairs -- and return the first
%  substitute any instance offers for the candidate. Which instance wins when
%  two hold the same template is not defined, so the first found is taken.
%
.xpostsys /.idiomcat {  % cand table  .  substitute true | false
    4 dict begin
    /table exch def /cand exch def /repl null def /found false def
    table {
        exch pop                  % One instance dictionary
        /cand load exch //.idiomsearch exec {
            /repl exch def /found true def exit
        }{ } ifelse
    } forall
    found { /repl load true }{ false } ifelse
    end
} put

%
%  bind's result passes through here. The global IdiomSet instances are always
%  in view; the local ones are added when the allocation mode is local, as bind
%  considers local resources only then. With no instances in either the
%  candidate is returned untouched without even reading the user parameter, so
%  the common bind pays only two dictionary lookups.
%
.xpostsys /.idiomsub {  % cand  .  cand'
    4 dict begin
    /cand exch def
    /g //.resources
        dup /IdiomSet known { /IdiomSet get }{ pop << >> } ifelse def
    /l currentglobal
        { << >> }
        { .gscratch /.lresources get
          dup /IdiomSet known { /IdiomSet get }{ pop << >> } ifelse }
        ifelse def
    g length 0 eq l length 0 eq and {
        /cand load
    }{
        //.internaldict /.idiomrecognition get exec {
            /cand load g //.idiomcat exec {
            }{
                /cand load l //.idiomcat exec
                { }{ /cand load } ifelse
            } ifelse
        }{
            /cand load
    } ifelse } ifelse
    end
} put

%
%  Run the plain bind kept in .internaldict, then offer its result to idiom
%  substitution. The two steps are what a LanguageLevel 3 bind is.
%
.xpostsys /.bindwrap {  % -  .  -   (installed as the bind operator by .finalize)
    //.internaldict /.cbind get exec
    //.idiomsub exec
} put

%
%  ------------------------------------------------------------------------
%
end end

//.internaldict /QUIET known { }{ (eof resource.ps\n)print } ifelse
