//.internaldict /QUIET known { }{ (loading ppmimage.ps...)print } ifelse

currentdict .jobstore .xpostsys begin begin begin  % Bake the helper names; see .xpostsys in init.ps

%
%  Make an instance of the 24-bit colour raster device: the class
%  copied, with the extent it is asked for written onto the copy.
%
%  This is the maker the page-device machinery reaches: init.ps files it
%  in .devicemakers under the name a -d option or a setpagedevice
%  request selects the device by, and calls it through privatedict.
%
.privatedict /newPPMIMAGEdevice {  % width height  .  IMAGE-device-dict
    .privatedict /.xpost_PPMIMAGE get dup /Create get exec
} put

%
%  .xpost_PPMIMAGE, the 24-bit rgb raster class: the shared raster method
%  suite (.makerasterclass, image.ps) over three colour components per
%  pixel, a scanline of three component planes -- one string of one byte
%  per pixel for red, for green and for blue -- and emission as a raw
%  (P6) portable pixmap. It uses the full range 0-255 of values and does
%  not calculate the actual maximum value in the data before
%  transmitting; MaxVal is always 255.
%
%  A plane holds one byte per pixel, so the widest page the class builds
%  is the widest string the build holds, which is the widest row the
%  grayscale class builds as well. Three components interleaved in one
%  string of the row would come to a third of that width.
%
%  Procedures (.xpost_PPMIMAGE is the Class dictionary, IMAGE an
%  instance returned by Create):
%            width height .xpost_PPMIMAGE  Create  ->  IMAGE
%                  r g b x y IMAGE  PutPix  ->  -
%                        x y IMAGE  GetPix  ->  r g b
%          r g b x1 y1 x2 y2 IMAGE  DrawLine  ->  -
%     r g b x y width height IMAGE  DrawRect  ->  -
%     r g b x y width height IMAGE  FillRect  ->  -
%              r g b polygon IMAGE  FillPoly  ->  -
%                            IMAGE  Emit  ->  -
%                            IMAGE  Destroy  ->  -
%                            dict1  .copydict  dict2
%
/.xpost_PPMIMAGE <<
    /nativecolorspace /DeviceRGB
    /.ncomp 3
    /BlendPix //.internaldict /.blendpixrgb get

    % This device's page may arrive a band at a time: a header and then
    % raw rows, so a row goes out the moment it is finished and nothing
    % written has to be revisited. What a device states about itself is
    % what the machinery above it goes by, and the safe answer is
    % silence -- a device that has not said this gets the whole page it
    % expects (doc/xpost_design.dox).
    /BandedPage true
    /.pnmmagic (P6\n)

    % Three component planes per scanline, red green blue in that order;
    % a fresh string is already zero. The empty row a page held in part
    % stands the rows it does not hold on is the same shape carrying no
    % pixel.
    /.rowalloc {  % -  .  row
        [ width string width string width string ]
    } bind
    /.rowempty {  % -  .  row
        [ 0 string 0 string 0 string ]
    } bind

    % Whether a row of the raster is one the page holds. A row of either
    % kind names three planes, so what tells them apart is the plane: a
    % held row's is as long as the page is wide and an empty row's holds
    % no pixel.
    /.rowheld {  % row  .  bool
        0 get length 0 ne
    } bind

    % What one .rowalloc costs the memory it allocates from, as the
    % elements and the string bytes it takes: a planar row is the three
    % elements naming its planes and one byte per pixel in each of them.
    % Create prices the whole raster from this before it builds any of
    % it.
    /.rowcost {  % -  .  elements bytes
        3 width 3 mul
    } bind

    % scale each component in [0,1] to its plane's byte, and read the
    % three back.
    /.rowput {  % row x c1 c2 c3  .  -
        .chan 4 index 2 get 4 index 3 -1 roll put
        .chan 3 index 1 get 3 index 3 -1 roll put
        .chan 3 -1 roll 0 get 3 1 roll put
    } bind
    /.rowget {  % row x  .  c1 c2 c3
        2 copy exch 0 get exch get 3 1 roll
        2 copy exch 1 get exch get 3 1 roll
        exch 2 get exch get
    } bind

    % The planes interleave through the compiled row writer
    /.writeband {  % rows file  .  -
        //.internaldict /.writergbrows get exec
    } bind
>> .makerasterclass def

end end end

//.internaldict /QUIET known { }{ (eof ppmimage.ps\n)print } ifelse
