//.internaldict /QUIET known { }{ (loading pgmimage.ps...)print } ifelse

.privatedict /newPGMIMAGEdevice {  % width height  .  IMAGE-device-dict
    .privatedict /.xpost_PGMIMAGE get dup /Create get exec
} put

%
%  .xpost_PGMIMAGE, the 8-bit grayscale raster class: the shared raster
%  method suite (.makerasterclass, image.ps) over one grey component per
%  pixel, a string row per scanline holding the scaled bytes, and
%  emission as a raw (P5) portable graymap. It uses the full range 0-255
%  of values and does not calculate the actual maximum value in the data
%  before transmitting; MaxVal is always 255.
%
%  procedures (.xpost_PGMIMAGE is the Class dictionary, IMAGE an
%  instance returned by Create):
%            width height .xpost_PGMIMAGE  Create  ->  IMAGE
%                    val x y IMAGE  PutPix  ->  -
%                        x y IMAGE  GetPix  ->  val
%            val x1 y1 x2 y2 IMAGE  DrawLine  ->  -
%       val x y width height IMAGE  DrawRect  ->  -
%       val x y width height IMAGE  FillRect  ->  -
%                val polygon IMAGE  FillPoly  ->  -
%                            IMAGE  Emit  ->  -
%                            IMAGE  Destroy  ->  -
%                            dict1  .copydict  dict2
%
/.xpost_PGMIMAGE <<
    /nativecolorspace /DeviceGray
    /.ncomp 1
    /BlendPix //.internaldict /.blendpixgray get

    % This device's page may arrive a band at a time: a header and then
    % raw rows, so a row goes out the moment it is finished and nothing
    % written has to be revisited. What a device states about itself is
    % what the machinery above it goes by, and the safe answer is
    % silence -- a device that has not said this gets the whole page it
    % expects (doc/INTERNALS).
    /BandedPage true
    /.pnmmagic (P5\n)

    % A string row per scanline; a fresh string is already zero. The
    % empty row a page held in part stands the rows it does not hold on
    % is the same shape carrying no pixel.
    /.rowalloc {  % -  .  row
        width string
    } bind
    /.rowempty {  % -  .  row
        0 string
    } bind

    % Whether a row of the raster is one the page holds. A grayscale row
    % is the pixels itself, so a held row is as long as the page is wide
    % and the empty row is as long as it holds pixels.
    /.rowheld {  % row  .  bool
        length 0 ne
    } bind

    % What one .rowalloc costs the memory it allocates from, as the
    % elements and the string bytes it takes: a string row is one byte
    % per pixel and no elements. Create prices the whole raster from this
    % before it builds any of it.
    /.rowcost {  % -  .  elements bytes
        0 width
    } bind

    % Scale a grey in [0,1] to the stored byte; a read is the byte
    /.rowput {  % row x c1  .  -
        .chan put
    } bind
    /.rowget {  % row x  .  c1
        get
    } bind

    % Raw (binary) format: each row string is already the raster bytes
    /.writeband {  % rows file  .  -
        exch { 1 index exch writestring } forall pop
    } bind

>> //.xpostsys /.makerasterclass get exec def

//.internaldict /QUIET known { }{ (eof pgmimage.ps\n)print } ifelse
