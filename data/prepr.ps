%!PS
%
% prepr.ps
%
% vim: set sw=4 sts=4 tw=72 et:
%
% The preview prompt: the interactive executive prompt.
%
% Copyright (c) 2013-2016 Michael Joshua Ryan
% SPDX-License-Identifier: BSD-3-Clause

%
%  If the stack is empty, it displays the standard, Adobe prompt
%  PS>.
%
%  But if the stack is not empty, the prompt will contain a digest
%  of the stack contents, single letters for most types,
%  t or f for booleans, 0-9 for the integers 0-9 respectively,
%  + for integers 10 and above. - for integers below zero
%  Capital Letters for Composite Objects
%  lowercase letters for simple objects.
%

%
%  ti and prompt are global: prompt relocates from userdict into systemdict
%  with the other interactive helpers, so it bakes a global ti (a global
%  procedure may not reference a local object). ti stays private -- it lives
%  in this scratch dictionary, which end discards, reachable only through the
%  //ti frozen into prompt.
%
currentglobal true setglobal

%
%  The one character a small integer is written into. In the job store:
%  a buffer cvs writes through is state, and state kept beside the
%  procedures cannot be sealed with them.
%
.jobstore /.promptdigit 1 string put

1 dict begin

%
%  The stack digest, one entry per object type. prompt walks the operand
%  stack and executes the entry the object's type names, and each entry
%  prints the single character that stands for it -- so a prompt shows
%  the shape of the stack without unstacking anything or printing a
%  value.
%
%  /default is what an object of a type not named here prints as.
%
/ti [
    % Simple
    /nulltype        { pop (#) print }  % null  .  -
    /marktype        { pop ([) print }  % mark  .  -
    /nametype        { xcheck { (\\) } { (/) } ifelse print }  % name  .  -
    /integertype     {  % int  .  -
                       dup 0 lt  { pop (-) print }{
                       dup 10 lt { //.promptdigit cvs print }
                                 { pop (+) print }
                     ifelse } ifelse }
    /realtype        { pop (r) print }  % real  .  -
    /booleantype     { { (t) }{ (f) } ifelse print }  % bool  .  -
    /fonttype        { pop ($) print }  % font  .  -

    % Composite
    /arraytype       { xcheck { (}) }{ (]) } ifelse print }  % array  .  -
    /stringtype      { pop (S) print }  % string  .  -
    /packedarraytype { pop (A) print }  % packedarray  .  -
    /dicttype        { pop (D) print }  % dict  .  -
    /filetype        { pop (F) print }  % file  .  -
    /operatortype    { pop (O) print }  % operator  .  -
    /savetype        { pop (V) print }  % save  .  -
    /default         { pop (?) print }  % obj  .  -

%
% Attempt to use the level-2 dict constructor >>
%
{ (>>) cvx cvn exec def } stopped { pop

    %level-1 workaround
    counttomark 2 idiv dup dict begin { def } repeat
    cleartomark currentdict end def
} if

%
%  Write the interactive prompt: PS, then the depth of the operand stack
%  and one character for the type of each entry, deepest first, then the
%  closing bracket.
%
%  The digest is a shape, not a listing. Nothing is unstacked to build it
%  -- each entry is copied, typed and dropped -- so a prompt cannot
%  disturb what the next line will operate on, and a stack of any depth
%  costs one line however large the objects on it are.
%
%  ti is reached through the reference frozen in here as this file loads.
%  The scratch dictionary holding it is discarded by the end below, so
%  after that this is the only way to it and a program cannot redefine
%  the table out from under the prompt.
%
/prompt {  % -  .  -
    (PS) print
    count
    dup 0 eq {
        pop
    }{
        (<) print
        dup 1 add copy  % ... n ... n
        -1 1 {
            -1 roll
            //ti 1 index type
            2 copy known not { pop /default } if
            get exec
        } for
        pop
    } ifelse
    (>) print
    flush
}
end def
setglobal

